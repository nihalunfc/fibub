/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://speed.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The menus' tool lists (loaded by every page the first time a menu opens): keep for 10 minutes.
/nav/
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/science/audio-spectrum-analyser/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), payment=(), usb=()

/science/harmonics-analyser/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), payment=(), usb=()

# OCR reader files (tesseract.js 7.0.0, src/lib/ocr.ts): versioned by the package pin, keep for a year.
/ocr/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker (scripts/make-sw.mjs) and the app manifest: always check for a newer copy, so a
# new deploy reaches installed apps on their next visit.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
