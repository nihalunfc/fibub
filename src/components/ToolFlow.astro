---
// A picture of what the tool does: 3 or 4 steps in one row, on every screen size.
// The row never wraps; steps shrink instead, so labels must stay short (see the schema).
import { ICONS, type IconName } from '../lib/icons';
interface Props { steps: { icon: IconName; label: string }[] }
const { steps } = Astro.props;
---
<figure class="flow">
  <ol class="flow-steps" style={`--n:${steps.length}`}>
    {steps.map((s, i) => (
      <li class="flow-step">
        <span class="flow-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} /><i>{i + 1}</i></span>
        <span class="flow-lbl">{s.label}</span>
      </li>
    ))}
  </ol>
  <figcaption class="flow-cap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.lock} />All on your device. Nothing is uploaded.</figcaption>
</figure>

<style>
  .flow { margin: 0 0 24px; padding: clamp(12px, 3vw, 20px) clamp(8px, 3vw, 24px) 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .flow-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .flow-step { position: relative; display: grid; justify-items: center; gap: 6px; text-align: center; min-width: 0; }
  /* The arrow sits in the gap between two icons, centred on the icon row. */
  .flow-step:not(:last-child)::after {
    content: ''; position: absolute; top: calc(var(--ico) / 2); left: calc(50% + var(--ico) / 2 + 4px); right: calc(-50% + var(--ico) / 2 + 4px);
    height: 2px; background: linear-gradient(90deg, var(--line), var(--accent)); transform: translateY(-1px);
  }
  .flow-step:not(:last-child)::before {
    content: ''; position: absolute; top: calc(var(--ico) / 2 - 4px); right: calc(-50% + var(--ico) / 2 + 4px);
    width: 8px; height: 8px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); transform: rotate(45deg); transform-origin: center; margin-right: 1px;
  }
  .flow { --ico: clamp(38px, 11vw, 56px); }
  .flow-ico { position: relative; width: var(--ico); height: var(--ico); display: grid; place-items: center; border-radius: 50%; background: var(--accent-soft); color: var(--accent); }
  .flow-ico svg { width: 52%; height: 52%; }
  .flow-ico i { position: absolute; top: -3px; right: -3px; min-width: 18px; height: 18px; border-radius: 9px; background: var(--accent); color: var(--accent-ink); font: 600 11px/18px system-ui, sans-serif; font-style: normal; }
  .flow-lbl { font-size: clamp(12px, 3.3vw, 15px); line-height: 1.25; font-weight: 600; padding: 0 2px; text-wrap: balance; }
  .flow-cap { display: flex; align-items: center; justify-content: center; gap: 6px; margin: clamp(12px, 3vw, 16px) calc(-1 * clamp(8px, 3vw, 24px)) 0; padding: 8px; font-size: 13px; color: var(--good); background: var(--good-soft); }
  .flow-cap svg { width: 14px; height: 14px; flex: none; }
</style>
