---
import WorksBadge from './WorksBadge.astro';
interface Props { href: string; name: string; summary: string; soon?: boolean; works: 'offline' | 'online' }
const { href, name, summary, soon = false, works } = Astro.props;
---
{soon
  ? <div class="card"><h3>{name}<span class="soon">coming soon</span></h3><p>{summary}</p><WorksBadge works={works} small /></div>
  : <a class="card" href={href}><h3>{name}</h3><p>{summary}</p><WorksBadge works={works} small /></a>}
