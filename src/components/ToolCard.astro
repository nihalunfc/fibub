---
// A tool on the home and shelf pages: coloured icon, name, one-line summary, offline label.
import { ICONS } from '../lib/icons';
import { toolUrl, type Tool } from '../lib/tools';
interface Props { tool: Tool }
const { tool } = Astro.props;
const d = tool.data;
---
<a class="tc" href={toolUrl(tool)} data-shelf={d.shelf} data-search={`${d.name} ${d.summary}`.toLowerCase()}>
  <span class="tc-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[d.icon]} /></span>
  <span class="tc-body">
    <b>{d.name}</b>
    <span class="tc-sum">{d.summary}</span>
    <span class:list={['tc-works', d.works]} data-works={d.works}>{d.works === 'offline' ? 'Works offline' : 'Needs internet'}</span>
  </span>
  <span class="tc-go" aria-hidden="true">→</span>
</a>

<style>
  .tc { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: start; padding: 14px 14px 14px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); text-decoration: none; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .tc:hover { border-color: color-mix(in srgb, var(--c) 45%, var(--line)); box-shadow: var(--shadow); transform: translateY(-1px); }
  .tc { --c: var(--accent); --cs: var(--accent-soft); }
  .tc[data-shelf=money] { --c: var(--money); --cs: var(--money-soft); }
  .tc[data-shelf=documents] { --c: var(--documents); --cs: var(--documents-soft); }
  .tc[data-shelf=everyday] { --c: var(--everyday); --cs: var(--everyday-soft); }
  .tc-ico { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--c); background: var(--cs); }
  .tc-ico svg { width: 22px; height: 22px; }
  .tc-body { display: grid; gap: 2px; min-width: 0; }
  .tc-body b { font-size: 16px; line-height: 1.3; }
  .tc-sum { color: var(--muted); font-size: 14px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tc-works { margin-top: 4px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
  .tc-works::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .tc-works.offline { color: var(--good); }
  .tc-works.online { color: var(--warn); }
  .tc-go { color: var(--muted); font-size: 18px; align-self: center; transition: transform .15s, color .15s; }
  .tc:hover .tc-go { color: var(--c); transform: translateX(3px); }
</style>
