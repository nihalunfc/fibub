---
// Shared converter for #T955 MP3 to u-law and #T956 WAV to u-law: any sound file to 8 kHz mono phone audio
// (G.711 u-law or A-law, raw or WAV, or 16-bit linear) for Asterisk, FreePBX, 3CX, Cisco and other PBXs. Nothing is uploaded.
// Kit: src/lib/audio/ (checks in tests/audio.mjs).
import { PHONE_FORMATS } from '../../lib/audio/pcm.ts';
interface Props { from: string; format?: string }
const { from, format = 'ulaw' } = Astro.props;
---
<div class="tool-ui pbx" data-format={format}>
  <section class="panel">
    <div class="pbx-drop">
      <button type="button" class="btn pbx-open">Open {from} files</button>
      <input class="pbx-file" type="file" multiple accept="audio/*,.mp3,.wav,.ogg,.opus,.m4a,.aac,.flac,.webm,.mp4" hidden />
      <span class="pbx-hint">Or drop them here. Up to 50 files, 200 MB each. MP3, WAV, OGG, M4A, FLAC and more. They stay on this device.</span>
    </div>
    <p class="note bad pbx-err" hidden></p>
  </section>

  <section class="panel">
    <label>Save as
      <select class="pbx-fmt">
        {Object.entries(PHONE_FORMATS).map(([k, f]) => <option value={k} selected={k === format}>{f.label}</option>)}
      </select>
    </label>
    <label class="pbx-check"><input class="pbx-norm" type="checkbox" checked /> Even out the volume: loudest point at −3 dB, so quiet recordings are not too soft on the phone</label>
    <p class="pbx-fine">Every file becomes 8,000 samples a second, one channel (mono): what G.711 phone calls carry. Sound above 3.6 kHz is filtered out first so it does not turn into a whistle.</p>
  </section>

  <section class="panel pbx-out" hidden>
    <ol class="pbx-list"></ol>
    <div class="pbx-row">
      <button type="button" class="btn pbx-all">Download all</button>
      <button type="button" class="btn secondary pbx-clear">Clear the list</button>
    </div>
    <p class="pbx-sum" aria-live="polite"></p>
  </section>
</div>

<style is:inline>
  .pbx { display: grid; gap: 14px; margin-bottom: 32px; }
  .pbx .panel { display: grid; gap: 12px; padding: 16px; }
  .pbx-drop { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; border: 2px dashed var(--line); border-radius: 12px; padding: 14px; }
  .pbx-drop.over { border-color: var(--accent); }
  .pbx-hint, .pbx-fine, .pbx-sum { color: var(--muted); font-size: 14px; margin: 0; }
  .pbx label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .pbx label.pbx-check { display: flex; align-items: flex-start; gap: 8px; color: var(--ink); }
  .pbx label.pbx-check input { margin-top: 3px; }
  .pbx select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .pbx-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .pbx-list li { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .pbx-list .nm { flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; }
  .pbx-list .st { color: var(--muted); font-size: 14px; flex: 1 1 100%; }
  .pbx-list .st.bad { color: var(--bad, #b00020); }
  .pbx-row { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { PHONE_FORMATS, toPhone, phoneFile, type PhoneFormat } from '../../lib/audio/pcm.ts';
  import { decodeFile, baseName, sizeText, secs, saveBytes, saveZip, player } from '../../lib/audio/browser.ts';
  const root = document.querySelector('.pbx') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const input = $<HTMLInputElement>('.pbx-file'), fmtSel = $<HTMLSelectElement>('.pbx-fmt'), norm = $<HTMLInputElement>('.pbx-norm');
  const list = $('.pbx-list'), err = $('.pbx-err'), sum = $('.pbx-sum'), all = $<HTMLButtonElement>('.pbx-all');
  type Item = { name: string; li: HTMLElement; src?: { rate: number; chans: Float32Array[] }; phone?: Float32Array; error?: string };
  let items: Item[] = [];
  const play = player();
  const fmt = () => fmtSel.value as PhoneFormat;
  const outName = (it: Item) => `${baseName(it.name)}.${PHONE_FORMATS[fmt()].ext}`;
  const bytesOf = (it: Item) => phoneFile(it.phone!, fmt());

  const render = (it: Item) => {
    const li = it.li; li.replaceChildren();
    const nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = it.name; li.append(nm);
    if (it.phone) {
      const p = document.createElement('button'); p.type = 'button'; p.className = 'btn secondary pbx-play'; p.textContent = 'Play';
      p.addEventListener('click', () => {
        if (play.playing && p.textContent === 'Stop') { play.stop(); p.textContent = 'Play'; return; }
        list.querySelectorAll('.pbx-play').forEach((b) => (b.textContent = 'Play'));
        p.textContent = 'Stop'; play.play([it.phone!], 8000, () => (p.textContent = 'Play'));
      });
      const d = document.createElement('button'); d.type = 'button'; d.className = 'btn pbx-save'; d.textContent = 'Download';
      d.addEventListener('click', () => saveBytes(bytesOf(it), outName(it), PHONE_FORMATS[fmt()].mime));
      li.append(p, d);
    }
    const st = document.createElement('span'); st.className = 'st' + (it.error ? ' bad' : '');
    st.textContent = it.error ?? (it.phone ? `${secs(it.phone.length / 8000)} → ${outName(it)}, ${sizeText(bytesOf(it).length)}` : 'Reading…');
    li.append(st);
  };
  const summary = () => {
    const ok = items.filter((i) => i.phone);
    $('.pbx-out').hidden = !items.length;
    all.hidden = ok.length < 2;
    all.textContent = `Download all ${ok.length} as a ZIP`;
    const total = ok.reduce((s, i) => s + bytesOf(i).length, 0);
    sum.textContent = ok.length ? `${ok.length} of ${items.length} file${items.length === 1 ? '' : 's'} ready, ${sizeText(total)} in all.` : '';
  };
  const convert = (it: Item) => { if (it.src) it.phone = toPhone(it.src, { normaliseDb: norm.checked ? -3 : null }); };

  const add = async (files: File[]) => {
    err.hidden = true;
    const room = 50 - items.length;
    if (files.length > room) { err.textContent = `Only 50 files at a time: ${files.length - Math.max(0, room)} were left out.`; err.hidden = false; files = files.slice(0, Math.max(0, room)); }
    const fresh = files.map((f) => { const li = document.createElement('li'); list.append(li); const it: Item = { name: f.name, li }; items.push(it); render(it); return [it, f] as const; });
    summary();
    for (const [it, f] of fresh) {
      if (f.size > 200e6) it.error = 'Too big: files up to 200 MB.';
      else try { it.src = await decodeFile(f); convert(it); if (!it.phone!.length) it.error = 'This file has no sound in it.'; }
      catch { it.error = 'This browser cannot read this file. Try MP3 or WAV.'; }
      if (it.error) it.phone = undefined;
      render(it); summary();
    }
  };

  $('.pbx-open').addEventListener('click', () => input.click());
  input.addEventListener('change', () => { if (input.files?.length) add([...input.files]); input.value = ''; });
  const drop = $('.pbx-drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); if (e.dataTransfer?.files.length) add([...e.dataTransfer.files]); });
  fmtSel.addEventListener('change', () => { items.forEach(render); summary(); });
  norm.addEventListener('change', () => { play.stop(); items.forEach((it) => { convert(it); render(it); }); summary(); });
  all.addEventListener('click', () => saveZip(items.filter((i) => i.phone).map((i) => ({ name: outName(i), bytes: bytesOf(i) })), `phone-audio-${fmt()}.zip`));
  $('.pbx-clear').addEventListener('click', () => { play.stop(); items = []; list.replaceChildren(); summary(); });
</script>
