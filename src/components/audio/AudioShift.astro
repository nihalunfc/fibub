---
// Shared page for #T971 Audio speed and #T972 Pitch shifter: speed a sound up or slow it down (keeping the pitch or not),
// or move its pitch without changing its length. Kit: src/lib/audio/stretch.ts (WSOLA; checks in tests/audio.mjs).
import { OUT_FORMATS } from '../../lib/audio/encode.ts';
interface Props { mode: 'speed' | 'pitch' }
const { mode } = Astro.props;
---
<div class="tool-ui ash" data-mode={mode}>
  <section class="panel">
    <div class="ash-drop">
      <button type="button" class="btn ash-open">Open a sound file</button>
      <input class="ash-file" type="file" accept="audio/*,.mp3,.wav,.ogg,.opus,.m4a,.aac,.flac,.webm,.mp4,.mov" hidden />
      <span class="ash-name">Or drop it here. MP3, WAV, M4A, OGG, FLAC, or a video's sound, up to 500 MB. It stays on this device.</span>
    </div>
    <p class="note bad ash-err" hidden></p>
  </section>

  <section class="panel ash-set" hidden>
    {mode === 'speed' ? (
      <div class="ash-grid">
        <label>Speed
          <select class="ash-pre">
            <option value="0.5">0.5× (half speed)</option><option value="0.75">0.75× (slower)</option><option value="0.9">0.9× (a little slower)</option>
            <option value="1.1">1.1× (a little faster)</option><option value="1.25" selected>1.25× (faster)</option><option value="1.5">1.5×</option>
            <option value="2">2× (double speed)</option><option value="custom">Other…</option>
          </select>
        </label>
        <label class="ash-cus-l" hidden>Speed (0.25 to 4) <input class="ash-cus" type="number" min="0.25" max="4" step="0.05" value="1.25" inputmode="decimal" /></label>
        <label class="ash-check"><input class="ash-keep" type="checkbox" checked /> Keep the pitch (voices sound natural)</label>
      </div>
    ) : (
      <div class="ash-grid">
        <label>Semitones (−12 to +12) <input class="ash-st" type="number" min="-12" max="12" step="1" value="2" inputmode="numeric" /></label>
        <label>Fine tune, cents (−50 to +50) <input class="ash-ct" type="number" min="-50" max="50" step="1" value="0" inputmode="numeric" /></label>
        <input class="ash-range" type="range" min="-12" max="12" step="1" value="2" aria-label="Semitones" />
      </div>
    )}
    <label class="ash-fmt-l">Save as
      <select class="ash-fmt">{Object.entries(OUT_FORMATS).filter(([k]) => k !== 'ulaw').map(([k, f]) => <option value={k}>{f.label}</option>)}</select>
    </label>
    <p class="ash-plan" aria-live="polite"></p>
    <div class="ash-row">
      <button type="button" class="btn secondary ash-orig">Play the original</button>
      <button type="button" class="btn secondary ash-play">Play the result</button>
      <button type="button" class="btn ash-save">Download</button>
    </div>
    <p class="ash-res" aria-live="polite"></p>
  </section>
  <p class="ash-fine">Your browser does the work on this device. Nothing is uploaded.</p>
</div>

<style is:inline>
  .ash { display: grid; gap: 14px; margin-bottom: 32px; }
  .ash .panel { display: grid; gap: 12px; padding: 16px; }
  .ash [hidden] { display: none !important; }
  .ash-drop { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; border: 2px dashed var(--line); border-radius: 12px; padding: 14px; }
  .ash-drop.over { border-color: var(--accent); }
  .ash-name, .ash-fine, .ash-plan, .ash-res { color: var(--muted); font-size: 14px; margin: 0; }
  .ash-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; align-items: end; }
  .ash label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .ash label.ash-check { display: flex; align-items: flex-start; gap: 8px; color: var(--ink); }
  .ash label.ash-check input { width: auto; margin-top: 3px; }
  .ash input, .ash select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .ash input[type=range] { padding: 0; border: 0; grid-column: 1 / -1; }
  .ash-row { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { OUT_FORMATS, encodeAs, estimateBytes, type OutFormat } from '../../lib/audio/encode.ts';
  import { changeSpeed, shiftPitch } from '../../lib/audio/stretch.ts';
  import type { Sound } from '../../lib/audio/pcm.ts';
  import { decodeFile, baseName, sizeText, secs, saveBytes, player } from '../../lib/audio/browser.ts';
  const root = document.querySelector('.ash') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const mode = root.dataset.mode as 'speed' | 'pitch';
  const input = $<HTMLInputElement>('.ash-file'), err = $('.ash-err'), plan = $('.ash-plan'), res = $('.ash-res');
  const playB = $<HTMLButtonElement>('.ash-play'), origB = $<HTMLButtonElement>('.ash-orig'), saveB = $<HTMLButtonElement>('.ash-save'), fmtSel = $<HTMLSelectElement>('.ash-fmt');
  const play = player();
  let snd: Sound | null = null, name = 'sound', made: { key: string; s: Sound } | null = null;

  const speed = () => { const p = $<HTMLSelectElement>('.ash-pre').value; return Math.min(4, Math.max(0.25, p === 'custom' ? +$<HTMLInputElement>('.ash-cus').value || 1 : +p)); };
  const keep = () => $<HTMLInputElement>('.ash-keep').checked;
  const semis = () => Math.max(-12, Math.min(12, Math.round(+$<HTMLInputElement>('.ash-st').value || 0)));
  const cents = () => Math.max(-50, Math.min(50, Math.round(+$<HTMLInputElement>('.ash-ct').value || 0)));
  const key = () => (mode === 'speed' ? `s${speed()}${keep()}` : `p${semis()},${cents()}`);
  const outLen = () => (snd ? snd.chans[0].length / snd.rate / (mode === 'speed' ? speed() : 1) : 0);
  const sign = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '') + Math.abs(n);
  const suffix = () => (mode === 'speed' ? `${speed()}x` : `${semis() >= 0 ? 'up' : 'down'}${Math.abs(semis())}${cents() ? `-${cents()}c` : ''}`);

  const update = () => {
    if (mode === 'speed') $('.ash-cus-l').hidden = $<HTMLSelectElement>('.ash-pre').value !== 'custom';
    if (!snd) return;
    const len = snd.chans[0].length / snd.rate, f = fmtSel.value as OutFormat;
    const size = sizeText(estimateBytes(outLen(), snd.rate, snd.chans.length, f));
    plan.textContent = mode === 'speed'
      ? `${secs(len)} becomes ${secs(outLen())} at ${speed()}×` + (keep() ? ', same pitch' : `, pitch ${speed() > 1 ? 'up' : 'down'} ${Math.abs(12 * Math.log2(speed())).toFixed(1)} semitones`) + `. About ${size}.`
      : `Pitch ${sign(semis())} semitones${cents() ? ` ${sign(cents())} cents` : ''} (every note × ${Math.pow(2, (semis() + cents() / 100) / 12).toFixed(3)} in frequency), same length ${secs(len)}. About ${size}.`;
  };
  const result = async () => {
    if (!snd) return null;
    const k = key();
    if (made?.key === k) return made.s;
    res.textContent = 'Working…'; await new Promise((r) => setTimeout(r, 20));
    const t0 = performance.now();
    const s = mode === 'speed' ? changeSpeed(snd, speed(), keep() ? 'keep-pitch' : 'tape') : shiftPitch(snd, semis(), cents());
    made = { key: k, s };
    res.textContent = `Ready in ${((performance.now() - t0) / 1000).toFixed(1)} s: ${secs(s.chans[0].length / s.rate)}.`;
    return s;
  };
  const open = async (f: File) => {
    err.hidden = true; play.stop(); made = null; snd = null; $('.ash-set').hidden = true; res.textContent = '';
    if (f.size > 500e6) { err.textContent = 'Too big: files up to 500 MB.'; err.hidden = false; return; }
    $('.ash-name').textContent = `${f.name}: reading…`; name = baseName(f.name);
    try { snd = await decodeFile(f); if (!snd.chans[0]?.length) throw new Error('empty'); }
    catch { snd = null; err.textContent = 'This browser cannot read the sound in this file (or it has none). Chrome and Edge read the most kinds.'; err.hidden = false; $('.ash-name').textContent = f.name; return; }
    $('.ash-name').textContent = `${f.name}: ${secs(snd.chans[0].length / snd.rate)}, ${snd.chans.length === 1 ? 'mono' : 'stereo'}, ${snd.rate.toLocaleString('en-US')} Hz.`;
    $('.ash-set').hidden = false; update();
  };
  const busy = async (b: HTMLButtonElement, fn: () => Promise<void>) => { b.disabled = true; try { await fn(); } catch { err.textContent = 'Something went wrong while working on this sound. Try a shorter file.'; err.hidden = false; } b.disabled = false; };
  playB.addEventListener('click', () => busy(playB, async () => {
    if (playB.textContent === 'Stop') { play.stop(); playB.textContent = 'Play the result'; return; }
    const s = await result(); if (!s) return;
    origB.textContent = 'Play the original'; playB.textContent = 'Stop';
    await play.play(s.chans, s.rate, () => (playB.textContent = 'Play the result'));
  }));
  origB.addEventListener('click', async () => {
    if (!snd) return;
    if (origB.textContent === 'Stop') { play.stop(); origB.textContent = 'Play the original'; return; }
    playB.textContent = 'Play the result'; origB.textContent = 'Stop';
    await play.play(snd.chans, snd.rate, () => (origB.textContent = 'Play the original'));
  });
  saveB.addEventListener('click', () => busy(saveB, async () => {
    const s = await result(); if (!s) return;
    const f = fmtSel.value as OutFormat;
    saveBytes(await encodeAs(s, f), `${name}-${suffix()}.${OUT_FORMATS[f].ext}`, OUT_FORMATS[f].mime);
  }));
  root.querySelectorAll('select, input:not([type=file])').forEach((el) => el.addEventListener('input', () => {
    if (el.classList.contains('ash-range')) $<HTMLInputElement>('.ash-st').value = (el as HTMLInputElement).value;
    if (el.classList.contains('ash-st')) { const r = root.querySelector('.ash-range') as HTMLInputElement | null; if (r) r.value = String(semis()); }
    update();
  }));
  $('.ash-open').addEventListener('click', () => input.click());
  input.addEventListener('change', () => { if (input.files?.[0]) open(input.files[0]); input.value = ''; });
  const drop = $('.ash-drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); const f = e.dataTransfer?.files[0]; if (f) open(f); });
</script>
