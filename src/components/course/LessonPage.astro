---
// One lesson of a long text course: the side list, the text with its figures, the quiz, then Done and Next.
import Base from '../../layouts/Base.astro';
import CourseSidebar from './CourseSidebar.astro';
import LessonQuiz from './LessonQuiz.astro';
import { splitFigures, type LessonEntry } from '../../lib/course';
import { flatLessons, type CourseSyllabus } from '../../courses/types';
import '../../styles/course.css';
interface Props { course: CourseSyllabus; entry: LessonEntry; slug: string; live: Set<string>; figures: Record<string, any> }
const { course, entry, slug, live, figures } = Astro.props;
const all = flatLessons(course);
const i = all.findIndex((l) => l.slug === slug), me = all[i];
const liveAll = all.filter((l) => live.has(l.slug));
const li = liveAll.findIndex((l) => l.slug === slug);
const prev = liveAll[li - 1], next = liveAll[li + 1];
const parts = splitFigures(entry.rendered?.html ?? '');
for (const p of parts) if (p.fig && !figures[p.fig]) throw new Error(`lesson ${slug}: unknown figure ${p.fig}`);
const d = entry.data;
---
<Base title={`${me.n} ${d.title}`} docTitle={`${d.title} | ${course.name} course | fibub`} description={d.summary}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/courses/">Courses</a> / <a href={`/learn/courses/${course.id}/`}>{course.name}</a> / Lesson {me.n}</div>
  <div class="cs-layout" data-course={course.id} data-total={all.length} data-lesson={slug}>
    <CourseSidebar course={course} live={live} current={slug} />
    <article class="cs-main cs-lesson">
      <p class="cs-kicker">Module {me.module.n}: {me.module.name} · Lesson {me.n} · about {d.minutes} min</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <div class="cs-body">
        {parts.map((p) => { if (p.fig) { const F = figures[p.fig]; return <F />; } return <Fragment set:html={p.html} />; })}
      </div>
      <LessonQuiz quiz={d.quiz} />
      {d.sources.length > 0 && <section class="cs-sources"><h2>Sources</h2><ul>{d.sources.map((s) => <li set:html={s.replace(/(https?:\/\/[^\s)]+)/g, '<a href="$1" rel="noopener">$1</a>')} />)}</ul></section>}
      <div class="cs-end">
        <button type="button" class="btn" data-mark-done>Mark this lesson as done</button>
        <p class="cs-small">Your ticks stay in this browser. Save them as a file on the <a href={`/learn/courses/${course.id}/#progress`}>course home</a>.</p>
      </div>
      <nav class="cs-pn" aria-label="Previous and next lesson">
        {prev ? <a href={`/learn/courses/${course.id}/${prev.slug}/`}>← {prev.n} {prev.title}</a> : <span />}
        {next ? <a class="cs-next" href={`/learn/courses/${course.id}/${next.slug}/`}>{next.n} {next.title} →</a> : <a class="cs-next" href={`/learn/courses/${course.id}/`}>Course home →</a>}
      </nav>
      <p class="cs-small">Updated {d.updated.toISOString().slice(0, 10)}. Prices and model names change fast: check the official source before you buy.</p>
    </article>
  </div>
</Base>
<script>import '../../scripts/course';</script>
