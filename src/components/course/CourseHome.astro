---
// A long text course's home page: what it is, progress, then every module and lesson (written ones linked).
import Base from '../../layouts/Base.astro';
import CourseSidebar from './CourseSidebar.astro';
import ProgressBox from './ProgressBox.astro';
import CourseSiblings from '../learn/CourseSiblings.astro';
import { COURSES, COURSE_CATS } from '../../data/curricula';
import '../../styles/learn.css';
import { courseLessons } from '../../lib/course';
import { flatLessons, type CourseSyllabus } from '../../courses/types';
import { courseLd, courseImage } from '../../lib/seo';
import { lessonMinutes, fmtStudy } from '../../lib/studytime';
import { LEVELS } from '../../data/curricula';
import CountStrip from '../CountStrip.astro';
import { questionTotals, examsFor } from '../../lib/qtotals';
import '../../styles/course.css';
// compact: one line per module (links to each lesson by number) for very long courses, so the page stays under 120 KB;
// the sidebar still lists every lesson by name. Its Course data then lists the teaching lessons, not the
// "question types" pages (each page still has its own data).
interface Props { course: CourseSyllabus; compact?: boolean }
const { course, compact = false } = Astro.props;
const written = await courseLessons(course);
const live = new Set(written.keys());
const all = flatLessons(course);
const cat = COURSE_CATS.find((k) => k.id === COURSES.find((c) => c.id === course.id)?.cat);
const minutes = [...written.values()].reduce((s, e) => s + lessonMinutes(e), 0);
const level = LEVELS.find((l) => l.id === COURSES.find((c) => c.id === course.id)?.level);
// Exam courses: the course's practice questions per exam, counted from the question banks at build time.
const mine = new Set(examsFor(course.id).map((e) => e.id));
const examNums = mine.size ? (await questionTotals()).exams.filter((e) => mine.has(e.id)) : [];
const ld = courseLd(course, all.filter((l) => live.has(l.slug) && !(compact && l.slug.endsWith('-questions'))).map((l) => ({ name: `${l.n} ${l.title}`, url: `/learn/courses/${course.id}/${l.slug}/` })), minutes / 60);
---
<Base title={`${course.name}: free course`} description={course.text} ld={ld} image={courseImage(course.id)}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/">Learn</a> / {cat ? <a href={cat.href}>{cat.short}</a> : <a href="/learn/courses/">Courses</a>} / {course.name}</div>
  <div class="cs-layout" data-course={course.id} data-total={all.length}>
    <CourseSidebar course={course} live={live} />
    <div class="cs-main">
      <h1>{course.title}</h1>
      <p class="lead">{course.text}</p>
      <p class="cs-meta">{course.audience} Free, no sign-up. {level ? `${level.name} level (${level.text.toLowerCase()}). ` : ''}{live.size === all.length ? `All ${all.length} lessons, about ${fmtStudy(minutes)} of study.` : `${live.size} of ${all.length} lessons written so far (about ${fmtStudy(minutes)} of study); new modules are added in order.`}</p>
      {examNums.length > 0 && <CountStrip counts={[{ value: live.size, label: 'lessons' }]} exams={examNums} label="This course in numbers" examsLabel="Practice questions" />}
      <slot />
      <ProgressBox total={all.length} />
      <h2>All modules</h2>
      {course.parts.map((p) => <>
        <h3 class="cs-parth">{p.name}</h3>
        {p.modules.map((m) => {
          const n = m.lessons.filter((l) => live.has(l[1])).length;
          if (compact) return (
            <p class="cs-modline"><span class="cs-n">{m.n}</span> {n ? <a href={`/learn/courses/${course.id}/${m.lessons.find((l) => live.has(l[1]))![1]}/`}>{m.name}</a> : m.name}{m.lessons.length > 1 && n > 0 && <> · {m.lessons.filter((l) => live.has(l[1])).map(([num, slug], i) => <>{i > 0 && ', '}<a href={`/learn/courses/${course.id}/${slug}/`} data-lesson={slug}>{num}</a></>)}</>}{n === 0 && <span class="ar-tag"> Coming soon</span>}</p>
          );
          return (
            <section class="cs-modcard">
              <h4><span class="cs-n">{m.n}</span> {m.name} <span class:list={['ar-tag', { live: n > 0 }]}>{n === 0 ? 'Coming soon' : n === m.lessons.length ? `${n} lessons` : `${n} of ${m.lessons.length} written`}</span></h4>
              <ol>{m.lessons.map(([num, slug, title]) => <li>{live.has(slug) ? <a href={`/learn/courses/${course.id}/${slug}/`} data-lesson={slug}><span class="cs-n">{num}</span> {title}</a> : <span class="cs-soon"><span class="cs-n">{num}</span> {title}</span>}</li>)}</ol>
            </section>
          );
        })}
      </>)}
      <CourseSiblings id={course.id} />
    </div>
  </div>
</Base>
<script>import '../../scripts/course';</script>
