---
// A Learn category page (/learn/data-ai/, /learn/science/, /learn/life-skills/): its courses as compact
// cards, the tools that go with them, then links to the other hubs. Courses join by their `cat` in
// COURSES (src/data/curricula.ts); nothing to add here when a course is published.
import Base from '../../layouts/Base.astro';
import CourseCard from './CourseCard.astro';
import LearnMore from './LearnMore.astro';
import { courseCards, cardsIn } from '../../lib/learn';
import { COURSE_CATS, type CourseCat } from '../../data/curricula';
import { allTools, toolUrl } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
import { hubHeadline } from '../../lib/headline';
import CountStrip from '../CountStrip.astro';
import '../../styles/area.css';
import '../../styles/learn.css';
interface Props { cat: CourseCat; lead: string; docTitle: string; description: string; tools?: string[]; toolsTitle?: string }
const { cat, lead, docTitle, description, tools: ids = [], toolsTitle = 'Tools that go with these courses' } = Astro.props;
const k = COURSE_CATS.find((c) => c.id === cat)!;
const cs = cardsIn(await courseCards(), cat);
const live = cs.filter((c) => c.status === 'live'), soon = cs.filter((c) => c.status !== 'live');
const all = await allTools();
const tools = ids.map((id) => all.find((t) => t.id === id && t.data.status === 'live')).filter((t) => !!t);
const nums = await hubHeadline(cat);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Learn', url: '/learn/' }, { name: k.name, url: k.href }];
---
<Base title={`Learn: ${k.name}`} docTitle={docTitle} description={description} ld={collectionLd(k.name, description, k.href, crumbs)}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/">Learn</a> / {k.name}</div>
  <div class="lh-head">
    <h1>{k.name}</h1>
    <p class="lead">{lead}</p>
  </div>
  <CountStrip counts={nums.counts} exams={nums.exams} label={`${k.name} in numbers`} />
  <section class="lh-cont" data-continue hidden aria-label="Continue where you left off"><h2>Continue where you left off</h2><ul></ul></section>
  {live.length > 0 && <>
    <div class="lh-sec"><h2>Courses <small class="lh-sub">({live.length})</small></h2></div>
    <div class="lh-grid lh-anim">{live.map((c, i) => <CourseCard c={c} i={i} />)}</div>
  </>}
  <slot />
  {tools.length > 0 && <>
    <div class="lh-sec"><h2>{toolsTitle}</h2></div>
    <ul class="lh-chips">{tools.map((t) => <li><a href={toolUrl(t!)}>{t!.data.name}</a></li>)}</ul>
  </>}
  {soon.length > 0 && <details class="lh-all lh-soon"><summary>Coming soon ({soon.length})</summary><ul>{soon.map((c) => <li><strong>{c.name}</strong>: {c.text}</li>)}</ul></details>}
  <LearnMore here={cat} />
  <p class="ar-note">Every course is free, with no sign-up. Your progress stays in your own browser: tick "Remember my progress" on a course to keep it on this device.</p>
</Base>
<script>import '../../scripts/learn';</script>
