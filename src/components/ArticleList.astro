---
// A list of Blog articles: title, kind, date and summary.
import { articleUrl, kindOf, KINDS, type Article } from '../lib/blog';
interface Props { articles: Article[]; showKind?: boolean }
const { articles, showKind = true } = Astro.props;
const one = (a: Article) => KINDS.find((k) => k.id === kindOf(a))!.one;
---
<ul class="al">
  {articles.map((a) => (
    <li>
      <a href={articleUrl(a)}>{a.data.title}</a>
      <span class="al-meta">{showKind && <>{one(a)} · </>}<time datetime={a.data.updated.toISOString().slice(0, 10)}>{a.data.updated.toISOString().slice(0, 10)}</time>{a.data.level && <> · {a.data.level}</>}</span>
      <p>{a.data.summary}</p>
    </li>
  ))}
</ul>
<style>
  .al { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; max-width: 760px; }
  .al li { padding: 12px 0; border-bottom: 1px solid var(--line); }
  .al a { font-weight: 700; font-size: 17px; color: var(--ink); text-decoration: none; }
  .al a:hover { color: var(--accent); text-decoration: underline; }
  .al-meta { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }
  .al p { margin: 4px 0 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
</style>
