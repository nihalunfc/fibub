---
import '../styles/global.css';
import { SITE, SHELVES } from '../site';
import { mark } from '../lib/brand';
import { ICONS } from '../lib/icons';
import { allTools, bySection, toolUrl } from '../lib/tools';
// The header menu: on computers each shelf opens a panel listing its tools, grouped by section.
const tools = await allTools();
const menus = SHELVES.map((s) => ({ shelf: s, groups: bySection(s.id, tools.filter((t) => t.data.status === 'live')) }));
interface Props { title: string; description?: string; shelf?: string; noindex?: boolean; image?: string }
const { title, description = SITE.description, shelf, noindex = false, image = '/og/home.png' } = Astro.props;
const imageUrl = new URL(image, SITE.url).href;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fibub" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title === SITE.name ? 'fibub: free tools, no sign-up' : `${title}: free, no sign-up, on fibub.com`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d111a" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="/" aria-label="fibub home"><Fragment set:html={mark()} /><span class="logo-t">fi<span>bub</span></span></a>
        <nav class="main" aria-label="Shelves">
          {menus.map(({ shelf: s, groups }) => (
            <div class="dd" data-shelf={s.id}>
              <a href={`/${s.id}/`} aria-current={shelf === s.id ? 'page' : undefined} aria-haspopup="true">{s.name}<svg class="dd-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
              <div class="dd-panel" role="menu" aria-label={`${s.name} tools`}>
                <div class="dd-cols" style={`--cols:${Math.min(3, Math.max(1, groups.length > 1 ? groups.length : Math.ceil(groups[0]?.tools.length / 6 || 1)))}`}>
                  {groups.map((g) => (
                    <div class="dd-group">
                      {g.name && <b class="dd-h">{g.name}</b>}
                      {g.tools.map((t) => (
                        <a class="dd-item" role="menuitem" href={toolUrl(t)}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[t.data.icon]} />
                          <span>{t.data.name}</span>{t.data.num && <small class="num">#{t.data.num}</small>}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
                <a class="dd-all" href={`/${s.id}/`}>All {s.name.toLowerCase()} tools →</a>
              </div>
            </div>
          ))}
        </nav>
        <button type="button" class="menu-btn" aria-expanded="false" aria-controls="all-tools"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>Tools</button>
      </div>
      <nav id="all-tools" class="all-tools" aria-label="All tools" hidden>
        <div class="at-top">
          <input type="search" class="at-search" placeholder="Find a tool…" aria-label="Find a tool" autocomplete="off" />
          <button type="button" class="at-close" aria-label="Close the tool list">✕</button>
        </div>
        <div class="at-mine" hidden>
          <div class="at-h"><b>My tools</b><button type="button" class="at-clear">Clear</button></div>
          <div class="at-mine-list"></div>
          <p class="at-note">Saved only in this browser, never sent anywhere.</p>
        </div>
        {menus.map(({ shelf: s, groups }) => (
          <section class="at-shelf" data-shelf={s.id}>
            <a class="at-shelf-h" href={`/${s.id}/`}>{s.name} <span>All →</span></a>
            {groups.map((g) => (
              <div class="at-group">
                {g.name && <b class="at-sub">{g.name}</b>}
                {g.tools.map((t) => (
                  <a class="at-item" href={toolUrl(t)} data-id={t.id} data-num={t.data.num} data-search={`${t.data.name} ${t.data.summary} ${s.name} ${g.name ?? ''}`.toLowerCase()}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[t.data.icon]} />
                    <span>{t.data.name}</span>{t.data.num && <small class="num">#{t.data.num}</small>}
                  </a>
                ))}
              </div>
            ))}
          </section>
        ))}
        <p class="at-empty" hidden>No tool matches that yet.</p>
      </nav>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <div class="row">
          <span><b>fibub</b>: Free In-Browser Utility Bubble. Your files stay on your device.</span>
          <nav aria-label="Site"><a href="/about/">About</a><a href="/stats/">Usage stats</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></nav>
        </div>
        <span><a href={SITE.maker.url} rel="author">Developer</a></span>
      </div>
    </footer>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
