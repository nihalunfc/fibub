---
// A subject's own page (/science/physics/): its sections as headings and every tool as a plain row,
// with a filter box and a jump list when there are many sections.
import Base from '../layouts/Base.astro';
import { type SubjectGroup } from '../lib/tools';
import { useLang } from '../i18n';
interface Props { shelf: string; subject: SubjectGroup; lang: string }
const L = useLang(Astro.props.lang);
const toolUrl = L.toolUrl;
const shelf = L.shelf(Astro.props.shelf);
const subject = { ...L.subject(Astro.props.subject), groups: Astro.props.subject.groups.map((g) => L.section(g)) };
const star = '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z"/>';
---
<Base title={L.t('subjectTools', { subject: subject.name })} description={L.t('subjectDescription', { n: subject.count, subject: subject.name, blurb: subject.blurb })} shelf={shelf.id} lang={L.code} i18n>
  <div class="crumbs"><a href={L.url('/')}>{L.t('home')}</a> / <a href={L.url(`/${shelf.id}/`)}>{shelf.name}</a> / {subject.name}</div>
  <h1>{L.t('subjectTools', { subject: subject.name })}</h1>
  <p class="lead">{L.t('subjectLead', { n: subject.count, blurb: subject.blurb })}</p>
  {subject.count > 8 && (
    <label class="find sp-find"><span class="visually-hidden">{L.t('findSubjectTool', { subject: subject.name })}</span><input type="search" placeholder={L.t('findSubjectTool', { subject: subject.name })} autocomplete="off" /></label>
  )}
  {subject.groups.length > 3 && (
    <nav class="jump" aria-label={L.t('sectionsAria')}>{subject.groups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}</nav>
  )}
  <div class="secs">
    {subject.groups.map((g) => (
      <section class="sec" id={g.id}>
        <h2>{g.name} <small>{g.tools.length}</small></h2>
        {g.blurb && <p class="blurb">{g.blurb}</p>}
        <ul class="ix">
          {g.tools.map((t) => (
            <li class="ti" data-id={t.id} data-num={t.data.num} data-search={`${t.data.name} ${L.summary(t)} ${t.data.summary} #${t.data.num}`.toLowerCase()}>
              <a href={toolUrl(t)}><span class="nm">{t.data.name}</span><span class="sm">{L.summary(t)}</span></a>
              <span class="num">#{t.data.num}</span>
              <button type="button" class="pin" aria-pressed="false" aria-label={L.t('addMine', { name: t.data.name })} title={L.t('addMineShort')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" set:html={star} /></button>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
  <p class="sp-empty" hidden set:html={L.rich('noSubjectMatch', { subject: subject.name })} />
</Base>

<style>
  .sp-find { margin-bottom: 14px; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .jump a { font-size: 13.5px; color: var(--ink); text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; }
  .jump a:hover { border-color: var(--ink); }
  .secs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 0 40px; align-items: start; }
  .sec h2 { display: flex; align-items: baseline; gap: 8px; font-size: 18px; margin: 24px 0 4px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); }
  .sec h2 small { font-size: 13px; font-weight: 500; color: var(--muted); }
  .blurb { margin: 6px 0 2px; font-size: 14px; color: var(--muted); }
  .sp-empty { color: var(--muted); }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('.sp-find input');
  if (input) {
    const rows = [...document.querySelectorAll<HTMLElement>('.secs .ti')];
    const empty = document.querySelector<HTMLElement>('.sp-empty')!;
    input.addEventListener('input', () => {
      const ws = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const r of rows) { const ok = ws.every((w) => r.dataset.search!.includes(w)); r.hidden = !ok; if (ok) shown++; }
      document.querySelectorAll<HTMLElement>('.secs .sec').forEach((s) => (s.hidden = !s.querySelector('.ti:not([hidden])')));
      empty.hidden = shown > 0;
    });
  }
</script>
