---
// #1492 Rolling race. Engine: src/lib/learn/ (quiz.ts, sim.ts). A teaching model: a ring, a disc, a solid sphere and a
// frictionless sliding block released together on a ramp; a = g sinθ ÷ (1 + I/mr²), rolling without slipping.
import '../../styles/astro.css';
import '../../styles/learnquiz-d.css';
---
<div class="tool-ui ax lrn rr">
  <div class="ax-card">
    <h2>Who gets down first?</h2>
    <canvas class="lrn-cv rr-cv" aria-label="Four racers in lanes seen from above, a ring, a disc, a sphere and a sliding block, on their way down a ramp"></canvas>
    <div class="ax-grid" style="margin-top:10px">
      <label class="lrn-sl">Ramp angle θ: <b class="rr-av"></b><input class="rr-a" type="range" min="5" max="45" step="5" value="30" /></label>
      <label class="lrn-sl">Ramp length: <b class="rr-lv"></b><input class="rr-l" type="range" min="1" max="3" step="0.5" value="2" /></label>
    </div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn rr-go">Release</button><button type="button" class="btn secondary rr-reset">Reset</button></div>
    <p class="ax-help">A teaching model: all four start together, the three rolling ones do not slip, the block has no friction. Slowed down to watch. g = 9.8 m/s².</p>
  </div>
  <div class="ax-card">
    <h2>Results</h2>
    <table class="rr-tab"><thead><tr><th>Racer</th><th>I ÷ mr²</th><th>a (m/s²)</th><th>Time</th></tr></thead><tbody class="rr-rows"></tbody></table>
    <p class="lrn-eq rr-eq"></p>
  </div>
  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lrn-try">
      <li>Release them. The block wins, then the sphere, then the disc, and the ring is last.</li>
      <li>The order never changes with the angle or the length. Only the times do.</li>
      <li>The mass and the size of the rolling bodies do not matter: they cancel out of a.</li>
      <li>A rolling body must turn as well as move, so part of its energy is spent on spinning. The more mass near the rim, the more is spent.</li>
    </ul>
  </div>
  <div class="ax-card rr-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<style is:inline>
  .rr .rr-cv { width: 100%; }
  .rr .rr-tab { width: 100%; border-collapse: collapse; font-size: 15px; }
  .rr .rr-tab th, .rr .rr-tab td { text-align: left; padding: 6px 8px 6px 0; border-bottom: 1px solid var(--line); }
  .rr .rr-tab th { font-size: 13px; color: var(--muted); font-weight: 600; }
  .rr .rr-eq { margin: 8px 0 0; }
</style>

<script>
  import { mountQuiz, pick, one, r } from '../../lib/learn/quiz';
  import { fitCanvas, pagePalette } from '../../lib/learn/sim';
  const G = 9.8;
  const RACERS = [
    { name: 'Ring', k: 1 },
    { name: 'Disc', k: 0.5 },
    { name: 'Sphere', k: 0.4 },
    { name: 'Block (sliding)', k: 0 },
  ];
  const root = document.querySelector('.rr') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const val = (c: string) => Number(q<HTMLInputElement>(c).value);
  const f = (x: number) => String(+x.toPrecision(3));
  const accel = (th: number, k: number) => (G * Math.sin((th * Math.PI) / 180)) / (1 + k);
  const timeOf = (L: number, a: number) => Math.sqrt((2 * L) / a);

  let t = 0, running = false, raf = 0, last = 0;
  const SLOW = 0.6;
  function draw() {
    const th = val('.rr-a'), L = val('.rr-l'), pal = pagePalette(), { ctx, W, H } = fitCanvas(q<HTMLCanvasElement>('.rr-cv'), 230);
    ctx.clearRect(0, 0, W, H);
    const x0 = 78, x1 = W - 20, laneH = 46, y0 = 22, R = 14;
    ctx.font = '12px system-ui, sans-serif'; ctx.textAlign = 'left';
    ctx.fillStyle = pal.muted; ctx.fillText('seen from above', 8, 14);
    RACERS.forEach((rc, i) => {
      const a = accel(th, rc.k), d = Math.min(L, 0.5 * a * t * t), y = y0 + 14 + i * laneH + R, cx = x0 + R + ((x1 - x0 - 2 * R) * d) / L;
      ctx.strokeStyle = pal.line; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x0, y + R + 4); ctx.lineTo(x1, y + R + 4); ctx.stroke();
      ctx.fillStyle = pal.ink; ctx.fillText(rc.name.replace(' (sliding)', ''), 6, y + 4);
      ctx.strokeStyle = pal.accent; ctx.fillStyle = pal.accent; ctx.lineWidth = 3;
      const turn = rc.k > 0 ? (((x1 - x0 - 2 * R) * d) / L) / R : 0;
      if (i === 0) { ctx.beginPath(); ctx.arc(cx, y, R - 1.5, 0, 7); ctx.stroke(); }
      else if (i === 1) { ctx.globalAlpha = 0.35; ctx.beginPath(); ctx.arc(cx, y, R, 0, 7); ctx.fill(); ctx.globalAlpha = 1; ctx.beginPath(); ctx.arc(cx, y, R, 0, 7); ctx.lineWidth = 2; ctx.stroke(); }
      else if (i === 2) { ctx.beginPath(); ctx.arc(cx, y, R, 0, 7); ctx.fill(); }
      else { ctx.fillRect(cx - R, y - R * 0.7, 2 * R, 1.4 * R); }
      if (rc.k > 0) { ctx.strokeStyle = i === 2 ? pal.bg : pal.ink; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(cx, y); ctx.lineTo(cx + Math.cos(turn) * (R - 2), y + Math.sin(turn) * (R - 2)); ctx.stroke(); }
      if (d >= L) { ctx.fillStyle = pal.good; ctx.fillText(`${f(timeOf(L, a))} s`, cx - 18, y - R - 3); }
    });
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(x1, y0 + 8); ctx.lineTo(x1, y0 + 14 + 4 * laneH); ctx.stroke();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'right'; ctx.fillText('finish', x1, y0 + 4);
  }
  function info() {
    const th = val('.rr-a'), L = val('.rr-l');
    q('.rr-av').textContent = `${th}°`; q('.rr-lv').textContent = `${L} m`;
    const res = RACERS.map((rc) => { const a = accel(th, rc.k); return { ...rc, a, tm: timeOf(L, a) }; });
    const td = (s: string) => { const e = document.createElement('td'); e.textContent = s; return e; };
    q('.rr-rows').replaceChildren(...res.map((x) => { const tr = document.createElement('tr'); tr.append(td(x.name), td(x.k ? String(x.k) : '0 (no rolling)'), td(f(x.a)), td(`${f(x.tm)} s`)); return tr; }));
    q('.rr-eq').textContent = `a = g sinθ ÷ (1 + I/mr²). Sphere: ${f(G)} × sin ${th}° ÷ 1.4 = ${f(res[2].a)} m/s². Time from rest: t = √(2L ÷ a) = ${f(res[2].tm)} s. Order: ${[...res].sort((p, s) => p.tm - s.tm).map((x) => x.name.replace(' (sliding)', '')).join(', then ')}.`;
  }
  function frame(now: number) {
    const dt = last ? Math.min(0.05, (now - last) / 1000) : 0; last = now;
    t += dt * SLOW; draw();
    const th = val('.rr-a'), L = val('.rr-l');
    if (t > timeOf(L, accel(th, 1)) + 0.4) { running = false; raf = 0; return; }
    raf = requestAnimationFrame(frame);
  }
  const reset = () => { cancelAnimationFrame(raf); raf = 0; running = false; t = 0; last = 0; draw(); };
  q('.rr-go').addEventListener('click', () => { reset(); running = true; if (matchMedia('(prefers-reduced-motion: reduce)').matches) { t = 1e3; draw(); running = false; return; } raf = requestAnimationFrame(frame); });
  q('.rr-reset').addEventListener('click', reset);
  root.querySelectorAll('.lrn-sl input').forEach((i) => i.addEventListener('input', () => { reset(); info(); }));
  addEventListener('resize', draw);
  mountQuiz(q('.rr-quiz'), () => {
    const L = pick(1, 4), th = 30, aS = accel(th, 0.4), aD = accel(th, 0.5), aB = accel(th, 0);
    const fac = one(['ring', 'disc']);
    return [
      { q: `A solid sphere rolls down a ${th}° ramp without slipping. Its acceleration, with g = 9.8 and I = 0.4 mr²?`, ans: aS, unit: 'm/s²', work: `a = g sinθ ÷ (1 + I/mr²) = 9.8 × 0.5 ÷ 1.4 = ${r(aS)} m/s²` },
      { q: `Which reaches the bottom first: a ring, a disc or a solid sphere (all rolling, same ramp)?`, choices: ['Ring', 'Disc', 'Solid sphere'], ans: 2, work: 'The smaller I/mr² is, the less energy goes into spinning and the bigger a is. Sphere 0.4 < disc 0.5 < ring 1.' },
      { q: `A frictionless block slides ${L} m down a ${th}° ramp from rest. How long does it take?`, ans: timeOf(L, aB), unit: 's', work: `a = g sinθ = ${r(aB)} m/s², t = √(2L ÷ a) = √(${2 * L} ÷ ${r(aB)}) = ${r(timeOf(L, aB))} s` },
      { q: `A ${fac} rolls ${L} m down a ${th}° ramp from rest. How long does it take?`, ans: timeOf(L, fac === 'ring' ? accel(th, 1) : aD), unit: 's', work: `a = ${fac === 'ring' ? '9.8 × 0.5 ÷ 2' : '9.8 × 0.5 ÷ 1.5'} = ${r(fac === 'ring' ? accel(th, 1) : aD)} m/s², t = √(2L ÷ a) = ${r(timeOf(L, fac === 'ring' ? accel(th, 1) : aD))} s` },
    ];
  });
  reset(); info();
</script>
