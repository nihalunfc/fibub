    <p class="ax-help ir-note"></p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small ir-csv-i">Items (CSV)</button><button type="button" class="btn secondary small ir-csv-p">Scores (CSV)</button></div>
