---
// Statement and converse checker: pick an "If P, then Q" statement, test it and its converse on random figures or
// numbers, and hunt for a counterexample. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
import { STATEMENTS } from '../../lib/sci/converse-school';
---
<div class="ax sm cv">
  <div class="ax-card">
    <h2>Pick a statement</h2>
    <label>Statement
      <select class="cv-pick">{STATEMENTS.map((s) => <option value={s.id}>{s.short}</option>)}</select>
    </label>
    <dl class="ax-facts cv-pair" style="margin-top:12px">
      <div><dt>Statement</dt><dd class="cv-s"></dd></div>
      <div><dt>Converse (swap the two parts)</dt><dd class="cv-c"></dd></div>
    </dl>
    <p class="ax-help">Before you test: which do you think is always true? Then test both.</p>
    <div class="ax-row">
      <button type="button" class="btn cv-ts">Test the statement</button>
      <button type="button" class="btn cv-tc">Test the converse</button>
    </div>
  </div>

  <div class="ax-card">
    <h2>Random tests</h2>
    <svg class="sm-fig cv-fig" viewBox="0 0 340 230" role="img" aria-label="The example being tested"></svg>
    <p class="ax-big cv-big" aria-live="polite">Press a Test button.</p>
    <p class="sm-f cv-desc"></p>
    <p class="ax-help cv-tally"></p>
    <div class="ax-row"><button type="button" class="btn secondary small cv-prev" disabled>Previous</button><button type="button" class="btn secondary small cv-next" disabled>Next example</button><button type="button" class="btn secondary small cv-jump" hidden>Show the counterexample</button></div>
    <div class="cv-verdict" hidden>
      <h3 style="margin:14px 0 4px">Why</h3>
      <p class="sm-f cv-why"></p>
    </div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Square: test the converse and find a rectangle or a trapezium with equal diagonals.</li>
      <li>Rhombus: the counterexamples for the converse look like kites. What is different about their sides?</li>
      <li>Isosceles triangle and Pythagoras: both directions pass every test. A statement whose converse is also true can be written with "if and only if".</li>
      <li>Passing 50 tests is not a proof. Read the "Why" box: the reason works for every case at once.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Is the converse true? Type 1 for yes or 0 for no. Fresh statements every time. Nothing is saved.</p>
    <div class="cv-quiz"></div>
  </div>
</div>

<style is:inline>
  .cv svg .cv-shape { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; }
  .cv svg .cv-shape.cv-bad { fill: var(--bad-soft); stroke: var(--bad); }
  .cv svg .cv-diag { stroke: var(--ink); stroke-width: 1.5; stroke-dasharray: 6 4; }
  .cv svg .cv-num { font-size: 44px; font-weight: 750; fill: var(--ink); }
  .cv .cv-big.good { color: var(--good); }
  .cv .cv-big.bad { color: var(--bad); }
</style>

<script>
  import { STATEMENTS, test, describe, rng, sides, diagonals, angleAt, type Obj, type Statement, type Trial } from '../../lib/sci/converse-school';
  import { randInt } from '../../lib/sci/smath';
  import { S, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.cv')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.cv-fig'), pick = q<HTMLSelectElement>('.cv-pick');
  const N = 50, rand = rng((Date.now() % 100000) + 1);
  let st: Statement = STATEMENTS[0], trials: Trial[] = [], at = 0, which: 'statement' | 'converse' = 'statement';
  const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

  function showPair() {
    st = STATEMENTS.find((s) => s.id === pick.value)!;
    q('.cv-s').textContent = `If ${st.P}, then ${st.Q}.`;
    q('.cv-c').textContent = `If ${st.Q}, then ${st.P}.`;
    trials = []; at = 0; fig.replaceChildren();
    q('.cv-big').textContent = 'Press a Test button.'; q('.cv-big').className = 'ax-big cv-big';
    q('.cv-desc').textContent = ''; q('.cv-tally').textContent = ''; q('.cv-verdict').hidden = true; q('.cv-jump').hidden = true;
    q<HTMLButtonElement>('.cv-prev').disabled = true; q<HTMLButtonElement>('.cv-next').disabled = true;
  }

  function drawObj(o: Obj, bad: boolean) {
    fig.replaceChildren();
    if (o.kind === 'num') {
      S('text', { x: 170, y: 120, 'text-anchor': 'middle', class: 'cv-num' }, fig, String(o.n));
      const f: number[] = []; let n = o.n; for (let k = 2; k * k <= n; k++) while (n % k === 0) { f.push(k); n /= k; } if (n > 1) f.push(n);
      S('text', { x: 170, y: 165, 'text-anchor': 'middle' }, fig, f.length > 1 ? `= ${f.join(' × ')}` : 'prime');
      return;
    }
    const xs = o.p.map((p) => p[0]), ys = o.p.map((p) => p[1]);
    const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
    const k = Math.min(260 / (x1 - x0 || 1), 170 / (y1 - y0 || 1)), ox = 170 - ((x0 + x1) / 2) * k, oy = 115 + ((y0 + y1) / 2) * k;
    const X = (p: number[]) => ox + p[0] * k, Y = (p: number[]) => oy - p[1] * k;
    S('polygon', { points: o.p.map((p) => `${X(p).toFixed(1)},${Y(p).toFixed(1)}`).join(' '), class: `cv-shape${bad ? ' cv-bad' : ''}` }, fig);
    const names = o.kind === 'quad' ? ['A', 'B', 'C', 'D'] : ['A', 'B', 'C'];
    if (o.kind === 'quad') { S('line', { x1: X(o.p[0]), y1: Y(o.p[0]), x2: X(o.p[2]), y2: Y(o.p[2]), class: 'cv-diag' }, fig); S('line', { x1: X(o.p[1]), y1: Y(o.p[1]), x2: X(o.p[3]), y2: Y(o.p[3]), class: 'cv-diag' }, fig); }
    const cx = o.p.reduce((s, p) => s + X(p), 0) / o.p.length, cy = o.p.reduce((s, p) => s + Y(p), 0) / o.p.length;
    o.p.forEach((p, i) => { const dx = X(p) - cx, dy = Y(p) - cy, L = Math.hypot(dx, dy) || 1; S('text', { x: X(p) + (dx / L) * 14, y: Y(p) + (dy / L) * 14 + 4, 'text-anchor': 'middle', style: 'font-weight:700' }, fig, `${names[i]} ${Math.round(angleAt(o.p, i))}°`); });
    const sd = sides(o.p);
    o.p.forEach((p, i) => { const qd = o.p[(i + 1) % o.p.length], mx = (X(p) + X(qd)) / 2, my = (Y(p) + Y(qd)) / 2, dx = mx - cx, dy = my - cy, L = Math.hypot(dx, dy) || 1; S('text', { x: mx - (dx / L) * 14, y: my - (dy / L) * 14 + 4, 'text-anchor': 'middle', class: 'sm-tick' }, fig, sd[i].toFixed(2)); });
    void diagonals;
  }

  function show() {
    if (!trials.length) return;
    const t = trials[at], fails = trials.filter((x) => !x.holds).length;
    drawObj(t.obj, !t.holds);
    const thenPart = which === 'statement' ? st.Q : st.P;
    q('.cv-big').textContent = t.holds ? `Example ${at + 1}: yes, ${thenPart}.` : `Example ${at + 1}: counterexample!`;
    q('.cv-big').className = `ax-big cv-big ${t.holds ? 'good' : 'bad'}`;
    q('.cv-desc').textContent = (t.obj.kind === 'num' ? describe(t.obj) : cap(describe(t.obj))) + '.';
    q('.cv-tally').textContent = fails ? `${N - fails} of ${N} random examples fit, ${fails} did not. One counterexample is enough: the ${which} is false.` : `All ${N} of ${N} random examples fit. That is good evidence, but only a proof makes it certain.`;
    q<HTMLButtonElement>('.cv-prev').disabled = at === 0; q<HTMLButtonElement>('.cv-next').disabled = at === N - 1;
    q('.cv-jump').hidden = !fails || !t.holds;
    q('.cv-verdict').hidden = false;
    const ok = which === 'statement' ? st.statementTrue : st.converseTrue;
    q('.cv-why').textContent = `The ${which} is ${ok ? 'always true' : 'false'}. ${which === 'statement' ? st.whyS : st.whyC}`;
  }
  function run(w: 'statement' | 'converse') {
    which = w; trials = test(st, w, N, rand).trials;
    const first = trials.findIndex((t) => !t.holds); at = first > 0 && first < 4 ? first : 0;   // start at a counterexample if one comes quickly
    show();
  }
  pick.addEventListener('change', showPair);
  q('.cv-ts').addEventListener('click', () => run('statement'));
  q('.cv-tc').addEventListener('click', () => run('converse'));
  q('.cv-prev').addEventListener('click', () => { at = Math.max(0, at - 1); show(); });
  q('.cv-next').addEventListener('click', () => { at = Math.min(N - 1, at + 1); show(); });
  q('.cv-jump').addEventListener('click', () => { at = trials.findIndex((t) => !t.holds); show(); });
  showPair();

  const BANK: [string, string, number, string][] = [
    ['a number is divisible by 9', 'it is divisible by 3', 0, 'False: 6 is divisible by 3 but not by 9.'],
    ['a triangle is equilateral', 'each of its angles is 60°', 1, 'True: if all three angles are 60°, the sides opposite equal angles are equal, so all three sides are equal.'],
    ['x = 3', 'x² = 9', 0, 'False: x = −3 also gives x² = 9.'],
    ['a quadrilateral is a rectangle', 'its diagonals are equal', 0, 'False: an isosceles trapezium has equal diagonals but is not a rectangle.'],
    ['two lines are parallel', 'the alternate angles made by a transversal are equal', 1, 'True: equal alternate angles force the lines to be parallel.'],
    ['a whole number is even', 'its square is even', 1, 'True: if n were odd, n² would be odd too, so an even square needs an even n.'],
    ['a quadrilateral is a square', 'it has four equal sides', 0, 'False: a rhombus has four equal sides but its angles need not be 90°.'],
    ['a triangle has a 90° angle', 'its other two angles add up to 90°', 1, 'True: the three angles add to 180°, so the third angle is 180° − 90° = 90°.'],
    ['two triangles are congruent', 'they have equal areas', 0, 'False: a 2 × 6 right triangle and a 3 × 4 right triangle both have area 6 but are not congruent.'],
    ['a number ends in 5', 'it is odd', 0, 'False: 7 is odd and ends in 7.'],
    ['a point is on the perpendicular bisector of AB', 'it is the same distance from A and from B', 1, 'True: any point equally far from A and B lies on the perpendicular bisector of AB.'],
    ['a polygon is a regular hexagon', 'it has six sides', 0, 'False: plenty of six-sided shapes have unequal sides or angles.'],
  ];
  quiz(q('.cv-quiz'), () => {
    const idx = new Set<number>(); while (idx.size < 4) idx.add(randInt(0, BANK.length - 1));
    return [...idx].map((i): Question => { const [p, qq, yes, why] = BANK[i]; return { q: `If ${p}, then ${qq}. Converse: if ${qq}, then ${p}. Is the converse always true?`, want: [yes], hint: '1 or 0', work: why }; });
  });
</script>
