---
// Insect degree-days from daily min and max temperatures: simple average or single sine, lower and upper
// thresholds with horizontal or vertical cutoff, running total and the date a degree-day target is reached.
// The example spring is made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
const example = `date	min	max
2026-04-01	4.0	16.7
2026-04-02	3.6	14.0
