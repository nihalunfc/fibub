---
// #1745 Car loan
---
<div class="tool-ui cr">
  <section class="panel">
    <div class="cr-grid">
      <label>Vehicle price <input data-k="price" inputmode="decimal" value="30000" /></label>
      <label>Trade-in value <input data-k="trade" inputmode="decimal" value="5000" /></label>
      <label>Cash down payment <input data-k="down" inputmode="decimal" value="2000" /></label>
      <label>Sales tax (%) <input data-k="tax" inputmode="decimal" value="8" /></label>
      <label>Fees (registration, dealer) <input data-k="fees" inputmode="decimal" value="500" /></label>
      <label>Interest rate a year (%) <input data-k="rate" inputmode="decimal" value="6" /></label>
      <label>Length (months) <input data-k="months" inputmode="decimal" value="60" />
        <span class="cr-chips" role="group" aria-label="Common loan lengths"><button type="button" data-term="36">3 yr</button><button type="button" data-term="48">4 yr</button><button type="button" data-term="60">5 yr</button><button type="button" data-term="72">6 yr</button><button type="button" data-term="84">7 yr</button></span></label>
      <label>Balloon at the end (% of price) <input data-k="balloon" inputmode="decimal" value="0" /></label>
    </div>
    <label class="cr-check"><input type="checkbox" data-k="net" checked /> Tax only on price minus trade-in (allowed in many US states and some provinces; untick if you are taxed on the full price)</label>
    <label class="cr-check"><input type="checkbox" data-k="finfees" checked /> Add the fees to the loan</label>
    <details class="cr-more">
      <summary>More options</summary>
      <div class="cr-grid">
        <label>Pay this much extra every month <input data-k="extra" inputmode="decimal" value="0" /></label>
        <label>Or: what can I afford? Monthly payment I can pay <input data-k="afford" inputmode="decimal" placeholder="e.g. 450" /></label>
      </div>
      <p class="cr-fine">The affordability answer uses your trade-in, down payment, tax, fees, rate, length and balloon above and works out the highest vehicle price.</p>
    </details>
    <p class="cr-fine">Works for a car, bike, scooter or truck: just use that vehicle's price. A balloon is a lump sum you still owe at the end of the term (common in leases and "balloon" finance); it lowers the payment but you must pay it, refinance it or hand the vehicle back.</p>
  </section>
  <section class="panel" aria-live="polite">
    <p class="cr-big"></p>
    <dl class="cr-rows"></dl>
    <p class="cr-warn" role="alert"></p>
    <p class="cr-fine cr-extra"></p>
    <p class="cr-fine cr-aff"></p>
    <p class="cr-fine cr-work"></p>
  </section>
  <section class="panel">
    <h2 class="cr-h">Shorter or longer loan?</h2>
    <div class="cr-scroll"><table class="cr-tab cr-terms"><thead><tr><th>Length</th><th>Payment</th><th>Interest</th><th>Total</th></tr></thead><tbody></tbody></table></div>
    <p class="cr-fine">A longer loan lowers the payment but costs more in interest.</p>
  </section>
  <p class="cr-fine">Not financial or tax advice. Sales tax rules differ by state, province and country, so check your own tax office. Lenders may round differently; use their quote for the final figure. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .cr { display: grid; gap: 14px; margin-bottom: 32px; }
  .cr .panel { padding: 16px; }
  .cr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 12px; }
  .cr label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .cr input:not([type=checkbox]), .cr select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .cr input:focus, .cr select:focus { border-color: var(--accent); outline: none; }
  .cr label.cr-check { display: flex; gap: 8px; align-items: center; color: var(--ink); margin-top: 12px; }
  .cr input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--accent); flex: none; }
  .cr-big { font-size: 28px; font-weight: 700; margin: 0 0 10px; } .cr-fine:empty { display: none; }
  .cr-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; } .cr-chips button { font: inherit; font-size: 13px; color: var(--accent); background: none; border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px; cursor: pointer; }
  .cr-more { margin-top: 12px; } .cr-more summary { cursor: pointer; font-weight: 600; margin-bottom: 10px; } .cr-terms tr.cur td { font-weight: 700; }
  .cr-rows { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin: 0; }
  .cr-rows dt { color: var(--muted); } .cr-rows dd { margin: 0; text-align: right; font-weight: 600; }
  .cr-warn { color: var(--bad); margin: 10px 0 0; } .cr-warn:empty { display: none; }
  .cr-fine { color: var(--muted); font-size: 13px; margin: 10px 0 0; }
  .cr-h { font-size: 16px; margin: 0 0 8px; }
  .cr-leg .lg { display: inline-flex; align-items: center; gap: 6px; margin-right: 14px; font-size: 13px; color: var(--muted); }
  .cr-scroll { overflow-x: auto; }
  .cr-tab { border-collapse: collapse; width: 100%; font-size: 14px; }
  .cr-tab th, .cr-tab td { padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .cr-tab th:first-child, .cr-tab td:first-child { text-align: left; }
  .cr-best { color: var(--good); }
</style>

<script>
  import { car, priceForPayment, type CarIn } from '../../lib/money/borrowing';
  import { monthlyExtraSaving, span } from '../../lib/loan';
  const root = document.querySelector('.cr') as HTMLElement;
  const q = (k: string) => root.querySelector(`[data-k="${k}"]`) as HTMLInputElement;
  const $ = (s: string) => root.querySelector(s) as HTMLElement;
  const num = (k: string) => parseFloat(q(k).value.replace(/,/g, '')) || 0;
  const m2 = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const calc = () => {
    const price = num('price'), months = Math.round(num('months'));
    if (!(price > 0) || !(months >= 1 && months <= 120) || num('rate') < 0 || num('balloon') < 0 || num('balloon') > 80 || num('down') < 0 || num('tax') < 0 || num('fees') < 0) {
      $('.cr-big').textContent = ''; $('.cr-rows').innerHTML = ''; $('.cr-terms tbody').innerHTML = ''; ['.cr-extra', '.cr-aff', '.cr-work'].forEach((c) => ($(c).textContent = '')); $('.cr-warn').textContent = 'Type a price above 0, 1 to 120 months, a rate, a balloon of 0 to 80%, and a down payment, tax and fees that are not negative.'; return;
    }
    const inp: CarIn = { price, trade: num('trade'), down: num('down'), taxPct: num('tax'), taxOnNet: q('net').checked, fees: num('fees'), financeFees: q('finfees').checked, ratePct: num('rate'), months, balloonPct: num('balloon') };
    const r = car(inp);
    $('.cr-big').textContent = `${m2(r.payment)} a month`;
    const line = (a: string, b: string) => `<dt>${a}</dt><dd>${b}</dd>`;
    $('.cr-rows').innerHTML = line('Sales tax', m2(r.tax)) + line('Amount borrowed', m2(r.loan)) + (r.balloon > 0 ? line('Balloon due at the end', m2(r.balloon)) : '') +
      line('Total interest', m2(r.interest)) + line('Total of the loan payments', m2(r.totalPaid)) + line('Cash you pay at the start', m2(r.cashNow)) + line('Total cost (loan + cash, not counting the trade-in)', m2(r.totalCost));
    // payoff date and the working
    const d = new Date(); d.setMonth(d.getMonth() + months);
    $('.cr-work').textContent = `Working: ${m2(price)} price + ${m2(r.tax)} tax + ${m2(inp.fees)} fees - ${m2(inp.trade)} trade-in - ${m2(inp.down)} down${inp.financeFees ? '' : ' (fees paid in cash)'} = ${m2(r.loan)} borrowed. Last payment ${d.toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}.`;
    // other lengths
    $('.cr-terms tbody').innerHTML = [36, 48, 60, 72, 84].map((n) => { const x = car({ ...inp, months: n }); return `<tr class="${n === months ? 'cur' : ''}"><td>${n / 12} years</td><td>${m2(x.payment)}</td><td>${m2(x.interest)}</td><td>${m2(x.totalPaid)}</td></tr>`; }).join('');
    // extra every month
    const extra = num('extra');
    $('.cr-extra').textContent = '';
    if (extra > 0 && r.loan > 0 && r.balloon === 0) {
      const s = monthlyExtraSaving(r.loan, inp.ratePct, months, extra);
      $('.cr-extra').textContent = `Paying ${m2(extra)} extra every month saves ${m2(s.interestSaved)} in interest and clears the loan ${span(s.monthsSaved)} sooner.`;
    } else if (extra > 0 && r.balloon > 0) $('.cr-extra').textContent = 'The extra-payment saving is not shown when there is a balloon.';
    // what can I afford
    const aff = num('afford');
    $('.cr-aff').textContent = '';
    if (aff > 0) {
      const top = priceForPayment(inp, aff);
      $('.cr-aff').textContent = top > 0 ? `At ${m2(aff)} a month you could buy a vehicle priced up to about ${m2(top)} (with the same trade-in, down payment, tax, fees, rate and length).` : 'That payment is too small for any vehicle with these fees and down payment.';
    }
    $('.cr-warn').textContent = r.loan <= 0 ? 'Your trade-in and down payment cover everything, so there is nothing to borrow.' : months > 84 ? 'Loans over 7 years often leave you owing more than the vehicle is worth for a long time.' : '';
  };
  root.addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest<HTMLElement>('[data-term]'); if (t) { q('months').value = t.dataset.term!; calc(); } });
  root.addEventListener('input', calc); root.addEventListener('change', calc);
  calc();
</script>
