---
// #T958 Tone generator: test tones, sweeps, noise, DTMF keys and phone signals; play them or save WAV / u-law.
// Sound maths in src/lib/audio/synth.ts (checks in tests/audio.mjs).
import { SIGNALS } from '../../lib/audio/synth.ts';
const KEYS = ['1', '2', '3', 'A', '4', '5', '6', 'B', '7', '8', '9', 'C', '*', '0', '#', 'D'];
---
<div class="tool-ui tg">
  <section class="panel">
    <div class="tg-modes" role="group" aria-label="Kind of sound">
      <button type="button" data-mode="tone" aria-pressed="true">Tone</button>
      <button type="button" data-mode="sweep" aria-pressed="false">Sweep</button>
      <button type="button" data-mode="noise" aria-pressed="false">Noise</button>
      <button type="button" data-mode="dtmf" aria-pressed="false">Keypad (DTMF)</button>
      <button type="button" data-mode="signal" aria-pressed="false">Phone signals</button>
    </div>

    <div class="tg-grid" data-for="tone">
      <label>Frequency (Hz) <input class="tg-f" type="number" min="1" max="24000" step="any" value="440" inputmode="decimal" /></label>
      <label>Wave shape
        <select class="tg-wave"><option value="sine">Sine (pure tone)</option><option value="square">Square</option><option value="triangle">Triangle</option><option value="sawtooth">Sawtooth</option></select>
      </label>
    </div>
    <div class="tg-grid" data-for="sweep" hidden>
      <label>From (Hz) <input class="tg-f1" type="number" min="1" max="24000" step="any" value="20" inputmode="decimal" /></label>
      <label>To (Hz) <input class="tg-f2" type="number" min="1" max="24000" step="any" value="20000" inputmode="decimal" /></label>
      <label>Sweep
        <select class="tg-swp"><option value="log">Even per octave (log)</option><option value="lin">Even per hertz (linear)</option></select>
      </label>
    </div>
    <div class="tg-grid" data-for="noise" hidden>
      <label>Noise
        <select class="tg-noise"><option value="white">White (equal per hertz, hiss)</option><option value="pink">Pink (equal per octave, like rain)</option></select>
      </label>
    </div>
    <div data-for="dtmf" hidden class="tg-dtmf">
      <div class="tg-keys">{KEYS.map((k) => <button type="button" class="tg-key" data-key={k}>{k}</button>)}</div>
      <label>Keys to save (a comma is a half-second pause) <input class="tg-seq" type="text" value="" maxlength="200" autocomplete="off" spellcheck="false" /></label>
      <div class="tg-grid">
        <label>Each key (ms) <input class="tg-ton" type="number" min="40" max="2000" step="10" value="100" /></label>
        <label>Gap between keys (ms) <input class="tg-gap" type="number" min="40" max="2000" step="10" value="100" /></label>
      </div>
    </div>
    <div class="tg-grid" data-for="signal" hidden>
      <label>Signal
        <select class="tg-sig">{Object.entries(SIGNALS).map(([k, s]) => <option value={k}>{s.name}</option>)}</select>
      </label>
    </div>

    <div class="tg-grid">
      <label class="tg-dur-l">Length (seconds) <input class="tg-dur" type="number" min="0.1" max="600" step="0.1" value="3" inputmode="decimal" /></label>
      <label>Volume (dB below full) <input class="tg-vol" type="number" min="-60" max="0" step="1" value="-12" inputmode="numeric" /></label>
      <label>Sample rate
        <select class="tg-rate"><option value="48000">48,000 Hz</option><option value="44100">44,100 Hz (CD)</option><option value="16000">16,000 Hz</option><option value="8000">8,000 Hz (phone)</option></select>
      </label>
    </div>
    <p class="tg-info" aria-live="polite"></p>
    <div class="tg-row">
      <button type="button" class="btn secondary tg-play">Play</button>
      <button type="button" class="btn tg-save">Download WAV</button>
      <button type="button" class="btn secondary tg-ulaw">Download .ulaw</button>
    </div>
    <p class="tg-fine">Start quiet. High tones and noise at full volume can hurt your ears or your speakers. Tones above half the sample rate cannot be made.</p>
  </section>
</div>

<style is:inline>
  .tg { display: grid; gap: 14px; margin-bottom: 32px; }
  .tg .panel { display: grid; gap: 14px; padding: 16px; }
  .tg-modes { display: flex; flex-wrap: wrap; gap: 6px; }
  .tg-modes button { font: inherit; font-size: 14px; padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--ink); cursor: pointer; }
  .tg-modes button[aria-pressed=true] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink, #fff); }
  .tg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: 12px; }
  .tg [hidden] { display: none !important; }
  .tg-dtmf { display: grid; gap: 12px; }
  .tg label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .tg input, .tg select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .tg-keys { display: grid; grid-template-columns: repeat(4, minmax(0, 64px)); gap: 8px; }
  .tg-key { font: inherit; font-size: 20px; padding: 10px 0; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--ink); cursor: pointer; touch-action: manipulation; }
  .tg-key:active { background: var(--accent-soft, #e6eefc); }
  .tg-info, .tg-fine { color: var(--muted); font-size: 14px; margin: 0; }
  .tg-row { display: flex; flex-wrap: wrap; gap: 8px; }
</style>

<script>
  import { tone, sweep, noise, dtmf, signal, dbToAmp, DTMF, type Wave } from '../../lib/audio/synth.ts';
  import { writeWav, resample } from '../../lib/audio/pcm.ts';
  import { encodeG711 } from '../../lib/audio/g711.ts';
  import { saveBytes, sizeText, player } from '../../lib/audio/browser.ts';
  const root = document.querySelector('.tg') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const v = (s: string) => +$<HTMLInputElement>(s).value;
  const info = $('.tg-info'), playB = $<HTMLButtonElement>('.tg-play'), saveB = $<HTMLButtonElement>('.tg-save'), ulawB = $<HTMLButtonElement>('.tg-ulaw');
  const seq = $<HTMLInputElement>('.tg-seq');
  let mode = 'tone';
  const play = player();

  const rate = () => +$<HTMLSelectElement>('.tg-rate').value;
  const amp = () => dbToAmp(Math.min(0, Math.max(-60, v('.tg-vol') || 0)));
  const dur = () => Math.min(600, Math.max(0.1, v('.tg-dur') || 1));
  const problem = (): string => {
    const ny = rate() / 2;
    if (mode === 'tone' && !(v('.tg-f') > 0 && v('.tg-f') < ny)) return `The frequency must be between 1 and ${ny.toLocaleString('en-US')} Hz at this sample rate.`;
    if (mode === 'sweep' && !(v('.tg-f1') > 0 && v('.tg-f2') > 0 && v('.tg-f1') < ny && v('.tg-f2') < ny)) return `Both ends must be between 1 and ${ny.toLocaleString('en-US')} Hz at this sample rate.`;
    if (mode === 'dtmf' && ![...seq.value.toUpperCase()].some((c) => c in DTMF)) return 'Press some keys or type them in the box first.';
    return '';
  };
  const make = (): Float32Array => {
    const r = rate(), a = amp(), d = dur();
    if (mode === 'tone') return tone($<HTMLSelectElement>('.tg-wave').value as Wave, v('.tg-f'), d, r, a);
    if (mode === 'sweep') return sweep(v('.tg-f1'), v('.tg-f2'), d, r, a, $<HTMLSelectElement>('.tg-swp').value === 'log');
    if (mode === 'noise') return noise($<HTMLSelectElement>('.tg-noise').value as 'white' | 'pink', d, r, a, 12345);
    if (mode === 'dtmf') return dtmf(seq.value, r, Math.max(40, v('.tg-ton')), Math.max(40, v('.tg-gap')), a / 2);
    return signal($<HTMLSelectElement>('.tg-sig').value, d, r, a);
  };
  const name = () => {
    if (mode === 'tone') return `tone-${v('.tg-f')}hz-${$<HTMLSelectElement>('.tg-wave').value}`;
    if (mode === 'sweep') return `sweep-${v('.tg-f1')}-${v('.tg-f2')}hz`;
    if (mode === 'noise') return `${$<HTMLSelectElement>('.tg-noise').value}-noise`;
    if (mode === 'dtmf') return `dtmf-${seq.value.replace(/[^0-9A-D*#]/gi, '').replace(/\*/g, 'star').replace(/#/g, 'hash').slice(0, 40)}`;
    return $<HTMLSelectElement>('.tg-sig').value;
  };
  const update = () => {
    root.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => (el.hidden = el.dataset.for !== mode));
    $('.tg-dur-l').hidden = mode === 'dtmf';
    const p = problem();
    playB.disabled = saveB.disabled = ulawB.disabled = !!p;
    if (p) { info.textContent = p; return; }
    const n = mode === 'dtmf' ? make().length : Math.round(dur() * rate());
    info.textContent = `${(n / rate()).toFixed(2)} s at ${rate().toLocaleString('en-US')} Hz, mono. WAV ${sizeText(44 + n * 2)}; u-law for phone systems ${sizeText(Math.round((n * 8000) / rate()))}.`;
  };

  root.querySelectorAll<HTMLButtonElement>('.tg-modes button').forEach((b) => b.addEventListener('click', () => {
    mode = b.dataset.mode!; root.querySelectorAll('.tg-modes button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    play.stop(); playB.textContent = 'Play'; update();
  }));
  root.querySelectorAll<HTMLButtonElement>('.tg-key').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.key!; seq.value = (seq.value + k).slice(0, 200);
    play.play([dtmf(k, 48000, 150, 40, amp() / 2)], 48000); update();
  }));
  playB.addEventListener('click', () => {
    if (playB.textContent === 'Stop') { play.stop(); playB.textContent = 'Play'; return; }
    playB.textContent = 'Stop'; play.play([make()], rate(), () => (playB.textContent = 'Play'));
  });
  saveB.addEventListener('click', () => saveBytes(writeWav([make()], rate()), name() + '.wav', 'audio/wav'));
  ulawB.addEventListener('click', () => { const x = make(); saveBytes(encodeG711(rate() === 8000 ? x : resample(x, rate(), 8000, 0.9), 'ulaw'), name() + '.ulaw', 'audio/basic'); });
  root.querySelectorAll('input, select').forEach((el) => el.addEventListener('input', update));
  update();
</script>
