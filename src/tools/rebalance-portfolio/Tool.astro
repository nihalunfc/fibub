---
// #1754 Rebalance portfolio: buy and sell amounts to reach target percentages.
---
<div class="tool-ui rb">
  <section class="panel">
    <h2>Your holdings</h2>
    <div class="rb-grid">
      <label>Currency <select class="rb-cur" data-k="cur"></select></label>
      <label>New cash to add <input data-k="cash" inputmode="decimal" /></label>
    </div>
    <label class="chk" style="margin-top:12px"><input type="checkbox" data-k="buyonly" /> Buy only (never sell; spend the new cash on what is furthest below target)</label>
    <div class="rb-wrap" style="margin-top:12px"><table>
      <thead><tr><th>Name</th><th>Value now</th><th>Target %</th><th></th></tr></thead>
      <tbody class="rb-in"></tbody>
    </table></div>
    <button type="button" class="btn secondary rb-add">Add a row</button>
    <p class="note bad rb-err" role="alert" hidden></p>
  </section>
  <section class="rb-res" aria-live="polite">
    <div class="rb-stats">
      <div><span>Total after adding cash</span><b class="rb-s-tot"></b></div>
      <div><span>Total to buy</span><b class="rb-s-buy"></b></div>
      <div><span>Total to sell</span><b class="rb-s-sell"></b></div>
    </div>
    <div class="panel rb-wrap"><table>
      <thead><tr><th>Name</th><th>Now</th><th>Target</th><th>Buy / sell</th><th>After</th><th>After %</th></tr></thead>
      <tbody class="rb-out"></tbody>
    </table></div>
    <p class="rb-fine rb-note"></p>
    <button type="button" class="btn secondary rb-csv">Download the plan (CSV)</button>
  </section>
  <p class="rb-fine">This only does the arithmetic to reach the percentages you chose. It does not say what you should hold, and it ignores trading fees, taxes and whole-share rounding. Selling may create a taxable gain (see <a href="/money/capital-gains/">Capital gains</a> if you sell). Not financial or tax advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .rb { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .rb > *, .rb-res > * { min-width: 0; }
  .rb h2 { margin: 0 0 12px; font-size: 18px; }
  .rb .panel { padding: 16px; }
  .rb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .rb label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .rb input, .rb select, .rb textarea { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .rb textarea { min-height: 150px; font-family: ui-monospace, monospace; font-size: 14px; }
  .rb input:focus, .rb select:focus, .rb textarea:focus { border-color: var(--accent); outline: none; }
  .rb .chk { display: flex; gap: 8px; align-items: center; color: var(--ink); }
  .rb .chk input { width: auto; }
  .rb-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .rb-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .rb-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .rb-stats span { font-size: 13px; color: var(--muted); }
  .rb-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .rb-stats .good b { color: var(--good); }
  .rb-wrap { overflow-x: auto; }
  .rb table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .rb th, .rb td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .rb th:first-child, .rb td:first-child { text-align: left; }
  .rb th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .rb td input { padding: 6px 8px; }
  .rb-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .rb-err { margin: 10px 0 0; }
  .rb .btn { justify-self: start; }
</style>

<script>
  import { rebalance, type Trade } from '../../lib/money/investing';
  import { csv } from '../../lib/money/growth';
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  const root = document.querySelector<HTMLElement>('.rb')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  q('.rb-cur').innerHTML = currencyOptions(defaultCurrency());
  f('cash').value = '0';
  const body = q('.rb-in');
  const addRow = (n = '', v = '', t = '') => {
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><input class="n" aria-label="Name" value="${n}" /></td><td><input class="v" inputmode="decimal" aria-label="Value now" value="${v}" /></td><td><input class="t" inputmode="decimal" aria-label="Target percent" value="${t}" /></td><td><button type="button" class="btn secondary x" aria-label="Remove row">x</button></td>`;
    body.append(tr);
  };
  addRow('Shares fund', '6,000', '50'); addRow('Bond fund', '4,000', '50');
  let plan: Trade[] = [];
  function run() {
    const cur = f('cur').value, $ = (n: number) => money(n, cur, 2);
    const h = [...body.querySelectorAll('tr')].map((tr, i) => ({ name: (tr.querySelector('.n') as HTMLInputElement).value.trim() || `Holding ${i + 1}`, value: num((tr.querySelector('.v') as HTMLInputElement).value), target: num((tr.querySelector('.t') as HTMLInputElement).value) }));
    const cash = num(f('cash').value), sumT = h.reduce((s, x) => s + x.target, 0);
    const bad = h.length < 2 ? 'Add at least two holdings.' : h.some((x) => x.value < 0 || x.target < 0) || cash < 0 ? 'Amounts and targets cannot be negative.' : !(sumT > 0) ? 'Enter a target percentage for at least one holding.' : h.reduce((s, x) => s + x.value, 0) + cash <= 0 ? 'Enter the value of your holdings.' : '';
    q('.rb-err').hidden = !bad; q('.rb-err').textContent = bad; q('.rb-res').hidden = !!bad;
    if (bad) return;
    plan = rebalance(h, cash, f('buyonly').checked);
    const total = plan.reduce((s, x) => s + x.after, 0);
    q('.rb-s-tot').textContent = $(total);
    q('.rb-s-buy').textContent = $(plan.reduce((s, x) => s + Math.max(0, x.trade), 0));
    q('.rb-s-sell').textContent = $(-plan.reduce((s, x) => s + Math.min(0, x.trade), 0));
    q('.rb-out').innerHTML = plan.map((x) => `<tr><td>${x.name.replace(/[<&]/g, '')}</td><td>${$(x.value)}</td><td>${Math.round(x.target * 100) / 100}%</td><td><b>${Math.abs(x.trade) < 0.005 ? 'Hold' : (x.trade > 0 ? 'Buy ' : 'Sell ') + $(Math.abs(x.trade))}</b></td><td>${$(x.after)}</td><td>${(Math.round((x.after / total) * 10000) / 100)}%</td></tr>`).join('');
    q('.rb-note').textContent = (Math.abs(sumT - 100) > 0.01 ? `Your targets add up to ${Math.round(sumT * 100) / 100}%, so they were scaled to 100%. ` : '') + (f('buyonly').checked ? 'Buy only: the new cash goes to the holdings furthest below target, so they may not reach it exactly.' : '');
  }
  q('.rb-add').addEventListener('click', () => { addRow(); run(); });
  body.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('.x'); if (b) { b.closest('tr')!.remove(); run(); } });
  q('.rb-csv').addEventListener('click', () => csv('rebalance.csv', ['Name', 'Now', 'Target %', 'Buy or sell', 'After'], plan.map((x) => [x.name, x.value, x.target, x.trade, x.after])));
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
