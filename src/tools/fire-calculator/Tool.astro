---
// #1733 FIRE calculator: the amount that lets you stop working, and how long it takes.
---
<div class="tool-ui fi">
  <section class="panel">
    <h2>Your numbers</h2>
    <div class="fi-grid">
      <label>Currency <select class="fi-cur" data-k="cur"></select></label>
      <label>Income after tax, a year <input data-k="income" inputmode="decimal" /></label>
      <label>Spending, a year <input data-k="spend" inputmode="decimal" /></label>
      <label>Saved so far <input data-k="saved" inputmode="decimal" /></label>
      <label>Return after inflation <span class="fi-suf"><input data-k="ret" inputmode="decimal" /><i>% a year</i></span></label>
      <label>Safe withdrawal rate <span class="fi-suf"><input data-k="wr" inputmode="decimal" /><i>% a year</i></span></label>
    </div>
    <p class="fi-hint">Spending in retirement is taken as the same as now. The return is after inflation, so every figure is in today's money.</p>
    <p class="note bad fi-err" role="alert" hidden></p>
  </section>
  <section class="fi-res" aria-live="polite">
    <div class="fi-stats">
      <div><span>Your FIRE number</span><b class="fi-num"></b></div>
      <div><span>You save each year</span><b class="fi-save"></b></div>
      <div class="good"><span>Years to independence</span><b class="fi-years"></b></div>
    </div>
    <p class="fi-line fi-msg"></p>
    <figure class="fi-chart panel">
      <figcaption>Your savings and the FIRE number <span class="fi-leg"></span></figcaption>
      <div class="fi-svg"></div>
    </figure>
    <div class="fi-tab panel">
      <h2>What if you saved more?</h2>
      <p class="fi-hint">Same income, a different share of it saved. Spending falls as saving rises, so the FIRE number falls too.</p>
      <div class="fi-wrap"><table>
        <thead><tr><th>Saving rate</th><th>Spending a year</th><th>FIRE number</th><th>Years to go</th></tr></thead>
        <tbody class="fi-body"></tbody>
      </table></div>
    </div>
  </section>
  <p class="fi-fine">FIRE means financial independence, retire early. The FIRE number is yearly spending divided by the withdrawal rate. The 4% rule comes from US research on 30-year retirements and is a guide, not a promise; for a longer retirement many people use 3 to 3.5%. Not financial or tax advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .fi { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .fi > *, .fi-res > * { min-width: 0; }
  .fi h2 { margin: 0 0 12px; font-size: 18px; }
  .fi .panel { padding: 16px; }
  .fi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .fi label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .fi input, .fi select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .fi input:focus, .fi select:focus { border-color: var(--accent); outline: none; }
  .fi input[type=checkbox] { width: auto; }
  .fi-suf { position: relative; display: block; }
  .fi-suf i { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-style: normal; font-size: 13px; color: var(--muted); pointer-events: none; }
  .fi-suf input { padding-right: 84px; }
  .fi-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .fi-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .fi-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .fi-stats span { font-size: 13px; color: var(--muted); }
  .fi-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .fi-stats .good b { color: var(--good); }
  .fi-stats .bad b { color: var(--bad); }
  .fi-line { margin: 0; font-size: 15px; }
  .fi-line:empty { display: none; }
  .fi-chart { margin: 0; }
  .fi-chart figcaption { font-weight: 600; font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 8px; }
  .fi-chart .lg { font-weight: 500; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }
  .fi-wrap { overflow-x: auto; }
  .fi table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .fi th, .fi td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .fi th:first-child, .fi td:first-child { text-align: left; }
  .fi th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .fi-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .fi-err { margin: 10px 0 0; }
  .fi-hint { margin: 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) { .fi-stats { grid-template-columns: 1fr; } }
</style>

<script>
  import { yearsToTarget } from '../../lib/money/goals';
  import { lineSvg, legend } from '../../lib/money/chart';
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  const root = document.querySelector<HTMLElement>('.fi')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  const cur = defaultCurrency();
  q('.fi-cur').innerHTML = currencyOptions(cur);
  const india = cur === 'INR';
  f('income').value = india ? '12,00,000' : '60,000'; f('spend').value = india ? '6,00,000' : '40,000'; f('saved').value = india ? '5,00,000' : '20,000';
  f('ret').value = '5'; f('wr').value = '4';
  const $ = (n: number) => money(n, f('cur').value, 0);
  const yrs = (y: number) => !isFinite(y) ? 'Not at this rate' : y <= 0 ? 'Already there' : y > 100 ? 'Over 100 years' : (Math.round(y * 10) / 10).toString() + ' years';
  function run() {
    const income = num(f('income').value), spend = num(f('spend').value), saved = num(f('saved').value), ret = num(f('ret').value), wr = num(f('wr').value);
    const bad = !(spend > 0) ? 'Enter what you spend in a year.' : !(wr > 0 && wr <= 20) ? 'Enter a withdrawal rate between 0 and 20, for example 4.' : ret < -10 || ret > 30 ? 'Enter a return between -10 and 30.' : income < 0 || saved < 0 ? 'Amounts cannot be negative.' : '';
    q('.fi-err').hidden = !bad; q('.fi-err').textContent = bad; q('.fi-res').hidden = !!bad;
    if (bad) return;
    const fire = spend / (wr / 100), save = income - spend;
    const y = yearsToTarget(fire, saved, save, ret);
    q('.fi-num').textContent = $(fire);
    q('.fi-save').textContent = $(save);
    q('.fi-years').textContent = yrs(y);
    q('.fi-msg').textContent = !isFinite(y) ? (save <= 0 ? 'You spend as much as you earn, so savings do not grow from your pay. Lower spending or raise income.' : 'At this return the target is out of reach.') : y <= 0 ? 'You already have enough for your spending at this withdrawal rate.' : `Saving ${$(save)} a year (${income > 0 ? Math.round((save / income) * 100) : 0}% of your income), you reach ${$(fire)} in about ${yrs(y)}.`;
    const n = isFinite(y) ? Math.min(60, Math.ceil(y) + 2) : 30, xs: number[] = [], bal: number[] = [];
    let b = saved;
    for (let k = 0; k <= n; k++) { xs.push(k); bal.push(b); b = b * (1 + ret / 100) + save; }
    const series = [{ label: 'Your savings', ys: bal, color: 'var(--accent)' }, { label: 'FIRE number', ys: bal.map(() => fire), color: 'var(--muted)', dash: true }];
    q('.fi-svg').innerHTML = lineSvg(series, xs, 'Savings over the years against the FIRE number');
    q('.fi-leg').innerHTML = legend(series);
    q('.fi-body').innerHTML = income > 0 ? [10, 20, 30, 40, 50, 60, 70].map((r) => {
      const sp = income * (1 - r / 100), fr = sp / (wr / 100), yy = yearsToTarget(fr, saved, income - sp, ret);
      return `<tr><td>${r}%</td><td>${$(sp)}</td><td>${$(fr)}</td><td>${yrs(yy)}</td></tr>`;
    }).join('') : '';
  }
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
