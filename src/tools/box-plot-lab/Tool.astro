---
// #L332 Box plot lab. Five-number summary, IQR and the 1.5 × IQR outlier rule for a list of numbers. Maths: src/lib/learn/usa-math.ts.
import '../../styles/astro.css';
import '../../styles/learnquiz-d.css';
---
<div class="tool-ui ax lrn bp">
  <div class="ax-card">
    <div class="ax-seg" role="group" aria-label="Level"><button type="button" data-level="8" aria-pressed="true">Grade 8 to 9</button><button type="button" data-level="10" aria-pressed="false">Grade 10 to 12</button></div>
    <p class="ax-help">Type or paste numbers, separated by spaces, commas or new lines. The box plot shows the middle half of the data inside the box.</p>
    <label>Numbers <textarea class="bp-in" rows="3" spellcheck="false" aria-label="Numbers">12, 15, 17, 18, 20, 21, 22, 24, 25, 27, 30, 58</textarea></label>
    <canvas class="lrn-cv bp-cv" aria-label="Box and whisker plot of the numbers, with outliers as separate dots" style="margin-top:10px"></canvas>
    <p class="ax-big bp-out" aria-live="polite"></p>
    <table class="bp-tab"><tbody class="bp-rows"></tbody></table>
    <p class="ax-help" data-only="10" hidden>Grade 10 to 12: a value is an outlier when it is below Q1 − 1.5 × IQR or above Q3 + 1.5 × IQR. The whisker stops at the most extreme value that is not an outlier. Q1 and Q3 are the medians of the lower and upper halves; with an odd count the middle value is left out of both halves.</p>
  </div>
  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lrn-try"><li>Delete the 58. The outlier dot disappears and the whisker reaches the new maximum.</li><li>Change 58 to 35. Is it still an outlier? Check the upper fence in the table.</li><li>Make every number the same. The box shrinks to a single line.</li></ul>
  </div>
  <div class="ax-card bp-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<style is:inline>
  .bp .bp-cv { width: 100%; }
  .bp textarea { width: 100%; font: inherit; font-size: 16px; padding: 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  .bp .bp-tab { border-collapse: collapse; margin-top: 8px; font-size: 14.5px; }
  .bp .bp-tab td { padding: 3px 14px 3px 0; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
  .bp .bp-tab td:first-child { color: var(--muted); }
</style>

<script>
  import { mountQuiz, pick, r } from '../../lib/learn/quiz';
  import { fitCanvas, wireLevel, pagePalette } from '../../lib/learn/sim';
  import { fiveNumber, mean } from '../../lib/learn/usa-math';
  const root = document.querySelector('.bp') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const inp = $<HTMLTextAreaElement>('.bp-in'), cv = $<HTMLCanvasElement>('.bp-cv'), out = $('.bp-out');
  const read = () => inp.value.split(/[\s,;]+/).map((s) => s.trim()).filter(Boolean).map(Number).filter((n) => Number.isFinite(n));
  const draw = (xs: number[]) => {
    const { ctx, W, H } = fitCanvas(cv, 130), pal = pagePalette();
    ctx.clearRect(0, 0, W, H); ctx.font = '12px system-ui,sans-serif';
    if (xs.length < 4) { ctx.fillStyle = pal.muted; ctx.fillText('Give at least 4 numbers.', 12, 30); return; }
    const f = fiveNumber(xs), span = (f.max - f.min) || 1, a = f.min - span * 0.05, b = f.max + span * 0.05;
    const px = (v: number) => 14 + ((v - a) / (b - a)) * (W - 28), cy = 55, bh = 34;
    ctx.strokeStyle = pal.line; ctx.beginPath(); ctx.moveTo(10, 100); ctx.lineTo(W - 10, 100); ctx.stroke();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'center';
    for (let i = 0; i <= 5; i++) { const v = a + (i / 5) * (b - a); ctx.fillText(String(Math.round(v * 10) / 10), px(v), 116); }
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(px(f.whiskerLow), cy); ctx.lineTo(px(f.q1), cy); ctx.moveTo(px(f.q3), cy); ctx.lineTo(px(f.whiskerHigh), cy);
    ctx.moveTo(px(f.whiskerLow), cy - 9); ctx.lineTo(px(f.whiskerLow), cy + 9); ctx.moveTo(px(f.whiskerHigh), cy - 9); ctx.lineTo(px(f.whiskerHigh), cy + 9); ctx.stroke();
    ctx.fillStyle = pal.accent; ctx.globalAlpha = 0.25; ctx.fillRect(px(f.q1), cy - bh / 2, px(f.q3) - px(f.q1), bh); ctx.globalAlpha = 1;
    ctx.strokeRect(px(f.q1), cy - bh / 2, px(f.q3) - px(f.q1), bh);
    ctx.strokeStyle = pal.accent2; ctx.beginPath(); ctx.moveTo(px(f.median), cy - bh / 2); ctx.lineTo(px(f.median), cy + bh / 2); ctx.stroke(); ctx.lineWidth = 1;
    ctx.fillStyle = pal.accent2; f.outliers.forEach((v) => { ctx.beginPath(); ctx.arc(px(v), cy, 4.5, 0, 7); ctx.fill(); });
  };
  const rows = $('.bp-rows');
  const update = () => {
    const xs = read();
    rows.replaceChildren();
    if (xs.length < 4) { out.textContent = 'Give at least 4 numbers.'; delete out.dataset.q1; draw(xs); return; }
    const f = fiveNumber(xs);
    out.textContent = `Median ${r(f.median)}, middle half from ${r(f.q1)} to ${r(f.q3)} (IQR ${r(f.iqr)}).`;
    out.dataset.q1 = String(f.q1); out.dataset.med = String(f.median); out.dataset.q3 = String(f.q3); out.dataset.out = f.outliers.join(',');
    const data: [string, string][] = [['Minimum', r(f.min)], ['Q1 (lower quartile)', r(f.q1)], ['Median', r(f.median)], ['Q3 (upper quartile)', r(f.q3)], ['Maximum', r(f.max)], ['IQR (Q3 − Q1)', r(f.iqr)], ['Mean', r(mean(xs))], ['Lower fence', r(f.lowFence)], ['Upper fence', r(f.highFence)], ['Outliers', f.outliers.length ? f.outliers.map((v) => r(v)).join(', ') : 'none']];
    for (const [k, v] of data) { const tr = document.createElement('tr'), a = document.createElement('td'), b = document.createElement('td'); a.textContent = k; b.textContent = v; tr.append(a, b); rows.append(tr); }
    draw(xs);
  };
  inp.addEventListener('input', update);
  addEventListener('resize', update);
  wireLevel(root, () => {});
  update();
  mountQuiz($('.bp-quiz'), () => {
    const base = pick(10, 30), step = pick(2, 4), sortedXs = Array.from({ length: 7 }, (_, i) => base + i * step), f = fiveNumber(sortedXs);
    const shown = [...sortedXs].sort(() => Math.random() - 0.5);
    return [
      { q: `Find the median of: ${shown.join(', ')}`, ans: f.median, work: `In order: ${sortedXs.join(', ')}. The middle (4th) value is ${f.median}.` },
      { q: 'For the same numbers, what is Q1 (the median of the lower three)?', ans: f.q1, work: `The lower three are ${sortedXs.slice(0, 3).join(', ')}. Their median is ${f.q1}.` },
      { q: 'A data set has Q1 = 20 and Q3 = 30. Above what value is a number an outlier?', ans: 45, work: 'IQR = 30 − 20 = 10. Upper fence = Q3 + 1.5 × IQR = 30 + 15 = 45.' },
    ];
  });
</script>
