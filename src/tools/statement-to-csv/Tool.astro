---
// #1752 Statement to CSV
---
<div class="tool-ui stc">
  <p class="stc-note">Your statement stays on this device. Nothing is uploaded and nothing is saved.</p>
  <label class="stc-pick">Bank statement (PDF)
    <input class="stc-file" type="file" accept=".pdf,application/pdf" />
  </label>
  <p class="stc-msg" role="status" aria-live="polite"></p>
  <div class="stc-work" hidden>
    <div class="stc-opts">
      <label>Column starts (distance from the left edge of the page, in points)
        <input class="stc-cols" type="text" inputmode="numeric" placeholder="40, 120, 380, 450" />
      </label>
      <p class="stc-hint">Each number is where a column begins. Add, remove or change numbers and the table below updates. <button class="btn secondary stc-auto" type="button">Find columns again</button></p>
      <label><input class="stc-dated" type="checkbox" checked /> Keep only lines that have a date</label>
      <label><input class="stc-join" type="checkbox" checked /> Join a description that wraps onto the next line</label>
      <label><input class="stc-tidy" type="checkbox" /> Tidy dates (2026-01-31) and amounts (1234.56)</label>
      <label><input class="stc-head" type="checkbox" checked /> Put the first kept line as column headings</label>
    </div>
    <p class="stc-count" aria-live="polite"></p>
    <div class="stc-scroll"><table class="stc-table"></table></div>
    <div class="stc-row">
      <button class="btn stc-csv" type="button">Download CSV</button>
      <button class="btn secondary stc-copy" type="button">Copy for a spreadsheet</button>
    </div>
    <p class="stc-hint">The CSV opens in Excel, Numbers and Google Sheets. Have a look at the table first: rows that are wrong usually mean a column start needs moving.</p>
  </div>
</div>

<style is:inline>
  .stc { display: grid; gap: .75rem; }
  .stc-note, .stc-hint, .stc-count, .stc-msg { margin: 0; } .stc-hint { font-size: .9rem; }
  .stc-msg { min-height: 1.3em; } .stc-msg.err { color: var(--warn); }
  .stc-pick, .stc-opts label { display: grid; gap: .25rem; font-weight: 600; }
  .stc-opts { display: grid; gap: .5rem; }
  .stc-opts label:has(input[type=checkbox]) { display: flex; gap: .5rem; align-items: center; font-weight: 400; }
  .stc-cols { width: 100%; box-sizing: border-box; font: inherit; }
  .stc-work[hidden] { display: none; } .stc-work { display: grid; gap: .75rem; }
  .stc-scroll { overflow-x: auto; max-height: 24rem; border: 1px solid var(--line); border-radius: 8px; }
  .stc-table { border-collapse: collapse; font-size: .85rem; width: max-content; min-width: 100%; }
  .stc-table th, .stc-table td { border-bottom: 1px solid var(--line); padding: .3rem .5rem; text-align: left; white-space: nowrap; }
  .stc-table th { position: sticky; top: 0; background: var(--surface); }
  .stc-row { display: flex; flex-wrap: wrap; gap: .75rem; }
</style>

<script>
  import { groupRows, findColumns, toTable, readPieces, type Piece } from '../../lib/docs/statementpdf';
  import { parseDate, parseAmount, toCsv, dateOrder } from '../../lib/money/statement';
  import { download } from '../../lib/docs/pdfpages';
  const root = document.querySelector('.stc') as HTMLElement;
  const $ = <T extends Element>(s: string) => root.querySelector(s) as T;
  const msg = $<HTMLElement>('.stc-msg'), work = $<HTMLElement>('.stc-work'), colsIn = $<HTMLInputElement>('.stc-cols');
  const tbl = $<HTMLTableElement>('.stc-table');
  let rows: Piece[][] = [], name = 'statement', current: string[][] = [];
  const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('err', err); };
  const cols = () => colsIn.value.split(/[,;\s]+/).map(Number).filter((n) => isFinite(n) && n >= 0);

  function build(): string[][] {
    const c = cols(); if (!c.length) return [];
    let t = toTable(rows, c);
    const hasDate = (r: string[]) => r.some((x) => parseDate(x));
    if ($<HTMLInputElement>('.stc-join').checked) {
      const out: string[][] = [];
      for (const r of t) {
        const filled = r.map((x, i) => (x ? i : -1)).filter((i) => i >= 0);
        const prev = out[out.length - 1];
        if (prev && hasDate(prev) && !hasDate(r) && filled.length === 1 && !r.some((x) => !isNaN(parseAmount(x)) && /\d/.test(x) && /[.,]\d\d$/.test(x))) prev[filled[0]] = (prev[filled[0]] + ' ' + r[filled[0]]).trim();
        else out.push(r.slice());
      }
      t = out;
    }
    if ($<HTMLInputElement>('.stc-dated').checked) {
      const head = t.findIndex((r) => r.some((x) => /date/i.test(x)) && !hasDate(r));
      t = t.filter((r, i) => hasDate(r) || (i === head));
    }
    if ($<HTMLInputElement>('.stc-tidy').checked) {
      const body = t.filter(hasDate), order = dateOrder(body.flat());
      const dateCol = new Set<number>(), amtCol = new Set<number>();
      for (let i = 0; i < c.length; i++) {
        const vals = body.map((r) => r[i]).filter(Boolean);
        if (vals.length && vals.every((v) => parseDate(v, order))) dateCol.add(i);
        else if (vals.length && vals.filter((v) => !isNaN(parseAmount(v))).length >= vals.length * 0.8 && vals.some((v) => /[.,]\d\d\s*(CR|DR|-)?\)?$/i.test(v))) amtCol.add(i);
      }
      t = t.map((r) => hasDate(r) ? r.map((v, i) => dateCol.has(i) ? parseDate(v, order) || v : amtCol.has(i) && v && !isNaN(parseAmount(v)) ? String(parseAmount(v)) : v) : r);
    }
    return t;
  }
  function render() {
    current = build();
    tbl.textContent = '';
    const useHead = $<HTMLInputElement>('.stc-head').checked && current.length;
    current.slice(0, 300).forEach((r, ri) => {
      const tr = tbl.insertRow();
      r.forEach((v) => { const c = document.createElement(useHead && ri === 0 ? 'th' : 'td'); c.textContent = v; tr.appendChild(c); });
    });
    const n = current.length - (useHead ? 1 : 0);
    $('.stc-count').textContent = current.length ? `${Math.max(0, n)} row${n === 1 ? '' : 's'} and ${cols().length} column${cols().length === 1 ? '' : 's'}${current.length > 300 ? ' (the first 300 are shown here; the download has them all)' : ''}.` : 'No rows yet. Add at least one column start.';
  }
  function auto() { colsIn.value = findColumns(rows.filter((r) => r.length > 1)).join(', '); render(); }

  $<HTMLInputElement>('.stc-file').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement, f = input.files?.[0]; input.value = ''; if (!f) return;
    try {
      say(`Reading ${f.name}...`); work.hidden = true;
      const bytes = new Uint8Array(await f.arrayBuffer());
      if (!(bytes[0] === 0x25 && bytes[1] === 0x50)) throw new Error('This is not a PDF file.');
      const pieces = await readPieces(bytes);
      if (!pieces.length) throw new Error('No text was found. This looks like a scanned picture, which this tool cannot read. Ask your bank for the digital statement, or an export as CSV.');
      rows = groupRows(pieces); name = f.name.replace(/\.pdf$/i, '');
      work.hidden = false; auto();
      say(`${f.name} read: ${rows.length} lines found. Check the table, then download.`);
    } catch (err: any) { say(`${f.name} could not be read. ${err.message || 'It may be damaged or locked with a password.'}`, true); }
  });
  colsIn.addEventListener('input', render);
  for (const s of ['.stc-dated', '.stc-join', '.stc-tidy', '.stc-head']) $(s).addEventListener('change', render);
  $('.stc-auto').addEventListener('click', auto);
  $('.stc-csv').addEventListener('click', () => {
    if (!current.length) { say('Nothing to download yet.', true); return; }
    download(new Blob(['﻿' + toCsv(current)], { type: 'text/csv;charset=utf-8' }), `${name}.csv`, 'text/csv');
  });
  $('.stc-copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(current.map((r) => r.join('\t')).join('\n')); say('Copied. Paste it into a spreadsheet.'); } catch { say('Your browser would not allow copying. Use Download CSV instead.', true); }
  });
</script>
