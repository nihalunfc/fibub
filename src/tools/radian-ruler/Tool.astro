---
// Radian ruler: lay the radius along the circle to see what one radian is, convert degrees and radians (with π
// forms), and read arc length s = rθ and sector area ½r²θ live.
import '../../styles/astro.css';
import SmQuiz from '../../components/SmQuiz.astro';
---
<div class="ax rdr">
  <div class="ax-card">
    <h2>Set the angle and the radius</h2>
    <label class="rd-sl"><span>Angle θ = <b class="rd-dv"></b>°</span><input class="rd-t" type="range" min="0" max="360" step="1" value="120" /></label>
    <label class="rd-sl"><span>Radius r = <b class="rd-rv"></b> cm</span><input class="rd-r" type="range" min="1" max="10" step="0.5" value="3" /></label>
    <div class="ax-grid">
      <label>Type degrees <input class="rd-deg" type="text" inputmode="decimal" value="120" /></label>
      <label>or radians (2.1 or 3pi/4) <input class="rd-rad" type="text" value="" placeholder="e.g. 3pi/4" autocomplete="off" spellcheck="false" /></label>
    </div>
    <p class="ax-err rd-err" hidden></p>
    <div class="ax-row"><button type="button" class="btn small rd-wrap">Wrap radii round the circle</button></div>
  </div>

  <div class="ax-card">
    <h2 class="rd-title"></h2>
    <canvas class="ax-fig rd-fig" role="img"></canvas>
    <p class="ax-legend"><span><i class="rd-k1"></i>arc s = rθ</span><span><i class="rd-k2"></i>radius r</span><span><i class="rd-k3"></i>a mark every radian</span></p>
    <dl class="ax-facts rd-facts"></dl>
    <p class="rd-note"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="rd-try">
      <li>Set θ to 57° or 58°: the arc is just about as long as the radius. That angle, 57.3°, is one radian.</li>
      <li>Press <b>Wrap radii</b> and count the marks: six whole radii and a bit fit round any circle, because 2π ≈ 6.28.</li>
      <li>Change the radius but not the angle: the arc grows, but s ÷ r, the angle in radians, stays the same.</li>
      <li>Type 3pi/4 in the radians box: the angle jumps to 135°.</li>
    </ul>
  </div>

  <SmQuiz cls="rd-quiz" />
</div>

<script>
  import { toRad, toDeg, piForm, readRad, arc, sector } from '../../lib/sci/school-radian';
  import { paint, type Figure } from '../../lib/report';
  import { fmt, FONT } from '../../lib/sm-graph';
  import { num } from '../../lib/sci/num';
  import { quiz, rint, pick, type Question } from '../../lib/sm-quiz';

  const root = document.querySelector<HTMLElement>('.rdr')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const W = 380, H = 320;
  let deg = 120, anim = 0;
  const fact = (k: string, v: string) => { const el = document.createElement('div'); el.innerHTML = '<dt></dt><dd></dd>'; el.querySelector('dt')!.textContent = k; el.querySelector('dd')!.textContent = v; return el; };

  function draw(from = '') {
    const r = +q<HTMLInputElement>('.rd-r').value, th = toRad(deg);
    if (from !== 'slider') q<HTMLInputElement>('.rd-t').value = String(Math.min(360, Math.max(0, deg)));
    if (from !== 'deg') q<HTMLInputElement>('.rd-deg').value = fmt(deg, 4);
    if (from !== 'rad') q<HTMLInputElement>('.rd-rad').value = '';
    q('.rd-dv').textContent = fmt(deg, 2); q('.rd-rv').textContent = fmt(r, 1);
    const pf = piForm(deg);
    q('.rd-title').textContent = `${fmt(deg, 2)}° = ${pf ? pf + ' ≈ ' : ''}${fmt(th, 4)} radians`;
    const R = 120, cx = W / 2, cy = H / 2 + 4, show = Math.min(th, 2 * Math.PI);
    const fig: Figure = { w: W, h: H, alt: `Circle of radius ${fmt(r, 1)} cm with an angle of ${fmt(deg, 2)}°: the arc is ${fmt(arc(r, th), 3)} cm, ${fmt(th, 3)} radii long.`, draw: (ctx, w, h, pl) => {
      ctx.lineWidth = 1.4; ctx.strokeStyle = pl.line; ctx.beginPath(); ctx.arc(cx, cy, R, 0, 2 * Math.PI); ctx.stroke();
      // sector
      ctx.globalAlpha = 0.14; ctx.fillStyle = pl.accent; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.arc(cx, cy, R, 0, -show, true); ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;
      ctx.strokeStyle = pl.accent; ctx.lineWidth = 6; ctx.lineCap = 'round'; ctx.beginPath(); ctx.arc(cx, cy, R, 0, -show, true); ctx.stroke(); ctx.lineCap = 'butt';
      // the two radii
      ctx.strokeStyle = pl.accent2; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + R, cy); ctx.moveTo(cx, cy); ctx.lineTo(cx + R * Math.cos(show), cy - R * Math.sin(show)); ctx.stroke();
      ctx.font = FONT; ctx.fillStyle = pl.accent2; ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText('r', cx + R / 2, cy + 4);
      // radian marks: every radius-length along the arc
      ctx.textBaseline = 'middle';
      for (let k = 1; k <= 6; k++) {
        const a = k; const x1 = cx + (R - 9) * Math.cos(a), y1 = cy - (R - 9) * Math.sin(a), x2 = cx + (R + 9) * Math.cos(a), y2 = cy - (R + 9) * Math.sin(a);
        const on = a <= show + 1e-9;
        ctx.strokeStyle = on ? pl.good : pl.line; ctx.lineWidth = on ? 3 : 1.5; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
        ctx.fillStyle = on ? pl.good : pl.muted; ctx.fillText(String(k), cx + (R + 22) * Math.cos(a), cy - (R + 22) * Math.sin(a));
      }
      // angle arc and label
      ctx.strokeStyle = pl.ink; ctx.lineWidth = 1.4; ctx.beginPath(); ctx.arc(cx, cy, 26, 0, -show, true); ctx.stroke();
      ctx.fillStyle = pl.ink; ctx.fillText('θ', cx + 40 * Math.cos(show / 2), cy - 40 * Math.sin(show / 2));
      ctx.beginPath(); ctx.arc(cx, cy, 3, 0, 7); ctx.fill();
    } };
    paint(q<HTMLCanvasElement>('.rd-fig'), fig);
    q('.rd-facts').replaceChildren(
      fact('In radians', `${pf ? pf + ' = ' : ''}${fmt(th, 4)}`),
      fact('Arc length s = r θ', `${fmt(r, 1)} × ${fmt(th, 4)} = ${fmt(arc(r, th), 3)} cm`),
      fact('Radii along the arc', `${fmt(th, 3)} (that is what the radian number counts)`),
      fact('Sector area ½ r² θ', `½ × ${fmt(r * r, 2)} × ${fmt(th, 4)} = ${fmt(sector(r, th), 3)} cm²`),
    );
    q('.rd-note').textContent = `To turn degrees into radians multiply by π/180; to go back multiply by 180/π. One radian = 180/π ≈ 57.30°. ${deg > 360 ? 'Angles over 360° go round more than once; the picture shows one full turn.' : ''}`;
  }

  const err = q('.rd-err');
  q('.rd-t').addEventListener('input', () => { cancelAnimationFrame(anim); deg = +q<HTMLInputElement>('.rd-t').value; err.hidden = true; draw('slider'); });
  q('.rd-r').addEventListener('input', () => draw('r'));
  q('.rd-deg').addEventListener('input', () => { const v = num(q<HTMLInputElement>('.rd-deg').value); if (!Number.isFinite(v) || Math.abs(v) > 3600) { err.textContent = 'Type degrees as a number up to 3600.'; err.hidden = false; return; } err.hidden = true; deg = Math.abs(v); draw('deg'); });
  q('.rd-rad').addEventListener('input', () => { const v = readRad(q<HTMLInputElement>('.rd-rad').value); if (!Number.isFinite(v) || Math.abs(v) > 63) { err.textContent = 'Type radians as a number (2.1) or with pi (3pi/4, pi/6).'; err.hidden = false; return; } err.hidden = true; deg = Math.abs(toDeg(v)); draw('rad'); });
  q('.rd-wrap').addEventListener('click', () => { cancelAnimationFrame(anim); const t0 = performance.now(); const st = (t: number) => { const k = Math.min(1, (t - t0) / 3000); deg = Math.round(360 * k); draw(); if (k < 1) anim = requestAnimationFrame(st); }; anim = requestAnimationFrame(st); });
  document.addEventListener('fibub:theme', () => draw());
  draw();

  quiz(q('.rd-quiz'), (): Question[] => {
    const d = pick([30, 45, 60, 120, 135, 150, 210, 225, 240, 300, 315, 330]), rr = pick([['π/3', 60], ['5π/6', 150], ['7π/4', 315], ['2π/3', 120], ['3π/2', 270], ['π/9', 20]] as [string, number][]);
    const r = rint(2, 12), k = pick([1, 2, 3, 4, 5]), s = rint(3, 20), rad = rint(2, 9);
    return [
      { text: `Write ${d}° in radians (a decimal, or like 3pi/4).`, answer: toRad(d), tol: 2e-3, worked: `${d} × π/180 = ${piForm(d)} ≈ ${fmt(toRad(d), 4)}.` },
      { text: `Write ${rr[0]} radians in degrees.`, answer: rr[1], worked: `${rr[0]} × 180/π = ${rr[1]}°.` },
      { text: `A circle has radius ${r} cm. How long is the arc cut off by an angle of ${k} radian${k === 1 ? '' : 's'}?`, answer: r * k, worked: `s = r θ = ${r} × ${k} = ${r * k} cm.` },
      { text: `An arc ${s} cm long on a circle of radius ${rad} cm: what angle does it make at the centre, in degrees?`, answer: toDeg(s / rad), tol: 0.05, worked: `θ = s / r = ${s}/${rad} = ${fmt(s / rad, 4)} rad, and × 180/π = ${fmt(toDeg(s / rad), 2)}°.` },
      { text: 'How many degrees is one radian, roughly?', choices: ['1°', '57.3°', '90°', '180°'], correct: 1, worked: 'π radians = 180°, so 1 radian = 180/π ≈ 57.3°: the angle whose arc is as long as the radius.' },
    ];
  });
</script>

<style is:inline>
  .rdr .rd-sl { display: grid; gap: 4px; color: var(--ink); font-size: 15px; margin-top: 8px; }
  .rdr .rd-sl input[type=range] { width: 100%; height: 32px; accent-color: var(--accent); }
  .rdr .ax-grid { margin-top: 10px; }
  .rdr .ax-row { margin-top: 10px; }
  .rdr i.rd-k1 { background: var(--accent); } .rdr i.rd-k2 { background: var(--warn); } .rdr i.rd-k3 { background: var(--good); }
  .rdr .rd-note { margin: 8px 0 0; }
  .rdr .rd-try { padding-left: 20px; display: grid; gap: 6px; margin: 0; }
</style>
