---
// #1771 Find and replace. Maths in src/lib/docs/textutil.ts.
---
<div class="tool-ui fnr">
  <div class="fnr-card">
    <label>Your text
      <textarea class="fnr-in" placeholder="Paste your text here"></textarea>
    </label>
    <p class="fnr-hint">Your text stays on this device. It is never sent anywhere.</p>
  </div>
  <div class="fnr-card">
    <h2>Find and replace</h2>
    <p class="fnr-hint">Pairs run from the top down, each on the result of the one before.</p>
    <div class="fnr-pairs"></div>
    <div class="fnr-row"><button type="button" class="btn fnr-add">Add another pair</button></div>
    <label class="fnr-chk"><input type="checkbox" class="fnr-case" /> <span>Match case<small>Off means "Cat" and "cat" both match.</small></span></label>
    <label class="fnr-chk"><input type="checkbox" class="fnr-word" /> <span>Whole word only<small>"cat" will not match inside "concatenate".</small></span></label>
    <label class="fnr-chk"><input type="checkbox" class="fnr-re" /> <span>Use patterns (regular expressions)<small>For experts. In "replace with" use $1, $2 for the groups you marked with brackets.</small></span></label>
    <p class="fnr-err" hidden></p>
  </div>
  <div class="fnr-card">
    <h2>Matches</h2>
    <p class="fnr-count" aria-live="polite"></p>
    <pre class="fnr-pre fnr-prev"></pre>
  </div>
  <div class="fnr-card">
    <h2>Result</h2>
    <pre class="fnr-pre fnr-out"></pre>
    <div class="fnr-row"><button type="button" class="btn fnr-copy">Copy the result</button><button type="button" class="btn fnr-use">Use result as my text</button></div>
  </div>
</div>
<style is:inline>
  .fnr { display: grid; gap: 14px; margin-bottom: 28px; }
  .fnr-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; display: grid; gap: 10px; min-width: 0; }
  .fnr-card h2 { margin: 0; font-size: 18px; }
  .fnr label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); min-width: 0; }
  .fnr textarea, .fnr input[type=text], .fnr input[type=number], .fnr select { font: inherit; font-size: 16px; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .fnr textarea { min-height: 180px; resize: vertical; }
  .fnr .fnr-chk { display: flex; align-items: flex-start; gap: 8px; color: var(--ink); }
  .fnr .fnr-chk input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent); flex: none; }
  .fnr .fnr-chk small { display: block; color: var(--muted); font-size: 13px; }
  .fnr-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .fnr-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .fnr-hint { margin: 0; font-size: 13px; color: var(--muted); }
  .fnr .btn { justify-self: start; }
  .fnr mark { background: color-mix(in srgb, var(--bad) 25%, transparent); color: inherit; border-radius: 3px; }
  .fnr-pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; padding: 10px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); max-height: 320px; overflow: auto; }
  @media (max-width: 480px) { .fnr-grid { grid-template-columns: minmax(0, 1fr); } }
  .fnr-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; gap: 8px; align-items: end; }
  .fnr-err { margin: 0; color: var(--bad); }
  .fnr-count { margin: 0; font-weight: 600; }
  @media (max-width: 480px) { .fnr-pair { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { findReplace, countText } from '../../lib/docs/textutil';
  const root = document.querySelector('.fnr') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const inp = q<HTMLTextAreaElement>('.fnr-in'), pairsEl = q('.fnr-pairs'), out = q('.fnr-out'), prev = q('.fnr-prev'),
    cs = q<HTMLInputElement>('.fnr-case'), wd = q<HTMLInputElement>('.fnr-word'), re = q<HTMLInputElement>('.fnr-re');
  const addPair = (f = '', r = '') => {
    const d = document.createElement('div'); d.className = 'fnr-pair';
    d.innerHTML = '<label>Find<input type="text" class="fnr-f" autocomplete="off" spellcheck="false"></label><label>Replace with<input type="text" class="fnr-r" autocomplete="off" spellcheck="false"></label><button type="button" class="btn fnr-x" aria-label="Remove this pair">Remove</button>';
    (d.querySelector('.fnr-f') as HTMLInputElement).value = f; (d.querySelector('.fnr-r') as HTMLInputElement).value = r;
    d.querySelector('.fnr-x')!.addEventListener('click', () => { if (pairsEl.children.length > 1) d.remove(); else { (d.querySelector('.fnr-f') as HTMLInputElement).value = ''; (d.querySelector('.fnr-r') as HTMLInputElement).value = ''; } update(); });
    pairsEl.append(d);
  };
  const getPairs = () => [...pairsEl.querySelectorAll('.fnr-pair')].map((d) => ({ find: (d.querySelector('.fnr-f') as HTMLInputElement).value, replace: (d.querySelector('.fnr-r') as HTMLInputElement).value }));
  const update = () => {
    const r = findReplace(inp.value, getPairs(), { regex: re.checked, matchCase: cs.checked, wholeWord: wd.checked });
    const err = q('.fnr-err'); err.hidden = r.ok; err.textContent = r.error || '';
    out.textContent = r.text;
    prev.innerHTML = '';
    for (const s of r.segments) { if (s.hit) { const m = document.createElement('mark'); m.textContent = s.text; prev.append(m); } else prev.append(document.createTextNode(s.text)); }
    const hasFind = getPairs().some((p) => p.find);
    q('.fnr-count').textContent = !hasFind ? 'Type what to find above.' : r.ok ? `${r.total} ${r.total === 1 ? 'match' : 'matches'} replaced` + (r.counts.length > 1 ? ' (' + r.counts.join(' + ') + ').' : '.') : '';
  };
  q('.fnr-add').addEventListener('click', () => { addPair(); (pairsEl.lastElementChild!.querySelector('.fnr-f') as HTMLInputElement).focus(); });
  [inp, cs, wd, re].forEach((e) => { e.addEventListener('input', update); e.addEventListener('change', update); });
  pairsEl.addEventListener('input', update);
  const copy = q<HTMLButtonElement>('.fnr-copy');
  copy.addEventListener('click', async () => { try { await navigator.clipboard.writeText(out.textContent || ''); copy.textContent = 'Copied'; } catch { copy.textContent = 'Press Ctrl+C to copy'; } setTimeout(() => (copy.textContent = 'Copy the result'), 1800); });
  q('.fnr-use').addEventListener('click', () => { inp.value = out.textContent || ''; update(); });
  addPair(); update();
</script>
