---
// Transpiration lab: a leafy shoot in a bubble potometer. Light, temperature, humidity, wind and petroleum jelly on
// the leaves change how fast the bubble moves. Teaching model with made-up round numbers.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax trl">
  <p class="ax-help trl-note">A teaching model: the shoot's numbers are made-up round values, so a real potometer will give different readings.</p>
  <div class="ax-card">
    <div class="ax-row"><span class="trl-lab">Level</span>
      <div class="ax-seg trl-level" role="group" aria-label="Level"><button type="button" data-v="10" aria-pressed="true">Class 10</button><button type="button" data-v="11" aria-pressed="false">Class 11</button></div></div>
    <label class="trl-gap">Light: <b class="trl-lv"></b>
      <input type="range" class="trl-l" min="0" max="100" step="5" value="50" aria-label="Light, per cent of full sun" /></label>
    <label class="trl-gap">Air temperature: <b class="trl-tv"></b>
      <input type="range" class="trl-t" min="5" max="40" step="1" value="20" aria-label="Air temperature in degrees Celsius" /></label>
    <label class="trl-gap">Humidity: <b class="trl-hv"></b>
      <input type="range" class="trl-h" min="10" max="100" step="5" value="50" aria-label="Relative humidity, per cent" /></label>
    <label class="trl-gap">Wind (a fan): <b class="trl-wv"></b>
      <input type="range" class="trl-w" min="0" max="5" step="0.5" value="0" aria-label="Wind speed in metres per second" /></label>
    <div class="ax-row trl-gap"><span class="trl-lab">Jelly on</span>
      <div class="ax-seg trl-coat" role="group" aria-label="Petroleum jelly on the leaves"><button type="button" data-v="none" aria-pressed="true">None</button><button type="button" data-v="upper" aria-pressed="false">Upper sides</button><button type="button" data-v="lower" aria-pressed="false">Lower sides</button><button type="button" data-v="both" aria-pressed="false">Both</button></div></div>
  </div>

  <div class="ax-card">
    <canvas class="ax-fig trl-fig"></canvas>
    <p class="ax-help trl-speed">The bubble is shown 30 times faster than real life.</p>
    <p class="ax-big trl-big" aria-live="polite"></p>
    <p class="trl-say"></p>
    <dl class="ax-facts trl-facts"></dl>
    <p class="trl-formula"></p>
  </div>

  <div class="ax-card">
    <h2>Take readings</h2>
    <p class="ax-help">Like the real practical: let the shoot settle, then read how far the bubble moves in 5 minutes. Real readings wobble a little, so each one is slightly different.</p>
    <div class="ax-row"><button type="button" class="btn small trl-read">Read 5 minutes</button><button type="button" class="btn secondary small trl-csv" disabled>Download results (CSV)</button><button type="button" class="btn secondary small trl-clear" disabled>Clear</button></div>
    <div class="ax-scroll"><table class="trl-tab"></table></div>
  </div>

  <div class="ax-card">
    <h2>Rate graph</h2>
    <div class="ax-row"><span class="trl-lab">Across</span>
      <div class="ax-seg trl-axis" role="group" aria-label="What changes along the graph"><button type="button" data-v="l" aria-pressed="true">Light</button><button type="button" data-v="t" aria-pressed="false">Temperature</button><button type="button" data-v="h" aria-pressed="false">Humidity</button><button type="button" data-v="w" aria-pressed="false">Wind</button></div></div>
    <canvas class="ax-fig trl-graph"></canvas>
    <p class="ax-help trl-gnote"></p>
    <Downloads />
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="trl-try">
      <li>Turn the light down to 0 %. Why does the bubble almost stop at night?</li>
      <li>Switch on the fan, then raise the humidity to 100 %. Why does the wind not help when the air is already full of water?</li>
      <li>Put jelly on the upper sides, then on the lower sides. Which slows the bubble more, and what does that tell you about where the stomata are?</li>
      <li>Class 11: watch the vapour pressure deficit as you warm the air from 20 °C to 30 °C at the same humidity.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <ol class="trl-qs"></ol>
    <div class="ax-row"><button type="button" class="btn small trl-check">Check answers</button><button type="button" class="btn secondary small trl-new">New questions</button></div>
    <p class="trl-score" aria-live="polite"></p>
  </div>
</div>

<script>
  import { esat, vpd, stomata, boundary, conductance, rate, bubbleMm, G_MAX, type Coat } from '../../lib/sci/potometer';
  import { chartFigure } from '../../lib/sci/plot';
  import { csv } from '../../lib/sci/num';
  import { paint, pagePalette, wireDownloads, save, type Figure, type Palette, type Section } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.trl')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const v = (c: string) => Number(q<HTMLInputElement>(c).value);
  const fx = (x: number, d = 1) => x.toFixed(d).replace('-', '−');
  const R_MM = 0.5; // capillary inner radius
  const COAT: Record<Coat, string> = { none: 'no jelly', upper: 'jelly on upper sides', lower: 'jelly on lower sides', both: 'jelly on both sides' };
  let level = 10, coat: Coat = 'none', axis = 'l', graph: Figure | null = null;
  type Reading = { l: number; t: number; h: number; w: number; coat: Coat; mm: number };
  let readings: Reading[] = [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const now = () => { const l = v('.trl-l'), t = v('.trl-t'), h = v('.trl-h'), w = v('.trl-w'); return { l, t, h, w, r: rate(l, t, h, w, coat) }; };
  const mmPer5 = (r: number) => bubbleMm((r * 5) / 60, R_MM);

  // ---------- the picture ----------
  let pos = 0, last = 0, blades = 0;
  const W = 480, H = 300;
  function drawScene(ctx: CanvasRenderingContext2D, w: number, h: number, pal: Palette) {
    const s = now();
    ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.font = '13px system-ui, sans-serif'; ctx.textBaseline = 'middle';
    // lamp, brighter with more light
    ctx.globalAlpha = 0.15 + (s.l / 100) * 0.75; ctx.fillStyle = pal.red ? pal.twilight : pal.bg === '#ffffff' ? '#ffe98a' : '#5a4c12';
    ctx.beginPath(); ctx.arc(60, 50, 26, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1;
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(60, 50, 16, 0, Math.PI * 2); ctx.stroke();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'center'; ctx.fillText(`light ${s.l} %`, 60, 92);
    // fan
    if (s.w > 0) {
      const fxp = 420, fyp = 60; ctx.strokeStyle = pal.ink; ctx.lineWidth = 2;
      for (let k = 0; k < 3; k++) { const a = blades + (k * 2 * Math.PI) / 3; ctx.beginPath(); ctx.ellipse(fxp + Math.cos(a) * 12, fyp + Math.sin(a) * 12, 12, 5, a, 0, Math.PI * 2); ctx.stroke(); }
      ctx.beginPath(); ctx.moveTo(fxp, fyp + 20); ctx.lineTo(fxp, fyp + 60); ctx.stroke();
      ctx.strokeStyle = pal.muted; ctx.lineWidth = 1.5;
      for (let k = 0; k < Math.ceil(s.w); k++) { const y = 40 + k * 14; ctx.beginPath(); ctx.moveTo(395, y); ctx.lineTo(330, y); ctx.lineTo(338, y - 4); ctx.stroke(); }
      ctx.fillStyle = pal.muted; ctx.fillText(`wind ${fx(s.w)} m/s`, fxp, 140);
    }
    // shoot in the tube
    const sx = 230, top = 70;
    ctx.strokeStyle = pal.good; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(sx, 190); ctx.lineTo(sx, top); ctx.stroke();
    const leaves: [number, number, number][] = [[-1, 90, 0.9], [1, 110, 1], [-1, 135, 1.1], [1, 158, 0.9], [-1, 178, 0.8]];
    for (const [side, y, sc] of leaves) {
      ctx.save(); ctx.translate(sx, y); ctx.scale(side, 1); ctx.rotate(-0.35);
      ctx.beginPath(); ctx.ellipse(28 * sc, 0, 28 * sc, 10 * sc, 0, 0, Math.PI * 2);
      ctx.fillStyle = coat === 'none' ? pal.bg : pal.grid; ctx.fill(); ctx.strokeStyle = pal.good; ctx.lineWidth = 2; ctx.stroke(); ctx.restore();
    }
    // water vapour leaving: little arrows, more when faster
    ctx.strokeStyle = pal.accent; ctx.lineWidth = 1.5; const n = Math.min(8, Math.round(s.r * 4));
    for (let k = 0; k < n; k++) { const x = sx - 70 + (k % 4) * 46, y = top - 6 + Math.floor(k / 4) * 30 + 40; ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x, y - 14); ctx.moveTo(x - 4, y - 9); ctx.lineTo(x, y - 14); ctx.lineTo(x + 4, y - 9); ctx.stroke(); }
    // tube, reservoir, capillary with scale
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(sx - 9, 185); ctx.lineTo(sx - 9, 240); ctx.lineTo(70, 240); ctx.moveTo(sx + 9, 185); ctx.lineTo(sx + 9, 250); ctx.lineTo(70, 250); ctx.stroke();
    ctx.globalAlpha = 0.18; ctx.fillStyle = pal.accent; ctx.fillRect(70, 240, sx - 61, 10); ctx.fillRect(sx - 9, 185, 18, 60); ctx.globalAlpha = 1;
    // scale 0..100 mm along the capillary, from x = 80 (100 mm) to x = 220 (0 mm)
    ctx.fillStyle = pal.muted; ctx.textAlign = 'center'; ctx.lineWidth = 1; ctx.strokeStyle = pal.muted;
    for (let mm = 0; mm <= 100; mm += 10) { const x = 220 - mm * 1.4; ctx.beginPath(); ctx.moveTo(x, 254); ctx.lineTo(x, mm % 50 ? 259 : 263); ctx.stroke(); if (mm % 50 === 0) ctx.fillText(String(mm), x, 274); }
    ctx.fillText('mm', 236, 274);
    // the bubble
    const bx = 220 - pos * 1.4; ctx.fillStyle = pal.bg; ctx.strokeStyle = pal.ink; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.ellipse(bx, 245, 6, 4, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.textAlign = 'left'; ctx.fillStyle = pal.ink; ctx.font = '600 15px system-ui, sans-serif';
    ctx.fillText(`${fx(s.r, 2)} mL an hour`, 280, 210);
    ctx.font = '13px system-ui, sans-serif'; ctx.fillStyle = pal.muted;
    ctx.fillText(`bubble ${fx(mmPer5(s.r))} mm in 5 min`, 280, 232);
    ctx.fillText(`${s.t} °C, humidity ${s.h} %`, 280, 254);
  }
  const picture: Figure = { w: W, h: H, alt: 'Leafy shoot in a bubble potometer', draw: drawScene };
  const canvas = () => q<HTMLCanvasElement>('.trl-fig');
  function frame(t: number) {
    const dt = last ? Math.min(0.1, (t - last) / 1000) : 0; last = t;
    const s = now(); pos += (mmPer5(s.r) / 300) * 30 * dt; if (pos > 100) pos = 0;
    blades += s.w * 2 * dt;
    paint(canvas(), picture, pagePalette());
    if (!reduce) requestAnimationFrame(frame);
  }

  function facts(list: [string, string, string?][]) {
    return list.map(([k, val, s]) => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = val; if (s) { const m = document.createElement('small'); m.textContent = s; d.querySelector('dd')!.append(m); } return d; });
  }
  let factList: [string, string, string?][] = [];
  function update() {
    const s = now(), mm = mmPer5(s.r), gs = stomata(s.l, coat), gb = boundary(s.w), d = vpd(s.t, s.h);
    q('.trl-lv').textContent = `${s.l} % of full sun`; q('.trl-tv').textContent = `${s.t} °C`; q('.trl-hv').textContent = `${s.h} %`; q('.trl-wv').textContent = s.w ? `${fx(s.w)} m/s` : 'off';
    q('.trl-big').textContent = `${fx(s.r, 2)} mL of water an hour: the bubble moves ${fx(mm)} mm in 5 minutes`;
    const open = stomata(s.l) / G_MAX;
    let say = '';
    if (coat === 'both') say = 'Jelly on both sides blocks every stoma, so almost no water leaves and the bubble stops.';
    else if (s.h >= 100) say = 'The air is already full of water vapour, so there is nowhere for more to go. Transpiration stops.';
    else if (s.l < 10) say = 'In the dark the guard cells close the stomata, so very little water leaves the leaves.';
    else if (coat === 'lower') say = 'Most stomata are on the lower side of the leaves, so jelly there cuts water loss by about four fifths.';
    else if (coat === 'upper') say = 'Few stomata are on the upper side, so jelly there makes only a small difference.';
    else if (s.w === 0) say = 'Still air: a layer of moist air builds up next to the leaves and slows water loss. Try the fan.';
    else say = 'Light keeps the stomata open, and the wind carries the moist air away, so water leaves quickly.';
    q('.trl-say').textContent = say;
    factList = [
      ['Water taken up', `${fx(s.r, 2)} mL/hour`, 'about what the leaves lose'],
      ['Bubble speed', `${fx(mm / 5, 2)} mm/minute`, `capillary ${R_MM * 2} mm across`],
      ['Stomata open', `${fx(open * 100, 0)} %`, coat === 'none' ? 'more light, wider open' : `then ${COAT[coat]}`],
    ];
    if (level === 11) factList.push(
      ['Vapour pressure deficit', `${fx(d, 2)} kPa`, `${fx(esat(s.t), 2)} × (1 − ${s.h / 100})`],
      ['Stomatal conductance', fx(gs, 3), 'gs, set by light and jelly'],
      ['Boundary layer conductance', fx(gb, 3), 'gb, raised by wind'],
      ['Total conductance', fx(conductance(s.l, s.w, coat), 3), '1 ÷ (1/gs + 1/gb)'],
    );
    q('.trl-facts').replaceChildren(...facts(factList));
    q('.trl-formula').textContent = level === 10
      ? `Bubble speed = ${fx(mm)} mm ÷ 5 min = ${fx(mm / 5, 2)} mm/min`
      : `Volume = π r² d = π × ${R_MM}² × ${fx(mm)} = ${fx(Math.PI * R_MM * R_MM * mm)} mm³ in 5 min = ${fx(s.r, 2)} mL/h`;
    drawGraph();
    if (reduce) paint(canvas(), picture, pagePalette());
  }

  function drawGraph() {
    const s = now(), series: any[] = [];
    const grid = (n: number, lo: number, hi: number) => Array.from({ length: n + 1 }, (_, j) => lo + (j / n) * (hi - lo));
    let xLabel = '', xMin = 0, xMax = 100, here = 0, note = '', f: (x: number, c: Coat) => number;
    if (axis === 'l') { xLabel = 'Light (% of full sun)'; here = s.l; f = (x, c) => rate(x, s.t, s.h, s.w, c); note = 'Light opens the stomata quickly, then the rate levels off once they are wide open.'; }
    else if (axis === 't') { xLabel = 'Air temperature (°C)'; xMin = 5; xMax = 40; here = s.t; f = (x, c) => rate(s.l, x, s.h, s.w, c); note = 'Warm air holds much more water vapour, so at the same humidity it is thirstier and the rate climbs ever faster.'; }
    else if (axis === 'h') { xLabel = 'Humidity (%)'; xMin = 10; here = s.h; f = (x, c) => rate(s.l, s.t, x, s.w, c); note = 'The more humid the air, the slower the water leaves; at 100 % it stops.'; }
    else { xLabel = 'Wind (m/s)'; xMax = 5; here = s.w; f = (x, c) => rate(s.l, s.t, s.h, x, c); note = 'Wind blows away the moist air around the leaves. The first breeze helps most; after that the stomata limit the rate.'; }
    const xs = grid(200, xMin, xMax);
    series.push({ name: 'No jelly', x: xs, y: xs.map((x) => f(x, 'none')), mode: 'line', width: 2.2 });
    if (coat !== 'none') series.push({ name: COAT[coat][0].toUpperCase() + COAT[coat].slice(1), x: xs, y: xs.map((x) => f(x, coat)), mode: 'line', width: 2, dash: [6, 3] });
    series.push({ name: 'Now', x: [here], y: [s.r], marker: 'circle', size: 8 });
    graph = chartFigure({ w: 480, h: 320, font: 14, xLabel, yLabel: 'Water uptake (mL per hour)', xMin, xMax, yMin: 0, legend: 'below', series }, `Transpiration rate against ${xLabel.toLowerCase()}`);
    paint(q<HTMLCanvasElement>('.trl-graph'), graph);
    q('.trl-gnote').textContent = note;
  }

  const HEAD = ['Light (%)', 'Temp (°C)', 'Humidity (%)', 'Wind (m/s)', 'Jelly', 'Bubble in 5 min (mm)'];
  const row = (r: Reading) => [String(r.l), String(r.t), String(r.h), fx(r.w), r.coat === 'none' ? 'none' : r.coat, fx(r.mm)];
  function drawReadings() {
    const tb = q<HTMLTableElement>('.trl-tab'); tb.innerHTML = '';
    if (!readings.length) return;
    const hr = tb.createTHead().insertRow(); HEAD.forEach((h, j) => { const th = document.createElement('th'); th.textContent = h; if (j !== 4) th.className = 'r'; hr.append(th); });
    const b = tb.createTBody(); readings.forEach((r) => { const tr = b.insertRow(); row(r).forEach((x, j) => { const td = tr.insertCell(); td.textContent = x; if (j !== 4) td.className = 'r'; }); });
  }

  // ---------- Check yourself ----------
  type Qn = { text: string; options?: string[]; answer: string | number; tol?: number; worked: string };
  let qs: Qn[] = [];
  const pick = <T,>(a: T[]) => a[Math.floor(Math.random() * a.length)];
  function makeQuiz() {
    const d = pick([30, 36, 45, 60, 72]), t = pick([3, 5, 6]);
    qs = [
      { text: `In a potometer the bubble moves ${d} mm in ${t} minutes. What is its speed in mm per minute?`, answer: +(d / t).toFixed(2), tol: 0.05, worked: `${d} ÷ ${t} = ${fx(d / t, 2)} mm per minute.` },
      pick([
        { text: 'Which of these makes a plant lose water fastest?', options: ['a warm, dry, windy day', 'a cool, humid, still day', 'a dark night'], answer: 'a warm, dry, windy day', worked: 'Warmth and dry air raise the pull on water; wind removes the moist layer; daylight keeps stomata open.' },
        { text: 'Why does transpiration almost stop at night?', options: ['the stomata close', 'the roots stop working', 'the leaves fall off'], answer: 'the stomata close', worked: 'Without light the guard cells lose turgor and close the stomata.' },
      ]),
      { text: 'Jelly on the lower sides of the leaves slows the bubble far more than jelly on the upper sides. Why?', options: ['most stomata are on the lower side', 'the lower side is warmer', 'water only moves downwards'], answer: 'most stomata are on the lower side', worked: 'In most dicot leaves the stomata are mainly on the lower surface, where they are shaded and cooler.' },
    ];
    if (level === 10) {
      qs.push({ text: 'Through which tiny pores do leaves lose most of their water?', options: ['stomata', 'lenticels', 'root hairs'], answer: 'stomata', worked: 'Water vapour leaves mainly through the stomata, each opened and closed by two guard cells.' });
    } else {
      const r = pick([0.25, 0.5, 0.75]), dd = pick([20, 40, 60, 80]);
      const vol = Math.PI * r * r * dd;
      qs.push({ text: `The capillary has an inner radius of ${r} mm and the bubble moves ${dd} mm. What volume of water was taken up, in mm³? (V = π r² d)`, answer: +vol.toFixed(2), tol: 0.06, worked: `π × ${r}² × ${dd} = ${fx(vol, 2)} mm³ (= ${fx(vol / 1000, 4)} mL).` });
      const T = pick([20, 25, 30]), H = pick([40, 50, 60, 80]), es = +esat(T).toFixed(2);
      qs.push({ text: `At ${T} °C the saturation vapour pressure is ${es} kPa. What is the vapour pressure deficit at ${H} % humidity, in kPa?`, answer: +(es * (1 - H / 100)).toFixed(3), tol: 0.01, worked: `${es} × (1 − ${H / 100}) = ${fx(es * (1 - H / 100), 3)} kPa.` });
    }
    const ol = q('.trl-qs'); ol.innerHTML = '';
    qs.forEach((qq, j) => {
      const li = document.createElement('li'); li.dataset.a = String(qq.answer);
      const p = document.createElement('p'); p.textContent = qq.text; li.append(p);
      if (qq.options) { const s = document.createElement('select'); s.className = 'trl-ans'; s.setAttribute('aria-label', `Answer ${j + 1}`); s.append(new Option('Choose…', ''), ...qq.options.map((o) => new Option(o, o))); li.append(s); }
      else { const inp = document.createElement('input'); inp.className = 'trl-ans'; inp.inputMode = 'decimal'; inp.setAttribute('aria-label', `Answer ${j + 1}`); li.append(inp); }
      const w = document.createElement('p'); w.className = 'trl-worked'; w.hidden = true; li.append(w);
      ol.append(li);
    });
    q('.trl-score').textContent = '';
  }
  function checkQuiz() {
    let right = 0;
    root.querySelectorAll<HTMLLIElement>('.trl-qs li').forEach((li, j) => {
      const qq = qs[j], el = li.querySelector('.trl-ans') as HTMLInputElement;
      const ok = qq.options ? el.value === qq.answer : el.value.trim() !== '' && Math.abs(Number(el.value.trim().replace(',', '.').replace('−', '-')) - Number(qq.answer)) <= (qq.tol ?? 0.01);
      if (ok) right++;
      const w = li.querySelector<HTMLElement>('.trl-worked')!; w.hidden = false; w.className = `trl-worked ${ok ? 'ok' : 'no'}`;
      w.textContent = `${ok ? '✓ Right.' : '✗ Not quite.'} ${qq.worked}`;
    });
    q('.trl-score').textContent = `${right} of ${qs.length} right.`;
  }

  // ---------- wiring ----------
  function seg(sel: string, on: (val: string) => void) {
    root.querySelectorAll<HTMLButtonElement>(`${sel} button`).forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll(`${sel} button`).forEach((o) => o.setAttribute('aria-pressed', String(o === b))); on(b.dataset.v!);
    }));
  }
  seg('.trl-level', (val) => { level = Number(val); update(); makeQuiz(); });
  seg('.trl-coat', (val) => { coat = val as Coat; update(); });
  seg('.trl-axis', (val) => { axis = val; drawGraph(); });
  root.querySelectorAll('input[type=range]').forEach((el) => el.addEventListener('input', update));
  q('.trl-read').addEventListener('click', () => {
    const s = now(), mm = Math.max(0, mmPer5(s.r) * (1 + (Math.random() - 0.5) * 0.06));
    readings.push({ l: s.l, t: s.t, h: s.h, w: s.w, coat, mm: Math.round(mm * 2) / 2 });
    q<HTMLButtonElement>('.trl-csv').disabled = false; q<HTMLButtonElement>('.trl-clear').disabled = false; drawReadings();
  });
  q('.trl-clear').addEventListener('click', () => { readings = []; q<HTMLButtonElement>('.trl-csv').disabled = true; q<HTMLButtonElement>('.trl-clear').disabled = true; drawReadings(); });
  q('.trl-csv').addEventListener('click', () => readings.length && save(new TextEncoder().encode(csv([['light_percent', 'temperature_C', 'humidity_percent', 'wind_m_s', 'jelly', 'bubble_mm_5min'], ...readings.map((r) => [r.l, r.t, r.h, r.w, r.coat, r.mm])])), 'potometer-readings.csv', 'text/csv'));
  q('.trl-check').addEventListener('click', checkQuiz);
  q('.trl-new').addEventListener('click', makeQuiz);
  document.addEventListener('fibub:theme', update);
  if (reduce) q('.trl-speed').textContent = 'The moving bubble is off because your device asks for less motion.';
  update(); makeQuiz();
  if (!reduce) requestAnimationFrame(frame);
  wireDownloads(q('.dl'), () => ({
    title: 'Transpiration lab', subtitle: q('.trl-big').textContent ?? '', file: 'transpiration-lab',
    sections: [
      { title: 'Set-up', text: [q('.trl-say').textContent ?? '', q('.trl-formula').textContent ?? '', 'Teaching model with made-up round numbers.'], facts: factList.map(([k, val, s]) => [k, s ? `${val} (${s})` : val] as [string, string]), figure: picture },
      { title: 'Rate graph', figure: graph ?? undefined, ...(readings.length ? { table: { head: HEAD, rows: readings.map(row), align: ['r', 'r', 'r', 'r', 'l', 'r'] as ('l' | 'r')[] } } : {}) },
    ] as Section[],
  }));
</script>

<style is:inline>
