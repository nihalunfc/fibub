---
// #1725 Canada tax: 2026 federal + provincial income tax, CPP/QPP, EI and take-home pay.
---
<div class="tool-ui cit">
  <section class="panel">
    <h2>Your income in 2026</h2>
    <div class="cit-grid">
      <label>Province or territory <select class="cit-prov"></select></label>
      <label>Employment income (salary, wages) <input class="cit-emp" inputmode="decimal" value="60,000" /></label>
      <label>Other income (interest, rent profit, pension) <input class="cit-oth" inputmode="decimal" value="0" /></label>
      <label>RRSP deduction <input class="cit-rrsp" inputmode="decimal" value="0" /></label>
    </div>
    <p class="cit-hint">Amounts are for the whole year, in Canadian dollars. Other income pays tax but no CPP or EI.</p>
    <p class="note warn cit-est" hidden></p>
  </section>

  <section class="cit-res" aria-live="polite">
    <div class="cit-stats">
      <div class="good"><span>Take-home a year</span><b class="cit-year"></b></div>
      <div><span>A month</span><b class="cit-month"></b></div>
      <div><span>Every two weeks</span><b class="cit-bi"></b></div>
      <div><span>Marginal / average rate</span><b class="cit-rates"></b></div>
    </div>
    <figure class="panel cit-fig">
      <figcaption>Where your money goes</figcaption>
      <div class="cit-bar" role="img"></div>
      <ul class="cit-key"></ul>
    </figure>
    <div class="panel cit-tw">
      <table>
        <thead><tr><th>Item</th><th>A year</th><th>A month</th></tr></thead>
        <tbody class="cit-body"></tbody>
      </table>
    </div>
  </section>
  <p class="cit-fine">Estimate for 2026 using the basic personal amount, the Canada employment amount and CPP/EI credits only. It leaves out other credits (tuition, medical, donations, dependants), low-income reductions in most provinces, Alberta's supplemental credit and the Ontario Trillium benefit. Not financial or tax advice: check the official source (canada.ca, Revenu Québec) or a tax professional. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .cit { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .cit h2 { margin: 0 0 12px; font-size: 18px; }
  .cit .panel { padding: 16px; }
  .cit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .cit label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .cit input, .cit select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .cit-hint, .cit-fine { color: var(--muted); font-size: 14px; margin: 10px 0 0; }
  .cit-res { display: grid; gap: 12px; min-width: 0; }
  .cit-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .cit-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .cit-stats span { font-size: 13px; color: var(--muted); }
  .cit-stats b { font-size: 20px; }
  .cit-stats .good b { color: var(--good); }
  .cit-fig { margin: 0; }
  .cit-fig figcaption { font-weight: 600; margin-bottom: 10px; }
  .cit-bar { display: flex; height: 28px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); }
  .cit-bar i { display: block; height: 100%; }
  .cit-key { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; }
  .cit-key i { display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
  .cit-tw { overflow-x: auto; }
  .cit table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .cit th, .cit td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); }
  .cit th:first-child, .cit td:first-child { text-align: left; }
  .cit th { font-size: 12px; color: var(--muted); }
  .cit tr.tot td { font-weight: 700; }
  @media (max-width: 640px) { .cit-stats { grid-template-columns: 1fr 1fr; } .cit-stats b { font-size: 17px; } }
</style>

<script>
  import { canadaTax, PROVINCES } from '../../lib/money/canada-income-tax.ts';
  const root = document.querySelector('.cit') as HTMLElement;
  const q = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const prov = q<HTMLSelectElement>('.cit-prov');
  prov.innerHTML = Object.entries(PROVINCES).sort((a, b) => a[1].name.localeCompare(b[1].name))
    .map(([k, p]) => `<option value="${k}"${k === 'ON' ? ' selected' : ''}>${p.name}</option>`).join('');
  const num = (s: string) => { const n = parseFloat(String(s).replace(/[^0-9.\-]/g, '')); return isFinite(n) ? n : 0; };
  const $ = (n: number) => n.toLocaleString('en-CA', { style: 'currency', currency: 'CAD' });
  const pct = (n: number) => `${(Math.round(n * 1000) / 10).toFixed(1)}%`;

  const update = () => {
    const r = canadaTax({ prov: prov.value, employment: num(q<HTMLInputElement>('.cit-emp').value), other: num(q<HTMLInputElement>('.cit-oth').value), rrsp: num(q<HTMLInputElement>('.cit-rrsp').value) });
    const qc = prov.value === 'QC', name = PROVINCES[prov.value].name;
    q('.cit-year').textContent = $(r.takeHome);
    q('.cit-month').textContent = $(r.takeHome / 12);
    q('.cit-bi').textContent = $(r.takeHome / 26);
    q('.cit-rates').textContent = `${pct(r.marginal)} / ${pct(r.average)}`;
    const est = q('.cit-est');
    est.hidden = !r.estimate;
    est.textContent = r.estimate ? `Estimate, check the official source: ${r.estimate}` : '';
    const rows: [string, number, string][] = [
      ['Federal tax' + (qc ? ' (after the 16.5% Quebec abatement)' : ''), r.federal, 'var(--accent)'],
      [`${name} tax`, r.provincial, 'var(--warn)'],
    ];
    if (r.surtax) rows.push(['Ontario surtax', r.surtax, 'var(--bad)']);
    if (r.healthPremium) rows.push(['Ontario Health Premium', r.healthPremium, 'var(--bad)']);
    rows.push([qc ? 'QPP' : 'CPP', r.cpp, 'var(--ink)']);
    if (r.cpp2) rows.push([qc ? 'QPP2' : 'CPP2', r.cpp2, 'var(--ink)']);
    rows.push(['EI', r.ei, 'var(--muted)']);
    if (r.qpip) rows.push(['QPIP (parental insurance)', r.qpip, 'var(--muted)']);
    const parts: [string, number, string][] = [['Take-home', r.takeHome, 'var(--good)'], ...rows];
    const total = Math.max(r.gross, 1);
    q('.cit-bar').innerHTML = parts.filter((p) => p[1] > 0).map(([l, v, c]) => `<i title="${l}" style="width:${(v / total) * 100}%;background:${c}"></i>`).join('');
    q('.cit-bar').setAttribute('aria-label', parts.map(([l, v]) => `${l} ${pct(v / total)}`).join(', '));
    q('.cit-key').innerHTML = parts.map(([l, v, c]) => `<li><i style="background:${c}"></i>${l} ${pct(v / total)}</li>`).join('');
    q('.cit-body').innerHTML = [
      ['Total income', r.gross], ['Taxable income', r.taxable], ...rows.map(([l, v]) => [l, -v] as [string, number]),
    ].map(([l, v]) => `<tr><td>${l}</td><td>${$(v as number)}</td><td>${$((v as number) / 12)}</td></tr>`).join('')
      + `<tr class="tot"><td>Take-home pay</td><td>${$(r.takeHome)}</td><td>${$(r.takeHome / 12)}</td></tr>`;
  };
  root.addEventListener('input', update);
  root.addEventListener('change', update);
  update();
</script>
