      o.fig = strip(names, groups, 'Value', [], test === 'anova');
      return o;
    }
    if (test === 'chi-gof') {
      const g = gofOf(box.value), r = H.chiGof(g.obs, g.exp);
      o.big = `χ²(${r.df}) = ${f3(r.chi2)}, ${pBig(r.p)}`;
      o.say = [verdict(r.p, a, 'the counts do not follow the expected shares', 'the counts follow them'), `Cohen's w = ${f3(r.w)} (${rBand(r.w)}). ${g.exp ? '' : 'No expected shares were given, so every category is expected to be equal. '}The table shows where the counts are furthest from expected: residuals beyond ±2 stand out.`, pMeaning(r.p)];
      o.facts = [['χ²', f3(r.chi2)], ['Degrees of freedom', String(r.df)], ['p-value', pFull(r.p)], ['Total count', sig(r.N, 8)], ["Cohen's w", f3(r.w)], ['Smallest expected count', f3(r.minExp)]];
      o.tables = [{ title: 'Observed and expected', head: ['Category', 'Observed', 'Expected', 'Expected share', 'Residual'], rows: g.names.map((n, i) => [n, sig(g.obs[i], 8), f3(r.exp[i]), `${sig((r.exp[i] / r.N) * 100, 3)} %`, f3(r.resid[i])]), sig: (i) => Math.abs(r.resid[i]) > 2 }];
      o.assume = [['Independent', 'info', 'Each count is a separate subject or event, and each falls in exactly one category. Use counts, not percentages.'], r.minExp >= 5 ? ['Expected ≥ 5', 'good', `Every expected count is at least 5 (smallest ${f3(r.minExp)}).`] : ['Expected ≥ 5', 'warn', `An expected count is below 5 (${f3(r.minExp)}): the p-value may be off. Merge small categories if it makes sense.`]];
