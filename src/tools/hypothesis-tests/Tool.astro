        o.facts = [[`U (for ${A})`, f3(r.U1)], [`U (for ${B})`, f3(r.U2)], ['p-value', pFull(r.p)], ['Method', r.exact ? 'Exact (no ties, 50 or fewer per group)' : 'Normal approximation, tie and continuity corrected'], ['Rank-biserial r', f3(r.rbc)], ['P(' + A + ' > ' + B + ')', sig(r.cles, 3)], ['Hodges-Lehmann shift', f3(r.hl)]];
