    }
    if (['welch', 'student', 'mw'].includes(test)) {
      const g = groupsOf(box.value);
      if (g.groups.length < 2) throw new Error('Paste two groups: two columns, or a column of group names next to the values.');
      const [x, y] = g.groups, [A, B] = g.names;
      const extra = [g.note, g.groups.length > 2 ? `Only the first two groups (${A} and ${B}) are compared; use ANOVA or Kruskal-Wallis for more.` : ''].filter(Boolean).join(' ');
      if (test !== 'mw') {
        const r = H.tTwo(x, y, test === 'welch', alt, conf);
        o.big = `t(${test === 'welch' ? sig(r.df, 4) : r.df}) = ${f3(r.t)}, ${pBig(r.p)}`;
        o.say = [verdict(r.p, a, altWord(alt, A, B, 'mean'), 'the means are equal'), `${A} averages ${sig(r.means[0], 5)} and ${B} ${sig(r.means[1], 5)}: a difference of ${f3(r.est)} (${confTxt()} CI ${ciTxt(r.ci)}). Effect size d = ${f3(r.d)}: ${dBand(r.d)} by Cohen's guide.`, pMeaning(r.p)];
        o.facts = [['t', f3(r.t)], ['Degrees of freedom', sig(r.df, 5)], ['p-value', pFull(r.p)], [`Difference (${A} − ${B})`, f3(r.est)], [`${confTxt()} CI of the difference`, ciTxt(r.ci)], ["Cohen's d (pooled SD)", `${f3(r.d)} (${ciTxt(r.dCi)})`], ["Hedges' g", f3(r.g)], ['Standard error', f3(r.se)]];
        const lv = H.levene([x, y]);
