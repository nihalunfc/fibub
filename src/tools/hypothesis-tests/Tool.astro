        o.tables = [{ ...summary(names, groups), head: ['Group', 'n', 'Median', 'Mean rank', 'Mean', 'SD'], rows: groups.map((x, i) => [names[i], String(x.length), sig(r.medians[i], 5), sig(r.meanRanks[i], 4), sig(H.meanOf(x), 5), x.length > 1 ? sig(Math.sqrt(H.varOf(x)), 4) : '–']) }];
