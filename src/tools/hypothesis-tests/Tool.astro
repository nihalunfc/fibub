    }
    if (test === 'anova' || test === 'kw') {
      const g = groupsOf(box.value);
      if (g.groups.length < 2) throw new Error('Paste at least two groups: one column per group, or group names next to the values.');
      const { names, groups } = g;
      if (test === 'anova') {
        const r = H.anova(groups), tk = H.tukey(groups, conf), lv = H.levene(groups);
