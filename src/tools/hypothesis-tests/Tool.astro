      }
      if (extra) o.say.push(extra);
      o.tables = [summary([A, B], [x, y])];
      o.fig = strip([A, B], [x, y], 'Value');
      return o;
    }
    if (test === 'paired-t' || test === 'wilcoxon') {
      const p = pairsOf(box.value), [A, B] = p.names, dd = p.a.map((v, i) => v - p.b[i]);
      const extra = p.dropped ? `${p.dropped} row${p.dropped > 1 ? 's' : ''} with a missing value left out.` : '';
      if (test === 'paired-t') {
        const r = H.tPaired(p.a, p.b, alt, conf);
        o.big = `t(${r.df}) = ${f3(r.t)}, ${pBig(r.p)}`;
        o.say = [verdict(r.p, a, alt === 'greater' ? `${A} is higher than ${B}` : alt === 'less' ? `${A} is lower than ${B}` : `${A} and ${B} differ on average`, 'there is no change'), `The mean difference (${A} − ${B}) is ${f3(r.est)} (${confTxt()} CI ${ciTxt(r.ci)}), over ${dd.length} pairs. Effect size dz = ${f3(r.d)}: ${dBand(r.d)} by Cohen's guide.`, pMeaning(r.p)];
        o.facts = [['t', f3(r.t)], ['Degrees of freedom', String(r.df)], ['p-value', pFull(r.p)], ['Mean difference', f3(r.est)], [`${confTxt()} CI`, ciTxt(r.ci)], ['SD of differences', f3(r.sds[2])], ['Cohen\'s dz', `${f3(r.d)} (${ciTxt(r.dCi)})`], ["Hedges' gz", f3(r.g)]];
        o.assume = [['Pairs', 'info', 'Each row is one subject (or matched pair); different rows are independent.'], swCheck('Differences', dd)];
      } else {
        const r = H.wilcoxon(dd, alt);
        o.big = `W = ${f3(r.W)}, ${pBig(r.p)}`;
        o.say = [verdict(r.p, a, alt === 'greater' ? `${A} tends to be higher than ${B}` : alt === 'less' ? `${A} tends to be lower than ${B}` : `${A} and ${B} differ`, 'there is no change'), `The median difference (${A} − ${B}) is ${f3(r.median)}. Matched-pairs rank-biserial r = ${f3(r.rbc)}: ${rBand(r.rbc)}.`, pMeaning(r.p)];
