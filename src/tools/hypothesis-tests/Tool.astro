  }
  function wxFacts(r: ReturnType<typeof H.wilcoxon>): [string, string][] {
    const f: [string, string][] = [['W (smaller rank sum)', f3(r.W)], ['p-value', pFull(r.p)], ['Positive rank sum T+', f3(r.Tp)], ['Negative rank sum T−', f3(r.Tm)], ['Non-zero differences', String(r.n)], ['Method', r.exact ? 'Exact (no ties, 50 or fewer)' : 'Normal approximation, tie corrected'], ['Rank-biserial r', f3(r.rbc)]];
    if (!r.exact) f.push(['z', f3(r.z)]);
    return f;
  }
  function summary(names: string[], groups: number[][]) {
    return { title: 'Summary', head: ['Group', 'n', 'Mean', 'SD', 'Median', 'Min', 'Max'], rows: groups.map((x, i) => [names[i], String(x.length), sig(H.meanOf(x), 5), x.length > 1 ? sig(Math.sqrt(H.varOf(x)), 4) : '–', sig(H.medianOf(x), 5), sig(Math.min(...x), 5), sig(Math.max(...x), 5)]) };
  }

  function show(o: Out, test: string) {
    q('.ht-name').textContent = NAME[test];
    q('.ht-big').textContent = o.big;
    q('.ht-say').replaceChildren(...o.say.map((s) => { const p = document.createElement('p'); p.textContent = s; return p; }));
    q('.ht-facts').replaceChildren(...o.facts.map(([k, v]) => { const d = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd'); dt.textContent = k; dd.textContent = v; d.append(dt, dd); return d; }));
    q('.ht-tables').replaceChildren(...o.tables.map((t) => {
      const wrap = document.createElement('div'), h = document.createElement('h3'), sc = document.createElement('div'), tb = document.createElement('table');
      h.textContent = t.title; sc.className = 'ax-scroll'; tb.className = 'ht-tab';
      const hr = tb.createTHead().insertRow(); t.head.forEach((x) => { const th = document.createElement('th'); th.textContent = x; hr.append(th); });
      const b = tb.createTBody(); t.rows.forEach((r, ri) => { const tr = b.insertRow(); r.forEach((x) => { const td = tr.insertCell(); td.textContent = x; if (t.sig?.(ri)) td.className = 'ht-sig'; }); });
      sc.append(tb); wrap.append(h, sc); return wrap;
    }));
    q('.ht-assume').replaceChildren(...o.assume.map(([k, c, t]) => { const li = document.createElement('li'), s = document.createElement('span'), x = document.createElement('span'); s.className = `ax-pill ${c === 'info' ? '' : c}`; s.textContent = k; x.textContent = t; li.append(s, x); return li; }));
    fig = o.fig;
    q('.ht-fig').hidden = !fig;
    if (fig) paint(q<HTMLCanvasElement>('.ht-fig'), fig);
    report = [{ title: NAME[test], text: [o.big, ...o.say], facts: o.facts, figure: fig ?? undefined }, ...o.tables.map((t) => ({ title: t.title, table: { head: t.head, rows: t.rows } })), { title: 'Assumptions', facts: o.assume.map(([k, , t]) => [k, t] as [string, string]) }];
    csvRows = [['Test', NAME[test]], ['Result', o.big], ...o.facts, ...o.tables.flatMap((t) => [[], [t.title], t.head, ...t.rows])];
  }

  function calc() {
    const counts = sel('.ht-kind') === 'counts';
    q('.ht-dl').hidden = counts; q('.ht-cl').hidden = !counts; q('.ht-nl').hidden = counts || sel('.ht-design') === 'normal';
    const picked = sel('.ht-test');
    // Swap in the matching example while the box still holds an untouched example.
    const designKey = counts ? sel('.ht-cdesign') : sel('.ht-design');
    const wantKey = picked === 'auto' ? designKey : KEY[picked];
    if (wantKey !== shownKey && (box.value.trim() === '' || Object.values(EX).includes(box.value))) {
      box.value = EX[wantKey]; shownKey = wantKey;
      if (wantKey === 'one') q<HTMLInputElement>('.ht-mu').value = '250';
    }
    const rec = recommend(), test = picked === 'auto' ? rec.test : picked;
    q('.ht-rec').textContent = picked === 'auto' ? `Recommended: ${rec.why}` : test === rec.test ? `You picked ${NAME[test]}, which matches your answers.` : `You picked ${NAME[test]}. Your answers point to ${NAME[rec.test]}: ${rec.why}`;
    q('.ht-how').textContent = HOW[KEY[test]];
    q('.ht-mul').hidden = !['one-t', 'wilcoxon-1'].includes(test);
    q('.ht-altl').hidden = ['anova', 'kw', 'chi-gof', 'chi-indep', 'shapiro'].includes(test);
    q('.ht-confl').hidden = ['kw', 'chi-gof', 'chi-indep', 'shapiro', 'mw', 'wilcoxon', 'wilcoxon-1'].includes(test);
    q('.ht-yl').hidden = test !== 'chi-indep';
    const err = q('.ht-err');
    try {
      const o = run(test);
      err.hidden = true; q('.ht-out').hidden = false;
      show(o, test);
    } catch (e) { err.textContent = (e as Error).message; err.hidden = false; q('.ht-out').hidden = true; report = []; csvRows = []; }
  }

  let tmr = 0;
  root.addEventListener('input', () => { clearTimeout(tmr); tmr = window.setTimeout(calc, 250); });
  root.addEventListener('change', (e) => { if (!(e.target as HTMLElement).matches('.ht-data')) calc(); });
  document.addEventListener('fibub:theme', () => fig && paint(q<HTMLCanvasElement>('.ht-fig'), fig));
  q('.ht-csv').addEventListener('click', () => { if (csvRows.length) save(new TextEncoder().encode(csv(csvRows)), 'hypothesis-test.csv', 'text/csv'); });
  wireDownloads(q('.dl'), () => ({ title: q('.ht-name').textContent ?? 'Hypothesis test', subtitle: q('.ht-big').textContent ?? '', file: 'hypothesis-test', sections: report }));
  calc();
</script>
