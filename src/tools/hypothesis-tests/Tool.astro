    o.assume = [['Independent', 'info', 'Values are independent of each other.'], ['Size', 'info', 'Works for 3 to 5,000 values.']];
    const series = g.groups.map((x, i) => { const s = [...x].sort((u, v) => u - v), n = s.length; return { name: g.names[i], x: s.map((_, j) => normInv((j + 1 - 0.375) / (n + 0.25))), y: s, mode: 'points' as const }; });
    const x0 = g.groups[0], m0 = H.meanOf(x0), s0 = Math.sqrt(H.varOf(x0)), zl = series[0].x;
    series.push({ name: `Normal line (${g.names[0]})`, x: [zl[0], zl[zl.length - 1]], y: [m0 + s0 * zl[0], m0 + s0 * zl[zl.length - 1]], mode: 'line' as any } as any);
    o.fig = chartFigure({ h: 340, xLabel: 'Normal quantile', yLabel: 'Value', series }, 'Normal Q-Q plot');
