          ? ['Equal spread', 'good', `Not needed for Welch's test. (Levene, median: p = ${sig(lv.p, 3)}.)`]
          : lv.p >= 0.05 ? ['Equal spread', 'good', `Levene's test (median) p = ${sig(lv.p, 3)}: no clear difference in spread.`] : ['Equal spread', 'warn', `Levene's test (median) p = ${sig(lv.p, 3)}: the spreads differ, so Welch's t test is safer.`]];
