        const f = H.fisher2x2(T, alt, conf);
        o.big = `Odds ratio = ${f3(f.or)}, ${pBig(f.p)}`;
        o.say = [verdict(f.p, a, alt === 'two-sided' ? `${colNames[0]} is more common in one row than the other` : alt === 'greater' ? `the odds of ${colNames[0]} are higher for ${rowNames[0]}` : `the odds of ${colNames[0]} are lower for ${rowNames[0]}`, 'the rows are alike'),
          `${rowNames[0]}: ${sig(rowPct[0][0], 3)} % ${colNames[0]}; ${rowNames[1]}: ${sig(rowPct[1][0], 3)} %. The odds ratio is ${f3(f.or)} (${confTxt()} CI ${ciTxt(f.orCi)}${f.haldane ? ', with 0.5 added to every cell because one is zero' : ''}).`, pMeaning(f.p)];
        o.facts = [['p-value', pFull(f.p)], ['Odds ratio', f3(f.or)], [`${confTxt()} CI (Woolf)`, ciTxt(f.orCi)], ['Total', sig(f.N, 8)], ['Alternative', alt === 'two-sided' ? 'two-sided' : `odds ratio ${alt === 'greater' ? '> 1' : '< 1'}`]];
        o.assume = [['Independent', 'info', 'Each subject is counted once, in one cell.'], ['Small counts', 'good', 'Exact: fine for small counts. It treats the row and column totals as fixed, which makes it a little conservative.']];
        return o;
      }
      o.big = `χ²(${r.df}) = ${f3(r.chi2)}, ${pBig(r.p)}`;
      const dfm = Math.min(T.length, T[0].length) - 1;
      o.say = [verdict(r.p, a, 'the two variables are related (the row percentages differ between rows)', 'they are unrelated'), `Cramér's V = ${f3(r.V)} (${band(r.V * Math.sqrt(dfm), [0.1, 0.3, 0.5])} for a table this size). ${r.yates ? 'Yates continuity correction is on, as scipy does for a 2 × 2 table.' : ''}`.trim(), pMeaning(r.p)];
      o.facts = [['χ²', f3(r.chi2)], ['Degrees of freedom', String(r.df)], ['p-value', pFull(r.p)], ["Cramér's V", f3(r.V)], ['Total', sig(r.N, 8)], ['Smallest expected count', f3(r.minExp)]];
      if (r.yates) o.facts.push(['χ² without correction', f3(r.chi2Pearson)]);
      const lowOk = r.minExp >= 1 && r.lowExp <= 0.2;
      o.assume = [['Independent', 'info', 'Each subject is counted once, in one cell. Use counts, not percentages.'], lowOk ? ['Expected counts', 'good', `At most 20 % of expected counts are below 5 and none below 1 (smallest ${f3(r.minExp)}).`] : ['Expected counts', 'warn', `Some expected counts are small (smallest ${f3(r.minExp)}): ${T.length === 2 && T[0].length === 2 ? "use Fisher's exact test" : 'merge categories'}.`]];
      return o;
    }
    // Shapiro-Wilk on each column.
    const g = groupsOf(box.value), rows: string[][] = [], res = g.groups.map((x) => H.shapiroWilk(x));
    res.forEach((r, i) => rows.push([g.names[i], String(r.n), sig(r.W, 4), pFull(r.p), r.p < a ? 'not normal' : 'no clear departure']));
    const r0 = res[0];
    o.big = g.groups.length === 1 ? `W = ${f3(r0.W)}, ${pBig(r0.p)}` : `${res.filter((r) => r.p < a).length} of ${res.length} columns not normal`;
    o.say = [g.groups.length === 1 ? verdict(r0.p, a, 'the data do not come from a normal distribution', 'they are normal') : `Each column is tested on its own. ${rows.filter((r) => r[4] === 'not normal').map((r) => r[0]).join(', ') || 'None'} ${res.filter((r) => r.p < a).length === 1 ? 'looks' : 'look'} not normal at α = ${a}.`,
      'Read this with the Q-Q plot: points near the straight line mean normal. With small samples the test misses real departures; with thousands of values it flags tiny ones that do not matter for a t test.'];
    o.facts = [['W', f3(r0.W)], ['p-value', pFull(r0.p)], ['n', String(r0.n)], ['Method', 'Royston (1995), as scipy and R']];
