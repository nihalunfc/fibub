          { title: 'ANOVA table', head: ['Source', 'Sum of squares', 'df', 'Mean square', 'F', 'p'], rows: [['Between groups', f3(r.ssb), String(r.df1), f3(r.ssb / r.df1), f3(r.F), pFull(r.p)], ['Within groups', f3(r.ssw), String(r.df2), f3(r.msw), '', ''], ['Total', f3(r.ssb + r.ssw), String(r.df1 + r.df2), '', '', '']] }];
        o.assume = [indep, ...groups.map((x, i) => swCheck(names[i], x)), lv.p >= 0.05 || !Number.isFinite(lv.p) ? ['Equal spread', 'good', `Levene's test (median) p = ${sig(lv.p, 3)}: no clear difference in spread.`] : ['Equal spread', 'warn', `Levene's test (median) p = ${sig(lv.p, 3)}: the spreads differ; treat the result with care or use Kruskal-Wallis.`]];
      } else {
