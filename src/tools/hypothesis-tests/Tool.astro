      o.tables = [summary([A, B, `${A} − ${B}`], [p.a, p.b, dd])];
      o.fig = strip([`${A} − ${B}`], [dd], `Difference (${A} − ${B})`, [{ kind: 'hline', at: 0, label: 'no change' }]);
