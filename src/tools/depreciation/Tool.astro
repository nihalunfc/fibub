---
// #1759 Depreciation: schedules for four standard methods.
---
<div class="tool-ui dp">
  <section class="panel">
    <h2>The asset</h2>
    <div class="dp-grid">
      <label>Currency <select class="dp-cur" data-k="cur"></select></label>
      <label>Cost <input data-k="cost" inputmode="decimal" /></label>
      <label>Salvage value at the end <input data-k="salv" inputmode="decimal" /></label>
      <label>Method <select data-k="method"><option value="sl">Straight line</option><option value="db">Declining balance</option><option value="syd">Sum of the years' digits</option><option value="units">Units of production</option></select></label>
      <label class="dp-life">Life in years <input data-k="life" inputmode="numeric" /></label>
      <label class="dp-db">Rate a year (blank = double declining) <span class="dp-suf"><input data-k="rate" inputmode="decimal" placeholder="double" /><i>%</i></span></label>
      <label class="dp-db dp-check"><span><input type="checkbox" data-k="fin" checked /> Depreciate down to salvage in the last year</span></label>
      <label class="dp-un">Total units in its life <input data-k="tot" inputmode="decimal" /></label>
      <label class="dp-un">Units used each year (separate with commas) <input data-k="uy" /></label>
    </div>
    <p class="note bad dp-err" role="alert" hidden></p>
  </section>
  <section class="dp-res" aria-live="polite">
    <div class="dp-stats">
      <div class="good"><span>Year 1 depreciation</span><b class="dp-s-first"></b></div>
      <div><span>Total depreciation</span><b class="dp-s-total"></b></div>
      <div><span>Book value at the end</span><b class="dp-s-end"></b></div>
    </div>
    <p class="dp-line dp-words"></p>
    <figure class="dp-chart panel">
      <figcaption>Book value by year</figcaption>
      <svg class="dp-svg" viewBox="0 0 640 220" role="img" aria-label="Book value falling year by year"></svg>
    </figure>
    <div class="panel"><h2>Schedule</h2>
      <div class="dp-wrap"><table><thead><tr><th>Year</th><th>Depreciation</th><th>Accumulated</th><th>Book value</th></tr></thead><tbody class="dp-rows"></tbody></table></div>
      <button type="button" class="btn dp-csv">Download CSV</button>
    </div>
  </section>
  <p class="dp-fine">Whole years only; no part-year first year. Book value never goes below salvage. This is an accounting schedule, not tax depreciation: tax rules have their own classes, rates and limits, so check the official source for your country. Not financial or tax advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .dp { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .dp > *, .dp-res > * { min-width: 0; }
  .dp h2 { margin: 0 0 12px; font-size: 18px; }
  .dp .panel { padding: 16px; }
  .dp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .dp label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .dp input, .dp select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .dp input:focus, .dp select:focus { border-color: var(--accent); outline: none; }
  .dp-suf { position: relative; display: block; }
  .dp-suf input { padding-right: 88px; }
  .dp-suf i { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-style: normal; font-size: 13px; color: var(--muted); pointer-events: none; }
  .dp-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .dp-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .dp-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .dp-stats span { font-size: 13px; color: var(--muted); }
  .dp-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .dp-stats .good b { color: var(--good); }
  .dp-line { margin: 0; font-size: 15px; }
  .dp-wrap { overflow-x: auto; }
  .dp table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .dp th, .dp td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .dp th:first-child, .dp td:first-child { text-align: left; }
  .dp th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .dp-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .dp-err { margin: 10px 0 0; }
  @media (max-width: 720px) { .dp-stats { grid-template-columns: 1fr 1fr; } }
  .dp details summary { cursor: pointer; font-weight: 700; margin-bottom: 8px; }
  .dp details .btn { margin-top: 12px; }
  .dp-chart { margin: 0; }
  .dp-chart figcaption { font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .dp-svg { width: 100%; height: auto; display: block; }
  .dp-svg text { font: 11px system-ui, sans-serif; fill: var(--muted); }
  .dp [hidden] { display: none !important; }
  .dp input[type=checkbox] { width: auto; }
</style>
<script>
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  import { depreciation, type DepIn, type DepRow } from '../../lib/money/business';
  import { csv } from '../../lib/money/growth';
  const root = document.querySelector<HTMLElement>('.dp')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  q('.dp-cur').innerHTML = currencyOptions(defaultCurrency());
  f('cost').value = '10,000'; f('salv').value = '1,000'; f('life').value = '5'; f('tot').value = '100,000'; f('uy').value = '20000, 30000, 25000, 15000, 10000';
  const $ = (n: number, d = 2) => money(n, f('cur').value, d);
  let last: DepRow[] = [];
  function run() {
    const method = f('method').value as DepIn['method'];
    q('.dp-life').hidden = method === 'units';
    root.querySelectorAll<HTMLElement>('.dp-db').forEach((e) => (e.hidden = method !== 'db'));
    root.querySelectorAll<HTMLElement>('.dp-un').forEach((e) => (e.hidden = method !== 'units'));
    const cost = num(f('cost').value), salvage = num(f('salv').value), life = Math.round(num(f('life').value));
    const units = f('uy').value.split(/[,\s]+/).filter(Boolean).map((v) => num(v)), totalUnits = num(f('tot').value);
    const rateText = f('rate').value.trim();
    const rate = rateText ? num(rateText) : undefined;
    const bad = !(cost > 0) ? 'Enter the cost of the asset.' : salvage < 0 || salvage > cost ? 'Salvage value must be between 0 and the cost.'
      : method !== 'units' && !(life >= 1 && life <= 100) ? 'Life must be 1 to 100 years.'
      : method === 'db' && rate !== undefined && !(rate > 0 && rate <= 100) ? 'The rate must be above 0 and at most 100%.'
      : method === 'units' && (!(totalUnits > 0) || !units.length || units.some((u) => u < 0) || units.reduce((s, u) => s + u, 0) > totalUnits + 1e-9) ? 'Enter total units, and yearly units that are not negative and add up to no more than the total.' : '';
    q('.dp-err').hidden = !bad; q('.dp-err').textContent = bad; q('.dp-res').hidden = !!bad;
    if (bad) return;
    const rows = depreciation({ cost, salvage, life, method, rate, units, totalUnits, finish: f('fin').checked });
    last = rows;
    const tot = rows[rows.length - 1].accumulated;
    q('.dp-s-first').textContent = $(rows[0].dep); q('.dp-s-total').textContent = $(tot); q('.dp-s-end').textContent = $(rows[rows.length - 1].book);
    const names = { sl: 'Straight line', db: 'Declining balance', syd: "Sum of the years' digits", units: 'Units of production' };
    q('.dp-words').innerHTML = `${names[method]} over <b>${rows.length}</b> years takes <b>${$(tot)}</b> off the cost of ${$(cost, 0)}, leaving a book value of <b>${$(rows[rows.length - 1].book)}</b>.`;
    q('.dp-rows').innerHTML = rows.map((r) => `<tr><td>${r.year}</td><td>${$(r.dep)}</td><td>${$(r.accumulated)}</td><td>${$(r.book)}</td></tr>`).join('');
    const W = 640, H = 220, L = 56, R = 10, T = 10, B = 26, n = rows.length;
    const x = (i: number) => L + (i / n) * (W - L - R), y = (v: number) => T + (1 - v / cost) * (H - T - B);
    const short = (v: number) => new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(v);
    let t = '';
    for (const k of [0, 0.5, 1]) t += `<line x1="${L}" x2="${W - R}" y1="${y(cost * k)}" y2="${y(cost * k)}" stroke="var(--line)"/><text x="${L - 6}" y="${y(cost * k) + 4}" text-anchor="end">${short(cost * k)}</text><text x="${x(n * k)}" y="${H - 8}" text-anchor="middle">Year ${Math.round(n * k)}</text>`;
    t += `<path d="${[cost, ...rows.map((r) => r.book)].map((v, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1)).join('')}" fill="none" stroke="var(--accent)" stroke-width="2.5"/>`;
    q('.dp-svg').innerHTML = t;
  }
  q('.dp-csv').addEventListener('click', () => csv('depreciation.csv', ['Year', 'Depreciation', 'Accumulated', 'Book value'], last.map((r) => [r.year, r.dep, r.accumulated, r.book])));
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
