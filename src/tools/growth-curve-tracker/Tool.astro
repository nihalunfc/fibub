---
// Body condition and growth curve tracker: average daily gain between weighings, Gompertz, logistic and von
// Bertalanffy curves by nonlinear least squares, and a body condition score trend. Nothing is uploaded.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax grc">
  <div class="ax-card">
    <h2>Weigh records</h2>
    <div class="ax-row"><button type="button" class="btn secondary small gc-ex">Use the example</button></div>
    <label style="margin-top:10px">One weighing per line: animal, date (2026-03-14) or age in days, weight, and optionally a body condition score (BCS)
      <textarea class="gc-in" rows="7" spellcheck="false"></textarea></label>
    <DataFile target=".gc-in" maxMB={5} maxCols={4} maxRows={20000} />
    <div class="ax-grid" style="margin-top:10px">
      <label>Animal <select class="gc-an"></select></label>
      <label>Curve for the figure <select class="gc-m"><option value="gompertz">Gompertz</option><option value="logistic">Logistic</option><option value="vonb">von Bertalanffy</option></select></label>
      <label>Weight unit <input class="gc-u" type="text" value="kg" maxlength="10" /></label>
    </div>
    <p class="ax-err gc-err" hidden></p>
  </div>

  <div class="ax-card gc-out" hidden>
    <h2>Growth</h2>
    <p class="ax-big gc-big" aria-live="polite"></p>
    <canvas class="ax-fig gc-fig"></canvas>
    <h3>Growth curves</h3>
    <div class="ax-scroll"><table class="gc-fits"></table></div>
    <p class="ax-help gc-fnote"></p>
    <h3>Average daily gain between weighings</h3>
    <div class="ax-scroll gc-gw"><table class="gc-gain"></table></div>
    <div class="gc-bcsw">
      <h3>Body condition score</h3>
      <p class="gc-bcs"></p>
      <canvas class="ax-fig gc-bfig"></canvas>
    </div>
    <div class="ax-row" style="margin-top:10px">
      <button type="button" class="btn secondary small gc-csv">Download gains (CSV)</button>
      <button type="button" class="btn secondary small gc-fcsv">Download fitted curves (CSV)</button>
    </div>
    <Downloads />
  </div>
</div>

<style is:global>
  .grc h3 { margin: 18px 0 8px; font-size: 15px; }
  .grc .gc-gw { max-height: 380px; overflow-y: auto; }
  .grc tr.best td { font-weight: 700; }
  .grc .gc-gain td { white-space: nowrap; }
</style>

<script>
  import { readRecords, fitGrowth, gains, animals, bcsTrend, MODELS, EXAMPLE, type Rec, type Fit, type ModelId, type Gain } from '../../lib/sci/growth';
  import { parseTable, num, sig, csv } from '../../lib/sci/num';
  import { chartFigure, type Series } from '../../lib/sci/plot';
  import { wireDownloads, save, paint, type Figure, type Section } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.grc')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const an = q<HTMLSelectElement>('.gc-an');
  const IDS: ModelId[] = ['gompertz', 'logistic', 'vonb'];
  let recs: Rec[] = [], sel: Rec[] = [], fits: (Fit | string)[] = [], gl: Gain[] = [], fig: Figure | null = null, bfig: Figure | null = null, byDate = true, unit = 'kg';
  const table = (t: HTMLElement, head: string[], rows: (string | number)[][], cls: string[] = []) => {
    t.replaceChildren();
    const h = t.insertRow(); head.forEach((x, k) => { const th = document.createElement('th'); th.textContent = x; if (cls[k]) th.className = cls[k]; h.append(th); });
    for (const r of rows) { const tr = t.insertRow(); r.forEach((x, k) => { const td = tr.insertCell(); td.textContent = String(x); if (cls[k]) td.className = cls[k]; }); }
    return t;
  };

  function run() {
    const err = q('.gc-err'); err.hidden = true;
    const r = readRecords(parseTable(q<HTMLTextAreaElement>('.gc-in').value), num);
    recs = r.recs; byDate = r.byDate; unit = q<HTMLInputElement>('.gc-u').value.trim() || 'kg';
    if (r.errors.length) { err.textContent = r.errors.slice(0, 4).join(' ') + (r.errors.length > 4 ? ` (${r.errors.length - 4} more)` : ''); err.hidden = false; }
    const names = animals(recs), keep = an.value;
    an.replaceChildren(...(names.length > 1 ? [new Option('All animals together', '*')] : []), ...names.map((n) => new Option(n, n)));
    an.value = names.includes(keep) || (keep === '*' && names.length > 1) ? keep : an.options[0]?.value ?? '';
    q('.gc-out').hidden = !recs.length;
    if (!recs.length) return;
    sel = an.value === '*' ? recs : recs.filter((x) => x.animal === an.value);
    gl = gains(sel);
    const xs = sel.map((x) => x.t), tSpan = Math.max(...xs) - Math.min(...xs);
    const first = sel.reduce((a, b) => (b.t < a.t ? b : a)), last = sel.reduce((a, b) => (b.t > a.t ? b : a));
    const who = an.value === '*' ? `${animals(sel).length} animals` : an.value;
    const adgAll = an.value === '*' ? gl.reduce((s, g) => s + g.gain, 0) / Math.max(1, gl.reduce((s, g) => s + g.days, 0)) : (last.w - first.w) / Math.max(1, tSpan);
    q('.gc-big').textContent = `${who}: average daily gain ${sig(adgAll, 3)} ${unit}/day over ${tSpan} days`;
    const xLab = byDate ? 'Days since first weighing' : 'Age (days)';
    table(q('.gc-gain'), ['Animal', byDate ? 'From' : 'From day', byDate ? 'To' : 'To day', 'Days', `Gain (${unit})`, `ADG (${unit}/day)`], gl.map((g) => [g.animal, g.fromDate ?? g.from, g.toDate ?? g.to, g.days, sig(g.gain, 4), g.adg.toFixed(3)]), ['', '', '', 'r', 'r', 'r']);
    // Fits.
    const t = sel.map((x) => x.t), w = sel.map((x) => x.w);
    fits = IDS.map((m) => { try { return fitGrowth(t, w, m); } catch (e) { return (e as Error).message; } });
    const ok = fits.filter((f): f is Fit => typeof f !== 'string');
    const bestAic = Math.min(...ok.map((f) => f.aic)), wMax = Math.max(...w);
    const ft = table(q('.gc-fits'), ['Curve', `Mature weight A (${unit})`, 'Rate k (per day)', 'b', 'Inflection day', `Inflection weight`, 'RSE', 'R²', 'AIC'], fits.map((f, i) => typeof f === 'string' ? [MODELS[IDS[i]].name, f, '', '', '', '', '', '', ''] : [MODELS[f.model].name, `${sig(f.A, 4)} ± ${sig(f.se[0], 2)}`, sig(f.k, 3), sig(f.b, 4), f.inflT.toFixed(0), sig(f.inflW, 4), sig(f.rse, 3), f.r2.toFixed(4), f.aic.toFixed(1)]), ['', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r']);
    fits.forEach((f, i) => { if (typeof f !== 'string' && f.aic === bestAic) ft.rows[i + 1].classList.add('best'); });
    const far = ok.filter((f) => f.A > 1.5 * wMax).map((f) => MODELS[f.model].name);
    q('.gc-fnote').textContent = `${ok.length ? `Lowest AIC (best balance of fit and simplicity, in bold): ${ok.filter((f) => f.aic === bestAic).map((f) => MODELS[f.model].name).join(', ')}. ` : ''}A ± one standard error. t is ${byDate ? 'days since each animal’s first weighing' : 'age in days'}.${far.length ? ` Careful: the ${far.join(' and ')} mature weight is far above the heaviest weighing, so the data do not show the curve levelling off yet and A is a guess.` : ''}`;
    // Figure.
    const m = q<HTMLSelectElement>('.gc-m').value as ModelId, fm = fits[IDS.indexOf(m)];
    const series: Series[] = animals(sel).map((a) => ({ name: a, x: sel.filter((x) => x.animal === a).map((x) => x.t), y: sel.filter((x) => x.animal === a).map((x) => x.w), mode: 'points' }));
    if (typeof fm !== 'string') { const tm = Math.max(...t), lo = Math.min(...t); const xx = Array.from({ length: 121 }, (_, k) => lo + ((tm - lo) * k) / 120); series.push({ name: `${MODELS[m].name} curve`, x: xx, y: xx.map((v) => MODELS[m].f(v, [fm.A, fm.b, fm.k])), mode: 'line', marker: 'none', width: 2, color: undefined }); }
    fig = chartFigure({ w: 640, h: 380, xLabel: xLab, yLabel: `Weight (${unit})`, series, legend: 'below', yMin: 0 }, `Weights of ${who} with the ${MODELS[m].name} curve`);
    paint(q<HTMLCanvasElement>('.gc-fig'), fig);
    // BCS.
    const bt = bcsTrend(sel), withBcs = sel.filter((x) => x.bcs !== undefined);
    q('.gc-bcsw').hidden = !withBcs.length;
    bfig = null;
    if (withBcs.length) {
      q('.gc-bcs').textContent = bt ? `Body condition score trend: ${bt.per30 >= 0 ? '+' : '−'}${Math.abs(bt.per30).toFixed(3)} points per 30 days (straight line through ${bt.n} scores, now about ${(bt.intercept + bt.slope * bt.last).toFixed(2)}).` : 'Give at least 3 scores on different days to see a trend.';
      const bs: Series[] = animals(withBcs).map((a) => ({ name: a, x: withBcs.filter((x) => x.animal === a).map((x) => x.t), y: withBcs.filter((x) => x.animal === a).map((x) => x.bcs!), mode: 'both' }));
      if (bt) bs.push({ name: 'Trend', x: [bt.first, bt.last], y: [bt.intercept + bt.slope * bt.first, bt.intercept + bt.slope * bt.last], mode: 'line', marker: 'none', dash: [6, 4] });
      bfig = chartFigure({ w: 640, h: 260, xLabel: xLab, yLabel: 'BCS', series: bs, legend: 'below' }, `Body condition score of ${who}`);
      paint(q<HTMLCanvasElement>('.gc-bfig'), bfig);
    }
  }

  const sections = (): Section[] => recs.length ? [
    { title: 'Growth', text: [q('.gc-big').textContent ?? ''], figure: fig ?? undefined },
    { title: 'Growth curves', table: { head: ['Curve', 'A', 'k', 'b', 'Inflection day', 'RSE', 'R²', 'AIC'], rows: fits.map((f, i) => typeof f === 'string' ? [MODELS[IDS[i]].name, f, '', '', '', '', '', ''] : [MODELS[f.model].name, `${sig(f.A, 4)} ± ${sig(f.se[0], 2)}`, sig(f.k, 3), sig(f.b, 4), f.inflT.toFixed(0), sig(f.rse, 3), f.r2.toFixed(4), f.aic.toFixed(1)]), align: ['l', 'r', 'r', 'r', 'r', 'r', 'r', 'r'] }, note: q('.gc-fnote').textContent ?? '' },
    { title: 'Average daily gain', table: { head: ['Animal', 'From', 'To', 'Days', 'Gain', 'ADG'], rows: gl.map((g) => [g.animal, String(g.fromDate ?? g.from), String(g.toDate ?? g.to), String(g.days), sig(g.gain, 4), g.adg.toFixed(3)]), align: ['l', 'l', 'l', 'r', 'r', 'r'] } },
    ...(bfig ? [{ title: 'Body condition score', text: [q('.gc-bcs').textContent ?? ''], figure: bfig }] : []),
  ] : [];

  let tm = 0;
  const later = () => { clearTimeout(tm); tm = window.setTimeout(run, 300); };
  q('.gc-in').addEventListener('input', later);
  q('.gc-u').addEventListener('input', later);
  an.addEventListener('change', run);
  q('.gc-m').addEventListener('change', run);
  q('.gc-ex').addEventListener('click', () => { q<HTMLTextAreaElement>('.gc-in').value = EXAMPLE; an.value = ''; q<HTMLInputElement>('.gc-u').value = 'kg'; run(); });
  q('.gc-csv').addEventListener('click', () => save(new Blob([csv([['animal', 'from', 'to', 'days', `gain_${unit}`, `adg_${unit}_per_day`], ...gl.map((g) => [g.animal, g.fromDate ?? g.from, g.toDate ?? g.to, g.days, g.gain, g.adg.toFixed(5)])])], { type: 'text/csv' }), 'daily-gains.csv', 'text/csv'));
  q('.gc-fcsv').addEventListener('click', () => {
    const rows: (string | number)[][] = [['animal', 'date', 't_days', `weight_${unit}`, ...IDS.map((m) => `${m}_fitted`)], ...sel.map((x) => [x.animal, x.date ?? '', x.t, x.w, ...fits.map((f) => (typeof f === 'string' ? '' : MODELS[f.model].f(x.t, [f.A, f.b, f.k]).toFixed(3)))])];
    rows.push([], ['curve', 'A', 'se_A', 'b', 'se_b', 'k', 'se_k', 'rse', 'r2', 'aic'], ...fits.filter((f): f is Fit => typeof f !== 'string').map((f) => [f.model, f.A.toFixed(4), f.se[0].toFixed(4), f.b.toFixed(6), f.se[1].toFixed(6), f.k.toExponential(6), f.se[2].toExponential(4), f.rse.toFixed(4), f.r2.toFixed(6), f.aic.toFixed(3)]));
    save(new Blob([csv(rows)], { type: 'text/csv' }), 'growth-curves.csv', 'text/csv');
  });
  wireDownloads(q('.dl'), () => ({ title: 'Growth curve', subtitle: q('.gc-big').textContent ?? '', file: 'growth-curve', sections: sections() }));
  document.addEventListener('fibub:theme', () => { if (fig && recs.length) { paint(q<HTMLCanvasElement>('.gc-fig'), fig); if (bfig) paint(q<HTMLCanvasElement>('.gc-bfig'), bfig); } });
</script>
