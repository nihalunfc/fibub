---
// Quadrilateral explorer: drag four corners on a grid (or type them) and see the sides, angles (adding to 360°),
// diagonals, area and the family name, with every family the shape belongs to. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm qx">
  <div class="ax-card">
    <h2>Drag the corners</h2>
    <div class="ax-seg qx-pre" role="group" aria-label="Start from">
      <button type="button" data-p="square">Square</button>
      <button type="button" data-p="rectangle">Rectangle</button>
      <button type="button" data-p="rhombus">Rhombus</button>
      <button type="button" data-p="parallelogram" aria-pressed="true">Parallelogram</button>
      <button type="button" data-p="kite">Kite</button>
      <button type="button" data-p="trapezium">Trapezium</button>
      <button type="button" data-p="dart">Dart</button>
    </div>
    <svg class="sm-fig qx-fig" viewBox="0 0 340 280" role="img" aria-label="Quadrilateral ABCD on a square grid"></svg>
    <p class="ax-help">Corners snap to the grid. Drag A, B, C or D, or type the coordinates.</p>
    <div class="qx-xy"></div>
    <div class="ax-row" style="margin-top:8px">
      <label class="ax-check"><input type="checkbox" class="qx-diag" checked /> Diagonals</label>
      <label class="ax-check"><input type="checkbox" class="qx-mid" /> Join the midpoints</label>
    </div>
  </div>

  <div class="ax-card">
    <h2>What it is</h2>
    <p class="ax-big qx-name" aria-live="polite"></p>
    <div class="qx-fam" aria-label="Families this shape belongs to"></div>
    <ul class="sm-steps qx-facts"></ul>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Start from the parallelogram and drag C until every angle is 90°. What is it now? Is it still a parallelogram?</li>
      <li>Make a rhombus. Check that its diagonals cross at 90° and cut each other in half.</li>
      <li>Drag D inside the triangle ABC to make a dart. The angles still add to 360°, but one is more than 180°.</li>
      <li>Turn on "Join the midpoints". Whatever you do, the inner shape stays a parallelogram with half the area.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <div class="qx-quiz"></div>
  </div>
</div>

<style is:inline>
  .qx .qx-xy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 12px; margin-top: 8px; }
  .qx .qx-xy label { display: flex; align-items: center; gap: 6px; font-weight: 700; }
  .qx .qx-xy input { width: 0; flex: 1; min-height: 40px; font: inherit; padding: 4px 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--ink); }
  .qx .qx-fam { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 10px; }
  .qx .qx-fam span { padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 14px; color: var(--muted); text-decoration: line-through; }
  .qx .qx-fam span.on { color: var(--ink); border-color: var(--accent); background: var(--accent-soft); font-weight: 700; text-decoration: none; }
  .qx svg .qx-shape { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2.5; stroke-linejoin: round; }
  .qx svg .qx-shape.bad { fill: none; stroke: var(--bad); }
  .qx svg .qx-diagl { stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .qx svg .qx-midl { fill: none; stroke: var(--good); stroke-width: 2; }
  .qx svg .qx-ang { font-size: 11px; fill: var(--muted); }
</style>

<script>
  import { sides, area, angles, shapeType, convex, diagonals, classify, midpoints, PRESETS, type Pt } from '../../lib/sci/quadri-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.qx')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.qx-fig');
  const NAMES = ['A', 'B', 'C', 'D'], X0 = 20, Y0 = 260, K = 30, GX = 10, GY = 8;
  const px = (x: number) => X0 + x * K, py = (y: number) => Y0 - y * K;
  let P: Pt[] = PRESETS.parallelogram.map((p) => [...p] as Pt);

  // Coordinate boxes.
  const boxes: HTMLInputElement[][] = NAMES.map((n, i) => {
    const l = document.createElement('label'); l.append(n);
    const xy = [0, 1].map((j) => { const b = document.createElement('input'); b.type = 'number'; b.step = '1'; b.min = '0'; b.max = String(j ? GY : GX); b.inputMode = 'numeric'; b.className = `qx-${n.toLowerCase()}${j ? 'y' : 'x'}`; b.setAttribute('aria-label', `${n} ${j ? 'y' : 'x'}`); b.addEventListener('input', () => { const v = Math.round(Number(b.value)); if (b.value.trim() !== '' && Number.isFinite(v)) { P[i][j] = Math.max(0, Math.min(j ? GY : GX, v)); draw(false); } }); l.append(b); return b; });
    q('.qx-xy').append(l); return xy;
  });

  const FAMILY = ['quadrilateral', 'trapezium', 'parallelogram', 'rectangle', 'rhombus', 'square', 'kite'];
  const cap = (s: string) => s[0].toUpperCase() + s.slice(1);

  function draw(syncBoxes = true) {
    if (syncBoxes) P.forEach((p, i) => { boxes[i][0].value = String(p[0]); boxes[i][1].value = String(p[1]); });
    fig.replaceChildren();
    for (let x = 0; x <= GX; x++) S('line', { x1: px(x), x2: px(x), y1: py(0), y2: py(GY), class: 'sm-grid' }, fig);
    for (let y = 0; y <= GY; y++) S('line', { x1: px(0), x2: px(GX), y1: py(y), y2: py(y), class: 'sm-grid' }, fig);
    const t = shapeType(P), C = classify(P), pts = P.map((p) => `${px(p[0])},${py(p[1])}`).join(' ');
    S('polygon', { points: pts, class: 'qx-shape' + (t === 'simple' ? '' : ' bad') }, fig);
    if (q<HTMLInputElement>('.qx-diag').checked) for (const [i, j] of [[0, 2], [1, 3]]) S('line', { x1: px(P[i][0]), y1: py(P[i][1]), x2: px(P[j][0]), y2: py(P[j][1]), class: 'qx-diagl' }, fig);
    if (q<HTMLInputElement>('.qx-mid').checked) S('polygon', { points: midpoints(P).map((p) => `${px(p[0])},${py(p[1])}`).join(' '), class: 'qx-midl qx-mids' }, fig);
    const cx = P.reduce((s, p) => s + p[0], 0) / 4, cy = P.reduce((s, p) => s + p[1], 0) / 4, A = t === 'simple' ? angles(P) : null;
    P.forEach((p, i) => {
      const dx = p[0] - cx, dy = p[1] - cy, d = Math.hypot(dx, dy) || 1;
      S('text', { x: px(p[0]) + (dx / d) * 16, y: py(p[1]) - (dy / d) * 16 + 5, 'text-anchor': 'middle', style: 'font-weight:700' }, fig, NAMES[i]);
      if (A) S('text', { x: px(p[0]) - (dx / d) * 24, y: py(p[1]) + (dy / d) * 24 + 4, 'text-anchor': 'middle', class: 'qx-ang' }, fig, `${fmt(A[i], 1)}°`);
    });
    P.forEach((p, i) => { S('circle', { cx: px(p[0]), cy: py(p[1]), r: 20, class: 'sm-hit' }, fig); S('circle', { cx: px(p[0]), cy: py(p[1]), r: 8, class: `sm-handle qx-h${NAMES[i]}` }, fig); });

    q('.qx-name').textContent = t === 'crossed' ? 'Not a quadrilateral: two sides cross' : t === 'degenerate' ? 'Not a quadrilateral: three corners in a line or two on top of each other' : `${cap(C.name)}${convex(P) ? '' : ' (concave)'}`;
    q('.qx-fam').replaceChildren(...FAMILY.map((f) => Object.assign(document.createElement('span'), { textContent: cap(f), className: t === 'simple' && (f === 'quadrilateral' || C.also.includes(f)) ? 'on' : '' })));
    const facts: string[] = [];
    if (t === 'simple') {
      const s = sides(P), D = diagonals(P), sq = (v: number) => { const r = Math.round(v * v); return Math.abs(Math.sqrt(r) - Math.round(Math.sqrt(r))) < 1e-9 ? String(Math.round(Math.sqrt(r))) : `√${r} ≈ ${fmt(v, 2)}`; };
      facts.push(`Sides: AB = ${sq(s[0])}, BC = ${sq(s[1])}, CD = ${sq(s[2])}, DA = ${sq(s[3])}.`);
      facts.push(`Angles: ${A!.map((a, i) => `∠${NAMES[i]} = ${fmt(a, 1)}°`).join(', ')}. Sum = ${fmt(A!.reduce((x, y) => x + y, 0), 1)}°.`);
      facts.push(C.parallelPairs === 2 ? 'Both pairs of opposite sides are parallel.' : C.parallelPairs === 1 ? 'One pair of opposite sides is parallel.' : 'No sides are parallel.');
      facts.push(`Diagonals: AC = ${sq(D.AC)}, BD = ${sq(D.BD)}${D.equal ? ' (equal)' : ''}. ${D.bisect ? 'They cut each other in half' : 'They do not cut each other in half'}${D.perpendicular ? ' and cross at 90°.' : '.'}`);
      facts.push(`Area = ${fmt(area(P), 2)} square units (count the grid squares, or use ½ × d₁ × d₂ when the diagonals are perpendicular).`);
      if (q<HTMLInputElement>('.qx-mid').checked) facts.push(`The midpoints make a parallelogram of area ${fmt(area(midpoints(P)), 2)}, half of ${fmt(area(P), 2)}.`);
    } else facts.push(t === 'crossed' ? 'Drag a corner so the sides no longer cross. A quadrilateral needs four sides that meet only at their ends.' : 'Move a corner so no three corners lie on one line.');
    q('.qx-facts').replaceChildren(...facts.map((f) => Object.assign(document.createElement('li'), { textContent: f })));
  }

  dragOn(fig, (x, y) => { let best: string | null = null, bd = 26; P.forEach((p, i) => { const d = Math.hypot(x - px(p[0]), y - py(p[1])); if (d < bd) { bd = d; best = String(i); } }); return best; },
    (id, x, y) => { const i = Number(id), nx = Math.max(0, Math.min(GX, Math.round((x - X0) / K))), ny = Math.max(0, Math.min(GY, Math.round((Y0 - y) / K))); if (nx !== P[i][0] || ny !== P[i][1]) { P[i] = [nx, ny]; draw(); } });
  root.querySelectorAll<HTMLButtonElement>('.qx-pre button').forEach((b) => b.addEventListener('click', () => { P = PRESETS[b.dataset.p!].map((p) => [...p] as Pt); root.querySelectorAll('.qx-pre button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
  for (const c of ['.qx-diag', '.qx-mid']) q(c).addEventListener('change', () => draw());
  draw();

  quiz(q('.qx-quiz'), () => {
    const out: Question[] = [];
    let a = randInt(60, 120), b = randInt(60, 120), c = randInt(60, 120); while (360 - a - b - c < 40 || 360 - a - b - c > 170) { a = randInt(60, 120); b = randInt(60, 120); c = randInt(60, 120); }
    out.push({ q: `Three angles of a quadrilateral are ${a}°, ${b}° and ${c}°. What is the fourth angle (in degrees)?`, want: [360 - a - b - c], tol: 0.01, work: `The four angles add to 360°, so the fourth is 360 − ${a} − ${b} − ${c} = ${360 - a - b - c}°.` });
    const x = randInt(40, 140); out.push({ q: `One angle of a parallelogram is ${x}°. What is the angle next to it (in degrees)?`, want: [180 - x], tol: 0.01, work: `Next to each other, the angles of a parallelogram add to 180°, so it is 180 − ${x} = ${180 - x}°.` });
    const [d1, d2, s] = [[6, 8, 5], [10, 24, 13], [16, 12, 10], [18, 24, 15], [14, 48, 25]][randInt(0, 4)];
    out.push({ q: `The diagonals of a rhombus are ${d1} cm and ${d2} cm. How long is each side (in cm)?`, want: [s], tol: 0.01, work: `The diagonals cut each other in half at 90°, so a side is the hypotenuse of a right triangle with legs ${d1 / 2} and ${d2 / 2}: √(${d1 / 2}² + ${d2 / 2}²) = ${s} cm.` });
    const [r1, r2, r3, r4] = [[1, 2, 3, 4], [2, 3, 3, 4], [3, 4, 5, 6], [1, 1, 2, 2], [4, 5, 4, 5]][randInt(0, 4)], u = 360 / (r1 + r2 + r3 + r4);
    out.push({ q: `The angles of a quadrilateral are in the ratio ${r1} : ${r2} : ${r3} : ${r4}. What is the largest angle (in degrees)?`, want: [Math.max(r1, r2, r3, r4) * u], tol: 0.01, work: `${r1} + ${r2} + ${r3} + ${r4} = ${r1 + r2 + r3 + r4} parts make 360°, so one part is ${fmt(u, 2)}° and the largest is ${Math.max(r1, r2, r3, r4)} × ${fmt(u, 2)} = ${fmt(Math.max(r1, r2, r3, r4) * u, 2)}°.` });
    return out;
  });
</script>
