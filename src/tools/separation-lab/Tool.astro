---
// Separation lab: pick a mixture, pick a container and a method, and see it separate (or not), step by step.
// The rules live in src/lib/sci/separation-lab.ts.
import '../../styles/astro.css';
---
<div class="ax sl">
  <div class="ax-card">
    <div class="ax-row sl-top">
      <span class="sl-lab">Level</span>
      <div class="ax-seg sl-level" role="group" aria-label="Level">
        <button type="button" data-l="9" aria-pressed="true">Class 9</button>
        <button type="button" data-l="11" aria-pressed="false">Class 11</button>
      </div>
    </div>
    <label>Mixture <select class="sl-mix"></select></label>
    <p class="ax-help sl-note"></p>
    <canvas class="sl-scene" aria-label="The lab bench"></canvas>
    <p class="sl-pick-lab">Use the next method on container:</p>
    <div class="ax-seg sl-boxes" role="group" aria-label="Container"></div>
    <div class="sl-methods" role="group" aria-label="Methods"></div>
    <div class="ax-row sl-ctl"><button type="button" class="btn secondary small sl-undo">Undo</button><button type="button" class="btn secondary small sl-reset">Start again</button></div>
  </div>

  <div class="ax-card">
    <h2>What happened</h2>
    <p class="sl-state"><span class="ax-pill sl-pill"></span></p>
    <p class="sl-why"></p>
    <dl class="ax-facts sl-facts"></dl>
    <div class="sl-extra"></div>
    <h3 class="sl-h3">Your steps</h3>
    <ol class="sl-log"></ol>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sl-try">
      <li><b>Sand and salt:</b> neither the sieve nor a magnet works. Add water first, then filter, then evaporate. Three steps, two pure substances.</li>
      <li><b>Salt water:</b> evaporation gives you the salt but the water goes into the air. Distillation keeps both.</li>
      <li><b>Alcohol and water:</b> try simple distillation, then fractional distillation. The boiling points are only 22 °C apart.</li>
      <li><b>Muddy water:</b> letting it settle leaves cloudy water. Which two methods get clear water?</li>
      <li><b>Green ink:</b> is it one dye or two? Only one method can tell you.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <div class="sl-quiz"></div>
  </div>
</div>

<script>
  import { COMPS, MIXTURES, METHODS, apply, recovered, isPure, questions, SIMPLE_GAP, type Box, type MethodId, type Result } from '../../lib/sci/separation-lab';
  import { mountQuiz } from '../../lib/school-quiz-b';
  import { pagePalette, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.sl')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const mixSel = q<HTMLSelectElement>('.sl-mix');
  for (const m of MIXTURES) mixSel.append(new Option(m.name, m.id));

  let level: 9 | 11 = 9, mix = MIXTURES[0], boxes: Box[] = [], sel = 0, last: { m: MethodId; r: Result; src: Box } | null = null, anim = 1, raf = 0;
  let history: { boxes: Box[]; sel: number; last: typeof last; log: string[] }[] = [], log: string[] = [];

  const methBox = q('.sl-methods');
  for (const m of METHODS) {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'btn secondary small'; b.dataset.m = m.id; b.textContent = m.name;
    b.addEventListener('click', () => use(m.id)); methBox.append(b);
  }

  const boxName = (b: Box) => {
    const n = b.comps.map((i) => COMPS[i].name), s = n.length < 2 ? n.join('') : `${n.slice(0, -1).join(', ')} + ${n[n.length - 1]}`;
    return b.trace?.length ? `${s} (+ a little ${b.trace.map((i) => COMPS[i].name).join(', ')})` : s;
  };

  function start() {
    mix = MIXTURES.find((m) => m.id === mixSel.value) ?? MIXTURES[0];
    boxes = [{ comps: [...mix.comps].sort() }]; sel = 0; last = null; log = []; history = []; anim = 1;
    render();
  }
  function use(m: MethodId) {
    const src = boxes[sel], r = apply(m, src), name = METHODS.find((x) => x.id === m)!.name;
    history.push({ boxes, sel, last, log: [...log] });
    last = { m, r, src };
    if (r.ok !== 'no') { boxes = [...boxes.slice(0, sel), ...r.out, ...boxes.slice(sel + 1)]; sel = Math.min(sel, Math.max(0, boxes.length - 1)); const imp = boxes.findIndex((b) => !isPure(b)); if (imp >= 0 && isPure(boxes[sel])) sel = imp; }
    log.push(`${name} on ${boxName(src)}: ${r.ok === 'yes' ? 'worked' : r.ok === 'part' ? 'partly worked' : 'did not work'}`);
    cancelAnimationFrame(raf); anim = 0; let t0 = performance.now();
    const tick = (now: number) => { anim = Math.min(1, (now - t0) / 1200); draw(); if (anim < 1) raf = requestAnimationFrame(tick); };
    raf = requestAnimationFrame(tick);
    render();
  }
  q('.sl-undo').addEventListener('click', () => { const h = history.pop(); if (!h) return; boxes = h.boxes; sel = h.sel; last = h.last; log = h.log; anim = 1; render(); });
  q('.sl-reset').addEventListener('click', start);
  mixSel.addEventListener('change', start);

  function render() {
    q('.sl-note').textContent = mix.note;
    const seg = q('.sl-boxes');
    seg.replaceChildren(...boxes.map((b, i) => {
      const btn = document.createElement('button'); btn.type = 'button'; btn.dataset.i = String(i);
      btn.textContent = `${i + 1}${isPure(b) ? ' ✓' : ''}`; btn.setAttribute('aria-pressed', String(i === sel)); btn.setAttribute('aria-label', `Container ${i + 1}: ${boxName(b)}`);
      btn.addEventListener('click', () => { sel = i; render(); }); return btn;
    }));
    if (!boxes.length) seg.textContent = '';
    const got = recovered(boxes, mix.targets), done = got.length === mix.targets.length;
    const pill = q('.sl-pill');
    if (!last) { pill.textContent = 'Pick a method to try'; pill.className = 'ax-pill sl-pill'; q('.sl-why').textContent = 'Each button is one lab method. Pick the container (1, 2, …) first when there is more than one.'; }
    else {
      const name = METHODS.find((x) => x.id === last!.m)!.name;
      pill.textContent = done ? `Separated! ${name} finished the job` : last.r.ok === 'yes' ? `${name} worked` : last.r.ok === 'part' ? `${name} only partly worked` : `${name} does not work here`;
      pill.className = `ax-pill sl-pill ${done || last.r.ok === 'yes' ? 'good' : last.r.ok === 'part' ? 'warn' : 'bad'}`;
      q('.sl-why').textContent = last.r.why + (last.r.lost?.length && last.r.ok !== 'no' ? ` Lost into the air: ${last.r.lost.map((i) => COMPS[i].name).join(', ')}.` : '');
    }
    const m = last ? METHODS.find((x) => x.id === last!.m)! : null;
    const facts: [string, string, string][] = [
      ['Recovered pure', `${got.length} of ${mix.targets.length}`, mix.targets.map((t) => `${COMPS[t].name} ${got.includes(t) ? '✓' : '✗'}`).join(', ')],
      ['Steps used', String(log.length), done ? (log.length <= mix.best.length ? 'the fewest possible' : `it can be done in ${mix.best.length}`) : ''],
    ];
    if (m) facts.push(['Property used', m.uses, '']);
    q('.sl-facts').replaceChildren(...facts.map(([k, v, s]) => fact(k, v, s)));
    const ex: HTMLElement[] = [];
    if (last?.r.temps?.length && last.r.ok !== 'no') ex.push(para('Thermometer: ', last.r.temps.length > 1 ? `stays at ${last.r.temps[0]} °C while the first liquid distils, then climbs to ${last.r.temps[1]} °C.` : `stays at ${last.r.temps[0]} °C while the liquid distils.`));
    if (level === 11) {
      const liqs = mix.comps.filter((i) => COMPS[i].liquid && !COMPS[i].immiscible);
      if (liqs.length === 2) { const [a, b] = liqs.map((i) => COMPS[i].bp!).sort((x, y) => x - y); ex.push(para('Rule of thumb: ', `boiling points ${a} °C and ${b} °C differ by ${b - a} °C. At about ${SIMPLE_GAP} °C or more simple distillation works; closer than that, use a fractionating column, where the vapour condenses and boils again many times on the way up.`)); }
      if (mix.id === 'ink') ex.push(para('Rf values (made-up teaching values): ', 'blue 0.3, yellow 0.7. Rf = distance moved by the spot ÷ distance moved by the solvent front. Each dye has its own Rf for a given paper and solvent, so Rf helps identify it.'));
      if (mix.id === 'nh4cl') ex.push(para('Also sublimes: ', 'camphor, naphthalene and iodine. Class 11 uses sublimation to purify such solids.'));
      if (mix.id === 'brine') ex.push(para('Crystallisation vs evaporation: ', 'crystals grown from a cooling solution leave soluble impurities behind in the liquid, so they are purer than a solid baked dry.'));
    }
    q('.sl-extra').replaceChildren(...ex);
    q('.sl-log').replaceChildren(...log.map((s) => { const li = document.createElement('li'); li.textContent = s; return li; }));
    q('.sl-h3').hidden = !log.length;
    q<HTMLButtonElement>('.sl-undo').disabled = !history.length;
    draw();
  }

  // ---- drawing ----------------------------------------------------------------------------------------------
  const H = 300;
  function col(pal: Palette, id: string) { const c = COMPS[id]; return pal.red ? (c.liquid ? pal.line : id === 'cream' || id === 'salt' || id === 'rice' || id === 'flour' || id === 'nh4cl' ? pal.muted : pal.ink) : c.colour; }
  function rnd(seed: number) { let s = seed; return () => ((s = (s * 16807) % 2147483647) / 2147483647); }
  function liquidColour(pal: Palette, b: Box) {
    const dyes = b.comps.filter((i) => COMPS[i].dye);
    if (dyes.length > 1 && !pal.red) return '#3f8f3a';
    if (dyes.length === 1) return col(pal, dyes[0]);
    if (b.comps.includes('cream') && !pal.red) return '#f3f0e6';
    const l = b.comps.find((i) => COMPS[i].liquid && !COMPS[i].immiscible) ?? b.comps.find((i) => COMPS[i].liquid);
    return l ? col(pal, l) : '';
  }
  function beaker(ctx: CanvasRenderingContext2D, pal: Palette, x: number, y: number, w: number, h: number, b: Box, seed: number, alpha = 1, hi = false) {
    ctx.save(); ctx.globalAlpha = alpha;
    const liqs = b.comps.filter((i) => COMPS[i].liquid), sol = b.comps.filter((i) => !COMPS[i].liquid);
    const r = rnd(seed + 7);
    ctx.save(); ctx.beginPath(); ctx.rect(x + 2, y, w - 4, h - 2); ctx.clip();
    if (liqs.length) {
      const imm = liqs.length > 1 && liqs.some((i) => COMPS[i].immiscible);
      if (imm) {
        const sorted = [...liqs].sort((a, c) => COMPS[c].dense! - COMPS[a].dense!), lh = (h * 0.7) / sorted.length;
        sorted.forEach((id, k) => { ctx.fillStyle = col(pal, id); ctx.globalAlpha = alpha * (pal.red ? 0.6 : 0.75); ctx.fillRect(x, y + h - lh * (k + 1), w, lh); });
      } else { ctx.fillStyle = liquidColour(pal, b); ctx.globalAlpha = alpha * (pal.red ? 0.6 : 0.55); ctx.fillRect(x, y + h * 0.3, w, h * 0.7); }
      ctx.globalAlpha = alpha;
    }
    for (const id of sol) {
      const c = COMPS[id];
      if (liqs.length && c.soluble) { // dissolved: a few faint specks spread through the liquid
        if (c.dye) continue;
        ctx.fillStyle = pal.red ? pal.muted : '#ffffff'; ctx.globalAlpha = alpha * 0.8;
        for (let k = 0; k < 14; k++) ctx.fillRect(x + 4 + r() * (w - 8), y + h * 0.32 + r() * h * 0.62, 1.6, 1.6);
        ctx.globalAlpha = alpha; continue;
      }
      ctx.fillStyle = col(pal, id); ctx.strokeStyle = pal.ink; ctx.lineWidth = 0.6;
      const count = c.size === 'big' ? 9 : c.size === 'grain' ? 40 : c.size === 'fine' ? 90 : 60;
      const spread = liqs.length && (c.size === 'tiny' || c.size === 'fine');
      const top = spread ? y + h * 0.32 : liqs.length ? y + h * 0.78 : y + h * (sol.length > 1 ? 0.45 : 0.55), bot = y + h - 3;
      for (let k = 0; k < count; k++) {
        const px = x + 5 + r() * (w - 10), py = top + r() * (bot - top);
        if (c.size === 'big') { ctx.beginPath(); ctx.ellipse(px, py, id === 'stone' ? 5 : 6, id === 'stone' ? 4 : 2.6, r() * 3, 0, 7); ctx.fill(); ctx.stroke(); }
        else if (c.size === 'grain') ctx.fillRect(px, py, 2.6, 2.6);
        else ctx.fillRect(px, py, 1.4, 1.4);
      }
    }
    if (b.trace?.length) { ctx.font = '600 11px system-ui, sans-serif'; ctx.fillStyle = pal.ink; ctx.textAlign = 'center'; ctx.fillText('+ trace', x + w / 2, y + 12); }
    ctx.restore();
    ctx.strokeStyle = hi ? pal.accent : pal.ink; ctx.lineWidth = hi ? 3 : 2;
    ctx.beginPath(); ctx.moveTo(x - 3, y); ctx.lineTo(x, y); ctx.lineTo(x, y + h); ctx.lineTo(x + w, y + h); ctx.lineTo(x + w, y); ctx.lineTo(x + w + 3, y); ctx.stroke();
    ctx.restore();
  }
  function flame(ctx: CanvasRenderingContext2D, pal: Palette, x: number, y: number, t: number) {
    ctx.fillStyle = pal.red ? pal.ink : '#e8701a'; const f = 1 + 0.15 * Math.sin(t * 40);
    ctx.beginPath(); ctx.moveTo(x - 7, y); ctx.quadraticCurveTo(x - 6, y - 12 * f, x, y - 20 * f); ctx.quadraticCurveTo(x + 6, y - 12 * f, x + 7, y); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2; ctx.strokeRect(x - 6, y, 12, 14);
  }
  function arrowTo(ctx: CanvasRenderingContext2D, pal: Palette, x0: number, y0: number, x1: number, y1: number) {
    ctx.strokeStyle = pal.muted; ctx.fillStyle = pal.muted; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke(); ctx.setLineDash([]);
    const a = Math.atan2(y1 - y0, x1 - x0); ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x1 - 8 * Math.cos(a - 0.4), y1 - 8 * Math.sin(a - 0.4)); ctx.lineTo(x1 - 8 * Math.cos(a + 0.4), y1 - 8 * Math.sin(a + 0.4)); ctx.fill();
  }
  // a small picture of the method's apparatus with the source mixture in it
  function apparatus(ctx: CanvasRenderingContext2D, pal: Palette, m: MethodId, src: Box, cx: number, top: number, t: number) {
    ctx.strokeStyle = pal.ink; ctx.fillStyle = pal.ink; ctx.lineWidth = 2;
    const bw = 56, bh = 60, bx = cx - bw / 2, by = top + 58;
    switch (m) {
      case 'hand': case 'water': case 'settle': case 'cryst': case 'evap': {
        if (m === 'evap' || m === 'cryst') { // dish on a stand over a flame
          ctx.beginPath(); ctx.ellipse(cx, by + 20, 40, 14, 0, 0, Math.PI); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - 40, by + 20); ctx.lineTo(cx + 40, by + 20); ctx.stroke();
          ctx.fillStyle = liquidColour(pal, src) || pal.muted; ctx.globalAlpha = 0.6 * (1 - t * (m === 'evap' ? 1 : 0.5)); ctx.beginPath(); ctx.ellipse(cx, by + 21, 34, 9, 0, 0, Math.PI); ctx.fill(); ctx.globalAlpha = 1;
          flame(ctx, pal, cx, by + 62, t);
          ctx.strokeStyle = pal.muted; for (let k = 0; k < 3; k++) { const yy = by + 6 - ((t * 60 + k * 18) % 50); ctx.beginPath(); ctx.moveTo(cx - 14 + k * 14, yy); ctx.quadraticCurveTo(cx - 8 + k * 14, yy - 6, cx - 14 + k * 14, yy - 12); ctx.stroke(); }
          return;
        }
        beaker(ctx, pal, bx, by, bw, bh, m === 'water' && t > 0.5 ? { comps: [...src.comps, 'water'] } : src, 3);
        if (m === 'water') { ctx.strokeStyle = pal.ink; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(cx + 10 + 8 * Math.sin(t * 20), top + 30); ctx.lineTo(cx - 4 + 8 * Math.sin(t * 20), by + bh - 6); ctx.stroke(); }
        if (m === 'settle') { ctx.save(); ctx.translate(bx + bw + 30, by + 4); ctx.rotate(-0.5 * Math.min(1, t * 2)); ctx.strokeStyle = pal.ink; ctx.strokeRect(-14, -22, 28, 38); ctx.restore(); }
        if (m === 'hand') { ctx.font = '26px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.fillText('✋', cx + 30 - t * 20, top + 40); }
        return;
      }
      case 'sieve': {
        ctx.beginPath(); ctx.ellipse(cx, top + 50, 44, 10, 0, 0, 7); ctx.stroke();
        ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; for (let k = -36; k <= 36; k += 6) { ctx.beginPath(); ctx.moveTo(cx + k, top + 43); ctx.lineTo(cx + k, top + 57); ctx.stroke(); }
        ctx.fillStyle = pal.muted; const r = rnd(5); for (let k = 0; k < 26 * t; k++) ctx.fillRect(cx - 30 + r() * 60, top + 64 + r() * 40 * t + k % 7, 1.6, 1.6);
        beaker(ctx, pal, bx, by + 40, bw, 40, { comps: [] }, 1);
        return;
      }
      case 'magnet': {
        beaker(ctx, pal, bx, by + 10, bw, 50, src, 4);
        const my = top + 20 + 40 * (t < 0.5 ? t * 2 : 2 - t * 2);
        ctx.lineWidth = 9; ctx.strokeStyle = pal.red ? pal.ink : '#c0282d'; ctx.beginPath(); ctx.arc(cx, my, 16, Math.PI, 0, false); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx - 16, my); ctx.lineTo(cx - 16, my + 18); ctx.moveTo(cx + 16, my); ctx.lineTo(cx + 16, my + 18); ctx.stroke(); ctx.lineWidth = 2;
        return;
      }
      case 'filter': {
        ctx.beginPath(); ctx.moveTo(cx - 30, top + 20); ctx.lineTo(cx, top + 60); ctx.lineTo(cx + 30, top + 20); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - 3, top + 60); ctx.lineTo(cx - 3, top + 80); ctx.moveTo(cx + 3, top + 60); ctx.lineTo(cx + 3, top + 80); ctx.stroke();
        ctx.strokeStyle = pal.muted; ctx.setLineDash([2, 2]); ctx.beginPath(); ctx.moveTo(cx - 26, top + 22); ctx.lineTo(cx, top + 56); ctx.lineTo(cx + 26, top + 22); ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle = liquidColour(pal, src) || pal.muted; ctx.beginPath(); ctx.arc(cx, top + 84 + ((t * 120) % 20), 2.5, 0, 7); ctx.fill();
        beaker(ctx, pal, bx, by + 50, bw, 44, { comps: src.comps.filter((i) => COMPS[i].liquid) }, 2, t);
        return;
      }
      case 'distil': case 'frac': {
        const fx = cx - 50, fy = top + 70;
        ctx.beginPath(); ctx.arc(fx, fy, 22, 0, 7); ctx.stroke(); ctx.fillStyle = liquidColour(pal, src) || pal.muted; ctx.globalAlpha = 0.6; ctx.beginPath(); ctx.arc(fx, fy, 20, 0.2, Math.PI - 0.2); ctx.fill(); ctx.globalAlpha = 1;
        ctx.strokeStyle = pal.ink; const colTop = m === 'frac' ? top + 4 : top + 30;
        ctx.strokeRect(fx - 5, colTop, 10, fy - 22 - colTop);
        if (m === 'frac') { ctx.strokeStyle = pal.muted; for (let yy = colTop + 6; yy < fy - 26; yy += 7) { ctx.beginPath(); ctx.arc(fx, yy, 3, 0, 7); ctx.stroke(); } }
        ctx.strokeStyle = pal.ink; ctx.beginPath(); ctx.moveTo(fx + 5, colTop + 8); ctx.lineTo(cx + 50, top + 64); ctx.stroke();
        ctx.save(); ctx.translate((fx + cx + 50) / 2 + 3, (colTop + top + 72) / 2); ctx.rotate(Math.atan2(top + 64 - colTop - 8, cx + 50 - fx - 5)); ctx.strokeRect(-40, -8, 80, 16); ctx.restore();
        flame(ctx, pal, fx, fy + 26, t);
        ctx.fillStyle = liquidColour(pal, { comps: src.comps.filter((i) => COMPS[i].liquid).slice(0, 1) }) || pal.muted; ctx.beginPath(); ctx.arc(cx + 52, top + 72 + ((t * 120) % 14), 2.5, 0, 7); ctx.fill();
        beaker(ctx, pal, cx + 34, top + 90, 40, 40, { comps: [] }, 1);
        return;
      }
      case 'funnel': {
        ctx.beginPath(); ctx.moveTo(cx - 6, top + 10); ctx.lineTo(cx - 30, top + 50); ctx.lineTo(cx - 4, top + 90); ctx.lineTo(cx - 4, top + 120); ctx.moveTo(cx + 6, top + 10); ctx.lineTo(cx + 30, top + 50); ctx.lineTo(cx + 4, top + 90); ctx.lineTo(cx + 4, top + 120); ctx.stroke();
        ctx.strokeRect(cx - 10, top + 100, 20, 6);
        const liqs = src.comps.filter((i) => COMPS[i].liquid).sort((a, c) => COMPS[c].dense! - COMPS[a].dense!);
        ctx.globalAlpha = 0.7; if (liqs[0]) { ctx.fillStyle = col(pal, liqs[0]); ctx.beginPath(); ctx.moveTo(cx - 24, top + 60 + t * 18); ctx.lineTo(cx + 24, top + 60 + t * 18); ctx.lineTo(cx + 4, top + 90); ctx.lineTo(cx - 4, top + 90); ctx.fill(); }
        if (liqs[1]) { ctx.fillStyle = col(pal, liqs[1]); ctx.beginPath(); ctx.moveTo(cx - 24 + t * 6, top + 40 + t * 18); ctx.lineTo(cx + 24 - t * 6, top + 40 + t * 18); ctx.lineTo(cx + 24, top + 60 + t * 18); ctx.lineTo(cx - 24, top + 60 + t * 18); ctx.fill(); }
        ctx.globalAlpha = 1; return;
      }
      case 'sublime': {
        ctx.beginPath(); ctx.ellipse(cx, by + 30, 40, 14, 0, 0, Math.PI); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx - 40, by + 30); ctx.lineTo(cx + 40, by + 30); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx - 34, by + 30); ctx.lineTo(cx - 3, top + 20); ctx.lineTo(cx - 3, top + 4); ctx.moveTo(cx + 34, by + 30); ctx.lineTo(cx + 3, top + 20); ctx.lineTo(cx + 3, top + 4); ctx.stroke();
        ctx.fillStyle = pal.muted; const r = rnd(9); for (let k = 0; k < 30 * t; k++) ctx.fillRect(cx - 25 + r() * 50, top + 30 + r() * 50, 2, 2);
        flame(ctx, pal, cx, by + 66, t); return;
      }
      case 'chroma': {
        ctx.strokeRect(cx - 18, top + 4, 36, 120); ctx.strokeStyle = pal.muted; ctx.beginPath(); ctx.moveTo(cx - 18, top + 108); ctx.lineTo(cx + 18, top + 108); ctx.stroke();
        ctx.fillStyle = pal.red ? pal.line : '#6aa7e0'; ctx.globalAlpha = 0.25; ctx.fillRect(cx - 18, top + 124 - t * 110, 36, t * 110); ctx.globalAlpha = 1;
        const dyes = src.comps.filter((i) => COMPS[i].dye);
        for (const d of dyes) { ctx.fillStyle = col(pal, d); ctx.beginPath(); ctx.arc(cx, top + 108 - COMPS[d].dye! * t * 94, 5, 0, 7); ctx.fill(); }
        return;
      }
      case 'spin': {
        ctx.save(); ctx.translate(cx, top + 66); ctx.rotate(t * 30);
        for (const a of [0, Math.PI]) { ctx.save(); ctx.rotate(a); ctx.strokeRect(14, -8, 40, 16); ctx.fillStyle = liquidColour(pal, src) || pal.muted; ctx.globalAlpha = 0.6; ctx.fillRect(15, -7, 38, 14); ctx.restore(); }
        ctx.restore(); ctx.beginPath(); ctx.arc(cx, top + 66, 6, 0, 7); ctx.fill(); return;
      }
    }
  }
  function draw() {
    const pal = pagePalette(), c = q<HTMLCanvasElement>('.sl-scene');
    const w = Math.max(260, Math.round(c.clientWidth || c.parentElement!.clientWidth || 320)), dpr = Math.min(3, window.devicePixelRatio || 1);
