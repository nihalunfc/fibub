---
// USDA soil texture triangle: classify sand / silt / clay into the 12 USDA classes and plot samples. Example data made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
const example = 'sample\tsand\tsilt\tclay\nField 1 top\t42\t38\t20\nField 1 deep\t30\t36\t34\nRiver bank\t78\t15\t7\nTerrace\t12\t70\t18\nGarden bed\t55\t30\t15\nPond edge\t18\t40\t42\nDune\t93\t4\t3\nOrchard\t25\t50\t25';
---
<div class="ax stt">
  <div class="ax-card">
    <h2>One sample</h2>
    <div class="ax-grid">
      <label>Sand (%) <input class="st-sand" inputmode="decimal" value="40" /></label>
      <label>Silt (%) <input class="st-silt" inputmode="decimal" value="40" /></label>
      <label>Clay (%) <input class="st-clay" inputmode="decimal" value="20" /></label>
    </div>
    <p class="ax-big st-one"></p>
    <p class="ax-help st-onehelp">Leave one box empty and it is filled in as 100 minus the other two.</p>
  </div>

  <div class="ax-card">
    <h2>Many samples</h2>
    <label>A row per sample: name, sand, silt and clay in % (a header row with the words sand, silt and clay lets the columns come in any order)
      <textarea class="st-data" rows="9" spellcheck="false">{example}</textarea></label>
    <DataFile target=".st-data" maxCols={20} maxRows={20000} />
    <div class="ax-grid" style="margin-top:10px">
      <label>When the three do not add up to 100 <select class="st-tol"><option value="2" selected>Rescale if within 2 %</option><option value="5">Rescale if within 5 %</option><option value="all">Always rescale</option><option value="0.01">Never rescale</option></select></label>
      <label>Point labels <select class="st-lab"><option value="auto" selected>If 20 points or fewer</option><option value="on">Always</option><option value="off">Never</option></select></label>
      <label>Class names on the triangle <select class="st-names"><option value="on" selected>Show</option><option value="off">Hide</option></select></label>
    </div>
    <p class="ax-help">Sand is 0.05 to 2 mm, silt 0.002 to 0.05 mm and clay below 0.002 mm (the USDA sizes). Measure them on the fine earth only (stones and gravel over 2 mm removed). Up to 20,000 rows. The example samples are made up.</p>
    <p class="ax-err st-err" hidden></p>
  </div>

  <div class="ax-card st-out">
    <h2>Result</h2>
    <p class="ax-big st-big"></p>
    <p class="ax-help st-warn" hidden></p>
    <canvas class="ax-fig st-fig"></canvas>
    <h3>Samples by class</h3>
    <div class="ax-scroll"><table class="st-count"></table></div>
    <h3>Each sample</h3>
    <div class="ax-scroll"><table class="st-tab"></table></div>
    <p class="ax-help st-more" hidden></p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small st-csv">Download classes (CSV)</button></div>
    <Downloads />
  </div>
</div>

<script>
  import { readSamples, CLASSES, POLYGONS, LABELS, triXY, type Sample } from '../../lib/sci/soiltexture';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, parseTable, csv as toCsv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.stt')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f1 = (x: number) => String(+x.toFixed(1));
  let fig: Figure | null = null, sections: Section[] = [], csvRows: string[][] = [];

  function table(sel: string, head: string[], rows: string[][], right: number[] = []) {
    const t = q<HTMLTableElement>(sel); t.replaceChildren();
    const hr = t.createTHead().insertRow(); head.forEach((h, i) => { const th = document.createElement('th'); th.textContent = h; if (right.includes(i)) th.style.textAlign = 'right'; hr.append(th); });
    const b = t.createTBody(); rows.forEach((r) => { const tr = b.insertRow(); r.forEach((c, i) => { const td = tr.insertCell(); td.textContent = c; if (right.includes(i)) td.style.textAlign = 'right'; }); });
  }

  function one() {
    const v = ['.st-sand', '.st-silt', '.st-clay'].map((c) => q<HTMLInputElement>(c).value.trim() === '' ? NaN : num(q<HTMLInputElement>(c).value));
    const r = readSamples([{ name: 'This sample', sand: v[0], silt: v[1], clay: v[2] }], 2);
    const o = q('.st-one'), h = q('.st-onehelp');
    if (!r.samples.length) { o.textContent = '–'; h.textContent = r.problems[0].replace('This sample: ', ''); h.classList.add('ax-err'); return; }
    const s = r.samples[0];
    o.textContent = s.cls;
    h.classList.remove('ax-err');
    h.textContent = `Sand ${f1(s.sand)} %, silt ${f1(s.silt)} %, clay ${f1(s.clay)} %${s.scaled ? ` (rescaled from a total of ${f1(s.total)} %)` : ''}. Leave one box empty and it is filled in as 100 minus the other two.`;
  }

  function read(): { names: string[]; rows: { name: string; sand: number; silt: number; clay: number }[] } | string {
    const t = parseTable(q<HTMLTextAreaElement>('.st-data').value);
    if (!t.length) return 'Paste a row per sample: name, sand, silt and clay.';
    const head = t[0].map((c) => c.toLowerCase());
    const hasHead = head.some((c) => c !== '' && !Number.isFinite(num(c))) && head.some((c) => /sand|silt|clay/.test(c));
    let iS: number, iSi: number, iC: number, iN = -1;
    if (hasHead) {
      iS = head.findIndex((c) => /sand/.test(c)); iSi = head.findIndex((c) => /silt/.test(c)); iC = head.findIndex((c) => /clay/.test(c));
      if (iS < 0 || iSi < 0 || iC < 0) return 'The header row needs columns named sand, silt and clay.';
      iN = head.findIndex((_, i) => i !== iS && i !== iSi && i !== iC);
    } else {
      const w = t[0].length, nameCol = !Number.isFinite(num(t[0][0])) && w >= 4;
      if (w < 3) return 'Each row needs sand, silt and clay (and an optional name first).';
      iN = nameCol ? 0 : -1; [iS, iSi, iC] = nameCol ? [1, 2, 3] : [0, 1, 2];
    }
    const body = hasHead ? t.slice(1) : t;
    if (body.length > 20000) return 'Up to 20,000 rows, please.';
    const cell = (r: string[], i: number) => ((r[i] ?? '').trim() === '' ? NaN : num(r[i]));
    const rows = body.map((r, k) => ({ name: iN >= 0 && (r[iN] ?? '').trim() ? r[iN].trim() : `Row ${k + 1}`, sand: cell(r, iS), silt: cell(r, iSi), clay: cell(r, iC) }));
    return { names: rows.map((r) => r.name), rows };
  }

  function calc() {
    const fail = (m: string) => { q('.st-err').textContent = m; q('.st-err').hidden = false; q('.st-out').hidden = true; fig = null; sections = []; csvRows = []; };
    q('.st-err').hidden = true;
    const d = read();
    if (typeof d === 'string') return fail(d);
    const tv = q<HTMLSelectElement>('.st-tol').value;
    const { samples, problems } = readSamples(d.rows, tv === 'all' ? 0 : Number(tv), tv === 'all');
    if (!samples.length) return fail(problems.length ? `No sample could be classified. ${problems.slice(0, 3).join(' ')}` : 'No sample could be classified.');
    q('.st-out').hidden = false;
    const counts = CLASSES.map((c) => samples.filter((s) => s.cls === c).length);
    const top = Math.max(...counts), topCls = CLASSES.filter((_, i) => counts[i] === top);
    q('.st-big').textContent = samples.length === 1 ? `${samples[0].name}: ${samples[0].cls}` : `${samples.length} samples in ${counts.filter((c) => c).length} classes; most common: ${topCls.join(', ')} (${top})`;
    const w = q('.st-warn'), scaled = samples.filter((s) => s.scaled).length;
    const notes = [...(problems.length ? [`${problems.length} row${problems.length > 1 ? 's' : ''} skipped: ${problems.slice(0, 3).join(' ')}${problems.length > 3 ? ' …' : ''}`] : []), ...(scaled ? [`${scaled} sample${scaled > 1 ? 's' : ''} rescaled to add up to 100 %.`] : [])];
    w.textContent = notes.join(' '); w.hidden = !notes.length;

    const lm = q<HTMLSelectElement>('.st-lab').value, showLab = lm === 'on' || (lm === 'auto' && samples.length <= 20), names = q<HTMLSelectElement>('.st-names').value === 'on';
    fig = triangle(samples, showLab, names);
    paint(q<HTMLCanvasElement>('.st-fig'), fig);

    const cRows = CLASSES.map((c, i) => [c, String(counts[i]), `${f1((100 * counts[i]) / samples.length)} %`]).filter((r) => r[1] !== '0');
    table('.st-count', ['Class', 'Samples', 'Share'], cRows, [1, 2]);
    const head = ['Sample', 'Sand %', 'Silt %', 'Clay %', 'USDA class'];
    const rows = samples.map((s) => [s.name, f1(s.sand), f1(s.silt), f1(s.clay), s.cls + (s.scaled ? ' *' : '')]);
    table('.st-tab', head, rows.slice(0, 500), [1, 2, 3]);
    q('.st-more').hidden = rows.length <= 500 && !scaled;
    q('.st-more').textContent = `${rows.length > 500 ? `Showing the first 500 of ${rows.length} samples; the CSV has them all. ` : ''}${scaled ? '* rescaled so sand + silt + clay = 100 %.' : ''}`;
    csvRows = [['sample', 'sand_pct', 'silt_pct', 'clay_pct', 'total_given_pct', 'usda_class'], ...samples.map((s) => [s.name, s.sand.toFixed(2), s.silt.toFixed(2), s.clay.toFixed(2), String(+s.total.toFixed(3)), s.cls])];
    sections = [{ title: q('.st-big').textContent!, text: ['USDA soil texture classes from sand (0.05 to 2 mm), silt (0.002 to 0.05 mm) and clay (below 0.002 mm) percentages of the fine earth.', ...notes], figure: fig, table: { head: ['Class', 'Samples', 'Share'], rows: cRows, align: ['l', 'r', 'r'] } },
      { title: 'Each sample', table: { head, rows: rows.slice(0, 2000), align: ['l', 'r', 'r', 'r', 'l'] } }];
  }

  function triangle(samples: Sample[], showLab: boolean, names: boolean): Figure {
    return { w: 400, h: 390, alt: `USDA soil texture triangle with ${samples.length} sample${samples.length > 1 ? 's' : ''}`, draw: (ctx, W, H, pal) => {
      const side = Math.min(W - 76, (H - 70) / (Math.sqrt(3) / 2)), ox = (W - side) / 2, oy = 22 + side * (Math.sqrt(3) / 2);
      const P = (clay: number, silt: number, sand: number): [number, number] => { const [x, y] = triXY(clay, silt, sand); return [ox + x * side, oy - y * side]; };
      const seg = (a: [number, number], b: [number, number]) => { ctx.beginPath(); ctx.moveTo(...a); ctx.lineTo(...b); ctx.stroke(); };
      ctx.lineWidth = 0.6; ctx.strokeStyle = pal.grid; ctx.font = '9px system-ui, sans-serif'; ctx.fillStyle = pal.muted;
      for (let v = 10; v < 100; v += 10) {
        seg(P(v, 0, 100 - v), P(v, 100 - v, 0)); seg(P(0, v, 100 - v), P(100 - v, v, 0)); seg(P(0, 100 - v, v), P(100 - v, 0, v));
        let [x, y] = P(v, 0, 100 - v); ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; ctx.fillText(String(v), x - 4, y);
        [x, y] = P(100 - v, v, 0); ctx.textAlign = 'left'; ctx.fillText(String(v), x + 4, y);
        [x, y] = P(0, 100 - v, v); ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(String(v), x, y + 4);
      }
      ctx.strokeStyle = pal.ink; ctx.lineWidth = 1;
      for (const c of CLASSES) { const p = POLYGONS[c]; ctx.beginPath(); p.forEach((v, i) => { const [x, y] = P(...v); if (i) ctx.lineTo(x, y); else ctx.moveTo(x, y); }); ctx.closePath(); ctx.stroke(); }
      ctx.lineWidth = 1.4; ctx.beginPath(); ctx.moveTo(...P(100, 0, 0)); ctx.lineTo(...P(0, 0, 100)); ctx.lineTo(...P(0, 100, 0)); ctx.closePath(); ctx.stroke();
      if (names) {
        ctx.fillStyle = pal.muted; ctx.font = '9.5px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        for (const c of CLASSES) { const [x, y] = P(...LABELS[c]); const parts = c === 'Silty clay loam' ? ['Silty clay', 'loam'] : c === 'Sandy clay loam' ? ['Sandy clay', 'loam'] : c === 'Loamy sand' ? ['Loamy', 'sand'] : [c]; parts.forEach((t, i) => ctx.fillText(t, x, y + (i - (parts.length - 1) / 2) * 10)); }
      }
      ctx.fillStyle = pal.ink; ctx.font = 'bold 11px system-ui, sans-serif';
      const a = P(55, 0, 45); ctx.save(); ctx.translate(a[0] - 26, a[1]); ctx.rotate(-Math.PI / 3); ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('Clay (%) →', 0, 0); ctx.restore();
      const b = P(55, 45, 0); ctx.save(); ctx.translate(b[0] + 26, b[1]); ctx.rotate(Math.PI / 3); ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('Silt (%) →', 0, 0); ctx.restore();
      const c0 = P(0, 50, 50); ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText('← Sand (%)', c0[0], c0[1] + 18);
      const col = pal.red ? pal.ink : pal.accent;
      samples.forEach((s) => { const [x, y] = P(s.clay, s.silt, s.sand); ctx.beginPath(); ctx.arc(x, y, 3.6, 0, 2 * Math.PI); ctx.fillStyle = col; ctx.fill(); ctx.lineWidth = 1; ctx.strokeStyle = pal.bg; ctx.stroke(); });
      if (showLab) { ctx.font = '9px system-ui, sans-serif'; ctx.fillStyle = pal.ink; ctx.textAlign = 'left'; ctx.textBaseline = 'middle'; samples.forEach((s) => { const [x, y] = P(s.clay, s.silt, s.sand); const t = s.name.length > 18 ? s.name.slice(0, 17) + '…' : s.name; ctx.fillText(t, x + 6, y); }); }
    } };
  }

  let timer = 0;
  const later = () => { clearTimeout(timer); timer = window.setTimeout(calc, 200); };
  root.querySelectorAll('.st-data, .st-tol, .st-lab, .st-names').forEach((i) => { i.addEventListener('input', later); i.addEventListener('change', later); });
  root.querySelectorAll('.st-sand, .st-silt, .st-clay').forEach((i) => i.addEventListener('input', one));
  q('.st-csv').addEventListener('click', () => { if (csvRows.length) save(new TextEncoder().encode(toCsv(csvRows)), 'soil-texture-classes.csv', 'text/csv'); });
  document.addEventListener('fibub:theme', () => { if (fig) paint(q<HTMLCanvasElement>('.st-fig'), fig); });
  one(); calc();
  wireDownloads(q('.dl'), () => ({ title: 'USDA soil texture triangle', subtitle: q('.st-big').textContent ?? '', file: 'soil-texture', sections }));
</script>

<style is:global>
  .stt select { max-width: 100%; }
  .stt textarea { width: 100%; }
</style>
