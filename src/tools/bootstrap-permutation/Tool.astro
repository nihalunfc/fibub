---
// Bootstrap confidence intervals (percentile, BCa) and permutation tests, with a seed so results repeat.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax bp">
  <div class="ax-card">
    <h2>Your data</h2>
    <div class="ax-grid">
      <label>Estimate <select class="bp-stat">
        <optgroup label="One sample">
          <option value="mean">Mean</option>
          <option value="median">Median</option>
          <option value="sd">Standard deviation</option>
        </optgroup>
        <optgroup label="Two separate groups">
          <option value="diff-mean" selected>Difference in means</option>
          <option value="diff-median">Difference in medians</option>
        </optgroup>
        <optgroup label="Pairs (x, y)">
          <option value="pearson">Pearson correlation r</option>
          <option value="spearman">Spearman correlation ρ</option>
          <option value="paired-mean">Mean of paired differences</option>
        </optgroup>
      </select></label>
    </div>
    <label style="margin-top:10px"><span class="bp-how"></span>
      <textarea class="bp-data" rows="10" spellcheck="false" wrap="off"></textarea></label>
    <DataFile target=".bp-data" maxCols={20} maxRows={20000} />
    <div class="ax-grid" style="margin-top:10px">
      <label>Resamples <input class="bp-b" inputmode="numeric" value="9999" /></label>
      <label>Seed <input class="bp-seed" inputmode="numeric" value="12345" /></label>
      <label>Confidence level <select class="bp-conf"><option value="0.9">90 %</option><option value="0.95" selected>95 %</option><option value="0.99">99 %</option></select></label>
      <label class="bp-altl">Permutation test <select class="bp-alt">
        <option value="two-sided" selected>Two-sided</option>
        <option value="greater">First is greater (r above 0)</option>
        <option value="less">First is less (r below 0)</option>
        <option value="off">Do not run</option>
      </select></label>
    </div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small bp-new">New random seed</button></div>
    <p class="ax-help">The same data, seed and number of resamples always give the same answer. A new seed shows how much the result moves by chance; more resamples make it steadier.</p>
    <p class="ax-err bp-err" hidden></p>
  </div>

  <div class="ax-card bp-out" hidden>
    <h2 class="bp-h"></h2>
    <p class="ax-big bp-big"></p>
    <div class="bp-say"></div>
    <dl class="ax-facts bp-facts"></dl>
    <canvas class="ax-fig bp-fig" style="margin-top:14px"></canvas>
    <div class="bp-perm">
      <h3>Permutation test</h3>
      <dl class="ax-facts bp-pfacts"></dl>
      <canvas class="ax-fig bp-pfig" style="margin-top:14px"></canvas>
    </div>
    <div class="ax-row" style="margin-top:10px">
      <button type="button" class="btn secondary small bp-csv">Download the results (CSV)</button>
      <button type="button" class="btn secondary small bp-dcsv">Download the resampled values (CSV)</button>
    </div>
    <Downloads />
  </div>
</div>

<style is:inline>
  .bp .bp-say p { margin: 10px 0 0; }
  .bp .bp-facts { margin-top: 14px; }
  .bp .bp-perm h3 { margin: 18px 0 8px; font-size: 16px; }
</style>

<script>
  import { parseTable, num, sig, csv } from '../../lib/sci/num';
  import { bootstrap, permutation, histogram, STAT_KIND, type Stat, type Alt, type BootResult, type PermResult } from '../../lib/sci/resample';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, save, wireDownloads, type Section, type Figure } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.bp')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const box = q<HTMLTextAreaElement>('.bp-data');
  const EX = {
    one: 'Commute (min)\n12\n18\n25\n14\n9\n31\n16\n22\n58\n15\n19\n27\n13\n21\n44\n17',
    two: 'Old method\tNew method\n14.2\t11.8\n15.9\t12.6\n13.1\t13.9\n17.4\t10.7\n16.0\t12.2\n14.8\t11.5\n19.6\t14.1\n15.2\t12.9\n13.7\t\n16.5\t',
    pairs: 'Hours studied\tScore\n2\t55\n5\t71\n1\t48\n7\t80\n3\t62\n6\t69\n4\t66\n8\t85\n3\t57\n5\t74\n2\t60\n6\t77',
  };
  const HOW = {
    one: 'One column of numbers (a header row is optional).',
    two: 'Two columns, one per group, names in the first row; the groups can have different lengths. Or two columns of group name and value.',
    pairs: 'Two columns, one row per subject: x and y. Rows with a blank are left out.',
  };
  const NAME: Record<Stat, string> = { mean: 'Mean', median: 'Median', sd: 'Standard deviation', 'diff-mean': 'Difference in means', 'diff-median': 'Difference in medians', pearson: 'Pearson r', spearman: 'Spearman ρ', 'paired-mean': 'Mean paired difference' };
  let shownKind = '', figs: Figure[] = [], report: Section[] = [], csvRows: (string | number)[][] = [], last: { boot: BootResult; perm: PermResult | null } | null = null;
  const trim = (t: string) => (/[.]/.test(t) && !/×/.test(t) ? t.replace(/0+$/, '').replace(/[.]$/, '') : t);
  const f4 = (x: number) => (Number.isFinite(x) ? trim(sig(x, 4)) : '–');
  const ci = (c: [number, number]) => `${f4(c[0])} to ${f4(c[1])}`;
  const isNum = (c: string) => Number.isFinite(num(c));

  function read(kind: 'one' | 'two' | 'pairs') {
    const rows = parseTable(box.value);
    if (!rows.length) throw new Error('Paste your data first, or open a file.');
    const head = rows[0].some((c) => c !== '' && !isNum(c)), body = head ? rows.slice(1) : rows;
    if (!body.length) throw new Error('There are no numbers under the header row.');
    if (kind === 'pairs') {
      const x: number[] = [], y: number[] = []; let dropped = 0;
      body.forEach((r, i) => { if (r.length < 2 || r[0] === '' || r[1] === '') { dropped++; return; } if (!isNum(r[0]) || !isNum(r[1])) throw new Error(`Row ${i + 1} ("${r.join(', ')}") is not two numbers.`); x.push(num(r[0])); y.push(num(r[1])); });
      return { names: [head ? rows[0][0] || 'x' : 'x', head ? rows[0][1] || 'y' : 'y'], cols: [x, y], note: dropped ? `${dropped} incomplete row${dropped > 1 ? 's' : ''} left out.` : '' };
    }
    const long = kind === 'two' && body.every((r) => r.length >= 2) && body.some((r) => r[0] !== '' && !isNum(r[0])) && body.every((r) => r[1] === '' || isNum(r[1]));
    if (long) {
      const names: string[] = [], cols: number[][] = [];
      for (const r of body) { if (r[1] === '') continue; let i = names.indexOf(r[0]); if (i < 0) { names.push(r[0]); cols.push([]); i = names.length - 1; } cols[i].push(num(r[1])); }
      return { names, cols, note: 'Read as group name and value.' };
    }
    const width = Math.max(...body.map((r) => r.length)), names = Array.from({ length: width }, (_, j) => (head && rows[0][j]) || `Column ${j + 1}`), cols = names.map(() => [] as number[]);
    body.forEach((r, i) => r.forEach((c, j) => { if (c === '') return; if (!isNum(c)) throw new Error(`"${c}" in row ${i + 1} of ${names[j]} is not a number.`); cols[j].push(num(c)); }));
    const keep = cols.map((_, j) => j).filter((j) => cols[j].length);
    return { names: keep.map((j) => names[j]), cols: keep.map((j) => cols[j]), note: '' };
  }

  function histFig(v: Float64Array, marks: any[], xLabel: string, alt: string): Figure {
    let lo = Infinity, hi = -Infinity; for (const x of v) if (Number.isFinite(x)) { if (x < lo) lo = x; if (x > hi) hi = x; }
    for (const m of marks) if (Number.isFinite(m.at)) { lo = Math.min(lo, m.at); hi = Math.max(hi, m.at); }
    if (!(hi > lo)) { lo -= 0.5; hi += 0.5; }
    const bins = Math.max(10, Math.min(60, Math.round(Math.sqrt(v.length)))), h = histogram(v, bins, lo, hi);
    const xs: number[] = [lo], ys: number[] = [0];
    h.counts.forEach((c, i) => { const a = lo + i * h.width; xs.push(a, a + h.width); ys.push(c, c); });
    xs.push(hi); ys.push(0);
    return chartFigure({ h: 300, xLabel, yLabel: 'Count', yMin: 0, legend: 'none', series: [{ name: 'Resamples', x: xs, y: ys, mode: 'line' }], marks }, alt);
  }

  function calc() {
    const s = q<HTMLSelectElement>('.bp-stat').value as Stat, kind = STAT_KIND[s];
    if (kind !== shownKind && (box.value.trim() === '' || Object.values(EX).includes(box.value))) box.value = EX[kind];
    shownKind = kind;
    q('.bp-how').textContent = HOW[kind];
    q('.bp-altl').hidden = kind === 'one';
    const err = q('.bp-err');
    try {
      const B = num(q<HTMLInputElement>('.bp-b').value), seed = num(q<HTMLInputElement>('.bp-seed').value), conf = Number(q<HTMLSelectElement>('.bp-conf').value);
      if (!(Number.isInteger(B) && B >= 100 && B <= 200000)) throw new Error('Resamples must be a whole number from 100 to 200,000.');
      if (!(Number.isInteger(seed) && seed >= 0 && seed < 2 ** 32)) throw new Error('The seed must be a whole number from 0 to 4,294,967,295.');
      const d = read(kind);
      if (kind !== 'one' && d.cols.length < 2) throw new Error(kind === 'two' ? 'Paste two groups: two columns, or group names next to the values.' : 'Paste two columns: x and y.');
      const [x, y] = d.cols, [A, Bn] = d.names;
      const boot = bootstrap(s, x, kind === 'one' ? undefined : y, B, conf, seed);
      const altV = q<HTMLSelectElement>('.bp-alt').value;
      const perm = kind !== 'one' && altV !== 'off' ? permutation(s, x, y, B, altV as Alt, seed) : null;
      last = { boot, perm };
      const pc = `${Math.round(conf * 100)} %`;
      const what = kind === 'one' ? `${NAME[s]} of ${A}` : kind === 'two' ? `${NAME[s]} (${A} − ${Bn})` : s === 'paired-mean' ? `Mean of ${A} − ${Bn}` : `${NAME[s]} of ${A} and ${Bn}`;
      q('.bp-h').textContent = what;
      q('.bp-big').textContent = `${f4(boot.est)}, ${pc} BCa CI ${ci(boot.bca)}`;
      const say = [`Resampling your data ${B.toLocaleString('en')} times (with replacement${kind === 'two' ? ', each group on its own' : kind === 'pairs' ? ', keeping pairs together' : ''}) gives a ${pc} confidence interval of ${ci(boot.bca)} by the BCa method, or ${ci(boot.percentile)} by the simple percentile method. BCa corrects for bias and skew and is usually the better choice.`];
      if (Math.abs(boot.bias) > 0.25 * boot.se) say.push(`The bootstrap estimates are biased by ${f4(boot.bias)} (a quarter of the standard error or more), so the BCa interval is the one to use.`);
      if (x.length < 10 || (kind === 'two' && y.length < 10)) say.push('With fewer than 10 values in a sample, bootstrap intervals tend to be too narrow; treat them as rough.');
      if (s === 'median' || s === 'diff-median') say.push('Medians of small samples jump between a few values, so the resampled values cluster and the interval edges sit on data values.');
      if (boot.degenerate) say.push(`${boot.degenerate} resamples had no answer (for example no spread for a correlation) and were left out.`);
      if (d.note) say.push(d.note);
      if (perm) {
        const a = 0.05, noun = kind === 'two' ? `the groups differ` : s === 'paired-mean' ? 'the paired values differ' : 'the two variables are related';
        say.push(`The permutation test asks how often ${perm.kind === 'group labels shuffled' ? 'randomly reshuffling the group labels' : perm.kind === 'y values shuffled against x' ? 'randomly re-pairing x with y' : 'randomly flipping the sign of each difference'} gives a result at least this extreme: p = ${f4(perm.p)}${perm.exact ? ' (exact, every arrangement tried)' : ''}. ${perm.p < a ? `That is below 0.05, so the data give evidence that ${noun}.` : `That is not below 0.05, so the data do not give clear evidence that ${noun}.`}`);
      }
      q('.bp-say').replaceChildren(...say.map((t) => { const p = document.createElement('p'); p.textContent = t; return p; }));
      const facts: [string, string][] = [['Estimate', f4(boot.est)], [`${pc} BCa interval`, ci(boot.bca)], [`${pc} percentile interval`, ci(boot.percentile)], ['Bootstrap standard error', f4(boot.se)], ['Bias (bootstrap mean − estimate)', f4(boot.bias)], ['BCa bias correction z₀', f4(boot.z0)], ['BCa acceleration a', f4(boot.a)], ['Resamples, seed', `${B.toLocaleString('en')}, ${seed}`], ['Sample size', kind === 'two' ? `${x.length} and ${y.length}` : String(x.length)]];
      const dl = (el: HTMLElement, list: [string, string][]) => el.replaceChildren(...list.map(([k, v]) => { const dv = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd'); dt.textContent = k; dd.textContent = v; dv.append(dt, dd); return dv; }));
      dl(q('.bp-facts'), facts);
      const f1 = histFig(boot.dist, [{ kind: 'vline', at: boot.est, label: 'estimate' }, { kind: 'vline', at: boot.bca[0], dash: [5, 4], label: 'BCa' }, { kind: 'vline', at: boot.bca[1], dash: [5, 4] }], NAME[s], `Bootstrap distribution of the ${NAME[s].toLowerCase()} with the BCa interval`);
      figs = [f1];
      paint(q<HTMLCanvasElement>('.bp-fig'), f1);
      let pfacts: [string, string][] = [];
      q('.bp-perm').hidden = !perm;
      if (perm) {
        pfacts = [['p-value', f4(perm.p)], ['Alternative', altV], ['Arrangements', `${perm.count.toLocaleString('en')} ${perm.exact ? '(all of them: exact)' : 'random (Monte Carlo)'}`], ['What is shuffled', perm.kind]];
        dl(q('.bp-pfacts'), pfacts);
        const marks: any[] = [{ kind: 'vline', at: perm.est, label: 'observed' }];
        if (altV === 'two-sided' && s !== 'pearson' && s !== 'spearman' && perm.est !== 0) marks.push({ kind: 'vline', at: -perm.est, dash: [5, 4] });
        const f2 = histFig(perm.null, marks, `${NAME[s]} if there were no effect`, 'Permutation (null) distribution with the observed value');
        figs.push(f2); paint(q<HTMLCanvasElement>('.bp-pfig'), f2);
      }
      err.hidden = true; q('.bp-out').hidden = false;
      report = [{ title: what, text: [q('.bp-big').textContent ?? '', ...say], facts, figure: f1 }];
      if (perm) report.push({ title: 'Permutation test', facts: pfacts, figure: figs[1] });
      csvRows = [['quantity', 'value'], ['statistic', what], ...facts.map(([k, v]) => [k, v]), ...pfacts.map(([k, v]) => [`permutation ${k}`, v])];
    } catch (e) { err.textContent = (e as Error).message; err.hidden = false; q('.bp-out').hidden = true; report = []; csvRows = []; last = null; }
  }

  let t = 0;
  root.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(calc, 400); });
  root.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('select')) calc(); });
  q('.bp-new').addEventListener('click', () => { const a = new Uint32Array(1); crypto.getRandomValues(a); q<HTMLInputElement>('.bp-seed').value = String(a[0] % 1000000); calc(); });
  document.addEventListener('fibub:theme', () => { if (figs[0]) paint(q<HTMLCanvasElement>('.bp-fig'), figs[0]); if (figs[1]) paint(q<HTMLCanvasElement>('.bp-pfig'), figs[1]); });
  q('.bp-csv').addEventListener('click', () => { if (csvRows.length) save(new TextEncoder().encode(csv(csvRows)), 'bootstrap-results.csv', 'text/csv'); });
  q('.bp-dcsv').addEventListener('click', () => {
    if (!last) return;
    const n = Math.max(last.boot.dist.length, last.perm?.null.length ?? 0), rows: (string | number)[][] = [last.perm ? ['bootstrap', 'permutation_null'] : ['bootstrap']];
    for (let i = 0; i < n; i++) rows.push(last.perm ? [last.boot.dist[i] ?? '', last.perm.null[i] ?? ''] : [last.boot.dist[i]]);
    save(new TextEncoder().encode(csv(rows)), 'resampled-values.csv', 'text/csv');
  });
  wireDownloads(q('.dl'), () => ({ title: 'Bootstrap and permutation test', subtitle: q('.bp-big').textContent ?? '', file: 'bootstrap', sections: report }));
  calc();
</script>
