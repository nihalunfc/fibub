---
// #T901 Engine CC
---
<div class="tool-ui ec">
  <section class="panel">
    <div class="ec-grid">
      <label>Bore, cylinder width <input data-k="bore" inputmode="decimal" value="57" /></label>
      <label>Stroke, piston travel <input data-k="stroke" inputmode="decimal" value="58.6" /></label>
      <label>Unit for bore and stroke <select data-k="unit"><option value="mm">millimetres</option><option value="in">inches</option></select></label>
      <label>Cylinders <input data-k="cyl" inputmode="numeric" value="1" /></label>
      <label>Combustion chamber volume (cc, one cylinder, optional) <input data-k="ch" inputmode="decimal" value="" placeholder="e.g. 14.5" /></label>
    </div>
    <p class="ec-fine">Bore and stroke are on the engine's spec sheet. The combustion chamber volume is what is left above the piston at the top of its stroke (head, gasket and piston dish together); leave it empty if you only want the size.</p>
  </section>
  <section class="panel" aria-live="polite">
    <p class="ec-big"></p>
    <dl class="ec-rows"></dl>
    <p class="ec-warn" role="alert"></p>
  </section>
  <details class="panel ec-more">
    <summary>More options: overbore, find a bore or stroke, piston speed, power per litre, unit converter</summary>
    <h2 class="ec-h">Overbore or longer stroke: what if?</h2>
    <div class="ec-grid">
      <label>Extra bore (same unit as above) <input data-k="ob" inputmode="decimal" placeholder="e.g. 1" /></label>
      <label>Extra stroke (same unit as above) <input data-k="os" inputmode="decimal" placeholder="e.g. 2" /></label>
    </div>
    <p class="ec-line" data-o="what" aria-live="polite"></p>
    <h2 class="ec-h">Find the bore or stroke for a size</h2>
    <div class="ec-grid">
      <label>Wanted size (cc, whole engine) <input data-k="tcc" inputmode="decimal" placeholder="e.g. 650" /></label>
    </div>
    <p class="ec-line" data-o="find" aria-live="polite"></p>
    <h2 class="ec-h">Piston speed and power per litre</h2>
    <div class="ec-grid">
      <label>Engine speed (rpm) <input data-k="rpm" inputmode="decimal" placeholder="e.g. 8000" /></label>
      <label>Peak power <input data-k="pw" inputmode="decimal" placeholder="e.g. 12" /></label>
      <label>Power unit <select data-k="pu"><option value="kw">kW</option><option value="hp">hp (mechanical)</option><option value="ps">PS (metric hp)</option></select></label>
    </div>
    <p class="ec-line" data-o="mps" aria-live="polite"></p>
    <p class="ec-line" data-o="spec" aria-live="polite"></p>
    <h2 class="ec-h">Convert a size you know</h2>
    <div class="ec-grid">
      <label>Size <input data-k="cvv" inputmode="decimal" placeholder="e.g. 1.6" /></label>
      <label>Unit <select data-k="cvu"><option value="cc">cc</option><option value="l">litres</option><option value="cuin">cubic inches</option></select></label>
    </div>
    <p class="ec-line" data-o="conv" aria-live="polite"></p>
  </details>
  <p class="ec-fine">Displacement is the volume the pistons sweep: π / 4 x bore x bore x stroke x cylinders. Makers round the badge (a 149.5 cc engine is sold as "150 cc"). Tax and licence classes often depend on cc: check your own authority. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .ec { display: grid; gap: 14px; margin-bottom: 32px; }
  .ec .panel { padding: 16px; }
  .ec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 12px; }
  .ec label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .ec input, .ec select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .ec input:focus, .ec select:focus { border-color: var(--accent); outline: none; }
  .ec-big { font-size: 28px; font-weight: 700; margin: 0 0 10px; }
  .ec-rows { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; margin: 0; }
  .ec-rows dt { color: var(--muted); } .ec-rows dd { margin: 0; text-align: right; font-weight: 600; }
  .ec-warn { color: var(--bad); margin: 10px 0 0; } .ec-warn:empty { display: none; }
  .ec-more summary { cursor: pointer; font-weight: 600; }
  .ec-h { font-size: 16px; margin: 18px 0 8px; }
  .ec-line { margin: 8px 0 0; font-weight: 600; } .ec-line:empty { display: none; }
  .ec-fine { color: var(--muted); font-size: 13px; margin: 10px 0 0; }
</style>

<script>
  import { engine, meanPistonSpeed, specificOutput, ccFrom, strokeFor, boreFor, CC_PER_CUIN } from '../../lib/money/vehicle-physics';
  const root = document.querySelector('.ec') as HTMLElement;
  const q = (k: string) => root.querySelector(`[data-k="${k}"]`) as HTMLInputElement;
  const $ = (s: string) => root.querySelector(s) as HTMLElement;
  const num = (k: string) => parseFloat(q(k).value.replace(/,/g, ''));
  const f = (v: number, d = 1) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
  const calc = () => {
    const k = q('unit').value === 'in' ? 25.4 : 1;
    const bore = num('bore') * k, stroke = num('stroke') * k, cyl = Math.round(num('cyl'));
    if (!(bore > 0) || !(stroke > 0) || !(cyl >= 1 && cyl <= 16)) { $('.ec-big').textContent = ''; $('.ec-rows').innerHTML = ''; $('.ec-warn').textContent = 'Type a bore and stroke above 0 and 1 to 16 cylinders.'; return; }
    $('.ec-warn').textContent = '';
    const r = engine({ boreMm: bore, strokeMm: stroke, cyl, chamberCc: num('ch') });
    $('.ec-big').textContent = `${f(r.cc)} cc`;
    const shape = Math.abs(r.ratio - 1) < 0.02 ? 'square' : r.ratio > 1 ? 'over-square (short stroke, revs freely)' : 'under-square (long stroke, more low-down pull)';
    const line = (a: string, b: string) => `<dt>${a}</dt><dd>${b}</dd>`;
    $('.ec-rows').innerHTML = line('One cylinder', `${f(r.sweptEach)} cc`) + line('Total in litres', `${f(r.litres, 3)} L`) + line('Total in cubic inches', `${f(r.cuin)} cu in`) +
      line('Bore / stroke ratio', `${f(r.ratio, 2)}`) + line('Engine shape', shape) + (r.cr ? line('Compression ratio', `${f(r.cr)} : 1`) : '');
    const blank = (k: string) => q(k).value.trim() === '', uName = q('unit').value === 'in' ? 'in' : 'mm';
    const el = (n: string) => $(`[data-o="${n}"]`);
    // What if
    if (blank('ob') && blank('os')) el('what').textContent = '';
    else {
      const ob = blank('ob') ? 0 : num('ob') * k, os = blank('os') ? 0 : num('os') * k;
      if (!isFinite(ob) || !isFinite(os) || bore + ob <= 0 || stroke + os <= 0) el('what').textContent = 'Type extra bore and stroke numbers that keep both above 0.';
      else {
        const n = engine({ boreMm: bore + ob, strokeMm: stroke + os, cyl, chamberCc: num('ch') });
        el('what').textContent = `${f(n.cc)} cc (${n.cc >= r.cc ? '+' : '-'}${f(Math.abs(n.cc - r.cc))} cc, ${n.cc >= r.cc ? '+' : '-'}${f(Math.abs(n.cc / r.cc - 1) * 100)}%)` + (n.cr && r.cr ? `, compression ${f(n.cr)} : 1 if the chamber stays the same` : '');
      }
    }
    // Find bore / stroke
    if (blank('tcc')) el('find').textContent = '';
    else if (!(num('tcc') > 0)) el('find').textContent = 'Type a wanted size above 0 cc.';
    else {
      const t = num('tcc'), u = uName === 'in' ? 25.4 : 1, d = (v: number) => (uName === 'in' ? f(v / u, 3) + ' in' : f(v, 1) + ' mm');
      el('find').textContent = `With this bore you need a stroke of ${d(strokeFor(t, bore, cyl))}. With this stroke you need a bore of ${d(boreFor(t, stroke, cyl))}.`;
    }
    // Piston speed and power per litre
    const rpm = num('rpm'), pw = num('pw');
    el('mps').textContent = blank('rpm') ? '' : rpm > 0 ? `Mean piston speed: ${f(meanPistonSpeed(stroke, rpm), 1)} m/s at ${f(rpm, 0)} rpm (2 x stroke x rpm / 60).` : 'Type an engine speed above 0.';
    el('spec').textContent = blank('pw') ? '' : pw > 0 ? `Power per litre: ${f(specificOutput(pw, q('pu').value as 'kw' | 'hp' | 'ps', r.litres), 1)} kW/L (${f(specificOutput(pw, q('pu').value as 'kw' | 'hp' | 'ps', r.litres) * 1.34102209, 1)} hp/L).` : 'Type a power above 0.';
    // Convert
    const cv = num('cvv');
    el('conv').textContent = blank('cvv') ? '' : cv > 0 ? (() => { const c = ccFrom(cv, q('cvu').value as 'cc' | 'l' | 'cuin'); return `${f(c, 1)} cc = ${f(c / 1000, 3)} L = ${f(c / CC_PER_CUIN, 1)} cu in`; })() : 'Type a size above 0.';
  };
  root.addEventListener('input', calc); root.addEventListener('change', calc);
  calc();
</script>
