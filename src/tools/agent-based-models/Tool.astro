---
// Agent-based model playground: boids flocking, Schelling segregation and an SIR epidemic on a grid, with seeded
// runs, step and run controls and time-series charts. Everything runs in the browser.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax abm">
  <div class="ax-card">
    <h2>Model</h2>
    <div class="ax-grid">
      <label>Model <select class="ab-m">
        <option value="boids">Boids: flocking birds</option>
        <option value="schelling">Schelling: segregation</option>
        <option value="sir">SIR epidemic on a grid</option>
      </select></label>
      <label>Seed <input class="ab-seed" inputmode="numeric" value="1" /></label>
    </div>
    <p class="ax-help ab-help"></p>
    <div class="ax-grid ab-p" data-m="boids" style="margin-top:10px">
      <label>Boids <input class="ab-n" inputmode="numeric" value="150" /></label>
      <label>Vision radius <input class="ab-vis" inputmode="decimal" value="25" /></label>
      <label>Personal space <input class="ab-sep" inputmode="decimal" value="6" /></label>
      <label>Separation weight <input class="ab-ws" inputmode="decimal" value="0.05" /></label>
      <label>Alignment weight <input class="ab-wa" inputmode="decimal" value="0.08" /></label>
      <label>Cohesion weight <input class="ab-wc" inputmode="decimal" value="0.005" /></label>
      <label>Top speed <input class="ab-vmax" inputmode="decimal" value="3" /></label>
      <label>Lowest speed <input class="ab-vmin" inputmode="decimal" value="1" /></label>
      <label>Noise (radians a step) <input class="ab-noise" inputmode="decimal" value="0.05" /></label>
    </div>
    <div class="ax-grid ab-p" data-m="schelling" style="margin-top:10px" hidden>
      <label>Grid side (cells) <input class="ab-sw" inputmode="numeric" value="50" /></label>
      <label>Empty cells (%) <input class="ab-se" inputmode="decimal" value="10" /></label>
      <label>Group A share (%) <input class="ab-sa" inputmode="decimal" value="50" /></label>
      <label>Wants at least (% alike) <input class="ab-st" inputmode="decimal" value="40" /></label>
      <label class="ax-check" style="align-self:end"><input type="checkbox" class="ab-swrap" checked /> Wrap edges</label>
    </div>
    <div class="ax-grid ab-p" data-m="sir" style="margin-top:10px" hidden>
      <label>Grid side (cells) <input class="ab-iw" inputmode="numeric" value="80" /></label>
      <label>Infection chance β <input class="ab-ib" inputmode="decimal" value="0.25" /></label>
      <label>Recovery chance γ <input class="ab-ig" inputmode="decimal" value="0.1" /></label>
      <label>First infected <input class="ab-i0" inputmode="numeric" value="5" /></label>
      <label>Neighbours <select class="ab-inb"><option value="4">4 (up, down, left, right)</option><option value="8">8 (with diagonals)</option></select></label>
      <label class="ax-check" style="align-self:end"><input type="checkbox" class="ab-iwrap" checked /> Wrap edges</label>
    </div>
    <div class="ax-row" style="margin-top:12px">
      <button type="button" class="btn small ab-run">Run</button>
      <button type="button" class="btn secondary small ab-step">Step</button>
      <button type="button" class="btn secondary small ab-reset">Reset</button>
      <label style="display:flex;flex-direction:row;align-items:center;gap:6px">Speed <select class="ab-speed" style="width:auto"><option value="1">1 step a frame</option><option value="3" selected>3 steps</option><option value="10">10 steps</option></select></label>
    </div>
    <p class="ax-err ab-err" hidden></p>
  </div>

  <div class="ax-card ab-out">
    <h2>World</h2>
    <p class="ab-status" aria-live="polite"></p>
    <canvas class="ax-fig ab-world" style="max-width:520px;margin:0 auto"></canvas>
    <div class="ax-legend ab-legend"></div>
    <dl class="ax-facts ab-facts" style="margin-top:12px"></dl>
    <h3>Over time</h3>
    <canvas class="ax-fig ab-chart"></canvas>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small ab-csv">Download time series (CSV)</button></div>
    <Downloads />
  </div>
</div>

<style is:global>
  .abm h3 { margin: 20px 0 8px; font-size: 15px; }
  .abm .ab-status { margin: 0 0 8px; font-weight: 600; font-variant-numeric: tabular-nums; }
</style>

<script>
  import { schellingInit, schellingStep, schellingStats, sirInit, sirStep, sirCounts, boidsInit, boidsStep, boidsStats, type Schelling, type SIR, type Boids } from '../../lib/sci/abm';
  import { num, sig, csv } from '../../lib/sci/num';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, pagePalette, wireDownloads, save, type Figure, type Section, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.abm')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const v = (c: string) => num(q<HTMLInputElement>(c).value);
  const HELP: Record<string, string> = {
    boids: 'Each bird (boid) sees neighbours within its vision radius. It steers away from any closer than its personal space (separation), turns towards their average heading (alignment) and moves towards their centre (cohesion). Flocks appear from these three local rules. The world wraps round at the edges.',
    schelling: 'Two groups live on a grid. An agent is unhappy if fewer than the given share of its occupied neighbouring cells (out of 8) hold its own group. Each step, every unhappy agent moves to a random empty cell. Even mild preferences lead to strong separation.',
    sir: 'Every cell is a person: Susceptible, Infected or Recovered. Each step, an infected person infects each susceptible neighbour with chance β and then recovers with chance γ. Recovered people are immune.',
  };
  type Hist = { t: number[]; a: number[]; b: number[]; c: number[] };
  let model = 'boids', B: Boids | null = null, S: Schelling | null = null, I: SIR | null = null;
  let hist: Hist = { t: [], a: [], b: [], c: [] }, running = false, raf = 0, frame = 0, world: Figure | null = null, chart: Figure | null = null, done = '';

  const int = (c: string, lo: number, hi: number, name: string) => { const x = v(c); if (!(Number.isInteger(x) && x >= lo && x <= hi)) throw new Error(`${name} must be a whole number from ${lo} to ${hi}.`); return x; };
  const rangeV = (c: string, lo: number, hi: number, name: string) => { const x = v(c); if (!(x >= lo && x <= hi)) throw new Error(`${name} must be between ${lo} and ${hi}.`); return x; };

  function reset() {
    stop(); const err = q('.ab-err');
    model = q<HTMLSelectElement>('.ab-m').value;
    for (const el of root.querySelectorAll<HTMLElement>('.ab-p')) el.hidden = el.dataset.m !== model;
    q('.ab-help').textContent = HELP[model];
    B = S = I = null; hist = { t: [], a: [], b: [], c: [] }; done = '';
    try {
      const seed = int('.ab-seed', 0, 2 ** 31, 'The seed');
      if (model === 'boids') {
        const vmax = rangeV('.ab-vmax', 0.1, 50, 'The top speed'), vmin = rangeV('.ab-vmin', 0, vmax, 'The lowest speed');
        B = boidsInit({ n: int('.ab-n', 1, 600, 'The number of boids'), size: 300, vision: rangeV('.ab-vis', 0, 300, 'The vision radius'), separation: rangeV('.ab-sep', 0, 300, 'The personal space'), sepWeight: rangeV('.ab-ws', 0, 5, 'The separation weight'), alignWeight: rangeV('.ab-wa', 0, 1, 'The alignment weight'), cohWeight: rangeV('.ab-wc', 0, 1, 'The cohesion weight'), maxSpeed: vmax, minSpeed: vmin, noise: rangeV('.ab-noise', 0, Math.PI, 'The noise'), seed });
      } else if (model === 'schelling') {
        const w = int('.ab-sw', 5, 200, 'The grid side');
        S = schellingInit({ w, h: w, empty: rangeV('.ab-se', 1, 90, 'The empty share') / 100, shareA: rangeV('.ab-sa', 0, 100, 'The group A share') / 100, threshold: rangeV('.ab-st', 0, 100, 'The wanted share alike') / 100, wrap: q<HTMLInputElement>('.ab-swrap').checked, seed });
      } else {
        const w = int('.ab-iw', 5, 300, 'The grid side');
        I = sirInit({ w, h: w, beta: rangeV('.ab-ib', 0, 1, 'β'), gamma: rangeV('.ab-ig', 0, 1, 'γ'), initial: int('.ab-i0', 1, w * w, 'The number first infected'), moore: q<HTMLSelectElement>('.ab-inb').value === '8', wrap: q<HTMLInputElement>('.ab-iwrap').checked, seed });
      }
      err.hidden = true; q('.ab-out').hidden = false;
      record(); draw(true);
    } catch (e) { err.textContent = (e as Error).message; err.hidden = false; q('.ab-out').hidden = true; }
  }

  function time() { return B ? B.t : S ? S.t : I ? I.t : 0; }
  function record() {
    hist.t.push(time());
    if (B) { const s = boidsStats(B); hist.a.push(s.order); hist.b.push(s.nearest); }
    else if (S) { const s = schellingStats(S); hist.a.push(s.similar * 100); hist.b.push(s.unhappy * 100); }
    else if (I) { const c = sirCounts(I), n = I.grid.length; hist.a.push((c[0] / n) * 100); hist.b.push((c[1] / n) * 100); hist.c.push((c[2] / n) * 100); }
  }
  function step(): boolean {
    if (B) boidsStep(B);
    else if (S) { const m = schellingStep(S); if (m === 0) done = schellingStats(S).unhappy > 0 ? 'Stopped: no empty cell to move to.' : 'Stopped: everyone is happy.'; }
    else if (I) { sirStep(I); if (sirCounts(I)[1] === 0) done = 'Stopped: nobody is infected any more.'; }
    if (hist.t.length < 20000) record();
    return !done;
  }

  const sCol = (pal: Palette) => (pal.red ? pal.grid : pal.bg === '#ffffff' ? '#c9cdd3' : '#3a3f47');
  const hex = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  function worldFig(): Figure {
    const W = 520;
    return {
      w: W, h: W, alt: model === 'boids' ? `${B!.p.n} boids after ${B!.t} steps` : model === 'schelling' ? `Schelling grid after ${S!.t} steps` : `SIR grid after ${I!.t} steps`,
      draw: (ctx, w, h, pal: Palette) => {
        if (B) {
          const k = w / B.p.size; ctx.fillStyle = pal.ink;
          for (let i = 0; i < B.p.n; i++) {
            const a = Math.atan2(B.vy[i], B.vx[i]), x = B.x[i] * k, y = B.y[i] * k, c = Math.cos(a), s = Math.sin(a);
            ctx.beginPath(); ctx.moveTo(x + 7 * c, y + 7 * s); ctx.lineTo(x - 4 * c - 3.5 * s, y - 4 * s + 3.5 * c); ctx.lineTo(x - 4 * c + 3.5 * s, y - 4 * s - 3.5 * c); ctx.closePath(); ctx.fill();
          }
          ctx.strokeStyle = pal.line; ctx.strokeRect(0.5, 0.5, w - 1, h - 1);
          return;
        }
        const g = S ? S.grid : I!.grid, gw = S ? S.p.w : I!.p.w, gh = S ? S.p.h : I!.p.h;
        const cols = S ? [hex(pal.bg), hex(pal.accent), hex(pal.accent2)] : [hex(sCol(pal)), hex(pal.bad), hex(pal.red ? pal.muted : pal.good)];
        const off = document.createElement('canvas'); off.width = gw; off.height = gh;
        const oc = off.getContext('2d')!, img = oc.createImageData(gw, gh);
        for (let i = 0; i < g.length; i++) { const c = cols[g[i]]; img.data[4 * i] = c[0]; img.data[4 * i + 1] = c[1]; img.data[4 * i + 2] = c[2]; img.data[4 * i + 3] = 255; }
        oc.putImageData(img, 0, 0);
        ctx.imageSmoothingEnabled = false; ctx.drawImage(off, 0, 0, w, h);
        ctx.strokeStyle = pal.line; ctx.strokeRect(0.5, 0.5, w - 1, h - 1);
      },
    };
  }
  function chartFig(): Figure {
    if (model === 'boids') return chartFigure({ h: 260, xLabel: 'Step', yLabel: 'Polarisation', yMin: 0, yMax: 1, legend: 'none', series: [{ name: 'Polarisation', x: hist.t, y: hist.a, mode: 'line' }] }, 'Polarisation of the flock over time');
    if (model === 'schelling') return chartFigure({ h: 260, xLabel: 'Step', yLabel: '%', yMin: 0, yMax: 100, series: [{ name: 'Neighbours alike', x: hist.t, y: hist.a, mode: 'line' }, { name: 'Unhappy', x: hist.t, y: hist.b, mode: 'line' }] }, 'Share of alike neighbours and of unhappy agents over time');
    return chartFigure({ h: 260, xLabel: 'Step', yLabel: '% of people', yMin: 0, yMax: 100, series: [{ name: 'Susceptible', x: hist.t, y: hist.a, mode: 'line' }, { name: 'Infected', x: hist.t, y: hist.b, mode: 'line' }, { name: 'Recovered', x: hist.t, y: hist.c, mode: 'line' }] }, 'Susceptible, infected and recovered over time');
  }
  function legend(pal: Palette) {
    const items: [string, string][] = model === 'schelling' ? [['Group A', pal.accent], ['Group B', pal.accent2], ['Empty', pal.bg]] : model === 'sir' ? [['Susceptible', sCol(pal)], ['Infected', pal.bad], ['Recovered', pal.red ? pal.muted : pal.good]] : [];
    q('.ab-legend').replaceChildren(...items.map(([n, c]) => { const s = document.createElement('span'), i = document.createElement('i'); i.style.background = c; i.style.border = '1px solid var(--line)'; s.append(i, n); return s; }));
  }
  function draw(withChart: boolean) {
    const pal = pagePalette();
    world = worldFig(); paint(q<HTMLCanvasElement>('.ab-world'), world, pal); legend(pal);
    const t = time(), last = hist.a.length - 1;
    let facts: [string, string][] = [];
    if (B) facts = [['Polarisation', sig(hist.a[last], 3)], ['Nearest neighbour (mean)', sig(hist.b[last], 3)], ['Boids', String(B.p.n)]];
    else if (S) facts = [['Neighbours alike', `${sig(hist.a[last], 3)} %`], ['Unhappy', `${sig(hist.b[last], 3)} %`], ['Moved last step', String(S.moved)]];
    else if (I) { const c = sirCounts(I); facts = [['Susceptible', c[0].toLocaleString('en')], ['Infected', c[1].toLocaleString('en')], ['Recovered', c[2].toLocaleString('en')], ['Peak infected', `${sig(Math.max(...hist.b), 3)} %`]]; }
    q('.ab-facts').replaceChildren(...facts.map(([k, x]) => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = x; return d; }));
    q('.ab-status').textContent = `Step ${t}${done ? '. ' + done : running ? ', running' : ''}`;
    if (withChart) { chart = chartFig(); paint(q<HTMLCanvasElement>('.ab-chart'), chart, pal); }
  }
  function loop() {
    const n = Number(q<HTMLSelectElement>('.ab-speed').value);
    for (let k = 0; k < n; k++) if (!step()) { stop(); break; }
    frame++; draw(frame % 6 === 0 || !running);
    if (running) raf = requestAnimationFrame(loop);
  }
  function start() { if (running || done || !(B || S || I)) return; running = true; q('.ab-run').textContent = 'Pause'; raf = requestAnimationFrame(loop); }
  function stop() { running = false; cancelAnimationFrame(raf); q('.ab-run').textContent = 'Run'; if (B || S || I) draw(true); }

  q('.ab-run').addEventListener('click', () => (running ? stop() : start()));
  q('.ab-step').addEventListener('click', () => { if (running) stop(); if (!done && (B || S || I)) { step(); draw(true); } });
  q('.ab-reset').addEventListener('click', reset);
  q('.ab-m').addEventListener('change', reset);
  let tm = 0;
  for (const el of root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.ab-p input, .ab-p select, .ab-seed')) el.addEventListener(el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'input', () => { clearTimeout(tm); tm = window.setTimeout(reset, 300); });
  q('.ab-csv').addEventListener('click', () => {
    const head = model === 'boids' ? ['step', 'polarisation', 'mean nearest distance'] : model === 'schelling' ? ['step', 'neighbours alike %', 'unhappy %'] : ['step', 'susceptible %', 'infected %', 'recovered %'];
    const rows = hist.t.map((t, i) => [t, hist.a[i], hist.b[i], ...(model === 'sir' ? [hist.c[i]] : [])]);
    save(new Blob([csv([head, ...rows])], { type: 'text/csv' }), `${model}-seed-${q<HTMLInputElement>('.ab-seed').value}.csv`, 'text/csv');
  });
  document.addEventListener('fibub:theme', () => { if (B || S || I) draw(true); });
  reset();
  wireDownloads(q('.dl'), () => {
    const sections: Section[] = [{ title: q<HTMLSelectElement>('.ab-m').selectedOptions[0].textContent!, text: [HELP[model], `Seed ${q<HTMLInputElement>('.ab-seed').value}, step ${time()}.`], facts: [...q('.ab-facts').querySelectorAll('div')].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.textContent!]) as [string, string][], figure: world ?? undefined }];
    if (chart) sections.push({ title: 'Over time', figure: chartFig() });
    return { title: 'Agent-based model', subtitle: q('.ab-status').textContent ?? '', file: `abm-${model}`, sections };
  });
</script>
