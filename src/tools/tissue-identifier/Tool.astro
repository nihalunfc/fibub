---
// Tissue identifier: teaching drawings of 15 plant and animal tissues. Explore one and tap its numbered features,
// or play Identify: a drawing with no name and four choices. Muscle types compared in a table.
// Drawings are fibub's own diagrams, not micrographs. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
import '../../styles/learnquiz-d.css';
---
<div class="ax sm tz">
  <p class="ax-help">Simple teaching drawings. Real tissues under a microscope are stained, less tidy and come in many shades.</p>
  <div class="ax-card">
    <div class="ax-seg tz-mode" role="group" aria-label="Mode"><button type="button" data-m="explore" aria-pressed="true">Explore</button><button type="button" data-m="identify" aria-pressed="false">Identify</button></div>
    <div class="tz-pick" role="group" aria-label="Tissue">
      <p class="tz-gl">Plant</p><div class="tz-chips tz-plant"></div>
      <p class="tz-gl">Animal</p><div class="tz-chips tz-animal"></div>
    </div>
    <svg class="sm-fig tz-fig" viewBox="0 0 300 200" role="img" aria-label="Drawing of the tissue"></svg>
    <p class="sm-f tz-cap" aria-live="polite"></p>
    <div class="tz-id" hidden>
      <p class="tz-q">Which tissue is this?</p>
      <div class="tz-opts"></div>
      <p class="tz-fb" aria-live="polite"></p>
      <div class="ax-row"><button type="button" class="btn small tz-next">Next drawing</button><span class="ax-help tz-score" style="margin:0"></span></div>
    </div>
  </div>

  <div class="ax-card tz-about">
    <h2 class="tz-name"></h2>
    <p class="ax-help tz-type"></p>
    <ol class="tz-feats"></ol>
    <dl class="ax-facts"><div><dt>Where it is found</dt><dd class="tz-where"></dd></div><div><dt>What it does</dt><dd class="tz-job"></dd></div></dl>
  </div>

  <div class="ax-card">
    <h2>Muscle types compared</h2>
    <div class="ax-scroll"><table class="tz-mus"><tbody></tbody></table></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Compare parenchyma, collenchyma and sclerenchyma. What changes in the cell walls?</li>
      <li>Find the one muscle that has stripes and branches. Where in the body is it?</li>
      <li>Play Identify until you get five in a row. Which features did you look for first?</li>
      <li>Why do red blood cells have no nucleus, while the cells of a root tip have very large ones?</li>
    </ul>
  </div>

  <div class="ax-card tz-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<style is:inline>
  .tz .tz-mode { margin-bottom: 8px; }
  .tz .tz-gl { margin: 8px 0 4px; font-size: 13px; color: var(--muted); font-weight: 600; }
  .tz .tz-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .tz .tz-chips button, .tz .tz-opts button { min-height: 40px; padding: 6px 12px; font: inherit; font-size: 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--ink); cursor: pointer; }
  .tz .tz-chips button[aria-pressed=true] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .tz .tz-fig { margin-top: 10px; }
  .tz .tz-opts { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); }
  .tz .tz-opts button { border-radius: 10px; min-height: 44px; }
  .tz .tz-opts button.ok { background: var(--good-soft); border-color: var(--good); color: var(--good); font-weight: 700; }
  .tz .tz-opts button.no { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }
  .tz .tz-q { font-weight: 700; margin: 8px 0; }
  .tz .tz-fb { font-weight: 600; min-height: 1.2em; }
  .tz .tz-fb.ok { color: var(--good); } .tz .tz-fb.no { color: var(--bad); }
  .tz .tz-feats { padding-left: 1.4em; margin: 6px 0 12px; }
  .tz .tz-feats li { margin: 4px 0; }
  .tz .tz-feats button { font: inherit; text-align: left; background: none; border: 0; color: var(--ink); padding: 4px 0; cursor: pointer; text-decoration: underline dotted; }
  .tz .tz-feats li.on button { font-weight: 700; color: var(--accent); }
  .tz svg .tz-cell { fill: var(--surface); stroke: var(--ink); stroke-width: 1.4; }
  .tz svg .tz-dense { fill: var(--accent-soft); stroke: var(--ink); stroke-width: 1; }
  .tz svg .tz-vac { fill: var(--bg); stroke: var(--line); stroke-width: 1; }
  .tz svg .tz-nuc { fill: var(--accent); }
  .tz svg .tz-thick { fill: var(--ink); opacity: .75; }
  .tz svg .tz-scl { fill: var(--surface); stroke: var(--ink); stroke-width: 10; stroke-linejoin: round; }
  .tz svg .tz-lumen { fill: var(--bg); stroke: var(--ink); stroke-width: 1; }
  .tz svg .tz-tube { fill: var(--surface); stroke: var(--ink); stroke-width: 1.6; }
  .tz svg .tz-ring { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .tz svg .tz-spiral { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .tz svg .tz-pit, .tz svg .tz-pore { fill: var(--muted); }
  .tz svg .tz-plate { fill: var(--ink); opacity: .6; }
  .tz svg .tz-guard { fill: var(--good-soft); stroke: var(--good); stroke-width: 1.6; }
  .tz svg .tz-pore2 { fill: var(--ink); }
  .tz svg .tz-flat { fill: var(--warn-soft); stroke: var(--ink); stroke-width: 1.2; }
  .tz svg .tz-base { fill: var(--ink); opacity: .55; }
  .tz svg .tz-cilia { stroke: var(--ink); stroke-width: 1.2; }
  .tz svg .tz-plasma { fill: var(--warn-soft); opacity: .45; }
  .tz svg .tz-rbc { fill: var(--bad-soft); stroke: var(--bad); stroke-width: 1.4; }
  .tz svg .tz-rbc-c { fill: var(--surface); opacity: .7; }
  .tz svg .tz-wbc { fill: var(--surface); stroke: var(--ink); stroke-width: 1.4; }
  .tz svg .tz-plt { fill: var(--ink); }
  .tz svg .tz-matrix { fill: var(--warn-soft); opacity: .5; }
  .tz svg .tz-ringb { fill: none; stroke: var(--ink); stroke-width: 1; opacity: .6; }
  .tz svg .tz-canal { fill: var(--surface); stroke: var(--ink); stroke-width: 2; }
  .tz svg .tz-lac { fill: var(--ink); }
  .tz svg .tz-canl { stroke: var(--ink); stroke-width: .7; }
  .tz svg .tz-fibre { fill: var(--bad-soft); stroke: var(--ink); stroke-width: 1.3; }
  .tz svg .tz-band { fill: var(--bad); opacity: .35; }
  .tz svg .tz-band2 { fill: var(--bad); opacity: .18; }
  .tz svg .tz-disc { fill: var(--ink); }
  .tz svg .tz-soma { fill: var(--accent-soft); stroke: var(--ink); stroke-width: 1.6; }
  .tz svg .tz-dend { stroke: var(--ink); stroke-width: 4; stroke-linecap: round; fill: none; }
  .tz svg .tz-dend2 { stroke: var(--ink); stroke-width: 2; stroke-linecap: round; fill: none; }
  .tz svg .tz-axon { stroke: var(--ink); stroke-width: 3; fill: none; }
  .tz svg .tz-myel { fill: var(--surface); stroke: var(--ink); stroke-width: 1.2; }
  .tz svg .tz-mk circle { fill: var(--ink); stroke: var(--surface); stroke-width: 2; }
  .tz svg .tz-mk text { fill: var(--surface); font: 700 11px system-ui, sans-serif; }
  .tz svg .tz-mk.on circle { fill: var(--accent); }
  .tz svg .tz-mk { cursor: pointer; }
  .tz [hidden] { display: none !important; }
</style>

<script>
  import { TISSUES, MUSCLES, byId, choicesFor, rng, type Tissue } from '../../lib/sci/tissues';
  import { S } from '../../lib/smath-ui';
  import { mountQuiz, one, type QItem } from '../../lib/learnquiz-d';

  const root = document.querySelector<HTMLElement>('.tz')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.tz-fig');
  const seed = Number(new URLSearchParams(location.search).get('seed')) || 0;
  const rnd = rng(seed || (Date.now() & 0xffff) + 1);
  let mode = 'explore', cur = 'parenchyma', mark = -1, answered = false, right = 0, tries = 0, last = '';

  for (const t of TISSUES) {
    const b = document.createElement('button'); b.type = 'button'; b.textContent = t.name; b.dataset.t = t.id; b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', () => { cur = t.id; mark = -1; draw(); });
    q(t.group === 'plant' ? '.tz-plant' : '.tz-animal').append(b);
  }
  q('.tz-mus tbody').replaceChildren(...MUSCLES.map((row, i) => { const tr = document.createElement('tr'); row.forEach((c, j) => { const td = document.createElement(i === 0 || j === 0 ? 'th' : 'td'); td.textContent = c; tr.append(td); }); return tr; }));

  root.querySelectorAll<HTMLButtonElement>('.tz-mode button').forEach((b) => b.addEventListener('click', () => {
    mode = b.dataset.m!; root.querySelectorAll('.tz-mode button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    q('.tz-pick').hidden = mode !== 'explore'; q('.tz-id').hidden = mode !== 'identify';
    if (mode === 'identify') next(); else { mark = -1; draw(); }
  }));
  q('.tz-next').addEventListener('click', next);

  function picture(t: Tissue, withMarks: boolean) {
    fig.replaceChildren();
    for (const s of t.draw(rng(t.id.length * 977 + 3))) S(s.t, { ...s.a, class: s.c }, fig);
    if (!withMarks) return;
    t.features.forEach((f, i) => {
      const g = S('g', { class: 'tz-mk' + (i === mark ? ' on' : ''), tabindex: 0, role: 'button', 'aria-label': `Feature ${i + 1}` }, fig);
      S('circle', { cx: f.x, cy: f.y, r: 10 }, g); S('text', { x: f.x, y: f.y + 4, 'text-anchor': 'middle' }, g, String(i + 1));
      const go = () => { mark = i; draw(); };
      g.addEventListener('click', go); g.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); });
    });
  }

  function about(t: Tissue) {
    q('.tz-about').hidden = false;
    q('.tz-name').textContent = t.name; q('.tz-type').textContent = t.type;
    q('.tz-where').textContent = t.where; q('.tz-job').textContent = t.job;
    q('.tz-feats').replaceChildren(...t.features.map((f, i) => { const li = document.createElement('li'); if (i === mark) li.className = 'on'; const b = document.createElement('button'); b.type = 'button'; b.textContent = f.label; b.addEventListener('click', () => { mark = i; draw(); }); li.append(b); return li; }));
  }

  function draw() {
    const t = byId(cur);
    root.querySelectorAll<HTMLButtonElement>('.tz-chips button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.t === cur)));
    picture(t, mode === 'explore' || answered);
    if (mode === 'explore' || answered) about(t); else q('.tz-about').hidden = true;
    q('.tz-cap').textContent = mode === 'identify' && !answered ? 'Look at the cell shapes, walls and nuclei.' : mark >= 0 ? `${mark + 1}. ${t.features[mark].label}` : 'Tap a numbered dot to see what it shows.';
  }

  function next() {
    let id = cur; while (id === cur || id === last) id = TISSUES[Math.floor(rnd() * TISSUES.length)].id;
    last = cur; cur = id; answered = false; mark = -1;
    q('.tz-fb').textContent = ''; q('.tz-fb').className = 'tz-fb';
    q('.tz-opts').replaceChildren(...choicesFor(cur, rnd).map((cid) => {
      const b = document.createElement('button'); b.type = 'button'; b.textContent = byId(cid).name; b.dataset.t = cid;
      b.addEventListener('click', () => {
        if (answered) return;
        const ok = cid === cur; tries++; if (ok) right++;
        b.classList.add(ok ? 'ok' : 'no');
        if (!ok) q(`.tz-opts button[data-t="${cur}"]`).classList.add('ok');
        answered = true;
        const fb = q('.tz-fb'); fb.textContent = ok ? `Right: ${byId(cur).name}.` : `Not this time: it is ${byId(cur).name}. Its numbered features are now shown.`; fb.className = 'tz-fb ' + (ok ? 'ok' : 'no');
        q('.tz-score').textContent = `${right} of ${tries} right. Nothing is saved.`;
        draw();
      });
      return b;
    }));
    draw();
  }
  draw();

  const FACTS: [string, string][] = [
    ['walls thickened at the corners', 'collenchyma'], ['very thick, lignified walls and no living contents', 'sclerenchyma'], ['large vacuoles and spaces between thin-walled cells', 'parenchyma'],
    ['cells that keep dividing at root and shoot tips', 'meristem'], ['sieve plates', 'phloem'], ['hollow vessels with spiral thickening', 'xylem'], ['guard cells around a pore', 'epidermis'],
    ['flat cells fitting like tiles', 'squamous'], ['tall cells with cilia', 'columnar'], ['cells with no nucleus floating in plasma', 'blood'], ['rings around a central canal', 'bone'],
    ['stripes and many nuclei at the edge', 'skeletal'], ['spindle-shaped cells with no stripes', 'smooth'], ['branched striped fibres with intercalated discs', 'cardiac'], ['an axon and dendrites', 'neuron'],
  ];
  mountQuiz(q('.tz-quiz'), () => {
    const out: QItem[] = [], used = new Set<string>();
    while (out.length < 4) {
      const [f, id] = one(FACTS); if (used.has(id)) continue; used.add(id);
      const ch = choicesFor(id, Math.random);
      out.push({ q: `Which tissue has ${f}?`, ans: ch.indexOf(id), choices: ch.map((c) => byId(c).name), work: `${byId(id).name}: ${byId(id).job.charAt(0).toLowerCase() + byId(id).job.slice(1)}.` });
    }
    return out;
  });
</script>
