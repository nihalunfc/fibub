---
// #1769 Case converter. Maths in src/lib/docs/textutil.ts.
const KINDS: [string, string][] = [['upper', 'UPPER CASE'], ['lower', 'lower case'], ['title', 'Title Case'], ['sentence', 'Sentence case'], ['camel', 'camelCase'], ['pascal', 'PascalCase'], ['snake', 'snake_case'], ['constant', 'CONSTANT_CASE'], ['kebab', 'kebab-case'], ['alternate', 'aLtErNaTe']];
---
<div class="tool-ui cvc">
  <div class="cvc-card">
    <label>Your text
      <textarea class="cvc-in" placeholder="Type or paste your text here"></textarea>
    </label>
    <div class="cvc-row" role="group" aria-label="Choose a case">
      {KINDS.map(([k, n]) => <button type="button" class="btn cvc-b" data-k={k}>{n}</button>)}
    </div>
    <p class="cvc-hint">Press a case to see the result below. Your own text is not changed until you press "Use result as my text".</p>
  </div>
  <div class="cvc-card">
    <h2>Result</h2>
    <pre class="cvc-pre cvc-out" aria-live="polite">Choose a case above.</pre>
    <div class="cvc-row"><button type="button" class="btn cvc-copy">Copy the result</button><button type="button" class="btn cvc-use">Use result as my text</button></div>
  </div>
</div>
<style is:inline>
  .cvc { display: grid; gap: 14px; margin-bottom: 28px; }
  .cvc-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; display: grid; gap: 10px; min-width: 0; }
  .cvc-card h2 { margin: 0; font-size: 18px; }
  .cvc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); min-width: 0; }
  .cvc textarea, .cvc input[type=text], .cvc input[type=number], .cvc select { font: inherit; font-size: 16px; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .cvc textarea { min-height: 180px; resize: vertical; }
  .cvc .cvc-chk { display: flex; align-items: flex-start; gap: 8px; color: var(--ink); }
  .cvc .cvc-chk input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--accent); flex: none; }
  .cvc .cvc-chk small { display: block; color: var(--muted); font-size: 13px; }
  .cvc-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .cvc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cvc-hint { margin: 0; font-size: 13px; color: var(--muted); }
  .cvc .btn { justify-self: start; }
  .cvc mark { background: color-mix(in srgb, var(--bad) 25%, transparent); color: inherit; border-radius: 3px; }
  .cvc-pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; padding: 10px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); max-height: 320px; overflow: auto; }
  @media (max-width: 480px) { .cvc-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { convertCase, type CaseKind } from '../../lib/docs/textutil';
  const root = document.querySelector('.cvc') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const inp = q<HTMLTextAreaElement>('.cvc-in'), out = q('.cvc-out');
  let kind: CaseKind | '' = '';
  const show = () => {
    out.textContent = kind ? convertCase(inp.value, kind) : 'Choose a case above.';
    root.querySelectorAll('.cvc-b').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.k === kind)));
  };
  root.querySelectorAll('.cvc-b').forEach((b) => b.addEventListener('click', () => { kind = (b as HTMLElement).dataset.k as CaseKind; show(); }));
  inp.addEventListener('input', show);
  const copy = q<HTMLButtonElement>('.cvc-copy');
  copy.addEventListener('click', async () => { try { await navigator.clipboard.writeText(out.textContent || ''); copy.textContent = 'Copied'; } catch { copy.textContent = 'Press Ctrl+C to copy'; } setTimeout(() => (copy.textContent = 'Copy the result'), 1800); });
  q('.cvc-use').addEventListener('click', () => { if (kind) { inp.value = out.textContent || ''; show(); } });
</script>
