---
// lac operon: switch lactose and glucose on or off and see the repressor, RNA polymerase and the three genes;
// try the i⁻ and Oᶜ mutants and the CAP extension; then follow a culture as it uses glucose, then lactose.
import '../../styles/astro.css';
import '../../styles/chemquiz.css';
---
<div class="ax lo">
  <div class="ax-card">
    <div class="lo-sw">
      <button type="button" class="lo-t lo-lac" aria-pressed="false">Lactose: absent</button>
      <button type="button" class="lo-t lo-glu" aria-pressed="false">Glucose: absent</button>
    </div>
    <div class="ax-seg lo-mut" role="group" aria-label="Bacterium" style="margin-top:10px"><button type="button" data-m="none" aria-pressed="true">Normal</button><button type="button" data-m="i-" aria-pressed="false">i⁻ (no repressor)</button><button type="button" data-m="oc" aria-pressed="false">Oᶜ (bad operator)</button></div>
    <div class="ax-seg lo-lev" role="group" aria-label="Level" style="margin-top:8px"><button type="button" data-l="basic" aria-pressed="true">Class 12</button><button type="button" data-l="cap" aria-pressed="false">With CAP (extension)</button></div>
    <p class="ax-big lo-big" style="margin:12px 0 2px"></p>
    <p class="lo-sub" style="margin:0 0 6px"></p>
    <svg class="lo-svg" viewBox="0 0 320 190" role="img" aria-label="lac operon"></svg>
    <p class="ax-help">i: regulator gene (makes the repressor) · p: promoter (RNA polymerase binds) · o: operator (repressor binds) · z, y, a: the structural genes for β-galactosidase, permease and transacetylase. The true inducer is allolactose, made from lactose.</p>
  </div>

  <div class="ax-card">
    <h2>A culture over time</h2>
    <p class="ax-help" style="margin-top:0">Bacteria are given both sugars at the start. The bacterium type and level above apply here too.</p>
    <label class="lo-rl"><span>Glu.</span><input type="range" class="lo-g0" min="0" max="4" step="0.5" value="2" aria-label="Glucose at the start" /><output class="lo-og0"></output></label>
    <label class="lo-rl"><span>Lac.</span><input type="range" class="lo-l0" min="0" max="4" step="0.5" value="2" aria-label="Lactose at the start" /><output class="lo-ol0"></output></label>
    <svg class="lo-plot" viewBox="0 0 320 200" role="img" aria-label="Time course"></svg>
    <dl class="ax-facts lo-facts"></dl>
    <p class="ax-help">A teaching model with made-up rates: sugars in mM, enzyme in arbitrary units, time in minutes.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lx-try">
      <li>Lactose absent: where is the repressor? Add lactose. What happens to it?</li>
      <li>Pick the i⁻ bacterium. Why are the genes on even without lactose? Do the same for Oᶜ.</li>
      <li>Switch to "With CAP". Add lactose and glucose together. Why is the operon only weakly on?</li>
      <li>In the time course, when does the enzyme start rising? Why does it fall again later?</li>
    </ul>
  </div>

  <div class="ax-card cq">
    <h2>Check yourself</h2>
    <ol class="cq-list"></ol>
    <button type="button" class="btn secondary small cq-new">New questions</button>
  </div>
</div>

<style is:inline>
  .lo-sw { display: flex; flex-wrap: wrap; gap: 10px; }
  .lo-t { min-height: 48px; padding: 0 16px; font: 700 16px system-ui, sans-serif; border: 2px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .lo-t[aria-pressed=true] { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
  .lo-svg, .lo-plot { display: block; width: 100%; max-width: 460px; margin: 6px auto 8px; }
  .lo .dna { stroke: var(--ink); stroke-width: 3; }
  .lo .gene { fill: var(--surface); stroke: var(--ink); stroke-width: 1.6; }
  .lo .gene.on { fill: var(--accent); }
  .lo .rep { fill: var(--muted); stroke: var(--ink); stroke-width: 1.4; }
  .lo .ind { fill: var(--accent); stroke: var(--ink); stroke-width: 1; }
  .lo .pol { fill: var(--line); stroke: var(--ink); stroke-width: 1.4; }
  .lo .cap { fill: var(--surface); stroke: var(--accent); stroke-width: 2; }
  .lo .mrna { fill: none; stroke: var(--accent); stroke-width: 2.4; }
  .lo .blk { stroke: var(--bad); stroke-width: 3; }
  .lo .tx { fill: var(--muted); font: 11px system-ui, sans-serif; }
  .lo .tb { fill: var(--ink); font: 600 12px system-ui, sans-serif; }
  .lo .gl { fill: var(--ink); font: 700 13px system-ui, sans-serif; }
  .lo-rl { display: grid !important; grid-template-columns: 34px 1fr 70px; align-items: center; gap: 10px !important; margin-top: 10px; color: var(--ink) !important; }
  .lo-rl input { height: 36px; accent-color: var(--accent); }
  .lo-rl output { font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; font-size: 14px; }
  .lo .axl { fill: none; stroke: var(--muted); stroke-width: 1; }
  .lo .cg { fill: none; stroke: var(--muted); stroke-width: 2; stroke-dasharray: 6 4; }
  .lo .cl { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .lo .ce { fill: none; stroke: var(--accent); stroke-width: 2.8; }
</style>

<script>
  import { simulate, state, timeBelow, type Level, type Mutant } from '../../lib/sci/lacoperon';
  import { mountQuiz, same, pickOne, type Question } from '../../lib/chemquiz';

  const root = document.querySelector<HTMLElement>('.lo')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as T;
  const NS = 'http://www.w3.org/2000/svg';
  const sv = (tag: string, attrs: Record<string, string | number>, text?: string) => { const n = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v)); if (text != null) n.textContent = text; return n; };
  let lac = false, glu = false, mutant: Mutant = 'none', level: Level = 'basic';

  function diagram() {
    const s = state(lac, glu, mutant, level), on = s.expression !== 'off';
    const svg = q<SVGSVGElement>('.lo-svg'); svg.replaceChildren();
    const Y = 120;
    svg.append(sv('line', { x1: 6, y1: Y, x2: 314, y2: Y, class: 'dna' }));
    const box = (x: number, w: number, lab: string, cls = 'gene') => { svg.append(sv('rect', { x, y: Y - 12, width: w, height: 24, rx: 3, class: cls }), sv('text', { x: x + w / 2, y: Y + 5, class: 'gl', 'text-anchor': 'middle' }, lab)); };
    box(12, 30, 'i'); box(84, 30, 'p'); box(114, 26, 'o');
    for (const [x, w, l] of [[146, 56, 'z'], [202, 52, 'y'], [254, 52, 'a']] as const) box(x, w, l, `gene${on ? ' on' : ''}`);
    // RNA polymerase on the promoter
    svg.append(sv('ellipse', { cx: 99, cy: Y + 26, rx: 22, ry: 12, class: 'pol' }), sv('text', { x: 99, y: Y + 30, class: 'tx', 'text-anchor': 'middle' }, 'RNA pol'));
    if (s.cap) svg.append(sv('circle', { cx: 62, cy: Y + 26, r: 14, class: 'cap' }), sv('text', { x: 62, y: Y + 30, class: 'tx', 'text-anchor': 'middle' }, 'CAP'));
    // repressor
    if (!s.repressorMade) svg.append(sv('text', { x: 6, y: 40, class: 'tb' }, 'i⁻: no repressor is made'));
    else {
      svg.append(sv('path', { d: `M27 ${Y - 14} V70`, class: 'mrna', 'stroke-dasharray': '4 3' }));
      if (s.bound) { svg.append(sv('rect', { x: 108, y: Y - 44, width: 38, height: 30, rx: 10, class: 'rep' }), sv('text', { x: 127, y: Y - 25, class: 'tx', 'text-anchor': 'middle' }, 'rep.')); svg.append(sv('line', { x1: 114, y1: Y + 44, x2: 140, y2: Y + 60, class: 'blk' }), sv('line', { x1: 140, y1: Y + 44, x2: 114, y2: Y + 60, class: 'blk' })); }
      else {
        svg.append(sv('rect', { x: 12, y: 40, width: 38, height: 30, rx: 10, class: 'rep' }), sv('text', { x: 31, y: 59, class: 'tx', 'text-anchor': 'middle' }, 'rep.'));
        if (s.repressorActive) svg.append(sv('text', { x: 56, y: 50, class: 'tx' }, 'cannot hold the faulty operator'));
        else svg.append(sv('path', { d: 'M50 44 l12 -8 l0 16 Z', class: 'ind' }), sv('text', { x: 66, y: 50, class: 'tx' }, 'allolactose holds it off'));
      }
    }
    if (on) {
      const amp = s.expression === 'low' ? 2 : 5;
      let d = `M146 ${Y - 24}`; for (let x = 146; x < 306; x += 10) d += ` q5 ${-amp} 10 0`;
      svg.append(sv('path', { d, class: 'mrna' }), sv('text', { x: 146, y: Y - 34, class: 'tb' }, s.expression === 'low' ? 'a little mRNA' : 'mRNA → 3 enzymes'));
    } else svg.append(sv('text', { x: 150, y: Y - 34, class: 'tb' }, 'no mRNA: genes off'));
    svg.setAttribute('aria-label', `lac operon, genes ${s.expression}`);
    const big: Record<string, string> = { off: 'Genes switched off', on: 'Genes switched on', low: 'Genes on, but only weakly', high: 'Genes switched on strongly' };
    q('.lo-big').textContent = big[s.expression];
    q('.lo-sub').textContent = !s.repressorMade ? 'With no repressor, nothing blocks RNA polymerase: the genes are on whatever the sugars.'
      : mutant === 'oc' && !lac ? 'The repressor is active but cannot grip the altered operator, so RNA polymerase passes: the genes are always on.'
      : s.bound ? 'No lactose: the repressor sits on the operator and blocks RNA polymerase. The cell saves energy by not making enzymes it cannot use.'
      : level === 'cap' && glu ? 'Lactose lifts the repressor off, but glucose keeps cAMP low, so CAP cannot help RNA polymerase: the cell prefers glucose.'
      : 'Lactose (as allolactose) binds the repressor and changes its shape, so it falls off the operator. RNA polymerase copies z, y and a.';
    q<HTMLButtonElement>('.lo-lac').textContent = `Lactose: ${lac ? 'present' : 'absent'}`; q('.lo-lac').setAttribute('aria-pressed', String(lac));
    q<HTMLButtonElement>('.lo-glu').textContent = `Glucose: ${glu ? 'present' : 'absent'}`; q('.lo-glu').setAttribute('aria-pressed', String(glu));
    q('.lo-glu').hidden = level !== 'cap';
    root.querySelectorAll<HTMLButtonElement>('.lo-mut button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === mutant)));
    root.querySelectorAll<HTMLButtonElement>('.lo-lev button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.l === level)));
  }

  function course() {
    const G0 = Number(q<HTMLInputElement>('.lo-g0').value), L0 = Number(q<HTMLInputElement>('.lo-l0').value);
    q('.lo-og0').textContent = `${G0} mM`; q('.lo-ol0').textContent = `${L0} mM`;
    const r = simulate(G0, L0, mutant, level);
    const svg = q<SVGSVGElement>('.lo-plot'); svg.replaceChildren();
    const X0 = 30, X1 = 312, Y0 = 170, Y1 = 12, px = (t: number) => X0 + (t / 400) * (X1 - X0), py = (v: number) => Y0 - (Math.min(v, 4) / 4) * (Y0 - Y1);
    svg.append(sv('path', { d: `M${X0} ${Y1} V${Y0} H${X1}`, class: 'axl' }));
    for (const t of [0, 100, 200, 300, 400]) svg.append(sv('text', { x: px(t), y: Y0 + 14, class: 'tx', 'text-anchor': 'middle' }, String(t)));
    for (const v of [0, 2, 4]) svg.append(sv('text', { x: X0 - 4, y: py(v) + 4, class: 'tx', 'text-anchor': 'end' }, String(v)));
    const line = (ys: number[], cls: string) => svg.append(sv('polyline', { points: ys.filter((_, i) => i % 4 === 0).map((v, i) => `${px(r.t[i * 4]).toFixed(1)},${py(v).toFixed(1)}`).join(' '), class: cls }));
    line(r.glucose, 'cg'); line(r.lactose, 'cl'); line(r.enzyme, 'ce');
    svg.append(sv('text', { x: X1, y: Y0 + 28, class: 'tx', 'text-anchor': 'end' }, 'minutes'));
    svg.append(sv('text', { x: X0 + 6, y: 196, class: 'tx' }, '- - glucose   — lactose   — enzyme (coloured)'));
    const f = q('.lo-facts'); f.replaceChildren();
    const fact = (k: string, v: string) => { const d = document.createElement('div'); const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v; d.append(dt, dd); f.append(d); };
    const tg = G0 > 0 ? timeBelow(r.t, r.glucose, 0.05) : 0, tl = L0 > 0 ? timeBelow(r.t, r.lactose, 0.05) : 0;
    const peak = Math.max(...r.enzyme), tp = r.t[r.enzyme.indexOf(peak)];
    fact('Glucose used up', G0 === 0 ? 'none given' : Number.isNaN(tg) ? 'not yet' : `${Math.round(tg)} min`);
    fact('Lactose used up', L0 === 0 ? 'none given' : Number.isNaN(tl) ? 'not yet' : `${Math.round(tl)} min`);
    fact('Most enzyme', `${peak.toFixed(2)} at ${Math.round(tp)} min`);
    svg.setAttribute('aria-label', `Glucose, lactose and enzyme over 400 minutes; most enzyme ${peak.toFixed(2)}`);
  }

  const all = () => { diagram(); course(); };
  q('.lo-lac').addEventListener('click', () => { lac = !lac; diagram(); });
  q('.lo-glu').addEventListener('click', () => { glu = !glu; diagram(); });
  root.querySelectorAll<HTMLButtonElement>('.lo-mut button').forEach((b) => b.addEventListener('click', () => { mutant = b.dataset.m as Mutant; all(); }));
  root.querySelectorAll<HTMLButtonElement>('.lo-lev button').forEach((b) => b.addEventListener('click', () => { level = b.dataset.l as Level; all(); }));
  ['.lo-g0', '.lo-l0'].forEach((s) => q(s).addEventListener('input', course));
  all();

  mountQuiz(q('.cq'), (): Question[] => {
    const cases = ([[false, 'none'], [true, 'none'], [false, 'i-'], [false, 'oc'], [true, 'i-']] as const).map(([l, m]) => ({ l, m, on: state(l, false, m).expression !== 'off' }));
    const [c1, c2] = [...cases].sort(() => Math.random() - 0.5);
    const desc = (c: typeof c1) => `${c.m === 'none' ? 'A normal bacterium' : c.m === 'i-' ? 'An i⁻ bacterium (makes no repressor)' : 'An Oᶜ bacterium (operator the repressor cannot hold)'} with lactose ${c.l ? 'present' : 'absent'}`;
    const facts = [
      ['Which gene of the lac operon codes for the repressor? (one letter)', 'i', 'The regulator gene i makes the repressor protein.', ['i', 'i gene', 'lacI']],
      ['Which enzyme, made by gene z, splits lactose into glucose and galactose?', 'beta-galactosidase', 'Gene z codes for β-galactosidase.', ['beta-galactosidase', 'β-galactosidase', 'beta galactosidase', 'betagalactosidase']],
      ['What does the repressor bind to on the DNA to stop transcription?', 'operator', 'It sits on the operator, next to the promoter, and blocks RNA polymerase.', ['operator', 'the operator', 'o']],
      ['Which enzyme, made by gene y, lets lactose into the cell?', 'permease', 'Gene y codes for permease, which carries lactose across the membrane.', ['permease', 'beta-galactoside permease']],
      ['What is the real inducer of the lac operon, made from lactose?', 'allolactose', 'Allolactose binds the repressor and makes it let go of the operator.', ['allolactose']],
    ] as const;
    const fs = [...facts].sort(() => Math.random() - 0.5).slice(0, 3);
    return [
      { q: `${desc(c1)}: are the lac genes on or off?`, hint: 'on or off', answer: c1.on ? 'on' : 'off', ok: same(c1.on ? 'on' : 'off'), worked: c1.m === 'i-' ? 'No repressor is made, so nothing blocks transcription.' : c1.m === 'oc' ? 'The repressor cannot bind the altered operator.' : c1.l ? 'Lactose (allolactose) lifts the repressor off the operator.' : 'The repressor sits on the operator.' },
      { q: `${desc(c2)}: are the lac genes on or off?`, hint: 'on or off', answer: c2.on ? 'on' : 'off', ok: same(c2.on ? 'on' : 'off'), worked: c2.m === 'i-' ? 'No repressor is made, so nothing blocks transcription.' : c2.m === 'oc' ? 'The repressor cannot bind the altered operator.' : c2.l ? 'Lactose (allolactose) lifts the repressor off the operator.' : 'The repressor sits on the operator.' },
      ...fs.map(([qq, a, w, alts]) => ({ q: qq, hint: 'a word', answer: a, ok: same(...alts), worked: w })),
    ];
  });
</script>
