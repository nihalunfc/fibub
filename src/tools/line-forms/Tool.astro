---
// Line forms (Learn, Class 11 straight lines): drag two points and every form of the line's equation updates
// together; add a second line and a point for the angle between lines and the perpendicular distance.
// Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm lf">
  <div class="ax-card lf-solve">
    <h2>Find the equation of my line</h2>
    <p class="ax-help">Type what your question gives (decimals and fractions like 3/2 are fine). You get the equation in every form, with the working.</p>
    <div class="ax-grid">
      <label>I know <select data-k="mode" class="lf-mode">
        <option value="two">Two points on the line</option>
        <option value="ps">A point and the slope</option>
        <option value="si">The slope and the y-intercept</option>
        <option value="ic">The x-intercept and y-intercept</option>
        <option value="par">A point, and a parallel line Ax + By + C = 0</option>
        <option value="perp">A point, and a perpendicular line Ax + By + C = 0</option>
        <option value="gen">The equation Ax + By + C = 0 (show every form)</option>
      </select></label>
      <label>Or start from an example <select data-k="preset" class="lf-pre"><option value="">My own numbers</option></select></label>
    </div>
    <div class="lf-in">
      <div class="lf-pair" data-need="two ps par perp"><b class="lf-p1l">Point 1</b><input data-k="x1" inputmode="decimal" value="2" aria-label="x of point 1" /><input data-k="y1" inputmode="decimal" value="3" aria-label="y of point 1" /></div>
      <div class="lf-pair" data-need="two"><b>Point 2</b><input data-k="x2" inputmode="decimal" value="6" aria-label="x of point 2" /><input data-k="y2" inputmode="decimal" value="11" aria-label="y of point 2" /></div>
      <label data-need="ps si"><span>Slope m</span><input data-k="m" inputmode="decimal" value="2" /></label>
      <label data-need="si"><span>y-intercept c</span><input data-k="c" inputmode="decimal" value="-1" /></label>
      <div class="lf-pair" data-need="ic"><b>Intercepts</b><input data-k="ia" inputmode="decimal" value="3" aria-label="x-intercept" /><input data-k="ib" inputmode="decimal" value="-4" aria-label="y-intercept" /></div>
      <div class="lf-abc" data-need="par perp gen"><b class="lf-abcl">Line</b><input data-k="A" inputmode="decimal" value="3" aria-label="A" /><input data-k="B" inputmode="decimal" value="-4" aria-label="B" /><input data-k="C" inputmode="decimal" value="12" aria-label="C" /></div>
    </div>
    <p class="ax-err lf-serr" hidden></p>
    <p class="ax-big lf-ans" aria-live="polite"></p>
    <ol class="sm-steps lf-work"></ol>
    <dl class="lf-srows"></dl>
    <p class="ax-help lf-tip"></p>
    <details class="lf-opt">
      <summary>More options: distance from a point, angle with another line</summary>
      <div class="lf-in" style="margin-top:8px">
        <div class="lf-pair"><b>Point P</b><input data-k="qx" inputmode="decimal" placeholder="x" aria-label="x of P" /><input data-k="qy" inputmode="decimal" placeholder="y" aria-label="y of P" /></div>
        <div class="lf-abc"><b>Other line</b><input data-k="A2" inputmode="decimal" placeholder="A" aria-label="A of the other line" /><input data-k="B2" inputmode="decimal" placeholder="B" aria-label="B of the other line" /><input data-k="C2" inputmode="decimal" placeholder="C" aria-label="C of the other line" /></div>
      </div>
      <p class="sm-f lf-sdist"></p>
      <p class="sm-f lf-sang"></p>
    </details>
  </div>

  <div class="ax-card">
    <h2>Drag the points</h2>
    <svg class="sm-fig lf-fig" viewBox="0 0 340 340" role="img" aria-label="Grid with the line through A and B, its intercepts, and optionally a second line and a point"></svg>
    <p class="ax-help">Drag A and B (and C, D and P when the extra part is on). Points snap to whole numbers.</p>
    <label class="ax-check"><input type="checkbox" class="lf-more" /> Add a second line CD and a point P: angle between lines and distance</label>
  </div>

  <div class="ax-card">
    <h2>The same line, every form</h2>
    <p class="sm-f lf-pts"></p>
    <dl class="lf-forms"></dl>
  </div>

  <div class="ax-card lf-extra" hidden>
    <h2>Angle and distance</h2>
    <p class="sm-f lf-l2"></p>
    <p class="sm-f lf-ang"></p>
    <p class="sm-f lf-meet"></p>
    <p class="sm-f lf-dist"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Put A and B one above the other. The slope is undefined, the line is x = constant, and slope-intercept form disappears.</li>
      <li>Drag B until the line passes through the origin. The intercept form no longer works: both intercepts are 0.</li>
      <li>Turn on the second line. Make CD parallel to AB (same slope), then perpendicular (slopes multiply to −1).</li>
      <li>Drag P onto the line AB: the distance becomes 0. Then move it away and compare the distance with the length of the dashed perpendicular.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Fractions like −3/4 are fine. Nothing is saved.</p>
    <div class="lf-quiz"></div>
  </div>
</div>

<style is:inline>
  .lf .lf-in { display: grid; gap: 8px; margin: 10px 0; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); }
  .lf .lf-pair, .lf .lf-abc { display: grid; grid-template-columns: 70px 1fr 1fr; gap: 8px; align-items: center; grid-column: 1 / -1; }
  .lf .lf-abc { grid-template-columns: 70px 1fr 1fr 1fr; }
  .lf .lf-in input { min-height: 44px; width: 100%; text-align: center; font-size: 17px; }
  .lf .lf-in label { display: grid; gap: 4px; }
  .lf .lf-ans { margin: 12px 0 6px; overflow-wrap: anywhere; }
  .lf .lf-work { padding-left: 22px; display: grid; gap: 6px; overflow-wrap: anywhere; }
  .lf .lf-opt summary { cursor: pointer; padding: 8px 0; font-weight: 600; }
  .lf .lf-forms, .lf .lf-srows { display: grid; gap: 8px; margin: 8px 0 0; }
  .lf .lf-forms div, .lf .lf-srows div { border-left: 3px solid var(--accent); padding: 2px 0 2px 10px; }
  .lf .lf-forms dt, .lf .lf-srows dt { font-size: 13px; color: var(--muted); }
  .lf .lf-forms dd, .lf .lf-srows dd { margin: 0; font-size: 17px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .lf svg .lf-l1 { stroke: var(--accent); stroke-width: 2.5; }
  .lf svg .lf-l2 { stroke: var(--warn); stroke-width: 2.5; }
  .lf svg .lf-int { fill: var(--good); }
  .lf svg .lf-p { fill: var(--bad); }
  .lf svg .lf-perp { stroke: var(--bad); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .lf svg .lf-handle2 { fill: var(--warn); stroke: var(--surface); stroke-width: 2; }
</style>

<script>
  import { through, slope, yIntercept, xIntercept, inclination, normalForm, angleBetween, parallel, perpendicular, distance, foot, meet, fromPointSlope, fromSlopeIntercept, fromIntercepts, parallelThrough, perpendicularThrough, tidy, lineRows, generalText, slopeInterceptText, type Pt, type Line } from '../../lib/sci/line-forms';
  import { fmt, randInt, fracText, gcd, readNum, numText } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.lf')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.lf-fig'), more = q<HTMLInputElement>('.lf-more');
  const pts: Record<string, Pt> = { A: [-4, -1], B: [2, 3], C: [-6, 6], D: [6, 0], P: [5, -5] };
  const W0 = -10, W1 = 10, L = 10, R = 330;
  const px = (x: number) => L + ((x - W0) / (W1 - W0)) * (R - L), py = (y: number) => R - ((y - W0) / (W1 - W0)) * (R - L);
  const ux = (p: number) => W0 + ((p - L) / (R - L)) * (W1 - W0), uy = (p: number) => W0 + ((R - p) / (R - L)) * (W1 - W0);
  const P2 = (p: Pt) => `(${fmt(p[0], 3)}, ${fmt(p[1], 3)})`;
  const neg = (s: string) => s.replace(/-/g, '−');
  /** "− 3" / "+ 3" pieces for x − x₁ style brackets. */
  const minus = (v: number) => (v === 0 ? '' : v < 0 ? ` + ${fmt(-v)}` : ` − ${fmt(v)}`);
  /** a x + b y + c = 0 as text. */
  function general(l: Line) {
    const t: string[] = [];
    const term = (k: number, v: string) => { if (!k) return; const s = Math.abs(k) === 1 && v ? v : fmt(Math.abs(k), 4) + v; t.push(t.length ? (k < 0 ? `− ${s}` : `+ ${s}`) : (k < 0 ? `−${s}` : s)); };
    term(l.a, 'x'); term(l.b, 'y'); term(l.c, '');
    return `${t.join(' ')} = 0`;
  }
  /** m x + c with fraction text. */
  function mxc(mn: number, md: number, cn: number, cd: number) {
    const m = fracText(mn, md), c = fracText(cn, cd);
    let s = m === '0' ? '' : m === '1' ? 'x' : m === '−1' ? '−x' : (m.includes('/') ? `(${m})x` : `${m}x`);
    if (c !== '0') s += s ? (c.startsWith('−') ? ` − ${c.slice(1)}` : ` + ${c}`) : c;
    return s || '0';
  }
  const lineEnds = (l: Line): [Pt, Pt] | null => {
    const P: Pt[] = [];
    if (l.b !== 0) for (const x of [W0, W1]) { const y = (-l.c - l.a * x) / l.b; if (y >= W0 - 1e-9 && y <= W1 + 1e-9) P.push([x, y]); }
    if (l.a !== 0) for (const y of [W0, W1]) { const x = (-l.c - l.b * y) / l.a; if (x >= W0 - 1e-9 && x <= W1 + 1e-9) P.push([x, y]); }
    if (P.length < 2) return null;
    let best: [Pt, Pt] = [P[0], P[1]], bd = 0;
    for (const a of P) for (const b of P) { const d = Math.hypot(a[0] - b[0], a[1] - b[1]); if (d > bd) { bd = d; best = [a, b]; } }
    return best;
  };
  const dot = (p: Pt, cls: string, lab: string, r = 5) => { S('circle', { cx: px(p[0]), cy: py(p[1]), r, class: cls }, fig); if (lab) S('text', { x: px(p[0]) + 8, y: py(p[1]) - 7, style: 'font-weight:700' }, fig, lab); };

  function draw() {
    const on = more.checked;
    q('.lf-extra').hidden = !on;
    fig.replaceChildren();
    for (let x = W0; x <= W1; x++) { S('line', { x1: px(x), x2: px(x), y1: L, y2: R, class: 'sm-grid', style: x % 5 ? 'opacity:.5' : '' }, fig); S('line', { x1: L, x2: R, y1: py(x), y2: py(x), class: 'sm-grid', style: x % 5 ? 'opacity:.5' : '' }, fig); }
    S('line', { x1: L, x2: R, y1: py(0), y2: py(0), class: 'sm-axis' }, fig); S('line', { x1: px(0), x2: px(0), y1: L, y2: R, class: 'sm-axis' }, fig);
    for (const v of [-5, 5]) { S('text', { x: px(v), y: py(0) + 14, 'text-anchor': 'middle', class: 'sm-tick' }, fig, fmt(v)); S('text', { x: px(0) - 4, y: py(v) + 4, 'text-anchor': 'end', class: 'sm-tick' }, fig, fmt(v)); }
    const { A, B, C, D, P } = pts, l1 = through(A, B), l2 = on ? through(C, D) : null;
    const seg = (l: Line | null, cls: string) => { const e = l && lineEnds(l); if (e) S('line', { x1: px(e[0][0]), y1: py(e[0][1]), x2: px(e[1][0]), y2: py(e[1][1]), class: cls }, fig); };
    seg(l1, 'lf-l1'); seg(l2, 'lf-l2');
    if (l1) {
      const xi = xIntercept(l1), yi = yIntercept(l1);
      if (Number.isFinite(xi) && Math.abs(xi) <= 10) dot([xi, 0], 'lf-int', '', 4.5);
      if (Number.isFinite(yi) && Math.abs(yi) <= 10) dot([0, yi], 'lf-int', '', 4.5);
    }
    if (on && l1) {
      const F = foot(l1, P);
      if (Math.abs(F[0]) <= 12 && Math.abs(F[1]) <= 12) { S('line', { x1: px(P[0]), y1: py(P[1]), x2: px(F[0]), y2: py(F[1]), class: 'lf-perp' }, fig); dot(F, 'lf-p', 'F', 3.5); }
      if (l2) { const M = meet(l1, l2); if (M && Math.abs(M[0]) <= 10 && Math.abs(M[1]) <= 10) dot(M, 'sm-handle', '', 4); }
    }
    const handles = on ? ['A', 'B', 'C', 'D', 'P'] : ['A', 'B'];
    for (const k of handles) {
      const p = pts[k];
      S('circle', { cx: px(p[0]), cy: py(p[1]), r: 20, class: 'sm-hit' }, fig);
      S('circle', { cx: px(p[0]), cy: py(p[1]), r: 9, class: (k === 'C' || k === 'D' ? 'lf-handle2' : k === 'P' ? 'lf-p' : 'sm-handle') + ` lf-h${k}` }, fig);
      S('text', { x: px(p[0]) - 12, y: py(p[1]) + 22, 'text-anchor': 'middle', style: 'font-weight:700' }, fig, k);
    }
    const [x1, y1] = A, [x2, y2] = B, dx = x2 - x1, dy = y2 - y1;
    q('.lf-pts').textContent = `A = ${P2(A)}, B = ${P2(B)}`;
    const box = q('.lf-forms'); box.replaceChildren();
    const row = (t: string, d: string, cls = '') => { const div = document.createElement('div'); if (cls) div.className = cls; const dt = document.createElement('dt'); dt.textContent = t; const dd = document.createElement('dd'); dd.textContent = neg(d); div.append(dt, dd); box.append(div); };
    if (!l1) { row('Two points the same', 'A and B are the same point, so they do not fix a line. Drag one away.', 'lf-same'); return extra(null); }
    const g = general(l1);
    if (dx === 0) {
      row('Slope', `x₂ − x₁ = 0, so the slope is undefined: the line is vertical (inclination 90°).`, 'lf-m');
      row('Equation', `x = ${fmt(x1)}`, 'lf-eq');
    } else {
      const m = fracText(dy, dx);
      row('Slope', `m = (y₂ − y₁)/(x₂ − x₁) = (${fmt(y2)} − ${fmt(y1)})/(${fmt(x2)} − ${fmt(x1)}) = ${fmt(dy)}/${fmt(dx)} = ${m}. Inclination θ = ${fmt(inclination(l1), 2)}° (tan θ = m).`.replace(/− -/g, '+ '), 'lf-m');
      row('Two-point form', `y − y₁ = [(y₂ − y₁)/(x₂ − x₁)](x − x₁): y${minus(y1)} = (${fmt(dy)}/${fmt(dx)})(x${minus(x1)})`, 'lf-2p');
      row('Point-slope form', `y − y₁ = m(x − x₁): y${minus(y1)} = ${m.includes('/') ? `(${m})` : m}(x${minus(x1)})`, 'lf-ps');
      row('Slope-intercept form', `y = mx + c: y = ${mxc(dy, dx, x2 * y1 - x1 * y2, dx)}`, 'lf-si');
    }
    const xi = xIntercept(l1), yi = yIntercept(l1);
    if (l1.c !== 0 && l1.a !== 0 && l1.b !== 0) { const wrap = (t: string) => (/[/−]/.test(t) ? `(${t})` : t); row('Intercept form', `x/a + y/b = 1: x/${wrap(fracText(-l1.c, l1.a))} + y/${wrap(fracText(-l1.c, l1.b))} = 1 (cuts the x axis at ${fmt(xi, 3)}, the y axis at ${fmt(yi, 3)})`, 'lf-ic'); }
    else row('Intercept form', l1.c === 0 ? 'The line passes through the origin, so both intercepts are 0 and there is no intercept form.' : l1.a === 0 ? `The line is horizontal: it never meets the x axis, so there is no intercept form. It cuts the y axis at ${fmt(yi, 3)}.` : `The line is vertical: it never meets the y axis, so there is no intercept form. It cuts the x axis at ${fmt(xi, 3)}.`, 'lf-ic');
    row('General form', `Ax + By + C = 0: ${g}  (A = ${fmt(l1.a)}, B = ${fmt(l1.b)}, C = ${fmt(l1.c)})`, 'lf-g');
    const nf = normalForm(l1);
    row('Normal form', `x cos ω + y sin ω = p: x cos ${fmt(nf.omega, 2)}° + y sin ${fmt(nf.omega, 2)}° = ${fmt(nf.p, 4)}  (p is the distance from the origin to the line)`, 'lf-nf');
    extra(l1);
  }

  function extra(l1: Line | null) {
    if (!more.checked) return;
    const { C, D, P } = pts, l2 = through(C, D);
    q('.lf-l2').textContent = l2 ? neg(`Line CD: ${general(l2)}, slope ${l2.b === 0 ? 'undefined (vertical)' : fracText(D[1] - C[1], D[0] - C[0])}.`) : 'C and D are the same point; drag one away.';
    if (!l1 || !l2) { q('.lf-ang').textContent = ''; q('.lf-meet').textContent = ''; } else {
      const th = angleBetween(l1, l2), m1 = slope(l1), m2 = slope(l2);
      const how = parallel(l1, l2) ? 'The lines are parallel (equal slopes): the angle between them is 0°.' : perpendicular(l1, l2) ? `The lines are perpendicular${Number.isFinite(m1) && Number.isFinite(m2) ? ` (m₁ m₂ = ${fmt(m1 * m2, 4)})` : ''}: the angle is 90°.` : Number.isFinite(m1) && Number.isFinite(m2) ? `tan θ = |(m₁ − m₂)/(1 + m₁m₂)| = |(${fmt(m1, 4)} − ${fmt(m2, 4)})/(1 + ${fmt(m1 * m2, 4)})| = ${fmt(Math.tan((th * Math.PI) / 180), 4)}, so θ = ${fmt(th, 2)}° (the other angle is ${fmt(180 - th, 2)}°).` : `One line is vertical, so θ = 90° − (inclination of the other) = ${fmt(th, 2)}°.`;
      q('.lf-ang').textContent = neg(how);
      const M = meet(l1, l2);
      q('.lf-meet').textContent = M ? `They meet at ${neg(P2(M))}.` : (distance(l1, C) < 1e-9 ? 'They are the same line.' : `Distance between the parallel lines: ${fmt(distance(l1, C), 4)}.`);
    }
    if (l1) {
      const v = l1.a * P[0] + l1.b * P[1] + l1.c, d = distance(l1, P), F = foot(l1, P);
      q('.lf-dist').textContent = neg(`Distance from P${P2(P)} to AB: |Ax₀ + By₀ + C|/√(A² + B²) = |${fmt(l1.a)}×${fmt(P[0])} + ${fmt(l1.b)}×${fmt(P[1])} + ${fmt(l1.c)}|/√(${fmt(l1.a * l1.a + l1.b * l1.b)}) = ${fmt(Math.abs(v))}/${fmt(Math.hypot(l1.a, l1.b), 4)} = ${fmt(d, 4)}. Foot of the perpendicular F = ${P2(F)}.${d === 0 ? ' P is on the line.' : ''}`);
    } else q('.lf-dist').textContent = '';
  }

  dragOn(fig, (x, y) => {
    let best: string | null = null, bd = 28;
    for (const k of more.checked ? ['A', 'B', 'C', 'D', 'P'] : ['A', 'B']) { const d = Math.hypot(x - px(pts[k][0]), y - py(pts[k][1])); if (d < bd) { bd = d; best = k; } }
    return best;
  }, (id, x, y) => { pts[id] = [Math.round(Math.max(W0, Math.min(W1, ux(x)))), Math.round(Math.max(W0, Math.min(W1, uy(y))))]; draw(); });
  more.addEventListener('change', draw);
  draw();

  // ---- Find the equation of my line: typed numbers, seven ways in, every form out. ----
  const lk = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  const lsel = (k: string) => q<HTMLSelectElement>(`[data-k="${k}"]`);
  const LF = ['x1', 'y1', 'x2', 'y2', 'm', 'c', 'ia', 'ib', 'A', 'B', 'C'];
  const PRE: { name: string; mode: string; v: Record<string, string> }[] = [
    { name: 'Through (2, 3) and (6, 11)', mode: 'two', v: { x1: '2', y1: '3', x2: '6', y2: '11' } },
    { name: 'Through (−1, 4) with slope 3/2', mode: 'ps', v: { x1: '-1', y1: '4', m: '3/2' } },
    { name: 'Slope −2 and y-intercept 5', mode: 'si', v: { m: '-2', c: '5' } },
    { name: 'Intercepts 3 and −4', mode: 'ic', v: { ia: '3', ib: '-4' } },
    { name: 'Through (2, 1), parallel to 3x − y + 4 = 0', mode: 'par', v: { x1: '2', y1: '1', A: '3', B: '-1', C: '4' } },
    { name: 'Through (2, 1), perpendicular to 3x − y + 4 = 0', mode: 'perp', v: { x1: '2', y1: '1', A: '3', B: '-1', C: '4' } },
    { name: 'Show every form of 3x − 4y + 12 = 0', mode: 'gen', v: { A: '3', B: '-4', C: '12' } },
  ];
  lsel('preset').append(...PRE.map((p, i) => new Option(p.name, String(i))));
  const nt = (x: number) => numText(x);
  const pr = (x: number) => (x < 0 || nt(x).includes('/') ? `(${nt(x)})` : nt(x));
  /** "x − 2" or "x + 1" for a variable v and a value n. */
  const sub = (v: string, n: number) => (n < 0 ? `${v} + ${nt(-n)}` : n === 0 ? v : `${v} − ${nt(n)}`);
  function solveLine() {
    const mode = lsel('mode').value;
    q('.lf-solve').querySelectorAll<HTMLElement>('[data-need]').forEach((e) => { e.hidden = !e.dataset.need!.split(' ').includes(mode); });
    q('.lf-p1l').textContent = mode === 'two' ? 'Point 1' : 'Point';
    q('.lf-abcl').textContent = mode === 'gen' ? 'Your line' : 'Given line';
    const v: Record<string, number> = {}; for (const k of LF) v[k] = readNum(lk(k).value);
    const err = q('.lf-serr'), ans = q('.lf-ans'), work = q('.lf-work'), rows = q('.lf-srows'), tip = q('.lf-tip');
    const stop = (m: string) => { err.textContent = m; err.hidden = !m; ans.textContent = ''; work.replaceChildren(); rows.replaceChildren(); tip.textContent = ''; q('.lf-sdist').textContent = ''; q('.lf-sang').textContent = ''; };
    const need: Record<string, string[]> = { two: ['x1', 'y1', 'x2', 'y2'], ps: ['x1', 'y1', 'm'], si: ['m', 'c'], ic: ['ia', 'ib'], par: ['x1', 'y1', 'A', 'B', 'C'], perp: ['x1', 'y1', 'A', 'B', 'C'], gen: ['A', 'B', 'C'] };
    const nm: Record<string, string> = { x1: 'x of the point', y1: 'y of the point', x2: 'x of point 2', y2: 'y of point 2', m: 'the slope m', c: 'the y-intercept c', ia: 'the x-intercept', ib: 'the y-intercept', A: 'A', B: 'B', C: 'C' };
    const bad = need[mode].find((k) => !Number.isFinite(v[k]));
    if (bad) return stop(`Type a number for ${nm[bad]} (a whole number, decimal or fraction like 3/2). Use 0 if it is zero.`);
    if (need[mode].some((k) => Math.abs(v[k]) > 1e9)) return stop('Please keep the numbers below a billion.');
    err.hidden = true;
    const P: Pt = [v.x1, v.y1], lines: string[] = [];
    let l: Line | null = null, mist = '';
    if (mode === 'two') {
      const Q: Pt = [v.x2, v.y2], dx = Q[0] - P[0], dy = Q[1] - P[1];
      if (dx === 0 && dy === 0) return stop('The two points are the same, so they do not fix a line. Change one of them.');
      l = through(P, Q) && tidy(through(P, Q)!);
      lines.push(`Slope m = (y₂ − y₁)/(x₂ − x₁) = (${pr(Q[1])} − ${pr(P[1])})/(${pr(Q[0])} − ${pr(P[0])}) = ${nt(dy)}/${nt(dx)}${dx === 0 ? ': division by 0, so the line is vertical' : ` = ${nt(dy / dx)}`}.`);
      lines.push(dx === 0 ? `Both points have x = ${nt(P[0])}, so the line is x = ${nt(P[0])}.` : `Point-slope form with point 1: ${sub('y', P[1])} = ${pr(dy / dx)}(${sub('x', P[0])}).`);
      mist = 'Subtract the coordinates in the same order on top and bottom: (y₂ − y₁)/(x₂ − x₁). Mixing the order flips the sign of the slope.';
    } else if (mode === 'ps') {
      l = fromPointSlope(P, v.m);
      lines.push(`Point-slope form: y − y₁ = m(x − x₁): ${sub('y', P[1])} = ${pr(v.m)}(${sub('x', P[0])}).`);
      lines.push(`Expand: y = ${pr(v.m)}x + (${pr(P[1])} − ${pr(v.m)}×${pr(P[0])}) = ${pr(v.m)}x + ${nt(P[1] - v.m * P[0])}.`);
      mist = 'x − x₁ means subtract the point’s x: through (−1, 4) it is (x + 1), not (x − 1).';
    } else if (mode === 'si') {
      l = fromSlopeIntercept(v.m, v.c);
      lines.push(`Slope-intercept form: y = mx + c = ${pr(v.m)}x + ${pr(v.c)}.`, 'Move everything to one side: mx − y + c = 0.');
      mist = 'c is where the line cuts the y axis (x = 0), and m is the rise for a run of 1.';
    } else if (mode === 'ic') {
      if (v.ia === 0 || v.ib === 0) return stop('Both intercepts must be above or below 0. (A line with an intercept of 0 passes through the origin, so the intercept form does not apply.)');
      l = fromIntercepts(v.ia, v.ib);
      lines.push(`Intercept form: x/a + y/b = 1: x/${pr(v.ia)} + y/${pr(v.ib)} = 1.`, `Multiply by a b = ${nt(v.ia * v.ib)}: ${nt(v.ib)}x + ${pr(v.ia)}y = ${nt(v.ia * v.ib)}.`);
      mist = 'The x-intercept is a (under x) and the y-intercept is b (under y). Keep their signs.';
    } else if (mode === 'par' || mode === 'perp') {
      if (v.A === 0 && v.B === 0) return stop('A and B cannot both be 0: that is not a line.');
      const g: Line = { a: v.A, b: v.B, c: v.C };
      l = mode === 'par' ? parallelThrough(g, P) : perpendicularThrough(g, P);
      lines.push(`The given line ${generalText({ a: v.A, b: v.B, c: v.C })} has ${v.B === 0 ? 'no slope (it is vertical)' : `slope −A/B = ${nt(-v.A / v.B)}`}.`);
      if (mode === 'par') lines.push('A parallel line has the same A and B and only the constant changes: Ax + By + k = 0.', `Put the point ${`(${nt(P[0])}, ${nt(P[1])})`} in: k = −(A x₁ + B y₁) = −(${pr(v.A)}×${pr(P[0])} + ${pr(v.B)}×${pr(P[1])}) = ${nt(-(v.A * P[0] + v.B * P[1]))}.`);
      else lines.push('A perpendicular line swaps A and B and changes one sign: Bx − Ay + k = 0 (the slopes multiply to −1).', `Put the point ${`(${nt(P[0])}, ${nt(P[1])})`} in: k = −(B x₁ − A y₁) = −(${pr(v.B)}×${pr(P[0])} − ${pr(v.A)}×${pr(P[1])}) = ${nt(-(v.B * P[0] - v.A * P[1]))}.`);
      mist = mode === 'par' ? 'The constant changes, not A and B. Check by putting the point back into your answer: it must give 0.' : 'Perpendicular means the slopes multiply to −1 (m₂ = −1/m₁). A vertical line is perpendicular to a horizontal one.';
    } else {
      if (v.A === 0 && v.B === 0) return stop('A and B cannot both be 0: that is not a line.');
      l = tidy({ a: v.A, b: v.B, c: v.C });
      lines.push(`The line ${generalText({ a: v.A, b: v.B, c: v.C })} written in every form is listed below.`);
      mist = 'To find the x-intercept put y = 0; for the y-intercept put x = 0.';
    }
    if (!l) return stop('Those numbers do not make a line.');
    ans.textContent = `The line is ${l.b === 0 ? `x = ${nt(-l.c / l.a)}` : slopeText(l)}, or ${generalText(l)}.`.replace(/-/g, '−');
    work.replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t.replace(/-(?=\d)/g, '−') })));
    rows.replaceChildren(...lineRows(l).map((r) => { const div = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd'); dt.textContent = r.name; dd.textContent = r.text.replace(/-(?=\d)/g, '−'); div.append(dt, dd); return div; }));
    tip.textContent = `Common mistake: ${mist}`;
    // Optional: distance from P and the angle with another line.
    const qx = readNum(lk('qx').value), qy = readNum(lk('qy').value), dEl = q('.lf-sdist'), aEl = q('.lf-sang');
    if (lk('qx').value.trim() === '' && lk('qy').value.trim() === '') dEl.textContent = '';
    else if (!Number.isFinite(qx) || !Number.isFinite(qy)) dEl.textContent = 'Type both numbers for the point P to get its distance from the line.';
    else { const num = Math.abs(l.a * qx + l.b * qy + l.c), den = Math.hypot(l.a, l.b); dEl.textContent = `Distance from P(${nt(qx)}, ${nt(qy)}) to the line = |Ax₀ + By₀ + C|/√(A² + B²) = |${pr(l.a)}×${pr(qx)} + ${pr(l.b)}×${pr(qy)} + ${pr(l.c)}|/√${nt(l.a * l.a + l.b * l.b)} = ${nt(num)}/${fmt(den, 4)} = ${fmt(num / den, 4)}${num === 0 ? ' (P is on the line)' : ''}.`.replace(/-(?=\d)/g, '−'); }
    const a2 = ['A2', 'B2', 'C2'].map((k) => readNum(lk(k).value));
    if (['A2', 'B2', 'C2'].every((k) => lk(k).value.trim() === '')) aEl.textContent = '';
    else if (!a2.every(Number.isFinite)) aEl.textContent = 'Type A, B and C of the other line (0 if a number is missing).';
    else if (a2[0] === 0 && a2[1] === 0) aEl.textContent = 'A and B of the other line cannot both be 0.';
    else {
      const l2: Line = { a: a2[0], b: a2[1], c: a2[2] }, th = angleBetween(l, l2), M = meet(l, l2);
      const pt2: Pt = l2.a !== 0 ? [-l2.c / l2.a, 0] : [0, -l2.c / l2.b], dd = distance(l, pt2);
      aEl.textContent = (parallel(l, l2) ? (dd < 1e-9 ? 'The two equations describe the same line.' : `The two lines are parallel (the angle between them is 0°) and never meet. The distance between them is ${fmt(dd, 4)}.`) : `${perpendicular(l, l2) ? 'The lines are perpendicular: ' : ''}The acute angle between the lines is ${fmt(th, 2)}° (the other angle is ${fmt(180 - th, 2)}°). They meet at ${M ? `(${nt(M[0])}, ${nt(M[1])})` : 'no point'}.`).replace(/-(?=\d)/g, '−');
    }
  }
  const slopeText = (l: Line) => (l.b === 0 ? '' : slopeInterceptText(-l.a / l.b, -l.c / l.b));
  const lroot = q('.lf-solve');
  lroot.addEventListener('input', (e) => { const k = (e.target as HTMLElement).dataset.k; if (k === 'preset') return; if (k !== 'mode' && LF.includes(k!)) lsel('preset').value = ''; solveLine(); });
  lroot.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).dataset.k === 'preset') {
      const p = PRE[Number(lsel('preset').value)]; if (!p) return;
      lsel('mode').value = p.mode; for (const k of LF) if (p.v[k] !== undefined) lk(k).value = p.v[k];
    }
    solveLine();
  });
  solveLine();

  quiz(q('.lf-quiz'), () => {
    const out: Question[] = [];
    let a: Pt, b: Pt;
    do { a = [randInt(-6, 6), randInt(-6, 6)]; b = [randInt(-6, 6), randInt(-6, 6)]; } while (a[0] === b[0]);
    out.push({ q: `Find the slope of the line through (${a[0]}, ${a[1]}) and (${b[0]}, ${b[1]}).`.replace(/-/g, '−'), want: [(b[1] - a[1]) / (b[0] - a[0])], tol: 1e-6, work: `m = (${b[1]} − ${a[1]})/(${b[0]} − ${a[0]}) = ${b[1] - a[1]}/${b[0] - a[0]} = ${fracText(b[1] - a[1], b[0] - a[0])}.`.replace(/− -/g, '+ ').replace(/-/g, '−') });
    const m = randInt(-4, 4, true), c = randInt(-6, 6), x0 = randInt(-3, 3);
    out.push({ q: `A line has slope ${m} and passes through (${x0}, ${m * x0 + c}). Where does it cut the y axis?`.replace(/-/g, '−'), want: [c], tol: 1e-6, work: `y − ${m * x0 + c} = ${m}(x − ${x0}); put x = 0: y = ${m * x0 + c} − ${m}×${x0} = ${c}.`.replace(/− -/g, '+ ').replace(/-/g, '−') });
    const [p3, q3, h] = [[3, 4, 5], [4, 3, 5], [5, 12, 13], [12, 5, 13], [6, 8, 10]][randInt(0, 4)], X = randInt(-3, 3), Y = randInt(-3, 3), k = randInt(1, 4), sgn = randInt(0, 1) ? 1 : -1;
    const C3 = sgn * k * h - p3 * X - q3 * Y;
    out.push({ q: `How far is the point (${X}, ${Y}) from the line ${p3}x + ${q3}y ${C3 < 0 ? '−' : '+'} ${Math.abs(C3)} = 0?`.replace(/-/g, '−'), want: [k], tol: 1e-6, work: `|${p3}×${X} + ${q3}×${Y} + ${C3}|/√(${p3}² + ${q3}²) = ${k * h}/${h} = ${k}.`.replace(/\+ -/g, '− ').replace(/-/g, '−') });
    const n1 = randInt(1, 5), d1 = randInt(1, 5) * (randInt(0, 1) ? 1 : -1), gg = gcd(n1, d1);
    out.push({ q: `A line has slope ${fracText(n1, d1)}. What is the slope of a line perpendicular to it?`, want: [-d1 / n1], tol: 1e-6, work: `Perpendicular slopes multiply to −1, so m₂ = −1/(${fracText(n1, d1)}) = ${fracText(-d1 / gg, n1 / gg)}.` });
    const A5 = randInt(1, 6), B5 = randInt(1, 6) * (randInt(0, 1) ? 1 : -1), xi = randInt(-5, 5, true), C5 = -A5 * xi;
    out.push({ q: `Where does ${A5}x ${B5 < 0 ? '−' : '+'} ${Math.abs(B5)}y ${C5 < 0 ? '−' : '+'} ${Math.abs(C5)} = 0 cut the x axis? Give the x value.`, want: [xi], tol: 1e-6, work: `Put y = 0: ${A5}x = ${-C5}, so x = ${xi}.`.replace(/-/g, '−') });
    return out;
  });
</script>
