---
// #T859 Photo palette
---
<div class="tool-ui pp">
  <section class="panel pp-set">
    <label class="pp-file">Choose a photo (JPG, PNG, WebP)<input data-k="file" type="file" accept="image/*" /></label>
    <label>Colours<select data-k="count">
      <option>5</option><option selected>6</option><option>7</option><option>8</option><option>9</option><option>10</option>
    </select></label>
    <label>Sort by<select data-k="sort"><option value="share">Share of the photo</option><option value="light">Dark to light</option><option value="hue">Hue</option></select></label>
    <button type="button" class="pp-reset">Use the example</button>
  </section>
  <p class="pp-msg" aria-live="polite"></p>
  <section class="panel pp-main">
    <canvas class="pp-photo" width="320" height="200" aria-label="The photo"></canvas>
    <ol class="pp-list"></ol>
  </section>
  <section class="panel">
    <div class="pp-bar" aria-hidden="true"></div>
    <h3 class="pp-h">CSS variables</h3>
    <textarea class="pp-css" rows="6" readonly></textarea>
    <div class="pp-acts">
      <button type="button" class="pp-copycss">Copy CSS</button>
      <button type="button" class="pp-png pp-main-btn">Download swatch strip (PNG)</button>
    </div>
  </section>
  <p class="pp-fine">Your photo is read on this page and never uploaded.</p>
</div>

<style is:inline>
  .pp { display: grid; gap: 14px; margin-bottom: 32px; }
  .pp .panel { padding: 16px; }
  .pp-set { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); gap: 12px; align-items: end; }
  .pp label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); min-width: 0; }
  .pp .pp-file { grid-column: 1 / -1; }
  .pp select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; }
  .pp input[type="file"] { font: inherit; font-size: 14px; max-width: 100%; }
  .pp button { font: inherit; font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .pp .pp-main-btn { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .pp-msg { margin: 0; color: var(--muted); font-size: 14px; }
  .pp-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .pp-photo { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); }
  .pp-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .pp-list li { display: grid; grid-template-columns: 40px 1fr auto; gap: 10px; align-items: center; }
  .pp-sw { width: 40px; height: 40px; border-radius: 8px; border: 1px solid var(--line); }
  .pp-list code { font: 14px ui-monospace, monospace; display: block; }
  .pp-list small { color: var(--muted); font-size: 12px; }
  .pp-list button { padding: 4px 10px; font-size: 13px; }
  .pp-bar { display: flex; height: 40px; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 12px; }
  .pp-h { margin: 0 0 8px; font-size: 16px; }
  .pp-css { width: 100%; font: 13px ui-monospace, monospace; padding: 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); margin-bottom: 8px; resize: vertical; }
  .pp-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .pp-fine { color: var(--muted); font-size: 13px; margin: 0; }
  @media (max-width: 560px) { .pp-main { grid-template-columns: 1fr; } }
</style>

<script>
  type RGB = [number, number, number];
  type Sw = { c: RGB; share: number };
  const root = document.querySelector('.pp') as HTMLElement;
  const q = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const photo = q<HTMLCanvasElement>('.pp-photo');
  const list = q<HTMLElement>('.pp-list'), bar = q<HTMLElement>('.pp-bar'), css = q<HTMLTextAreaElement>('.pp-css'), msg = q<HTMLElement>('.pp-msg');
  const countSel = q<HTMLSelectElement>('[data-k="count"]'), sortSel = q<HTMLSelectElement>('[data-k="sort"]');
  const MAX = 120; // the photo is shrunk to at most 120 px on its long side before counting colours
  let pixels: Float32Array = new Float32Array(0);
  let sw: Sw[] = [];
  const hex = (c: RGB) => '#' + c.map((v) => Math.round(v).toString(16).padStart(2, '0')).join('');
  // Small seeded random numbers (mulberry32), so the same photo always gives the same palette.
  const rng = (seed: number) => () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  const kmeans = (px: Float32Array, k: number): Sw[] => {
    const n = px.length / 3; if (!n) return [];
    const r = rng(20261110), cent: number[][] = [];
    const d2 = new Float64Array(n).fill(Infinity);
    const j0 = Math.floor(r() * n); cent.push(Array.from(px.subarray(j0 * 3, j0 * 3 + 3)));
    // k-means++ start: each new centre is picked with chance in proportion to its squared distance.
    while (cent.length < k) {
      const c = cent[cent.length - 1]; let tot = 0;
      for (let i = 0; i < n; i++) { const a = px[i * 3] - c[0], b = px[i * 3 + 1] - c[1], e = px[i * 3 + 2] - c[2]; const d = a * a + b * b + e * e; if (d < d2[i]) d2[i] = d; tot += d2[i]; }
      if (tot < 1) break; // fewer distinct colours than asked for
      let t = r() * tot, j = 0;
      for (; j < n - 1; j++) { t -= d2[j]; if (t <= 0) break; }
      cent.push(Array.from(px.subarray(j * 3, j * 3 + 3)));
    }
    const lab = new Int32Array(n);
    for (let it = 0; it < 25; it++) {
      let moved = 0;
      for (let i = 0; i < n; i++) {
        let best = 0, bd = Infinity;
        for (let j = 0; j < cent.length; j++) { const a = px[i * 3] - cent[j][0], b = px[i * 3 + 1] - cent[j][1], e = px[i * 3 + 2] - cent[j][2]; const d = a * a + b * b + e * e; if (d < bd) { bd = d; best = j; } }
        if (lab[i] !== best) { lab[i] = best; moved++; }
      }
      const sum = cent.map(() => [0, 0, 0, 0]);
      for (let i = 0; i < n; i++) { const s = sum[lab[i]]; s[0] += px[i * 3]; s[1] += px[i * 3 + 1]; s[2] += px[i * 3 + 2]; s[3]++; }
      sum.forEach((s, j) => { if (s[3]) cent[j] = [s[0] / s[3], s[1] / s[3], s[2] / s[3]]; });
      if (!moved && it) break;
    }
    const cnt = new Array(cent.length).fill(0); for (let i = 0; i < n; i++) cnt[lab[i]]++;
    return cent.map((c, j) => ({ c: c.map(Math.round) as RGB, share: cnt[j] / n })).filter((s) => s.share > 0);
  };
  const lightness = (c: RGB) => 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
  const hue = ([r, g, b]: RGB) => { const mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn; if (!d) return -1; const h = mx === r ? ((g - b) / d + 6) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; return h * 60; };
  const sorted = () => {
    const s = [...sw];
    if (sortSel.value === 'light') s.sort((a, b) => lightness(a.c) - lightness(b.c));
    else if (sortSel.value === 'hue') s.sort((a, b) => hue(a.c) - hue(b.c));
    else s.sort((a, b) => b.share - a.share);
    return s;
  };
  const pctText = (x: number) => (x * 100).toFixed(1) + '%';
  const show = () => {
    const s = sorted();
    list.innerHTML = ''; bar.innerHTML = '';
    s.forEach((w, i) => {
      const h = hex(w.c);
      const li = document.createElement('li'); li.dataset.hex = h; li.dataset.share = w.share.toFixed(4);
      const box = document.createElement('span'); box.className = 'pp-sw'; box.style.background = h;
      const t = document.createElement('div');
      const cd = document.createElement('code'); cd.textContent = h;
      const sm = document.createElement('small'); sm.textContent = `rgb(${w.c.join(', ')}) · ${pctText(w.share)} of the photo`;
      t.append(cd, sm);
      const b = document.createElement('button'); b.type = 'button'; b.textContent = 'Copy';
      b.addEventListener('click', async () => { try { await navigator.clipboard.writeText(h); b.textContent = 'Copied'; } catch { b.textContent = h; } setTimeout(() => (b.textContent = 'Copy'), 1200); });
      li.append(box, t, b); list.append(li);
      const seg = document.createElement('span'); seg.style.background = h; seg.style.flex = String(Math.max(w.share, 0.01)); seg.title = `${i + 1}: ${h}`; bar.append(seg);
    });
    css.value = ':root {\n' + s.map((w, i) => `  --colour-${i + 1}: ${hex(w.c)};`).join('\n') + '\n}';
    msg.textContent = s.length < +countSel.value ? `This photo has only ${s.length} distinct colour${s.length === 1 ? '' : 's'}, so you get ${s.length}.` : `${s.length} main colours, found by grouping similar pixels (k-means).`;
  };
  const run = () => { sw = kmeans(pixels, +countSel.value); show(); };
  const load = (src: CanvasImageSource, w: number, h: number) => {
    const k = Math.min(1, MAX / Math.max(w, h)), sw2 = Math.max(1, Math.round(w * k)), sh = Math.max(1, Math.round(h * k));
    const small = document.createElement('canvas'); small.width = sw2; small.height = sh;
    const x = small.getContext('2d', { willReadFrequently: true })!; x.imageSmoothingQuality = 'high'; x.drawImage(src, 0, 0, sw2, sh);
    const d = x.getImageData(0, 0, sw2, sh).data, out: number[] = [];
    for (let i = 0; i < d.length; i += 4) if (d[i + 3] >= 128) out.push(d[i], d[i + 1], d[i + 2]); // skip see-through pixels
    pixels = new Float32Array(out);
    const pk = Math.min(1, 640 / Math.max(w, h));
    photo.width = Math.max(1, Math.round(w * pk)); photo.height = Math.max(1, Math.round(h * pk));
    photo.getContext('2d')!.drawImage(src, 0, 0, photo.width, photo.height);
    run();
  };
  const example = () => {
    const c = document.createElement('canvas'); c.width = 320; c.height = 200; const x = c.getContext('2d')!;
    x.fillStyle = '#7ec8e3'; x.fillRect(0, 0, 320, 120);
    x.fillStyle = '#f9d65c'; x.beginPath(); x.arc(250, 45, 26, 0, Math.PI * 2); x.fill();
    x.fillStyle = '#5b7f3a'; x.beginPath(); x.moveTo(0, 120); x.lineTo(90, 60); x.lineTo(180, 120); x.fill();
    x.fillStyle = '#3e5f8a'; x.beginPath(); x.moveTo(120, 120); x.lineTo(220, 70); x.lineTo(320, 120); x.fill();
    x.fillStyle = '#8fbf4d'; x.fillRect(0, 120, 320, 50);
    x.fillStyle = '#c2a66b'; x.fillRect(0, 170, 320, 30);
    x.fillStyle = '#b5523b'; x.fillRect(40, 130, 50, 40);
    x.fillStyle = '#ffffff'; x.fillRect(55, 145, 20, 25);
    load(c, 320, 200);
    msg.textContent = 'This is a drawn example. Choose a photo to get its colours. ' + msg.textContent;
  };
  q<HTMLInputElement>('[data-k="file"]').addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    try { const b = await createImageBitmap(f); load(b, b.width, b.height); }
    catch { msg.textContent = 'That file could not be opened as an image. Try a JPG or PNG.'; }
  });
  countSel.addEventListener('input', run);
  sortSel.addEventListener('input', show);
  q('.pp-reset').addEventListener('click', () => { q<HTMLInputElement>('[data-k="file"]').value = ''; countSel.value = '6'; sortSel.value = 'share'; example(); });
  q('.pp-copycss').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(css.value); b.textContent = 'Copied'; } catch { css.select(); b.textContent = 'Press Ctrl+C'; }
    setTimeout(() => (b.textContent = 'Copy CSS'), 1500);
  });
  q('.pp-png').addEventListener('click', () => {
    const s = sorted(), W = 160, c = document.createElement('canvas'); c.width = W * s.length; c.height = 200;
    const x = c.getContext('2d')!;
    s.forEach((w, i) => {
      x.fillStyle = hex(w.c); x.fillRect(i * W, 0, W, 150);
      x.fillStyle = '#ffffff'; x.fillRect(i * W, 150, W, 50);
      x.fillStyle = '#111111'; x.font = '600 18px system-ui, sans-serif'; x.fillText(hex(w.c), i * W + 12, 176);
      x.font = '14px system-ui, sans-serif'; x.fillText(pctText(w.share), i * W + 12, 194);
    });
    c.toBlob((b) => { const u = URL.createObjectURL(b!); const a = document.createElement('a'); a.href = u; a.download = 'palette.png'; document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 4000); }, 'image/png');
  });
  example();
</script>
