---
// GP explorer (Learn, Class 11 sequences and series): terms of a geometric progression as bars, partial sums that
// settle on a/(1 − r) when |r| < 1, AM ≥ GM drawn in a semicircle, and money that grows or shrinks as a GP.
// Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm gp">
  <div class="ax-card">
    <h2>Terms and sums</h2>
    <svg class="sm-fig gp-fig" viewBox="0 0 340 240" role="img" aria-label="Bars for the terms of the progression, a line for the running sum, and a dashed line at the sum to infinity"></svg>
    <p class="ax-help"><span class="gp-key gp-k1"></span> term &nbsp; <span class="gp-key gp-k2"></span> running sum Sₙ &nbsp; <span class="gp-key gp-k3"></span> sum to infinity</p>
    <div class="sm-sl"><b>a</b><input type="range" class="gp-ar" min="-10" max="10" step="0.5" value="8" aria-label="First term slider" /><input type="number" class="gp-a" step="0.5" value="8" inputmode="decimal" aria-label="First term a" /></div>
    <div class="sm-sl"><b>r</b><input type="range" class="gp-rr" min="-2" max="2" step="0.05" value="0.5" aria-label="Common ratio slider" /><input type="number" class="gp-r" step="0.05" value="0.5" inputmode="decimal" aria-label="Common ratio r" /></div>
    <div class="sm-sl"><b>n</b><input type="range" class="gp-nr" min="1" max="15" step="1" value="8" aria-label="Number of terms slider" /><input type="number" class="gp-n" min="1" max="15" step="1" value="8" inputmode="numeric" aria-label="Number of terms n" /></div>
    <p class="ax-err gp-err" hidden></p>
    <p class="sm-f gp-list"></p>
    <p class="sm-f gp-t"></p>
    <p class="sm-f gp-s"></p>
    <p class="sm-f gp-inf"></p>
  </div>

  <div class="ax-card">
    <h2>AM ≥ GM in a semicircle</h2>
    <svg class="sm-fig gp-mfig" viewBox="0 0 340 210" role="img" aria-label="A semicircle on a diameter of length a + b. The radius is the arithmetic mean and the half-chord at the join is the geometric mean."></svg>
    <div class="sm-sl"><b>a</b><input type="range" class="gp-xr" min="0.5" max="20" step="0.5" value="4" aria-label="First number slider" /><input type="number" class="gp-x" min="0.01" step="0.5" value="4" inputmode="decimal" aria-label="First number" /></div>
    <div class="sm-sl"><b>b</b><input type="range" class="gp-yr" min="0.5" max="20" step="0.5" value="9" aria-label="Second number slider" /><input type="number" class="gp-y" min="0.01" step="0.5" value="9" inputmode="decimal" aria-label="Second number" /></div>
    <label class="ax-check"><input type="checkbox" class="gp-hm" /> Show the harmonic mean too (GM² = AM × HM)</label>
    <p class="ax-err gp-merr" hidden></p>
    <p class="sm-f gp-am"></p>
    <p class="sm-f gp-gm"></p>
    <p class="sm-f gp-hmt"></p>
    <p class="sm-f gp-cmp"></p>
  </div>

  <div class="ax-card">
    <div class="ax-row" style="justify-content:space-between">
      <h2 style="margin:0">Money as a GP</h2>
      <div class="ax-seg gp-way" role="group" aria-label="Grow or shrink"><button type="button" data-w="grow" aria-pressed="true">Compound interest</button><button type="button" data-w="shrink" aria-pressed="false">Depreciation</button></div>
    </div>
    <svg class="sm-fig gp-yfig" viewBox="0 0 340 200" style="margin-top:10px" role="img" aria-label="Bars for the value at the start and after each year"></svg>
    <div class="ax-grid" style="margin-top:8px">
      <label>Starting amount <input type="number" class="gp-p" min="1" step="100" value="10000" inputmode="decimal" /></label>
      <label>Rate (% a year) <input type="number" class="gp-i" min="0" max="99" step="0.5" value="8" inputmode="decimal" /></label>
      <label>Years <input type="number" class="gp-yrs" min="1" max="40" step="1" value="10" inputmode="numeric" /></label>
    </div>
    <p class="ax-err gp-perr" hidden></p>
    <p class="sm-f gp-pr"></p>
    <p class="sm-f gp-pv"></p>
    <p class="sm-f gp-pd"></p>
    <p class="ax-help">A teaching model: interest added once a year at a fixed rate, no tax or fees. Real savings and loans differ; the money planners on fibub handle real payments.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Set r = 0.5. The running sum climbs toward the dashed line at a/(1 − r) = 2a but never passes it.</li>
      <li>Set r = −0.5. The bars flip up and down and the running sum zig-zags in on the dashed line from both sides.</li>
      <li>Set r = 1.1, then r = −1. Now there is no sum to infinity: the terms do not shrink to zero.</li>
      <li>Make a = b in the semicircle. The half-chord becomes the radius: AM = GM only when the two numbers are equal.</li>
      <li>At 8 % a year, how many years does the money take to double? Compare with 72 ÷ 8.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Fractions like 3/4 are fine. Nothing is saved.</p>
    <div class="gp-quiz"></div>
  </div>
</div>

<style is:inline>
  .gp .gp-key { display: inline-block; width: 14px; height: 10px; border-radius: 2px; vertical-align: middle; }
  .gp .gp-k1 { background: var(--accent); }
  .gp .gp-k2 { background: var(--ink); height: 3px; }
  .gp .gp-k3 { border-top: 2px dashed var(--good); height: 0; }
  .gp svg .gp-bar { fill: var(--accent); fill-opacity: 0.75; }
  .gp svg .gp-sum { fill: none; stroke: var(--ink); stroke-width: 2; }
  .gp svg .gp-sdot { fill: var(--ink); }
  .gp svg .gp-inf { stroke: var(--good); stroke-width: 2; stroke-dasharray: 6 4; }
  .gp svg .gp-arc { fill: var(--accent-soft); fill-opacity: 0.4; stroke: var(--ink); stroke-width: 2; }
  .gp svg .gp-amL { stroke: var(--accent); stroke-width: 3; }
  .gp svg .gp-gmL { stroke: var(--good); stroke-width: 3; }
  .gp svg .gp-hmL { stroke: var(--warn); stroke-width: 3; }
  .gp .ax-grid input { width: 100%; min-height: 44px; }
</style>

<script>
  import { terms, sumN, sumInf, am, gm, hm, yearly, yearsTo } from '../../lib/sci/gp-explorer';
  import { fmt, randInt, fracText } from '../../lib/sci/smath';
  import { S, pair, val, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.gp')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const A = q<HTMLInputElement>('.gp-a'), Rb = q<HTMLInputElement>('.gp-r'), Nb = q<HTMLInputElement>('.gp-n');
  pair(q('.gp-ar'), A, drawGP); pair(q('.gp-rr'), Rb, drawGP); pair(q('.gp-nr'), Nb, drawGP);
  const X = q<HTMLInputElement>('.gp-x'), Y = q<HTMLInputElement>('.gp-y');
  pair(q('.gp-xr'), X, drawMeans); pair(q('.gp-yr'), Y, drawMeans);
  q('.gp-hm').addEventListener('change', drawMeans);
  const f4 = (x: number) => fmt(x, 4), par = (x: number) => (x < 0 ? `(${fmt(x, 4)})` : fmt(x, 4));

  function drawGP() {
    const fig = q<SVGSVGElement>('.gp-fig'); fig.replaceChildren();
    const a = val(A, 8), r = val(Rb, 0.5), n = Math.round(val(Nb, 8, 1, 15)), err = q('.gp-err');
    err.hidden = true;
    if (r === 0) { err.textContent = 'With r = 0 every term after the first is 0. Try a small ratio like 0.1 instead.'; err.hidden = false; }
    const t = terms(a, r, n), sums = t.map((_, k) => sumN(a, r, k + 1)), inf = sumInf(a, r);
    const top = Math.max(1e-9, ...t.map(Math.abs), ...sums.map(Math.abs), Number.isFinite(inf) ? Math.abs(inf) : 0);
    const L = 34, Rr = 330, T = 12, B = 228, has = t.some((v) => v < 0) || sums.some((v) => v < 0);
    const y0 = has ? (T + B) / 2 : B, h = has ? (B - T) / 2 : B - T;
    const py = (v: number) => y0 - (v / top) * h, w = (Rr - L) / n;
    S('line', { x1: L, x2: Rr, y1: y0, y2: y0, class: 'sm-axis' }, fig);
    S('text', { x: L - 4, y: py(top) + 4, 'text-anchor': 'end', class: 'sm-tick' }, fig, fmt(top, top < 10 ? 2 : 0));
    if (has) S('text', { x: L - 4, y: py(-top) + 4, 'text-anchor': 'end', class: 'sm-tick' }, fig, fmt(-top, top < 10 ? 2 : 0));
    t.forEach((v, i) => {
      const x = L + i * w + w * 0.15;
      S('rect', { x, width: w * 0.7, y: Math.min(py(v), y0), height: Math.max(0.5, Math.abs(py(v) - y0)), class: 'gp-bar' }, fig);
    });
    if (Number.isFinite(inf) && a !== 0) S('line', { x1: L, x2: Rr, y1: py(inf), y2: py(inf), class: 'gp-inf' }, fig);
    S('polyline', { points: sums.map((s, i) => `${L + (i + 0.5) * w},${py(s)}`).join(' '), class: 'gp-sum' }, fig);
    sums.forEach((s, i) => S('circle', { cx: L + (i + 0.5) * w, cy: py(s), r: 3.5, class: 'gp-sdot' }, fig));
    q('.gp-list').textContent = `Terms: ${t.slice(0, 8).map((v) => f4(v)).join(', ')}${n > 8 ? ', …' : ''}  (each one is r = ${fmt(r, 4)} times the one before)`;
    q('.gp-t').textContent = `nth term: aₙ = a rⁿ⁻¹ = ${fmt(a, 4)} × ${par(r)}^${n - 1} = ${f4(t[n - 1])}`;
    q('.gp-s').textContent = r === 1 ? `Sum of ${n} terms: r = 1, so Sₙ = n a = ${n} × ${fmt(a, 4)} = ${f4(sums[n - 1])}` : `Sum of ${n} terms: Sₙ = a(rⁿ − 1)/(r − 1) = ${fmt(a, 4)} × (${par(r)}^${n} − 1)/(${fmt(r, 4)} − 1) = ${f4(sums[n - 1])}`;
    q('.gp-inf').textContent = a === 0 ? 'Every term is 0, so every sum is 0.' : Number.isFinite(inf) ? `|r| < 1, so the terms shrink to 0 and S∞ = a/(1 − r) = ${fmt(a, 4)}/(1 − ${par(r)}) = ${f4(inf)}. After ${n} terms the sum is still ${f4(Math.abs(inf - sums[n - 1]))} away.` : `|r| = ${fmt(Math.abs(r), 4)} is not less than 1, so the terms do not shrink to 0 and there is no sum to infinity.`;
  }

  function drawMeans() {
    const fig = q<SVGSVGElement>('.gp-mfig'); fig.replaceChildren();
    const a = val(X, 4), b = val(Y, 9), err = q('.gp-merr');
    if (!(a > 0 && b > 0)) { err.textContent = 'Both numbers must be positive for the geometric mean.'; err.hidden = false; for (const c of ['.gp-am', '.gp-gm', '.gp-hmt', '.gp-cmp']) q(c).textContent = ''; return; }
    err.hidden = true;
    const k = 300 / (a + b), x0 = 20, base = 190, R = (a + b) / 2 * k, cx = x0 + R, px = x0 + a * k, G = gm(a, b), Am = am(a, b), H = hm(a, b);
    const s = Math.min(1, 175 / R), sc = (v: number) => v * s; // keep tall circles inside
    const X0 = cx - sc(R), X1 = cx + sc(R), PX = cx + (px - cx) * s;
    S('path', { d: `M ${X0} ${base} A ${sc(R)} ${sc(R)} 0 0 1 ${X1} ${base} Z`, class: 'gp-arc' }, fig);
    const D = { x: PX, y: base - sc(G * k) };
    S('line', { x1: cx, y1: base, x2: cx, y2: base - sc(R), class: 'gp-amL' }, fig);
    S('line', { x1: PX, y1: base, x2: D.x, y2: D.y, class: 'gp-gmL' }, fig);
    S('line', { x1: cx, y1: base, x2: D.x, y2: D.y, class: 'sm-dash' }, fig);
    if (q<HTMLInputElement>('.gp-hm').checked && a !== b) {
      const ux = (cx - D.x), uy = (base - D.y), len = Math.hypot(ux, uy), hl = sc(H * k);
      const E = { x: D.x + (ux / len) * hl, y: D.y + (uy / len) * hl };
      S('line', { x1: PX, y1: base, x2: E.x, y2: E.y, class: 'sm-dash' }, fig);
      S('line', { x1: D.x, y1: D.y, x2: E.x, y2: E.y, class: 'gp-hmL' }, fig);
    }
    S('text', { x: (X0 + PX) / 2, y: base + 14, 'text-anchor': 'middle' }, fig, `a = ${fmt(a)}`);
    S('text', { x: (PX + X1) / 2, y: base + 14, 'text-anchor': 'middle' }, fig, `b = ${fmt(b)}`);
    S('text', { x: cx + 6, y: base - sc(R) + 14, style: 'fill:var(--accent);font-weight:700' }, fig, 'AM');
    S('text', { x: PX + (PX < cx ? -6 : 6), y: (base + D.y) / 2, 'text-anchor': PX < cx ? 'end' : 'start', style: 'fill:var(--good);font-weight:700' }, fig, 'GM');
    S('circle', { cx: PX, cy: base, r: 3.5, class: 'gp-sdot' }, fig);
    q('.gp-am').textContent = `AM = (a + b)/2 = (${fmt(a)} + ${fmt(b)})/2 = ${f4(Am)}: the radius.`;
    q('.gp-gm').textContent = `GM = √(ab) = √(${fmt(a)} × ${fmt(b)}) = √${fmt(a * b, 4)} = ${f4(G)}: the half-chord at the join of a and b.`;
    q('.gp-hmt').textContent = q<HTMLInputElement>('.gp-hm').checked ? `HM = 2ab/(a + b) = ${f4(H)} = GM²/AM (${f4(G * G)} / ${f4(Am)}), the orange piece. So AM ≥ GM ≥ HM.` : '';
    q('.gp-cmp').textContent = a === b ? `a = b, so the half-chord is the radius: AM = GM = ${f4(Am)}.` : `The half-chord can never be longer than the radius, so AM ≥ GM. Here AM − GM = ${f4(Am - G)} = (√a − √b)²/2.`;
  }

  let way = 'grow';
  root.querySelectorAll<HTMLButtonElement>('.gp-way button').forEach((b) => b.addEventListener('click', () => { way = b.dataset.w!; root.querySelectorAll('.gp-way button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); drawMoney(); }));
  for (const c of ['.gp-p', '.gp-i', '.gp-yrs']) q(c).addEventListener('input', drawMoney);
  function drawMoney() {
    const fig = q<SVGSVGElement>('.gp-yfig'); fig.replaceChildren();
    const P = Number(q<HTMLInputElement>('.gp-p').value), i = Number(q<HTMLInputElement>('.gp-i').value), n = Math.round(Number(q<HTMLInputElement>('.gp-yrs').value)), err = q('.gp-perr');
    const bad = !(P > 0) ? 'Type a starting amount above 0.' : !(i >= 0 && i < 100) ? 'Type a rate from 0 to 99 %.' : !(n >= 1 && n <= 40) ? 'Type a whole number of years from 1 to 40.' : '';
    err.textContent = bad; err.hidden = !bad;
    if (bad) { for (const c of ['.gp-pr', '.gp-pv', '.gp-pd']) q(c).textContent = ''; return; }
    const rate = way === 'grow' ? i : -i, v = yearly(P, rate, n), r = 1 + rate / 100, top = Math.max(...v);
    const L = 8, Rr = 332, T = 10, B = 186, w = (Rr - L) / (n + 1);
    v.forEach((x, k) => S('rect', { x: L + k * w + w * 0.12, width: w * 0.76, y: B - (x / top) * (B - T), height: (x / top) * (B - T), class: 'gp-bar', style: k ? '' : 'fill:var(--ink);fill-opacity:.6' }, fig));
    S('line', { x1: L, x2: Rr, y1: B, y2: B, class: 'sm-axis' }, fig);
    const money = (x: number) => x.toLocaleString('en', { maximumFractionDigits: 2 });
    q('.gp-pr').textContent = `Each year the value is multiplied by r = 1 ${way === 'grow' ? '+' : '−'} ${fmt(i, 2)}/100 = ${fmt(r, 4)}, so the values ${money(P)}, ${money(v[1])}, ${money(v[2] ?? v[1])}, … form a GP.`;
    q('.gp-pv').textContent = `After ${n} years: ${money(P)} × ${fmt(r, 4)}^${n} = ${money(v[n])} (${way === 'grow' ? 'interest earned' : 'value lost'}: ${money(Math.abs(v[n] - P))}).`;
    const yd = yearsTo(P, rate, way === 'grow' ? 2 * P : P / 2);
    q('.gp-pd').textContent = i === 0 ? 'At 0 % nothing changes: r = 1.' : `It ${way === 'grow' ? 'doubles' : 'halves'} for the first time after ${yd} years${way === 'grow' ? ` (the rule of 72 guesses 72 ÷ ${fmt(i)} ≈ ${fmt(72 / i, 1)})` : ''}.`;
  }
  drawGP(); drawMeans(); drawMoney();

  quiz(q('.gp-quiz'), () => {
    const out: Question[] = [];
    const a1 = randInt(1, 5), r1 = randInt(2, 3), n1 = randInt(4, 7), t1 = a1 * r1 ** (n1 - 1);
    out.push({ q: `A GP starts ${a1}, ${a1 * r1}, ${a1 * r1 * r1}, … What is term number ${n1}?`, want: [t1], work: `r = ${r1}, so a${n1} = ${a1} × ${r1}^${n1 - 1} = ${t1}.` });
    const a2 = randInt(1, 6), n2 = randInt(4, 8), s2 = a2 * (2 ** n2 - 1);
    out.push({ q: `Add the first ${n2} terms of ${a2}, ${2 * a2}, ${4 * a2}, …`, want: [s2], work: `S${n2} = a(rⁿ − 1)/(r − 1) = ${a2} × (2^${n2} − 1)/1 = ${s2}.` });
    const a3 = randInt(2, 12), d3 = randInt(2, 4), s3 = (a3 * d3) / (d3 - 1);
    out.push({ q: `Find the sum to infinity of ${a3} + ${fracText(a3, d3)} + ${fracText(a3, d3 * d3)} + …`, want: [s3], tol: 0.001, work: `r = 1/${d3}, so S∞ = a/(1 − r) = ${a3}/(1 − 1/${d3}) = ${fracText(a3 * d3, d3 - 1)}.` });
    const g = randInt(2, 6), m = randInt(1, 3), k = randInt(2, 4), x = g * m, y = g * m * k * k;
    out.push({ q: `What is the geometric mean of ${x} and ${y}?`, want: [Math.sqrt(x * y)], work: `GM = √(${x} × ${y}) = √${x * y} = ${Math.sqrt(x * y)}.` });
    const P = randInt(2, 9) * 10000, i = [10, 20][randInt(0, 1)], v = Math.round(P * (1 - i / 100) ** 2 * 100) / 100;
    out.push({ q: `A scooter worth ${P.toLocaleString('en')} loses ${i} % of its value each year. What is it worth after 2 years?`, want: [v], work: `r = 1 − ${i}/100 = ${1 - i / 100}, so ${P.toLocaleString('en')} × ${1 - i / 100}² = ${v}.` });
    return out;
  });
</script>
