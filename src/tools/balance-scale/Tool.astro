---
// Balance-scale equation solver: x boxes and 1-weights on two pans. Make moves that do the same to both pans
// until x is alone; slide a guess to see the beam tip. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm bs">
  <div class="ax-card">
    <h2>The equation</h2>
    <div class="bs-eqin" role="group" aria-label="Equation">
      <input type="number" class="bs-a" min="0" max="9" step="1" value="3" inputmode="numeric" aria-label="x boxes on the left" /><span>x +</span>
      <input type="number" class="bs-b" min="0" max="30" step="1" value="5" inputmode="numeric" aria-label="1-weights on the left" /><span>=</span>
      <input type="number" class="bs-c" min="0" max="9" step="1" value="1" inputmode="numeric" aria-label="x boxes on the right" /><span>x +</span>
      <input type="number" class="bs-d" min="0" max="30" step="1" value="13" inputmode="numeric" aria-label="1-weights on the right" />
    </div>
    <div class="ax-row" style="margin-top:8px"><button type="button" class="btn small secondary bs-new">New equation</button><span class="ax-help bs-lim">Up to 9 boxes and 30 weights a side.</span></div>
    <p class="ax-err bs-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>The scale</h2>
    <svg class="sm-fig bs-fig" viewBox="0 0 340 240" role="img" aria-label="A balance with x boxes and 1-weights on each pan"></svg>
    <p class="sm-f bs-eq" aria-live="polite"></p>
    <div class="ax-row bs-moves">
      <button type="button" class="btn small bs-m" data-m="unit">− 1 from each</button>
      <button type="button" class="btn small bs-m" data-m="units">− all 1s you can</button>
      <button type="button" class="btn small bs-m" data-m="box">− x from each</button>
      <span class="bs-share"><button type="button" class="btn small bs-m" data-m="share">Share into</button><input type="number" class="bs-k" min="2" max="9" value="2" step="1" inputmode="numeric" aria-label="Number of equal groups" /><span>groups</span></span>
      <button type="button" class="btn small secondary bs-m" data-m="swap">Swap pans</button>
      <button type="button" class="btn small secondary bs-hint">Hint</button>
      <button type="button" class="btn small secondary bs-reset">Start again</button>
    </div>
    <p class="ax-help bs-msg" aria-live="polite"></p>
    <ol class="sm-steps bs-log"></ol>
  </div>

  <div class="ax-card">
    <h2>Test a guess</h2>
    <div class="sm-sl"><b>x</b><input type="range" class="bs-gr" min="0" max="20" step="0.5" value="2" aria-label="Guess slider" /><input type="number" class="bs-g" step="0.5" value="2" inputmode="decimal" aria-label="Guess for x" /></div>
    <p class="sm-f bs-test" aria-live="polite"></p>
    <p class="ax-big bs-big"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Slide the guess slowly. Which way does the beam tip when your guess is too small? Too big?</li>
      <li>Solve 3x + 5 = x + 13 in as few moves as you can. Can you do it in three?</li>
      <li>Type 2x + 4 = 2x + 4. Every guess balances. Now try 2x + 4 = 2x + 6.</li>
      <li>Type 3x = 7. Sharing into 3 does not work with whole weights: the answer is a fraction.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Fractions like 7/3 are fine. Nothing is saved.</p>
    <div class="bs-quiz"></div>
  </div>
</div>

<style is:inline>
  .bs .bs-eqin { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; font-size: 17px; font-weight: 600; }
  .bs .bs-eqin input { width: 2.9em !important; min-height: 44px; text-align: center; font-size: 17px; padding: 6px 2px !important; }
  .bs .bs-share { display: inline-flex; align-items: center; gap: 6px; }
  .bs .bs-k { width: 3.4em !important; min-height: 40px; }
  .bs .bs-moves { margin-top: 8px; }
  .bs svg .bs-beam { stroke: var(--ink); stroke-width: 6; stroke-linecap: round; }
  .bs svg .bs-post { fill: var(--muted); }
  .bs svg .bs-str { stroke: var(--muted); stroke-width: 1.5; }
  .bs svg .bs-pan { stroke: var(--ink); stroke-width: 4; stroke-linecap: round; }
  .bs svg .bs-x { fill: var(--accent); stroke: var(--surface); stroke-width: 1.5; }
  .bs svg .bs-xt { fill: var(--accent-ink); font-size: 12px; font-weight: 700; }
  .bs svg .bs-u { fill: var(--warn); stroke: var(--surface); stroke-width: 1; }
  .bs svg .bs-lev.ok { fill: var(--good); font-weight: 700; }
  .bs svg .bs-lev.no { fill: var(--bad); font-weight: 700; }
  .bs [hidden] { display: none !important; }
</style>

<script>
  import { solve, solText, eqText, sideText, tip, move, isSolved, hint, type Pans, type Move } from '../../lib/sci/balance-scale';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, pair, val, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.bs')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const ins = (['a', 'b', 'c', 'd'] as const).map((k) => q<HTMLInputElement>('.bs-' + k));
  const G = q<HTMLInputElement>('.bs-g');
  pair(q('.bs-gr'), G, draw);
  let start: Pans = { a: 3, b: 5, c: 1, d: 13 }, cur: Pans = { ...start }, log: string[] = [];

  function readStart() {
    const v = ins.map((i, k) => Number(i.value)), err = q('.bs-err');
    const bad = v.some((x, k) => !Number.isInteger(x) || x < 0 || x > (k % 2 ? 30 : 9));
    if (bad) { err.textContent = 'Use whole numbers: 0 to 9 boxes and 0 to 30 weights on each side.'; err.hidden = false; return; }
    err.hidden = true;
    start = { a: v[0], b: v[1], c: v[2], d: v[3] }; cur = { ...start }; log = []; q('.bs-msg').textContent = ''; draw();
  }
  ins.forEach((i) => i.addEventListener('input', readStart));
  q('.bs-new').addEventListener('click', () => {
    const x = randInt(1, 6), c = randInt(0, 3), a = c + randInt(1, 3), b = randInt(0, 12), d = (a - c) * x + b;
    if (d > 30) return q('.bs-new').click();
    [a, b, c, d].forEach((v, k) => (ins[k].value = String(v))); readStart();
  });
  const WORDS: Record<Move, string> = { unit: 'Took 1 from each pan', units: 'Took the same 1-weights from each pan', box: 'Took an x from each pan', share: 'Shared both pans into equal groups', swap: 'Swapped the pans' };
  root.querySelectorAll<HTMLButtonElement>('.bs-m').forEach((b) => b.addEventListener('click', () => {
    const m = b.dataset.m as Move, k = Number(q<HTMLInputElement>('.bs-k').value);
    const r = move(cur, m, k);
    if (typeof r === 'string') { q('.bs-msg').textContent = r; return; }
    const before = cur; cur = r;
    const extra = m === 'units' ? ` (${before.b - cur.b})` : m === 'share' ? ` (${k} groups, kept one)` : '';
    log.push(`${WORDS[m]}${extra}: ${eqText(cur)}`);
    q('.bs-msg').textContent = isSolved(cur) ? `Solved! x = ${solText(solve(cur))}. Check it with the guess slider.` : '';
    draw();
  }));
  q('.bs-hint').addEventListener('click', () => { q('.bs-msg').textContent = hint(cur); });
  q('.bs-reset').addEventListener('click', () => { cur = { ...start }; log = []; q('.bs-msg').textContent = ''; draw(); });

  function pan(fig: SVGSVGElement, cx: number, top: number, x: number, u: number) {
    const py = top + 130;
    S('line', { x1: cx, y1: top, x2: cx - 50, y2: py, class: 'bs-str' }, fig); S('line', { x1: cx, y1: top, x2: cx + 50, y2: py, class: 'bs-str' }, fig);
    S('line', { x1: cx - 55, y1: py, x2: cx + 55, y2: py, class: 'bs-pan' }, fig);
    let y = py - 3;
    for (let i = 0; i < x; i++) {
      const col = i % 5, row = Math.floor(i / 5);
      const bx = cx - 52 + col * 21, by = y - 20 - row * 21;
      S('rect', { x: bx, y: by, width: 19, height: 19, rx: 3, class: 'bs-x' }, fig);
      S('text', { x: bx + 9.5, y: by + 14, 'text-anchor': 'middle', class: 'bs-xt' }, fig, 'x');
    }
    y -= Math.ceil(x / 5) * 21;
    for (let i = 0; i < u; i++) {
      const col = i % 10, row = Math.floor(i / 10);
      S('circle', { cx: cx - 49 + col * 11, cy: y - 6 - row * 11, r: 5, class: 'bs-u' }, fig);
    }
  }

  function draw() {
    const fig = q<SVGSVGElement>('.bs-fig'); fig.replaceChildren();
    const g = val(G, 2), T = tip(cur, g), th = T.t * 12 * Math.PI / 180, L = 110, cx = 170, cy = 52;
    const lx = cx - L * Math.cos(th), ly = cy - L * Math.sin(th), rx = cx + L * Math.cos(th), ry = cy + L * Math.sin(th);
    S('polygon', { points: `${cx},${cy} ${cx - 16},236 ${cx + 16},236`, class: 'bs-post' }, fig);
    pan(fig, lx, ly, cur.a, cur.b); pan(fig, rx, ry, cur.c, cur.d);
    S('line', { x1: lx, y1: ly, x2: rx, y2: ry, class: 'bs-beam' }, fig);
    S('circle', { cx, cy, r: 6, class: 'sm-handle' }, fig);
    const lev = Math.abs(T.right - T.left) < 1e-9;
    S('text', { x: cx, y: 18, 'text-anchor': 'middle', class: 'bs-lev ' + (lev ? 'ok' : 'no') }, fig, lev ? `Balanced at x = ${fmt(g, 2)}` : `x = ${fmt(g, 2)}: ${T.left > T.right ? 'left' : 'right'} pan is heavier`);
    const sol = solve(cur);
    q('.bs-eq').textContent = `Now: ${eqText(cur)}${isSolved(cur) ? '  ✓' : ''}`;
    q('.bs-log').replaceChildren(...[`Start: ${eqText(start)}`, ...log].map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    q('.bs-test').textContent = `Left pan: ${sideText(cur.a, cur.b)} = ${fmt(T.left, 3)}.  Right pan: ${sideText(cur.c, cur.d)} = ${fmt(T.right, 3)}.`;
    q('.bs-big').textContent = sol.kind === 'one' ? (lev ? `x = ${fmt(g, 3)} balances` : (T.left < T.right) === (cur.a > cur.c) ? 'Too small: try a bigger x' : 'Too big: try a smaller x') : sol.kind === 'all' ? 'Every x balances: both pans are the same' : 'No x can balance these pans';
  }
  draw();

  quiz(q('.bs-quiz'), () => {
    const out: Question[] = [];
    const x = randInt(2, 9), a = randInt(2, 5), b = randInt(1, 12), r = a * x + b;
    out.push({ q: `Solve ${a}x + ${b} = ${r}.`, want: [x], work: `Take ${b} from both sides: ${a}x = ${r - b}. Share into ${a} groups: x = ${x}.` });
    const x2 = randInt(1, 8), c = randInt(1, 3), a2 = c + randInt(1, 3), b2 = randInt(0, 9), d2 = (a2 - c) * x2 + b2;
    out.push({ q: `Solve ${sideText(a2, b2)} = ${sideText(c, d2)}.`, want: [x2], work: `Take ${c === 1 ? 'an x' : `${c} x's`} from both sides: ${sideText(a2 - c, b2)} = ${d2}. ${b2 ? `Take ${b2} from both: ${sideText(a2 - c, 0)} = ${d2 - b2}. ` : ''}${a2 - c > 1 ? `Share into ${a2 - c}: ` : ''}x = ${x2}.` });
    const a3 = randInt(2, 4), n3 = a3 * randInt(1, 5) + randInt(1, a3 - 1);
    out.push({ q: `Solve ${a3}x = ${n3}. (A fraction is fine.)`, want: [n3 / a3], tol: 0.001, work: `${n3} does not share into ${a3} whole groups, so x = ${n3}/${a3} ≈ ${fmt(n3 / a3, 3)}.` });
    const a4 = randInt(2, 4), x4 = randInt(2, 6), b4 = randInt(1, 9), g4 = x4 + (Math.random() < 0.5 ? 0 : randInt(1, 2));
    out.push({ q: `Does x = ${g4} balance ${a4}x + ${b4} = ${a4 * x4 + b4}? Type 1 for yes, 0 for no.`, want: [g4 === x4 ? 1 : 0], work: `${a4} × ${g4} + ${b4} = ${a4 * g4 + b4}, ${g4 === x4 ? 'which equals' : 'which is not'} ${a4 * x4 + b4}. ${g4 === x4 ? 'Yes.' : 'No.'}` });
    return out;
  });
</script>
