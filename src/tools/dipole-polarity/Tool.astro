---
// Dipole moment and polarity: bond dipoles from the electronegativity difference, drawn as arrows on the 3D VSEPR
// shape; their vector sum says whether the molecule is polar. Swap outer atoms, compare with measured values, quiz.
import '../../styles/astro.css';
import { PRESETS, nameOf } from '../../lib/sci/dipole';
---
<div class="ax dpp">
  <div class="ax-card">
    <h2>Add up the bond dipoles</h2>
    <div class="ax-grid">
      <label>Molecule <select class="dp-ex">{PRESETS.map((p) => <option value={p.id} selected={p.id === 'h2o'}>{nameOf(p.central, p.outer, p.charge)}</option>)}</select></label>
    </div>
    <div class="ax-row" style="margin-top:10px"><span class="ax-help" style="margin:0">Level</span><span class="ax-seg dp-lvl" role="group" aria-label="Level"><button type="button" data-v="basic" aria-pressed="true">Basic</button><button type="button" data-v="num" aria-pressed="false">With numbers</button></span></div>
    <div class="dp-outer" aria-label="Outer atoms"></div>
    <p class="ax-big dp-big"></p>
    <canvas class="ax-fig dp-fig" tabindex="0"></canvas>
    <div class="ax-row dp-under"><span class="ax-help" style="margin:0">Drag the picture to turn it.</span><button type="button" class="btn secondary small dp-reset">Reset view</button></div>
    <p class="dp-why"></p>
    <p class="dp-lp" hidden></p>
    <p class="dp-sum"></p>
    <dl class="ax-facts dp-facts"></dl>
    <p class="ax-help">Grey arrows: bond dipoles, pointing to the atom that pulls the electrons harder (the + end is at the tail). Red arrow: their sum, the dipole of the whole molecule.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="dp-try">
      <li>CO₂ and H₂O both have two polar bonds. Turn each one: why is only water polar?</li>
      <li>Start from CH₄ and change one H to Cl, then two, then three, then four. When does the red arrow vanish again?</li>
      <li>Compare NH₃ and NF₃ in "With numbers". The bond dipoles are about the same size, but the measured values are very different. Read the lone pair note.</li>
      <li>XeF₄ has two lone pairs but no dipole. Where are they?</li>
      <li>In SF₆, change one F to Cl: the perfect octahedron is no longer balanced.</li>
    </ul>
  </div>

  <div class="ax-card dp-quiz">
    <h2>Check yourself</h2>
    <p class="ax-help" style="margin-top:0">Is each molecule polar or non-polar? Think about the shape first. New questions every time; nothing is saved.</p>
    <div class="dp-qs"></div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn small dp-check">Check</button><button type="button" class="btn secondary small dp-new">New questions</button><span class="dp-score" aria-live="polite"></span></div>
  </div>
</div>

<style is:inline>
  .dp-outer { display: flex; flex-wrap: wrap; gap: 8px 12px; margin: 12px 0 4px; }
  .dp-outer label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
  .dp-outer select { min-width: 72px; }
  .dp-outer .dp-fixed { font-size: 16px; font-weight: 700; color: var(--ink); padding: 8px 4px; }
  .dp-fig { max-width: 420px; margin: 0 auto; touch-action: none; cursor: grab; border: 1px solid var(--line); }
  .dp-under { margin: 8px 0; }
  .dp-sum { font-size: 15px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; overflow-wrap: anywhere; }
  .dp-lp { font-size: 14px; border-left: 3px solid var(--accent); padding-left: 10px; }
  .dp-try { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .dp-qs { display: grid; gap: 12px; }
  .dp-qs .dp-q1 { display: grid; gap: 6px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .dp-qs .dp-ans { font-size: 14px; margin: 0; }
  .dp-qs .ok { color: var(--good); } .dp-qs .no { color: var(--bad); }
  .dp-score { font-weight: 700; }
  .dpp.basic .dp-num { display: none; }
</style>

<script>
  import { PRESETS, MEASURED, polarity, type Polarity } from '../../lib/sci/dipole';
  import { mul, rotX, rotY, apply, project, type M3, type V3 } from '../../lib/sci/mol3d';
  import { paint, type Figure } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.dpp')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const cv = q<HTMLCanvasElement>('.dp-fig');
  const SWAP = ['H', 'F', 'Cl', 'Br', 'I'];
  const COL: Record<string, string> = { H: '#ffffff', F: '#7fd36b', Cl: '#2fa84f', Br: '#a33a2a', I: '#7b3fa0', O: '#e0412f', S: '#e3c32a', N: '#3b6fe0', C: '#555555' };
  const fmt = (x: number) => (Math.round(x * 100) / 100).toFixed(2);
  const fact = (k: string, v: string, sm = '', cls = '') => { const d = document.createElement('div'); if (cls) d.className = cls; d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };

  const START: M3 = mul(rotX(-0.35), rotY(0.45));
  let R: M3 = START, central = 'O', outer: string[] = ['H', 'H'], presetId: string | null = 'h2o', res: Polarity | null = null;
  const level = () => (root.classList.contains('basic') ? 'basic' : 'num');

  function figure(): Figure {
    const r = res;
    return { w: 400, h: 340, alt: r ? `${r.name}, ${r.shape}: ${r.polar ? 'polar, the bond dipoles add up to a net dipole' : 'non-polar, the bond dipoles cancel'}` : 'No molecule', draw: (ctx, W, H, pal) => {
      if (!r) return;
      const cx = W / 2, cy = H / 2, L = Math.min(W, H) * 0.36, c0 = project([0, 0, 0], cx, cy, L);
      type Item = { z: number; draw: () => void }; const items: Item[] = [];
      const arrow = (a: { x: number; y: number }, b: { x: number; y: number }, col: string, w: number, plus: boolean) => {
        const dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy); if (len < 4) return;
        const ux = dx / len, uy = dy / len, hs = 6 + w * 1.5;
        ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = w; ctx.lineCap = 'round';
        ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x - ux * hs * 0.8, b.y - uy * hs * 0.8); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(b.x, b.y); ctx.lineTo(b.x - ux * hs - uy * hs * 0.55, b.y - uy * hs + ux * hs * 0.55); ctx.lineTo(b.x - ux * hs + uy * hs * 0.55, b.y - uy * hs - ux * hs * 0.55); ctx.closePath(); ctx.fill();
        if (plus) { const px = a.x + ux * 6, py = a.y + uy * 6; ctx.lineWidth = Math.max(2, w - 1); ctx.beginPath(); ctx.moveTo(px - uy * 6, py + ux * 6); ctx.lineTo(px + uy * 6, py - ux * 6); ctx.stroke(); }
      };
      r.lonePos.forEach((p) => {
        const v = apply(R, p as V3), tip = project([v[0] * 0.8, v[1] * 0.8, v[2] * 0.8], cx, cy, L), mid = project([v[0] * 0.45, v[1] * 0.45, v[2] * 0.45], cx, cy, L);
        items.push({ z: v[2] * 0.45, draw: () => {
          const dx = tip.x - c0.x, dy = tip.y - c0.y, len = Math.hypot(dx, dy);
          ctx.save(); ctx.translate(mid.x, mid.y); ctx.rotate(Math.atan2(dy, dx)); ctx.beginPath(); ctx.ellipse(0, 0, Math.max(14, len * 0.45), 16 * mid.k, 0, 0, Math.PI * 2);
          ctx.globalAlpha = pal.red ? 0.3 : 0.18; ctx.fillStyle = pal.accent; ctx.fill(); ctx.globalAlpha = 1; ctx.lineWidth = 1.2; ctx.strokeStyle = pal.accent; ctx.setLineDash([4, 3]); ctx.stroke(); ctx.setLineDash([]); ctx.restore();
        } });
      });
      r.bonds.forEach((b) => {
        const v = apply(R, b.dir as V3), a = project(v, cx, cy, L), rad = (b.el === 'H' ? 13 : 17) * a.k;
        items.push({ z: v[2] * 0.5, draw: () => { ctx.strokeStyle = pal.muted; ctx.lineWidth = 4; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(c0.x, c0.y); ctx.lineTo(a.x, a.y); ctx.stroke(); } });
        items.push({ z: v[2], draw: () => {
          ctx.beginPath(); ctx.arc(a.x, a.y, rad, 0, Math.PI * 2); ctx.fillStyle = pal.red ? '#300000' : COL[b.el] || '#9a9a9a'; ctx.fill(); ctx.lineWidth = 1.5; ctx.strokeStyle = pal.ink; ctx.stroke();
          ctx.fillStyle = pal.red ? pal.ink : ['I', 'Br', 'N', 'Cl'].includes(b.el) ? '#ffffff' : '#000000'; ctx.font = `600 ${Math.round(12 * a.k)}px system-ui, sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(b.el, a.x, a.y + 0.5);
        } });
        if (Math.abs(b.dEN) >= 0.02) items.push({ z: v[2] * 0.5 + 0.01, draw: () => {
          // Bond dipole arrow beside the bond, pointing to the more electronegative atom, length from ΔEN.
          const dx = a.x - c0.x, dy = a.y - c0.y, len = Math.hypot(dx, dy) || 1, nx = -dy / len * 11, ny = dx / len * 11;
          const half = Math.min(0.42, 0.12 + Math.abs(b.dEN) * 0.22), s = b.dEN > 0 ? 1 : -1;
          const m = { x: c0.x + dx * 0.55 + nx, y: c0.y + dy * 0.55 + ny };
          const p0 = { x: m.x - dx * half * s, y: m.y - dy * half * s }, p1 = { x: m.x + dx * half * s, y: m.y + dy * half * s };
          arrow(p0, p1, pal.ink, 2, true);
          if (level() === 'num') { ctx.font = '600 11px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; const t = fmt(Math.abs(b.dEN)), w = ctx.measureText(t).width + 4; ctx.fillStyle = pal.bg; ctx.fillRect(m.x + nx * 1.4 - w / 2, m.y + ny * 1.4 - 7, w, 14); ctx.fillStyle = pal.ink; ctx.fillText(t, m.x + nx * 1.4, m.y + ny * 1.4); }
        } });
      });
      items.push({ z: 0, draw: () => {
        ctx.beginPath(); ctx.arc(c0.x, c0.y, 20, 0, Math.PI * 2); ctx.fillStyle = pal.red ? '#200000' : COL[central] || pal.muted; ctx.fill(); ctx.lineWidth = 1.5; ctx.strokeStyle = pal.ink; ctx.stroke();
        ctx.fillStyle = pal.red ? pal.ink : ['N', 'C', 'Cl', 'Xe', 'P', 'Be', 'B'].includes(central) ? '#ffffff' : '#000000'; ctx.font = '700 14px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(central, c0.x, c0.y + 0.5);
      } });
      items.sort((x, y) => x.z - y.z).forEach((it) => it.draw());
      if (r.polar) {
        const n = apply(R, r.net as V3), k = Math.min(1.1, 0.35 + r.size * 0.45) / r.size;
        const tip = project([n[0] * k, n[1] * k, n[2] * k], cx, cy, L);
        const dx = tip.x - c0.x, dy = tip.y - c0.y, d = Math.hypot(dx, dy) || 1, from = { x: c0.x + dx / d * 21, y: c0.y + dy / d * 21 };
        arrow(from, d > 40 ? tip : { x: c0.x + dx / d * 62, y: c0.y + dy / d * 62 }, pal.red ? pal.ink : '#d1352b', 5, true);
      }
      ctx.fillStyle = pal.muted; ctx.font = '12px system-ui, sans-serif'; ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      ctx.fillText(r.polar ? 'red arrow = net dipole' : 'net dipole = 0: the arrows cancel', 8, H - 8);
    } };
  }
  const draw = () => paint(cv, figure());

  function outerControls() {
    const box = q('.dp-outer');
    box.replaceChildren(...outer.map((el, i) => {
      if (!SWAP.includes(el)) { const s = document.createElement('span'); s.className = 'dp-fixed'; s.textContent = el; return s; }
      const lab = document.createElement('label'); lab.textContent = `Atom ${i + 1}`;
      const sel = document.createElement('select'); sel.className = 'dp-o'; sel.dataset.i = String(i);
      sel.innerHTML = SWAP.map((x) => `<option${x === el ? ' selected' : ''}>${x}</option>`).join('');
      lab.append(sel); return lab;
    }));
  }

  function update() {
    const r = polarity(central, outer);
    if (typeof r === 'string') { res = null; q('.dp-big').textContent = r; q('.dp-why').textContent = ''; q('.dp-sum').textContent = ''; q('.dp-facts').replaceChildren(); q('.dp-lp').hidden = true; draw(); return; }
    res = r;
    q('.dp-big').textContent = `${r.name}: ${r.polar ? 'polar' : 'non-polar'}`;
    q('.dp-why').textContent = r.why;
    const lp = q('.dp-lp');
    lp.hidden = !r.lp;
    if (r.lp) lp.textContent = r.lp === 'adds'
      ? `The lone pair${r.lone > 1 ? 's' : ''} on ${central} also make a dipole, pointing away from ${central}. Here it points the same way as the bond dipoles and adds to them, so the real dipole is larger.`
      : `The lone pair${r.lone > 1 ? 's' : ''} on ${central} also make a dipole, pointing away from ${central}. Here it points against the bond dipoles and partly cancels them, so the real dipole is smaller.`;
    const groups = new Map<string, { n: number; d: number }>();
    for (const b of r.bonds) { const g = groups.get(b.el) || { n: 0, d: b.dEN }; g.n++; groups.set(b.el, g); }
    const parts = [...groups].map(([el, g]) => `${g.n} × ${central}–${el} (ΔEN ${fmt(Math.abs(g.d))}, towards ${g.d > 0 ? el : g.d < 0 ? central : 'neither'})`);
    q('.dp-sum').textContent = level() === 'basic'
      ? `Net dipole = sum of the bond arrows → ${r.polar ? 'they do not cancel: polar' : 'they cancel: non-polar'}`
      : `Net dipole = sum of bond arrows: ${parts.join(' + ')} → |(${r.net.map(fmt).join(', ')})| = ${fmt(r.size)} (relative units)`;
    const m = presetId && presetId in MEASURED && same() ? MEASURED[presetId] : null;
    q('.dp-facts').replaceChildren(
      fact('Shape', r.shape, r.lone ? `${r.lone} lone pair${r.lone > 1 ? 's' : ''} on ${central}` : 'no lone pairs on the central atom'),
      fact('Polar?', r.polar ? 'yes' : 'no', r.polar ? 'it lines up in an electric field and dissolves well in water' : 'it does not line up in an electric field'),
      fact('Model net dipole', fmt(r.size), 'sum of ΔEN arrows, not debye', 'dp-num'),
      ...(m !== null ? [fact('Measured dipole moment', `${m.toFixed(2)} D`, 'data-book value, 1 D = 3.336 × 10⁻³⁰ C m', 'dp-num')] : []),
    );
    draw();
  }
  const same = () => { const p = PRESETS.find((x) => x.id === presetId); return !!p && p.outer.join() === outer.join(); };

  // Start view: net dipole pointing up the screen, bonds spread sideways, tilted a little.
  function startView(): M3 {
    const r = res; if (!r || !r.polar) return START;
    const n = r.net.map((x) => x / r.size) as V3, y: V3 = [0, 1, 0];
    const ax: V3 = [n[1] * y[2] - n[2] * y[1], n[2] * y[0] - n[0] * y[2], n[0] * y[1] - n[1] * y[0]], s = Math.hypot(...ax), c = n[1];
    let A: M3 = [1, 0, 0, 0, 1, 0, 0, 0, 1];
    if (s > 1e-9) { const [x1, y1, z1] = ax.map((v) => v / s), C = 1 - c; A = [c + x1 * x1 * C, x1 * y1 * C - z1 * s, x1 * z1 * C + y1 * s, y1 * x1 * C + z1 * s, c + y1 * y1 * C, y1 * z1 * C - x1 * s, z1 * x1 * C - y1 * s, z1 * y1 * C + x1 * s, c + z1 * z1 * C]; }
    else if (c < 0) A = rotX(Math.PI);
    const b = apply(A, r.bonds[0].dir as V3), phi = Math.abs(b[0]) + Math.abs(b[2]) > 1e-6 ? Math.atan2(b[2], b[0]) : 0;
    return mul(rotX(-0.3), mul(rotY(phi + 0.35), A));
  }
  function setPreset(id: string) { const p = PRESETS.find((x) => x.id === id)!; presetId = id; central = p.central; outer = [...p.outer]; outerControls(); update(); R = startView(); draw(); }
  q('.dp-ex').addEventListener('change', () => setPreset(q<HTMLSelectElement>('.dp-ex').value));
  q('.dp-outer').addEventListener('change', (e) => { const s = e.target as HTMLSelectElement; if (!s.classList.contains('dp-o')) return; outer[Number(s.dataset.i)] = s.value; update(); });
  q('.dp-lvl').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    q('.dp-lvl').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    root.classList.toggle('basic', b.dataset.v === 'basic'); update();
  });
  q('.dp-reset').addEventListener('click', () => { R = startView(); draw(); });
  let last: { x: number; y: number } | null = null;
  cv.addEventListener('pointerdown', (e) => { cv.setPointerCapture(e.pointerId); last = { x: e.clientX, y: e.clientY }; });
  cv.addEventListener('pointermove', (e) => { if (!last) return; const dx = e.clientX - last.x, dy = e.clientY - last.y; last = { x: e.clientX, y: e.clientY }; R = mul(mul(rotY(dx * 0.012), rotX(dy * 0.012)), R); draw(); });
  const stop = () => { last = null; }; cv.addEventListener('pointerup', stop); cv.addEventListener('pointercancel', stop);
  cv.addEventListener('keydown', (e) => { const mm: Record<string, M3> = { ArrowLeft: rotY(-0.15), ArrowRight: rotY(0.15), ArrowUp: rotX(-0.15), ArrowDown: rotX(0.15) }; if (mm[e.key]) { e.preventDefault(); R = mul(mm[e.key], R); draw(); } });
  new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

  // Check yourself.
  let quiz: { name: string; polar: boolean; why: string; shape: string }[] = [];
  function newQuiz() {
    const pool = [...PRESETS].sort(() => Math.random() - 0.5);
    const pick = [pool.find((p) => MEASURED[p.id] > 0)!, pool.find((p) => MEASURED[p.id] === 0)!];
    for (const p of pool) { if (pick.length >= 4) break; if (!pick.includes(p)) pick.push(p); }
    pick.sort(() => Math.random() - 0.5);
    quiz = pick.map((p) => { const r = polarity(p.central, p.outer) as Polarity; return { name: r.name, polar: r.polar, why: r.why, shape: r.shape }; });
    q('.dp-qs').replaceChildren(...quiz.map((x, i) => {
      const d = document.createElement('div'); d.className = 'dp-q1';
      const lab = document.createElement('label'); lab.textContent = `${i + 1}. Is ${x.name} polar?`;
      const sel = document.createElement('select'); sel.className = 'dp-qa'; sel.innerHTML = '<option value="">Choose</option><option value="polar">Polar</option><option value="non-polar">Non-polar</option>';
      lab.append(sel); const p = document.createElement('p'); p.className = 'dp-ans'; p.hidden = true; d.append(lab, p); return d;
    }));
    q('.dp-score').textContent = '';
  }
  q('.dp-check').addEventListener('click', () => {
    let right = 0;
    root.querySelectorAll<HTMLElement>('.dp-q1').forEach((d, i) => {
      const v = d.querySelector<HTMLSelectElement>('select')!.value, p = d.querySelector<HTMLElement>('.dp-ans')!, x = quiz[i], ans = x.polar ? 'polar' : 'non-polar';
      const ok = v === ans; if (ok) right++;
      p.hidden = false; p.className = 'dp-ans ' + (ok ? 'ok' : 'no');
      p.textContent = `${ok ? '✓ Right:' : v ? '✗ No, it is' : '✗ No answer yet. It is'} ${ans}. ${x.name} is ${x.shape}. ${x.why}`;
    });
    q('.dp-score').textContent = `${right} of ${quiz.length} right`;
  });
  q('.dp-new').addEventListener('click', newQuiz);

  root.classList.add('basic');
  setPreset('h2o'); newQuiz();
</script>
