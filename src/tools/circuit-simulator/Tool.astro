---
// SPICE-like linear circuit simulator: R, C, L, V and I sources; DC operating point, AC sweep, transient. Examples made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
import { EXAMPLES } from '../../lib/sci/eng-circuit';
const first = EXAMPLES.rc;
---
<div class="ax csim">
  <div class="ax-card">
    <h2>Circuit</h2>
    <label>Example <select class="cs-ex">
      {Object.entries(EXAMPLES).map(([k, e]) => <option value={k} selected={k === 'rc'}>{e.name}</option>)}
    </select></label>
    <label style="margin-top:10px;display:block">Netlist, one part per line <textarea class="cs-net" rows="8" spellcheck="false" autocapitalize="off" autocomplete="off">{first.text}</textarea></label>
    <DataFile target=".cs-net" maxCols={20} maxRows={500} label="Open a netlist" />
    <p class="ax-help">Each line is <code>name node node value</code>. Names start with <b>R</b> (resistor), <b>C</b> (capacitor), <b>L</b> (inductor), <b>V</b> (voltage source) or <b>I</b> (current source). Node <b>0</b> (or gnd) is ground. Values take SPICE letters: f p n u m k meg g (so 4.7k, 100n, 1meg). Sources: <code>DC 5</code>, <code>AC 1</code> (for the AC sweep), and for the transient <code>PULSE(v1 v2 delay rise fall width period)</code>, <code>SIN(offset amplitude frequency)</code> or <code>PWL(t1 v1 t2 v2 …)</code>. Lines starting with * are comments. The examples are made up.</p>
    <p class="ax-err cs-err" hidden></p>
    <p class="ax-help cs-warn" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Analysis</h2>
    <div class="ax-grid">
      <label>Run <select class="cs-an"><option value="op">DC operating point</option><option value="ac" selected>AC sweep (Bode plot)</option><option value="tran">Transient (voltage against time)</option></select></label>
      <label>Show the voltage at node <select class="cs-probe"></select></label>
      <label class="cs-acbox">Start frequency (Hz) <input class="cs-f1" type="text" inputmode="decimal" value="1" /></label>
      <label class="cs-acbox">Stop frequency (Hz) <input class="cs-f2" type="text" inputmode="decimal" value="100k" /></label>
      <label class="cs-acbox">Points per decade <input class="cs-ppd" type="text" inputmode="decimal" value="20" /></label>
      <label class="cs-trbox">Time step <input class="cs-h" type="text" inputmode="decimal" value="10u" /></label>
      <label class="cs-trbox">Stop time <input class="cs-tstop" type="text" inputmode="decimal" value="10m" /></label>
      <label class="cs-trbox">Method <select class="cs-meth"><option value="trap" selected>Trapezoidal (accurate)</option><option value="be">Backward Euler (no ringing on steps)</option></select></label>
      <label class="cs-trbox">Also show node <select class="cs-probe2"></select></label>
    </div>
    <p class="ax-help cs-anhelp"></p>
  </div>

  <div class="ax-card cs-out">
    <h2>Result</h2>
    <p class="ax-big cs-big"></p>
    <dl class="ax-facts cs-facts"></dl>
    <canvas class="ax-fig cs-fig1"></canvas>
    <canvas class="ax-fig cs-fig2"></canvas>
    <div class="ax-scroll"><table class="cs-tab"></table></div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small cs-csv">Download data (CSV)</button></div>
    <p class="ax-help">A teaching and sanity-check simulator for linear circuits, for study and planning, not a substitute for professional judgement. Real parts have tolerances, resistance in wires and capacitors, and limits that this model leaves out.</p>
    <Downloads />
  </div>
</div>

<script>
  import { parseNetlist, parseValue, dcOp, acSweep, bode, crossings, refinePeak, logFreqs, transient, eng, EXAMPLES, type Netlist } from '../../lib/sci/eng-circuit';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, fileSafe, type Figure, type Section } from '../../lib/report';
  import { csv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.csim')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  const val = (c: string) => parseValue(q<HTMLInputElement>(c).value);
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const fx = (x: number, d: number) => { const t = x.toFixed(d); return (/^-0\.?0*$/.test(t) ? t.slice(1) : t).replace('-', '−'); };
  let figs: [Figure | null, Figure | null] = [null, null], sections: Section[] = [], rows: (string | number)[][] = [], fileTag = 'circuit';

  function fillProbes(nl: Netlist) {
    for (const [c, none] of [['.cs-probe', false], ['.cs-probe2', true]] as const) {
      const s = q<HTMLSelectElement>(c), keep = s.dataset.want ?? s.value;
      const opts = (none ? ['(none)'] : []).concat(nl.nodes);
      if (s.options.length !== opts.length || [...s.options].some((o, i) => o.value !== opts[i])) s.replaceChildren(...opts.map((n) => { const o = document.createElement('option'); o.value = n === '(none)' ? '' : n; o.textContent = n; return o; }));
      if ([...s.options].some((o) => o.value === keep)) s.value = keep;
      delete s.dataset.want;
    }
  }
  const tUnit = (tmax: number): [number, string] => (tmax < 1e-6 ? [1e9, 'ns'] : tmax < 1e-3 ? [1e6, 'µs'] : tmax < 1 ? [1e3, 'ms'] : [1, 's']);
  function table(head: string[], body: string[][]) {
    const t = q<HTMLTableElement>('.cs-tab'), tr = document.createElement('tr');
    head.forEach((h) => { const th = document.createElement('th'); th.textContent = h; tr.append(th); });
    t.replaceChildren(tr, ...body.map((r) => { const x = document.createElement('tr'); r.forEach((c, i) => { const td = document.createElement('td'); td.textContent = c; if (i) td.style.textAlign = 'right'; x.append(td); }); return x; }));
  }

  function run() {
    const err = q('.cs-err'), out = q('.cs-out'), warn = q('.cs-warn');
    const an = sel('.cs-an');
    root.querySelectorAll<HTMLElement>('.cs-acbox').forEach((e) => (e.hidden = an !== 'ac'));
    root.querySelectorAll<HTMLElement>('.cs-trbox').forEach((e) => (e.hidden = an !== 'tran'));
    q('.cs-anhelp').textContent = an === 'op' ? 'DC operating point: capacitors are open circuits and inductors short circuits; every source gives its DC value.'
      : an === 'ac' ? 'AC sweep: each source gives its AC value (amplitude and phase) at every frequency; DC values are ignored. With AC 1 at the input, the voltage at a node is the gain from the input.'
      : 'Transient: starts from the DC operating point with sources at their t = 0 values, then steps forward in time. Use a step at least 10 times shorter than the fastest change; sudden edges shorter than the step are spread over one step.';
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; sections = []; rows = []; };
    let nl: Netlist;
    try { nl = parseNetlist(q<HTMLTextAreaElement>('.cs-net').value); } catch (e) { warn.hidden = true; return fail((e as Error).message); }
    if (nl.nodes.length > 80) return fail(`The circuit has ${nl.nodes.length} nodes; the limit is 80.`);
    fillProbes(nl);
    const p = sel('.cs-probe'), p2 = sel('.cs-probe2');
    const notes = [...nl.warnings];
    const title = nl.title || 'Circuit';
    fileTag = fileSafe(title);
    try {
      const facts: HTMLElement[] = [];
      let f1: Figure | null = null, f2: Figure | null = null;
      if (an === 'op') {
        const r = dcOp(nl);
        notes.push(...r.notes);
        q('.cs-big').textContent = `V(${p}) = ${eng(r.v[p], 'V')}`;
        const src = r.elems.filter((e) => e.kind === 'V' || e.kind === 'I');
        const pd = src.reduce((s, e) => s - e.p, 0), pr = r.elems.filter((e) => e.kind === 'R').reduce((s, e) => s + e.p, 0);
        facts.push(fact('Power from the sources', eng(pd, 'W'), `taken by the resistors: ${eng(pr, 'W')}`));
        for (const e of src) facts.push(fact(e.name, e.kind === 'V' ? `${eng(-e.i, 'A')} out of its + end` : `${eng(e.v, 'V')} across it`, e.p < 0 ? `delivers ${eng(-e.p, 'W')}` : `absorbs ${eng(e.p, 'W')}`));
        const body = [...nl.nodes.map((n) => [`V(${n})`, eng(r.v[n], 'V'), '', '']), ...r.elems.map((e) => [e.name, eng(e.v, 'V'), e.kind === 'C' ? '0 (open at DC)' : eng(e.i, 'A'), eng(e.p, 'W')])];
        table(['Node or part', 'Voltage', 'Current (1st → 2nd node)', 'Power absorbed'], body);
        rows = [['item', 'voltage_V', 'current_A', 'power_W'], ...nl.nodes.map((n) => [`V(${n})`, r.v[n], '', '']), ...r.elems.map((e) => [e.name, e.v, e.i, e.p])];
        sections = [{ title: `${title}: DC operating point`, facts: facts.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.textContent!] as [string, string]), table: { head: ['Node or part', 'Voltage', 'Current', 'Power absorbed'], rows: body, align: ['l', 'r', 'r', 'r'] } }];
      } else if (an === 'ac') {
        const a = val('.cs-f1'), b = val('.cs-f2'), n = val('.cs-ppd');
        if (!(a > 0 && b > a)) return fail('Give a start frequency above zero and a stop frequency above it.');
        if (!(n >= 1 && n <= 200)) return fail('Give 1 to 200 points per decade.');
        if (Math.log10(b / a) * n > 5000) return fail('That is more than 5,000 frequencies; use fewer points per decade or a narrower range.');
        const r = acSweep(nl, logFreqs(a, b, Math.round(n))), bd = bode(r, p);
        let k = 0; bd.db.forEach((d, i) => { if (d > bd.db[k]) k = i; });
        let pk = bd.db[k], fk = r.f[k];
        if (k > 0 && k < r.f.length - 1) { const t = refinePeak(nl, p, r.f[k - 1], r.f[k + 1]); if (t.db > pk) { pk = t.db; fk = t.f; } }
        const x3 = crossings(r.f, bd.db, pk - 3.0103, nl, p);
        q('.cs-big').textContent = x3.length ? `V(${p}): −3 dB at ${x3.map((f) => eng(f, 'Hz')).join(' and ')}` : `V(${p}): ${fx(bd.db[0], 2)} dB at ${eng(a, 'Hz')} to ${fx(bd.db[bd.db.length - 1], 2)} dB at ${eng(b, 'Hz')}`;
        facts.push(fact('Highest gain', `${fx(pk, 2)} dB (× ${eng(10 ** (pk / 20))}) at ${eng(fk, 'Hz')}`, k === 0 || k === r.f.length - 1 ? 'at the end of the sweep' : 'a peak inside the sweep'));
        facts.push(fact('−3 dB points', x3.length ? x3.map((f) => eng(f, 'Hz')).join(', ') : 'none in this range', 'where the gain is 3 dB below its highest (half the power)'));
        if (x3.length === 2) facts.push(fact('Bandwidth', eng(x3[1] - x3[0], 'Hz'), `Q = centre ÷ bandwidth = ${(Math.sqrt(x3[0] * x3[1]) / (x3[1] - x3[0])).toPrecision(3)}`));
        facts.push(fact('At the ends', `${fx(bd.db[0], 2)} dB, ${fx(bd.phase[0], 1)}° at ${eng(a, 'Hz')}; ${fx(bd.db[bd.db.length - 1], 2)} dB, ${fx(bd.phase[bd.phase.length - 1], 1)}° at ${eng(b, 'Hz')}`));
        { const m = bd.db.length - 1, i0 = Math.max(0, m - Math.round(n)); const sl = (bd.db[m] - bd.db[i0]) / Math.log10(r.f[m] / r.f[i0]); facts.push(fact('Slope at the top end', `${fx(sl, 1)} dB per decade`, 'about −20 dB/decade per order of a low-pass')); }
        f1 = chartFigure({ w: 380, h: 220, xLabel: 'Frequency (Hz)', yLabel: `Gain at ${p} (dB)`, xLog: true, xMin: a, xMax: b, legend: 'none', series: [{ name: 'Gain', x: r.f, y: bd.db, mode: 'line', width: 2 }], marks: x3.map((f) => ({ kind: 'vline' as const, at: f, dash: [4, 3], label: '−3 dB' })) }, `Bode magnitude at node ${p}`);
        f2 = chartFigure({ w: 380, h: 200, xLabel: 'Frequency (Hz)', yLabel: 'Phase (°)', xLog: true, xMin: a, xMax: b, legend: 'none', series: [{ name: 'Phase', x: r.f, y: bd.phase, mode: 'line', width: 2 }] }, `Bode phase at node ${p}`);
        q<HTMLTableElement>('.cs-tab').replaceChildren();
        rows = [['frequency_Hz', ...nl.nodes.flatMap((nd) => [`V(${nd})_dB`, `V(${nd})_phase_deg`])]];
        const all = nl.nodes.map((nd) => bode(r, nd));
        r.f.forEach((f, i) => rows.push([+f.toPrecision(8), ...all.flatMap((x) => [+x.db[i].toFixed(6), +x.phase[i].toFixed(4)])]));
        sections = [{ title: `${title}: AC sweep at ${p}`, facts: facts.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), figure: f1 }, { title: 'Phase', figure: f2 }];
      } else {
        const h = val('.cs-h'), ts = val('.cs-tstop');
        if (!(h > 0)) return fail('Give a time step above zero, for example 10u for 10 µs.');
        if (!(ts > h)) return fail('Give a stop time longer than the time step.');
        const r = transient(nl, h, ts, sel('.cs-meth') as 'trap' | 'be');
        notes.push(...r.notes);
        const [sc, tu] = tUnit(ts), y = r.v[p], N = r.t.length, every = Math.max(1, Math.ceil(N / 1500));
        const idx: number[] = []; for (let i = 0; i < N; i += every) idx.push(i); if (idx[idx.length - 1] !== N - 1) idx.push(N - 1);
        let mn = Infinity, mx = -Infinity, s2 = 0, s1 = 0;
        for (let i = 0; i < N; i++) { const v = y[i]; mn = Math.min(mn, v); mx = Math.max(mx, v); s1 += v; s2 += v * v; }
        q('.cs-big').textContent = `V(${p}) from 0 to ${eng(ts, 's')}: ends at ${eng(y[N - 1], 'V')}`;
        facts.push(fact('Lowest and highest', `${eng(mn, 'V')} to ${eng(mx, 'V')}`, `peak to peak ${eng(mx - mn, 'V')}`));
        facts.push(fact('Average and RMS', `${eng(s1 / N, 'V')}, ${eng(Math.sqrt(s2 / N), 'V')}`, 'over the whole run'));
        facts.push(fact('Start', `${eng(y[0], 'V')}`, 'from the DC operating point at t = 0'));
        facts.push(fact('Steps', `${(N - 1).toLocaleString('en')} of ${eng(h, 's')}`, sel('.cs-meth') === 'trap' ? 'trapezoidal rule' : 'backward Euler'));
        const series = [{ name: `V(${p})`, x: idx.map((i) => r.t[i] * sc), y: idx.map((i) => y[i]), mode: 'line' as const, width: 2 }];
        if (p2 && p2 !== p) series.push({ name: `V(${p2})`, x: idx.map((i) => r.t[i] * sc), y: idx.map((i) => r.v[p2][i]), mode: 'line' as const, width: 1.5 });
        f1 = chartFigure({ w: 380, h: 240, xLabel: `Time (${tu})`, yLabel: 'Voltage (V)', xMin: 0, xMax: ts * sc, legend: series.length > 1 ? 'below' : 'none', series }, `Voltage at ${p} against time`);
        q<HTMLTableElement>('.cs-tab').replaceChildren();
        const parts = nl.elems.map((e) => e.name);
        rows = [['time_s', ...nl.nodes.map((nd) => `V(${nd})_V`), ...parts.map((e) => `I(${e})_A`)]];
        const cap = Math.max(1, Math.ceil(N / 20000));
        for (let i = 0; i < N; i += cap) rows.push([+r.t[i].toPrecision(10), ...nl.nodes.map((nd) => +r.v[nd][i].toPrecision(8)), ...parts.map((e) => +r.i[e][i].toPrecision(8))]);
        sections = [{ title: `${title}: transient at ${p}`, facts: facts.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), figure: f1 }];
      }
      err.hidden = true; out.hidden = false;
      q('.cs-facts').replaceChildren(...facts);
      figs = [f1, f2];
      for (const [c, f] of [['.cs-fig1', f1], ['.cs-fig2', f2]] as const) { const cv = q<HTMLCanvasElement>(c); cv.hidden = !f; if (f) paint(cv, f); }
      q('.cs-tab').closest<HTMLElement>('.ax-scroll')!.hidden = an !== 'op';
      warn.textContent = notes.join(' '); warn.hidden = !notes.length;
      if (notes.length) sections.push({ title: 'Notes', text: notes });
      sections.push({ title: 'Netlist', text: q<HTMLTextAreaElement>('.cs-net').value.trim().split('\n') });
    } catch (e) { warn.textContent = notes.join(' '); warn.hidden = !notes.length; return fail((e as Error).message); }
  }

  q('.cs-ex').addEventListener('change', () => {
    const e = EXAMPLES[sel('.cs-ex')];
    q<HTMLTextAreaElement>('.cs-net').value = e.text;
    q<HTMLSelectElement>('.cs-an').value = e.analysis;
    q<HTMLSelectElement>('.cs-probe').dataset.want = e.probe;
    q<HTMLSelectElement>('.cs-probe2').dataset.want = '';
    q<HTMLInputElement>('.cs-f1').value = eng(e.ac[0]).replace(/ /g, '').replace('µ', 'u').replace('M', 'meg');
    q<HTMLInputElement>('.cs-f2').value = eng(e.ac[1]).replace(/ /g, '').replace('µ', 'u').replace('M', 'meg');
    q<HTMLInputElement>('.cs-ppd').value = String(e.ac[2]);
    q<HTMLInputElement>('.cs-h').value = eng(e.tran[0]).replace(/ /g, '').replace('µ', 'u');
    q<HTMLInputElement>('.cs-tstop').value = eng(e.tran[1]).replace(/ /g, '').replace('µ', 'u');
    run();
  });
  let timer = 0;
  q('.cs-net').addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 300); });
  root.querySelectorAll('.ax-card:nth-child(2) input, .ax-card:nth-child(2) select').forEach((i) => { i.addEventListener('change', run); if (i.tagName === 'INPUT') i.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 300); }); });
  document.addEventListener('fibub:theme', () => { if (!q('.cs-out').hidden) { if (figs[0]) paint(q<HTMLCanvasElement>('.cs-fig1'), figs[0]); if (figs[1]) paint(q<HTMLCanvasElement>('.cs-fig2'), figs[1]); } });
  q<HTMLSelectElement>('.cs-probe').dataset.want = EXAMPLES.rc.probe;
  run();
  q('.cs-csv').addEventListener('click', () => { if (rows.length) save(new Blob([csv(rows)], { type: 'text/csv' }), `${fileTag}-${sel('.cs-an')}.csv`, 'text/csv'); });
  wireDownloads(q('.dl'), () => ({ title: 'Circuit simulation', subtitle: q('.cs-big').textContent ?? '', file: `${fileTag}-simulation`, sections }));
</script>

<style is:inline>
  .csim select, .csim input { max-width: 100%; }
  .csim .cs-net { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; width: 100%; }
  .csim .cs-tab { margin-top: 10px; }
  .csim .cs-tab td { white-space: nowrap; }
  .csim code { font-size: 13px; }
</style>
