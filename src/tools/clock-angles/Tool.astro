---
// Clock hand angles: drag the minute hand (the hour hand follows at 0.5° a minute) or type a time, and see the
// angle between the hands, how far each hand has turned, and when the hands next make a chosen angle.
// Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm ck">
  <div class="ax-card">
    <svg class="sm-fig ck-face" viewBox="0 0 300 300" role="img" aria-label="Clock face; drag the long hand to change the time" style="max-width:340px;margin:0 auto"></svg>
    <p class="ax-big ck-big" aria-live="polite" style="margin:8px 0 2px"></p>
    <p class="ck-sub" style="margin:0 0 8px"></p>
    <div class="ax-grid">
      <label>Hours <input type="number" class="ck-h" min="0" max="23" step="1" value="3" inputmode="numeric" /></label>
      <label>Minutes <input type="number" class="ck-m" min="0" max="59.99" step="any" value="30" inputmode="decimal" /></label>
    </div>
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn secondary small ck-step" data-d="-5">− 5 min</button>
      <button type="button" class="btn secondary small ck-step" data-d="1">+ 1 min</button>
      <button type="button" class="btn secondary small ck-step" data-d="5">+ 5 min</button>
      <button type="button" class="btn secondary small ck-step" data-d="60">+ 1 hour</button>
    </div>
    <div class="ax-row">
      <button type="button" class="btn secondary small ck-pre" data-t="3,0">3:00</button>
      <button type="button" class="btn secondary small ck-pre" data-t="6,0">6:00</button>
      <button type="button" class="btn secondary small ck-pre" data-t="9,45">9:45</button>
      <button type="button" class="btn secondary small ck-pre" data-t="2,20">2:20</button>
    </div>
    <p class="ax-err ck-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>How the angle is worked out</h2>
    <ul class="sm-steps ck-out"></ul>
  </div>

  <div class="ax-card">
    <h2>When do the hands make an angle?</h2>
    <div class="ax-grid"><label>Angle between the hands (°) <input type="number" class="ck-want" min="0" max="180" step="any" value="90" inputmode="decimal" /></label></div>
    <p class="sm-f ck-when"></p>
    <div class="ax-row"><button type="button" class="btn secondary small ck-next">Set the clock to the next one</button></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Set 3:00, then 3:30. The angle is not 0° at 3:30, because the hour hand has moved half way to 4.</li>
      <li>Drag the long hand once all the way round. The short hand moves one hour: 30°.</li>
      <li>Ask for 0°: the hands do not meet at 1:05 exactly but a little later. Why?</li>
      <li>How many times a day are the hands at right angles? Count the list for 12 hours, then double it.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <div class="ck-quiz"></div>
  </div>
</div>

<style is:inline>
  .ck .ck-rim { fill: var(--surface); stroke: var(--ink); stroke-width: 2.5; }
  .ck .ck-tk { stroke: var(--muted); stroke-width: 1.5; }
  .ck .ck-tk5 { stroke: var(--ink); stroke-width: 3; }
  .ck .ck-num { font: 600 15px system-ui, sans-serif; fill: var(--ink); }
  .ck .ck-hr { stroke: var(--ink); stroke-width: 7; stroke-linecap: round; }
  .ck .ck-mn { stroke: var(--accent); stroke-width: 5; stroke-linecap: round; cursor: grab; }
  .ck .ck-sec { fill: var(--accent-soft); stroke: var(--warn); stroke-width: 2; }
  .ck .ck-knob { fill: var(--accent); stroke: var(--surface); stroke-width: 2; cursor: grab; }
</style>

<script>
  import { hands, between, formula, timesAtAngle, clockText } from '../../lib/sci/clock-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.ck')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const face = q<SVGSVGElement>('.ck-face');
  const H = q<HTMLInputElement>('.ck-h'), M = q<HTMLInputElement>('.ck-m');
  const CX = 150, CY = 150, RR = 132;
  const P = (deg: number, r: number) => [CX + r * Math.sin((deg * Math.PI) / 180), CY - r * Math.cos((deg * Math.PI) / 180)];
  let total = 3 * 60 + 30; // minutes after 12:00, 0..720

  const set = (t: number) => { total = ((t % 720) + 720) % 720; const h = Math.floor(total / 60), m = Math.round((total - 60 * h) * 100) / 100; H.value = String(h === 0 ? 12 : h); M.value = String(m); draw(); };
  function read() {
    const h = Number(H.value), m = Number(M.value), err = q('.ck-err');
    const ok = H.value.trim() !== '' && M.value.trim() !== '' && Number.isInteger(h) && h >= 0 && h <= 23 && m >= 0 && m < 60;
    err.hidden = ok; if (!ok) err.textContent = 'Hours must be a whole number from 0 to 23 and minutes from 0 to just under 60.';
    if (ok) total = ((h % 12) * 60 + m) % 720;
    draw();
  }
  H.addEventListener('input', read); M.addEventListener('input', read);

  function draw() {
    const h = Math.floor(total / 60), m = total - 60 * h, hh = h === 0 ? 12 : h;
    const pos = hands(h, m), b = between(h, m), f = formula(h, m);
    face.replaceChildren();
    S('circle', { cx: CX, cy: CY, r: RR + 8, class: 'ck-rim' }, face);
    for (let i = 0; i < 60; i++) { const [x1, y1] = P(i * 6, RR), [x2, y2] = P(i * 6, i % 5 ? RR - 7 : RR - 14); S('line', { x1, y1, x2, y2, class: i % 5 ? 'ck-tk' : 'ck-tk5' }, face); }
    for (let i = 1; i <= 12; i++) { const [x, y] = P(i * 30, RR - 30); S('text', { x, y: y + 5, 'text-anchor': 'middle', class: 'ck-num' }, face, String(i)); }
    // Shade the smaller angle between the hands.
    const a1 = Math.min(pos.hour, pos.minute), a2 = Math.max(pos.hour, pos.minute), wrap = a2 - a1 > 180;
    const from = wrap ? a2 : a1, sweep = b.small, r0 = 46;
    if (sweep > 0.3) { const [sx, sy] = P(from, r0), [ex, ey] = P(from + sweep, r0); S('path', { d: `M ${CX} ${CY} L ${sx} ${sy} A ${r0} ${r0} 0 0 1 ${ex} ${ey} Z`, class: 'ck-sec' }, face); }
    const [mx, my] = P(pos.minute, RR - 18), [hx, hy] = P(pos.hour, RR - 58);
    S('line', { x1: CX, y1: CY, x2: hx, y2: hy, class: 'ck-hr' }, face);
    S('line', { x1: CX, y1: CY, x2: mx, y2: my, class: 'ck-mn' }, face);
    S('circle', { cx: mx, cy: my, r: 10, class: 'ck-knob' }, face);
    S('circle', { cx: CX, cy: CY, r: 5, class: 'sm-good' }, face);
    q('.ck-big').textContent = `${clockText(total)}: the hands are ${fmt(b.small, 2)}° apart`;
    q('.ck-sub').textContent = `The other way round it is ${fmt(b.reflex, 2)}° (a reflex angle). ${b.small === 90 ? 'A right angle.' : b.small === 180 ? 'A straight line.' : b.small === 0 ? 'The hands are on top of each other.' : b.small < 90 ? 'An acute angle.' : 'An obtuse angle.'}`;
    const mm = fmt(m, 2);
    q('.ck-out').replaceChildren(...[
      `The minute hand turns 360° in 60 minutes, which is 6° a minute. At ${mm} minutes it points ${mm} × 6° = ${fmt(pos.minute, 2)}° clockwise from 12.`,
      `The hour hand turns 360° in 12 hours: 30° an hour, which is 0.5° a minute. At ${hh % 12} h ${mm} min it points ${hh % 12} × 30° + ${mm} × 0.5° = ${fmt(pos.hour, 2)}° from 12.`,
      `Difference: |${fmt(pos.hour, 2)}° − ${fmt(pos.minute, 2)}°| = ${fmt(Math.abs(pos.hour - pos.minute), 2)}°${Math.abs(pos.hour - pos.minute) > 180 ? `, more than 180°, so the smaller angle is 360° − ${fmt(Math.abs(pos.hour - pos.minute), 2)}° = ${fmt(b.small, 2)}°` : ''}.`,
      `Shortcut: |30h − 5.5m| = |30 × ${hh % 12} − 5.5 × ${mm}| = ${fmt(f, 2)}°${f > 180 ? `, and 360° − ${fmt(f, 2)}° = ${fmt(b.small, 2)}°` : ''}.`,
      `Since 12:00 the minute hand has turned ${fmt(total * 6, 1)}° (${fmt(total / 60, 3)} full turns) and the hour hand ${fmt(total * 0.5, 1)}°.`,
    ].map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    when();
  }
  let nextT: number | null = null;
  function when() {
    const w = q<HTMLInputElement>('.ck-want'), a = Number(w.value), out = q('.ck-when');
    nextT = null;
    if (w.value.trim() === '' || !Number.isFinite(a) || a < 0 || a > 180) { out.textContent = 'Type an angle from 0° to 180°.'; return; }
    const ts = timesAtAngle(a);
    nextT = ts.find((t) => t > total + 1e-6) ?? ts[0] + 720;
    out.textContent = `In 12 hours the hands are ${fmt(a, 2)}° apart ${ts.length} times: ${ts.slice(0, 6).map(clockText).join(', ')}${ts.length > 6 ? ', ...' : ''}. In a whole day that is ${2 * ts.length} times. The next one after ${clockText(total)} is ${clockText(nextT)}.`;
  }
  q('.ck-want').addEventListener('input', when);
  q('.ck-next').addEventListener('click', () => { if (nextT !== null) set(nextT); });

  dragOn(face, (x, y) => { const [mx, my] = P(hands(0, total % 60).minute, RR - 18); return Math.hypot(x - mx, y - my) < 34 || Math.hypot(x - CX, y - CY) > 40 ? 'm' : null; },
    (_id, x, y) => {
      let a = (Math.atan2(x - CX, -(y - CY)) * 180) / Math.PI; if (a < 0) a += 360;
      const mNew = Math.round(a / 6 * 4) / 4, mOld = total % 60;
      let d = mNew - mOld; if (d > 30) d -= 60; if (d < -30) d += 60;
      set(total + d);
    });
  root.querySelectorAll<HTMLButtonElement>('.ck-step').forEach((b) => b.addEventListener('click', () => set(total + Number(b.dataset.d))));
  root.querySelectorAll<HTMLButtonElement>('.ck-pre').forEach((b) => b.addEventListener('click', () => { const [h, m] = b.dataset.t!.split(',').map(Number); set(h * 60 + m); }));
  draw();

  quiz(q('.ck-quiz'), () => {
    const out: Question[] = [];
    const h1 = randInt(1, 11);
    out.push({ q: `What is the smaller angle between the hands at ${h1}:00?`, want: [between(h1, 0).small], work: `Each hour mark is 30° apart: ${h1} × 30° = ${h1 * 30}°${h1 * 30 > 180 ? `, and 360° − ${h1 * 30}° = ${between(h1, 0).small}°` : ''}.` });
    const h2 = randInt(1, 11), m2 = [10, 15, 20, 30, 40, 45, 50][randInt(0, 6)], b2 = between(h2, m2).small, f2 = formula(h2, m2);
    out.push({ q: `What is the smaller angle between the hands at ${h2}:${String(m2).padStart(2, '0')}?`, want: [b2], work: `|30 × ${h2} − 5.5 × ${m2}| = ${fmt(f2, 1)}°${f2 > 180 ? `; 360° − ${fmt(f2, 1)}° = ${fmt(b2, 1)}°` : ''}. So the angle is ${fmt(b2, 1)}°.` });
    const m3 = randInt(2, 11) * 5;
    out.push({ q: `How many degrees does the minute hand turn in ${m3} minutes?`, want: [m3 * 6], work: `6° a minute: ${m3} × 6° = ${m3 * 6}°.` });
    const h4 = randInt(2, 8);
    out.push({ q: `How many degrees does the hour hand turn in ${h4} hours and 30 minutes?`, want: [h4 * 30 + 15], work: `30° an hour and 0.5° a minute: ${h4} × 30° + 30 × 0.5° = ${h4 * 30 + 15}°.` });
    return out;
  });
</script>
