---
// #T875 Gravel calculator
---
<div class="tool-ui gc">
  <section class="panel">
    <div class="gc-row">
      <label>Units
        <select data-k="units">
          <option value="m">Metric (m, mm)</option>
          <option value="ft">Imperial (ft, in)</option>
        </select>
      </label>
      <label><span class="gc-dl">Depth (mm)</span> <input data-k="depth" inputmode="decimal" value="75" /></label>
      <label>Extra for settling and spill (%) <input data-k="extra" inputmode="decimal" value="0" /></label>
    </div>
    <h3>Areas</h3>
    <div class="gc-areas"></div>
    <div class="gc-btns">
      <button type="button" class="gc-add">Add an area</button>
      <button type="button" class="gc-reset">Reset</button>
    </div>
  </section>
  <section class="panel">
    <div class="gc-row">
      <label>Material
        <select data-k="mat">
          <option value="1.6">Gravel or pea gravel (about 1.6 t/m³)</option>
          <option value="1.6">Crushed stone (about 1.6 t/m³)</option>
          <option value="1.6">Sand (about 1.6 t/m³)</option>
          <option value="1.3">Topsoil (about 1.3 t/m³)</option>
          <option value="0.4">Bark mulch (about 0.4 t/m³)</option>
        </select>
      </label>
      <label>Density (t/m³, ask your supplier) <input data-k="dens" inputmode="decimal" value="1.6" /></label>
      <label>Bag size
        <select data-k="bag">
          <option value="kg:25">25 kg bag</option>
          <option value="kg:20">20 kg bag</option>
          <option value="lb:50">50 lb bag</option>
          <option value="lb:40">40 lb bag</option>
          <option value="cf:1">1 cu ft bag</option>
          <option value="cf:2">2 cu ft bag</option>
          <option value="cf:3">3 cu ft bag</option>
        </select>
      </label>
    </div>
  </section>
  <section class="panel gc-res" aria-live="polite">
    <p class="gc-area"></p>
    <p class="gc-big gc-vol"></p>
    <p class="gc-wt"></p>
    <p class="gc-bags"></p>
    <p class="gc-say"></p>
  </section>
  <p class="gc-fine">Densities are approximate; loose stone, wet sand and fluffy mulch all weigh different amounts. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .gc { display: grid; gap: 14px; margin-bottom: 32px; }
  .gc .panel { padding: 16px; }
  .gc h3 { font-size: 16px; margin: 16px 0 8px; }
  .gc-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .gc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .gc input, .gc select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .gc input:focus, .gc select:focus { border-color: var(--accent); outline: none; }
  .gc-areas { display: grid; gap: 10px; }
  .gc-a { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 130px), 1fr)); gap: 8px; align-items: end; padding: 10px; border: 1px solid var(--line); border-radius: 10px; }
  .gc button { font: inherit; font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .gc .gc-add { border-color: var(--accent); color: var(--accent); }
  .gc-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .gc-res p { margin: 4px 0; overflow-wrap: anywhere; }
  .gc-big { font-size: 24px; font-weight: 700; }
  .gc-say, .gc-fine { color: var(--muted); font-size: 14px; }
  .gc-fine { margin: 0; font-size: 13px; }
</style>

<script>
  const root = document.querySelector('.gc') as HTMLElement;
  const el = (k: string) => root.querySelector(`[data-k="${k}"]`) as HTMLInputElement;
  const list = root.querySelector('.gc-areas') as HTMLElement;
  const out = (c: string) => root.querySelector('.' + c) as HTMLElement;
  const n = (v: number, d = 2) => v.toLocaleString('en-US', { maximumFractionDigits: d });
  const FT = 0.3048, IN = 0.0254, FT3 = FT ** 3, YD3 = 0.9144 ** 3, LB = 0.45359237, USTON = 907.18474;
  const SHAPES: Record<string, string[]> = { rect: ['Length', 'Width'], circle: ['Diameter'], tri: ['Base', 'Height'] };
  const num = (s: string) => (s.trim() === '' ? NaN : Number(s));

  const addArea = (shape = 'rect', vals: string[] = []) => {
    const box = document.createElement('div'); box.className = 'gc-a';
    const lab = document.createElement('label'); lab.append('Shape');
    const sel = document.createElement('select'); sel.className = 'gc-shape';
    for (const [v, t] of [['rect', 'Rectangle'], ['circle', 'Circle'], ['tri', 'Triangle']]) { const o = document.createElement('option'); o.value = v; o.textContent = t; sel.append(o); }
    sel.value = shape; lab.append(sel); box.append(lab);
    const dims = document.createElement('div'); dims.style.display = 'contents'; box.append(dims);
    const draw = (keep: string[]) => {
      dims.innerHTML = '';
      SHAPES[sel.value].forEach((name, i) => {
        const l = document.createElement('label'); l.append(`${name} (${el('units').value})`);
        const inp = document.createElement('input'); inp.className = 'gc-d'; inp.inputMode = 'decimal'; inp.value = keep[i] ?? '';
        inp.addEventListener('input', calc); l.append(inp); dims.append(l);
      });
    };
    sel.addEventListener('change', () => { draw([]); calc(); });
    const rm = document.createElement('button'); rm.type = 'button'; rm.textContent = 'Remove'; rm.className = 'gc-rm';
    rm.addEventListener('click', () => { box.remove(); calc(); });
    draw(vals); box.append(rm); list.append(box);
  };

  const calc = () => {
    const metric = el('units').value === 'm';
    const L = metric ? 1 : FT, D = metric ? 0.001 : IN;
    let area = 0, bad = false;
    list.querySelectorAll('.gc-a').forEach((box) => {
      const shape = (box.querySelector('.gc-shape') as HTMLSelectElement).value;
      const d = [...box.querySelectorAll('.gc-d')].map((i) => num((i as HTMLInputElement).value) * L);
      if (d.some((x) => !Number.isFinite(x) || x < 0)) { bad = true; return; }
      area += shape === 'rect' ? d[0] * d[1] : shape === 'circle' ? Math.PI * (d[0] / 2) ** 2 : 0.5 * d[0] * d[1];
    });
    const depth = num(el('depth').value) * D, extra = num(el('extra').value) || 0, dens = num(el('dens').value);
    const clear = (msg: string) => { for (const c of ['gc-area', 'gc-vol', 'gc-wt', 'gc-bags']) out(c).textContent = ''; out('gc-say').textContent = msg; };
    if (bad || !list.children.length || !Number.isFinite(depth) || depth <= 0) return clear('Type the size of each area and the depth.');
    const vol = area * depth * (1 + extra / 100);
    out('gc-area').textContent = metric ? `Area: ${n(area)} m²` : `Area: ${n(area / FT ** 2)} sq ft`;
    out('gc-vol').textContent = `${n(vol, 3)} m³ · ${n(vol / YD3, 3)} yd³ · ${n(vol / FT3, 2)} ft³`;
    if (!Number.isFinite(dens) || dens <= 0) { out('gc-wt').textContent = ''; out('gc-bags').textContent = ''; out('gc-say').textContent = 'Type a density to see the weight.'; return; }
    const kg = vol * dens * 1000;
    out('gc-wt').textContent = `Weight: ${n(kg / 1000, 2)} t (tonnes) · ${n(kg / USTON, 2)} US tons · ${n(kg, 0)} kg · ${n(kg / LB, 0)} lb`;
    const [kind, size] = el('bag').value.split(':'), s = +size;
    const each = kind === 'kg' ? s : kind === 'lb' ? s * LB : s * FT3;
    const bags = Math.ceil((kind === 'cf' ? vol : kg) / each - 1e-9);
    const bagName = kind === 'cf' ? `${s} cu ft` : `${s} ${kind}`;
    out('gc-bags').textContent = `${n(bags, 0)} bags of ${bagName}`;
    out('gc-say').textContent = `Area × depth${extra ? ` + ${n(extra)}% extra` : ''} = volume; volume × ${n(dens, 3)} t/m³ = weight. ${kind === 'cf' ? 'Bags are counted by volume.' : 'Bags are counted by weight.'} Bulk loads are often sold by the tonne or cubic yard.`;
  };

  const setUnits = (u: string, convert: boolean) => {
    const toFt = u === 'ft';
    if (convert) {
      list.querySelectorAll('.gc-d').forEach((i) => { const x = num((i as HTMLInputElement).value); if (Number.isFinite(x)) (i as HTMLInputElement).value = String(+(toFt ? x / FT : x * FT).toFixed(2)); });
      const d = num(el('depth').value); if (Number.isFinite(d)) el('depth').value = String(+(toFt ? d / 25.4 : d * 25.4).toFixed(toFt ? 2 : 0));
    }
    (root.querySelector('.gc-dl') as HTMLElement).textContent = toFt ? 'Depth (in)' : 'Depth (mm)';
    list.querySelectorAll('.gc-a').forEach((box) => box.querySelectorAll('label').forEach((l, i) => { if (i) l.firstChild!.textContent = l.firstChild!.textContent!.replace(/\((m|ft)\)/, `(${u})`); }));
  };
  el('units').addEventListener('change', () => { setUnits(el('units').value, true); calc(); });
  el('mat').addEventListener('change', () => { el('dens').value = el('mat').value; calc(); });
  for (const k of ['depth', 'extra', 'dens', 'bag']) el(k).addEventListener(k === 'bag' ? 'change' : 'input', calc);
  (root.querySelector('.gc-add') as HTMLElement).addEventListener('click', () => { addArea(); calc(); });
  const reset = () => {
    list.innerHTML = ''; el('units').value = 'm'; setUnits('m', false);
    el('depth').value = '75'; el('extra').value = '0'; el('mat').selectedIndex = 0; el('dens').value = '1.6'; el('bag').selectedIndex = 0;
    addArea('rect', ['5', '2']); calc();
  };
  (root.querySelector('.gc-reset') as HTMLElement).addEventListener('click', reset);
  reset();
</script>
