,-78.607426,168.1\n2026-06-14T07:57:10Z,44.250611,-78.607136,168.6\n2026-06-14T07:57:20Z,44.250522,-78.606830,167.9\n2026-06-14T07:57:30Z,44.250446,-78.606512,167.1\n2026-06-14T07:57:40Z,44.250367,-78.606209,168.4\n2026-06-14T07:57:50Z,44.250298,-78.605896,167.7\n2026-06-14T07:58:00Z,44.250240,-78.605598,168.9\n2026-06-14T07:58:10Z,44.250195,-78.605283,169.2\n2026-06-14T07:58:20Z,44.250147,-78.604973,168.7\n2026-06-14T07:58:30Z,44.250107,-78.604645,169.3\n2026-06-14T07:58:40Z,44.250077,-78.604333,169.9\n2026-06-14T07:58:50Z,44.250039,-78.604019,171.0\n2026-06-14T07:59:00Z,44.250025,-78.603703,171.1\n2026-06-14T07:59:10Z,44.249994,-78.603380,172.1\n2026-06-14T07:59:20Z,44.249980,-78.603051,172.9\n2026-06-14T07:59:30Z,44.249973,-78.602735,172.7\n2026-06-14T07:59:40Z,44.249957,-78.602414,175.0\n2026-06-14T07:59:50Z,44.249961,-78.602091,175.1\n2026-06-14T08:00:00Z,44.249951,-78.601770,176.2\n2026-06-14T08:00:10Z,44.249958,-78.601435,177.4\n2026-06-14T08:00:20Z,44.249960,-78.601112,177.7\n2026-06-14T08:00:30Z,44.249966,-78.600787,179.7\n2026-06-14T08:00:40Z,44.249985,-78.600456,181.3\n2026-06-14T08:00:50Z,44.249995,-78.600124,181.1\n2026-06-14T08:01:00Z,44.250000,-78.600000,182.0';
---
<div class="ax gpa">
  <div class="ax-card">
    <h2>Track</h2>
    <div class="ax-row">
      <button type="button" class="btn secondary small gp-open">Open a GPX or CSV file</button>
      <input type="file" class="gp-in" accept=".gpx,.csv,.tsv,.txt,application/gpx+xml,text/csv,text/plain" hidden />
      <span class="ax-help" style="margin:0">GPX, CSV or TXT, up to 50 MB</span>
    </div>
    <p class="ax-help"><strong>Your file stays on this device.</strong> This page reads it in your browser; nothing is uploaded or saved.</p>
    <p class="ax-help gp-note" hidden></p>
    <label>Or paste time, lat, lon, elevation (CSV with a header row), or GPX text <textarea class="gp-data" rows="6" spellcheck="false">{demo}</textarea></label>
    <div class="ax-grid" style="margin-top:10px">
      <label>Units <select class="gp-units"><option value="km" selected>km, m, km/h</option><option value="mi">miles, feet, mph</option></select></label>
      <label>Distance on <select class="gp-ell"><option value="1" selected>WGS84 ellipsoid (Vincenty)</option><option value="0">Sphere (haversine)</option></select></label>
      <label>Counts as stopped below (km/h or mph) <input class="gp-stop" type="text" inputmode="decimal" value="1.5" /></label>
      <label>Ignore jumps faster than (km/h or mph) <input class="gp-spike" type="text" inputmode="decimal" value="250" /></label>
      <label>Count climbing in steps of (m or ft) <input class="gp-step" type="text" inputmode="decimal" value="5" /></label>
      <label>Thin points closer than (m or ft to the line; 0: off) <input class="gp-thin" type="text" inputmode="decimal" value="0" /></label>
    </div>
    <p class="ax-err gp-err" hidden></p>
  </div>

  <div class="ax-card gp-out">
    <h2>Summary</h2>
    <p class="ax-big gp-big"></p>
    <dl class="ax-facts gp-facts"></dl>
    <canvas class="ax-fig gp-map"></canvas>
    <canvas class="ax-fig gp-ele"></canvas>
    <canvas class="ax-fig gp-spd"></canvas>
    <h3>Splits</h3>
    <div class="ax-scroll gp-scroll"><table class="gp-tab"></table></div>
    <p class="ax-help">The plan is a simple flat projection with no map underneath. GPS heights are rough; the climbing step hides small ups and downs that are only noise.</p>
    <Downloads />
  </div>
</div>

<script>
  import { analyse, splits, thin, parseTime, fmtDuration, R_MEAN, type Pt } from '../../lib/sci/gpstrack';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, type Figure, type Section } from '../../lib/report';
  import { num, parseTable, sig } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.gpa')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const val = (c: string) => num(q<HTMLInputElement>(c).value);
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const MAX_BYTES = 50e6, MAX_POINTS = 500000;
  let filePts: Pt[] | null = null, figs: Record<string, Figure> = {}, report: Section[] = [];

  /** Points from GPX text: each trkseg is a segment; routes (rtept) if there is no track. */
  function fromGpx(text: string): Pt[] {
    const doc = new DOMParser().parseFromString(text, 'application/xml');
    if (doc.getElementsByTagName('parsererror').length) throw new Error('This GPX file could not be read (it is not valid XML).');
    const pts: Pt[] = [];
    const read = (el: Element, seg: number) => {
      const lat = num(el.getAttribute('lat')), lon = num(el.getAttribute('lon'));
      if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;
      const e = el.getElementsByTagName('ele')[0]?.textContent, t = el.getElementsByTagName('time')[0]?.textContent;
      pts.push({ lat, lon, ele: e != null ? num(e) : undefined, t: t != null ? parseTime(t) : undefined, seg });
    };
    let seg = 0;
    for (const s of Array.from(doc.getElementsByTagName('trkseg'))) { for (const p of Array.from(s.getElementsByTagName('trkpt'))) read(p, seg); seg++; }
    if (!pts.length) for (const r of Array.from(doc.getElementsByTagName('rte'))) { for (const p of Array.from(r.getElementsByTagName('rtept'))) read(p, seg); seg++; }
    return pts;
  }

  /** Points from a CSV or pasted table, with columns found by their names. */
  function fromTable(text: string): Pt[] {
    const rows = parseTable(text);
    if (!rows.length) return [];
    const h = rows[0].map((c) => c.toLowerCase());
    const find = (re: RegExp) => h.findIndex((c) => re.test(c));
    let iT = find(/^(time|date|timestamp|datetime|utc)/), iLa = find(/^lat/), iLo = find(/^(lon|lng|long)/), iE = find(/^(ele|elev|alt|height)/), iS = find(/^(seg|segment|track|lap)/);
    let body = rows.slice(1);
    if (iLa < 0 || iLo < 0) {
      body = rows;
      const w = rows[0].length;
      if (w >= 4 && Number.isFinite(parseTime(rows[0][0])) && !Number.isFinite(num(rows[0][0]))) { iT = 0; iLa = 1; iLo = 2; iE = 3; } else if (w >= 2) { iT = -1; iLa = 0; iLo = 1; iE = w >= 3 ? 2 : -1; }
      iS = -1;
    }
    const pts: Pt[] = []; let lastSeg = '', seg = 0;
    for (const r of body) {
      const lat = num(r[iLa]), lon = num(r[iLo]);
      if (!(Math.abs(lat) <= 90 && Math.abs(lon) <= 180)) continue;
      if (iS >= 0) { if (pts.length && r[iS] !== lastSeg) seg++; lastSeg = r[iS]; }
      pts.push({ lat, lon, ele: iE >= 0 ? num(r[iE]) : undefined, t: iT >= 0 ? parseTime(r[iT]) : undefined, seg });
    }
    return pts;
  }

  const parse = (text: string) => (/^\s*(<\?xml|<gpx)/i.test(text) ? fromGpx(text) : fromTable(text));

  function calc() {
    const err = q('.gp-err'), out = q('.gp-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; };
    let pts: Pt[];
    try { pts = filePts ?? parse(q<HTMLTextAreaElement>('.gp-data').value); } catch (e) { return fail((e as Error).message); }
    if (pts.length > MAX_POINTS) return fail(`This track has ${pts.length.toLocaleString('en')} points; the limit is ${MAX_POINTS.toLocaleString('en')}.`);
    if (pts.length < 2) return fail('No track found. Open a GPX file, or paste a table with lat and lon columns (and time and elevation if you have them).');
    const mi = q<HTMLSelectElement>('.gp-units').value === 'mi';
    const U = mi ? { d: 1609.344, dl: 'mi', h: 0.3048, hl: 'ft', v: 0.44704, vl: 'mph' } : { d: 1000, dl: 'km', h: 1, hl: 'm', v: 1 / 3.6, vl: 'km/h' };
    const stop = val('.gp-stop') * U.v, spike = val('.gp-spike') * U.v, step = val('.gp-step') * U.h, tol = val('.gp-thin') * U.h;
    if (!(stop >= 0 && spike > stop && step >= 0 && tol >= 0)) return fail('Check the settings: the jump limit must be above the stopped speed, and the others zero or more.');
    // Points with a time must be in time order; drop exact repeats of time.
    const timed = pts.every((p) => Number.isFinite(p.t));
    if (!timed && pts.some((p) => Number.isFinite(p.t))) pts = pts.map((p) => ({ ...p, t: undefined }));
    if (timed) { pts = pts.slice().sort((a, b) => a.seg - b.seg || a.t! - b.t!); pts = pts.filter((p, i) => i === 0 || p.t !== pts[i - 1].t || p.seg !== pts[i - 1].seg); }
    const before = pts.length;
    if (tol > 0) pts = thin(pts, tol);
    const ell = q<HTMLSelectElement>('.gp-ell').value === '1';
    const a = analyse(pts, { moveSpeed: stop, spikeSpeed: spike, eleStep: step, ellipsoid: ell });
    const other = analyse(pts, { moveSpeed: stop, spikeSpeed: spike, eleStep: step, ellipsoid: !ell });
    err.hidden = true; out.hidden = false;
    const D = (m: number) => `${(m / U.d).toFixed(2)} ${U.dl}`, H = (m: number) => `${Math.round(m / U.h)} ${U.hl}`, V = (v: number) => `${(v / U.v).toFixed(1)} ${U.vl}`;
    const pace = (v: number) => (v > 0 ? `${fmtDuration(U.d / v)} /${U.dl}` : '–');
    const hasEle = Number.isFinite(a.eMin);
    q('.gp-big').textContent = a.timed ? `${D(a.dist)} in ${fmtDuration(a.moving)} moving (${pace(a.avgMoving)})` : `${D(a.dist)} (no times in this track)`;
    const f: HTMLElement[] = [fact('Distance', D(a.dist), `${ell ? 'on the WGS84 ellipsoid' : 'on a sphere'}; the ${ell ? 'sphere' : 'ellipsoid'} gives ${D(other.dist)}`)];
    if (a.timed) {
      f.push(fact('Time', `${fmtDuration(a.elapsed)} in all`, `${fmtDuration(a.moving)} moving, ${fmtDuration(a.elapsed - a.moving)} stopped (slower than ${sig(stop / U.v, 3)} ${U.vl})`));
      f.push(fact('Average speed', `${V(a.avgMoving)} moving`, `${pace(a.avgMoving)}; ${V(a.avg)} including stops`));
      f.push(fact('Fastest', V(a.maxV), 'between two points, after skipping jumps'));
    }
    if (hasEle) f.push(fact('Climbing', `+${H(a.gain)} / −${H(a.loss)}`, `lowest ${H(a.eMin)}, highest ${H(a.eMax)}; counted in steps of ${sig(step / U.h, 3)} ${U.hl}`));
    const segs = new Set(pts.map((p) => p.seg)).size;
    f.push(fact('Points', `${pts.length.toLocaleString('en')}`, `${segs} segment${segs > 1 ? 's' : ''}${a.spikes ? `; ${a.spikes} jump${a.spikes > 1 ? 's' : ''} skipped` : ''}${tol > 0 ? `; thinned from ${before.toLocaleString('en')}` : ''}`));
    q('.gp-facts').replaceChildren(...f);
    // Plan: equirectangular around the middle latitude.
    const lat0 = pts.reduce((s, p) => s + p.lat, 0) / pts.length, kx = Math.cos((lat0 * Math.PI) / 180);
    const xs = pts.map((p) => p.lon * kx), ys = pts.map((p) => p.lat);
    const good = pts.map((_, i) => i === 0 || Number.isFinite(a.speed[i]) || !a.timed || pts[i].seg !== pts[i - 1].seg);
    if (!a.timed) for (let i = 1; i < pts.length; i++) good[i] = a.cum[i] > a.cum[i - 1] || pts[i].seg !== pts[i - 1].seg;
    const gx = xs.filter((_, i) => good[i]), gy = ys.filter((_, i) => good[i]);
    const bx0 = Math.min(...gx), bx1 = Math.max(...gx), by0 = Math.min(...gy), by1 = Math.max(...gy);
    const spanM = Math.max(bx1 - bx0, by1 - by0) * (R_MEAN * Math.PI) / 180;
    const bar = [1, 2, 5].flatMap((m) => [m, m * 10, m * 100, m * 1000, m * 10000, m * 100000]).sort((p, r) => p - r).filter((m) => m <= spanM / 3).pop() ?? 1;
    figs.map = { w: 380, h: 320, alt: `Plan of the track: ${D(a.dist)}, start and finish marked`, draw: (ctx, W, Hh, pal) => {
      const pad = 18, s = Math.min((W - 2 * pad) / (bx1 - bx0 || 1e-9), (Hh - 2 * pad - 14) / (by1 - by0 || 1e-9));
      const ox = (W - s * (bx1 - bx0)) / 2, oy = (Hh - 14 + s * (by1 - by0)) / 2;
      const X = (x: number) => ox + (x - bx0) * s, Y = (y: number) => oy - (y - by0) * s;
      ctx.strokeStyle = pal.accent; ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.beginPath();
      let pen = false;
      pts.forEach((p, i) => { if (!good[i]) return; if (i > 0 && pts[i].seg !== pts[i - 1].seg) pen = false; if (pen) ctx.lineTo(X(xs[i]), Y(ys[i])); else { ctx.moveTo(X(xs[i]), Y(ys[i])); pen = true; } });
      ctx.stroke();
      // Distance markers every whole unit.
      ctx.font = '9px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      let k = 1;
      for (let i = 1; i < pts.length && k * U.d <= a.dist; i++) if (a.cum[i] >= k * U.d && good[i]) { ctx.fillStyle = pal.bg; ctx.beginPath(); ctx.arc(X(xs[i]), Y(ys[i]), 7, 0, 7); ctx.fill(); ctx.strokeStyle = pal.ink; ctx.lineWidth = 1; ctx.stroke(); ctx.fillStyle = pal.ink; ctx.fillText(String(k), X(xs[i]), Y(ys[i]) + 0.5); k++; }
      const fi = good.lastIndexOf(true);
      ctx.fillStyle = pal.good; ctx.beginPath(); ctx.arc(X(xs[0]), Y(ys[0]), 5, 0, 7); ctx.fill();
      ctx.strokeStyle = pal.bad; ctx.lineWidth = 2; ctx.beginPath(); ctx.rect(X(xs[fi]) - 4, Y(ys[fi]) - 4, 8, 8); ctx.stroke();
      ctx.strokeStyle = pal.ink; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(W - 14, 30); ctx.lineTo(W - 14, 10); ctx.lineTo(W - 18, 16); ctx.moveTo(W - 14, 10); ctx.lineTo(W - 10, 16); ctx.stroke(); ctx.fillStyle = pal.ink; ctx.fillText('N', W - 14, 38);
      const bw = (bar / ((R_MEAN * Math.PI) / 180)) * s, ly = Hh - 8;
      ctx.beginPath(); ctx.moveTo(8, ly - 4); ctx.lineTo(8, ly); ctx.lineTo(8 + bw, ly); ctx.lineTo(8 + bw, ly - 4); ctx.stroke();
      ctx.textAlign = 'left'; ctx.fillText(bar >= 1000 ? `${bar / 1000} km` : `${bar} m`, 12 + bw, ly - 2);
      ctx.fillStyle = pal.good; ctx.beginPath(); ctx.arc(W - 120, ly - 2, 4, 0, 7); ctx.fill(); ctx.fillStyle = pal.ink; ctx.fillText('start', W - 113, ly - 2);
      ctx.strokeStyle = pal.bad; ctx.lineWidth = 2; ctx.strokeRect(W - 70, ly - 6, 7, 7); ctx.fillText('finish', W - 59, ly - 2);
    } };
    paint(q<HTMLCanvasElement>('.gp-map'), figs.map);
    const dx = pts.map((_, i) => a.cum[i] / U.d);
    const ce = q<HTMLCanvasElement>('.gp-ele'), cs = q<HTMLCanvasElement>('.gp-spd');
    ce.hidden = !hasEle; cs.hidden = !a.timed;
    if (hasEle) { const idx = pts.map((_, i) => i).filter((i) => good[i] && Number.isFinite(pts[i].ele)); figs.ele = chartFigure({ w: 380, h: 220, xMin: 0, xLabel: `Distance (${U.dl})`, yLabel: `Elevation (${U.hl})`, series: [{ name: 'Elevation', x: idx.map((i) => dx[i]), y: idx.map((i) => pts[i].ele! / U.h), mode: 'line', width: 2 }] }, 'Elevation profile along the track'); paint(ce, figs.ele); } else delete figs.ele;
    if (a.timed) {
      const idx = pts.map((_, i) => i).filter((i) => Number.isFinite(a.speed[i]));
      const sm = idx.map((_, k) => { const w = idx.slice(Math.max(0, k - 2), k + 3); return w.reduce((s, i) => s + a.speed[i], 0) / w.length / U.v; });
      figs.spd = chartFigure({ w: 380, h: 220, xMin: 0, yMin: 0, xLabel: `Distance (${U.dl})`, yLabel: `Speed (${U.vl})`, legend: 'below', series: [{ name: 'Point to point', x: idx.map((i) => dx[i]), y: idx.map((i) => a.speed[i] / U.v), mode: 'line', width: 1 }, { name: 'Smoothed (5 points)', x: idx.map((i) => dx[i]), y: sm, mode: 'line', width: 2 }] }, 'Speed along the track');
      paint(cs, figs.spd);
    } else delete figs.spd;
    const sp = splits(pts, a.cum, U.d);
    const head = ['Split', `Distance (${U.dl})`, 'Time', 'Split time', `Pace (/${U.dl})`, `Speed (${U.vl})`];
    const rowsT = sp.map((s, i) => [String(i + 1), String(s.at / U.d), fmtDuration(s.time), fmtDuration(s.split), fmtDuration(s.split), (U.d / s.split / U.v).toFixed(1)]);
    if (a.timed && sp.length && a.dist - sp[sp.length - 1].at > 1) { const rest = a.dist - sp[sp.length - 1].at, tr = a.elapsed - sp[sp.length - 1].time; rowsT.push(['last', (a.dist / U.d).toFixed(2), fmtDuration(a.elapsed), fmtDuration(tr), tr > 0 ? fmtDuration((tr * U.d) / rest) : '–', tr > 0 ? (rest / tr / U.v).toFixed(1) : '–']); }
    const tab = q<HTMLTableElement>('.gp-tab'); tab.replaceChildren();
    q('.gp-scroll').previousElementSibling!.toggleAttribute('hidden', !rowsT.length); q('.gp-scroll').hidden = !rowsT.length;
    const hr = tab.createTHead().insertRow(); head.forEach((h) => { const th = document.createElement('th'); th.textContent = h; hr.append(th); });
    const bd = tab.createTBody(); rowsT.forEach((r) => { const tr = bd.insertRow(); r.forEach((v) => { tr.insertCell().textContent = v; }); });
    report = [{ title: q('.gp-big').textContent!, facts: f.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), figure: figs.map }];
    if (figs.ele) report.push({ title: 'Elevation', figure: figs.ele });
    if (figs.spd) report.push({ title: 'Speed', figure: figs.spd });
    if (rowsT.length) report.push({ title: 'Splits', table: { head, rows: rowsT, align: ['l', 'r', 'r', 'r', 'r', 'r'] } });
  }

  const input = q<HTMLInputElement>('.gp-in'), note = q('.gp-note');
  q('.gp-open').addEventListener('click', () => input.click());
  input.addEventListener('change', async () => {
    const f = input.files?.[0]; input.value = '';
    if (!f) return;
    if (f.size > MAX_BYTES) { note.hidden = false; note.textContent = `${f.name} is ${(f.size / 1e6).toFixed(1)} MB; the limit is 50 MB.`; return; }
    try {
      const pts = parse(await f.text());
      if (!pts.length) throw new Error(`No track points found in ${f.name}.`);
      filePts = pts; q<HTMLTextAreaElement>('.gp-data').value = '';
      note.textContent = `Opened ${f.name} on this device: ${pts.length.toLocaleString('en')} points. Type or paste in the box to use that instead.`; note.hidden = false;
    } catch (e) { note.textContent = (e as Error).message; note.hidden = false; return; }
    calc();
  });
  q('.gp-data').addEventListener('input', () => { filePts = null; note.hidden = true; });
  root.querySelectorAll('input:not([type=file]), textarea, select').forEach((i) => { i.addEventListener('input', calc); i.addEventListener('change', calc); });
  document.addEventListener('fibub:theme', () => { if (q('.gp-out').hidden) return; paint(q<HTMLCanvasElement>('.gp-map'), figs.map); if (figs.ele) paint(q<HTMLCanvasElement>('.gp-ele'), figs.ele); if (figs.spd) paint(q<HTMLCanvasElement>('.gp-spd'), figs.spd); });
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'GPS track', subtitle: q('.gp-big').textContent ?? '', file: 'gps-track', sections: report }));
</script>

<style is:inline>
  .gpa select, .gpa input { max-width: 100%; }
  .gpa textarea { width: 100%; }
  .gpa h3 { margin: 14px 0 6px; font-size: 1rem; }
  .gpa .gp-tab td { white-space: nowrap; }
  .gpa .gp-scroll { max-height: 380px; overflow-y: auto; }
</style>
