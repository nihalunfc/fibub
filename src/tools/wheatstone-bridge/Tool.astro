---
// Metre bridge and Wheatstone bridge: slide the jockey to the null point and find a mystery resistance; every
// current from Kirchhoff's rules. Everything runs in the browser.
import '../../styles/astro.css';
---
<div class="ax wsb">
  <div class="ax-card">
    <h2>Metre bridge</h2>
    <div class="ax-row">
      <label>Known resistance R (right gap) <select class="wsb-rk" style="width:auto"><option>1</option><option>2</option><option>5</option><option selected>10</option><option>20</option><option>50</option></select></label>
    </div>
    <div class="ax-row" style="margin-top:10px">
      <button type="button" class="btn secondary small wsb-new">New mystery resistor</button>
      <button type="button" class="btn secondary small wsb-show">Show the answer</button>
    </div>
    <canvas class="ax-fig wsb-fig" style="margin-top:10px"></canvas>
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn secondary small wsb-l10" aria-label="Move the jockey 1 cm left">◀ 1 cm</button>
      <button type="button" class="btn secondary small wsb-l1" aria-label="Move the jockey 0.1 cm left">◀ 0.1</button>
      <button type="button" class="btn secondary small wsb-r1" aria-label="Move the jockey 0.1 cm right">0.1 ▶</button>
      <button type="button" class="btn secondary small wsb-r10" aria-label="Move the jockey 1 cm right">1 cm ▶</button>
    </div>
    <p class="ax-help">Drag the jockey (the triangle) along the wire, or tap the wire, until the galvanometer reads zero. Then use the balance length to work out the mystery resistance X.</p>
    <p class="ax-big wsb-big" aria-live="polite"></p>
    <p class="wsb-formula"></p>
    <dl class="ax-facts wsb-facts" style="margin-top:8px"></dl>
    <p class="wsb-answer" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Kirchhoff's rules on the bridge</h2>
    <div class="ax-scroll"><table class="wsb-tab"></table></div>
    <ol class="wsb-k"></ol>
    <p class="ax-help">The cell is 2 V with 0.5 Ω inside it, the wire is 2 Ω over its 100 cm, and the galvanometer is 50 Ω. P is the mystery resistor X, Q the known R, and the wire on each side of the jockey makes the other two arms.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="wsb-try">
      <li>Find the balance point and work out X = R l / (100 − l) yourself before you tap Show the answer.</li>
      <li>Change R and balance again: l moves, but X comes out the same.</li>
      <li>Pick R close to X: the balance point moves near the middle, where the result is most accurate.</li>
      <li>At balance, read the table: no current in the galvanometer, so the two arms on each side carry equal currents.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <div class="wsb-quiz"></div>
  </div>
</div>

<style is:inline>
  .wsb-fig { max-width: 520px; margin-left: auto; margin-right: auto; touch-action: none; cursor: ew-resize; }
  .wsb .btn.small { min-height: 40px; }
  .wsb-big { font-size: clamp(18px, 4.6vw, 24px); margin: 10px 0 0; }
  .wsb-formula, .wsb-answer { margin: 6px 0 0; font-size: 16px; overflow-wrap: anywhere; }
  .wsb-k { margin: 10px 0 0; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; overflow-wrap: anywhere; }
  .wsb-try { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; }
  .wsb .eq-list { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 14px; }
  .wsb .eq-q p { margin: 0 0 6px; }
  .wsb .eq-res { margin: 6px 0 0; font-size: 14px; min-height: 1em; }
  .wsb .eq-ok { color: var(--good); font-weight: 600; }
  .wsb .eq-no { color: var(--bad); }
  .wsb .eq-work { margin-top: 4px; font-size: 14px; }
  .wsb .eq-work summary { cursor: pointer; color: var(--muted); padding: 4px 0; }
  .wsb .eq-work p { margin: 4px 0; }
</style>

<script>
  import { metre, balanceL, unknownFrom, questions } from '../../lib/sci/wheatstone';
  import { pagePalette } from '../../lib/report';
  import { sig } from '../../lib/sci/num';
  import { quiz } from '../../lib/elec-quiz-ui';

  const root = document.querySelector<HTMLElement>('.wsb')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const fig = q<HTMLCanvasElement>('.wsb-fig');
  const sg = (x: number, n = 3) => sig(x, n);
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const RW = 2, G = 50, E = 2, RI = 0.5;
  let X = 6, l = 20, shown = false;
  const Rk = () => +q<HTMLSelectElement>('.wsb-rk').value;
  const ua = (I: number) => (Math.abs(I) < 1e-10 ? '0 µA' : Math.abs(I) >= 1e-3 ? `${sg(I * 1000)} mA` : `${sg(I * 1e6)} µA`);
  const balanced = () => Math.abs(l - balanceL(X, Rk())) <= 0.05 + 1e-9;

  function setup(c: HTMLCanvasElement, w: number, h: number) {
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    if (c.width !== Math.round(w * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); c.style.aspectRatio = `${w} / ${h}`; }
    const x = c.getContext('2d')!; x.setTransform(dpr, 0, 0, dpr, 0, 0); return x;
  }
  const W = 360, H = 250, X0 = 30, X1 = 330, WY = 180;
  const LX = (cm: number) => X0 + (cm / 100) * (X1 - X0);
  function draw() {
    const pal = pagePalette(), c = setup(fig, W, H), b = metre(X, Rk(), l, RW, G, E, RI);
    c.fillStyle = pal.bg; c.fillRect(0, 0, W, H);
    // Metre scale and wire.
    c.strokeStyle = pal.line; c.fillStyle = pal.muted; c.font = '10px system-ui, sans-serif'; c.textAlign = 'center'; c.lineWidth = 1;
    for (let k = 0; k <= 100; k += 5) { c.beginPath(); c.moveTo(LX(k), WY + 6); c.lineTo(LX(k), WY + (k % 10 ? 10 : 14)); c.stroke(); if (k % 20 === 0) c.fillText(String(k), LX(k), WY + 26); }
    c.fillText('cm', LX(100) + 4, WY + 38);
    c.strokeStyle = pal.warn; c.lineWidth = 2; c.beginPath(); c.moveTo(X0, WY); c.lineTo(X1, WY); c.stroke();
    // Thick copper strips with two gaps: X on the left, R on the right.
    c.strokeStyle = pal.ink; c.lineWidth = 4; c.beginPath();
    c.moveTo(X0, WY); c.lineTo(X0, 90); c.lineTo(80, 90); c.moveTo(140, 90); c.lineTo(220, 90); c.moveTo(280, 90); c.lineTo(X1, 90); c.lineTo(X1, WY); c.stroke();
    c.lineWidth = 2; c.fillStyle = pal.bg;
    for (const [x, lab] of [[110, shown ? `X = ${sg(X)} Ω` : 'X = ?'], [250, `R = ${Rk()} Ω`]] as [number, string][]) { c.beginPath(); c.moveTo(80, 90); c.fillRect(x - 24, 82, 48, 16); c.strokeRect(x - 24, 82, 48, 16); c.beginPath(); c.moveTo(x - 30, 90); c.lineTo(x - 24, 90); c.moveTo(x + 24, 90); c.lineTo(x + 30, 90); c.stroke(); c.fillStyle = pal.ink; c.font = '700 12px system-ui, sans-serif'; c.fillText(lab, x, 75); c.fillStyle = pal.bg; }
    // Galvanometer from the middle strip to the jockey.
    const jx = LX(l), gx = 180, gy = 128;
    c.strokeStyle = pal.ink; c.lineWidth = 1.5; c.beginPath(); c.moveTo(gx, 90); c.lineTo(gx, gy - 16); c.moveTo(gx, gy + 16); c.lineTo(gx, 150); c.lineTo(jx, 158); c.stroke();
    c.fillStyle = pal.bg; c.beginPath(); c.arc(gx, gy, 16, 0, Math.PI * 2); c.fill(); c.stroke();
    const defl = Math.max(-1, Math.min(1, Math.sign(b.IG) * Math.sqrt(Math.abs(b.IG) / 5e-3)));
    const an = -Math.PI / 2 + defl * 1.0;
    c.strokeStyle = pal.bad; c.lineWidth = 2; c.beginPath(); c.moveTo(gx, gy + 6); c.lineTo(gx + 14 * Math.cos(an), gy + 6 + 14 * Math.sin(an)); c.stroke();
    c.fillStyle = pal.ink; c.font = '700 11px system-ui, sans-serif'; c.fillText('G', gx, gy + 13);
    // Jockey.
    c.fillStyle = balanced() ? pal.good : pal.accent; c.beginPath(); c.moveTo(jx, WY - 2); c.lineTo(jx - 8, 158); c.lineTo(jx + 8, 158); c.closePath(); c.fill();
    // Cell and key along the top.
    c.strokeStyle = pal.ink; c.lineWidth = 1.5; c.beginPath(); c.moveTo(X0, 90); c.lineTo(X0, 30); c.lineTo(165, 30); c.moveTo(195, 30); c.lineTo(X1, 30); c.lineTo(X1, 90); c.stroke();
    c.beginPath(); c.moveTo(170, 20); c.lineTo(170, 40); c.moveTo(178, 25); c.lineTo(178, 35); c.moveTo(186, 20); c.lineTo(186, 40); c.moveTo(194, 25); c.lineTo(194, 35); c.stroke();
    c.fillStyle = pal.muted; c.font = '11px system-ui, sans-serif'; c.fillText('2 V cell', 182, 14);
    c.textAlign = 'left'; c.fillText(`l = ${l.toFixed(1)} cm`, Math.min(jx + 10, 280), 172);
    fig.setAttribute('aria-label', `Metre bridge, jockey at ${l.toFixed(1)} cm, galvanometer current ${sg(b.IG * 1e6)} microamps`);
  }
  function texts() {
    const R = Rk(), b = metre(X, R, l, RW, G, E, RI), ok = balanced();
    q('.wsb-big').textContent = ok ? `Balanced: no deflection at l = ${l.toFixed(1)} cm` : `Galvanometer: ${ua(b.IG)} ${b.IG > 0 ? '(needle right: move the jockey left)' : '(needle left: move the jockey right)'}`;
    q('.wsb-formula').textContent = ok ? `X / R = l / (100 − l), so X = ${R} × ${l.toFixed(1)} / ${(100 - l).toFixed(1)} = ${sg(unknownFrom(R, l))} Ω` : 'At balance, X / R = l / (100 − l). Keep sliding until the needle reads zero.';
    q('.wsb-facts').replaceChildren(fact('Jockey at l', `${l.toFixed(1)} cm`), fact('Other side 100 − l', `${(100 - l).toFixed(1)} cm`), fact('Galvanometer current', ua(b.IG)));
    const ans = q('.wsb-answer'); ans.hidden = !shown;
    ans.textContent = `The mystery resistor is ${sg(X)} Ω. With R = ${R} Ω it balances at l = 100 × ${sg(X)} / ${sg(X + R)} = ${sg(balanceL(X, R))} cm.`;
    // Kirchhoff table and checks.
    const a = (RW * l) / 100, s = (RW * (100 - l)) / 100;
    const rows = [['P = X', `${sg(X)} Ω`, ua(b.IP)], ['Q = R', `${R} Ω`, ua(b.IQ)], ['Wire, left of jockey', `${sg(a)} Ω`, ua(b.IR)], ['Wire, right of jockey', `${sg(s)} Ω`, ua(b.IS)], ['Galvanometer', `${G} Ω`, ua(b.IG)], ['Cell', `${RI} Ω inside`, ua(b.I)]];
    const head = document.createElement('tr'); head.innerHTML = '<th>Arm</th><th>Resistance</th><th class="r">Current</th>';
    q('.wsb-tab').replaceChildren(head, ...rows.map((r) => { const tr = document.createElement('tr'); r.forEach((v, i) => { const td = document.createElement('td'); td.textContent = v; if (i === 2) td.className = 'r'; tr.append(td); }); return tr; }));
    const li = (t: string) => { const e = document.createElement('li'); e.textContent = t; return e; };
    q('.wsb-k').replaceChildren(
      li(`Junction rule at the cell: ${ua(b.I)} = ${ua(b.IP)} through X + ${ua(b.IR)} along the wire.`),
      li(`Junction rule between X and R: I_X = I_R + I_G, ${ua(b.IP)} = ${ua(b.IQ)} + ${ua(b.IG)}.`),
      li(`Loop rule round X, the galvanometer and the left wire: I_X X + I_G G − I_wire a = ${sg(b.IP * X, 4)} + ${sg(b.IG * G, 4)} − ${sg(b.IR * a, 4)} = ${sg(Math.abs(b.IP * X + b.IG * G - b.IR * a) < 1e-12 ? 0 : b.IP * X + b.IG * G - b.IR * a)} V.`),
      li(ok ? 'At balance I_G = 0, so the voltage drops across X and across the left wire are equal, and X / R = a / b = l / (100 − l).' : 'At balance I_G would be 0, making the voltage drops across X and the left wire equal.'),
    );
  }
  const all = () => { draw(); texts(); };
  const setL = (v: number) => { l = Math.round(Math.max(0.5, Math.min(99.5, v)) * 10) / 10; all(); };
  const toL = (e: PointerEvent) => { const b = fig.getBoundingClientRect(); return ((((e.clientX - b.left) / b.width) * W - X0) / (X1 - X0)) * 100; };
  let drag = false;
  fig.addEventListener('pointerdown', (e) => { drag = true; fig.setPointerCapture(e.pointerId); setL(toL(e)); e.preventDefault(); });
  fig.addEventListener('pointermove', (e) => { if (drag) setL(toL(e)); });
  fig.addEventListener('pointerup', () => { drag = false; }); fig.addEventListener('pointercancel', () => { drag = false; });
  for (const [c, d] of [['.wsb-l10', -1], ['.wsb-l1', -0.1], ['.wsb-r1', 0.1], ['.wsb-r10', 1]] as const) q(c).addEventListener('click', () => setL(l + d));
  q('.wsb-rk').addEventListener('change', all);
  q('.wsb-new').addEventListener('click', () => { X = Math.round((1.5 + Math.random() * 28.5) * 10) / 10; shown = false; l = 20; all(); });
  q('.wsb-show').addEventListener('click', () => { shown = true; all(); });
  new MutationObserver(all).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
  all();
  quiz(q('.wsb-quiz'), () => questions());
</script>
