---
// Teaching coalescent: Kingman genealogies with mutations, against the textbook expectations. Seeded, so repeatable.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax cls">
  <div class="ax-card">
    <h2>Sample and mutation rate</h2>
    <div class="ax-grid">
      <label>Sample size n (gene copies) <input class="co-n" inputmode="numeric" value="10" /></label>
      <label>θ = 4Nμ (per locus) <input class="co-th" inputmode="decimal" value="5" /></label>
      <label>Genealogies to average <input class="co-r" inputmode="numeric" value="10000" /></label>
      <label>Seed <input class="co-seed" inputmode="numeric" value="1" /></label>
      <label>Show times in <select class="co-unit"><option value="c" selected>Coalescent units (2N generations)</option><option value="g">Generations</option></select></label>
      <label class="co-nbox" hidden>Effective size N (diploid) <input class="co-ne" inputmode="numeric" value="10000" /></label>
    </div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small co-next">Next tree</button></div>
    <p class="ax-help">Trace n gene copies back in time until they all meet in one common ancestor (the MRCA). With k lineages, any two merge after a random wait averaging 2/(k(k − 1)) units of 2N generations, so mergers come fast at first and slowly at the end. Mutations fall on the branches at random, θ/2 per unit of branch length. θ = 0 draws trees without mutations. The tree shown is the first of the genealogies averaged; "Next tree" moves to the next seed. Up to n 200 and 5 million tips in all.</p>
    <p class="ax-err co-err" hidden></p>
  </div>

  <div class="ax-card co-out">
    <h2>One genealogy</h2>
    <p class="ax-big co-big"></p>
    <dl class="ax-facts co-facts"></dl>
    <canvas class="ax-fig co-fig"></canvas>
    <p class="ax-help">Tips are the sampled copies at the bottom (time 0); the root at the top is their most recent common ancestor. Each dot is a mutation; every mutation is one segregating site.</p>
    <h3>Over many genealogies</h3>
    <div class="ax-scroll"><table class="co-tab"></table></div>
    <canvas class="ax-fig co-hist"></canvas>
    <p class="ax-help co-histhelp"></p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small co-nwk">Download tree (Newick)</button><button type="button" class="btn secondary small co-csv">Download genealogies (CSV)</button></div>
    <Downloads />
  </div>
</div>

<script>
  import { genealogy, replicate, expected, meanVar, newick, tipOrder, type Genealogy } from '../../lib/sci/coalescent';
  import { wfRng } from '../../lib/sci/wrightfisher';
  import { chartFigure, niceTicks } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, sig, csv as toCsv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.cls')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const val = (c: string) => num(q<HTMLInputElement>(c).value);
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const s4 = (x: number) => String(+x.toPrecision(4));
  let fig: Figure | null = null, hist: Figure | null = null, sections: Section[] = [], tree: Genealogy | null = null, reps: ReturnType<typeof replicate> | null = null, scale = 1, unitName = '';

  function treeFigure(g: Genealogy, sc: number, unit: string): Figure {
    const order = tipOrder(g), xs = new Float64Array(g.nodes.length);
    order.forEach((id, i) => (xs[id] = i));
    for (const d of g.nodes) if (d.children.length) xs[d.id] = (xs[d.children[0]] + xs[d.children[1]]) / 2; // children are made before parents
    const labels = g.n <= 30;
    return { w: 720, h: 380, alt: `Genealogy of ${g.n} gene copies, TMRCA ${s4(g.tmrca * sc)} ${unit}, ${g.S} mutations`, draw: (ctx, W, H, pal) => {
      const L = 58, Rm = 14, T = 14, B = labels ? 40 : 26, top = g.tmrca * sc || 1;
      const X = (i: number) => L + (g.n === 1 ? 0 : (i / (g.n - 1)) * (W - L - Rm)), Y = (t: number) => H - B - (t * sc / top) * (H - B - T);
      ctx.font = '12px system-ui, sans-serif'; ctx.fillStyle = pal.muted; ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      const ticks = niceTicks(0, top, 5).filter((v) => v <= top * 1.0001);
      const step = ticks.length > 1 ? ticks[1] - ticks[0] : top;
      for (const v of ticks) { ctx.beginPath(); ctx.moveTo(L, Y(v / sc)); ctx.lineTo(W - Rm, Y(v / sc)); ctx.stroke(); ctx.fillText(String(+v.toFixed(Math.max(0, -Math.floor(Math.log10(step)) + 1))), L - 6, Y(v / sc)); }
      ctx.save(); ctx.translate(13, (H - B + T) / 2); ctx.rotate(-Math.PI / 2); ctx.textAlign = 'center'; ctx.fillStyle = pal.ink; ctx.fillText(`Time before present (${unit})`, 0, 0); ctx.restore();
      ctx.strokeStyle = pal.ink; ctx.lineWidth = 1.6;
      for (const d of g.nodes) {
        if (d.parent < 0) continue;
        const p = g.nodes[d.parent], x = X(xs[d.id]);
        ctx.beginPath(); ctx.moveTo(x, Y(d.time)); ctx.lineTo(x, Y(p.time)); ctx.lineTo(X(xs[p.id]), Y(p.time)); ctx.stroke();
      }
      ctx.fillStyle = pal.red ? pal.ink : pal.bad;
      for (const d of g.nodes) {
        if (d.parent < 0 || !d.muts) continue;
        const y0 = Y(d.time), y1 = Y(g.nodes[d.parent].time), x = X(xs[d.id]);
        for (let k = 1; k <= d.muts; k++) { ctx.beginPath(); ctx.arc(x, y0 + ((y1 - y0) * k) / (d.muts + 1), 3, 0, 2 * Math.PI); ctx.fill(); }
      }
      ctx.beginPath(); ctx.moveTo(X(xs[g.root]), Y(g.tmrca)); ctx.lineTo(X(xs[g.root]), Y(g.tmrca) - 8); ctx.strokeStyle = pal.ink; ctx.stroke();
      if (labels) { ctx.fillStyle = pal.ink; ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.font = `${g.n > 20 ? 10 : 12}px system-ui, sans-serif`; order.forEach((id, i) => ctx.fillText(`s${id + 1}`, X(i), H - B + 6)); }
    } };
  }

  function calc() {
    const fail = (m: string) => { q('.co-err').textContent = m; q('.co-err').hidden = false; q('.co-out').hidden = true; fig = hist = null; sections = []; tree = null; reps = null; };
    q('.co-err').hidden = true;
    const n = val('.co-n'), th = val('.co-th'), R = val('.co-r'), seed = val('.co-seed'), gen = q<HTMLSelectElement>('.co-unit').value === 'g', Ne = val('.co-ne');
    q('.co-nbox').hidden = !gen;
    if (!(Number.isInteger(n) && n >= 2 && n <= 200)) return fail('The sample size n must be a whole number from 2 to 200.');
    if (!(th >= 0 && th <= 1000)) return fail('θ must be a number from 0 to 1,000.');
    if (!(Number.isInteger(R) && R >= 1 && R <= 100000)) return fail('Genealogies to average must be a whole number from 1 to 100,000.');
    if (n * R > 5e6) return fail(`n × genealogies is ${(n * R).toLocaleString('en')}; the limit is 5 million. Average fewer genealogies.`);
    if (!(Number.isInteger(seed) && seed >= 0 && seed < 2 ** 32)) return fail('The seed must be a whole number from 0 to 4,294,967,295.');
    if (gen && !(Ne >= 1)) return fail('Give the effective size N (1 or more) to show times in generations.');
    scale = gen ? 2 * Ne : 1; unitName = gen ? 'generations' : '2N generations';
    tree = genealogy(n, th, wfRng(seed));
    reps = replicate(n, th, R, seed);
    const e = expected(n, th), g = tree;
    q('.co-out').hidden = false;
    q('.co-big').textContent = `TMRCA ${s4(g.tmrca * scale)} ${unitName}; expected ${s4(e.tmrca * scale)}`;
    const facts = [
      fact('Time to the MRCA', `${s4(g.tmrca * scale)}`, `${unitName}; expected 2(1 − 1/n) = ${s4(e.tmrca * scale)}`),
      fact('Total branch length', `${s4(g.total * scale)}`, `expected 2 × a = ${s4(e.total * scale)}, a = Σ 1/i = ${s4(e.a)}`),
      fact('Segregating sites S', String(g.S), `expected θa = ${s4(e.S)}`),
      fact("Watterson's θ", s4(g.S / e.a), `S / a; the true θ is ${th}`),
      fact('Last merger', `${s4(g.tmrca > 0 ? ((g.tmrca - (g.times[g.times.length - 2] ?? 0)) / g.tmrca) * 100 : 0)} % of the TMRCA`, 'the final two lineages often take about half the time'),
    ];
    q('.co-facts').replaceChildren(...facts);
    fig = treeFigure(g, scale, unitName); paint(q<HTMLCanvasElement>('.co-fig'), fig);
    const m = { t: meanVar(reps.tmrca), L: meanVar(reps.total), S: meanVar(reps.S), w: meanVar(reps.thetaW) };
    const head = ['', 'Expected', 'Mean of runs', 'Expected SD', 'SD of runs'];
    const rows = [
      ['Time to the MRCA', s4(e.tmrca * scale), s4(m.t.mean * scale), s4(Math.sqrt(e.varTmrca) * scale), s4(Math.sqrt(m.t.var) * scale)],
      ['Total branch length', s4(e.total * scale), s4(m.L.mean * scale), s4(Math.sqrt(e.varTotal) * scale), s4(Math.sqrt(m.L.var) * scale)],
      ['Segregating sites S', s4(e.S), s4(m.S.mean), s4(Math.sqrt(e.varS)), s4(Math.sqrt(m.S.var))],
      ["Watterson's θ", String(th), s4(m.w.mean), s4(Math.sqrt(e.varS) / e.a), s4(Math.sqrt(m.w.var) / 1)],
    ].map((r) => r.map((c) => (c === 'NaN' ? '–' : c)));
    const tb = q<HTMLTableElement>('.co-tab'); tb.replaceChildren();
    const hr = tb.createTHead().insertRow(); head.forEach((h, i) => { const th2 = document.createElement('th'); th2.textContent = h; if (i) th2.style.textAlign = 'right'; hr.append(th2); });
    const bd = tb.createTBody(); rows.forEach((r) => { const tr = bd.insertRow(); r.forEach((c, i) => { const td = tr.insertCell(); td.textContent = c; if (i) td.style.textAlign = 'right'; }); });
    // Histogram of TMRCA as a step outline.
    const vals = Array.from(reps.tmrca, (v) => v * scale).sort((a, b) => a - b), hi = vals[Math.min(vals.length - 1, Math.floor(vals.length * 0.995))] || 1, bins = 30, w = hi / bins;
    const cnt = new Array(bins).fill(0); for (const v of vals) { const k = Math.floor(v / w); if (k < bins) cnt[k]++; }
    const hx: number[] = [], hy: number[] = []; cnt.forEach((c, k) => { hx.push(k * w, (k + 1) * w); hy.push(c / (R * w), c / (R * w)); });
    hist = chartFigure({ h: 280, xMin: 0, yMin: 0, xLabel: `Time to the MRCA (${unitName})`, yLabel: 'Density', legend: 'none', series: [{ name: 'Runs', x: hx, y: hy, mode: 'line' }], marks: [{ kind: 'vline', at: e.tmrca * scale, label: 'expected mean' }] }, `Distribution of the TMRCA over ${R} genealogies`);
    paint(q<HTMLCanvasElement>('.co-hist'), hist);
    q('.co-histhelp').textContent = `${R.toLocaleString('en')} genealogies of ${n} copies, seed ${seed}. The spread is wide: the time to the common ancestor varies a lot from one gene to the next even with nothing but chance at work.`;
    sections = [{ title: q('.co-big').textContent!, text: [`Kingman coalescent, n = ${n}, θ = ${th}, seed ${seed}. Times in ${unitName}.`], facts: [...q('.co-facts').children].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), figure: fig },
      { title: `Over ${R.toLocaleString('en')} genealogies`, table: { head: ['Quantity', ...head.slice(1)], rows, align: ['l', 'r', 'r', 'r', 'r'] }, figure: hist }];
  }

  let timer = 0;
  const later = () => { clearTimeout(timer); timer = window.setTimeout(calc, 300); };
  root.querySelectorAll('input, select').forEach((i) => { i.addEventListener('input', later); i.addEventListener('change', later); });
  q('.co-next').addEventListener('click', () => { const s = q<HTMLInputElement>('.co-seed'); s.value = String(((Number(s.value) || 0) + 1) % 2 ** 32); calc(); });
  q('.co-nwk').addEventListener('click', () => { if (tree) save(new TextEncoder().encode(newick(tree, scale) + '\n'), 'coalescent-tree.nwk', 'text/plain'); });
  q('.co-csv').addEventListener('click', () => {
    if (!reps) return;
    const rows: (string | number)[][] = [['genealogy', `TMRCA (${unitName})`, `total length (${unitName})`, 'segregating sites', 'Watterson theta']];
    for (let i = 0; i < reps.tmrca.length; i++) rows.push([i + 1, +(reps.tmrca[i] * scale).toPrecision(6), +(reps.total[i] * scale).toPrecision(6), reps.S[i], +reps.thetaW[i].toPrecision(6)]);
    save(new TextEncoder().encode(toCsv(rows)), 'coalescent-genealogies.csv', 'text/csv');
  });
  document.addEventListener('fibub:theme', () => { if (fig) paint(q<HTMLCanvasElement>('.co-fig'), fig); if (hist) paint(q<HTMLCanvasElement>('.co-hist'), hist); });
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'Coalescent simulation', subtitle: q('.co-big').textContent ?? '', file: 'coalescent', sections }));
</script>

<style is:inline>
  .cls select { max-width: 100%; }
</style>
