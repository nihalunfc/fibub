---
// #T1036 LUFS meter: live BS.1770 loudness (momentary, short-term, integrated, LRA, true peak) of the microphone,
// a shared browser tab or a playing file. Meter maths in src/lib/audio/livemeter.ts (checks in tests/audio-master.mjs).
---
<div class="tool-ui lm">
  <section class="panel">
    <div class="lm-src" role="group" aria-label="What to measure">
      <button type="button" class="btn lm-mic">Microphone or line in</button>
      <button type="button" class="btn secondary lm-tab" hidden>A browser tab's sound</button>
      <button type="button" class="btn secondary lm-fileb">Play a file</button>
      <input class="lm-file" type="file" accept="audio/*,.mp3,.wav,.ogg,.opus,.m4a,.aac,.flac,.webm,.mp4" hidden />
    </div>
    <p class="lm-status">Choose what to measure. Sound is measured on this device and never recorded or sent.</p>
    <p class="note bad lm-err" hidden></p>
  </section>

  <section class="panel">
    <dl class="lm-grid" aria-live="polite">
      <div class="lm-big"><dt>Short-term (3 s)</dt><dd class="lm-s">—</dd></div>
      <div class="lm-big"><dt>Integrated (since reset)</dt><dd class="lm-i">—</dd></div>
      <div><dt>Momentary (0.4 s)</dt><dd class="lm-m">—</dd></div>
      <div><dt>Loudness range</dt><dd class="lm-lra">—</dd></div>
      <div><dt>True peak (highest)</dt><dd class="lm-tp">—</dd></div>
      <div><dt>Loudest momentary</dt><dd class="lm-mm">—</dd></div>
    </dl>
    <canvas class="lm-graph" width="720" height="220" aria-label="Loudness over the last two minutes, with target lines"></canvas>
    <p class="lm-key"><span class="k1"></span> short-term <span class="k2"></span> momentary <span class="k3"></span> targets</p>
    <div class="lm-row">
      <button type="button" class="btn secondary lm-reset">Reset</button>
      <button type="button" class="btn secondary lm-stop" disabled>Stop</button>
    </div>
    <details class="lm-more">
      <summary>More options</summary>
      <div class="lm-two">
        <label>My own target line (LUFS) <input class="lm-custom" data-k="custom" type="number" min="-40" max="0" step="0.5" value="-16" inputmode="decimal" /></label>
        <label class="lm-check"><input type="checkbox" class="lm-stereo" data-k="stereo" /> Measure the microphone or line in as stereo</label>
      </div>
      <p class="lm-fine">Lines at −14 (streaming) and −23 (EBU R 128 broadcast) are always shown. Most microphones are mono; tick stereo only for a two-channel line input.</p>
    </details>
    <p class="lm-fine">LUFS measures the signal, not the sound in the room: a microphone reading is not a calibrated sound level (dB SPL), and it depends on the microphone and its gain. Turn off any voice processing in the browser or the system for honest numbers.</p>
  </section>
</div>

<style is:inline>
  .lm { display: grid; gap: 14px; margin-bottom: 32px; }
  .lm .panel { display: grid; gap: 12px; padding: 16px; }
  .lm [hidden] { display: none !important; }
  .lm-src, .lm-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .lm-status, .lm-fine, .lm-key { color: var(--muted); font-size: 14px; margin: 0; }
  .lm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 10px; margin: 0; }
  .lm-grid div { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .lm-grid dt { color: var(--muted); font-size: 13px; }
  .lm-grid dd { margin: 2px 0 0; font-size: 20px; font-variant-numeric: tabular-nums; }
  .lm-grid .lm-big dd { font-size: 30px; }
  .lm-graph { width: 100%; height: 220px; border: 1px solid var(--line); border-radius: 10px; }
  .lm-key span { display: inline-block; width: 14px; height: 3px; vertical-align: middle; margin-left: 6px; }
  .lm-key .k1 { background: var(--accent); } .lm-key .k2 { background: var(--muted); } .lm-key .k3 { border-top: 2px dashed var(--ink); height: 0; }
  .lm-two { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 12px; }
  .lm label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .lm label.lm-check { display: flex; gap: 8px; align-items: center; color: var(--ink); }
  .lm input[type=number] { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .lm-more summary { cursor: pointer; font-size: 14px; margin-bottom: 10px; }
</style>

<script>
  import { LoudnessMeter } from '../../lib/audio/livemeter.ts';
  import { decodeFile } from '../../lib/audio/browser.ts';

  const root = document.querySelector('.lm') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const f1 = (v: number) => (isFinite(v) ? (Math.round(v * 10) / 10).toFixed(1).replace('-', '−') : '—');
  const status = $('.lm-status'), err = $('.lm-err'), stopB = $<HTMLButtonElement>('.lm-stop');
  let ac: AudioContext | null = null, proc: ScriptProcessorNode | null = null, srcNode: AudioNode | null = null, stream: MediaStream | null = null;
  let meter: LoudnessMeter | null = null, hist: { m: number; s: number }[] = [], seen = 0, running = false, nch = 1;
  const HIST = 1200; // two minutes at 10 steps a second

  const fail = (m: string) => { err.textContent = m; err.hidden = false; };
  const stop = () => {
    try { (srcNode as AudioBufferSourceNode | null)?.stop?.(); } catch {}
    srcNode?.disconnect(); proc?.disconnect(); srcNode = null; proc = null;
    stream?.getTracks().forEach((t) => t.stop()); stream = null;
    stopB.disabled = true; running = false;
  };
  const start = async (make: (c: AudioContext) => Promise<{ node: AudioNode; channels: number; label: string; hear?: boolean }>) => {
    err.hidden = true; stop();
    ac ??= new AudioContext(); await ac.resume();
    let got;
    try { got = await make(ac); } catch (e) { fail(String((e as Error)?.message || e)); status.textContent = 'Not measuring.'; return; }
    meter = new LoudnessMeter(ac.sampleRate, got.channels); hist = []; seen = 0; nch = got.channels;
    proc = ac.createScriptProcessor(4096, 2, 2);
    const silent = ac.createGain(); silent.gain.value = 0; proc.connect(silent); silent.connect(ac.destination);
    proc.onaudioprocess = (e) => {
      const ib = e.inputBuffer, ch = [ib.getChannelData(0), ib.numberOfChannels > 1 ? ib.getChannelData(1) : ib.getChannelData(0)].slice(0, nch);
      meter!.push(ch.map((c) => Float32Array.from(c)));
    };
    got.node.connect(proc); if (got.hear) got.node.connect(ac.destination);
    srcNode = got.node; stopB.disabled = false;
    status.textContent = `Measuring: ${got.label} (${got.channels === 1 ? 'mono' : 'stereo'}, ${ac.sampleRate.toLocaleString('en-US')} Hz).`;
    running = true; loop();
  };

  const loop = () => { render(); if (running) setTimeout(() => requestAnimationFrame(loop), 90); };
  const render = () => {
    if (!meter) return draw();
    const m = meter;
    $('.lm-s').textContent = `${f1(m.shortTerm)} LUFS`; $('.lm-i').textContent = `${f1(m.integrated())} LUFS`;
    $('.lm-m').textContent = `${f1(m.momentary)} LUFS`; $('.lm-lra').textContent = `${f1(m.range())} LU`;
    $('.lm-tp').textContent = `${f1(m.truePeakDb())} dBTP`; $('.lm-mm').textContent = `${f1(m.maxMomentary)} LUFS`;
    for (; seen < m.blocks.length; seen++) hist.push({ m: m.momentary, s: m.shortTerm });
    if (hist.length > HIST) hist.splice(0, hist.length - HIST);
    draw();
  };
  const draw = () => {
    const cv = $<HTMLCanvasElement>('.lm-graph'), dpr = devicePixelRatio || 1, w = (cv.width = Math.round((cv.clientWidth || 720) * dpr)), h = (cv.height = Math.round(220 * dpr));
    const g = cv.getContext('2d')!, css = getComputedStyle(root), ink = css.getPropertyValue('--ink') || '#000', muted = css.getPropertyValue('--muted') || '#666', acc = css.getPropertyValue('--accent') || '#2457c5';
    const lo = -50, hi = 0, y = (v: number) => h - ((Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * h;
    g.clearRect(0, 0, w, h); g.font = `${11 * dpr}px system-ui`; g.lineWidth = dpr;
    g.fillStyle = muted; for (let v = -10; v > lo; v -= 10) { g.fillText(String(v).replace('-', '−'), 4, y(v) - 2); g.globalAlpha = 0.2; g.fillRect(0, y(v), w, 1); g.globalAlpha = 1; }
    const custom = +$<HTMLInputElement>('.lm-custom').value;
    g.setLineDash([6 * dpr, 4 * dpr]); g.strokeStyle = ink;
    for (const [v, t] of [[-14, '−14'], [-23, '−23'], [custom, 'mine']] as [number, string][]) { if (!isFinite(v)) continue; g.beginPath(); g.moveTo(0, y(v)); g.lineTo(w, y(v)); g.stroke(); g.fillStyle = ink; g.fillText(t, w - 34 * dpr, y(v) - 3); }
    g.setLineDash([]);
    const line = (k: 'm' | 's', col: string, lw: number) => {
      g.strokeStyle = col; g.lineWidth = lw * dpr; g.beginPath(); let on = false;
      hist.forEach((p, i) => { const x = w - (hist.length - 1 - i) * (w / HIST), v = p[k]; if (!isFinite(v)) { on = false; return; } if (on) g.lineTo(x, y(v)); else { g.moveTo(x, y(v)); on = true; } });
      g.stroke();
    };
    line('m', muted, 1); line('s', acc, 2);
  };

  $('.lm-mic').addEventListener('click', () => start(async (c) => {
    if (!navigator.mediaDevices?.getUserMedia) throw new Error('This browser cannot open the microphone.');
    const stereo = $<HTMLInputElement>('.lm-stereo').checked;
    stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, channelCount: stereo ? 2 : 1 } });
    const n = stereo && (stream.getAudioTracks()[0]?.getSettings().channelCount ?? 1) >= 2 ? 2 : 1;
    return { node: c.createMediaStreamSource(stream), channels: n, label: 'microphone or line in' };
  }));
  // Sharing a tab's sound works in Chrome, Edge and other Chromium browsers; the picture is dropped at once.
  const tabB = $<HTMLButtonElement>('.lm-tab');
  if (navigator.mediaDevices && 'getDisplayMedia' in navigator.mediaDevices) tabB.hidden = false;
  tabB.addEventListener('click', () => start(async (c) => {
    stream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: true } as DisplayMediaStreamOptions);
    stream.getVideoTracks().forEach((t) => t.stop());
    if (!stream.getAudioTracks().length) throw new Error('No sound came with the share. Choose a browser tab and tick "Share tab audio".');
    stream.getAudioTracks()[0].addEventListener('ended', () => { stop(); status.textContent = 'Sharing ended.'; });
    return { node: c.createMediaStreamSource(stream), channels: 2, label: 'shared tab' };
  }));
  const fileIn = $<HTMLInputElement>('.lm-file');
  $('.lm-fileb').addEventListener('click', () => fileIn.click());
  fileIn.addEventListener('change', () => {
    const f = fileIn.files?.[0]; fileIn.value = ''; if (!f) return;
    status.textContent = `${f.name}: opening…`;
    start(async (c) => {
      let s; try { s = await decodeFile(f); } catch { throw new Error('This browser cannot read that file. Try MP3 or WAV.'); }
      const nc = Math.min(2, s.chans.length), b = c.createBuffer(nc, s.chans[0].length, s.rate);
      for (let i = 0; i < nc; i++) b.copyToChannel(s.chans[i], i);
      const src = c.createBufferSource(); src.buffer = b; src.start();
      src.onended = () => { if (srcNode === src) { stop(); status.textContent = `${f.name}: finished. The numbers stay until you reset.`; } };
      return { node: src, channels: nc, label: f.name, hear: true };
    });
  });
  $('.lm-reset').addEventListener('click', () => { meter?.reset(); hist = []; seen = 0; render(); });
  stopB.addEventListener('click', () => { stop(); status.textContent = 'Stopped. The numbers stay until you reset.'; });
  $<HTMLInputElement>('.lm-custom').addEventListener('input', draw);
  draw();
</script>
