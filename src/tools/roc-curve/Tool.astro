---
// ROC curve and AUC for a diagnostic marker: DeLong interval, paired comparison of two markers, Youden cut-off.
import DataFile from '../../components/DataFile.astro';
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax rc">
  <div class="ax-card">
    <p class="rc-med-note">For study and teaching, not medical advice. Check with a qualified professional.</p>
    <h2>Data</h2>
    <label>One row per subject: the true outcome (for example 1 = has the condition, 0 = does not), then one or two marker values measured on the same subjects. A header row is optional.
      <textarea class="rc-data" rows="10" spellcheck="false" wrap="off">
Disease	Marker A	Marker B
1	53	8.6
0	43	3.3
0	30	6.3
0	40	5.1
1	36	3.9
0	24	4.9
0	8	5.9
0	44	9.8
0	44	4
0	22	5.7
0	28	6.3
0	25	6.3
0	57	5.4
1	44	8.5
1	67	5.2
0	40	5.3
0	26	6.4
1	78	5.1
1	66	6.1
1	52	8.4
0	29	5.7
1	63	1.1
1	58	7.3
0	35	3.3
0	25	3
0	41	3.6
0	17	3.9
0	24	4.7
1	60	6.5
1	56	8.1
0	26	5.3
1	51	4
0	44	8.5
1	56	7
1	44	5
1	42	5
1	57	7.7
1	53	5.1
0	24	3
1	45	7.7
0	42	4.2
0	36	0.8
0	38	4.6
0	45	7.8
0	36	5.9
