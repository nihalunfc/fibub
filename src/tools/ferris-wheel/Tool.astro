---
// Ferris wheel height: drag a seat round the wheel (or press Play) and its height above the ground is drawn as a
// wave against the angle turned. Turns past 360° are counted. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm fw9">
  <div class="ax-card">
    <div class="ax-seg fw9-lvl" role="group" aria-label="Level"><button type="button" data-l="9" aria-pressed="true">Class 9: turns and heights</button><button type="button" data-l="11" aria-pressed="false">Class 10–11: the sine wave</button></div>
    <svg class="sm-fig fw9-wheel" viewBox="0 0 340 250" role="img" aria-label="Ferris wheel with one coloured seat; drag the seat to turn the wheel" style="margin-top:10px"></svg>
    <p class="ax-big fw9-big" aria-live="polite" style="margin:8px 0 2px"></p>
    <p class="fw9-turns" style="margin:0 0 6px"></p>
    <div class="ax-row">
      <button type="button" class="btn small fw9-play">Play</button>
      <button type="button" class="btn secondary small fw9-step" data-d="-30">− 30°</button>
      <button type="button" class="btn secondary small fw9-step" data-d="30">+ 30°</button>
      <button type="button" class="btn secondary small fw9-step" data-d="90">+ 90°</button>
      <button type="button" class="btn secondary small fw9-reset">Back to the bottom</button>
    </div>
    <div class="sm-sl"><b>θ</b><input type="range" class="fw9-ar" min="0" max="720" step="1" value="60" aria-label="Angle turned slider" /><input type="number" class="fw9-a" step="any" value="60" inputmode="decimal" aria-label="Angle turned in degrees" /></div>
    <div class="sm-sl"><b>r</b><input type="range" class="fw9-rr" min="2" max="60" step="1" value="10" aria-label="Radius slider" /><input type="number" class="fw9-r" min="0.5" step="any" value="10" inputmode="decimal" aria-label="Radius in metres" /></div>
    <div class="sm-sl"><b>c</b><input type="range" class="fw9-cr" min="0" max="20" step="0.5" value="2" aria-label="Gap below the wheel slider" /><input type="number" class="fw9-c" min="0" step="any" value="2" inputmode="decimal" aria-label="Gap between the lowest seat and the ground in metres" /></div>
    <div class="sm-sl"><b>T</b><input type="range" class="fw9-tr" min="10" max="1200" step="10" value="60" aria-label="Time for one turn slider" /><input type="number" class="fw9-t" min="1" step="any" value="60" inputmode="decimal" aria-label="Time for one turn in seconds" /></div>
    <p class="ax-help">θ is the angle turned since the seat was at the bottom, r the radius, c the gap between the lowest seat and the ground (so the hub is r + c above the ground), T the time for one full turn. All lengths in metres.</p>
    <div class="ax-row">
      <button type="button" class="btn secondary small fw9-pre" data-p="10,2,60">Fair wheel</button>
      <button type="button" class="btn secondary small fw9-pre" data-p="60,5,1800">Giant wheel (30 min a turn)</button>
      <button type="button" class="btn secondary small fw9-pre" data-p="4,1,20">Small ride</button>
    </div>
    <p class="ax-err fw9-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Height against angle</h2>
    <svg class="sm-fig fw9-graph" viewBox="0 0 340 200" role="img" aria-label="Height of the seat against angle turned, two full turns"></svg>
    <ul class="sm-steps fw9-out"></ul>
  </div>

  <div class="ax-card">
    <h2>When is the seat high up?</h2>
    <div class="ax-grid"><label>Height (m) <input type="number" class="fw9-h" step="any" value="17" inputmode="decimal" /></label></div>
    <p class="sm-f fw9-when"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Press Play and watch the dot on the graph. The height goes up and down the same way every turn: the graph repeats every 360°.</li>
      <li>Turn to 450°. That is one full turn and 90° more, so the seat is where it was at 90°: level with the hub.</li>
      <li>Double the radius. The wave gets twice as tall, but it still repeats every 360°.</li>
      <li>Switch to Class 10–11 and compare the wave with the sine graph on the unit circle.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <div class="fw9-quiz"></div>
  </div>
</div>

<style is:inline>
  .fw9 .fw9-rim { fill: none; stroke: var(--ink); stroke-width: 2; }
  .fw9 .fw9-spoke { stroke: var(--line); stroke-width: 1.5; }
  .fw9 .fw9-seatb { fill: var(--surface); stroke: var(--muted); stroke-width: 1.2; }
  .fw9 .fw9-seat { fill: var(--accent); stroke: var(--surface); stroke-width: 2; cursor: grab; }
  .fw9 .fw9-ground { stroke: var(--good); stroke-width: 3; }
  .fw9 .fw9-hgt { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 4 3; }
  .fw9 .fw9-arc { fill: none; stroke: var(--warn); stroke-width: 3; }
  .fw9 .fw9-dot { fill: var(--accent); }
  .fw9 .fw9-band { fill: var(--good-soft); }
</style>

<script>
  import { height, turns, anglesAtHeight, shareAbove } from '../../lib/sci/ferris-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, pair, val, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.fw9')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const wheel = q<SVGSVGElement>('.fw9-wheel'), graph = q<SVGSVGElement>('.fw9-graph');
  const A = q<HTMLInputElement>('.fw9-a'), R = q<HTMLInputElement>('.fw9-r'), C = q<HTMLInputElement>('.fw9-c'), TT = q<HTMLInputElement>('.fw9-t');
  const setA = pair(q('.fw9-ar'), A, draw), setR = pair(q('.fw9-rr'), R, draw), setC = pair(q('.fw9-cr'), C, draw), setT = pair(q('.fw9-tr'), TT, draw);
  let level = 9;
  const cosd = (d: number) => Math.cos((d * Math.PI) / 180), sind = (d: number) => Math.sin((d * Math.PI) / 180);

  // Wheel geometry on screen: hub at (110, ...), drawn radius fits the box together with the ground.
  const geo = () => {
    const r = val(R, 10, 0.5, 1e5), c = val(C, 2, 0, 1e5), hub = r + c;
    const k = 200 / (hub + r || 1), cx = 110, gy = 232, cy = gy - hub * k, pr = r * k;
    return { r, c, hub, k, cx, cy, gy, pr };
  };
  function draw() {
    const g = geo(), th = val(A, 60, -1e6, 1e6), T = val(TT, 60, 0.01, 1e7), h = height(th, g.r, g.hub), tr = turns(th);
    const err = q('.fw9-err'); const bad = Number(R.value) <= 0 || Number(C.value) < 0 || Number(TT.value) <= 0;
    err.hidden = !bad; if (bad) err.textContent = 'The radius and the time for a turn must be more than 0, and the gap 0 or more. Using the nearest allowed value.';
    wheel.replaceChildren();
    S('line', { x1: 0, x2: 340, y1: g.gy, y2: g.gy, class: 'fw9-ground' }, wheel);
    S('line', { x1: g.cx - 18, y1: g.gy, x2: g.cx, y2: g.cy, class: 'sm-line' }, wheel); S('line', { x1: g.cx + 18, y1: g.gy, x2: g.cx, y2: g.cy, class: 'sm-line' }, wheel);
    S('circle', { cx: g.cx, cy: g.cy, r: g.pr, class: 'fw9-rim' }, wheel);
    for (let i = 0; i < 8; i++) {
      const a = th + i * 45, x = g.cx + g.pr * sind(a), y = g.cy + g.pr * cosd(a);
      S('line', { x1: g.cx, y1: g.cy, x2: x, y2: y, class: 'fw9-spoke' }, wheel);
      if (i) S('rect', { x: x - 6, y: y - 3, width: 12, height: 10, rx: 2, class: 'fw9-seatb' }, wheel);
    }
    const r0 = Math.min(26, g.pr * 0.45), rest = tr.rest;
    if (rest > 0.5) { const sx = g.cx, sy = g.cy + r0, ex = g.cx + r0 * sind(rest), ey = g.cy + r0 * cosd(rest); S('path', { d: `M ${sx} ${sy} A ${r0} ${r0} 0 ${rest > 180 ? 1 : 0} 0 ${ex} ${ey}`, class: 'fw9-arc' }, wheel); }
    S('circle', { cx: g.cx, cy: g.cy, r: 3, class: 'fw9-dot' }, wheel);
    const sx = g.cx + g.pr * sind(th), sy = g.cy + g.pr * cosd(th);
    S('line', { x1: 250, x2: 250, y1: g.gy, y2: sy, class: 'fw9-hgt' }, wheel); S('line', { x1: sx, x2: 250, y1: sy, y2: sy, class: 'sm-dash' }, wheel);
    S('text', { x: 256, y: (g.gy + sy) / 2 + 4 }, wheel, `${fmt(h, 2)} m`);
    S('text', { x: 256, y: g.cy - 4, class: 'sm-tick' }, wheel, `hub ${fmt(g.hub, 2)} m`);
    S('circle', { cx: sx, cy: sy, r: 9, class: 'fw9-seat' }, wheel);
    q('.fw9-big').textContent = `Height ${fmt(h, 2)} m after turning ${fmt(th, 1)}°`;
    q('.fw9-turns').textContent = tr.turns === 0 ? `Less than one full turn (${fmt(rest, 1)}° of 360°). Time taken: ${fmt((th / 360) * T, 1)} s.` : `${fmt(th, 1)}° = ${tr.turns} full turn${Math.abs(tr.turns) === 1 ? '' : 's'} ${tr.turns < 0 ? '(backwards) ' : ''}+ ${fmt(rest, 1)}°, so the seat is where it was at ${fmt(rest, 1)}°. Time taken: ${fmt((th / 360) * T, 1)} s.`;
    // Graph: two turns.
    graph.replaceChildren();
    const X = (d: number) => 36 + (d / 720) * 296, top = g.hub + g.r, Y = (v: number) => 180 - (v / (top || 1)) * 160;
    for (const d of [0, 90, 180, 270, 360, 450, 540, 630, 720]) { S('line', { x1: X(d), x2: X(d), y1: 20, y2: 180, class: 'sm-grid' }, graph); if (d % 180 === 0) S('text', { x: X(d), y: 195, 'text-anchor': 'middle', class: 'sm-tick' }, graph, `${d}°`); }
    S('line', { x1: 36, x2: 332, y1: 180, y2: 180, class: 'sm-axis' }, graph); S('line', { x1: 36, x2: 36, y1: 18, y2: 180, class: 'sm-axis' }, graph);
    for (const v of [0, g.hub, top]) S('text', { x: 32, y: Y(v) + 4, 'text-anchor': 'end', class: 'sm-tick' }, graph, fmt(v, 1));
    S('line', { x1: 36, x2: 332, y1: Y(g.hub), y2: Y(g.hub), class: 'sm-dash' }, graph);
    let d = '';
    for (let i = 0; i <= 240; i++) { const a = (i / 240) * 720; d += `${i ? 'L' : 'M'} ${X(a).toFixed(1)} ${Y(height(a, g.r, g.hub)).toFixed(1)} `; }
    S('path', { d, class: 'sm-curve' }, graph);
    const shown = ((th % 720) + 720) % 720;
    S('circle', { cx: X(shown), cy: Y(h), r: 6, class: 'fw9-dot' }, graph);
    const lines = [
      `Hub height = r + c = ${fmt(g.r, 2)} + ${fmt(g.c, 2)} = ${fmt(g.hub, 2)} m. Lowest point ${fmt(g.c, 2)} m (at 0°), highest ${fmt(top, 2)} m (at 180°).`,
      `The pattern repeats every 360° (every ${fmt(T, 1)} s): the seat is back where it started after each full turn.`,
    ];
    if (level === 11) {
      lines.push(`h = H − r cos θ = ${fmt(g.hub, 2)} − ${fmt(g.r, 2)} × cos ${fmt(th, 1)}° = ${fmt(g.hub, 2)} − ${fmt(g.r, 2)} × ${fmt(cosd(th), 4)} = ${fmt(h, 3)} m.`);
      lines.push(`The same wave is h = H + r sin(θ − 90°), a sine wave of amplitude r = ${fmt(g.r, 2)} m about the hub height. With time, θ = 360° × t / T, so h = ${fmt(g.hub, 2)} − ${fmt(g.r, 2)} cos(360° t / ${fmt(T, 1)}).`);
      lines.push(`In radians one turn is 2π, and θ = ${fmt(th, 1)}° = ${fmt((th * Math.PI) / 180, 4)} rad.`);
    } else {
      lines.push(`After a quarter turn (90°) the seat is level with the hub; after half a turn (180°) it is at the top.`);
    }
    q('.fw9-out').replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    when();
  }
  function when() {
    const g = geo(), T = val(TT, 60, 0.01, 1e7), hv = q<HTMLInputElement>('.fw9-h'), x = Number(hv.value), out = q('.fw9-when');
    if (hv.value.trim() === '' || !Number.isFinite(x)) { out.textContent = 'Type a height in metres.'; return; }
    const a = anglesAtHeight(x, g.r, g.hub), share = shareAbove(x, g.r, g.hub);
    if (!a.length) { out.textContent = x > g.hub + g.r ? `The seat never gets that high: the top is ${fmt(g.hub + g.r, 2)} m.` : `The seat is always higher than that: the lowest point is ${fmt(g.c, 2)} m.`; return; }
    out.textContent = a.length === 1 ? `The seat is at ${fmt(x, 2)} m only at ${fmt(a[0], 1)}° in each turn (${fmt((a[0] / 360) * T, 1)} s).` : `In each turn the seat is at ${fmt(x, 2)} m at ${fmt(a[0], 1)}° and ${fmt(a[1], 1)}° (after ${fmt((a[0] / 360) * T, 1)} s and ${fmt((a[1] / 360) * T, 1)} s). It is higher than that for ${fmt(share * 100, 1)} % of each turn: ${fmt(share * T, 1)} s of every ${fmt(T, 1)} s.`;
  }
  q('.fw9-h').addEventListener('input', when);

  // Drag the seat: the angle keeps adding up past 360°.
  dragOn(wheel, (x, y) => { const g = geo(), th = val(A, 0); const sx = g.cx + g.pr * sind(th), sy = g.cy + g.pr * cosd(th); return Math.hypot(x - sx, y - sy) < 30 || Math.abs(Math.hypot(x - g.cx, y - g.cy) - g.pr) < 24 ? 'seat' : null; },
    (_id, x, y) => {
      const g = geo(), th = val(A, 0);
      const a = (Math.atan2(x - g.cx, y - g.cy) * 180) / Math.PI; // 0 at the bottom, anticlockwise positive
      let d = a - (((th % 360) + 360) % 360); d = ((d + 540) % 360) - 180;
      setA(Math.round((th + d) * 10) / 10); draw();
    });

  let playing = 0, last = 0;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tick = (now: number) => {
    if (!playing) return;
    const dt = Math.min(0.1, (now - last) / 1000); last = now;
    const sp = reduce ? 30 : 60; // degrees per second on screen
    setA(Math.round((val(A, 0) + sp * dt) * 10) / 10); draw();
    playing = requestAnimationFrame(tick);
  };
  q('.fw9-play').addEventListener('click', () => {
    const b = q('.fw9-play');
    if (playing) { cancelAnimationFrame(playing); playing = 0; b.textContent = 'Play'; return; }
    b.textContent = 'Pause'; last = performance.now(); playing = requestAnimationFrame(tick);
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden && playing) { cancelAnimationFrame(playing); playing = 0; q('.fw9-play').textContent = 'Play'; } });
  root.querySelectorAll<HTMLButtonElement>('.fw9-step').forEach((b) => b.addEventListener('click', () => { setA(Math.round((val(A, 0) + Number(b.dataset.d)) * 10) / 10); draw(); }));
  q('.fw9-reset').addEventListener('click', () => { setA(0); draw(); });
  root.querySelectorAll<HTMLButtonElement>('.fw9-pre').forEach((b) => b.addEventListener('click', () => { const [r, c, t] = b.dataset.p!.split(',').map(Number); setR(r); setC(c); setT(t); draw(); }));
  root.querySelectorAll<HTMLButtonElement>('.fw9-lvl button').forEach((b) => b.addEventListener('click', () => { level = Number(b.dataset.l); root.querySelectorAll('.fw9-lvl button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
  draw();

  quiz(q('.fw9-quiz'), () => {
    const out: Question[] = [];
    const r = randInt(4, 30), c = randInt(1, 6), H = r + c;
    out.push({ q: `A wheel has radius ${r} m and its lowest seat is ${c} m above the ground. How high is the top of the wheel, in metres?`, want: [H + r], work: `The hub is r + c = ${r} + ${c} = ${H} m up; the top is one more radius: ${H} + ${r} = ${H + r} m.` });
    const k = randInt(1, 3), extra = [90, 180, 270][randInt(0, 2)];
    out.push({ q: `A seat starts at the bottom and turns ${360 * k + extra}°. How many degrees past its last full turn is it?`, want: [extra], work: `${360 * k + extra}° = ${k} × 360° + ${extra}°, so it is ${extra}° past a full turn.` });
    const T = randInt(2, 12) * 10, f = [0.25, 0.5, 0.75][randInt(0, 2)];
    out.push({ q: `One turn takes ${T} s. How many seconds does it take the seat to turn ${360 * f}°?`, want: [T * f], work: `${360 * f}° is ${f === 0.25 ? 'a quarter' : f === 0.5 ? 'half' : 'three quarters'} of a turn: ${f} × ${T} = ${T * f} s.` });
    const r2 = randInt(3, 20) * 2, c2 = randInt(1, 5), H2 = r2 + c2;
    out.push({ q: `Radius ${r2} m, hub ${H2} m above the ground. Using h = H − r cos θ, how high is the seat after 60°?`, want: [H2 - r2 / 2], work: `cos 60° = 0.5, so h = ${H2} − ${r2} × 0.5 = ${H2 - r2 / 2} m.` });
    return out;
  });
</script>
