---
// #T927 Weighted grade
---
<div class="tool-ui wg">
  <section class="panel">
    <div class="wg-head" aria-hidden="true"><span>Item</span><span>Score (% or 45/50)</span><span>Weight (%)</span><span></span></div>
    <div class="wg-rows"></div>
    <p class="wg-btns"><button type="button" class="btn secondary small wg-add">Add a row</button> <button type="button" class="btn secondary small wg-reset">Reset to the example</button></p>
    <p class="wg-big" aria-live="polite"></p>
    <p class="wg-say" aria-live="polite"></p>
    <p class="wg-warn" aria-live="polite"></p>
    <details class="wg-workd">
      <summary>Show the working</summary>
      <ul class="wg-working"></ul>
    </details>
  </section>
  <section class="panel">
    <h3 class="wg-h">What if</h3>
    <label class="wg-if">If I score this on the items with no score yet (%)<input data-k="if" inputmode="decimal" placeholder="e.g. 85" /></label>
    <p class="wg-ifout" aria-live="polite"></p>
    <label class="wg-if wg-goal">I want to finish with (%)<input data-k="goal" inputmode="decimal" placeholder="e.g. 80" /></label>
    <p class="wg-goalout" aria-live="polite"></p>
  </section>
  <section class="panel">
    <details class="wg-more">
      <summary>More options: several scores in one row, drop the lowest, letter scale</summary>
      <div class="wg-fields">
        <p class="wg-fine">A row can hold several scores, such as 90 85 45/50 (separated by spaces or semicolons): the row's score is their average. This suits homework or quizzes.</p>
        <label>Drop the lowest score in each row that has several
          <select data-k="drop"><option value="0">Drop none</option><option value="1">Drop the lowest 1</option><option value="2">Drop the lowest 2</option></select>
        </label>
        <label>Letter scale
          <select data-k="scale"><option value="simple">Simple A to D (90, 80, 70, 60)</option><option value="plusminus">Plus and minus (A 93, A- 90, B+ 87 ...)</option><option value="uk">UK degree classes (70, 60, 50, 40)</option></select>
        </label>
      </div>
      <p class="wg-fine">Lowest percent for each letter; anything below the last is the lowest grade. Common defaults, not rules: change them to your school's scale.</p>
      <div class="wg-cuts"></div>
    </details>
  </section>
  <p class="wg-fine">Weighted average = sum of (score × weight) ÷ sum of weights. Weights can be percents or points. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .wg { display: grid; gap: 14px; margin-bottom: 32px; }
  .wg .panel { padding: 16px; }
  .wg-head, .wg-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr) minmax(0, 1fr) 36px; gap: 6px; align-items: center; }
  .wg-head { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
  .wg-row { margin-bottom: 6px; }
  .wg input { font: inherit; color: var(--ink); padding: 8px 9px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .wg input:focus { border-color: var(--accent); outline: none; }
  .wg input.bad { border-color: var(--bad); }
  .wg-del { font: inherit; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .wg label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .wg-cuts { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 8px; margin-top: 8px; }
  .wg-big { font-size: 26px; font-weight: 700; margin: 14px 0 4px; overflow-wrap: anywhere; }
  .wg-say, .wg-ifout { margin: 0; color: var(--muted); font-size: 15px; }
  .wg-ifout { margin-top: 8px; }
  .wg-warn { margin: 6px 0 0; color: var(--warn); font-size: 14px; }
  .wg-warn:empty { display: none; }
  .wg-h { margin: 0 0 8px; font-size: 16px; }
  .wg-fine { color: var(--muted); font-size: 13px; margin: 0 0 8px; }
  .wg-btns { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .wg select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .wg-goal { margin-top: 12px; }
  .wg-more summary, .wg-workd summary { cursor: pointer; font-size: 14px; }
  .wg-more > .wg-fields { margin-top: 12px; display: grid; gap: 12px; }
  .wg-working { margin: 10px 0 0; padding-left: 20px; font-size: 14px; color: var(--muted); display: grid; gap: 4px; overflow-wrap: anywhere; }
  .wg-working li strong { color: var(--ink); }
</style>

<script>
  import { SCALES, letterFor, parseScoreList, categoryAverage, neededOnRest } from '../../lib/everyday/grades';
  const root = document.querySelector('.wg') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const k = (s: string) => q<HTMLInputElement>(`[data-k="${s}"]`);
  const rows = q('.wg-rows'), big = q('.wg-big'), say = q('.wg-say'), warn = q('.wg-warn'), ifOut = q('.wg-ifout'), goalOut = q('.wg-goalout'), working = q('.wg-working'), cutsEl = q('.wg-cuts');
  const ifIn = k('if');
  const EX: [string, string, string][] = [['Homework', '90', '20'], ['Midterm', '80', '30'], ['Final exam', '70', '50']];
  const MAXROWS = 60;
  const f1 = (v: number) => v.toFixed(1);
  const num = (s: string) => (s.trim() === '' ? NaN : Number(s.trim().replace('%', '').replace(',', '.')));
  const cuts = (): [string, number][] => [...cutsEl.querySelectorAll<HTMLInputElement>('[data-c]')].map((i) => [i.dataset.c!, num(i.value)]);
  const letter = (p: number) => letterFor(p, cuts(), SCALES[k('scale').value].below);
  const buildCuts = () => {
    cutsEl.innerHTML = '';
    for (const [g, c] of SCALES[k('scale').value].cuts) {
      const l = document.createElement('label'); l.append(g);
      const i = document.createElement('input'); i.dataset.c = g; i.dataset.k = 'c-' + g; i.inputMode = 'decimal'; i.value = String(c); i.setAttribute('aria-label', `Lowest percent for ${g}`);
      i.addEventListener('input', calc); l.append(i); cutsEl.append(l);
    }
  };
  const addRow = (n = '', s = '', w = '') => {
    const r = document.createElement('div'); r.className = 'wg-row';
    const mk = (f: string, v: string, lab: string, im?: string) => { const i = document.createElement('input'); i.dataset.f = f; i.value = v; i.setAttribute('aria-label', lab); if (im) i.inputMode = im; i.addEventListener('input', calc); return i; };
    const del = document.createElement('button'); del.type = 'button'; del.className = 'wg-del'; del.textContent = '×'; del.setAttribute('aria-label', 'Remove this row');
    del.addEventListener('click', () => { r.remove(); calc(); });
    r.append(mk('name', n, 'Item'), mk('score', s, 'Score, as a percent or points like 45/50; several scores may be separated by spaces'), mk('w', w, 'Weight, in percent or points', 'decimal'), del);
    rows.append(r);
  };
  function calc() {
    let sw = 0, sum = 0, allW = 0, missW = 0, missing = 0, bad = 0;
    const lines: { name: string; s: number; w: number; note: string }[] = [];
    const drop = +k('drop').value;
    rows.querySelectorAll<HTMLElement>('.wg-row').forEach((r, idx) => {
      const si = r.querySelector('[data-f="score"]') as HTMLInputElement, wi = r.querySelector('[data-f="w"]') as HTMLInputElement, ni = r.querySelector('[data-f="name"]') as HTMLInputElement;
      const list = parseScoreList(si.value), w = num(wi.value);
      si.classList.toggle('bad', list === undefined); wi.classList.toggle('bad', wi.value.trim() !== '' && !(w >= 0));
      if (list === undefined || !(w >= 0)) { if (si.value.trim() || wi.value.trim()) bad++; return; }
      allW += w;
      if (list === null) { missW += w; if (w > 0) missing++; return; }
      const { avg, dropped } = categoryAverage(list, drop);
      sw += w; sum += avg * w;
      lines.push({ name: ni.value.trim() || `Row ${idx + 1}`, s: avg, w, note: list.length > 1 ? ` (average of ${list.length} scores${dropped.length ? `, lowest ${dropped.map(f1).join(' and ')}% dropped` : ''})` : '' });
    });
    warn.textContent = ''; working.innerHTML = ''; goalOut.textContent = '';
    if (sw <= 0) { big.textContent = ''; say.textContent = 'Type a score and a weight on at least one row.'; ifOut.textContent = ''; return; }
    const avg = sum / sw;
    big.textContent = `${f1(avg)}% (${letter(avg)})`;
    say.textContent = missing ? `Weighted average of the ${f1(sw)}% of the course you have marks for.` : `Weighted average over ${f1(sw)}% of weight.`;
    for (const l of lines) { const li = document.createElement('li'); const b = document.createElement('strong'); b.textContent = l.name; li.append(b, `: ${f1(l.s)}%${l.note} × weight ${f1(l.w)} ÷ ${f1(sw)} = ${(l.s * l.w / sw).toFixed(2)} points`); working.append(li); }
    const tot = document.createElement('li'); tot.textContent = `Total: ${avg.toFixed(2)}% = ${f1(avg)}%`; working.append(tot);
    const notes: string[] = [];
    if (Math.abs(allW - 100) > 1e-9) notes.push(`The weights add up to ${f1(allW)}, not 100, so each is scaled by 100 ÷ ${f1(allW)} (the same as dividing by the total weight).`);
    if (bad) notes.push(`${bad} row${bad > 1 ? 's are' : ' is'} left out because a score or weight could not be read.`);
    warn.textContent = notes.join(' ');
    if (!missing) { ifOut.textContent = 'Every row has a score. Clear a score to treat that item as still to come.'; goalOut.textContent = ''; return; }
    const v = num(ifIn.value);
    if (!Number.isFinite(v)) { ifOut.textContent = `${missing} item${missing > 1 ? 's have' : ' has'} no score yet (${f1(missW)} of the weight). Type a score above to see your grade at the end.`; }
    else { const end = (sum + v * missW) / (sw + missW); ifOut.textContent = `Scoring ${f1(v)}% on the ${missing} missing item${missing > 1 ? 's' : ''} gives ${f1(end)}% (${letter(end)}) overall.`; }
    const g = num(k('goal').value);
    if (!Number.isFinite(g)) goalOut.textContent = 'Type the grade you want to see what the missing items must average.';
    else if (missW <= 0) goalOut.textContent = 'The missing items have no weight, so they cannot change your grade.';
    else {
      const need = neededOnRest(sum, sw, missW, g);
      goalOut.textContent = need > 100 ? `To finish on ${f1(g)}% you would need ${f1(need)}% on the missing items: over 100%, so it is out of reach without extra credit.`
        : need <= 0 ? `You already finish on at least ${f1(g)}% even with 0% on the missing items.`
        : `To finish on ${f1(g)}% you need an average of ${f1(need)}% on the ${missing} missing item${missing > 1 ? 's' : ''} (${f1(missW)} of the weight).`;
    }
  }
  const reset = () => { rows.innerHTML = ''; for (const r of EX) addRow(...r); ifIn.value = ''; k('goal').value = ''; k('drop').value = '0'; k('scale').value = 'simple'; buildCuts(); calc(); };
  q('.wg-add').addEventListener('click', () => { if (rows.children.length >= MAXROWS) return; addRow(); calc(); (rows.lastElementChild?.querySelector('input') as HTMLInputElement)?.focus(); });
  q('.wg-reset').addEventListener('click', reset);
  k('scale').addEventListener('change', () => { buildCuts(); calc(); });
  k('drop').addEventListener('change', calc);
  ifIn.addEventListener('input', calc); k('goal').addEventListener('input', calc);
  reset();
</script>
