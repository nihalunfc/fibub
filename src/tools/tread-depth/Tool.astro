---
// #T942 Tread depth
---
<div class="tool-ui td">
  <section class="panel">
    <div class="td-grid">
      <label>Country
        <select data-k="region">
          <option value="uk">UK</option><option value="usa">USA</option><option value="canada">Canada</option><option value="india">India</option><option value="gulf">UAE and Gulf</option>
        </select>
      </label>
      <label>Vehicle
        <select data-k="veh"><option value="car">Car or SUV</option><option value="motorcycle">Motorcycle</option><option value="truck">Truck or bus</option></select>
      </label>
      <label>Unit
        <select data-k="unit"><option value="mm">mm</option><option value="32">32nds of an inch</option></select>
      </label>
      <label>Tread depth <input data-k="depth" inputmode="decimal" value="3" /></label>
    </div>
    <p class="td-err" role="alert"></p>
  </section>
  <section class="panel td-res" hidden>
    <p class="td-pill"></p>
    <p class="td-big"></p>
    <p class="td-line td-wet"></p>
    <svg class="td-gauge" viewBox="0 0 300 54" role="img" aria-label="Gauge from 0 to 8 mm with the legal limit and your tread marked">
      <rect x="10" y="22" width="280" height="12" rx="6" fill="none" stroke="currentColor" opacity=".5"/>
      <rect class="td-fill" x="10" y="22" width="0" height="12" rx="6" fill="currentColor" opacity=".7"/>
      <line class="td-lim" x1="0" x2="0" y1="14" y2="42" stroke="var(--bad)" stroke-width="3"/>
      <text class="td-limt" x="0" y="10" font-size="11" text-anchor="middle" fill="var(--bad)">limit</text>
      <text x="10" y="50" font-size="10" fill="currentColor">0</text>
      <text x="290" y="50" font-size="10" text-anchor="end" fill="currentColor">8 mm</text>
    </svg>
    <p class="td-fine td-note"></p>
    <p class="td-fine">Wet roads and braking: see <a href="/vehicles/stopping-distance/">Stopping distance</a>.</p>
  </section>
  <section class="panel">
    <h2 class="td-h">No gauge? Try these</h2>
    <div class="td-coins">
      <figure>
        <svg viewBox="0 0 80 70" aria-hidden="true"><rect x="2" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><rect x="58" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><circle cx="40" cy="26" r="20" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="40" cy="20" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M28 36c2-6 6-8 12-8s10 2 12 8" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <figcaption><b>US penny</b>, head down in a groove. Top of the head fully visible: 2/32 inch or less. Replace.</figcaption>
      </figure>
      <figure>
        <svg viewBox="0 0 80 70" aria-hidden="true"><rect x="2" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><rect x="58" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><circle cx="40" cy="26" r="22" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="40" cy="20" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M28 38c2-6 6-8 12-8s10 2 12 8" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <figcaption><b>US quarter</b>, head down. Head touches the tread: about 4/32 inch. Head fully visible: under 4/32.</figcaption>
      </figure>
      <figure>
        <svg viewBox="0 0 80 70" aria-hidden="true"><rect x="2" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><rect x="58" y="30" width="20" height="38" fill="currentColor" opacity=".35"/><circle cx="40" cy="26" r="20" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="40" cy="26" r="14" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3"/><text x="40" y="30" text-anchor="middle" font-size="11" fill="currentColor">20</text></svg>
        <figcaption><b>UK 20p</b>, in a groove. Outer band still visible: the tread is likely under 1.6 mm.</figcaption>
      </figure>
      <figure>
        <svg viewBox="0 0 80 70" aria-hidden="true"><rect x="2" y="30" width="30" height="38" fill="currentColor" opacity=".35"/><rect x="48" y="30" width="30" height="38" fill="currentColor" opacity=".35"/><rect x="32" y="56" width="16" height="12" fill="var(--bad)"/><path d="M40 6 36 18h8z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <figcaption><b>Wear bar</b>, 1.6 mm. Find the triangle on the sidewall. If the bar is level with the tread, replace.</figcaption>
      </figure>
    </div>
  </section>
  <details class="panel">
    <summary>Where do these limits come from?</summary>
    <ul class="td-list">
      <li>Replace by 3 mm (4/32 inch) for good wet grip; on winter tyres keep 4 mm (5/32 inch) or more.</li>
      <li>Coin tests are rough. A gauge is better.</li>
      <li>Always check your own country's rule: <em>as checked November 2026; check the official source.</em></li>
    </ul>
  </details>
  <p class="td-fine">Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .td { display: grid; gap: 14px; margin-bottom: 32px; }
  .td .panel { padding: 16px; }
  .td-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 12px; }
  .td label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .td input, .td select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .td input:focus, .td select:focus { border-color: var(--accent); outline: none; }
  .td-err { color: var(--bad); margin: 8px 0 0; } .td-err:empty { display: none; }
  .td-pill { display: inline-block; margin: 0; padding: 6px 16px; border-radius: 999px; font-weight: 700; font-size: 22px; }
  .td-pill.good { background: var(--good-soft); color: var(--good); }
  .td-pill.warn { background: var(--warn-soft); color: var(--warn); }
  .td-pill.bad { background: var(--bad-soft); color: var(--bad); }
  .td-big { font-size: 18px; margin: 10px 0 0; }
  .td-line { margin: 6px 0 0; font-weight: 600; }
  .td-gauge { width: 100%; max-width: 360px; height: auto; display: block; margin: 12px 0 0; color: var(--ink); }
  .td-fine { color: var(--muted); font-size: 13px; margin: 8px 0 0; }
  .td > .td-fine { margin: 0; }
  .td-h { font-size: 16px; margin: 0 0 10px; }
  .td-coins { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr)); gap: 12px; }
  .td-coins figure { margin: 0; display: grid; gap: 6px; align-content: start; }
  .td-coins svg { width: 80px; height: auto; color: var(--ink); }
  .td-coins figcaption { font-size: 13px; }
  .td-list { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 6px; }
</style>

<script>
  import { judgeTread, wetStopNote, to32nds, from32nds, type Region, type Vehicle } from '../../lib/vehicles/tyre-checks';
  import { presetCountry } from '../../lib/vehicles/country';
  const root = document.querySelector('.td') as HTMLElement;
  const q = (k: string) => root.querySelector(`[data-k="${k}"]`) as HTMLInputElement & HTMLSelectElement;
  const $ = (s: string) => root.querySelector(s) as HTMLElement;
  const fmt = (v: number) => (Math.round(v * 10) / 10).toString();
  const calc = () => {
    const raw = parseFloat(q('depth').value.replace(/,/g, '.'));
    const res = $('.td-res'), err = $('.td-err');
    if (!isFinite(raw) || raw < 0 || raw > (q('unit').value === '32' ? 40 : 20)) { res.hidden = true; err.textContent = q('depth').value.trim() ? 'Type a tread depth, from 0 up (new tyres are about 8 mm or 10/32 inch).' : ''; return; }
    err.textContent = '';
    const u32 = q('unit').value === '32';
    const mm = u32 ? from32nds(raw) : raw;
    const j = judgeTread(mm, q('region').value as Region, q('veh').value as Vehicle);
    res.hidden = false;
    const p = $('.td-pill'); p.textContent = j.label; p.className = 'td-pill ' + j.level;
    $('.td-big').textContent = `${fmt(mm)} mm (${fmt(to32nds(mm))}/32 inch). ${j.text}`;
    $('.td-wet').textContent = wetStopNote(mm);
    $('.td-note').textContent = `${j.note} As checked November 2026; check the official source.`;
    const x = (v: number) => 10 + 280 * Math.min(Math.max(v, 0), 8) / 8;
    $('.td-fill').setAttribute('width', String(x(mm) - 10));
    const l = $('.td-lim'); l.setAttribute('x1', String(x(j.limitMm))); l.setAttribute('x2', String(x(j.limitMm)));
    $('.td-limt').setAttribute('x', String(x(j.limitMm) + 12));
  };
  const setUnitFor = () => { q('unit').value = q('region').value === 'usa' ? '32' : 'mm'; };
  q('region').addEventListener('change', () => { const was = q('unit').value; setUnitFor(); if (was !== q('unit').value) q('depth').value = q('unit').value === '32' ? '5' : '3'; });
  q('unit').addEventListener('change', (e) => {
    // convert the typed number so the tyre stays the same
    const v = parseFloat(q('depth').value); if (!isFinite(v)) return;
    q('depth').value = q('unit').value === '32' ? fmt(to32nds(v)) : fmt(from32nds(v));
  });
  presetCountry(q('region'));
  root.addEventListener('input', calc); root.addEventListener('change', calc);
  calc();
</script>
