---
// Kepler's laws orbit lab: launch a planet, see its ellipse and equal areas in equal times, check T² = a³
// with the planets, and see how g changes above and below the surface. Maths in src/lib/sci/kepler.ts.
import '../../styles/astro.css';
---
<div class="ax ko">
  <div class="ax-card">
    <div class="ax-row ko-top">
      <span class="ko-lab">Level</span>
      <div class="ax-seg ko-level" role="group" aria-label="Level">
        <button type="button" data-l="9" aria-pressed="false">Class 9</button>
        <button type="button" data-l="11" aria-pressed="true">Class 11</button>
      </div>
    </div>
    <div class="ax-seg ko-mode" role="group" aria-label="What to explore">
      <button type="button" data-m="launch" aria-pressed="true">Launch a planet</button>
      <button type="button" data-m="third" aria-pressed="false">T² = a³</button>
      <button type="button" data-m="g" aria-pressed="false">g above and below</button>
    </div>
    <canvas class="ko-c" aria-label="Orbit"></canvas>

    <div class="ko-p ko-p-launch">
      <div class="ax-row"><button type="button" class="btn small ko-go">Play</button><button type="button" class="btn secondary small ko-reset">Reset</button><span class="ax-help">Drag the arrow tip to change the launch speed.</span></div>
      <label>Launch speed (sideways, 1 AU from a Sun-like star): <b class="ko-vv"></b><input class="ko-v" type="range" min="15" max="50" step="0.5" value="36" /></label>
      <label class="ax-check"><input class="ko-areas" type="checkbox" checked /> Shade the area swept in each twelfth of the orbit</label>
    </div>
    <div class="ko-p ko-p-third" hidden>
      <p class="ax-help">Each dot is a planet: its average distance from the Sun a (in AU, the Earth's distance = 1) and its year T (in Earth years). On these log scales T² = a³ is a straight line. The planet values are rounded.</p>
      <div class="ax-scroll"><table class="ko-tab"><thead><tr><th>Planet</th><th class="r">a (AU)</th><th class="r">T (years)</th><th class="r">T² ÷ a³</th></tr></thead><tbody></tbody></table></div>
    </div>
    <div class="ko-p ko-p-g" hidden>
      <label>Height above the Earth's surface (negative = depth below): <b class="ko-hv"></b><input class="ko-h" type="range" min="-6371" max="19113" step="1" value="6371" /></label>
      <p class="ax-help">A model Earth: a uniform ball of radius 6,371 km with g = 9.8 m/s² at the surface. The real Earth is denser in the middle, so g inside changes differently.</p>
    </div>
  </div>

  <div class="ax-card">
    <h2 class="ko-h2">The orbit</h2>
    <p class="ko-state"><span class="ax-pill ko-pill"></span></p>
    <dl class="ax-facts ko-facts"></dl>
    <div class="ko-eq"></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="ko-try">
      <li>Set the launch speed to 29.8 km/s: a circle, the Earth's orbit, one year round.</li>
      <li>Go faster: the orbit stretches into an ellipse with the star at one focus, and the year gets longer.</li>
      <li>Watch the shaded slices: each is swept in the same time. Near the star the planet moves faster, so its slices are short and wide.</li>
      <li>Push past 42.1 km/s, the escape speed: the planet never comes back.</li>
      <li>In g above and below, go up one Earth radius: g falls to a quarter. Go half-way to the centre: g is half.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <div class="ko-quiz"></div>
  </div>
</div>

<script>
  import { AU_PER_YR_KMS, orbit, position, sweptArea, openPath, PLANETS, gAt, surfaceSpeeds, questions, type Orbit } from '../../lib/sci/kepler';
  import { mountQuiz } from '../../lib/school-quiz-b';
  import { pagePalette, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.ko')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const inp = (c: string) => q<HTMLInputElement>(c);
  const val = (c: string) => Number(inp(c).value);
  const f = (x: number, d = 2) => { const r = Math.round(x * 10 ** d) / 10 ** d; return (Object.is(r, -0) ? 0 : r).toFixed(d).replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '').replace('-', '−'); };
  const H = 320, RE = 6371, G0 = 9.8;
  let level: 9 | 11 = 11, mode: 'launch' | 'third' | 'g' = 'launch';
  let t = 0, playing = false, raf = 0, last = 0;
  let view = { cx: 0, cy: 0, sc: 1, tipX: 0, tipY: 0, x0: 0, y0: 0 };

  const vAU = () => val('.ko-v') / AU_PER_YR_KMS;
  function setup(c: HTMLCanvasElement, h: number) {
    const w = Math.max(260, Math.round(c.clientWidth || c.parentElement!.clientWidth || 320)), dpr = Math.min(3, window.devicePixelRatio || 1);
    c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); c.style.height = `${h}px`;
    const ctx = c.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { ctx, w };
  }
  function fact(k: string, v: string, sm = '') {
    const d = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd');
    dt.textContent = k; dd.textContent = v;
    if (sm) { const e = document.createElement('small'); e.textContent = sm; dd.append(e); }
    d.append(dt, dd); return d;
  }
  function para(parts: (string | [string])[]) { const el = document.createElement('p'); for (const x of parts) { if (typeof x === 'string') el.append(x); else { const b = document.createElement('b'); b.textContent = x[0]; el.append(b); } } return el; }

  // ---- launch ----------------------------------------------------------------------------------------------
  function drawLaunch(pal: Palette, o: Orbit) {
    const c = q<HTMLCanvasElement>('.ko-c'), { ctx, w } = setup(c, H);
    ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, w, H);
    // path points
    let xs: number[] = [], ys: number[] = [];
    if (o.bound) { for (let i = 0; i <= 360; i++) { const p = position(o, (o.T * i) / 360); xs.push(p.x); ys.push(p.y); } }
    else { const p = openPath(1, vAU(), 3); xs = p.x; ys = p.y; }
    let x0 = Math.min(-0.3, ...xs), x1 = Math.max(1.3, ...xs), y0 = Math.min(-0.6, ...ys), y1 = Math.max(0.6, ...ys);
    if (!o.bound) { x0 = Math.max(x0, -6); x1 = Math.min(x1, 6); y0 = Math.max(y0, -6); y1 = Math.min(y1, 6); }
    const pad = 22, sc = Math.min((w - 2 * pad) / (x1 - x0), (H - 2 * pad) / (y1 - y0));
    const cx = w / 2 - ((x0 + x1) / 2) * sc, cy = H / 2 + ((y0 + y1) / 2) * sc;
    const X = (x: number) => cx + x * sc, Y = (y: number) => cy - y * sc;
    // equal-area slices
    if (o.bound && inp('.ko-areas').checked) {
      for (let k = 0; k < 12; k++) {
        ctx.save(); ctx.globalAlpha = pal.red ? (k % 2 ? 0.25 : 0.5) : k % 2 ? 0.12 : 0.26; ctx.fillStyle = pal.accent; ctx.beginPath(); ctx.moveTo(X(0), Y(0));
        for (let i = 0; i <= 30; i++) { const p = position(o, (o.T * (k + i / 30)) / 12); ctx.lineTo(X(p.x), Y(p.y)); }
        ctx.closePath(); ctx.fill(); ctx.restore();
      }
    }
    // reference: the Earth's circular orbit
    ctx.save(); ctx.setLineDash([4, 4]); ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(X(0), Y(0), sc, 0, 7); ctx.stroke(); ctx.restore();
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2; ctx.beginPath(); xs.forEach((x, i) => (i ? ctx.lineTo(X(x), Y(ys[i])) : ctx.moveTo(X(x), Y(ys[i])))); ctx.stroke();
    // star and planet
    ctx.fillStyle = pal.accent2; ctx.beginPath(); ctx.arc(X(0), Y(0), 8, 0, 7); ctx.fill();
    let px = 1, py = 0;
    if (o.bound) { const p = position(o, t); px = p.x; py = p.y; }
    else { const p = openPath(1, vAU(), Math.max(1e-6, t), undefined, Math.max(10, Math.round(t * 800))); px = p.x.at(-1)!; py = p.y.at(-1)!; }
    ctx.fillStyle = pal.ink; ctx.beginPath(); ctx.arc(X(px), Y(py), 6, 0, 7); ctx.fill();
    if (o.bound && level === 11) { ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(px), Y(py)); ctx.stroke(); }
    // launch arrow (drag its tip)
    const L = Math.min(110, val('.ko-v') * 2.2);
    ctx.strokeStyle = pal.accent; ctx.fillStyle = pal.accent; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(X(1), Y(0)); ctx.lineTo(X(1), Y(0) - L + 8); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(X(1), Y(0) - L); ctx.lineTo(X(1) - 6, Y(0) - L + 11); ctx.lineTo(X(1) + 6, Y(0) - L + 11); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.arc(X(1), Y(0) - L, 10, 0, 7); ctx.lineWidth = 1.5; ctx.stroke();
    ctx.font = '600 12px system-ui, sans-serif'; const lab = `${f(val('.ko-v'), 1)} km/s`, right = X(1) + 14 + ctx.measureText(lab).width < w - 4; ctx.textAlign = right ? 'left' : 'right'; ctx.fillText(lab, right ? X(1) + 14 : X(1) - 14, Y(0) - L + 4);
    view = { cx, cy, sc, tipX: X(1), tipY: Y(0) - L, x0: X(1), y0: Y(0) };
    c.dataset.tip = `${Math.round(X(1))},${Math.round(Y(0) - L)}`;
    c.setAttribute('aria-label', o.bound ? `Ellipse with a = ${f(o.a)} AU, e = ${f(o.e)}, period ${f(o.T)} years` : 'Open orbit: the planet escapes');
  }
  function launchReadouts(o: Orbit) {
    const v = val('.ko-v'), vc = o.vCirc * AU_PER_YR_KMS, ve = o.vEsc * AU_PER_YR_KMS;
    q('.ko-vv').textContent = `${f(v, 1)} km/s`;
    const pill = q('.ko-pill');
    const shape = !o.bound ? 'Escapes: an open orbit (it never comes back)' : o.e < 0.005 ? 'A circle' : `An ellipse (e = ${f(o.e)})`;
    pill.textContent = shape; pill.className = `ax-pill ${o.bound ? 'good' : 'warn'} ko-pill`;
    const facts = [fact('Launch speed', `${f(v, 1)} km/s`), fact('Circular orbit speed here', `${f(vc, 1)} km/s`, '√(GM/r)'), fact('Escape speed here', `${f(ve, 1)} km/s`, '√2 × circular speed')];
    if (o.bound) {
      facts.push(fact('Period T', `${f(o.T, 3)} years`, `${f(o.T * 365.25, 0)} days`), fact('Semi-major axis a', `${f(o.a, 3)} AU`, 'half the long axis'), fact('Closest to the star', `${f(o.rp, 3)} AU`), fact('Farthest from the star', `${f(o.ra, 3)} AU`));
      if (level === 11) facts.push(fact('Each shaded slice', `${f(sweptArea(o, 0, o.T / 12), 4)} AU²`, `swept in T/12 = ${f((o.T / 12) * 365.25, 1)} days`));
    }
    q('.ko-facts').replaceChildren(...facts);
    const eq: HTMLElement[] = [];
    if (o.bound) {
      eq.push(para([['First law: '], `the orbit is an ellipse with the star at one focus${o.e < 0.005 ? ' (a circle is an ellipse with e = 0)' : ''}.`]));
      eq.push(para([['Second law: '], 'the line from the star to the planet sweeps out equal areas in equal times, so the planet is fastest when it is closest.']));
      eq.push(para([['Third law: '], `T² = a³ in years and AU: ${f(o.T, 3)}² = ${f(o.T * o.T, 3)} and ${f(o.a, 3)}³ = ${f(o.a ** 3, 3)}.`]));
      if (level === 11) eq.push(para([['Energy: '], `E/m = v²/2 − GM/r is negative for a closed orbit and fixes a = −GM/2E = ${f(o.a, 3)} AU. At ${f(ve, 1)} km/s (√2 times the circular speed) it reaches zero and the planet escapes.`]));
    } else eq.push(para([['Escape: '], `at ${f(ve, 1)} km/s or more the kinetic energy beats the gravitational potential energy (½mv² ≥ GMm/r), so the total energy is not negative and the planet never returns.`]));
    q('.ko-eq').replaceChildren(...eq);
    q('.ko-h2').textContent = 'The orbit';
  }

  // ---- T² = a³ ----------------------------------------------------------------------------------------------
  function drawThird(pal: Palette) {
    const c = q<HTMLCanvasElement>('.ko-c'), { ctx, w } = setup(c, H);
    ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, w, H);
    const L = 46, R = 14, T0 = 14, B = H - 34, lx0 = -0.6, lx1 = 1.6, ly0 = -0.8, ly1 = 2.4;
    const X = (a: number) => L + ((Math.log10(a) - lx0) / (lx1 - lx0)) * (w - L - R), Y = (T: number) => B - ((Math.log10(T) - ly0) / (ly1 - ly0)) * (B - T0);
    ctx.font = '11px system-ui, sans-serif'; ctx.lineWidth = 1;
    for (const a of [0.3, 1, 3, 10, 30]) { ctx.strokeStyle = pal.grid; ctx.beginPath(); ctx.moveTo(X(a), T0); ctx.lineTo(X(a), B); ctx.stroke(); ctx.fillStyle = pal.muted; ctx.textAlign = 'center'; ctx.fillText(String(a), X(a), B + 14); }
    for (const T of [0.3, 1, 3, 10, 30, 100]) { ctx.strokeStyle = pal.grid; ctx.beginPath(); ctx.moveTo(L, Y(T)); ctx.lineTo(w - R, Y(T)); ctx.stroke(); ctx.fillStyle = pal.muted; ctx.textAlign = 'right'; ctx.fillText(String(T), L - 5, Y(T) + 4); }
    ctx.strokeStyle = pal.ink; ctx.beginPath(); ctx.moveTo(L, T0); ctx.lineTo(L, B); ctx.lineTo(w - R, B); ctx.stroke();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'right'; ctx.fillText('a (AU)', w - R, B + 28); ctx.textAlign = 'left'; ctx.fillText('T (years)', L + 4, T0 + 10);
    ctx.strokeStyle = pal.accent; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(X(10 ** lx0), Y(10 ** (1.5 * lx0))); ctx.lineTo(X(10 ** lx1), Y(10 ** (1.5 * lx1))); ctx.stroke();
    ctx.font = '600 11px system-ui, sans-serif';
    PLANETS.forEach(([nm, a, T], i) => { ctx.fillStyle = pal.ink; ctx.beginPath(); ctx.arc(X(a), Y(T), 4.5, 0, 7); ctx.fill(); ctx.textAlign = i < 4 && i % 2 ? 'right' : 'left'; ctx.fillText(nm, X(a) + (i < 4 && i % 2 ? -8 : 8), Y(T) + (i < 4 ? (i % 2 ? -6 : 12) : 4)); });
    const o = orbit(1, vAU());
    if (o.bound && o.a <= 40) { ctx.fillStyle = pal.accent2; ctx.beginPath(); ctx.arc(X(o.a), Y(o.T), 6, 0, 7); ctx.fill(); ctx.textAlign = 'left'; ctx.fillText('your orbit', X(o.a) + 8, Y(o.T) - 8); }
    c.setAttribute('aria-label', 'Period against distance for the planets on log scales: a straight line T² = a³');
  }
  function thirdReadouts() {
    const tb = q('.ko-tab tbody');
    tb.replaceChildren(...PLANETS.map(([nm, a, T]) => { const tr = document.createElement('tr'); for (const [v, r] of [[nm, false], [String(a), true], [String(T), true], [f((T * T) / a ** 3, 3), true]] as [string, boolean][]) { const td = document.createElement('td'); td.textContent = v; if (r) td.className = 'r'; tr.append(td); } return tr; }));
    const o = orbit(1, vAU()), pill = q('.ko-pill'); pill.className = 'ax-pill ko-pill';
    pill.textContent = 'T² ÷ a³ is the same for every planet';
    q('.ko-facts').replaceChildren(...(o.bound ? [fact('Your launched orbit', `a = ${f(o.a, 3)} AU`, `T = ${f(o.T, 3)} years`), fact('T² ÷ a³', f((o.T * o.T) / o.a ** 3, 3), 'exactly 1 for any orbit of the Sun')] : [fact('Your launched orbit', 'escapes', 'no period')]));
    q('.ko-eq').replaceChildren(para([['Why a straight line: '], 'T² = a³ means log T = 1.5 log a, a straight line of slope 1.5 on log-log axes. Newton showed T² = (4π²/GM) a³, so the constant depends only on the mass of the Sun.']));
    q('.ko-h2').textContent = "Kepler's third law";
  }

  // ---- g above and below ------------------------------------------------------------------------------------
  function drawG(pal: Palette) {
    const c = q<HTMLCanvasElement>('.ko-c'), { ctx, w } = setup(c, H);
    ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, w, H);
    const L = 46, R = 14, T0 = 16, B = H - 34, rMax = 4;
    const X = (r: number) => L + (r / rMax) * (w - L - R), Y = (g: number) => B - (g / 10) * (B - T0);
    ctx.font = '11px system-ui, sans-serif'; ctx.lineWidth = 1;
    for (let g = 0; g <= 10; g += 2) { ctx.strokeStyle = pal.grid; ctx.beginPath(); ctx.moveTo(L, Y(g)); ctx.lineTo(w - R, Y(g)); ctx.stroke(); ctx.fillStyle = pal.muted; ctx.textAlign = 'right'; ctx.fillText(String(g), L - 5, Y(g) + 4); }
    for (let r = 0; r <= rMax; r++) { ctx.fillStyle = pal.muted; ctx.textAlign = 'center'; ctx.fillText(r ? `${r}R` : 'centre', X(r), B + 14); }
    ctx.save(); ctx.globalAlpha = pal.red ? 0.3 : 0.12; ctx.fillStyle = pal.accent; ctx.fillRect(X(0), T0, X(1) - X(0), B - T0); ctx.restore();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'center'; ctx.fillText('inside the Earth', (X(0) + X(1)) / 2, T0 + 12);
    ctx.strokeStyle = pal.ink; ctx.beginPath(); ctx.moveTo(L, T0); ctx.lineTo(L, B); ctx.lineTo(w - R, B); ctx.stroke();
    ctx.fillStyle = pal.muted; ctx.textAlign = 'right'; ctx.fillText('distance from the centre', w - R, B + 28); ctx.textAlign = 'left'; ctx.fillText('g (m/s²)', L + 4, T0 + 26);
    ctx.strokeStyle = pal.ink; ctx.lineWidth = 2.2; ctx.beginPath();
    for (let i = 0; i <= 400; i++) { const r = (rMax * i) / 400, g = gAt(r, 1, G0); i ? ctx.lineTo(X(r), Y(g)) : ctx.moveTo(X(r), Y(g)); }
    ctx.stroke();
    const r = 1 + val('.ko-h') / RE, g = gAt(r, 1, G0);
    ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(X(r), B); ctx.lineTo(X(r), Y(g)); ctx.stroke();
    ctx.fillStyle = pal.accent; ctx.beginPath(); ctx.arc(X(r), Y(g), 6, 0, 7); ctx.fill();
    c.setAttribute('aria-label', `g = ${f(g)} m/s² at ${f(r)} Earth radii from the centre`);
  }
  function gReadouts() {
    const h = val('.ko-h'), r = 1 + h / RE, g = gAt(r, 1, G0), s = surfaceSpeeds(G0, RE * 1000);
    q('.ko-hv').textContent = h >= 0 ? `${h.toLocaleString('en')} km up (${f(h / RE)} R)` : `${(-h).toLocaleString('en')} km deep (${f(-h / RE)} R)`;
    const pill = q('.ko-pill'); pill.className = 'ax-pill ko-pill'; pill.textContent = `g = ${f(g)} m/s², ${f((g / G0) * 100, 1)} % of the surface value`;
    q('.ko-facts').replaceChildren(fact('g here', `${f(g)} m/s²`), fact('Weight of a 50 kg student', `${f(50 * g, 1)} N`, `${f(50 * G0, 0)} N on the surface; the mass is still 50 kg`), fact('Escape speed from the surface', `${f(s.escape / 1000, 1)} km/s`, '√(2 g R)'), fact('Speed of a low orbit', `${f(s.orbit / 1000, 1)} km/s`, '√(g R)'));
    const eq = [para([[h >= 0 ? 'Above the surface: ' : 'Below the surface: '], h >= 0 ? `g = g₀ (R ÷ (R + h))² = 9.8 × (1 ÷ ${f(r, 3)})² = ${f(g)} m/s². Gravity follows the inverse square law: twice as far from the centre, a quarter of the pull.` : `only the part of the Earth below you pulls you (net), so for a uniform Earth g = g₀ (1 − d ÷ R) = 9.8 × (1 − ${f(-h / RE, 3)}) = ${f(g)} m/s². At the centre g = 0.`])];
    if (level === 11) eq.push(para([['From Newton: '], 'g = GM/r² outside. With g₀ = GM/R² this gives g = g₀R²/r². Inside a uniform ball only the mass within r counts, M(r) = M r³/R³, so g = GM r/R³ = g₀ r/R.']));
    q('.ko-eq').replaceChildren(...eq);
    q('.ko-h2').textContent = 'Gravity with height and depth';
  }

  function draw() {
    const pal = pagePalette();
    if (mode === 'launch') { const o = orbit(1, vAU()); drawLaunch(pal, o); launchReadouts(o); }
    else if (mode === 'third') { drawThird(pal); thirdReadouts(); }
    else { drawG(pal); gReadouts(); }
  }
  function stop() { playing = false; cancelAnimationFrame(raf); raf = 0; q('.ko-go').textContent = 'Play'; }
  q('.ko-go').addEventListener('click', () => {
    if (playing) { stop(); return; }
    playing = true; q('.ko-go').textContent = 'Pause'; last = performance.now();
    const tick = (now: number) => {
      if (!playing) return;
      const o = orbit(1, vAU()), rate = o.bound ? o.T / 6 : 0.5; // one orbit in 6 s
      t += Math.min(0.1, (now - last) / 1000) * rate; last = now;
      if (!o.bound && t > 3) { stop(); draw(); return; }
      draw(); raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
  });
  q('.ko-reset').addEventListener('click', () => { stop(); t = 0; draw(); });
  inp('.ko-v').addEventListener('input', () => { t = 0; draw(); });
  inp('.ko-areas').addEventListener('change', draw);
  inp('.ko-h').addEventListener('input', draw);
  // drag the arrow tip
  const cv = q<HTMLCanvasElement>('.ko-c');
  let drag = false;
  cv.addEventListener('pointerdown', (e) => {
    if (mode !== 'launch') return;
    const r = cv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    if (Math.hypot(x - view.tipX, y - view.tipY) < 28) { drag = true; cv.setPointerCapture(e.pointerId); stop(); e.preventDefault(); }
  });
  cv.addEventListener('pointermove', (e) => {
    if (!drag) return;
    const r = cv.getBoundingClientRect(), y = e.clientY - r.top, L = Math.max(0, view.y0 - y);
    inp('.ko-v').value = String(Math.max(15, Math.min(50, Math.round((L / 2.2) * 2) / 2))); t = 0; draw();
  });
  const up = () => { drag = false; }; cv.addEventListener('pointerup', up); cv.addEventListener('pointercancel', up);

  root.querySelectorAll<HTMLButtonElement>('.ko-level button').forEach((b) => b.addEventListener('click', () => {
    level = Number(b.dataset.l) as 9 | 11;
    root.querySelectorAll('.ko-level button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    renderQuiz(); draw();
  }));
  root.querySelectorAll<HTMLButtonElement>('.ko-mode button').forEach((b) => b.addEventListener('click', () => {
    stop(); mode = b.dataset.m as typeof mode;
    root.querySelectorAll('.ko-mode button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    for (const m of ['launch', 'third', 'g']) q(`.ko-p-${m}`).hidden = m !== mode;
    draw();
  }));

  let renderQuiz = () => {};
  renderQuiz = mountQuiz(q('.ko-quiz'), () => questions(level));
  draw();
  document.addEventListener('fibub:theme', draw);
