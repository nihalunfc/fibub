---
// #1726 India tax: FY 2026-27 new regime vs old regime, side by side.
---
<div class="tool-ui iit">
  <section class="panel">
    <h2>Your income in FY 2026-27</h2>
    <div class="iit-grid">
      <label>Your age <select class="iit-age">
        <option value="under60">Under 60</option>
        <option value="60to79">60 to 79 (senior citizen)</option>
        <option value="80plus">80 or over (super senior)</option>
      </select></label>
      <label>Gross salary for the year (₹) <input class="iit-sal" inputmode="decimal" value="15,00,000" /></label>
      <label>Other income: interest, rent, other (₹) <input class="iit-oth" inputmode="decimal" value="0" /></label>
    </div>
    <details class="iit-old" open>
      <summary>Old regime deductions (the new regime ignores these)</summary>
      <div class="iit-grid">
        <label>HRA exemption (₹) <input class="iit-hra" inputmode="decimal" value="0" /></label>
        <label>80C: PF, PPF, ELSS, insurance (max 1,50,000) <input class="iit-80c" inputmode="decimal" value="1,50,000" /></label>
        <label>80D: health insurance, you and family <input class="iit-80d" inputmode="decimal" value="25,000" /></label>
        <label>80D: parents' health insurance <input class="iit-80dp" inputmode="decimal" value="0" /></label>
        <label class="iit-chk"><input type="checkbox" class="iit-ps" /> Parents are 60 or over</label>
        <label>Home loan interest, 24(b) (max 2,00,000) <input class="iit-home" inputmode="decimal" value="0" /></label>
        <label>Own NPS, 80CCD(1B) (max 50,000) <input class="iit-nps" inputmode="decimal" value="0" /></label>
      </div>
    </details>
    <p class="iit-hint">Resident individuals, amounts for the whole year in rupees. HRA: type the exempt amount from your Form 16 or payslip.</p>
  </section>

  <section class="iit-res" aria-live="polite">
    <p class="iit-verdict"></p>
    <div class="iit-cols">
      <div class="panel iit-col" data-reg="new"><h3>New regime</h3><b class="iit-tot"></b><span class="iit-sub"></span><table><tbody></tbody></table></div>
      <div class="panel iit-col" data-reg="old"><h3>Old regime</h3><b class="iit-tot"></b><span class="iit-sub"></span><table><tbody></tbody></table></div>
    </div>
    <figure class="panel iit-fig">
      <figcaption>Tax for each regime</figcaption>
      <div class="iit-bars"></div>
    </figure>
  </section>
  <p class="iit-fine">Estimate for resident individuals, income taxed at slab rates only (no capital gains or special-rate income). Uses the FY 2026-27 slabs, which Budget 2026-27 left as they were; the Income-tax Act, 2025 renumbers the sections from 1 April 2026. Not financial or tax advice: check the official source (incometax.gov.in) or a tax professional. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .iit { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .iit h2 { margin: 0 0 12px; font-size: 18px; }
  .iit h3 { margin: 0; font-size: 16px; }
  .iit .panel { padding: 16px; }
  .iit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .iit label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .iit .iit-chk { display: flex; align-items: center; gap: 8px; color: var(--ink); align-self: end; padding-bottom: 10px; }
  .iit input:not([type=checkbox]), .iit select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .iit-old { margin-top: 14px; }
  .iit-old summary { cursor: pointer; font-weight: 600; margin-bottom: 12px; }
  .iit-hint, .iit-fine { color: var(--muted); font-size: 14px; margin: 10px 0 0; }
  .iit-res { display: grid; gap: 12px; min-width: 0; }
  .iit-verdict { margin: 0; font-size: 17px; font-weight: 600; }
  .iit-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .iit-col { display: grid; gap: 4px; align-content: start; min-width: 0; }
  .iit-col.best { border-color: var(--good); box-shadow: inset 0 0 0 1px var(--good); }
  .iit-tot { font-size: 22px; }
  .iit-col.best .iit-tot { color: var(--good); }
  .iit-sub { font-size: 13px; color: var(--muted); }
  .iit table { border-collapse: collapse; width: 100%; font-size: 14px; margin-top: 8px; }
  .iit td { padding: 6px 4px; border-bottom: 1px solid var(--line); text-align: right; }
  .iit td:first-child { text-align: left; color: var(--muted); }
  .iit tr.tot td { font-weight: 700; color: var(--ink); }
  .iit-fig { margin: 0; }
  .iit-fig figcaption { font-weight: 600; margin-bottom: 10px; }
  .iit-bars { display: grid; gap: 8px; }
  .iit-bars div { display: grid; gap: 4px; font-size: 14px; }
  .iit-bars i { display: block; height: 22px; border-radius: 6px; background: var(--accent); min-width: 2px; }
  .iit-bars .best i { background: var(--good); }
  @media (max-width: 640px) { .iit-cols { grid-template-columns: 1fr; } }
</style>

<script>
  import { indiaTax, type Age } from '../../lib/money/india-income-tax.ts';
  const root = document.querySelector('.iit') as HTMLElement;
  const q = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const val = (s: string) => { const n = parseFloat(q<HTMLInputElement>(s).value.replace(/[^0-9.\-]/g, '')); return isFinite(n) ? n : 0; };
  const inr = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN');
  const pct = (n: number) => `${(Math.round(n * 1000) / 10).toFixed(1)}%`;

  const update = () => {
    const r = indiaTax({
      age: q<HTMLSelectElement>('.iit-age').value as Age, salary: val('.iit-sal'), other: val('.iit-oth'), hra: val('.iit-hra'),
      c80: val('.iit-80c'), d80: val('.iit-80d'), d80parents: val('.iit-80dp'), parentsSenior: q<HTMLInputElement>('.iit-ps').checked,
      home: val('.iit-home'), nps: val('.iit-nps'),
    });
    q('.iit-verdict').textContent = r.saving < 1 ? 'Both regimes give the same tax.'
      : `The ${r.better} regime saves you ${inr(r.saving)} a year (${inr(r.saving / 12)} a month).`;
    const max = Math.max(r.new.total, r.old.total, 1);
    for (const reg of ['new', 'old'] as const) {
      const s = r[reg], col = q(`.iit-col[data-reg=${reg}]`);
      col.classList.toggle('best', r.better === reg && r.saving >= 1);
      (col.querySelector('.iit-tot') as HTMLElement).textContent = inr(s.total);
      (col.querySelector('.iit-sub') as HTMLElement).textContent = `Tax a year · ${inr(s.total / 12)} a month · average ${pct(s.gross ? s.total / s.gross : 0)}, marginal ${pct(s.marginal)}`;
      const rows: [string, number][] = [['Total income', s.gross], ...s.deductions.map((d) => [`− ${d.label}`, d.amount] as [string, number]),
        ['Taxable income', s.taxable], ['Tax on slabs', s.slabTax]];
      if (s.rebate) rows.push([reg === 'new' && s.taxable > 1200000 ? '− Marginal relief (87A)' : '− Rebate 87A', s.rebate]);
      if (s.surcharge) rows.push(['+ Surcharge', s.surcharge]);
      rows.push(['+ Cess 4%', s.cess]);
      (col.querySelector('tbody') as HTMLElement).innerHTML = rows.map(([l, v]) => `<tr><td>${l}</td><td>${inr(v)}</td></tr>`).join('')
        + `<tr class="tot"><td>Total tax</td><td>${inr(s.total)}</td></tr><tr class="tot"><td>Left after tax</td><td>${inr(s.takeHome)}</td></tr>`;
    }
    q('.iit-bars').innerHTML = (['new', 'old'] as const).map((reg) => `<div class="${r.better === reg && r.saving >= 1 ? 'best' : ''}"><span>${reg === 'new' ? 'New' : 'Old'} ${inr(r[reg].total)}</span><i style="width:${(r[reg].total / max) * 100}%"></i></div>`).join('');
  };
  root.addEventListener('input', update);
  root.addEventListener('change', update);
  update();
</script>
