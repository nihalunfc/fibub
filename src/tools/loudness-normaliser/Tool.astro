---
// #T960 Loudness normaliser: measure LUFS, loudness range and true peak (ITU-R BS.1770-4, EBU R 128) and save a copy at a target.
// Maths in src/lib/audio/loudness.ts (checks in tests/audio.mjs). Nothing is uploaded.
import { TARGETS } from '../../lib/audio/loudness.ts';
---
<div class="tool-ui ln">
  <section class="panel">
    <div class="ln-drop">
      <button type="button" class="btn ln-open">Open a sound file</button>
      <input class="ln-file" type="file" accept="audio/*,.mp3,.wav,.ogg,.opus,.m4a,.aac,.flac,.webm,.mp4" hidden />
      <span class="ln-name">Or drop it here. MP3, WAV, M4A, FLAC, OGG, up to 500 MB. It stays on this device.</span>
    </div>
    <p class="note bad ln-err" hidden></p>
  </section>

  <section class="panel ln-res" hidden>
    <h2 class="ln-h">Measured</h2>
    <dl class="ln-grid">
      <div><dt>Integrated loudness</dt><dd class="ln-i"></dd></div>
      <div><dt>True peak</dt><dd class="ln-tp"></dd></div>
      <div><dt>Loudness range</dt><dd class="ln-lra"></dd></div>
      <div><dt>Loudest 3 s (short-term)</dt><dd class="ln-st"></dd></div>
      <div><dt>Loudest 0.4 s (momentary)</dt><dd class="ln-m"></dd></div>
      <div><dt>Sample peak</dt><dd class="ln-sp"></dd></div>
    </dl>
    <div class="ln-two">
      <label>Target
        <select class="ln-target">
          {TARGETS.map((t, i) => <option value={t.id} selected={i === 1}>{t.name}</option>)}
          <option value="custom">My own target</option>
        </select>
      </label>
      <label>Target loudness (LUFS) <input class="ln-lufs" type="number" min="-40" max="-5" step="0.5" value="-16" inputmode="decimal" /></label>
      <label>Highest true peak (dBTP) <input class="ln-peak" type="number" min="-9" max="0" step="0.5" value="-1" inputmode="decimal" /></label>
      <label>Save as
        <select class="ln-bits"><option value="16">WAV 16-bit</option><option value="24">WAV 24-bit (for more editing)</option></select>
      </label>
    </div>
    <p class="ln-plan" aria-live="polite"></p>
    <div class="ln-row">
      <button type="button" class="btn ln-save">Download at the target</button>
      <button type="button" class="btn secondary ln-play">Play 10 s from the loudest part</button>
    </div>
    <p class="ln-fine">The whole file is turned up or down by the same amount, so nothing else about the sound changes. If the target would push the peaks too high, it stops short and says so; a limiter in an editor can then squeeze the peaks.</p>
  </section>
</div>

<style is:inline>
  .ln { display: grid; gap: 14px; margin-bottom: 32px; }
  .ln .panel { display: grid; gap: 12px; padding: 16px; }
  .ln [hidden] { display: none !important; }
  .ln-drop { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; border: 2px dashed var(--line); border-radius: 12px; padding: 14px; }
  .ln-drop.over { border-color: var(--accent); }
  .ln-name, .ln-fine, .ln-plan { color: var(--muted); font-size: 14px; margin: 0; }
  .ln-plan { color: var(--ink); font-size: 16px; }
  .ln-h { font-size: 18px; margin: 0; }
  .ln-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: 10px; margin: 0; }
  .ln-grid div { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .ln-grid dt { color: var(--muted); font-size: 13px; }
  .ln-grid dd { margin: 2px 0 0; font-size: 20px; font-variant-numeric: tabular-nums; }
  .ln-two { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .ln label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .ln input, .ln select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .ln-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .ln .warn { color: var(--warn, #8a5a00); }
</style>

<script>
  import { measure, planGain, TARGETS, type Loudness } from '../../lib/audio/loudness.ts';
  import { writeWav, type Sound } from '../../lib/audio/pcm.ts';
  import { decodeFile, baseName, saveBytes, player } from '../../lib/audio/browser.ts';
  const root = document.querySelector('.ln') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const input = $<HTMLInputElement>('.ln-file'), err = $('.ln-err'), tSel = $<HTMLSelectElement>('.ln-target');
  const lufsIn = $<HTMLInputElement>('.ln-lufs'), peakIn = $<HTMLInputElement>('.ln-peak'), plan = $('.ln-plan'), saveB = $<HTMLButtonElement>('.ln-save');
  let snd: Sound | null = null, L: Loudness | null = null, name = 'sound';
  const play = player();
  const f1 = (v: number) => (isFinite(v) ? (Math.round(v * 10) / 10).toFixed(1).replace('-', '−') : '—');

  const gainNow = () => planGain(L!, +lufsIn.value, +peakIn.value);
  const update = () => {
    if (!L) return;
    if (!isFinite(L.integrated)) { plan.textContent = 'This file is silent (or too quiet to measure), so there is nothing to change.'; saveB.disabled = true; return; }
    const g = gainNow(), reach = L.integrated + g.gain;
    saveB.disabled = false;
    plan.className = 'ln-plan' + (g.limitedByPeak ? ' warn' : '');
    plan.textContent = `${g.gain >= 0 ? 'Turn up' : 'Turn down'} by ${f1(Math.abs(g.gain))} dB → ${f1(reach)} LUFS, true peak ${f1(L.truePeak + g.gain)} dBTP.` +
      (g.limitedByPeak ? ` It stops ${f1(+lufsIn.value - reach)} dB short of ${f1(+lufsIn.value)} LUFS so the peaks stay at or under ${f1(+peakIn.value)} dBTP.` : '');
  };
  const show = () => {
    const l = L!;
    $('.ln-i').textContent = `${f1(l.integrated)} LUFS`; $('.ln-tp').textContent = `${f1(l.truePeak)} dBTP`;
    $('.ln-lra').textContent = `${f1(l.range)} LU`; $('.ln-st').textContent = `${f1(l.maxShortTerm)} LUFS`;
    $('.ln-m').textContent = `${f1(l.maxMomentary)} LUFS`; $('.ln-sp').textContent = `${f1(l.samplePeak)} dBFS`;
    $('.ln-res').hidden = false; update();
  };
  const open = async (f: File) => {
    err.hidden = true; play.stop();
    if (f.size > 500e6) { err.textContent = 'Too big: files up to 500 MB.'; err.hidden = false; return; }
    $('.ln-name').textContent = `${f.name}: measuring…`;
    await new Promise((r) => setTimeout(r, 30));
    try { snd = await decodeFile(f); } catch { err.textContent = 'This browser cannot read that file. Try MP3 or WAV.'; err.hidden = false; $('.ln-name').textContent = f.name; return; }
    name = baseName(f.name);
    await new Promise((r) => setTimeout(r, 0));
    L = measure(snd.chans, snd.rate);
    const s = snd.chans[0].length / snd.rate;
    $('.ln-name').textContent = `${f.name}: ${s >= 60 ? Math.floor(s / 60) + ' min ' + Math.round(s % 60) + ' s' : s.toFixed(1) + ' s'}, ${snd.chans.length === 1 ? 'mono' : snd.chans.length === 2 ? 'stereo' : snd.chans.length + ' channels'}, ${snd.rate.toLocaleString('en-US')} Hz.`;
    show();
  };
  const scaled = () => { const g = Math.pow(10, gainNow().gain / 20); return snd!.chans.map((c) => c.map((v) => v * g)); };

  tSel.addEventListener('change', () => { const t = TARGETS.find((x) => x.id === tSel.value); if (t) { lufsIn.value = String(t.lufs); peakIn.value = String(t.peak); } update(); });
  for (const el of [lufsIn, peakIn]) el.addEventListener('input', () => { if (!TARGETS.some((t) => t.id === tSel.value && t.lufs === +lufsIn.value && t.peak === +peakIn.value)) tSel.value = 'custom'; update(); });
  saveB.addEventListener('click', () => { if (!snd) return; const bits = +$<HTMLSelectElement>('.ln-bits').value as 16 | 24; saveBytes(writeWav(scaled(), snd.rate, 1, bits), `${name}-${String(+lufsIn.value).replace('-', 'minus')}lufs.wav`, 'audio/wav'); });
  $('.ln-play').addEventListener('click', () => {
    const b = $<HTMLButtonElement>('.ln-play');
    if (play.playing) { play.stop(); b.textContent = 'Play 10 s from the loudest part'; return; }
    if (!snd) return;
    // Find the loudest second, then play 10 s around it at the new level.
    const c0 = snd.chans[0], r = snd.rate; let best = 0, at = 0;
    for (let s = 0; s + r <= c0.length; s += r) { let e = 0; for (let i = s; i < s + r; i++) e += c0[i] * c0[i]; if (e > best) { best = e; at = s; } }
    const a = Math.max(0, at - 4 * r), z = Math.min(c0.length, a + 10 * r), g = Math.pow(10, gainNow().gain / 20);
    b.textContent = 'Stop'; play.play(snd.chans.map((c) => c.slice(a, z).map((v) => Math.max(-1, Math.min(1, v * g)))), r, () => (b.textContent = 'Play 10 s from the loudest part'));
  });
  $('.ln-open').addEventListener('click', () => input.click());
  input.addEventListener('change', () => { if (input.files?.[0]) open(input.files[0]); input.value = ''; });
  const drop = $('.ln-drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); const f = e.dataTransfer?.files[0]; if (f) open(f); });
</script>
