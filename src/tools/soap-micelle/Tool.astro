---
// How soap cleans: a teaching model of soap molecules (water-loving head, oil-loving tail) that sit at the surface,
// gather into micelles round oil drops, and are used up as scum by hard-water ions. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
import '../../styles/chemquiz.css';
---
<div class="ax sm sm2">
  <div class="ax-card">
    <div class="ax-seg sm2-kind" role="group" aria-label="Cleaner"><button type="button" data-d="0" aria-pressed="true">Soap</button><button type="button" data-d="1" aria-pressed="false">Detergent</button></div>
    <svg class="sm-fig sm2-fig" viewBox="0 0 340 260" role="img" aria-label="A beaker of water with soap molecules, micelles, oil drops and scum" style="margin-top:10px"></svg>
    <p class="ax-big sm2-big" aria-live="polite" style="margin:8px 0 2px"></p>
    <p class="sm2-sub" style="margin:0 0 8px"></p>
    <div class="sm-sl"><b>S</b><input type="range" class="sm2-sr" min="0" max="600" step="10" value="300" aria-label="Soap molecules slider" /><input type="number" class="sm2-s" min="0" max="5000" step="1" value="300" inputmode="numeric" aria-label="Soap molecules" /></div>
    <div class="sm-sl"><b>H</b><input type="range" class="sm2-hr" min="0" max="200" step="5" value="0" aria-label="Hardness ions slider" /><input type="number" class="sm2-h" min="0" max="5000" step="1" value="0" inputmode="numeric" aria-label="Hardness ions (calcium and magnesium)" /></div>
    <div class="sm-sl"><b>O</b><input type="range" class="sm2-or" min="0" max="8" step="1" value="4" aria-label="Oil drops slider" /><input type="number" class="sm2-o" min="0" max="8" step="1" value="4" inputmode="numeric" aria-label="Oil drops" /></div>
    <p class="ax-help">S = soap (or detergent) molecules, H = calcium and magnesium ions in the water (hardness), O = drops of oily dirt. A teaching model: the numbers are made up and much smaller than in a real wash.</p>
    <div class="ax-row">
      <button type="button" class="btn secondary small sm2-pre" data-p="300,0,4">Soft water</button>
      <button type="button" class="btn secondary small sm2-pre" data-p="300,120,4">Hard water</button>
      <button type="button" class="btn secondary small sm2-pre" data-p="15,0,2">Too little soap</button>
    </div>
    <p class="ax-err sm2-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>A soap molecule</h2>
    <svg class="sm-fig sm2-mol" viewBox="0 0 340 90" role="img" aria-label="A soap molecule: a long carbon tail and a charged head"></svg>
    <ul class="sm-steps sm2-out"></ul>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Start with no soap and slowly add it. At first the molecules sit at the surface; micelles only form after the surface is full.</li>
      <li>Press "Hard water". The same soap makes scum and cannot lift the oil. How much more soap does it need?</li>
      <li>Switch to Detergent with hard water. Why do washing powders use detergents?</li>
      <li>Each micelle here holds one oil drop. How many micelles are needed for 8 drops?</li>
    </ul>
  </div>

  <div class="ax-card cq">
    <h2>Check yourself</h2>
    <p class="ax-help">In this model: each hardness ion uses up 2 soap molecules; the first 20 free molecules stay single; then every 24 make one micelle, which holds one oil drop. Nothing is saved.</p>
    <ol class="cq-list"></ol>
    <button type="button" class="btn secondary small cq-new">New questions</button>
  </div>
</div>

<style is:inline>
  .sm2 svg .sm2-water { fill: var(--accent-soft); stroke: var(--ink); stroke-width: 2; }
  .sm2 svg .sm2-head { fill: var(--accent); }
  .sm2 svg .sm2-tail { stroke: var(--ink); stroke-width: 1.6; fill: none; }
  .sm2 svg .sm2-oil { fill: #d9a520; stroke: #8a6510; stroke-width: 1; }
  .sm2 svg .sm2-scum { fill: var(--muted); }
  .sm2 svg .sm2-ca { fill: var(--bad); }
  .sm2 svg .sm2-cloth { fill: var(--bg); stroke: var(--muted); stroke-width: 1.5; }
  .sm2 svg .sm2-hl { font: 700 12px system-ui, sans-serif; fill: #fff; }
  .sm2 svg .sm2-lab { font: 600 11px system-ui, sans-serif; fill: var(--ink); }
</style>

<script>
  import { wash, soapNeeded, CMC, AGG } from '../../lib/sci/micelle-school';
  import { fmt } from '../../lib/sci/smath';
  import { S, pair, val } from '../../lib/smath-ui';
  import { mountQuiz, near, rint, type Question } from '../../lib/chemquiz';

  const root = document.querySelector<HTMLElement>('.sm2')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.sm2-fig'), mol = q<SVGSVGElement>('.sm2-mol');
  const Si = q<HTMLInputElement>('.sm2-s'), Hi = q<HTMLInputElement>('.sm2-h'), Oi = q<HTMLInputElement>('.sm2-o');
  const setS = pair(q('.sm2-sr'), Si, draw), setH = pair(q('.sm2-hr'), Hi, draw), setO = pair(q('.sm2-or'), Oi, draw);
  let det = false;

  // One soap molecule: head at (x, y), tail pointing at angle a (radians), length L.
  function molecule(x: number, y: number, a: number, L = 14) {
    let d = `M ${x} ${y}`;
    for (let i = 1; i <= 4; i++) { const t = (i / 4) * L, w = i % 2 ? 2.5 : -2.5; d += ` L ${x + t * Math.cos(a) - w * Math.sin(a)} ${y + t * Math.sin(a) + w * Math.cos(a)}`; }
    S('path', { d, class: 'sm2-tail' }, fig); S('circle', { cx: x, cy: y, r: 3, class: 'sm2-head' }, fig);
  }

  function draw() {
    const soap = Math.round(val(Si, 300, 0, 5000)), hard = Math.round(val(Hi, 0, 0, 5000)), oil = Math.round(val(Oi, 4, 0, 8));
    const err = q('.sm2-err'), bad = [Si, Hi, Oi].some((e) => e.value.trim() === '' || Number(e.value) < 0);
    err.hidden = !bad; if (bad) err.textContent = 'Use whole numbers of 0 or more (oil drops up to 8).';
    const w = wash({ soap, hard, oil, detergent: det });
    fig.replaceChildren();
    S('rect', { x: 20, y: 40, width: 300, height: 200, rx: 8, class: 'sm2-water' }, fig);
    S('rect', { x: 30, y: 222, width: 280, height: 12, rx: 3, class: 'sm2-cloth' }, fig);
    S('text', { x: 170, y: 252, 'text-anchor': 'middle', class: 'sm-tick' }, fig, 'dirty cloth');
    // Single molecules at the surface: heads in the water, tails up in the air.
    const single = Math.min(w.single, CMC);
    for (let i = 0; i < single; i++) molecule(30 + (i + 0.5) * (280 / CMC), 44, -Math.PI / 2 + (i % 2 ? 0.15 : -0.15), 12);
    // Oil still on the cloth.
    for (let i = 0; i < w.leftOil; i++) S('ellipse', { cx: 50 + i * 34, cy: 216, rx: 13, ry: 7, class: 'sm2-oil' }, fig);
    // Micelles: up to 8 drawn, the first `lifted` holding an oil drop.
    const shown = Math.min(w.micelles, 8);
    for (let k = 0; k < shown; k++) {
      const cx = 60 + (k % 4) * 70, cy = 95 + Math.floor(k / 4) * 62, hasOil = k < w.lifted, r = hasOil ? 22 : 17;
      if (hasOil) S('circle', { cx, cy, r: 9, class: 'sm2-oil' }, fig);
      for (let i = 0; i < 12; i++) { const a = (2 * Math.PI * i) / 12; molecule(cx + r * Math.cos(a), cy + r * Math.sin(a), a + Math.PI, hasOil ? 11 : 13); }
    }
    if (w.micelles > 8) S('text', { x: 170, y: 214, 'text-anchor': 'middle', class: 'sm2-lab' }, fig, `+ ${w.micelles - 8} more micelles`);
    // Hardness ions and scum.
    const freeIons = Math.max(0, hard - w.scumIons);
    for (let i = 0; i < Math.min(freeIons, 30); i++) S('circle', { cx: 34 + ((i * 53) % 270), cy: 70 + ((i * 37) % 130), r: 2.5, class: 'sm2-ca' }, fig);
    for (let i = 0; i < Math.min(w.scumIons, 60); i++) S('rect', { x: 26 + ((i * 47) % 286), y: 50 + (i % 3) * 4, width: 5, height: 3, class: 'sm2-scum' }, fig);
    q('.sm2-big').textContent = oil === 0 ? 'Nothing to clean' : w.clean ? 'Clean: every oil drop is held in a micelle' : `${w.leftOil} of ${oil} oil drop${oil === 1 ? '' : 's'} still on the cloth`;
    q('.sm2-sub').textContent = `${w.micelles} micelle${w.micelles === 1 ? '' : 's'}, ${w.free} free ${det ? 'detergent' : 'soap'} molecules, ${w.used} lost as scum. ${!det && hard > 0 ? `Least soap that would clean this: ${soapNeeded(oil, hard)}.` : ''}`;
    const lines = [
      det ? 'A detergent molecule is like soap but its head is a sulfonate (−SO₃⁻) group. Its calcium and magnesium salts dissolve, so it makes no scum and works in hard water.'
        : 'Soap is the sodium salt of a long-chain fatty acid, for example sodium stearate, C₁₇H₃₅COO⁻ Na⁺. It is made by heating fat or oil with sodium hydroxide (saponification).',
      'The long carbon tail mixes with oil but not with water (hydrophobic); the charged head mixes with water (hydrophilic).',
      `In water the molecules first line up at the surface, tails out of the water. Once there are enough (here more than ${CMC}), the rest gather in balls called micelles: tails inside, heads outside. Oil dissolves in the oily centre, and the whole micelle is carried away by the water.`,
      hard > 0 && !det ? `Hard water: each Ca²⁺ or Mg²⁺ ion takes two soap anions out as an insoluble grey scum, for example 2C₁₇H₃₅COO⁻ + Ca²⁺ → (C₁₇H₃₅COO)₂Ca. Here ${w.scumIons} ions used ${w.used} soap molecules before any could clean.` : 'Soft water: no scum forms, so all the soap is free to work.',
    ];
    q('.sm2-out').replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    // The molecule picture.
    mol.replaceChildren();
    let d = 'M 40 50';
    for (let i = 1; i <= 17; i++) d += ` L ${40 + i * 13} ${50 + (i % 2 ? -8 : 8)}`;
    S('path', { d, class: 'sm2-tail' }, mol);
    S('circle', { cx: 275, cy: 42, r: 16, class: 'sm2-head' }, mol);
    S('text', { x: 275, y: 47, 'text-anchor': 'middle', class: 'sm2-hl' }, mol, det ? 'SO₃⁻' : 'COO⁻');
    S('text', { x: 140, y: 82, 'text-anchor': 'middle', class: 'sm2-lab' }, mol, 'oil-loving tail (hydrocarbon chain)');
    S('text', { x: 275, y: 82, 'text-anchor': 'middle', class: 'sm2-lab' }, mol, 'water-loving head');
  }
  root.querySelectorAll<HTMLButtonElement>('.sm2-kind button').forEach((b) => b.addEventListener('click', () => { det = b.dataset.d === '1'; root.querySelectorAll('.sm2-kind button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
  root.querySelectorAll<HTMLButtonElement>('.sm2-pre').forEach((b) => b.addEventListener('click', () => { const [s, h, o] = b.dataset.p!.split(',').map(Number); setS(s); setH(h); setO(o); draw(); }));
  draw();

  mountQuiz(q('.cq'), (): Question[] => {
    const h = rint(5, 60), s = 2 * h + rint(30, 300);
    const w = wash({ soap: s, hard: h, oil: 0, detergent: false });
    const o = rint(1, 6), h2 = rint(0, 40), need = soapNeeded(o, h2);
    return [
      { q: `Hard water with ${h} calcium ions. How many soap molecules are used up as scum?`, hint: 'a whole number', answer: String(2 * h), ok: near(2 * h, 0), worked: `Each ion takes two: 2 × ${h} = ${2 * h}.` },
      { q: `${s} soap molecules go into water with ${h} hardness ions. How many micelles form?`, hint: 'a whole number', answer: String(w.micelles), ok: near(w.micelles, 0), worked: `Scum uses ${2 * h}, leaving ${w.free}. The first ${CMC} stay single: (${w.free} − ${CMC}) ÷ ${AGG} = ${fmt(Math.max(0, w.free - CMC) / AGG, 2)}, so ${w.micelles} whole micelles.` },
      { q: `What is the least soap that cleans ${o} oil drop${o > 1 ? 's' : ''} in water with ${h2} hardness ions?`, hint: 'a whole number', answer: String(need), ok: near(need, 0), worked: `Scum ${2 * h2} + single ${CMC} + ${o} micelles × ${AGG} = ${need}.` },
      { q: 'How many water-loving heads does one soap molecule have?', hint: 'a whole number', answer: '1', ok: near(1, 0), worked: 'One charged head (COO⁻) at one end, and one long hydrocarbon tail.' },
    ];
  });
</script>
