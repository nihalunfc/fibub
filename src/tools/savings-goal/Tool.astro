---
// #1732 Savings goal: how much to save each month, or how long it will take.
---
<div class="tool-ui sg">
  <section class="panel">
    <h2>Your goal</h2>
    <div class="sg-grid">
      <label>Currency <select class="sg-cur" data-k="cur"></select></label>
      <label>I want to work out <select data-k="mode"><option value="monthly">how much to save each month</option><option value="time">how long it will take</option></select></label>
      <label>What is the goal for? <select data-k="kind"><option value="amount">An amount I choose</option><option value="emergency">An emergency fund</option></select></label>
      <label class="sg-amt">Target amount <input data-k="target" inputmode="decimal" /></label>
      <label class="sg-em" hidden>Essential costs a month <input data-k="ess" inputmode="decimal" /></label>
      <label class="sg-em" hidden>Months of costs to cover <input data-k="mcover" inputmode="decimal" /></label>
      <label>Already saved <input data-k="start" inputmode="decimal" /></label>
      <label>Interest rate <span class="sg-suf"><input data-k="rate" inputmode="decimal" /><i>% a year</i></span></label>
      <label class="sg-m">Months to go <input data-k="months" inputmode="decimal" /></label>
      <label class="sg-d">Or the target date <input data-k="date" type="date" /></label>
      <label class="sg-t" hidden>I can save each month <input data-k="monthly" inputmode="decimal" /></label>
    </div>
    <p class="note bad sg-err" role="alert" hidden></p>
  </section>
  <section class="sg-res" aria-live="polite">
    <div class="sg-stats">
      <div><span class="sg-l1"></span><b class="sg-r1"></b></div>
      <div><span>You put in</span><b class="sg-r2"></b></div>
      <div class="good"><span>Interest earned</span><b class="sg-r3"></b></div>
    </div>
    <p class="sg-line sg-note"></p>
    <figure class="sg-chart panel">
      <figcaption>Your savings month by month <span class="sg-leg"></span></figcaption>
      <div class="sg-svg"></div>
    </figure>
  </section>
  <p class="sg-fine">An estimate with one fixed rate. Deposits go in at the end of each month and interest is added monthly. For an emergency fund, many advisers suggest 3 to 6 months of essential costs. Not financial or tax advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .sg { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .sg > *, .sg-res > * { min-width: 0; }
  .sg h2 { margin: 0 0 12px; font-size: 18px; }
  .sg .panel { padding: 16px; }
  .sg-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .sg label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .sg input, .sg select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .sg input:focus, .sg select:focus { border-color: var(--accent); outline: none; }
  .sg input[type=checkbox] { width: auto; }
  .sg-suf { position: relative; display: block; }
  .sg-suf i { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-style: normal; font-size: 13px; color: var(--muted); pointer-events: none; }
  .sg-suf input { padding-right: 84px; }
  .sg-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .sg-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .sg-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .sg-stats span { font-size: 13px; color: var(--muted); }
  .sg-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .sg-stats .good b { color: var(--good); }
  .sg-stats .bad b { color: var(--bad); }
  .sg-line { margin: 0; font-size: 15px; }
  .sg-line:empty { display: none; }
  .sg-chart { margin: 0; }
  .sg-chart figcaption { font-weight: 600; font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 8px; }
  .sg-chart .lg { font-weight: 500; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }
  .sg-wrap { overflow-x: auto; }
  .sg table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .sg th, .sg td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .sg th:first-child, .sg td:first-child { text-align: left; }
  .sg th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .sg-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .sg-err { margin: 10px 0 0; }
  .sg-hint { margin: 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) { .sg-stats { grid-template-columns: 1fr; } }
</style>

<script>
  import { monthlyNeeded, monthsToReach, balanceAfter } from '../../lib/money/goals';
  import { lineSvg, legend } from '../../lib/money/chart';
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  const root = document.querySelector<HTMLElement>('.sg')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  const cur = defaultCurrency();
  q('.sg-cur').innerHTML = currencyOptions(cur);
  const india = cur === 'INR';
  f('target').value = india ? '5,00,000' : '10,000'; f('start').value = '0'; f('rate').value = '3'; f('months').value = '24';
  f('monthly').value = india ? '10,000' : '300'; f('ess').value = india ? '40,000' : '2,500'; f('mcover').value = '6';
  const $ = (n: number) => money(n, f('cur').value, Math.abs(n) < 10000 ? 2 : 0);
  const addMonths = (n: number) => { const d = new Date(); d.setMonth(d.getMonth() + Math.round(n)); return d; };
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const fmtLen = (m: number) => { const r = Math.ceil(m - 1e-9), y = Math.floor(r / 12), mo = r % 12; return [y ? `${y} year${y > 1 ? 's' : ''}` : '', mo ? `${mo} month${mo > 1 ? 's' : ''}` : ''].filter(Boolean).join(' and ') || '0 months'; };
  function setDate() { f('date').value = iso(addMonths(num(f('months').value))); }
  setDate();
  f('months').addEventListener('input', setDate);
  f('date').addEventListener('input', () => {
    const d = new Date(f('date').value + 'T00:00:00'), n = new Date();
    if (isNaN(+d)) return;
    f('months').value = String(Math.max(1, (d.getFullYear() - n.getFullYear()) * 12 + d.getMonth() - n.getMonth()));
  });
  function run() {
    const mode = f('mode').value, em = f('kind').value === 'emergency';
    root.querySelectorAll<HTMLElement>('.sg-amt').forEach((e) => (e.hidden = em));
    root.querySelectorAll<HTMLElement>('.sg-em').forEach((e) => (e.hidden = !em));
    root.querySelectorAll<HTMLElement>('.sg-m, .sg-d').forEach((e) => (e.hidden = mode !== 'monthly'));
    q('.sg-t').hidden = mode !== 'time';
    const target = em ? num(f('ess').value) * num(f('mcover').value) : num(f('target').value);
    const start = num(f('start').value), rate = num(f('rate').value), months = Math.round(num(f('months').value)), monthly0 = num(f('monthly').value);
    const bad = !(target > 0) ? (em ? 'Enter your essential costs and the months to cover.' : 'Enter the target amount.') : start < 0 || monthly0 < 0 ? 'Amounts cannot be negative.' : rate < 0 || rate > 100 ? 'Enter the yearly interest rate, for example 3.' : mode === 'monthly' && !(months >= 1 && months <= 1200) ? 'Enter the months to go, from 1 to 1,200.' : '';
    q('.sg-err').hidden = !bad; q('.sg-err').textContent = bad; q('.sg-res').hidden = !!bad;
    if (bad) return;
    let monthly: number, n: number;
    if (mode === 'monthly') { n = months; monthly = monthlyNeeded(target, start, rate, n); }
    else {
      const m = monthsToReach(target, start, rate, monthly0);
      if (!isFinite(m)) { q('.sg-err').hidden = false; q('.sg-err').textContent = 'With nothing saved each month and no interest, you will not reach the goal. Enter a monthly amount.'; q('.sg-res').hidden = true; return; }
      n = Math.ceil(m - 1e-9); monthly = monthly0;
    }
    const total = balanceAfter(start, rate, monthly, n);
    const put = start + monthly * n;
    q('.sg-l1').textContent = mode === 'monthly' ? 'Save each month' : 'Time to reach it';
    q('.sg-r1').textContent = mode === 'monthly' ? $(monthly) : fmtLen(n);
    q('.sg-r2').textContent = $(put);
    q('.sg-r3').textContent = $(Math.max(0, total - put));
    q('.sg-note').textContent = `Goal: ${$(target)}${em ? ` (${num(f('mcover').value)} months of costs)` : ''}. ${mode === 'monthly' ? `You reach it in ${fmtLen(n)}, around ${addMonths(n).toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}.` : `You would reach it around ${addMonths(n).toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}.`}`;
    const step = Math.max(1, Math.ceil(n / 12));
    const xs: number[] = [], bal: number[] = [], put2: number[] = [];
    for (let m = 0; m <= n; m += step) { xs.push(m); bal.push(balanceAfter(start, rate, monthly, m)); put2.push(start + monthly * m); }
    if (xs[xs.length - 1] !== n) { xs.push(n); bal.push(total); put2.push(put); }
    const series = [{ label: 'Balance', ys: bal, color: 'var(--accent)' }, { label: 'Money you put in', ys: put2, color: 'var(--muted)', dash: true }];
    q('.sg-svg').innerHTML = lineSvg(series, xs, 'Balance and money put in, month by month');
    q('.sg-leg').innerHTML = legend(series);
  }
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
