---
// Field area by triangles: drag the corners of a plot of land on a metre grid; it is split into triangles, each
// triangle's area is worked out (Heron for Class 9, the coordinate formula for Class 10) and the total is checked
// with the shoelace formula. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
import { PRESETS } from '../../lib/sci/field-school';
---
<div class="ax sm fa">
  <div class="ax-card">
    <h2>The plot</h2>
    <div class="ax-row" style="margin-bottom:8px"><span class="ax-help" style="margin:0">Level</span>
      <div class="ax-seg fa-lvl" role="group" aria-label="Level"><button type="button" data-l="9" aria-pressed="true">Class 9 (Heron)</button><button type="button" data-l="10" aria-pressed="false">Class 10 (coordinates)</button></div>
    </div>
    <label>Start from <select class="fa-pre">{PRESETS.map((p) => <option value={p.id}>{p.name}</option>)}</select></label>
    <svg class="sm-fig fa-fig" viewBox="0 0 340 260" role="img" aria-label="The plot on a grid of metres, split into triangles" style="margin-top:10px"></svg>
    <p class="ax-help">Drag a corner (it snaps to whole metres). Each grid square is 2 m by 2 m.</p>
    <div class="ax-row"><button type="button" class="btn secondary small fa-add">Add a corner</button><button type="button" class="btn secondary small fa-del">Remove last corner</button></div>
    <p class="ax-err fa-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Area, triangle by triangle</h2>
    <p class="ax-big fa-big" aria-live="polite"></p>
    <ol class="sm-steps fa-steps"></ol>
    <p class="sm-f fa-check"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Count the triangles. A shape with n corners always splits into n − 2 of them. Why?</li>
      <li>L-shaped plot: check the answer by splitting it into two rectangles instead.</li>
      <li>Drag one corner along a line parallel to the side opposite it. Which triangle's area stays the same?</li>
      <li>Push a corner inwards so the field is no longer convex. The triangles still cover it exactly.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Give answers to 2 decimal places where needed. Nothing is saved.</p>
    <div class="fa-quiz"></div>
  </div>
</div>

<style is:inline>
  .fa svg .fa-t0 { fill: var(--accent-soft); } .fa svg .fa-t1 { fill: var(--good-soft); } .fa svg .fa-t2 { fill: var(--warn-soft); }
  .fa svg .fa-tri { stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .fa svg .fa-edge { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .fa svg .fa-edge.fa-bad { stroke: var(--bad); }
  .fa svg .fa-lab { font-weight: 700; }
</style>

<script>
  import { PRESETS, shoelace, perimeter, isSimple, triangulate, heron, coordArea, dist, type P } from '../../lib/sci/field-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.fa')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.fa-fig'), pre = q<HTMLSelectElement>('.fa-pre');
  const W = 40, H = 30, K = 8, OX = 10, OY = 250;              // 40 m × 30 m grid, 8 px a metre
  const X = (x: number) => OX + x * K, Y = (y: number) => OY - y * K;
  let pts: P[] = PRESETS[0].p.map((p) => [...p] as P), level = '9';
  const NAMES = 'ABCDEFGHIJ';

  root.querySelectorAll<HTMLButtonElement>('.fa-lvl button').forEach((b) => b.addEventListener('click', () => {
    level = b.dataset.l!; root.querySelectorAll('.fa-lvl button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw();
  }));
  pre.addEventListener('change', () => { pts = PRESETS.find((p) => p.id === pre.value)!.p.map((p) => [...p] as P); draw(); });
  const f2 = (x: number) => fmt(x, 2);

  function draw() {
    fig.replaceChildren();
    for (let x = 0; x <= W; x += 2) S('line', { x1: X(x), y1: Y(0), x2: X(x), y2: Y(H), class: 'sm-grid' }, fig);
    for (let y = 0; y <= H; y += 2) S('line', { x1: X(0), y1: Y(y), x2: X(W), y2: Y(y), class: 'sm-grid' }, fig);
    const ok = isSimple(pts), err = q('.fa-err');
    err.hidden = ok;
    if (!ok) err.textContent = pts.length < 3 ? 'A field needs at least 3 corners.' : 'Two sides cross or two corners sit on top of each other. Drag a corner to untangle the field.';
    const tris = ok ? triangulate(pts) : [];
    tris.forEach(([a, b, c], i) => {
      S('polygon', { points: [pts[a], pts[b], pts[c]].map((p) => `${X(p[0])},${Y(p[1])}`).join(' '), class: `fa-tri fa-t${i % 3}` }, fig);
      const cx = (pts[a][0] + pts[b][0] + pts[c][0]) / 3, cy = (pts[a][1] + pts[b][1] + pts[c][1]) / 3;
      S('text', { x: X(cx), y: Y(cy) + 4, 'text-anchor': 'middle', class: 'fa-lab' }, fig, `T${i + 1}`);
    });
    S('polygon', { points: pts.map((p) => `${X(p[0])},${Y(p[1])}`).join(' '), class: `fa-edge${ok ? '' : ' fa-bad'}` }, fig);
    pts.forEach((p, i) => {
      S('circle', { cx: X(p[0]), cy: Y(p[1]), r: 20, class: 'sm-hit' }, fig);
      S('circle', { cx: X(p[0]), cy: Y(p[1]), r: 8, class: 'sm-handle', 'data-i': i }, fig);
      const lx = X(p[0]) + (p[0] > W / 2 ? 11 : -11), ly = Y(p[1]) + (p[1] > H / 2 ? -9 : 17);
      S('text', { x: lx, y: ly, 'text-anchor': p[0] > W / 2 ? 'start' : 'end', class: 'fa-lab' }, fig, `${NAMES[i]}(${p[0]}, ${p[1]})`);
    });
    if (!ok) { q('.fa-big').textContent = ''; q('.fa-steps').replaceChildren(); q('.fa-check').textContent = ''; return; }
    const area = Math.abs(shoelace(pts)), steps: string[] = [];
    let sum = 0;
    tris.forEach(([a, b, c], i) => {
      const nm = `${NAMES[a]}${NAMES[b]}${NAMES[c]}`, A = pts[a], B = pts[b], C = pts[c];
      if (level === '9') {
        const h = heron(A, B, C); sum += h.area;
        steps.push(`T${i + 1} = triangle ${nm}: sides ${h.sides.map(f2).join(', ')} m; s = ${f2(h.s)}; area = √[s(s − a)(s − b)(s − c)] = ${f2(h.area)} m².`);
      } else {
        const ar = coordArea(A, B, C); sum += ar;
        steps.push(`T${i + 1} = triangle ${nm}: ½|${A[0]}(${B[1]} − ${C[1]}) + ${B[0]}(${C[1]} − ${A[1]}) + ${C[0]}(${A[1]} − ${B[1]})| = ${f2(ar)} m².`);
      }
    });
    steps.push(`Total = ${tris.map((_, i) => `T${i + 1}`).join(' + ')} = ${f2(sum)} m².`);
    q('.fa-steps').replaceChildren(...steps.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    q('.fa-big').textContent = `Area ${f2(area)} m² = ${fmt(area / 10000, 4)} hectare`;
    q('.fa-check').textContent = `${pts.length} corners, so ${tris.length} triangle${tris.length > 1 ? 's' : ''}. Check with the shoelace formula (all corners at once): ${f2(area)} m². Perimeter (fencing) ${f2(perimeter(pts))} m.`;
  }

  dragOn(fig, (x, y) => {
    let best = -1, bd = 26;
    pts.forEach((p, i) => { const d = Math.hypot(x - X(p[0]), y - Y(p[1])); if (d < bd) { bd = d; best = i; } });
    return best < 0 ? null : String(best);
  }, (id, x, y) => {
    const i = Number(id), nx = Math.max(0, Math.min(W, Math.round((x - OX) / K))), ny = Math.max(0, Math.min(H, Math.round((OY - y) / K)));
    if (pts[i][0] !== nx || pts[i][1] !== ny) { pts[i] = [nx, ny]; draw(); }
  });
  q('.fa-add').addEventListener('click', () => {
    if (pts.length >= 10) return;
    // New corner halfway along the longest side (drag it out to change the shape).
    let best = 0, bl = -1;
    pts.forEach((p, i) => { const d = dist(p, pts[(i + 1) % pts.length]); if (d > bl) { bl = d; best = i; } });
    const a = pts[best], b = pts[(best + 1) % pts.length];
    const m: P = [Math.round((a[0] + b[0]) / 2), Math.round((a[1] + b[1]) / 2)];
    pts.splice(best + 1, 0, m); draw();
  });
  q('.fa-del').addEventListener('click', () => { if (pts.length > 3) { pts.pop(); draw(); } });
  draw();

  quiz(q('.fa-quiz'), () => {
    const out: Question[] = [];
    const a = randInt(10, 40), b = randInt(4, 20), c = randInt(6, 30);
    out.push({ q: `A plot is a ${a} m by ${b} m rectangle with a right triangle (legs ${b} m and ${c} m) joined along the ${b} m end. Find its area.`, want: [a * b + (b * c) / 2], hint: 'm²', work: `Rectangle ${a} × ${b} = ${a * b} m²; triangle ½ × ${b} × ${c} = ${fmt((b * c) / 2, 1)} m²; total ${fmt(a * b + (b * c) / 2, 1)} m².` });
    const p = randInt(10, 30), qq = p + randInt(4, 20), h = randInt(6, 20);
    out.push({ q: `A field is a trapezium with parallel sides ${p} m and ${qq} m, ${h} m apart. Find its area.`, want: [((p + qq) * h) / 2], hint: 'm²', work: `Split it into two triangles along a diagonal: ½ × ${p} × ${h} + ½ × ${qq} × ${h} = ½ × (${p} + ${qq}) × ${h} = ${fmt(((p + qq) * h) / 2, 1)} m².` });
    const T = [[13, 14, 15, 84], [5, 12, 13, 30], [9, 10, 17, 36], [10, 17, 21, 84]][randInt(0, 3)], k = randInt(2, 5);
    out.push({ q: `A quadrilateral field ABCD has diagonal AC. Triangle ABC has sides ${T[0] * k}, ${T[1] * k} and ${T[2] * k} m, and triangle ACD has area ${50 * k} m². Find the field's area.`, want: [T[3] * k * k + 50 * k], hint: 'm²', work: `Heron for ABC: s = ${((T[0] + T[1] + T[2]) * k) / 2}, area = ${T[3] * k * k} m². Total = ${T[3] * k * k} + ${50 * k} = ${T[3] * k * k + 50 * k} m².` });
    const x = randInt(2, 9), y = randInt(2, 9);
    out.push({ q: `Find the area of the triangle with corners (0, 0), (${2 * x}, 0) and (${x}, ${y}) (lengths in metres).`, want: [x * y], hint: 'm²', work: `½|0(0 − ${y}) + ${2 * x}(${y} − 0) + ${x}(0 − 0)| = ½ × ${2 * x * y} = ${x * y} m².` });
    return out;
  });
</script>
