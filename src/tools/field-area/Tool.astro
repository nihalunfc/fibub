---
// Field area: drag the corners of a plot of land on a grid; the plot is split into triangles, each found by
// Heron's formula from its three sides, and the total is checked with the shoelace formula. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm fa">
  <div class="ax-card">
    <div class="ax-seg fa-lvl" role="group" aria-label="Level"><button type="button" data-l="9" aria-pressed="true">Class 9: triangles and Heron</button><button type="button" data-l="11" aria-pressed="false">Class 11: coordinates</button></div>
    <svg class="sm-fig fa-fig" viewBox="0 0 340 300" role="img" aria-label="A plot of land on a 10 metre grid; drag the corners" style="margin-top:10px"></svg>
    <p class="ax-big fa-big" aria-live="polite" style="margin:8px 0 2px"></p>
    <p class="fa-sub" style="margin:0 0 8px"></p>
    <div class="ax-row">
      <button type="button" class="btn secondary small fa-add">Add a corner</button>
      <button type="button" class="btn secondary small fa-del">Remove a corner</button>
    </div>
    <div class="ax-row">
      <button type="button" class="btn secondary small fa-pre" data-p="10,10 110,10 150,90 70,140 20,100">Five-sided field</button>
      <button type="button" class="btn secondary small fa-pre" data-p="10,10 150,10 150,60 70,60 70,140 10,140">L-shaped plot</button>
      <button type="button" class="btn secondary small fa-pre" data-p="20,20 150,20 60,130">Triangle</button>
    </div>
    <p class="ax-help">Each grid square is 10 m by 10 m. Corners snap to whole metres. Tap a corner to select it before removing.</p>
    <p class="ax-err fa-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Triangle by triangle</h2>
    <ul class="sm-steps fa-out"></ul>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Pick the L-shaped plot. It has a dent, yet the page still cuts it into triangles that do not stick out.</li>
      <li>Drag one corner along a straight line through two others. When three corners line up, one triangle has no area.</li>
      <li>Make a 100 m by 100 m square: it is exactly 1 hectare.</li>
      <li>Drag a corner across a side so that two sides cross. A plot like that has no proper inside, and the page tells you.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <div class="fa-quiz"></div>
  </div>
</div>

<style is:inline>
  .fa svg .fa-poly { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .fa svg .fa-poly.bad { stroke: var(--bad); stroke-dasharray: 6 4; }
  .fa svg .fa-t0 { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1; }
  .fa svg .fa-t1 { fill: var(--good-soft); stroke: var(--good); stroke-width: 1; }
  .fa svg .fa-t2 { fill: var(--warn-soft); stroke: var(--warn); stroke-width: 1; }
  .fa svg .fa-tl { font: 700 12px system-ui, sans-serif; fill: var(--ink); }
  .fa svg .fa-len { font: 11px system-ui, sans-serif; fill: var(--muted); }
  .fa svg .fa-sel { fill: var(--warn); }
</style>

<script>
  import { shoelace, perimeter, isSimple, triangleAreas, type Pt } from '../../lib/sci/fieldarea-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.fa')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.fa-fig');
  // Field coordinates in metres, x 0..160 to the right, y 0..140 upwards; 2 px per metre.
  const X = (x: number) => 10 + x * 2, Y = (y: number) => 290 - y * 2;
  const parse = (s: string): Pt[] => s.split(' ').map((p) => p.split(',').map(Number) as Pt);
  let pts: Pt[] = parse('10,10 110,10 150,90 70,140 20,100'), sel = -1, level = 9;
  const NAMES = 'ABCDEFGHIJ';

  function draw() {
    fig.replaceChildren();
    for (let x = 0; x <= 160; x += 10) S('line', { x1: X(x), x2: X(x), y1: Y(0), y2: Y(140), class: 'sm-grid' }, fig);
    for (let y = 0; y <= 140; y += 10) S('line', { x1: X(0), x2: X(160), y1: Y(y), y2: Y(y), class: 'sm-grid' }, fig);
    const ok = isSimple(pts), err = q('.fa-err');
    err.hidden = ok; if (!ok) err.textContent = 'Two sides cross (or two corners are on top of each other), so this plot has no proper inside. Move a corner to untangle it.';
    const tris = ok ? triangleAreas(pts) : [];
    tris.forEach((t, i) => {
      S('polygon', { points: t.tri.map((k) => `${X(pts[k][0])},${Y(pts[k][1])}`).join(' '), class: `fa-t${i % 3}` }, fig);
      const cx = t.tri.reduce((s, k) => s + X(pts[k][0]), 0) / 3, cy = t.tri.reduce((s, k) => s + Y(pts[k][1]), 0) / 3;
      S('text', { x: cx, y: cy + 4, 'text-anchor': 'middle', class: 'fa-tl' }, fig, `T${i + 1}`);
    });
    S('polygon', { points: pts.map((p) => `${X(p[0])},${Y(p[1])}`).join(' '), class: 'fa-poly' + (ok ? '' : ' bad') }, fig);
    const n = pts.length, cx = pts.reduce((s, p) => s + p[0], 0) / n, cy = pts.reduce((s, p) => s + p[1], 0) / n;
    pts.forEach((p, i) => {
      const q2 = pts[(i + 1) % n], mx = (p[0] + q2[0]) / 2, my = (p[1] + q2[1]) / 2, L = Math.hypot(q2[0] - p[0], q2[1] - p[1]);
      const dx = mx - cx, dy = my - cy, d = Math.hypot(dx, dy) || 1;
      S('text', { x: Math.min(318, Math.max(22, X(mx + (dx / d) * 7))), y: Math.min(296, Math.max(12, Y(my + (dy / d) * 7) + 4)), 'text-anchor': 'middle', class: 'fa-len' }, fig, `${fmt(L, 1)} m`);
    });
    pts.forEach((p, i) => {
      S('circle', { cx: X(p[0]), cy: Y(p[1]), r: 9, class: i === sel ? 'fa-sel' : 'sm-handle' }, fig);
      const dx = p[0] - cx, dy = p[1] - cy, d = Math.hypot(dx, dy) || 1;
      S('text', { x: Math.min(332, Math.max(8, X(p[0] + (dx / d) * 9))), y: Math.min(296, Math.max(14, Y(p[1] + (dy / d) * 9) + 5)), 'text-anchor': 'middle', class: 'fa-tl' }, fig, NAMES[i]);
    });
    const area = ok ? shoelace(pts) : NaN, per = perimeter(pts);
    q('.fa-big').textContent = ok ? `Area ${fmt(area, 2)} m²` : 'No area: the sides cross';
    q('.fa-sub').textContent = ok ? `= ${fmt(area / 10000, 4)} hectare = ${fmt(area / 4046.8564224, 4)} acre. Perimeter ${fmt(per, 2)} m (the length of fence needed).` : `Perimeter ${fmt(per, 2)} m.`;
    const lines: string[] = [];
    if (ok) {
      lines.push(`A plot with ${n} straight sides splits into ${n} − 2 = ${n - 2} triangle${n - 2 === 1 ? '' : 's'} (cut along lines between corners that stay inside the plot).`);
      tris.forEach((t, i) => {
        const [a, b, c] = t.sides, nm = t.tri.map((k) => NAMES[k]).join('');
        lines.push(`T${i + 1} = ${nm}: sides ${fmt(a, 2)}, ${fmt(b, 2)}, ${fmt(c, 2)} m. s = (a + b + c)/2 = ${fmt(t.s, 3)}. Area = √[s(s − a)(s − b)(s − c)] = √[${fmt(t.s, 3)} × ${fmt(t.s - a, 3)} × ${fmt(t.s - b, 3)} × ${fmt(t.s - c, 3)}] = ${fmt(t.area, 2)} m².`);
      });
      lines.push(`Total: ${tris.map((t) => fmt(t.area, 2)).join(' + ')} = ${fmt(tris.reduce((s, t) => s + t.area, 0), 2)} m².`);
      if (level === 11) {
        lines.push(`Corners: ${pts.map((p, i) => `${NAMES[i]}(${p[0]}, ${p[1]})`).join(', ')}.`);
        const terms = pts.map((p, i) => { const q2 = pts[(i + 1) % n]; return p[0] * q2[1] - q2[0] * p[1]; });
        lines.push(`Shoelace (surveyor's) formula: area = ½ |Σ (xᵢ yᵢ₊₁ − xᵢ₊₁ yᵢ)| = ½ |${terms.map((t) => fmt(t, 0)).join(' + ').replace(/\+ −/g, '− ')}| = ½ × ${fmt(Math.abs(terms.reduce((s, t) => s + t, 0)), 0)} = ${fmt(area, 2)} m², the same answer.`);
      }
    }
    q('.fa-out').replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
    q<HTMLButtonElement>('.fa-add').disabled = pts.length >= 10;
    q<HTMLButtonElement>('.fa-del').disabled = pts.length <= 3;
  }

  dragOn(fig, (x, y) => {
    let best = -1, bd = 26;
    pts.forEach((p, i) => { const d = Math.hypot(X(p[0]) - x, Y(p[1]) - y); if (d < bd) { bd = d; best = i; } });
    if (best >= 0) sel = best;
    return best >= 0 ? String(best) : null;
  }, (id, x, y) => {
    const i = Number(id), mx = Math.round(Math.min(160, Math.max(0, (x - 10) / 2))), my = Math.round(Math.min(140, Math.max(0, (290 - y) / 2)));
    pts[i] = [mx, my]; draw();
  });
  q('.fa-add').addEventListener('click', () => {
    // Put a new corner in the middle of the longest side.
    let k = 0, L = -1;
    pts.forEach((p, i) => { const q2 = pts[(i + 1) % pts.length], d = Math.hypot(q2[0] - p[0], q2[1] - p[1]); if (d > L) { L = d; k = i; } });
    const a = pts[k], b = pts[(k + 1) % pts.length];
    pts.splice(k + 1, 0, [Math.round((a[0] + b[0]) / 2), Math.round((a[1] + b[1]) / 2)]); sel = k + 1; draw();
  });
  q('.fa-del').addEventListener('click', () => { if (pts.length <= 3) return; pts.splice(sel >= 0 && sel < pts.length ? sel : pts.length - 1, 1); sel = -1; draw(); });
  root.querySelectorAll<HTMLButtonElement>('.fa-pre').forEach((b) => b.addEventListener('click', () => { pts = parse(b.dataset.p!); sel = -1; draw(); }));
  root.querySelectorAll<HTMLButtonElement>('.fa-lvl button').forEach((b) => b.addEventListener('click', () => { level = Number(b.dataset.l); root.querySelectorAll('.fa-lvl button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); draw(); }));
  draw();

  quiz(q('.fa-quiz'), () => {
    const out: Question[] = [];
    const [a, b, c, A] = [[13, 14, 15, 84], [5, 12, 13, 30], [10, 13, 13, 60], [9, 10, 17, 36], [20, 21, 29, 210], [7, 15, 20, 42]][randInt(0, 5)], k = randInt(1, 4);
    out.push({ q: `A triangular field has sides ${a * k} m, ${b * k} m and ${c * k} m. What is its area in m²?`, want: [A * k * k], work: `s = (${a * k} + ${b * k} + ${c * k})/2 = ${((a + b + c) * k) / 2}; area = √[${((a + b + c) * k) / 2} × ${((b + c - a) * k) / 2} × ${((a + c - b) * k) / 2} × ${((a + b - c) * k) / 2}] = ${A * k * k}.` });
    const w = randInt(3, 9) * 10, h = randInt(2, 6) * 10, th = randInt(1, 4) * 10;
    out.push({ q: `A plot is a ${w} m by ${h} m rectangle with a triangle on top whose base is the ${w} m side and whose height is ${th} m. What is the total area in m²?`, want: [w * h + (w * th) / 2], work: `Rectangle ${w} × ${h} = ${w * h}; triangle ½ × ${w} × ${th} = ${(w * th) / 2}; total ${w * h + (w * th) / 2}.` });
    const m2 = randInt(2, 60) * 500;
    out.push({ q: `How many hectares is ${m2} m²?`, want: [m2 / 10000], work: `1 hectare = 10 000 m², so ${m2} ÷ 10 000 = ${m2 / 10000}.` });
    const n = randInt(5, 9);
    out.push({ q: `A field has ${n} straight sides. Into how many triangles can it be cut by lines joining its corners?`, want: [n - 2], work: `A polygon with n sides splits into n − 2 triangles: ${n} − 2 = ${n - 2}.` });
    return out;
  });
</script>
