---
// Simple circuit lab (Learn): cells, a switch, a torch bulb or an LED tester, and a gap where you test materials as
// conductors or insulators. Class 10 level shows R = ρL/A and the current.
import '../../styles/astro.css';
import '../../styles/learnquiz-d.css';
import { MATERIALS } from '../../lib/sci/learnj-circuit';
---
<div class="ax lrn scl">
  <div class="ax-card">
    <div class="ax-seg" role="group" aria-label="Level"><button type="button" data-level="8" aria-pressed="true">Class 8</button><button type="button" data-level="10" aria-pressed="false">Class 10</button></div>
    <canvas class="lrn-cv sc-cv" style="margin-top:10px" aria-label="A circuit: cells on the left, a switch on top, a bulb or LED on the right and the material being tested at the bottom"></canvas>
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn small sc-sw" aria-pressed="false">Switch on</button>
      <div class="ax-seg sc-tester" role="group" aria-label="Tester"><button type="button" data-t="bulb" aria-pressed="true">Torch bulb</button><button type="button" data-t="led" aria-pressed="false">LED</button></div>
      <div class="ax-seg sc-cells" role="group" aria-label="Cells"><button type="button" data-c="1" aria-pressed="false">1 cell</button><button type="button" data-c="2" aria-pressed="true">2 cells</button></div>
    </div>
    <p class="ax-big sc-big" style="margin:10px 0 0"></p>
    <p class="ax-help sc-note"></p>
    <p class="lrn-eq sc-eq" data-only="10" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Put a material in the gap</h2>
    <div class="sc-mats">{MATERIALS.map((m) => <button type="button" class="sc-mat" data-m={m.id} aria-pressed="false">{m.name}</button>)}</div>
  </div>

  <div class="ax-card">
    <h2>Your results</h2>
    <p class="ax-help">Each material you test with the switch on is added here, with the tester you used.</p>
    <div class="ax-scroll"><table class="sc-tab"><thead><tr><th>Material</th><th>Tester</th><th>Glow</th><th>Conductor?</th></tr></thead><tbody></tbody></table></div>
    <button type="button" class="btn secondary small sc-clear" style="margin-top:8px">Clear results</button>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lrn-try">
      <li>Test every metal, then the plastic ruler and the eraser. Which group lets the bulb glow?</li>
      <li>Test salt water with the torch bulb, then with the LED. The LED shows a small current that the bulb cannot.</li>
      <li>Compare tap water, salt water and distilled water with the LED.</li>
      <li>Use one cell instead of two: the bulb is dimmer, and the LED cannot light at all. Why?</li>
      <li>Class 10: compare the resistance of copper and pencil lead from R = ρL/A.</li>
    </ul>
    <p class="ax-help">Resistivities are rounded typical values; real samples vary a lot. Never test mains electricity or wall sockets.</p>
  </div>

  <div class="ax-card sc-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<style is:inline>
  .scl .sc-mats { display: flex; flex-wrap: wrap; gap: 8px; }
  .scl .sc-mat { min-height: 44px; padding: 8px 12px; font: inherit; font-size: 15px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); cursor: pointer; }
  .scl .sc-mat[aria-pressed=true] { border-color: var(--accent); box-shadow: inset 0 0 0 2px var(--accent); }
  .scl .ax-seg button { min-height: 44px; }
</style>

<script>
  import { MATERIALS, sampleR, bulbCurrent, ledCurrent, bulbGlow, ledGlow, bulbShare, BULB_R, LED, CELL_V, GAP, AREA_LIQUID, AREA_SOLID, type Glow } from '../../lib/sci/learnj-circuit';
  import { mountQuiz, pick, one, r, fitCanvas, wireLevel } from '../../lib/learnquiz-d';
  import { pagePalette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.scl')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  let on = false, tester = 'bulb', cells = 2, mat = MATERIALS[0], level = '8';
  const results = new Map<string, string[]>();
  const fmtR = (x: number) => x >= 1e9 ? `${sci(x)} Ω` : x >= 1e6 ? `${r(x / 1e6, 3)} MΩ` : x >= 1e3 ? `${r(x / 1e3, 3)} kΩ` : x >= 0.01 ? `${r(x, 3)} Ω` : `${r(x * 1000, 3)} mΩ`;
  const sci = (x: number) => { if (x === 0) return '0'; const e = Math.floor(Math.log10(Math.abs(x))); return Math.abs(e) < 3 ? r(x, 3) : `${r(x / 10 ** e, 3)} × 10^${e}`; };
  const fmtI = (I: number) => I >= 0.1 ? `${r(I, 3)} A` : I >= 1e-4 ? `${r(I * 1000, 3)} mA` : I > 0 ? `${sci(I * 1e6)} µA` : '0 A';

  function state() {
    const rs = sampleR(mat), I = !on ? 0 : tester === 'bulb' ? bulbCurrent(cells, rs) : ledCurrent(cells, rs);
    const glow: Glow = !on ? 'off' : tester === 'bulb' ? bulbGlow(I) : ledGlow(I);
    return { rs, I, glow };
  }

  function render() {
    const pal = pagePalette(), { rs, I, glow } = state();
    const { ctx: c, W, H } = fitCanvas(q<HTMLCanvasElement>('.sc-cv'), 240);
    c.fillStyle = pal.bg; c.fillRect(0, 0, W, H);
    const L = 40, Rr = W - 40, T = 40, B = H - 40, flow = on && I > 1e-7;
    const wire = flow ? (pal.red ? pal.ink : pal.accent) : pal.ink;
    c.strokeStyle = wire; c.lineWidth = 3; c.lineCap = 'round';
    // wires with gaps for parts
    const cy = (T + B) / 2, swX = W / 2, gapX = W / 2;
    const seg = (x1: number, y1: number, x2: number, y2: number) => { c.beginPath(); c.moveTo(x1, y1); c.lineTo(x2, y2); c.stroke(); };
    seg(L, T, swX - 30, T); seg(swX + 30, T, Rr, T); seg(Rr, T, Rr, cy - 22); seg(Rr, cy + 22, Rr, B); seg(Rr, B, gapX + 45, B); seg(gapX - 45, B, L, B); seg(L, B, L, cy + 18); seg(L, T, L, cy - 18);
    // cells
    c.lineWidth = 3; for (let k = 0; k < cells; k++) { const y = cells === 1 ? cy : cy - 8 + k * 16; c.strokeStyle = pal.ink; seg(L - 14, y - 4, L + 14, y - 4); c.lineWidth = 6; seg(L - 7, y + 3, L + 7, y + 3); c.lineWidth = 3; }
    if (cells === 1) { seg(L, cy - 4, L, cy - 18); seg(L, cy + 3, L, cy + 18); } else { seg(L, cy - 12, L, cy - 18); seg(L, cy + 11, L, cy + 18); seg(L, cy - 5, L, cy + 4); }
    c.fillStyle = pal.muted; c.font = '12px system-ui, sans-serif'; c.textAlign = 'left'; c.fillText(`${cells * CELL_V} V`, L + 18, cy + 4);
    // switch
    c.strokeStyle = pal.ink; c.fillStyle = pal.ink; c.beginPath(); c.arc(swX - 30, T, 4, 0, 7); c.arc(swX + 30, T, 4, 0, 7); c.fill();
    c.lineWidth = 3; if (on) seg(swX - 30, T, swX + 30, T); else seg(swX - 30, T, swX + 24, T - 24);
    c.textAlign = 'center'; c.fillStyle = pal.muted; c.fillText(on ? 'switch on' : 'switch off', swX, T - 26 < 12 ? 12 : T - 28);
    // tester
    const glowA = glow === 'bright' ? 1 : glow === 'dim' ? 0.55 : glow === 'faint' ? 0.25 : 0;
    const lamp = pal.red ? '#a30000' : tester === 'led' ? '#d32f2f' : '#f2b705';
    if (glowA > 0) { c.globalAlpha = glowA * 0.35; c.fillStyle = lamp; c.beginPath(); c.arc(Rr, cy, 22 + 18 * glowA, 0, 7); c.fill(); c.globalAlpha = 1; }
    if (tester === 'bulb') {
      c.fillStyle = glowA > 0 ? lamp : pal.bg; c.globalAlpha = glowA > 0 ? 0.4 + 0.6 * glowA : 1; c.beginPath(); c.arc(Rr, cy, 18, 0, 7); c.fill(); c.globalAlpha = 1;
      c.strokeStyle = pal.ink; c.lineWidth = 2; c.beginPath(); c.arc(Rr, cy, 18, 0, 7); c.stroke(); seg(Rr - 12, cy - 12, Rr + 12, cy + 12); seg(Rr - 12, cy + 12, Rr + 12, cy - 12);
    } else {
      c.fillStyle = glowA > 0 ? lamp : pal.bg; c.globalAlpha = glowA > 0 ? 0.4 + 0.6 * glowA : 1; c.beginPath(); c.moveTo(Rr - 14, cy - 12); c.lineTo(Rr + 14, cy - 12); c.lineTo(Rr, cy + 10); c.closePath(); c.fill(); c.globalAlpha = 1;
      c.strokeStyle = pal.ink; c.lineWidth = 2; c.beginPath(); c.moveTo(Rr - 14, cy - 12); c.lineTo(Rr + 14, cy - 12); c.lineTo(Rr, cy + 10); c.closePath(); c.stroke(); seg(Rr - 14, cy + 10, Rr + 14, cy + 10);
      seg(Rr, cy - 22, Rr, cy - 12); seg(Rr, cy + 10, Rr, cy + 22);
    }
    c.fillStyle = pal.muted; c.textAlign = 'right'; c.fillText(tester === 'bulb' ? 'bulb' : 'LED', Rr - 26, cy + 4);
    // the material in the gap
    c.fillStyle = pal.ink; c.beginPath(); c.arc(gapX - 45, B, 5, 0, 7); c.arc(gapX + 45, B, 5, 0, 7); c.fill();
    if (mat.liquid) { c.strokeStyle = pal.ink; c.lineWidth = 2; c.strokeRect(gapX - 40, B - 10, 80, 26); c.fillStyle = pal.red ? '#300000' : '#9cc8e8'; c.globalAlpha = 0.6; c.fillRect(gapX - 39, B - 2, 78, 17); c.globalAlpha = 1; c.lineWidth = 3; seg(gapX - 45, B, gapX - 30, B); seg(gapX - 30, B, gapX - 30, B + 12); seg(gapX + 45, B, gapX + 30, B); seg(gapX + 30, B, gapX + 30, B + 12); }
    else { const metal = ['copper', 'aluminium', 'iron', 'coin'].includes(mat.id); c.fillStyle = pal.red ? '#5a0000' : metal ? (mat.id === 'copper' ? '#b87333' : '#9e9e9e') : mat.id === 'graphite' ? '#444' : mat.id === 'wood' ? '#a0703c' : mat.id === 'rubber' ? '#e57373' : mat.id === 'plastic' ? '#64b5f6' : mat.id === 'glass' ? '#cfe8ef' : '#eeeeee'; c.fillRect(gapX - 45, B - 5, 90, 10); c.strokeStyle = pal.line; c.lineWidth = 1; c.strokeRect(gapX - 45, B - 5, 90, 10); }
    c.fillStyle = pal.muted; c.textAlign = 'center'; c.fillText(mat.name, gapX, B + 30);
    if (flow) { c.fillStyle = wire; c.textAlign = 'left'; c.fillText(`current → ${fmtI(I)}`, L + 8, T + 18); }

    const word = { bright: 'glows brightly', dim: 'glows dimly', faint: 'glows very faintly', off: 'stays dark' }[glow];
    q('.sc-big').textContent = !on ? 'Switch is off: the circuit is open, so no current flows.' : `${tester === 'bulb' ? 'The bulb' : 'The LED'} ${word}: ${mat.name.toLowerCase()} ${glow === 'off' ? (tester === 'led' && cells === 1 ? 'is not the problem: one cell is not enough to light an LED.' : 'does not let enough current through.') : 'conducts electricity.'}`;
    q('.sc-note').textContent = `${mat.name}: ${mat.note}.`;
    const A = mat.liquid ? AREA_LIQUID : AREA_SOLID;
    q('.sc-eq').textContent = `R = ρL/A = ${sci(mat.rho)} Ω m × ${GAP} m ÷ ${sci(A)} m² = ${fmtR(rs)}.  ` + (tester === 'bulb'
      ? `I = V/(R_bulb + R) = ${cells * CELL_V} ÷ (${r(BULB_R, 3)} + ${fmtR(rs)}) = ${fmtI(bulbCurrent(cells, rs))}; bulb power ${r(100 * bulbShare(bulbCurrent(cells, rs)), 3)} % of its rating.`
      : `I = (V − 1.8 V)/(100 Ω + R) = (${cells * CELL_V} − ${LED.drop}) ÷ (${LED.series} + ${fmtR(rs)}) = ${fmtI(ledCurrent(cells, rs))}.`) + (on ? '' : ' (when switched on)');
    q('.sc-eq').hidden = level !== '10';
    root.querySelectorAll<HTMLButtonElement>('.sc-mat').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === mat.id)));
    q('.sc-sw').textContent = on ? 'Switch off' : 'Switch on'; q('.sc-sw').setAttribute('aria-pressed', String(on));
    if (on) results.set(`${mat.id}-${tester}`, [mat.name, tester === 'bulb' ? 'Bulb' : 'LED', glow, glow === 'off' ? (tester === 'led' && cells === 1 ? 'needs 2 cells' : 'No (insulator or very poor)') : glow === 'bright' ? 'Yes, good' : 'Yes, weak']);
    const body = q<HTMLTableElement>('.sc-tab').tBodies[0]; body.replaceChildren();
    for (const row of results.values()) { const tr = body.insertRow(); row.forEach((x) => { tr.insertCell().textContent = x; }); }
  }

  q('.sc-sw').addEventListener('click', () => { on = !on; render(); });
  q('.sc-cv').addEventListener('click', (e) => { const b = q('.sc-cv').getBoundingClientRect(); if (e.clientY - b.top < 70) { on = !on; render(); } });
  root.querySelectorAll<HTMLButtonElement>('.sc-mat').forEach((b) => b.addEventListener('click', () => { mat = MATERIALS.find((m) => m.id === b.dataset.m)!; render(); }));
  root.querySelectorAll<HTMLButtonElement>('.sc-tester button').forEach((b) => b.addEventListener('click', () => { tester = b.dataset.t!; root.querySelectorAll('.sc-tester button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); render(); }));
  root.querySelectorAll<HTMLButtonElement>('.sc-cells button').forEach((b) => b.addEventListener('click', () => { cells = +b.dataset.c!; root.querySelectorAll('.sc-cells button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); render(); }));
  q('.sc-clear').addEventListener('click', () => { results.clear(); q<HTMLTableElement>('.sc-tab').tBodies[0].replaceChildren(); });
  addEventListener('resize', render);
  wireLevel(root, (l) => { level = l; render(); });

  mountQuiz(q('.sc-quiz'), () => {
    const V = one([1.5, 3, 4.5, 6]), R = one([5, 10, 15, 20, 30]), rho = one([1.7, 2.8, 10]), Lm = pick(1, 10), Amm = one([0.5, 1, 2]);
    const ins = one(['rubber', 'plastic', 'dry wood', 'glass']), con = one(['copper', 'aluminium', 'iron', 'silver']);
    return [
      { q: `Which of these is a good conductor of electricity: ${con} or ${ins}?`, ans: 0, choices: [con, ins], work: `${con[0].toUpperCase() + con.slice(1)} is a metal, so it conducts well. ${ins[0].toUpperCase() + ins.slice(1)} is an insulator.` },
      { q: 'Why are electric wires covered in plastic or rubber?', ans: 1, choices: ['To make them conduct better', 'Plastic and rubber are insulators, so they stop current reaching your hand', 'To keep the wire warm'], work: 'The metal inside carries the current; the insulating cover keeps it from flowing through anything (or anyone) touching the wire.' },
      { q: 'A bulb does not glow when salt water is in the gap, but an LED does. Why?', ans: 2, choices: ['Salt water is an insulator', 'The LED makes its own electricity', 'Salt water lets only a small current through, and an LED glows with a much smaller current than a bulb'], work: 'Salt water conducts, but weakly. A torch bulb needs a fairly large current to glow; an LED lights up with just a few milliamperes.' },
      { q: `Class 10: a ${V} V supply drives current through a ${R} Ω resistor. What is the current?`, ans: V / R, unit: 'A', work: `I = V ÷ R = ${V} ÷ ${R} = ${r(V / R)} A` },
      { q: `Class 10: a wire of resistivity ${rho} × 10⁻⁸ Ω m is ${Lm} m long with a cross-section of ${Amm} mm². What is its resistance?`, ans: (rho * 1e-8 * Lm) / (Amm * 1e-6), unit: 'Ω', work: `R = ρL/A = ${rho} × 10⁻⁸ × ${Lm} ÷ (${Amm} × 10⁻⁶) = ${r((rho * 1e-8 * Lm) / (Amm * 1e-6))} Ω` },
    ];
  });
</script>
