---
// #T871 Concrete calculator
---
<div class="tool-ui cc">
  <div class="cc-row">
    <div class="cc-seg cc-units" role="group" aria-label="Units">
      <button type="button" data-u="m" aria-pressed="true">Metric (m, mm)</button>
      <button type="button" data-u="i" aria-pressed="false">Imperial (ft, in)</button>
    </div>
  </div>
  <div class="cc-seg cc-shape" role="group" aria-label="Shape">
    <button type="button" data-s="slab" aria-pressed="true">Slab</button>
    <button type="button" data-s="footing" aria-pressed="false">Footing</button>
    <button type="button" data-s="hole" aria-pressed="false">Post holes</button>
    <button type="button" data-s="steps" aria-pressed="false">Steps</button>
  </div>
  <section class="panel">
    <p class="cc-hint"></p>
    <div class="cc-fields"></div>
    <div class="cc-fields cc-more">
      <label>Extra for waste (%) <input data-x="waste" inputmode="decimal" value="10" /></label>
      <label>Bag size
        <select data-x="bag">
          <option value="20kg">20 kg</option><option value="25kg">25 kg</option><option value="30kg">30 kg</option>
          <option value="40lb">40 lb</option><option value="60lb">60 lb</option><option value="80lb">80 lb</option>
        </select>
      </label>
      <label><span class="cc-ylab">Yield per bag (m³)</span> <input data-x="yield" inputmode="decimal" /></label>
    </div>
    <div class="cc-btns"><button type="button" class="cc-reset">Reset example</button><button type="button" class="cc-clear">Clear</button></div>
  </section>
  <section class="panel cc-res" aria-live="polite">
    <p class="cc-big"></p>
    <dl class="cc-dl">
      <dt>Each</dt><dd class="cc-each"></dd>
      <dt>Volume</dt><dd class="cc-vol"></dd>
      <dt>With waste</dt><dd class="cc-total"></dd>
      <dt>Bags</dt><dd class="cc-bags"></dd>
    </dl>
    <p class="cc-note"></p>
  </section>
  <p class="cc-fine">Bag yields are typical label values: check the bag you buy. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .cc { display: grid; gap: 14px; margin-bottom: 32px; }
  .cc-seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .cc-seg button, .cc-btns button { font: inherit; font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .cc-seg button[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .cc .panel { padding: 16px; }
  .cc-hint { margin: 0 0 10px; color: var(--muted); font-size: 14px; }
  .cc-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: 12px; }
  .cc-more { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  .cc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .cc input, .cc select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .cc input:focus, .cc select:focus { border-color: var(--accent); outline: none; }
  .cc-btns { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .cc-big { font-size: 26px; font-weight: 700; margin: 0 0 10px; overflow-wrap: anywhere; }
  .cc-dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; margin: 0; font-size: 15px; }
  .cc-dl dt { color: var(--muted); }
  .cc-dl dd { margin: 0; overflow-wrap: anywhere; }
  .cc-note { margin: 12px 0 0; color: var(--muted); font-size: 14px; }
  .cc-fine { color: var(--muted); font-size: 13px; margin: 0; }
</style>

<script>
  // Lengths: L = long (m or ft), S = short (mm or in), N = plain count. Everything is worked in metres.
  type F = { k: string; l: string; u: 'L' | 'S' | 'N'; m: number; i: number };
  const SH: Record<string, { hint: string; f: F[]; vol: (v: Record<string, number>) => number }> = {
    slab: { hint: 'A flat slab: patio, shed base or path.',
      f: [{ k: 'l', l: 'Length', u: 'L', m: 3, i: 10 }, { k: 'w', l: 'Width', u: 'L', m: 3, i: 10 }, { k: 't', l: 'Thickness', u: 'S', m: 100, i: 4 }, { k: 'q', l: 'How many', u: 'N', m: 1, i: 1 }],
      vol: (v) => v.l * v.w * v.t },
    footing: { hint: 'A strip footing or rectangular pad under a wall or pier.',
      f: [{ k: 'l', l: 'Length', u: 'L', m: 6, i: 20 }, { k: 'w', l: 'Width', u: 'S', m: 400, i: 16 }, { k: 't', l: 'Depth', u: 'S', m: 300, i: 12 }, { k: 'q', l: 'How many', u: 'N', m: 1, i: 1 }],
      vol: (v) => v.l * v.w * v.t },
    hole: { hint: 'Round post holes or columns. The post inside each hole is taken off (0 if none).',
      f: [{ k: 'd', l: 'Hole diameter', u: 'S', m: 300, i: 12 }, { k: 'h', l: 'Depth', u: 'S', m: 900, i: 36 }, { k: 'p', l: 'Post diameter', u: 'S', m: 100, i: 4 }, { k: 'q', l: 'How many holes', u: 'N', m: 10, i: 10 }],
      vol: (v) => (Math.PI / 4) * Math.max(0, v.d * v.d - v.p * v.p) * v.h },
    steps: { hint: 'Solid steps on the ground: each step is filled down to the base.',
      f: [{ k: 'n', l: 'Number of steps', u: 'N', m: 3, i: 3 }, { k: 'w', l: 'Width', u: 'L', m: 1.2, i: 4 }, { k: 'r', l: 'Rise per step', u: 'S', m: 180, i: 7 }, { k: 'g', l: 'Tread depth', u: 'S', m: 280, i: 11 }],
      vol: (v) => v.w * v.r * v.g * (v.n * (v.n + 1)) / 2 },
  };
  const YIELD: Record<string, number> = { '20kg': 0.0096, '25kg': 0.012, '30kg': 0.0144, '40lb': 0.3, '60lb': 0.45, '80lb': 0.6 };
  const FT3 = 0.028316846592;
  const root = document.querySelector('.cc') as HTMLElement;
  const fields = root.querySelector('.cc-fields') as HTMLElement;
  const q = (s: string) => root.querySelector(s) as HTMLElement;
  const x = (k: string) => root.querySelector(`[data-x="${k}"]`) as HTMLInputElement;
  const n = (v: number, d = 2) => v.toLocaleString('en-US', { maximumFractionDigits: d });
  let units: 'm' | 'i' = 'm', shape = 'slab';
  const vals: Record<string, Record<string, string>> = {};
  const unitName = (u: string) => (u === 'L' ? (units === 'm' ? 'm' : 'ft') : u === 'S' ? (units === 'm' ? 'mm' : 'in') : '');
  const toM = (u: string, v: number) => (u === 'L' ? (units === 'm' ? v : v * 0.3048) : u === 'S' ? (units === 'm' ? v / 1000 : v * 0.0254) : v);
  const inp = (k: string) => fields.querySelector(`[data-k="${k}"]`) as HTMLInputElement;
  const save = () => { const v: Record<string, string> = {}; for (const f of SH[shape].f) v[f.k] = inp(f.k).value; vals[shape] = v; };
  const setYield = () => { const b = (x('bag') as unknown as HTMLSelectElement).value; x('yield').value = String(YIELD[b]); q('.cc-ylab').textContent = `Yield per bag (${b.endsWith('kg') ? 'm³' : 'ft³'})`; };

  const calc = () => {
    const S = SH[shape], v: Record<string, number> = {};
    for (const f of S.f) { const s = inp(f.k).value.trim(); const num = +s; if (s === '' || !Number.isFinite(num) || num < 0) { show(''); return; } v[f.k] = toM(f.u, num); }
    const count = shape === 'steps' ? 1 : Math.round(v.q);
    const each = S.vol(v), vol = each * count;
    const waste = Math.max(0, +x('waste').value || 0), total = vol * (1 + waste / 100);
    const bag = (x('bag') as unknown as HTMLSelectElement).value, y = +x('yield').value;
    const yM3 = bag.endsWith('kg') ? y : y * FT3;
    const three = (m3: number) => `${n(m3, 3)} m³ · ${n(m3 / FT3 / 27, 2)} yd³ · ${n(m3 / FT3, 1)} ft³`;
    q('.cc-each').textContent = count > 1 ? `${n(each, 4)} m³ (${n(each / FT3, 2)} ft³) × ${count}` : '–';
    q('.cc-vol').textContent = three(vol);
    q('.cc-total').textContent = `${three(total)} (+${n(waste, 1)}%)`;
    const bags = yM3 > 0 ? Math.ceil(total / yM3 - 1e-9) : NaN;
    q('.cc-bags').textContent = Number.isFinite(bags) ? `${bags} bags of ${bag.replace(/(\d)(kg|lb)/, '$1 $2')} premix (${n(y, 4)} ${bag.endsWith('kg') ? 'm³' : 'ft³'} each, rounded up)` : 'Type the yield per bag.';
    q('.cc-big').textContent = units === 'm' ? `${n(total, 3)} m³` : `${n(total / FT3 / 27, 2)} yd³`;
    q('.cc-note').textContent = total > 1
      ? 'That is a lot to mix by hand. Above about 1 m³ (1.3 yd³) ready-mix from a truck is usually easier; ask local suppliers about minimum loads and short-load charges, and order a little extra.'
      : 'Small jobs like this are fine with bags. For bigger pours, ready-mix delivered by truck saves mixing; suppliers sell it by the cubic metre or yard.';
  };
  const show = (msg: string) => { q('.cc-big').textContent = ''; for (const c of ['.cc-each', '.cc-vol', '.cc-total', '.cc-bags']) q(c).textContent = '–'; q('.cc-note').textContent = msg || 'Type the sizes above.'; };

  const build = () => {
    const S = SH[shape];
    q('.cc-hint').textContent = S.hint;
    fields.innerHTML = '';
    for (const f of S.f) {
      const lab = document.createElement('label');
      lab.append(f.l + (f.u === 'N' ? '' : ` (${unitName(f.u)})`));
      const el = document.createElement('input'); el.inputMode = 'decimal'; el.dataset.k = f.k;
      el.value = vals[shape]?.[f.k] ?? String(units === 'm' ? f.m : f.i);
      el.addEventListener('input', () => { save(); calc(); });
      lab.append(el); fields.append(lab);
    }
    calc();
  };
  root.querySelectorAll('.cc-shape button').forEach((b) => b.addEventListener('click', () => {
    save(); shape = (b as HTMLElement).dataset.s!;
    root.querySelectorAll('.cc-shape button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    build();
  }));
  root.querySelectorAll('.cc-units button').forEach((b) => b.addEventListener('click', () => {
    const u = (b as HTMLElement).dataset.u as 'm' | 'i';
    if (u === units) return;
    save();
    // Convert what was typed so switching units keeps the job.
    for (const s of Object.keys(vals)) for (const f of SH[s].f) {
      const t = vals[s][f.k]; if (f.u === 'N' || t.trim() === '' || !Number.isFinite(+t)) continue;
      const m = toM(f.u, +t);
      const back = f.u === 'L' ? (u === 'm' ? m : m / 0.3048) : (u === 'm' ? m * 1000 : m / 0.0254);
      vals[s][f.k] = String(+back.toFixed(f.u === 'S' && u === 'm' ? 0 : 2));
    }
    units = u;
    root.querySelectorAll('.cc-units button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    (x('bag') as unknown as HTMLSelectElement).value = u === 'm' ? '25kg' : '80lb'; setYield();
    build();
  }));
  x('waste').addEventListener('input', calc);
  x('yield').addEventListener('input', calc);
  x('bag').addEventListener('change', () => { setYield(); calc(); });
  q('.cc-reset').addEventListener('click', () => { delete vals[shape]; x('waste').value = '10'; setYield(); build(); });
  q('.cc-clear').addEventListener('click', () => { fields.querySelectorAll('input').forEach((i) => ((i as HTMLInputElement).value = '')); save(); calc(); });
  (x('bag') as unknown as HTMLSelectElement).value = '25kg'; setYield();
  build();
</script>
