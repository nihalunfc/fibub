---
// Zeros of a polynomial: linear, quadratic or cubic with coefficient sliders, zeros where the curve meets the x
// axis (drag them to rebuild the polynomial), and the sum and product of zeros against the coefficients.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm pz">
  <div class="ax-card pz-solve">
    <h2>Find the zeros of your polynomial</h2>
    <p class="ax-help">Type the numbers from your question (decimals and fractions like 3/2 are fine) and read the zeros with the working.</p>
    <div class="ax-grid">
      <label>Kind <select data-k="deg" class="pz-sdeg"><option value="2">Quadratic: ax² + bx + c</option><option value="3">Cubic: ax³ + bx² + cx + d</option><option value="1">Linear: ax + b</option></select></label>
      <label>Or start from an example <select data-k="preset" class="pz-pre"><option value="">My own numbers</option></select></label>
    </div>
    <div class="pz-co">
      <label><span class="pz-cl">x²</span><input data-k="ca" inputmode="decimal" value="1" aria-label="a" /></label>
      <label><span class="pz-cl">x</span><input data-k="cb" inputmode="decimal" value="-5" aria-label="b" /></label>
      <label><span class="pz-cl">number</span><input data-k="cc" inputmode="decimal" value="6" aria-label="c" /></label>
      <label hidden><span class="pz-cl">number</span><input data-k="cd" inputmode="decimal" value="0" aria-label="d" /></label>
    </div>
    <p class="ax-err pz-serr" hidden></p>
    <p class="ax-big pz-ans" aria-live="polite"></p>
    <ol class="sm-steps pz-work"></ol>
    <p class="ax-help pz-tip"></p>
    <button type="button" class="btn small secondary pz-show">Draw it on the graph below</button>
    <details class="pz-more">
      <summary>More options: is k a zero? divide by (x − k); build from sum and product</summary>
      <div class="ax-grid" style="margin-top:8px"><label>k (try this value of x) <input data-k="k" inputmode="decimal" value="2" /></label></div>
      <p class="sm-f pz-k"></p>
      <div class="ax-grid" style="margin-top:12px">
        <label>Sum of zeros <input data-k="sum" inputmode="decimal" value="5" /></label>
        <label>Product of zeros <input data-k="prod" inputmode="decimal" value="6" /></label>
      </div>
      <p class="sm-f pz-build"></p>
    </details>
  </div>

  <div class="ax-card">
    <h2>Zeros on the graph</h2>
    <div class="ax-seg pz-deg" role="group" aria-label="Degree">
      <button type="button" data-d="1" aria-pressed="false">Linear</button>
      <button type="button" data-d="2" aria-pressed="true">Quadratic</button>
      <button type="button" data-d="3" aria-pressed="false">Cubic</button>
    </div>
    <p class="ax-big pz-eq" aria-live="polite" style="margin:10px 0 4px"></p>
    <svg class="sm-fig pz-fig" viewBox="0 0 340 300" role="img" aria-label="Graph of the polynomial; zeros are where it meets the x axis"></svg>
    <p class="ax-help pz-note">Slide the coefficients, or drag a green zero along the x axis to move it.</p>
    <div class="sm-sl pz-row" data-k="0"><b>a</b><input type="range" min="-3" max="3" step="0.5" value="1" aria-label="a slider" /><input type="number" step="0.5" value="1" inputmode="decimal" aria-label="a" /></div>
    <div class="sm-sl pz-row" data-k="1"><b>b</b><input type="range" min="-10" max="10" step="0.5" value="-1" aria-label="b slider" /><input type="number" step="0.5" value="-1" inputmode="decimal" aria-label="b" /></div>
    <div class="sm-sl pz-row" data-k="2"><b>c</b><input type="range" min="-10" max="10" step="0.5" value="-6" aria-label="c slider" /><input type="number" step="0.5" value="-6" inputmode="decimal" aria-label="c" /></div>
    <div class="sm-sl pz-row" data-k="3"><b>d</b><input type="range" min="-10" max="10" step="0.5" value="0" aria-label="d slider" /><input type="number" step="0.5" value="0" inputmode="decimal" aria-label="d" /></div>
    <p class="ax-err pz-err" hidden></p>
    <p class="sm-f pz-zeros"></p>
  </div>

  <div class="ax-card">
    <h2>Zeros and coefficients</h2>
    <ul class="sm-steps pz-rel"></ul>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Quadratic: drag the two zeros towards each other until they meet. The curve now just touches the axis.</li>
      <li>Cubic: drag the three zeros to −2, 1 and 3. Read b, c and d, and check them against the sum, pair-sum and product.</li>
      <li>Change a while keeping the zeros. The curve stretches, but the zeros (and −b/a, c/a) stay the same.</li>
      <li>Find a cubic that crosses the x axis only once. Where did the other two zeros go?</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Fractions like 5/2 are fine. Nothing is saved.</p>
    <div class="pz-quiz"></div>
  </div>
</div>

<style is:inline>
  .pz .pz-co { display: grid; grid-template-columns: repeat(auto-fit, minmax(72px, 1fr)); gap: 8px; margin: 10px 0; }
  .pz .pz-co input { min-height: 44px; width: 100%; text-align: center; font-size: 17px; }
  .pz .pz-ans { margin: 12px 0 6px; overflow-wrap: anywhere; }
  .pz .pz-work { padding-left: 22px; display: grid; gap: 6px; overflow-wrap: anywhere; }
  .pz .pz-more summary { cursor: pointer; padding: 8px 0; font-weight: 600; }
</style>

<script>
  import { realZeros, fromZeros, relations, polyText, evalPoly, solveQuadratic, synthetic, allZeros, rationalZero } from '../../lib/sci/polyzeros-school';
  import { fmt, randInt, fracText, readNum, numText } from '../../lib/sci/smath';
  import { S, dragOn, pair, val, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.pz')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.pz-fig');
  const rows = [...root.querySelectorAll<HTMLElement>('.pz-row')];
  const boxes = rows.map((r) => r.querySelector<HTMLInputElement>('input[type=number]')!);
  const sets = rows.map((r, i) => pair(r.querySelector('input[type=range]')!, boxes[i], draw));
  const NAMES = ['a', 'b', 'c', 'd'];
  let deg = 2;
  const X0 = -6, X1 = 6, Y0 = -10, Y1 = 10, L = 10, R = 330, T = 10, B = 290;
  const px = (x: number) => L + ((x - X0) / (X1 - X0)) * (R - L), py = (y: number) => B - ((y - Y0) / (Y1 - Y0)) * (B - T);
  const ux = (p: number) => X0 + ((p - L) / (R - L)) * (X1 - X0);

  function coeffs() {
    const co = boxes.slice(0, deg + 1).map((b, i) => val(b, i ? 0 : 1, -1000, 1000));
    return co;
  }

  function draw() {
    rows.forEach((r, i) => { r.hidden = i > deg; r.querySelector('b')!.textContent = NAMES[i]; });
    const err = q('.pz-err');
    let co = coeffs();
    if (co[0] === 0) { err.textContent = `With a = 0 the x${deg === 1 ? '' : deg === 2 ? '²' : '³'} term disappears and the degree drops. Using a = 1 for now.`; err.hidden = false; co = [1, ...co.slice(1)]; } else err.hidden = true;
    const zs = realZeros(co);
    q('.pz-eq').textContent = `p(x) = ${polyText(co)}`;
    fig.replaceChildren();
    for (let x = X0; x <= X1; x++) S('line', { x1: px(x), x2: px(x), y1: T, y2: B, class: 'sm-grid' }, fig);
    for (let y = Y0; y <= Y1; y += 2) S('line', { x1: L, x2: R, y1: py(y), y2: py(y), class: 'sm-grid' }, fig);
    S('line', { x1: L, x2: R, y1: py(0), y2: py(0), class: 'sm-axis' }, fig);
    S('line', { x1: px(0), x2: px(0), y1: T, y2: B, class: 'sm-axis' }, fig);
    for (const x of [-4, -2, 2, 4]) S('text', { x: px(x), y: py(0) + 14, 'text-anchor': 'middle', class: 'sm-tick' }, fig, fmt(x));
    for (const y of [-8, -4, 4, 8]) S('text', { x: px(0) - 4, y: py(y) + 4, 'text-anchor': 'end', class: 'sm-tick' }, fig, fmt(y));
    let d = '', pen = false;
    for (let i = 0; i <= 360; i++) {
      const x = X0 + (i / 360) * (X1 - X0), y = evalPoly(co, x);
      if (y < Y0 - 3 || y > Y1 + 3) { pen = false; continue; }
      d += `${pen ? 'L' : 'M'}${px(x).toFixed(1)},${py(y).toFixed(1)}`; pen = true;
    }
    const clip = S('clipPath', { id: 'pz-clip' }, fig); S('rect', { x: L, y: T, width: R - L, height: B - T }, clip);
    S('path', { d, class: 'sm-curve', 'clip-path': 'url(#pz-clip)' }, fig);
    const uniq = [...new Set(zs.map((z) => Math.round(z * 1e6) / 1e6))];
    const dragZ = zs.length === deg;
    zs.forEach((z, i) => {
      if (z < X0 || z > X1) return;
      if (dragZ) S('circle', { cx: px(z), cy: py(0), r: 20, class: 'sm-hit' }, fig);
      S('circle', { cx: px(z), cy: py(0), r: 8, class: `sm-good pz-z`, 'data-i': i }, fig);
    });
    uniq.forEach((z) => { if (z >= X0 && z <= X1) S('text', { x: px(z), y: py(0) - 14, 'text-anchor': 'middle', style: 'font-weight:600' }, fig, fmt(z, 2)); });
    const missing = deg - zs.length;
    q('.pz-zeros').textContent = `${zs.length === 0 ? 'No real zeros: the curve never meets the x axis.' : `Real zeros: ${zs.map((z) => fmt(z, 3)).join(', ')}.`}${missing ? ` ${missing} zero${missing > 1 ? 's are' : ' is'} not real (complex), so ${missing > 1 ? 'they do' : 'it does'} not show on the graph.` : ''} A polynomial of degree ${deg} has at most ${deg} zero${deg > 1 ? 's' : ''}.`;
    q('.pz-note').textContent = dragZ ? 'Slide the coefficients, or drag a green zero along the x axis to move it.' : 'Slide the coefficients. (Zeros can be dragged when all of them are real.)';
    // Relations.
    const Rl = relations(co) as { sum: number; pairs?: number; product?: number };
    const [a, b, c, dd] = co;
    const lines: string[] = [];
    const zl = zs.map((z) => `(${fmt(z, 3)})`);
    if (deg === 1) lines.push(`The zero of ax + b is −b/a = ${fmt(-b)} / ${fmt(a)} = ${fmt(Rl.sum, 4)}.`);
    else if (deg === 2) {
      lines.push(`Sum of zeros α + β = −b/a = ${fmt(-b)} / ${fmt(a)} = ${fmt(Rl.sum, 4)}${zs.length === 2 ? `; from the graph: ${zl.join(' + ')} = ${fmt(zs[0] + zs[1], 4)}` : ''}.`);
      lines.push(`Product of zeros αβ = c/a = ${fmt(c)} / ${fmt(a)} = ${fmt(Rl.product!, 4)}${zs.length === 2 ? `; from the graph: ${zl.join(' × ')} = ${fmt(zs[0] * zs[1], 4)}` : ''}.`);
      lines.push(`So p(x) = a[x² − (sum)x + (product)] = ${fmt(a)}[x² ${Rl.sum >= 0 ? '−' : '+'} ${fmt(Math.abs(Rl.sum), 4)}x ${Rl.product! >= 0 ? '+' : '−'} ${fmt(Math.abs(Rl.product!), 4)}].`);
    } else {
      const all = zs.length === 3;
      lines.push(`α + β + γ = −b/a = ${fmt(-b)} / ${fmt(a)} = ${fmt(Rl.sum, 4)}${all ? `; from the graph: ${fmt(zs[0] + zs[1] + zs[2], 4)}` : ''}.`);
      lines.push(`αβ + βγ + γα = c/a = ${fmt(c)} / ${fmt(a)} = ${fmt(Rl.pairs!, 4)}${all ? `; from the graph: ${fmt(zs[0] * zs[1] + zs[1] * zs[2] + zs[0] * zs[2], 4)}` : ''}.`);
      lines.push(`αβγ = −d/a = ${fmt(-dd)} / ${fmt(a)} = ${fmt(Rl.product!, 4)}${all ? `; from the graph: ${zl.join(' × ')} = ${fmt(zs[0] * zs[1] * zs[2], 4)}` : ''}.`);
      if (!all) lines.push('With complex zeros the relations still hold, but you cannot read all the zeros off the graph.');
    }
    q('.pz-rel').replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t })));
  }

  let dragI = -1, held: number[] = [];
  dragOn(fig, (x, y) => {
    const co = coeffs(); if (!co[0]) return null;
    const zs = realZeros(co); if (zs.length !== deg) return null;
    let best = -1, bd = 26;
    zs.forEach((z, i) => { const dd = Math.hypot(x - px(z), y - py(0)); if (dd < bd) { bd = dd; best = i; } });
    if (best < 0) return null;
    dragI = best; held = zs.map((z) => Math.round(z * 1000) / 1000); return 'z';
  }, (_id, x) => {
    held[dragI] = Math.round(Math.max(X0, Math.min(X1, ux(x))) * 2) / 2;
    const a = coeffs()[0];
    fromZeros(held, a).forEach((c, i) => sets[i](Math.round(c * 1000) / 1000));
    draw();
  });

  root.querySelectorAll<HTMLButtonElement>('.pz-deg button').forEach((btn) => btn.addEventListener('click', () => {
    deg = Number(btn.dataset.d); root.querySelectorAll('.pz-deg button').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
    const start = deg === 1 ? [2, -3] : deg === 2 ? [1, -1, -6] : [1, -2, -5, 6];
    start.forEach((c, i) => sets[i](c));
    draw();
  }));
  draw();

  // ---- Find the zeros of typed coefficients, with the working. ----
  const sg = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  const ssel = (k: string) => q<HTMLSelectElement>(`[data-k="${k}"]`);
  const PRE: { name: string; co: string[] }[] = [
    { name: 'x² − 5x + 6', co: ['1', '-5', '6'] },
    { name: '2x² − 7x + 3 (a fraction zero)', co: ['2', '-7', '3'] },
    { name: 'x² − 6x + 9 (equal zeros)', co: ['1', '-6', '9'] },
    { name: 'x² − 4x + 1 (zeros with a root sign)', co: ['1', '-4', '1'] },
    { name: 'x² + 2x + 5 (no real zeros)', co: ['1', '2', '5'] },
    { name: 'x³ − 6x² + 11x − 6', co: ['1', '-6', '11', '-6'] },
    { name: '2x³ − 3x² − 3x + 2', co: ['2', '-3', '-3', '2'] },
    { name: 'x³ − 1 (one real zero)', co: ['1', '0', '0', '-1'] },
  ];
  ssel('preset').append(...PRE.map((p, i) => new Option(p.name, String(i))));
  const tf = (x: number) => fmt(x, 4), par = (x: number) => (x < 0 ? `(${tf(x)})` : tf(x));
  const sumOf = (xs: number[]) => xs.reduce((a, b) => a + b, 0);
  const isSq = (n: number) => Number.isInteger(n) && n >= 0 && Number.isInteger(Math.sqrt(n));
  const cx = (re: number, im: number) => `${numText(re)} ± ${numText(im)}i`;
  /** (−b ± √D)/2a with the root simplified: D = 12 gives 2 ± √3. */
  function surd(a: number, b: number, D: number): string {
    let k = 1, d = D; for (let f = 2; f * f <= d; f++) while (d % (f * f) === 0) { d /= f * f; k *= f; }
    const g = Math.abs(gcdI(gcdI(b, k), 2 * a)) || 1, p = -b / g, rt = k / g, den = (2 * a) / g, root = `${rt === 1 ? '' : rt}√${d}`;
    const sgn = den < 0 ? -1 : 1, P = p * sgn, Dn = Math.abs(den);
    if (Dn === 1) return P === 0 ? `±${root}` : `${P} ± ${root}`;
    return P === 0 ? `±${root}/${Dn}` : `(${P} ± ${root})/${Dn}`;
  }
  const gcdI = (x: number, y: number): number => (y ? gcdI(y, x % y) : Math.abs(x));
  /** The zeros as a sentence and the working lines for a quadratic. */
  function quadWork(a: number, b: number, c: number, lines: string[]) {
    const sq = solveQuadratic(a, b, c), D = sq.D;
    lines.push(`Discriminant D = b² − 4ac = ${par(b)}² − 4×${par(a)}×${par(c)} = ${tf(b * b)} − ${tf(4 * a * c)} = ${tf(D)}.`);
    if (sq.kind === 'complex') { lines.push(`D < 0, so there are no real zeros (the parabola never meets the x axis). The zeros are complex: x = (−b ± √D)/2a = ${cx(sq.re, sq.im)}.`); return { text: `No real zeros. The complex zeros are x = ${cx(sq.re, sq.im)}.`, real: [] as number[] }; }
    const ints = [a, b, c].every(Number.isInteger);
    lines.push(`D ${sq.kind === 'equal' ? '= 0, so the two zeros are equal' : '> 0, so there are two different real zeros'}. x = (−b ± √D)/(2a) = (${tf(-b)} ± √${tf(D)})/${tf(2 * a)}.`);
    if (sq.kind === 'two' && ints && !isSq(D)) lines.push(`Exactly: x = ${surd(a, b, D)}. As decimals: ${tf(sq.real[0])} and ${tf(sq.real[1])}.`);
    const [r1, r2] = sq.real;
    lines.push(`Check: sum of zeros = −b/a = ${numText(-b / a)} and the zeros add to ${numText(r1 + r2)}; product = c/a = ${numText(c / a)} and the zeros multiply to ${numText(r1 * r2)}.`);
    if (ints && sq.kind !== 'complex') { const f = (r: number) => (r === 0 ? 'x' : `(x ${r < 0 ? '+' : '−'} ${numText(Math.abs(r))})`); if (isSq(D)) lines.push(`Factorised: ${a === 1 ? '' : `${a}`}${f(r1)}${sq.kind === 'equal' ? '²' : f(r2)}.`.replace('xx', 'x²')); }
    return { text: sq.kind === 'equal' ? `The zero is x = ${numText(r1)} (it occurs twice).` : `The zeros are x = ${numText(r1)} and x = ${numText(r2)}.`, real: sq.real };
  }
  function solveZeros() {
    const deg = Number(ssel('deg').value), ids = ['ca', 'cb', 'cc', 'cd'];
    const names = deg === 1 ? ['x', 'number'] : deg === 2 ? ['x²', 'x', 'number'] : ['x³', 'x²', 'x', 'number'];
    ids.forEach((id, i) => { const lab = sg(id).closest('label')!; lab.hidden = i > deg; if (i <= deg) lab.querySelector('.pz-cl')!.textContent = names[i]; });
    const err = q('.pz-serr'), ans = q('.pz-ans'), work = q('.pz-work'), tip = q('.pz-tip'), kk = q('.pz-k');
    const co = ids.slice(0, deg + 1).map((id) => readNum(sg(id).value));
    const stop = (m: string) => { err.textContent = m; err.hidden = false; ans.textContent = ''; work.replaceChildren(); tip.textContent = ''; kk.textContent = ''; };
    const bad = co.findIndex((x) => !Number.isFinite(x));
    if (bad >= 0) return stop(`Type a number for the ${names[bad]} box (0 is fine; use a fraction like 3/2 if you need one).`);
    if (co.some((x) => Math.abs(x) > 1e6)) return stop('Please keep the numbers between −1,000,000 and 1,000,000.');
    err.hidden = true;
    const lines: string[] = [], what = `p(x) = ${polyText(co, 4)}`;
    let text = '', zeros: number[] = [];
    const [a, b] = co;
    if (a === 0) {
      const lower = co.slice(1);
      if (lower.every((x) => x === 0)) { ans.textContent = 'Every number is a zero: all the coefficients are 0.'; work.replaceChildren(); tip.textContent = ''; return; }
      return stop(`The first number (${names[0]}) is 0, so this is not a ${deg === 2 ? 'quadratic' : deg === 3 ? 'cubic' : 'linear'} any more. Type a number other than 0 there, or pick a lower kind.`);
    }
    lines.push(`${what}. Its zeros are the x values where p(x) = 0.`);
    if (deg === 1) { zeros = [-b / a]; lines.push(`ax + b = 0, so x = −b/a = ${tf(-b)}/${tf(a)} = ${numText(zeros[0])}.`); text = `The zero is x = ${numText(zeros[0])}.`; }
    else if (deg === 2) { const r = quadWork(a, b, co[2], lines); text = r.text; zeros = r.real; }
    else {
      const [, , c, d] = co, ints = co.every(Number.isInteger), rz = ints ? rationalZero(co) : null;
      let done = false;
      if (rz) {
        const r = rz[0] / rz[1], sy = synthetic(co, r);
        lines.push(`Try the rational zero test: a whole-number or fraction zero p/q has p dividing ${d} and q dividing ${a}. x = ${numText(r)} works: p(${numText(r)}) = ${tf(evalPoly(co, r))}, so (x ${r < 0 ? '+' : '−'} ${numText(Math.abs(r))}) is a factor.`);
        lines.push(`Divide (synthetic division, k = ${numText(r)}): ${sy.rows.map(tf).join(', ')}. The quotient is ${polyText(sy.quotient, 4)} and the remainder is ${tf(sy.remainder)}.`);
        const sub: string[] = []; const r2 = quadWork(sy.quotient[0], sy.quotient[1], sy.quotient[2], sub); lines.push(...sub.map((t, i) => (i === 0 ? `Now solve the quotient. ${t}` : t)));
        zeros = [r, ...r2.real].sort((x, y) => x - y);
        const cp = solveQuadratic(sy.quotient[0], sy.quotient[1], sy.quotient[2]);
        text = cp.kind === 'complex' ? `One real zero: x = ${numText(r)}. The other two are complex: x = ${cx(cp.re, cp.im)}.` : `The zeros are ${zeros.map((z) => `x = ${numText(z)}`).join(', ')}${new Set(zeros.map((z) => tf(z))).size < 3 ? ' (one repeats)' : ''}.`;
        done = true;
      }
      if (!done) {
        const az = allZeros(co); zeros = az.real;
        lines.push('No simple whole-number or fraction zero was found, so the zeros are found by the cubic formula (worked out by the page) and rounded.');
        text = az.complex ? `One real zero: x ≈ ${tf(az.real[0])}. The other two are complex: x ≈ ${tf(az.complex.re)} ± ${tf(az.complex.im)}i.` : `The zeros are ${az.real.map((z) => `x ≈ ${tf(z)}`).join(', ')}.`;
      }
      const all = zeros.length === 3;
      lines.push(`Check with the relations: α + β + γ = −b/a = ${numText(-b / a)}${all ? `, zeros add to ${numText(sumOf(zeros))}` : ''}; αβ + βγ + γα = c/a = ${numText(c / a)}${all ? `, zeros give ${numText(zeros[0] * zeros[1] + zeros[1] * zeros[2] + zeros[0] * zeros[2])}` : ''}; αβγ = −d/a = ${numText(-d / a)}${all ? `, zeros multiply to ${numText(zeros[0] * zeros[1] * zeros[2])}` : ''}.`);
    }
    ans.textContent = text;
    work.replaceChildren(...lines.map((t) => Object.assign(document.createElement('li'), { textContent: t.replace(/-(?=\d)/g, '−') })));
    tip.textContent = deg === 1 ? 'Common mistake: the zero is −b/a, not b/a. Check by putting it back into p(x).' : 'Common mistake: write the equation as p(x) = 0 first (everything on one side) and keep the signs of b and c when you substitute them.';
    // k: remainder theorem.
    const k = readNum(sg('k').value);
    if (!Number.isFinite(k)) kk.textContent = 'Type a number for k to test it as a zero.';
    else { const v = evalPoly(co, k), sy = synthetic(co, k), isZ = Math.abs(v) < 1e-9 * Math.max(1, ...co.map(Math.abs)); kk.textContent = `p(${numText(k)}) = ${tf(v)}${isZ ? `, so k = ${numText(k)} is a zero and (x ${k < 0 ? '+' : '−'} ${numText(Math.abs(k))}) is a factor.` : `, which is not 0, so ${numText(k)} is not a zero. By the remainder theorem, dividing by (x ${k < 0 ? '+' : '−'} ${numText(Math.abs(k))}) leaves remainder ${tf(v)}.`} Quotient: ${polyText(sy.quotient, 4)}, remainder ${tf(sy.remainder)}.`.replace(/-(?=\d)/g, '−'); }
    // Build from sum and product.
    const S = readNum(sg('sum').value), P = readNum(sg('prod').value), bl = q('.pz-build');
    if (!Number.isFinite(S) || !Number.isFinite(P)) bl.textContent = 'Type the sum and the product to build the quadratic.';
    else { const Dd = S * S - 4 * P; bl.textContent = `x² − (sum)x + (product) = ${polyText([1, -S, P], 4)}. Its zeros are ${Dd < 0 ? `not real (D = ${tf(Dd)} is below 0)` : Dd === 0 ? `equal: x = ${numText(S / 2)}` : `x = ${numText((S - Math.sqrt(Dd)) / 2)} and x = ${numText((S + Math.sqrt(Dd)) / 2)}`}. Any a × this polynomial has the same zeros.`.replace(/-(?=\d)/g, '−'); }
  }
  const sroot = q('.pz-solve');
  sroot.addEventListener('input', (e) => { const k = (e.target as HTMLElement).dataset.k; if (k === 'preset') return; if (['ca', 'cb', 'cc', 'cd'].includes(k!)) ssel('preset').value = ''; solveZeros(); });
  sroot.addEventListener('change', (e) => {
    const k = (e.target as HTMLElement).dataset.k;
    if (k === 'preset') {
      const p = PRE[Number(ssel('preset').value)]; if (!p) return;
      ssel('deg').value = String(p.co.length - 1); ['ca', 'cb', 'cc', 'cd'].forEach((id, i) => { sg(id).value = p.co[i] ?? '0'; });
    } else if (k === 'deg') ssel('preset').value = '';
    solveZeros();
  });
  q('.pz-show').addEventListener('click', () => {
    const d = Number(ssel('deg').value), co = ['ca', 'cb', 'cc', 'cd'].slice(0, d + 1).map((id) => readNum(sg(id).value));
    if (!co.every(Number.isFinite) || !co[0]) { solveZeros(); return; }
    root.querySelector<HTMLButtonElement>(`.pz-deg button[data-d="${d}"]`)!.click();
    co.forEach((c, i) => sets[i](Math.max(-1000, Math.min(1000, c)))); draw();
    q('.pz-fig').scrollIntoView({ block: 'center', behavior: 'smooth' });
  });
  solveZeros();

  quiz(q('.pz-quiz'), () => {
    const out: Question[] = [];
    let r1 = randInt(-5, 5), r2 = randInt(-5, 5); while (r1 === r2) r2 = randInt(-5, 5);
    const co1 = fromZeros([r1, r2]);
    out.push({ q: `Find the zeros of ${polyText(co1)}.`, want: [r1, r2], hint: 'both zeros', work: `${polyText(co1)} = (x ${r1 < 0 ? '+' : '−'} ${Math.abs(r1)})(x ${r2 < 0 ? '+' : '−'} ${Math.abs(r2)}), so the zeros are ${r1} and ${r2}. Check: sum ${r1 + r2} = −b, product ${r1 * r2} = c.`.replace(/-/g, '−') });
    const a2 = randInt(2, 5), b2 = randInt(-9, 9, true), c2 = randInt(-9, 9, true);
    out.push({ q: `For ${polyText([a2, b2, c2])}, what are the sum and the product of the zeros?`, want: [-b2 / a2, c2 / a2], ordered: true, hint: 'sum, product', tol: 0.005,
      work: `Sum = −b/a = ${fracText(-b2, a2)} and product = c/a = ${fracText(c2, a2)}.` });
    const s3 = randInt(-6, 6), p3 = randInt(-9, 9);
    out.push({ q: `A quadratic x² + bx + c has zeros with sum ${s3} and product ${p3}. Find b and c.`, want: [-s3, p3], ordered: true, hint: 'b, c', work: `x² − (sum)x + (product) = x² ${s3 > 0 ? '−' : '+'} ${Math.abs(s3)}x ${p3 < 0 ? '−' : '+'} ${Math.abs(p3)}, so b = ${-s3} and c = ${p3}.`.replace(/(= )-/g, '$1−') });
    const z = [randInt(-3, 3), randInt(-3, 3), randInt(-3, 3)], co4 = fromZeros(z, 2);
    out.push({ q: `The cubic ${polyText(co4)} has three zeros. What is their sum? And their product?`, want: [z[0] + z[1] + z[2], z[0] * z[1] * z[2]], ordered: true, hint: 'sum, product',
      work: `Sum = −b/a = ${fmt(-co4[1])}/2 = ${fmt(z[0] + z[1] + z[2])}; product = −d/a = ${fmt(-co4[3])}/2 = ${fmt(z[0] * z[1] * z[2])}. (The zeros are ${z.slice().sort((x, y) => x - y).join(', ')}.)`.replace(/-/g, '−') });
    return out;
  });
</script>
