---
// #T844 Hospital CD viewer: list the studies and series on a hospital scan CD or USB and look at the images.
---
<div class="tool-ui cd">
  <p class="note cd-note">Your files stay on this device. fibub never sees them. For organising your own records, not medical advice. Ask your doctor or pharmacist about your results. <b>Not for diagnosis:</b> this is a simple viewer.</p>

  <div class="panel cd-pick">
    <h2>Open your disc or USB stick</h2>
    <p class="cd-hint">Choose the whole folder from the disc (it often has a folder called DICOM, plus a viewer program and a DICOMDIR file that are skipped), or drop files here.</p>
    <div class="cd-btns">
      <label class="btn cd-folder">Choose a folder<input type="file" class="cd-dir" webkitdirectory multiple hidden /></label>
      <label class="btn secondary cd-fl">Choose files<input type="file" class="cd-files" multiple hidden /></label>
    </div>
    <div class="cd-drop" tabindex="0">or drop a folder or files here</div>
    <p class="cd-prog" role="status"></p>
  </div>

  <div class="cd-list" hidden>
    <div class="panel">
      <div class="cd-head"><h2>What is on it</h2><button type="button" class="btn secondary cd-names">Show patient names</button></div>
      <p class="cd-sum" role="status"></p>
      <div class="cd-studies"></div>
      <p class="cd-hint">Sharing these files? <a href="/science/dicom-anonymiser/">Remove names before sharing</a>. For measurements and more tools, use the <a href="/science/dicom-viewer/">DICOM viewer</a>.</p>
    </div>
  </div>

  <div class="panel cd-view" hidden>
    <div class="cd-head"><h2 class="cd-title"></h2><button type="button" class="btn secondary cd-close">Close picture</button></div>
    <p class="cd-err note warn" hidden></p>
    <div class="cd-stage"><canvas class="cd-cv" role="img" aria-label="Scan image"></canvas></div>
    <label class="cd-slice">Image <b class="cd-sn"></b><input type="range" class="cd-range" min="0" max="0" value="0" /></label>
    <div class="cd-grid">
      <label>Brightness window <select class="cd-pre"></select></label>
      <label class="cd-inv"><input type="checkbox" class="cd-invert" /> Invert black and white</label>
    </div>
    <p class="cd-hint">Window presets are approximate starting points. They change how the picture looks, not the scan.</p>
    <div class="cd-btns">
      <button type="button" class="btn secondary cd-png">Save this image (PNG)</button>
      <button type="button" class="btn secondary cd-jpg">Save this image (JPG)</button>
      <button type="button" class="btn secondary cd-mark">Add to PDF</button>
      <button type="button" class="btn cd-pdf" disabled>Make PDF of chosen images</button>
    </div>
    <p class="cd-hint cd-marked" role="status">No images chosen for the PDF yet.</p>
    <p class="cd-hint">Saved pictures hold only the image. Some scans have names burnt into the picture itself, so look before you share.</p>
  </div>
</div>

<style is:inline>
  .cd { display: grid; gap: 14px; margin-bottom: 32px; }
  .cd > * { min-width: 0; }
  .cd h2 { font-size: 17px; margin: 0; }
  .cd .panel { padding: 16px; }
  .cd-hint { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
  .cd-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .cd-btns label { cursor: pointer; }
  .cd-drop { margin-top: 12px; padding: 20px; border: 2px dashed var(--line); border-radius: 12px; text-align: center; color: var(--muted); }
  .cd-drop.over { border-color: var(--accent); background: var(--accent-soft); }
  .cd-prog { margin: 8px 0 0; font-size: 14px; }
  .cd-prog:empty { display: none; }
  .cd-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .cd-sum { margin: 0 0 10px; font-size: 14px; color: var(--muted); }
  .cd-study { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; background: var(--surface); }
  .cd-study h3 { margin: 0; font-size: 16px; overflow-wrap: anywhere; }
  .cd-study .meta { font-size: 14px; color: var(--muted); margin: 2px 0 8px; overflow-wrap: anywhere; }
  .cd-series { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .cd-series span { flex: 1 1 200px; overflow-wrap: anywhere; }
  .cd-stage { background: #000; border-radius: 8px; overflow: hidden; }
  .cd-cv { display: block; width: 100%; height: 380px; }
  .cd-slice { display: grid; gap: 4px; margin-top: 10px; font-size: 14px; color: var(--muted); }
  .cd-slice[hidden] { display: none; }
  .cd-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; margin-top: 10px; align-items: end; }
  .cd label { font-size: 14px; }
  .cd select { font: inherit; padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); width: 100%; min-width: 0; }
  .cd-inv { display: flex; gap: 8px; align-items: center; }
  .cd-range { width: 100%; accent-color: var(--accent); }
</style>

<script>
  import * as D from '../../lib/sci/dicom';
  import { readInst, group, niceDate, type Inst, type Series, type Study } from '../../lib/docs/cdindex';
  import { save } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.cd')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const MAX_FILES = 30000;
  let studies: Study[] = [], showNames = false, skipped = 0;

  // ---------- opening ----------
  async function walk(entry: any, out: File[]) {
    if (entry.isFile) out.push(await new Promise<File>((res, rej) => entry.file(res, rej)));
    else if (entry.isDirectory) {
      const r = entry.createReader();
      for (;;) { const batch: any[] = await new Promise((res, rej) => r.readEntries(res, rej)); if (!batch.length) break; for (const e of batch) await walk(e, out); }
    }
  }
  async function openFiles(files: File[]) {
    if (!files.length) return;
    const prog = q('.cd-prog');
    if (files.length > MAX_FILES) { prog.textContent = `That is ${files.length.toLocaleString('en')} files; this page reads up to ${MAX_FILES.toLocaleString('en')} at a time.`; return; }
    const found: Inst[] = []; skipped = 0;
    for (let i = 0; i < files.length; i++) {
      if (i % 25 === 0) { prog.textContent = `Reading ${i + 1} of ${files.length} files…`; await new Promise((r) => setTimeout(r)); }
      const x = await readInst(files[i]);
      if (x) found.push(x); else skipped++;
    }
    prog.textContent = '';
    studies = group(found);
    closeView();
    renderList(found.length);
  }
  q('.cd-dir').addEventListener('change', (e) => { const i = e.target as HTMLInputElement; openFiles([...(i.files ?? [])]); i.value = ''; });
  q('.cd-files').addEventListener('change', (e) => { const i = e.target as HTMLInputElement; openFiles([...(i.files ?? [])]); i.value = ''; });
  const drop = q('.cd-drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', async (e) => {
    e.preventDefault(); drop.classList.remove('over');
    const dt = (e as DragEvent).dataTransfer!, out: File[] = [];
    const items = [...dt.items].map((it) => (it as any).webkitGetAsEntry?.()).filter(Boolean);
    if (items.length) { for (const en of items) await walk(en, out); } else out.push(...dt.files);
    openFiles(out);
  });

  // ---------- the list ----------
  function renderList(n: number) {
    const total = studies.reduce((s, st) => s + st.series.length, 0);
    q('.cd-list').hidden = false;
    q('.cd-sum').textContent = `${n} DICOM image file${n === 1 ? '' : 's'} found: ${studies.length} stud${studies.length === 1 ? 'y' : 'ies'}, ${total} series. ${skipped} other file${skipped === 1 ? '' : 's'} skipped (DICOMDIR, programs, text and anything that is not a DICOM file).`;
    q('.cd-names').textContent = showNames ? 'Hide patient names' : 'Show patient names';
    q('.cd-studies').innerHTML = studies.map((s, si) => `<section class="cd-study"><h3>${esc(niceDate(s.date))}${s.desc ? ' · ' + esc(s.desc) : ''}</h3><p class="meta">${[s.modalities.join(', '), s.bodies.join(', '), 'Patient: ' + (showNames ? esc(s.patient || 'not given') : '•••• (hidden)')].filter(Boolean).join(' · ')}</p>${s.series.map((r, ri) => `<div class="cd-series"><span><b>${r.no ? 'Series ' + r.no : 'Series'}</b>${r.desc ? ': ' + esc(r.desc) : ''} · ${esc(r.modality || '?')}${r.body ? ' · ' + esc(r.body) : ''} · ${r.insts.length} image${r.insts.length === 1 ? '' : 's'}</span><button type="button" class="btn secondary cd-open" data-s="${si}" data-r="${ri}">Open</button></div>`).join('')}</section>`).join('');
  }
  q('.cd-names').addEventListener('click', () => { showNames = !showNames; renderList(studies.reduce((s, st) => s + st.series.reduce((a, r) => a + r.insts.length, 0), 0)); });
  q('.cd-studies').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.cd-open'); if (!b) return;
    const st = studies[+b.dataset.s!]; openSeries(st, st.series[+b.dataset.r!]);
  });

  // ---------- the viewer ----------
  type Img = { inst: Inst; frame: number };
  let cur: { study: Study; series: Series; imgs: Img[] } | null = null, idx = 0, wc = 40, ww = 400, inv = false;
  const marked = new Set<string>();
  const cache = new Map<File, D.Dicom>();
  const cv = q<HTMLCanvasElement>('.cd-cv'), pix = document.createElement('canvas');

  async function parsed(i: Inst): Promise<D.Dicom> {
    let d = cache.get(i.file);
    if (!d) { d = D.parse(new Uint8Array(await i.file.arrayBuffer())); cache.set(i.file, d); if (cache.size > 40) cache.delete(cache.keys().next().value!); }
    return d;
  }
  function closeView() { q('.cd-view').hidden = true; cur = null; cache.clear(); }
  q('.cd-close').addEventListener('click', closeView);

  function openSeries(study: Study, series: Series) {
    const imgs: Img[] = [];
    for (const inst of series.insts) for (let f = 0; f < Math.min(inst.info.frames, 500); f++) imgs.push({ inst, frame: f });
    cur = { study, series, imgs }; idx = Math.floor((imgs.length - 1) / 2);
    q('.cd-view').hidden = false;
    q('.cd-title').textContent = `${niceDate(study.date)} · ${series.desc || 'Series ' + series.no}`;
    const first = series.insts[0].info, sel = q<HTMLSelectElement>('.cd-pre'), opts: [string, string][] = [];
    first.wc.forEach((c, k) => { if (Number.isFinite(first.ww[k])) opts.push([`f${k}`, `From the scan file (centre ${c}, width ${first.ww[k]})`]); });
    opts.push(['auto', 'Automatic (fits the picture)']);
    if (first.units === 'HU') for (const p of D.PRESETS) opts.push([`p:${p.name}`, `${p.name}, approximate (centre ${p.c}, width ${p.w})`]);
    sel.replaceChildren(...opts.map(([v, t]) => new Option(t, v)));
    q('.cd-view').scrollIntoView({ block: 'nearest' });
    show();
  }
  async function show() {
    if (!cur) return;
    const im = cur.imgs[idx], info = im.inst.info, err = q('.cd-err');
    const r = q<HTMLInputElement>('.cd-range'); r.max = String(cur.imgs.length - 1); r.value = String(idx);
    q('.cd-slice').hidden = cur.imgs.length < 2;
    q('.cd-sn').textContent = `${idx + 1} of ${cur.imgs.length}`;
    q('.cd-mark').textContent = marked.has(key()) ? 'Remove from PDF' : 'Add to PDF';
    if (!info.supported) { err.hidden = false; err.textContent = info.why; const c = cv.getContext('2d')!; cv.width = 10; cv.height = 10; c.fillStyle = '#000'; c.fillRect(0, 0, 10, 10); return; }
    err.hidden = true;
    const d = await parsed(im.inst);
    if (!cur || cur.imgs[idx] !== im) return;
    const w = info.cols, h = info.rows;
    pix.width = w; pix.height = h;
    const ictx = pix.getContext('2d')!, id = ictx.createImageData(w, h), px = id.data;
    if (info.spp === 3) { const rgb = D.rgbFrame(d, info, im.frame); for (let i = 0; i < w * h; i++) { for (let k = 0; k < 3; k++) px[i * 4 + k] = inv ? 255 - rgb[i * 3 + k] : rgb[i * 3 + k]; px[i * 4 + 3] = 255; } }
    else {
      const data = D.frame(d, info, im.frame);
      applyPreset(data);
      const flip = (info.photo === 'MONOCHROME1') !== inv;
      for (let i = 0; i < w * h; i++) { let g = D.windowLevel(data[i], wc, ww); if (flip) g = 255 - g; px[i * 4] = px[i * 4 + 1] = px[i * 4 + 2] = g; px[i * 4 + 3] = 255; }
    }
    ictx.putImageData(id, 0, 0);
    const box = cv.getBoundingClientRect(), W = Math.max(1, Math.round(box.width)), H = Math.max(1, Math.round(box.height));
    cv.width = W; cv.height = H;
    const c = cv.getContext('2d')!, ay = info.spacing ? info.spacing[0] / info.spacing[1] : 1;
    const s = Math.min(W / w, H / (h * ay));
    c.fillStyle = '#000'; c.fillRect(0, 0, W, H); c.imageSmoothingEnabled = s < 3;
    c.drawImage(pix, (W - w * s) / 2, (H - h * ay * s) / 2, w * s, h * ay * s);
  }
  function applyPreset(data: Float32Array) {
    const v = q<HTMLSelectElement>('.cd-pre').value, i = cur!.series.insts[0].info;
    if (v.startsWith('f')) { const k = +v.slice(1); wc = i.wc[k]; ww = i.ww[k]; }
    else if (v.startsWith('p:')) { const p = D.PRESETS.find((x) => x.name === v.slice(2))!; wc = p.c; ww = p.w; }
    else { [wc, ww] = D.autoWindow(data); }
  }
  const key = () => `${cur!.series.uid}:${idx}`;
  q('.cd-range').addEventListener('input', (e) => { idx = +(e.target as HTMLInputElement).value; show(); });
  q('.cd-pre').addEventListener('change', () => show());
  q('.cd-invert').addEventListener('change', (e) => { inv = (e.target as HTMLInputElement).checked; show(); });

  // ---------- exports ----------
  const fullBlob = (type: string) => new Promise<Blob | null>((res) => {
    // The picture at its own pixel size, not the size on screen.
    const c = document.createElement('canvas'); c.width = pix.width; c.height = pix.height;
    const x = c.getContext('2d')!; if (type === 'image/jpeg') { x.fillStyle = '#000'; x.fillRect(0, 0, c.width, c.height); }
    x.drawImage(pix, 0, 0); c.toBlob(res, type, 0.92);
  });
  const fileBase = () => `scan-series${cur!.series.no || ''}-image${idx + 1}`;
  q('.cd-png').addEventListener('click', async () => { if (!cur) return; await show(); const b = await fullBlob('image/png'); if (b) save(b, `${fileBase()}.png`, 'image/png'); });
  q('.cd-jpg').addEventListener('click', async () => { if (!cur) return; await show(); const b = await fullBlob('image/jpeg'); if (b) save(b, `${fileBase()}.jpg`, 'image/jpeg'); });

  type Pick = { blob: Blob; caption: string };
  const picks = new Map<string, Pick>();
  const updateMarked = () => {
    q('.cd-marked').textContent = picks.size ? `${picks.size} image${picks.size === 1 ? '' : 's'} chosen for the PDF (up to 200).` : 'No images chosen for the PDF yet.';
    (q('.cd-pdf') as HTMLButtonElement).disabled = !picks.size;
  };
  q('.cd-mark').addEventListener('click', async () => {
    if (!cur) return;
    await show();
    const k = key();
    if (picks.has(k)) { picks.delete(k); marked.delete(k); }
    else {
      if (picks.size >= 200) { q('.cd-marked').textContent = 'The PDF holds up to 200 images; make this one first.'; return; }
      const b = await fullBlob('image/png'); if (!b) return;
      picks.set(k, { blob: b, caption: `${niceDate(cur.study.date)} · ${cur.series.desc || 'Series ' + cur.series.no} · image ${idx + 1} of ${cur.imgs.length}` }); marked.add(k);
    }
    q('.cd-mark').textContent = marked.has(k) ? 'Remove from PDF' : 'Add to PDF';
    updateMarked();
  });
  q('.cd-pdf').addEventListener('click', async () => {
    const { PDFDocument, StandardFonts, rgb } = await import('pdf-lib');
    const { pdfSafe } = await import('../../lib/resume/pdf');
    const doc = await PDFDocument.create(); doc.setTitle('Scan images'); doc.setCreator('fibub.com');
    const font = await doc.embedFont(StandardFonts.Helvetica), W = 595.28, H = 841.89, M = 40;
    for (const p of picks.values()) {
      const pg = doc.addPage([W, H]), im = await doc.embedPng(new Uint8Array(await p.blob.arrayBuffer()));
      const s = Math.min((W - 2 * M) / im.width, (H - 2 * M - 40) / im.height);
      pg.drawRectangle({ x: M, y: H - M - im.height * s, width: im.width * s, height: im.height * s, color: rgb(0, 0, 0) });
      pg.drawImage(im, { x: M, y: H - M - im.height * s, width: im.width * s, height: im.height * s });
      pg.drawText(pdfSafe(p.caption).text, { x: M, y: M + 18, size: 10, font });
      pg.drawText('Not for diagnosis. Made on your own device with fibub.com. Look for names burnt into the picture before sharing.', { x: M, y: M, size: 8, font, color: rgb(0.4, 0.4, 0.4) });
    }
    save(await doc.save(), 'scan-images.pdf', 'application/pdf');
  });
  updateMarked();
</script>
