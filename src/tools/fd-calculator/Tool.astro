---
// #1735 FD calculator: fixed deposit / GIC / CD and recurring deposit maturity, with a ladder.
---
<div class="tool-ui fd">
  <section class="panel">
    <h2>Your deposit</h2>
    <div class="fd-grid">
      <label>Currency <select class="fd-cur" data-k="cur"></select></label>
      <label>Type <select data-k="type"><option value="fd">Fixed deposit, GIC or CD (one lump sum)</option><option value="rd">Recurring deposit (a deposit every month)</option></select></label>
      <label><span class="fd-al">Amount deposited</span> <input data-k="amt" inputmode="decimal" /></label>
      <label>Interest rate <span class="fd-suf"><input data-k="rate" inputmode="decimal" /><i>% a year</i></span></label>
      <label>Length <input data-k="len" inputmode="decimal" /></label>
      <label>In <select data-k="unit"><option value="months">months</option><option value="days">days</option><option value="years">years</option></select></label>
      <label>Interest is <select data-k="comp"><option value="m">compounded monthly</option><option value="q">compounded quarterly</option><option value="h">compounded every 6 months</option><option value="y">compounded yearly</option><option value="s">simple, paid at the end</option></select></label>
      <label class="fd-lad-l">Ladder <select data-k="ladder"><option value="1">No ladder (one deposit)</option><option value="2">Split across 2 terms</option><option value="3">Split across 3 terms</option><option value="4">Split across 4 terms</option><option value="5">Split across 5 terms</option></select></label>
    </div>
    <p class="note bad fd-err" role="alert" hidden></p>
  </section>
  <section class="fd-res" aria-live="polite">
    <div class="fd-stats">
      <div><span>Maturity amount</span><b class="fd-mat"></b></div>
      <div><span class="fd-pl">You deposit</span><b class="fd-put"></b></div>
      <div class="good"><span>Interest earned</span><b class="fd-int"></b></div>
    </div>
    <p class="fd-line fd-eff"></p>
    <div class="fd-lad panel" hidden>
      <h2>Your ladder</h2>
      <p class="fd-hint">The amount is split equally. The first deposit has the length you entered, the next twice that, and so on, so one matures after each step and you can reinvest it.</p>
      <div class="fd-wrap"><table>
        <thead><tr><th>Deposit</th><th>Amount</th><th>Length</th><th>Matures to</th><th>Interest</th></tr></thead>
        <tbody class="fd-body"></tbody>
      </table></div>
    </div>
  </section>
  <p class="fd-fine">Recurring deposits use a deposit at the start of every month. With quarterly compounding this is the standard Indian bank formula, R[(1+i)^n - 1] / (1 - (1+i)^(-1/3)), with i the quarterly rate and n the number of quarters. Days are counted as days / 365. Banks may round differently, pay a different rate, or take tax at source; check your bank's own figure. Not financial or tax advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .fd { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .fd > *, .fd-res > * { min-width: 0; }
  .fd h2 { margin: 0 0 12px; font-size: 18px; }
  .fd .panel { padding: 16px; }
  .fd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .fd label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .fd input, .fd select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .fd input:focus, .fd select:focus { border-color: var(--accent); outline: none; }
  .fd input[type=checkbox] { width: auto; }
  .fd-suf { position: relative; display: block; }
  .fd-suf i { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-style: normal; font-size: 13px; color: var(--muted); pointer-events: none; }
  .fd-suf input { padding-right: 84px; }
  .fd-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .fd-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .fd-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .fd-stats span { font-size: 13px; color: var(--muted); }
  .fd-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .fd-stats .good b { color: var(--good); }
  .fd-stats .bad b { color: var(--bad); }
  .fd-line { margin: 0; font-size: 15px; }
  .fd-line:empty { display: none; }
  .fd-chart { margin: 0; }
  .fd-chart figcaption { font-weight: 600; font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 14px; margin-bottom: 8px; }
  .fd-chart .lg { font-weight: 500; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }
  .fd-wrap { overflow-x: auto; }
  .fd table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .fd th, .fd td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .fd th:first-child, .fd td:first-child { text-align: left; }
  .fd th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .fd-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .fd-err { margin: 10px 0 0; }
  .fd-hint { margin: 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 720px) { .fd-stats { grid-template-columns: 1fr; } }
</style>

<script>
  import { fdMaturity, rdMaturity, type Comp } from '../../lib/money/goals';
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  const root = document.querySelector<HTMLElement>('.fd')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  const cur = defaultCurrency();
  q('.fd-cur').innerHTML = currencyOptions(cur);
  const india = cur === 'INR';
  f('amt').value = india ? '1,00,000' : '10,000'; f('rate').value = '7'; f('len').value = '12'; f('comp').value = 'q';
  const $ = (n: number) => money(n, f('cur').value, Math.abs(n) < 10000 ? 2 : 0);
  const lenText = (months: number, unit: string, len: number) => unit === 'days' ? `${len} days` : unit === 'years' ? `${len} year${len === 1 ? '' : 's'}` : `${len} month${len === 1 ? '' : 's'}`;
  function run() {
    const rd = f('type').value === 'rd', unit = f('unit').value, len = num(f('len').value), amt = num(f('amt').value), rate = num(f('rate').value), comp = f('comp').value as Comp;
    q('.fd-al').textContent = rd ? 'Deposit each month' : 'Amount deposited';
    q('.fd-lad-l').hidden = rd; if (rd) f('ladder').value = '1';
    const years = unit === 'days' ? len / 365 : unit === 'months' ? len / 12 : len;
    const bad = !(amt > 0) ? 'Enter the amount.' : !(len > 0) ? 'Enter the length of the deposit.' : years > 50 ? 'Enter a length of up to 50 years.' : rate < 0 || rate > 100 ? 'Enter the yearly interest rate, for example 7.' : rd && Math.abs(years * 12 - Math.round(years * 12)) > 1e-6 ? 'A recurring deposit needs a whole number of months. Use months or years.' : '';
    q('.fd-err').hidden = !bad; q('.fd-err').textContent = bad; q('.fd-res').hidden = !!bad;
    if (bad) return;
    const rungs = rd ? 1 : +f('ladder').value;
    let mat = 0, put = 0, rows = '';
    if (rd) {
      const months = Math.round(years * 12);
      mat = rdMaturity(amt, rate, months, comp); put = amt * months;
    } else {
      for (let k = 1; k <= rungs; k++) {
        const part = amt / rungs, y = years * (rungs === 1 ? 1 : k), m = fdMaturity(part, rate, y, comp);
        mat += m; put += part;
        const L = len * (rungs === 1 ? 1 : k);
        rows += `<tr><td>${k}</td><td>${$(part)}</td><td>${lenText(0, unit, Math.round(L * 100) / 100)}</td><td>${$(m)}</td><td>${$(m - part)}</td></tr>`;
      }
    }
    q('.fd-pl').textContent = rd ? 'You deposit in total' : 'You deposit';
    q('.fd-mat').textContent = $(mat); q('.fd-put').textContent = $(put); q('.fd-int').textContent = $(mat - put);
    const lad = q('.fd-lad'); lad.hidden = rungs < 2; q('.fd-body').innerHTML = rows;
    const eff = comp === 's' ? rate : (Math.pow(1 + rate / 100 / ({ m: 12, q: 4, h: 2, y: 1 } as Record<string, number>)[comp], ({ m: 12, q: 4, h: 2, y: 1 } as Record<string, number>)[comp]) - 1) * 100;
    q('.fd-eff').textContent = rungs > 1 ? 'With a ladder, the maturity amount is the sum of every deposit when it matures; the longest one decides when you have it all.' : comp === 's' ? '' : `Compounded this way, ${rate}% a year is worth ${(Math.round(eff * 100) / 100)}% over a full year.`;
  }
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
