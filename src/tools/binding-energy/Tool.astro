---
// Binding energy per nucleon (Learn): the curve from the liquid drop formula with real nuclei marked, a mass defect
// calculator from atomic masses, and fission and fusion shown as moves up the curve.
import '../../styles/astro.css';
import '../../styles/learnquiz-d.css';
---
<div class="ax lrn bne">
  <div class="ax-card">
    <h2>Binding energy per nucleon</h2>
    <canvas class="lrn-cv be-cv" aria-label="Graph of binding energy per nucleon against mass number, rising steeply, peaking near iron and falling slowly"></canvas>
    <div class="ax-seg be-show" role="group" aria-label="Show a reaction" style="margin-top:8px"><button type="button" data-r="none" aria-pressed="true">Just the curve</button><button type="button" data-r="fission" aria-pressed="false">Fission</button><button type="button" data-r="fusion" aria-pressed="false">Fusion</button></div>
    <div class="ax-grid" style="margin-top:10px">
      <label class="lrn-sl">Mass number A <b class="be-Av"></b><input type="range" class="be-A" min="4" max="250" step="1" value="56" aria-label="Mass number" /></label>
    </div>
    <p class="lrn-eq be-eq"></p>
    <dl class="ax-facts be-terms" style="margin-top:10px"></dl>
    <p class="ax-help">The line is the liquid drop (semi-empirical) formula for the most tightly bound nucleus of each mass number; it is a model and is poor for the lightest nuclei. Dots are real nuclei worked out from their measured masses.</p>
  </div>

  <div class="ax-card">
    <h2>Mass defect calculator</h2>
    <div class="ax-grid">
      <label>Nucleus <select class="be-nuc"></select></label>
      <label class="be-own">Protons Z <input class="be-Z" inputmode="numeric" value="2" /></label>
      <label class="be-own">Mass number A <input class="be-AA" inputmode="numeric" value="4" /></label>
      <label class="be-own">Atomic mass (u) <input class="be-M" inputmode="decimal" value="4.002603" /></label>
    </div>
    <p class="ax-err be-err" hidden></p>
    <p class="ax-big be-big"></p>
    <p class="lrn-eq be-meq"></p>
    <p class="ax-help">Atomic masses (including the electrons) are used with the mass of a hydrogen atom, 1.007825 u, so the electrons cancel. Neutron 1.008665 u. 1 u = 931.494 MeV. Masses from the 2020 Atomic Mass Evaluation, rounded.</p>
  </div>

  <div class="ax-card be-react" hidden>
    <h2 class="be-rh"></h2>
    <p class="lrn-eq be-req"></p>
    <dl class="ax-facts be-rf" style="margin-top:10px"></dl>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lrn-try">
      <li>Slide A from 4 to 250 and find the top of the curve: nuclei near iron and nickel are the most tightly bound.</li>
      <li>Look at the terms: the surface term hurts small nuclei, the Coulomb (proton push) term hurts big ones.</li>
      <li>Show Fission: splitting uranium-235 moves both halves up the curve, and the extra binding comes out as about 200 MeV.</li>
      <li>Show Fusion: joining hydrogen nuclei into helium jumps much further up the curve, so it gives more energy per kilogram.</li>
      <li>In the calculator, compare helium-4 with lithium-7: helium is unusually tightly bound.</li>
    </ul>
  </div>

  <div class="ax-card be-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<script>
  import { NUCLEI, massDefect, bindingMeV, semf, stableZ, qValue, M_H, M_N, U_MEV } from '../../lib/sci/learnbinding';
  import { mountQuiz, pick, one, r, fitCanvas } from '../../lib/learnquiz-d';
  import { pagePalette } from '../../lib/report';
  import { num, sig, fmtExp } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.bne')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const nsel = q<HTMLSelectElement>('.be-nuc'); NUCLEI.forEach((n) => nsel.add(new Option(n.name, n.id))); nsel.add(new Option('My own nucleus', 'own')); nsel.value = 'he4';
  const by = (id: string) => NUCLEI.find((n) => n.id === id)!;
  const realBA = NUCLEI.map((n) => ({ ...n, ba: bindingMeV(n.Z, n.A, n.M) / n.A }));
  const curve = Array.from({ length: 247 }, (_, i) => { const A = i + 4; return [A, semf(stableZ(A), A).perNucleon] as [number, number]; });
  let react = 'none';
  const FIS = { inM: [by('u235').M, M_N], outM: [by('ba141').M, by('kr92').M, 3 * M_N] };
  const FUS = { inM: [by('h2').M, by('h3').M], outM: [by('he4').M, M_N] };
  const J_PER_MEV = 1.602176634e-13, KG_PER_U = 1.66053906660e-27;

  function draw() {
    const pal = pagePalette(), { ctx, W, H } = fitCanvas(q<HTMLCanvasElement>('.be-cv'), 260), gx = 34, gy = 10, gw = W - 44, gh = H - 42;
    const X = (A: number) => gx + (A / 250) * gw, Y = (b: number) => gy + gh - (b / 10) * gh;
    ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = pal.line; ctx.lineWidth = 1; ctx.strokeRect(gx, gy, gw, gh);
    ctx.fillStyle = pal.muted; ctx.font = '11px system-ui, sans-serif'; ctx.textAlign = 'right';
    for (const b of [0, 2, 4, 6, 8, 10]) { ctx.fillText(String(b), gx - 4, Y(b) + 4); if (b && b < 10) { ctx.strokeStyle = pal.grid; ctx.beginPath(); ctx.moveTo(gx, Y(b)); ctx.lineTo(gx + gw, Y(b)); ctx.stroke(); } }
    ctx.textAlign = 'center'; for (const A of [0, 50, 100, 150, 200, 250]) ctx.fillText(String(A), X(A), gy + gh + 13);
    ctx.fillText('mass number A', gx + gw / 2, H - 6);
    ctx.save(); ctx.translate(10, gy + gh / 2); ctx.rotate(-Math.PI / 2); ctx.fillText('MeV per nucleon', 0, 0); ctx.restore();
    const hi = pal.red ? pal.ink : pal.accent, hi2 = pal.red ? pal.muted : pal.accent2;
    ctx.strokeStyle = hi; ctx.lineWidth = 2; ctx.beginPath(); curve.forEach(([A, b], i) => { const y = Y(Math.max(0, b)); if (i) ctx.lineTo(X(A), y); else ctx.moveTo(X(A), y); }); ctx.stroke();
    ctx.fillStyle = pal.ink; ctx.font = '10px system-ui, sans-serif'; ctx.textAlign = 'left';
    realBA.forEach((n) => { ctx.beginPath(); ctx.arc(X(n.A), Y(n.ba), 3.5, 0, 7); ctx.fill(); if (['he4', 'fe56', 'u238', 'h2', 'c12'].includes(n.id)) ctx.fillText(n.name.replace(/ \(.*\)/, '').replace('Deuterium', 'H-2'), X(n.A) + 5, Y(n.ba) + (n.id === 'u238' ? -6 : 12)); });
    const A = +q<HTMLInputElement>('.be-A').value, b = semf(NUCLEI.find((n) => n.A === A)?.Z ?? stableZ(A), A).perNucleon;
    ctx.fillStyle = hi2; ctx.beginPath(); ctx.arc(X(A), Y(Math.max(0, b)), 6, 0, 7); ctx.fill();
    const arrow = (x1: number, y1: number, x2: number, y2: number) => { ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); const a = Math.atan2(y2 - y1, x2 - x1); ctx.beginPath(); ctx.moveTo(x2, y2); ctx.lineTo(x2 - 9 * Math.cos(a - 0.4), y2 - 9 * Math.sin(a - 0.4)); ctx.lineTo(x2 - 9 * Math.cos(a + 0.4), y2 - 9 * Math.sin(a + 0.4)); ctx.closePath(); ctx.fill(); };
    ctx.strokeStyle = hi2; ctx.fillStyle = hi2; ctx.lineWidth = 2;
    const ba = (id: string) => realBA.find((n) => n.id === id)!;
    if (react === 'fission') { const u = ba('u235'); arrow(X(u.A), Y(u.ba), X(ba('ba141').A), Y(ba('ba141').ba)); arrow(X(u.A), Y(u.ba), X(ba('kr92').A), Y(ba('kr92').ba)); }
    if (react === 'fusion') { arrow(X(2), Y(ba('h2').ba), X(4), Y(ba('he4').ba)); arrow(X(3), Y(ba('h3').ba), X(4), Y(ba('he4').ba)); }
  }

  function curveText() {
    const A = +q<HTMLInputElement>('.be-A').value, Z = NUCLEI.find((n) => n.A === A)?.Z ?? stableZ(A), s = semf(Z, A);
    q('.be-Av').textContent = `${A} (Z = ${Z}, N = ${A - Z})`;
    q('.be-eq').textContent = `Liquid drop: B = ${sig(s.vol, 4)} (volume) − ${sig(-s.surf, 4)} (surface) − ${sig(-s.coul, 4)} (Coulomb) − ${sig(-s.asym, 3)} (asymmetry) ${s.pair >= 0 ? '+' : '−'} ${sig(Math.abs(s.pair), 3)} (pairing) = ${sig(s.B, 4)} MeV, so B/A = ${sig(s.perNucleon, 4)} MeV per nucleon.`;
    q('.be-terms').replaceChildren(fact('Binding energy', `${sig(s.B, 4)} MeV`), fact('Per nucleon', `${sig(s.perNucleon, 4)} MeV`), fact('Surface loss per nucleon', `${sig(-s.surf / A, 3)} MeV`, 'big for small nuclei'), fact('Coulomb loss per nucleon', `${sig(-s.coul / A, 3)} MeV`, 'big for large nuclei'));
    draw();
  }

  function calc() {
    const own = nsel.value === 'own'; root.querySelectorAll<HTMLElement>('.be-own').forEach((e) => { e.hidden = !own; });
    let Z: number, A: number, M: number, name: string;
    if (own) { Z = num(q<HTMLInputElement>('.be-Z').value); A = num(q<HTMLInputElement>('.be-AA').value); M = num(q<HTMLInputElement>('.be-M').value); name = `Z = ${Z}, A = ${A}`; }
    else { const n = by(nsel.value); Z = n.Z; A = n.A; M = n.M; name = n.name; }
    const err = q('.be-err');
    const bad = !(Number.isInteger(Z) && Number.isInteger(A) && Z >= 1 && A >= 2 && Z < A && A <= 300) ? 'Give whole numbers with 1 ≤ Z < A ≤ 300.' : !(Math.abs(M - A) < 0.5) ? 'The atomic mass in u should be close to A (within 0.5).' : '';
    err.textContent = bad; err.hidden = !bad;
    if (bad) { q('.be-big').textContent = ''; q('.be-meq').textContent = ''; return; }
    const dm = massDefect(Z, A, M), B = dm * U_MEV;
    q('.be-big').textContent = `${name}: ${sig(B, 5)} MeV, ${sig(B / A, 4)} MeV per nucleon`;
    q('.be-meq').textContent = `Δm = Z m_H + N m_n − M = ${Z} × ${M_H.toFixed(6)} + ${A - Z} × ${M_N.toFixed(6)} − ${M} = ${dm.toFixed(6)} u.  B = Δm × 931.494 MeV/u = ${sig(B, 5)} MeV.  B/A = ${sig(B, 5)} / ${A} = ${sig(B / A, 4)} MeV.`;
  }

  function reaction() {
    q('.be-react').hidden = react === 'none';
    if (react === 'none') return;
    const fis = react === 'fission', R = fis ? FIS : FUS, Q = qValue(R.inM, R.outM), nuc = fis ? 236 : 5, massU = R.inM.reduce((a, b) => a + b, 0);
    q('.be-rh').textContent = fis ? 'Fission: uranium-235 + n → barium-141 + krypton-92 + 3n' : 'Fusion: deuterium + tritium → helium-4 + n';
    q('.be-req').textContent = fis
      ? `Mass before: ${by('u235').M} + ${M_N.toFixed(6)} u. Mass after: ${by('ba141').M} + ${by('kr92').M} + 3 × ${M_N.toFixed(6)} u. Lost: ${sig(Q / U_MEV, 4)} u × 931.494 = ${sig(Q, 4)} MeV.`
      : `Mass before: ${by('h2').M} + ${by('h3').M} u. Mass after: ${by('he4').M} + ${M_N.toFixed(6)} u. Lost: ${sig(Q / U_MEV, 4)} u × 931.494 = ${sig(Q, 4)} MeV.`;
    q('.be-rf').replaceChildren(fact('Energy given out', `${sig(Q, 4)} MeV`, fis ? 'plus about 25 MeV more later, from the radioactive fragments' : 'mostly carried by the neutron'), fact('Per nucleon taking part', `${sig(Q / nuc, 3)} MeV`, `${nuc} nucleons`), fact('Per kilogram of fuel', `${fmtExp((Q * J_PER_MEV) / (massU * KG_PER_U), 2)} J`, 'millions of times more than burning fuel'));
  }

  q<HTMLInputElement>('.be-A').addEventListener('input', curveText);
  [nsel, q('.be-Z'), q('.be-AA'), q('.be-M')].forEach((e) => e.addEventListener('input', calc));
  root.querySelectorAll<HTMLButtonElement>('.be-show button').forEach((b) => b.addEventListener('click', () => { react = b.dataset.r!; root.querySelectorAll('.be-show button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); reaction(); draw(); }));
  addEventListener('resize', draw);
  curveText(); calc(); reaction();

  mountQuiz(q('.be-quiz'), () => {
    const dm = pick(5, 300) / 1000, A = pick(20, 200), ba = pick(75, 88) / 10, n = one(NUCLEI.filter((x) => x.A > 3 && x.A < 60)), ask = one([0, 1]);
    const Bn = bindingMeV(n.Z, n.A, n.M);
    return [
      { q: `A nucleus has a mass defect of ${dm} u. What is its binding energy? (1 u = 931.5 MeV)`, ans: dm * 931.5, unit: 'MeV', work: `B = Δm × 931.5 = ${dm} × 931.5 = ${r(dm * 931.5, 4)} MeV` },
      { q: `A nucleus with A = ${A} has a binding energy of ${r(A * ba, 4)} MeV. What is its binding energy per nucleon?`, ans: ba, unit: 'MeV', work: `B/A = ${r(A * ba, 4)} / ${A} = ${ba} MeV per nucleon` },
      { q: `${n.name} (Z = ${n.Z}, A = ${n.A}) has an atomic mass of ${n.M} u. With m_H = 1.007825 u and m_n = 1.008665 u, what is its binding energy in MeV?`, ans: Bn, unit: 'MeV', tol: 0.01, work: `Δm = ${n.Z} × 1.007825 + ${n.A - n.Z} × 1.008665 − ${n.M} = ${massDefect(n.Z, n.A, n.M).toFixed(6)} u; B = Δm × 931.5 = ${r(Bn, 4)} MeV` },
      { q: ask ? 'Which of these nuclei is the most tightly bound (largest binding energy per nucleon)?' : 'Which of these is the least tightly bound per nucleon?', ans: ask ? 1 : 0, choices: ['Deuterium (H-2)', 'Iron-56', 'Uranium-238'], work: ask ? 'Iron-56 sits near the top of the curve, at about 8.8 MeV per nucleon.' : 'Deuterium has only about 1.1 MeV per nucleon: the lightest nuclei are the most loosely bound.' },
      { q: 'Why do both fission of uranium and fusion of hydrogen give out energy?', ans: 0, choices: ['The products have more binding energy per nucleon', 'The products have more mass', 'Neutrons are created from nothing'], work: 'Both move towards the peak of the curve near iron. The products are more tightly bound, so a little mass is lost and comes out as energy (E = mc²).' },
    ];
  });
</script>
