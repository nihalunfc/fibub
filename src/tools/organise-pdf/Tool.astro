---
// #1701 Organise PDF
---
<div class="tool-ui og">
  <label class="og-drop">Add one or more PDFs <input class="og-file" type="file" accept="application/pdf,.pdf" multiple /></label>
  <p class="og-msg" role="status" aria-live="polite"></p>
  <div class="og-bar" hidden>
    <button class="btn secondary small og-all" type="button">Select all</button>
    <button class="btn secondary small og-none" type="button">Select none</button>
    <button class="btn secondary small og-clear" type="button">Remove all files</button>
  </div>
  <div class="og-grid"></div>
  <div class="og-out" hidden>
    <h3>Save</h3>
    <div class="og-row">
      <button class="btn og-merge" type="button">Download all pages as one PDF</button>
      <button class="btn secondary og-extract" type="button">Download selected pages</button>
    </div>
    <div class="og-row">
      <label>Split every <input class="og-n" type="number" min="1" value="1" /> pages</label>
      <button class="btn secondary og-split-n" type="button">Split to ZIP</button>
    </div>
    <div class="og-row">
      <label>Split by ranges <input class="og-ranges" type="text" placeholder="1-3,5" /></label>
      <button class="btn secondary og-split-r" type="button">Split to ZIP</button>
    </div>
    <p class="og-hint">Page numbers in ranges follow the order you see above. Each part between commas becomes its own PDF.</p>
  </div>
</div>

<style is:inline>
  .og { display: grid; gap: .75rem; }
  .og-drop { display: grid; gap: .4rem; padding: 1rem; border: 2px dashed var(--line); border-radius: var(--radius); font-weight: 600; }
  .og-bar, .og-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .og-bar[hidden], .og-out[hidden] { display: none; }
  .og-msg { margin: 0; min-height: 1.3em; }
  .og-msg.err { color: var(--warn); }
  .og-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: .6rem; }
  .og-card { border: 2px solid var(--line); border-radius: 10px; padding: 6px; display: grid; gap: 4px; background: var(--surface); }
  .og-card.sel { border-color: var(--accent); }
  .og-th { height: 120px; display: grid; place-items: center; overflow: hidden; cursor: pointer; background: #fff; border-radius: 6px; }
  .og-th canvas { max-width: 100%; max-height: 120px; transition: transform .15s; }
  .og-lab { font-size: 12px; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .og-act { display: flex; justify-content: space-between; gap: 2px; }
  .og-act button { flex: 1; min-height: 36px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 6px; font: inherit; cursor: pointer; }
  .og input[type=number] { width: 4.5em; } .og-ranges { width: 9em; }
  .og-hint { font-size: 14px; margin: 0; }
</style>

<script>
  import { zipSync } from 'fflate';
  import { buildPdf, parseRanges, download, baseName, loadPdfJs, type PageRef } from '../../lib/docs/pdfpages';
  const root = document.querySelector('.og') as HTMLElement;
  const $ = <T extends Element>(s: string) => root.querySelector(s) as T;
  const msg = $<HTMLElement>('.og-msg'), grid = $<HTMLElement>('.og-grid');
  interface Item extends PageRef { sel: boolean }
  const sources: Uint8Array[] = [], names: string[] = [], viewers: any[] = [];
  let items: Item[] = [];
  const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('err', err); };

  async function thumb(it: Item): Promise<HTMLCanvasElement> {
    const pg = await viewers[it.src].getPage(it.index + 1);
    const vp0 = pg.getViewport({ scale: 1 }), scale = 120 / Math.max(vp0.width, vp0.height) * 1.5;
    const vp = pg.getViewport({ scale }), c = document.createElement('canvas');
    c.width = vp.width; c.height = vp.height;
    await pg.render({ canvasContext: c.getContext('2d')!, viewport: vp, canvas: c } as any).promise;
    return c;
  }
  const cache = new Map<string, HTMLCanvasElement>();

  function draw() {
    grid.textContent = '';
    items.forEach((it, i) => {
      const card = document.createElement('div'); card.className = 'og-card' + (it.sel ? ' sel' : '');
      card.innerHTML = '<div class="og-th" title="Tap to select"></div><div class="og-lab"></div><div class="og-act"><button type="button" data-a="l" aria-label="Move earlier">&larr;</button><button type="button" data-a="r" aria-label="Move later">&rarr;</button><button type="button" data-a="rot" aria-label="Rotate">&#8635;</button><button type="button" data-a="del" aria-label="Delete page">&times;</button></div>';
      (card.querySelector('.og-lab') as HTMLElement).textContent = `${i + 1}. ${names[it.src]} p${it.index + 1}`;
      const th = card.querySelector('.og-th') as HTMLElement, key = it.src + ':' + it.index;
      const put = (c: HTMLCanvasElement) => { const k = c.cloneNode() as HTMLCanvasElement; k.getContext('2d')!.drawImage(c, 0, 0); k.style.transform = `rotate(${it.rot}deg)`; th.appendChild(k); };
      if (cache.has(key)) put(cache.get(key)!); else thumb(it).then((c) => { cache.set(key, c); if (th.isConnected) put(c); }).catch(() => { th.textContent = 'No preview'; });
      th.onclick = () => { it.sel = !it.sel; card.classList.toggle('sel', it.sel); };
      card.querySelector('.og-act')!.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('button')?.dataset.a; if (!a) return;
        if (a === 'l' && i > 0) [items[i - 1], items[i]] = [items[i], items[i - 1]];
        else if (a === 'r' && i < items.length - 1) [items[i + 1], items[i]] = [items[i], items[i + 1]];
        else if (a === 'rot') it.rot = (it.rot + 90) % 360;
        else if (a === 'del') items.splice(i, 1);
        draw();
      });
      grid.appendChild(card);
    });
    const has = items.length > 0;
    ($('.og-bar') as HTMLElement).hidden = !has; ($('.og-out') as HTMLElement).hidden = !has;
    if (has) say(`${items.length} page${items.length === 1 ? '' : 's'} from ${sources.length} file${sources.length === 1 ? '' : 's'}. Tap a page to select it.`);
  }

  $<HTMLInputElement>('.og-file').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement, files = [...(input.files || [])]; input.value = '';
    for (const f of files) {
      try {
        say(`Reading ${f.name}...`);
        const bytes = new Uint8Array(await f.arrayBuffer());
        const pdfjs = await loadPdfJs();
        const doc = await pdfjs.getDocument({ data: bytes.slice(), isEvalSupported: false }).promise;
        const src = sources.length; sources.push(bytes); names.push(baseName(f.name)); viewers.push(doc);
        for (let i = 0; i < doc.numPages; i++) items.push({ src, index: i, rot: 0, sel: false });
      } catch { say(`${f.name} could not be opened. It may be damaged or locked with a password.`, true); return; }
    }
    draw();
  });
  const each = (fn: (it: Item) => void) => { items.forEach(fn); draw(); };
  $('.og-all').addEventListener('click', () => each((it) => (it.sel = true)));
  $('.og-none').addEventListener('click', () => each((it) => (it.sel = false)));
  $('.og-clear').addEventListener('click', () => { items = []; sources.length = names.length = viewers.length = 0; cache.clear(); say(''); draw(); });

  const outName = () => (sources.length === 1 ? names[0] : 'organised');
  const refs = (list: Item[]): PageRef[] => list.map(({ src, index, rot }) => ({ src, index, rot }));
  async function zip(groups: Item[][], label: string) {
    const files: Record<string, Uint8Array> = {};
    for (let g = 0; g < groups.length; g++) files[`${outName()}-${label}${g + 1}.pdf`] = await buildPdf(sources, refs(groups[g]));
    download(zipSync(files, { level: 0 }), `${outName()}-split.zip`, 'application/zip');
    say(`Made a ZIP with ${groups.length} PDF${groups.length === 1 ? '' : 's'}.`);
  }
  const guard = (fn: () => Promise<void>) => async () => { try { await fn(); } catch (e: any) { say(e.message || 'Something went wrong.', true); } };
  $('.og-merge').addEventListener('click', guard(async () => { download(await buildPdf(sources, refs(items)), `${outName()}-organised.pdf`); say(`Saved ${items.length} pages.`); }));
  $('.og-extract').addEventListener('click', guard(async () => {
    const s = items.filter((i) => i.sel); if (!s.length) throw new Error('Tap the pages you want first.');
    download(await buildPdf(sources, refs(s)), `${outName()}-extract.pdf`); say(`Saved ${s.length} selected pages.`);
  }));
  $('.og-split-n').addEventListener('click', guard(async () => {
    const n = Math.max(1, Math.floor(Number($<HTMLInputElement>('.og-n').value) || 1)), g: Item[][] = [];
    for (let i = 0; i < items.length; i += n) g.push(items.slice(i, i + n));
    await zip(g, 'part');
  }));
  $('.og-split-r').addEventListener('click', guard(async () => {
    const groups = parseRanges($<HTMLInputElement>('.og-ranges').value, items.length);
    await zip(groups.map((g) => g.map((i) => items[i])), 'part');
  }));
</script>
