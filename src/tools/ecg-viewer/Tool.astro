---
// ECG viewer and HRV: filtering, Pan-Tompkins beat detection, heart rate, RR tachogram, time- and frequency-domain
// HRV and a Poincaré plot. The example ECG is synthetic (made up by fibub in the browser), never a real recording.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax egv">
  <div class="ax-card">
    <h2>ECG recording</h2>
    <label>Samples <textarea class="eg-data" rows="7" spellcheck="false"></textarea></label>
    <DataFile target=".eg-data" maxMB={20} maxCols={12} maxRows={400000} label="Open a file" />
    <div class="ax-row" style="margin-top:8px"><button type="button" class="btn secondary small eg-ex">Use the example</button></div>
    <p class="ax-help">One lead. Either one column of values at a fixed sample rate, or a time column in seconds plus value columns. Header rows are skipped. The example is a made-up ECG of 3 minutes at 250 Hz, built from Gaussian waves with a slow and a breathing rhythm in the heart rate, baseline wander, 50 Hz hum and noise. Up to 400,000 samples.</p>
    <div class="ax-grid" style="margin-top:10px">
      <label>Layout <select class="eg-fmt"><option value="v" selected>Values only (give the sample rate)</option><option value="tv">Time (s) in the first column</option></select></label>
      <label>Value column (1 = first) <input class="eg-col" type="text" inputmode="numeric" value="1" /></label>
      <label>Sample rate (Hz) <input class="eg-fs" type="text" inputmode="decimal" value="250" /></label>
      <label>Unit (for labels) <input class="eg-unit" type="text" value="mV" /></label>
      <label>High-pass cut-off (Hz) <input class="eg-hp" type="text" inputmode="decimal" value="0.5" /></label>
      <label>Low-pass cut-off (Hz) <input class="eg-lp" type="text" inputmode="decimal" value="40" /></label>
      <label>Mains hum filter <select class="eg-notch"><option value="0">Off</option><option value="50" selected>50 Hz notch</option><option value="60">60 Hz notch</option></select></label>
      <label>R wave points <select class="eg-pol"><option value="auto" selected>Find out (up or down)</option><option value="up">Up</option><option value="down">Down</option></select></label>
      <label>Set aside RR intervals that differ from the local median by more than <select class="eg-tol"><option value="0">Off (keep all)</option><option value="0.1">10 %</option><option value="0.2" selected>20 %</option><option value="0.3">30 %</option></select></label>
      <label class="ax-check"><input class="eg-detr" type="checkbox" checked /> Remove the straight-line trend before the spectrum</label>
    </div>
    <p class="ax-help">The high-pass removes baseline wander (breathing, movement), the low-pass removes muscle noise; 0.5 to 40 Hz is a common choice for viewing. Filters are second-order Butterworth, run forwards and backwards so the waves do not shift. Beat detection always uses its own 5 to 15 Hz band. Leave a cut-off empty to switch it off. Intervals set aside (missed or extra beats, ectopic beats) are left out of HRV.</p>
    <p class="ax-err eg-err" hidden></p>
  </div>

  <div class="ax-card eg-out">
    <h2>Heart rate and HRV</h2>
    <p class="ax-big eg-big"></p>
    <dl class="ax-facts eg-facts"></dl>
    <h2 style="margin-top:14px">ECG with the detected beats</h2>
    <div class="ax-grid">
      <label>Window <select class="eg-win"><option value="5">5 s</option><option value="10" selected>10 s</option><option value="30">30 s</option><option value="0">Whole recording</option></select></label>
      <label>Start at <b class="eg-posv">0 s</b><input class="eg-pos" type="range" min="0" max="100" step="0.5" value="0" /></label>
    </div>
    <canvas class="ax-fig eg-strip"></canvas>
    <h2 style="margin-top:14px">RR tachogram</h2>
    <canvas class="ax-fig eg-tach"></canvas>
    <h2 style="margin-top:14px">Spectrum (Lomb-Scargle)</h2>
    <dl class="ax-facts eg-ffacts"></dl>
    <canvas class="ax-fig eg-psd"></canvas>
    <h2 style="margin-top:14px">Poincaré plot</h2>
    <canvas class="ax-fig eg-poin"></canvas>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small eg-csv">Download beats (CSV)</button></div>
    <p class="ax-help"><b>For study and research, not for diagnosis.</b> This page finds beats and measures the spacing between them; it does not judge rhythm, find arrhythmias or read the shape of the waves. Short recordings (under 2 minutes) give unreliable LF power and VLF needs much longer ones. Your recording stays on this device.</p>
    <Downloads />
  </div>
</div>

<script>
  import { panTompkins, hrvTime, hrvFreq, synthEcg, BANDS, type Polarity } from '../../lib/sci/ecg';
  import { filtfilt, bandSections, readSignal } from '../../lib/sci/biosig';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, parseTable, sig, csv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.egv')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const val = (c: string) => (q(c) as HTMLInputElement).value;
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const factsOf = (box: HTMLElement) => [...box.children].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent! + (d.querySelector('small') ? ` (${d.querySelector('small')!.textContent})` : '')] as [string, string]);
  const f1 = (v: number, d = 1) => (Number.isFinite(v) ? v.toFixed(d) : '–');

  const example = () => { const { x } = synthEcg(); let s = 'ECG (mV), 250 Hz\n'; for (const v of x) s += v.toFixed(4) + '\n'; return s; };
  let state: { y: Float64Array; fs: number; t0: number; r: number[]; unit: string } | null = null;
  let figs: Figure[] = [], report: Section[] = [], beatRows: (string | number)[][] = [];

  function strip() {
    if (!state) return;
    const { y, fs, t0, r, unit } = state, dur = y.length / fs;
    const win = +val('.eg-win') || dur, pos = q<HTMLInputElement>('.eg-pos');
    pos.max = String(Math.max(0, Math.floor((dur - win) * 2) / 2)); pos.disabled = win >= dur;
    const a = Math.min(+pos.value, +pos.max), i0 = Math.max(0, Math.floor(a * fs)), i1 = Math.min(y.length, Math.ceil((a + win) * fs) + 1);
    q('.eg-posv').textContent = `${a} s`;
    const step = Math.max(1, Math.floor((i1 - i0) / 4000)), xs: number[] = [], ys: number[] = [];
    for (let i = i0; i < i1; i += step) {
      if (step === 1) { xs.push(t0 + i / fs); ys.push(y[i]); continue; }
      let lo = i, hi = i; for (let k = i; k < Math.min(i1, i + step); k++) { if (y[k] < y[lo]) lo = k; if (y[k] > y[hi]) hi = k; }
      for (const k of lo < hi ? [lo, hi] : [hi, lo]) { xs.push(t0 + k / fs); ys.push(y[k]); }
    }
    const rr = r.filter((v) => v >= i0 && v < i1);
    const at = (p: number) => { const k = Math.floor(p), u = p - k; return y[k] * (1 - u) + (y[k + 1] ?? y[k]) * u; };
    const fig = chartFigure({ w: 380, h: 220, xLabel: 'Time (s)', yLabel: `ECG (${unit})`, legend: 'below', xMin: t0 + a, xMax: t0 + a + win, series: [
      { name: 'Filtered ECG', x: xs, y: ys, mode: 'line', width: 1 },
      { name: `Detected beats (${rr.length} in view)`, x: rr.map((p) => t0 + p / fs), y: rr.map(at), mode: 'points', marker: 'open-circle', size: 4 },
    ] }, `Filtered ECG from ${a} s to ${a + win} s with ${rr.length} detected beats marked`);
    paint(q<HTMLCanvasElement>('.eg-strip'), fig); figs[0] = fig;
    if (report[0]) report[0].figure = fig;
  }

  function calc() {
    const err = q('.eg-err'), out = q('.eg-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; state = null; };
    const tv = val('.eg-fmt') === 'tv';
    let col = Math.round(num(val('.eg-col')));
    if (tv && col === 1) col = 2;
    if (!(col >= 1)) return fail('The value column must be a whole number, 1 or more.');
    const fsIn = num(val('.eg-fs'));
    if (!tv && !(fsIn > 0)) return fail('Give the sample rate in Hz (samples per second), such as 250 or 500.');
    const sgl = readSignal(parseTable(q<HTMLTextAreaElement>('.eg-data').value), num, fsIn, col, tv);
    const fs = sgl.fs;
    if (!sgl.y.length) return fail(tv ? `No numbers found in columns 1 (time) and ${col} (value).` : `No numbers found in column ${col}.`);
    if (sgl.y.length > 400000) return fail(`The recording has ${sgl.y.length.toLocaleString('en')} samples; the limit is 400,000.`);
    if (!(fs >= 50 && fs <= 10000)) return fail(`The sample rate is ${Number.isFinite(fs) ? sig(fs, 4) : 'unknown'} Hz. Beat detection needs 50 to 10,000 Hz${tv ? '; check the time column is in seconds' : ''}.`);
    const dur = sgl.y.length / fs;
    if (dur < 10) return fail(`The recording is ${sig(dur, 3)} s long. Give at least 10 seconds (2 to 5 minutes for HRV).`);
    const hp = val('.eg-hp').trim() ? num(val('.eg-hp')) : 0, lp = val('.eg-lp').trim() ? num(val('.eg-lp')) : 0, mains = +val('.eg-notch');
    if (!(hp >= 0) || !(lp >= 0)) return fail('The cut-off frequencies must be numbers of 0 or more (leave empty to switch off).');
    if (lp && lp >= fs / 2) return fail(`The low-pass cut-off must be below half the sample rate (${sig(fs / 2, 4)} Hz).`);
    if (hp && lp && hp >= lp) return fail('The high-pass cut-off must be lower than the low-pass cut-off.');
    const unit = val('.eg-unit').trim() || 'units';
    const y = filtfilt(sgl.y, bandSections(fs, hp, lp, mains));
    let det;
    try { det = panTompkins(sgl.y, y, fs, val('.eg-pol') as Polarity); } catch (e) { return fail((e as Error).message); }
    const beats = det.r.map((p) => sgl.t0 + p / fs);
    let h;
    try { h = hrvTime(beats, +val('.eg-tol')); } catch (e) { return fail(`${(e as Error).message} Check the sample rate, the value column and the R wave direction.`); }
    err.hidden = true; out.hidden = false;
    state = { y, fs, t0: sgl.t0, r: det.r, unit };
    q('.eg-big').textContent = `Heart rate ${f1(h.meanHR)} bpm · SDNN ${f1(h.sdnn)} ms · RMSSD ${f1(h.rmssd)} ms`;
    const facts = [
      fact('Recording', `${sig(dur, 4)} s`, `${sgl.y.length.toLocaleString('en')} samples at ${sig(fs, 5)} Hz${sgl.fromTime ? ' (from the time column)' : ''}${sgl.skipped ? `; ${sgl.skipped} text row${sgl.skipped === 1 ? '' : 's'} skipped` : ''}`),
      fact('Beats found', String(beats.length), `R waves point ${det.polarity}${det.searchBack ? `; ${det.searchBack} found by searching back` : ''}${det.tWaves ? `; ${det.tWaves} T waves ignored` : ''}`),
      fact('Intervals used', `${h.nn.length} of ${h.rr.length}`, h.removed ? `${h.removed} set aside as irregular` : 'none set aside'),
      fact('Mean RR', `${f1(h.meanRR)} ms`, `heart rate ${f1(h.minHR)} to ${f1(h.maxHR)} bpm`),
      fact('SDNN', `${f1(h.sdnn)} ms`, 'standard deviation of the intervals'),
      fact('RMSSD', `${f1(h.rmssd)} ms`, 'root mean square of successive differences'),
      fact('SDSD', `${f1(h.sdsd)} ms`, 'standard deviation of successive differences'),
      fact('NN50 and pNN50', `${h.nn50} · ${f1(h.pnn50)} %`, `of ${h.nDiff} successive differences, those over 50 ms`),
      fact('Poincaré SD1 and SD2', `${f1(h.sd1)} · ${f1(h.sd2)} ms`, `SD1/SD2 = ${f1(h.sd1 / h.sd2, 3)}; SD1 follows beat-to-beat change, SD2 slower change`),
    ];
    q('.eg-facts').replaceChildren(...facts);
    const tk = h.tBeat.filter((_, i) => h.keep[i]);
    let fq = null as ReturnType<typeof hrvFreq> | null, ferr = '';
    try { fq = hrvFreq(tk, h.nn, q<HTMLInputElement>('.eg-detr').checked); } catch (e) { ferr = (e as Error).message; }
    const ffacts = fq ? [
      fact('LF power', `${sig(fq.lf, 4)} ms²`, `${BANDS.lf[0]} to ${BANDS.lf[1]} Hz, peak at ${sig(fq.peakLF, 3)} Hz; ${f1(fq.lfnu)} n.u.`),
      fact('HF power', `${sig(fq.hf, 4)} ms²`, `${BANDS.hf[0]} to ${BANDS.hf[1]} Hz, peak at ${sig(fq.peakHF, 3)} Hz (often the breathing rate); ${f1(fq.hfnu)} n.u.`),
      fact('LF/HF', f1(fq.lfhf, 2), 'n.u. = share of LF + HF'),
      fact('VLF power', `${sig(fq.vlf, 4)} ms²`, `${BANDS.vlf[0]} to ${BANDS.vlf[1]} Hz; needs long recordings`),
      fact('Total power', `${sig(fq.total, 4)} ms²`, `${BANDS.vlf[0]} to ${BANDS.hf[1]} Hz`),
    ] : [fact('Spectrum', 'not available', ferr)];
    q('.eg-ffacts').replaceChildren(...ffacts);
    // Tachogram.
    const tach = chartFigure({ w: 380, h: 200, xLabel: 'Time (s)', yLabel: 'RR interval (ms)', legend: h.removed ? 'below' : 'none', series: [
      { name: 'Used', x: tk, y: h.nn, mode: 'both', size: 2, width: 1 },
      ...(h.removed ? [{ name: 'Set aside', x: h.tBeat.filter((_, i) => !h.keep[i]), y: h.rr.filter((_, i) => !h.keep[i]), mode: 'points' as const, marker: 'cross' as const, size: 4 }] : []),
    ] }, `RR tachogram: ${h.nn.length} intervals, mean ${f1(h.meanRR)} ms`);
    paint(q<HTMLCanvasElement>('.eg-tach'), tach);
    let psdFig: Figure | null = null;
    if (fq) {
      const fx: number[] = [], py: number[] = [];
      for (let i = 0; i < fq.f.length; i++) if (fq.f[i] <= 0.5) { fx.push(fq.f[i]); py.push(fq.psd[i]); }
      psdFig = chartFigure({ w: 380, h: 200, xLabel: 'Frequency (Hz)', yLabel: 'Power (ms²/Hz)', legend: 'none', xMin: 0, xMax: 0.5, yMin: 0, series: [{ name: 'Lomb-Scargle', x: fx, y: py, mode: 'line', width: 1.4 }],
        marks: [{ kind: 'vline', at: 0.04, dash: [3, 3], label: 'LF' }, { kind: 'vline', at: 0.15, dash: [3, 3], label: 'HF' }, { kind: 'vline', at: 0.4, dash: [3, 3] }] }, `Lomb-Scargle spectrum of the RR intervals: LF ${sig(fq.lf, 4)} ms², HF ${sig(fq.hf, 4)} ms²`);
      paint(q<HTMLCanvasElement>('.eg-psd'), psdFig);
    }
    q('.eg-psd').hidden = !fq;
    const px = h.poincare.map((p) => p[0]), py = h.poincare.map((p) => p[1]);
    const lo = Math.min(...px, ...py), hi = Math.max(...px, ...py), pad = (hi - lo) * 0.05 || 10;
    const poin = chartFigure({ w: 380, h: 320, xLabel: 'RRₙ (ms)', yLabel: 'RRₙ₊₁ (ms)', legend: 'below', xMin: lo - pad, xMax: hi + pad, yMin: lo - pad, yMax: hi + pad, series: [
      { name: 'Successive intervals', x: px, y: py, mode: 'points', size: 2.5 },
      { name: 'Line of identity', x: [lo - pad, hi + pad], y: [lo - pad, hi + pad], mode: 'line', dash: [4, 3], width: 1 },
    ] }, `Poincaré plot, SD1 ${f1(h.sd1)} ms, SD2 ${f1(h.sd2)} ms`);
    paint(q<HTMLCanvasElement>('.eg-poin'), poin);
    figs = [figs[0], tach, psdFig as Figure, poin];
    beatRows = [['beat', 'R time (s)', 'RR before (ms)', 'heart rate (bpm)', 'used in HRV'], ...beats.map((b, i) => [i + 1, b.toFixed(4), i ? h.rr[i - 1].toFixed(1) : '', i ? (60000 / h.rr[i - 1]).toFixed(1) : '', i ? (h.keep[i - 1] ? 'yes' : 'no') : ''])];
    report = [
      { title: q('.eg-big').textContent!, text: ['For study and research, not for diagnosis.'], facts: factsOf(q('.eg-facts')) },
      { title: 'RR tachogram', figure: tach },
      { title: 'Spectrum', facts: factsOf(q('.eg-ffacts')), ...(psdFig ? { figure: psdFig } : {}) },
      { title: 'Poincaré plot', figure: poin },
    ];
    strip();
    report[0].figure = figs[0];
  }

  let timer = 0;
  const later = () => { clearTimeout(timer); timer = window.setTimeout(calc, 250); };
  root.querySelectorAll('.ax-card:first-child input, .ax-card:first-child select').forEach((i) => i.addEventListener('change', calc));
  q('.eg-data').addEventListener('input', later);
  ['.eg-col', '.eg-fs', '.eg-hp', '.eg-lp', '.eg-unit'].forEach((c) => q(c).addEventListener('input', later));
  q('.eg-win').addEventListener('change', strip);
  q('.eg-pos').addEventListener('input', strip);
  q('.eg-ex').addEventListener('click', () => { q<HTMLTextAreaElement>('.eg-data').value = example(); (q('.eg-fmt') as HTMLSelectElement).value = 'v'; (q('.eg-col') as HTMLInputElement).value = '1'; (q('.eg-fs') as HTMLInputElement).value = '250'; calc(); });
  q('.eg-csv').addEventListener('click', () => { if (beatRows.length) save(new Blob([csv(beatRows)], { type: 'text/csv' }), 'ecg-beats.csv', 'text/csv'); });
  document.addEventListener('fibub:theme', () => { if (state) calc(); });
  q<HTMLTextAreaElement>('.eg-data').value = example();
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'ECG and heart rate variability', subtitle: q('.eg-big').textContent ?? '', file: 'ecg-hrv', sections: report }));
</script>

<style is:global>
  .egv select, .egv input[type=text] { max-width: 100%; }
  .egv textarea { width: 100%; font-family: ui-monospace, monospace; font-size: 13px; }
  .egv input[type=range] { width: 100%; }
</style>
