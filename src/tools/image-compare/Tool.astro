---
// #T925 Image compare
---
<div class="tool-ui ic">
  <section class="panel ic-files">
    <label>Image A (before)<input data-k="a" type="file" accept="image/*" /></label>
    <label>Image B (after)<input data-k="b" type="file" accept="image/*" /></label>
  </section>
  <div class="ic-tabs" role="tablist" aria-label="How to compare">
    <button type="button" role="tab" data-m="slide" aria-selected="true">Slider</button>
    <button type="button" role="tab" data-m="overlay" aria-selected="false">Overlay</button>
    <button type="button" role="tab" data-m="diff" aria-selected="false">Difference</button>
  </div>
  <section class="panel">
    <label class="ic-ctl" data-for="slide">Slider position: A on the left, B on the right<input data-k="pos" type="range" min="0" max="100" value="50" /></label>
    <label class="ic-ctl" data-for="overlay" hidden>Opacity of B on top of A<input data-k="op" type="range" min="0" max="100" value="50" /></label>
    <label class="ic-ctl" data-for="diff" hidden>Threshold: how much a pixel must change to count (0 to 255)<input data-k="th" type="number" inputmode="numeric" min="0" max="254" value="16" /></label>
    <div class="ic-view"><canvas class="ic-canvas" aria-label="Comparison view"></canvas></div>
    <p class="ic-big" aria-live="polite"></p>
    <p class="ic-say" aria-live="polite"></p>
    <p class="ic-note" aria-live="polite"></p>
    <p class="ic-btns"><button type="button" class="btn secondary small ic-dl">Download this view (PNG)</button> <button type="button" class="btn secondary small ic-reset">Back to the example</button></p>
  </section>
  <p class="ic-fine">Your images are opened in this page only and never uploaded.</p>
</div>

<style is:inline>
  .ic { display: grid; gap: 14px; margin-bottom: 32px; }
  .ic .panel { padding: 16px; }
  .ic-files { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .ic label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .ic input[type="file"] { font: inherit; font-size: 14px; max-width: 100%; }
  .ic input[type="number"] { font: inherit; color: var(--ink); padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 8em; max-width: 100%; }
  .ic input[type="range"] { width: 100%; accent-color: var(--accent); }
  .ic-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .ic-tabs button { font: inherit; font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .ic-tabs button[aria-selected="true"] { border-color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .ic-view { margin-top: 12px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--surface); line-height: 0; }
  .ic-canvas { display: block; width: 100%; height: auto; touch-action: pan-y; cursor: ew-resize; }
  .ic-big { font-size: 22px; font-weight: 700; margin: 12px 0 4px; overflow-wrap: anywhere; }
  .ic-say, .ic-note { margin: 0; color: var(--muted); font-size: 14px; }
  .ic-note:empty, .ic-big:empty { display: none; }
  .ic-btns { margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ic-fine { color: var(--muted); font-size: 13px; margin: 0; }
</style>

<script>
  const MAX = 2000; // longest side used for comparing, to keep memory in check on phones
  const root = document.querySelector('.ic') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const cv = q<HTMLCanvasElement>('.ic-canvas'), ctx = cv.getContext('2d')!;
  const big = q('.ic-big'), say = q('.ic-say'), note = q('.ic-note');
  const pos = q<HTMLInputElement>('[data-k="pos"]'), op = q<HTMLInputElement>('[data-k="op"]'), th = q<HTMLInputElement>('[data-k="th"]');
  let mode = 'slide';
  let A: HTMLCanvasElement | null = null, B: HTMLCanvasElement | null = null;
  let srcA: CanvasImageSource | null = null, srcB: CanvasImageSource | null = null;
  let sizeA = [0, 0], sizeB = [0, 0];
  let diffImg: ImageData | null = null;

  const canvas = (w: number, h: number) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
  // The example: a small scene, and the same scene with one 10 x 10 square changed.
  const scene = (changed: boolean) => {
    const c = canvas(200, 150), g = c.getContext('2d')!;
    g.fillStyle = '#dfe8f0'; g.fillRect(0, 0, 200, 150);
    g.fillStyle = '#5a7d4a'; g.fillRect(0, 100, 200, 50);
    g.fillStyle = '#8a5a3c'; g.fillRect(40, 60, 50, 40);
    g.fillStyle = '#b03a2e'; g.beginPath(); g.moveTo(35, 60); g.lineTo(65, 35); g.lineTo(95, 60); g.closePath(); g.fill();
    g.fillStyle = '#f2c14e'; g.fillRect(150, 20, 20, 20);
    if (changed) { g.fillStyle = '#1f3b73'; g.fillRect(120, 110, 10, 10); }
    return c;
  };
  // Both images are drawn at A's size (at most MAX px on the longest side); B is stretched to fit.
  const prepare = () => {
    if (!srcA || !srcB) return;
    const k = Math.min(1, MAX / Math.max(sizeA[0], sizeA[1]));
    const w = Math.max(1, Math.round(sizeA[0] * k)), h = Math.max(1, Math.round(sizeA[1] * k));
    A = canvas(w, h); A.getContext('2d')!.drawImage(srcA, 0, 0, w, h);
    B = canvas(w, h); B.getContext('2d')!.drawImage(srcB, 0, 0, w, h);
    cv.width = w; cv.height = h;
    const n: string[] = [];
    if (k < 1) n.push(`Compared at ${w} × ${h} px (scaled down from ${sizeA[0]} × ${sizeA[1]}).`);
    if (sizeA[0] !== sizeB[0] || sizeA[1] !== sizeB[1]) {
      n.push(`The images are different sizes: B (${sizeB[0]} × ${sizeB[1]}) is fitted to A (${sizeA[0]} × ${sizeA[1]}).`);
      if (Math.abs(sizeA[0] / sizeA[1] - sizeB[0] / sizeB[1]) > 0.01) n.push('Their shapes differ too, so B is stretched and the difference view will show more change than there really is.');
    }
    note.textContent = n.join(' ');
    diffImg = null; render();
  };
  const computeDiff = () => {
    const w = A!.width, h = A!.height, t = Math.max(0, Math.min(254, Number(th.value) || 0));
    const a = A!.getContext('2d')!.getImageData(0, 0, w, h).data, b = B!.getContext('2d')!.getImageData(0, 0, w, h).data;
    const out = new ImageData(w, h), o = out.data; let n = 0;
    for (let i = 0; i < a.length; i += 4) {
      const d = Math.max(Math.abs(a[i] - b[i]), Math.abs(a[i + 1] - b[i + 1]), Math.abs(a[i + 2] - b[i + 2]), Math.abs(a[i + 3] - b[i + 3]));
      if (d > t) { n++; o[i] = 230; o[i + 1] = 0; o[i + 2] = 0; o[i + 3] = 255; }
      else { const y = Math.round((a[i] * 0.299 + a[i + 1] * 0.587 + a[i + 2] * 0.114) * 0.35 + 166); o[i] = o[i + 1] = o[i + 2] = y; o[i + 3] = 255; }
    }
    diffImg = out; return { n, total: w * h, t };
  };
  let stats = { n: 0, total: 0, t: 16 };
  const render = () => {
    if (!A || !B) return;
    const w = cv.width, h = cv.height;
    ctx.clearRect(0, 0, w, h);
    if (mode === 'slide') {
      const x = Math.round((Number(pos.value) / 100) * w);
      ctx.drawImage(B, 0, 0);
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, x, h); ctx.clip(); ctx.drawImage(A, 0, 0); ctx.restore();
      ctx.fillStyle = '#fff'; ctx.fillRect(Math.max(0, x - Math.max(1, w / 400)), 0, Math.max(2, w / 200), h);
      big.textContent = ''; say.textContent = `A is on the left of the line, B on the right (${pos.value}%). Drag across the picture or use the slider.`;
    } else if (mode === 'overlay') {
      ctx.drawImage(A, 0, 0); ctx.globalAlpha = Number(op.value) / 100; ctx.drawImage(B, 0, 0); ctx.globalAlpha = 1;
      big.textContent = ''; say.textContent = `B is drawn on top of A at ${op.value}% opacity.`;
    } else {
      if (!diffImg) stats = computeDiff();
      ctx.putImageData(diffImg!, 0, 0);
      const p = (stats.n / stats.total) * 100;
      big.textContent = `${p < 0.01 && p > 0 ? p.toPrecision(2) : p.toFixed(p < 10 ? 3 : 1)}% of pixels changed`;
      say.textContent = `${stats.n.toLocaleString('en-US')} of ${stats.total.toLocaleString('en-US')} pixels differ by more than ${stats.t} (out of 255) in red, green, blue or transparency. They are shown in red; the rest is faded grey.`;
    }
  };
  const show = (m: string) => {
    mode = m;
    root.querySelectorAll('.ic-tabs button').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.m === m)));
    root.querySelectorAll<HTMLElement>('.ic-ctl').forEach((l) => { l.hidden = l.dataset.for !== m; });
    cv.style.cursor = m === 'slide' ? 'ew-resize' : 'default';
    render();
  };
  const open = async (f: File) => { const b = await createImageBitmap(f); return { src: b as CanvasImageSource, size: [b.width, b.height] }; };
  const onFile = (which: 'a' | 'b') => async (e: Event) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    try {
      const r = await open(f);
      if (which === 'a') { srcA = r.src; sizeA = r.size; } else { srcB = r.src; sizeB = r.size; }
      prepare();
      if (!(q<HTMLInputElement>('[data-k="a"]').files?.length && q<HTMLInputElement>('[data-k="b"]').files?.length)) say.textContent = `Now choose image ${which === 'a' ? 'B' : 'A'}. Until then it is compared with the example.`;
    } catch { say.textContent = 'That file could not be opened as an image. Try a JPG, PNG or WebP.'; }
  };
  const example = () => {
    const a = scene(false), b = scene(true);
    srcA = a; srcB = b; sizeA = [a.width, a.height]; sizeB = [b.width, b.height]; prepare();
  };
  q('[data-k="a"]').addEventListener('change', onFile('a'));
  q('[data-k="b"]').addEventListener('change', onFile('b'));
  pos.addEventListener('input', render); op.addEventListener('input', render);
  th.addEventListener('input', () => { diffImg = null; render(); });
  root.querySelectorAll('.ic-tabs button').forEach((b) => b.addEventListener('click', () => show((b as HTMLElement).dataset.m!)));
  let drag = false;
  const at = (e: PointerEvent) => { const r = cv.getBoundingClientRect(); pos.value = String(Math.round(Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)) * 100)); render(); };
  cv.addEventListener('pointerdown', (e) => { if (mode !== 'slide') return; drag = true; cv.setPointerCapture(e.pointerId); at(e); });
  cv.addEventListener('pointermove', (e) => { if (drag) at(e); });
  cv.addEventListener('pointerup', () => { drag = false; });
  cv.addEventListener('pointercancel', () => { drag = false; });
  q('.ic-dl').addEventListener('click', () => {
    cv.toBlob((b) => { if (!b) return; const u = URL.createObjectURL(b); const a = document.createElement('a'); a.href = u; a.download = `compare-${mode}.png`; document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 4000); }, 'image/png');
  });
  q('.ic-reset').addEventListener('click', () => { q<HTMLInputElement>('[data-k="a"]').value = ''; q<HTMLInputElement>('[data-k="b"]').value = ''; pos.value = '50'; op.value = '50'; th.value = '16'; example(); show('slide'); });
  example(); show('slide');
</script>
