---
// The PDF compressor UI. All work happens in compress.ts, in the browser.
---
<div class="panel pdfc" data-state="empty">
  <label class="drop" id="pdfc-drop">
    <input id="pdfc-file" type="file" accept="application/pdf,.pdf" class="visually-hidden" />
    <strong>Choose a PDF</strong>
    <span>or drop it here · stays on your device</span>
  </label>

  <div class="file" id="pdfc-file-row" hidden>
    <span id="pdfc-name"></span> <span class="muted" id="pdfc-size"></span>
    <button type="button" class="link" id="pdfc-clear">Choose another</button>
  </div>

  <fieldset class="levels" id="pdfc-levels">
    <legend>How much to compress</legend>
    <label><input type="radio" name="level" value="lossless" /> <b>Light</b><span>Keeps text, links and forms exactly as they are. Smaller saving.</span></label>
    <label><input type="radio" name="level" value="balanced" checked /> <b>Recommended</b><span>Best for scans and photos. Pages become images at 150 DPI.</span></label>
    <label><input type="radio" name="level" value="smallest" /> <b>Smallest</b><span>For strict upload limits. Pages become images at 100 DPI.</span></label>
  </fieldset>
  <p class="note warn" id="pdfc-image-note">Recommended and Smallest turn each page into an image: text can no longer be selected or searched, and links and fill-in fields are removed. Use Light to keep them. If image compression would not make the file smaller, you get the Light result instead.</p>

  <button class="btn" id="pdfc-go" type="button" disabled>Compress PDF</button>
  <p class="progress" id="pdfc-progress" role="status" aria-live="polite"></p>

  <div id="pdfc-result" hidden>
    <p class="note" id="pdfc-summary"></p>
    <a class="btn" id="pdfc-download" download>Download compressed PDF</a>
  </div>
  <p class="note bad" id="pdfc-error" role="alert" hidden></p>
</div>

<style>
  .pdfc { display: grid; gap: 16px; margin-bottom: 32px; }
  .drop { display: grid; place-items: center; gap: 4px; text-align: center; padding: 36px 16px; border: 2px dashed var(--line); border-radius: var(--radius); cursor: pointer; background: var(--bg); }
  .drop strong { font-size: 18px; color: var(--accent); }
  .drop span, .muted { color: var(--muted); font-size: 14px; }
  .drop.over, .drop:focus-within { border-color: var(--accent); background: var(--accent-soft); }
  .pdfc[data-state="ready"] .drop, .pdfc[data-state="working"] .drop, .pdfc[data-state="done"] .drop { display: none; }
  .file { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; font-weight: 600; word-break: break-all; }
  .link { background: none; border: 0; color: var(--accent); text-decoration: underline; cursor: pointer; font: inherit; font-size: 14px; padding: 0; }
  .levels { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .levels legend { font-weight: 600; margin-bottom: 8px; }
  .levels label { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: baseline; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
  .levels label:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .levels span { grid-column: 2; color: var(--muted); font-size: 14px; }
  .progress { margin: 0; color: var(--muted); min-height: 1.6em; }
  #pdfc-result { display: grid; gap: 12px; justify-items: start; }
  #pdfc-result[hidden], #pdfc-error[hidden], .file[hidden], .note[hidden] { display: none; }
</style>

<script>
  import { formatBytes } from './format';
  import type { Level } from './compress';
  // The PDF libraries (about 1 MB) load only when someone presses Compress.
  const engine = () => import('./compress');
  // Fetch them in the background once the page is idle, so the tool also works offline after that.
  const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1500));
  idle(() => engine().then((m) => m.warmUp()).catch(() => {}));

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector<HTMLElement>('.pdfc')!;
  const input = $<HTMLInputElement>('pdfc-file');
  const drop = $('pdfc-drop');
  const go = $<HTMLButtonElement>('pdfc-go');
  const progress = $('pdfc-progress');
  const result = $('pdfc-result');
  const summary = $('pdfc-summary');
  const download = $<HTMLAnchorElement>('pdfc-download');
  const error = $('pdfc-error');
  const imageNote = $('pdfc-image-note');
  let file: File | null = null;
  let url: string | null = null;

  const level = () => (document.querySelector<HTMLInputElement>('input[name=level]:checked')!.value as Level);
  const setState = (s: string) => (root.dataset.state = s);

  function reset() {
    if (url) URL.revokeObjectURL(url);
    url = null;
    result.hidden = true;
    error.hidden = true;
    progress.textContent = '';
  }

  function pick(f: File | undefined) {
    reset();
    if (!f) return;
    if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
      error.textContent = 'That file is not a PDF. Choose a file ending in .pdf.';
      error.hidden = false;
      return;
    }
    file = f;
    $('pdfc-name').textContent = f.name;
    $('pdfc-size').textContent = formatBytes(f.size);
    $('pdfc-file-row').hidden = false;
    go.disabled = false;
    setState('ready');
  }

  input.addEventListener('change', () => pick(input.files?.[0]));
  for (const ev of ['dragenter', 'dragover']) drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); });
  for (const ev of ['dragleave', 'drop']) drop.addEventListener(ev, () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => { e.preventDefault(); pick((e as DragEvent).dataTransfer?.files?.[0]); });
  $('pdfc-clear').addEventListener('click', () => {
    reset();
    file = null;
    input.value = '';
    $('pdfc-file-row').hidden = true;
    go.disabled = true;
    setState('empty');
  });
  document.querySelectorAll<HTMLInputElement>('input[name=level]').forEach((r) =>
    r.addEventListener('change', () => { imageNote.hidden = level() === 'lossless'; reset(); }),
  );

  go.addEventListener('click', async () => {
    if (!file) return;
    reset();
    go.disabled = true;
    setState('working');
    progress.textContent = 'Reading the PDF…';
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const { compress } = await engine();
      const res = await compress(bytes, level(), (d, t) => (progress.textContent = `Compressing page ${d} of ${t}…`));
      const before = file.size, after = res.bytes.length;
      const saved = Math.round((1 - after / before) * 100);
      url = URL.createObjectURL(new Blob([res.bytes], { type: 'application/pdf' }));
      download.href = url;
      download.download = file.name.replace(/\.pdf$/i, '') + '-compressed.pdf';
      if (res.method === 'original') {
        summary.className = 'note warn';
        summary.textContent = `This PDF is already well compressed: none of the methods made it smaller than ${formatBytes(before)}. You can download your original file unchanged.`;
        download.textContent = 'Download original PDF';
      } else {
        summary.className = 'note good';
        const how = res.method === 'lossless'
          ? (level() === 'lossless' ? 'Text and links are unchanged.' : 'Image compression would not have helped this file, so text and links were kept as they are.')
          : 'Pages were converted to images.';
        summary.textContent = `${formatBytes(before)} → ${formatBytes(after)} (${saved}% smaller, ${res.pages} page${res.pages === 1 ? '' : 's'}). ${how}`;
        download.textContent = 'Download compressed PDF';
      }
      result.hidden = false;
      progress.textContent = '';
      setState('done');
    } catch (e) {
      console.error(e);
      progress.textContent = '';
      error.textContent = (e as Error)?.name === 'EncryptedPdfError'
        ? 'This PDF is password-protected. Open it in your PDF reader, save a copy without a password, then try again.'
        : 'Sorry, this PDF could not be read. It may be damaged or use a feature this tool does not support.';
      error.hidden = false;
      setState('ready');
    } finally {
      go.disabled = false;
    }
  });
</script>
