---
// Hyperbolic geometry drawer: geodesics, distances, circles and triangles in the Poincaré disk, and {p,q} tilings.
import '../../styles/astro.css';
---
<div class="ax hd">
  <div class="ax-card">
    <div class="ax-seg hd-mode" role="group" aria-label="What to draw">
      <button type="button" data-m="draw" aria-pressed="true">Draw</button>
      <button type="button" data-m="tile" aria-pressed="false">Tiling {"{p, q}"}</button>
    </div>
    <div class="hd-draw">
      <h3 class="hd-h">Points</h3>
      <p class="ax-help" style="margin:0 0 8px">Tap inside the disk to add a point, drag a point to move it, or type coordinates (inside the unit circle).</p>
      <div class="ax-scroll"><table class="hd-pts"></table></div>
      <h3 class="hd-h">Shapes</h3>
      <div class="hd-shapes"></div>
      <div class="ax-row" style="margin-top:8px">
        <button type="button" class="btn secondary small hd-add">Add a shape</button>
        <button type="button" class="btn secondary small hd-clear">Clear all</button>
      </div>
    </div>
    <div class="hd-tile" hidden>
      <div class="ax-grid" style="margin-top:12px">
        <label>p (sides of each tile) <select class="hd-p"></select></label>
        <label>q (tiles at each corner) <select class="hd-q"></select></label>
        <label class="ax-check"><input type="checkbox" class="hd-shade" checked /> Shade every other ring</label>
      </div>
      <p class="ax-help">A {"{p, q}"} tiling is hyperbolic when (p − 2)(q − 2) is more than 4. Drag the disk to walk around the tiling.</p>
    </div>
    <p class="ax-err hd-err" hidden></p>
  </div>

  <div class="ax-card">
    <canvas class="hd-cv" role="img" aria-label="Poincaré disk"></canvas>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small hd-reset" hidden>Back to the centre</button></div>
    <div class="dl">
      <span class="dl-l">Download</span>
      <button type="button" class="btn secondary hd-png">PNG</button>
      <button type="button" class="btn secondary hd-svg">SVG</button>
      <button type="button" class="btn secondary hd-csv">CSV</button>
    </div>
  </div>

  <div class="ax-card">
    <h2 class="hd-mh">Measurements</h2>
    <dl class="ax-facts hd-facts"></dl>
    <div class="ax-scroll"><table class="hd-mt"></table></div>
    <p class="ax-help hd-note"></p>
  </div>
</div>

<style is:global>
  .hd-h { font-size: 15px; margin: 14px 0 6px; }
  .hd-pts input { width: 6.5em !important; padding: 6px 8px !important; }
  .hd-pts td { vertical-align: middle; }
  .hd-x { border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 8px; width: 36px; height: 34px; font-size: 17px; cursor: pointer; }
  .hd-shapes { display: grid; gap: 8px; }
  .hd-shape { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; font-size: 14px; }
  .hd-shape select, .hd-shape input { width: auto !important; padding: 6px 8px !important; }
  .hd-shape input { width: 5em !important; }
  .hd-sw { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .hd-cv { display: block; width: 100%; max-width: 560px; margin: 0 auto; aspect-ratio: 1; height: auto; touch-action: none; cursor: crosshair; }
</style>

<script>
  import { dist, segment, line, idealPoints, midpoint, triangle, circle, mobius, abs, hyperbolicPQ, tileMeasures, centralTile, tiling, type Z, type Tile } from '../../lib/sci/hyperbolic';
  import { canvasPainter, svgPainter, OKABE_ITO, type Painter } from '../../lib/sci/plot';
  import { sig, num } from '../../lib/sci/num';
  import { pagePalette, LIGHT, save, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.hd')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const cv = q<HTMLCanvasElement>('.hd-cv');
  const fmt = (v: number, n = 6) => { const t = sig(v, n); return /×/.test(t) ? t : t.replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, ''); };
  const deg = (r: number) => `${fmt((r * 180) / Math.PI, 5)}°`;
  const NAMES = 'ABCDEFGHIJKL'.split(''), MAXR = 0.995;
  type Pt = { name: string; z: Z };
  type Shape = { kind: 'segment' | 'line' | 'triangle' | 'circle'; a: string; b: string; c: string; r: number };
  let mode: 'draw' | 'tile' = 'draw';
  let pts: Pt[] = [], shapes: Shape[] = [];
  let tiles: Tile[] = [], S = 500;

  function example() {
    pts = [{ name: 'A', z: [-0.5, -0.2] }, { name: 'B', z: [0.6, 0.1] }, { name: 'C', z: [0.1, 0.6] }, { name: 'D', z: [-0.6, 0.4] }];
    shapes = [{ kind: 'triangle', a: 'A', b: 'B', c: 'C', r: 1 }, { kind: 'circle', a: 'C', b: 'A', c: 'B', r: 1 }, { kind: 'line', a: 'A', b: 'D', c: 'B', r: 1 }];
  }
  const colors = (pal: Palette) => (pal.red ? ['#a30000', '#7a0000', '#c00000', '#5a0000'] : pal.bg === '#ffffff' ? OKABE_ITO : ['#56B4E9', '#E69F00', '#5fd3a8', '#e59ac4', '#f0e442', '#9ecae1']);
  const ptOf = (n: string) => pts.find((p) => p.name === n);
  const err = (m: string) => { const e = q('.hd-err'); e.textContent = m; e.hidden = !m; };

  // ---------- Lists ----------
  function renderPoints() {
    const t = q<HTMLTableElement>('.hd-pts');
    t.innerHTML = '<thead><tr><th>Point</th><th>x</th><th>y</th><th></th></tr></thead><tbody></tbody>';
    t.tBodies[0].replaceChildren(...pts.map((p, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = '<td><b></b></td><td><input class="hd-px" inputmode="decimal" /></td><td><input class="hd-py" inputmode="decimal" /></td><td><button type="button" class="hd-x hd-pdel">×</button></td>';
      tr.querySelector('b')!.textContent = p.name;
      const [x, y] = tr.querySelectorAll('input'); x.value = String(+p.z[0].toFixed(4)); y.value = String(+p.z[1].toFixed(4));
      x.dataset.i = y.dataset.i = String(i); x.setAttribute('aria-label', `${p.name} x`); y.setAttribute('aria-label', `${p.name} y`);
      const del = tr.querySelector('button')!; del.dataset.i = String(i); del.setAttribute('aria-label', `Remove point ${p.name}`);
      return tr;
    }));
  }
  function syncPointInputs() {
    root.querySelectorAll<HTMLTableRowElement>('.hd-pts tbody tr').forEach((tr, i) => {
      const [x, y] = tr.querySelectorAll('input'); if (!pts[i]) return;
      if (document.activeElement !== x) x.value = String(+pts[i].z[0].toFixed(4)); if (document.activeElement !== y) y.value = String(+pts[i].z[1].toFixed(4));
    });
  }
  function renderShapes() {
    const col = colors(pagePalette()), opts = pts.map((p) => `<option>${p.name}</option>`).join('');
    q('.hd-shapes').replaceChildren(...shapes.map((s, i) => {
      const d = document.createElement('div'); d.className = 'hd-shape'; d.dataset.i = String(i);
      d.innerHTML = `<i class="hd-sw"></i><select class="hd-k" aria-label="Shape ${i + 1}"><option value="segment">Segment</option><option value="line">Line</option><option value="triangle">Triangle</option><option value="circle">Circle</option></select>`
        + `<span class="hd-l1"></span><select class="hd-a" aria-label="First point">${opts}</select><span class="hd-l2"></span><select class="hd-b" aria-label="Second point">${opts}</select>`
        + `<select class="hd-c" aria-label="Third point">${opts}</select><input class="hd-r" inputmode="decimal" aria-label="Hyperbolic radius" /><button type="button" class="hd-x hd-sdel" aria-label="Remove shape ${i + 1}">×</button>`;
      (d.querySelector('.hd-sw') as HTMLElement).style.background = col[i % col.length];
      const g = <T extends HTMLElement>(c: string) => d.querySelector(c) as T;
      g<HTMLSelectElement>('.hd-k').value = s.kind; g<HTMLSelectElement>('.hd-a').value = s.a; g<HTMLSelectElement>('.hd-b').value = s.b; g<HTMLSelectElement>('.hd-c').value = s.c; g<HTMLInputElement>('.hd-r').value = String(s.r);
      const circ = s.kind === 'circle';
      g('.hd-l1').textContent = circ ? 'centre' : s.kind === 'line' ? 'through' : s.kind === 'triangle' ? '' : 'from';
      g('.hd-l2').textContent = circ ? 'radius' : s.kind === 'segment' ? 'to' : s.kind === 'line' ? 'and' : '';
      g('.hd-b').hidden = circ; g('.hd-c').hidden = s.kind !== 'triangle'; g('.hd-r').hidden = !circ;
      return d;
    }));
    q<HTMLButtonElement>('.hd-add').disabled = pts.length < 2;
  }

  // ---------- Measurements ----------
  type Row = [string, string, string];
  function measures(): { rows: Row[]; bad: string } {
    const rows: Row[] = []; let bad = '';
    shapes.forEach((s, i) => {
      const a = ptOf(s.a), b = ptOf(s.b), c = ptOf(s.c), name = `${i + 1}. `;
      if (!a || (s.kind !== 'circle' && !b) || (s.kind === 'triangle' && !c)) { bad = `Shape ${i + 1} uses a point that no longer exists.`; return; }
      if (s.kind === 'segment' || s.kind === 'line') {
        if (dist(a.z, b!.z) < 1e-12) { bad = `Shape ${i + 1} needs two different points.`; return; }
        const lbl = `${name}${s.kind === 'segment' ? 'Segment' : 'Line'} ${a.name}${b!.name}`;
        rows.push([lbl, 'Hyperbolic length', fmt(dist(a.z, b!.z))]);
        if (s.kind === 'segment') {
          rows.push([lbl, 'Euclidean length on the picture', fmt(Math.hypot(a.z[0] - b!.z[0], a.z[1] - b!.z[1]))]);
          const m = midpoint(a.z, b!.z); rows.push([lbl, 'Midpoint', `(${fmt(m[0], 5)}, ${fmt(m[1], 5)})`]);
        } else {
          const [p, r] = idealPoints(a.z, b!.z), ang = (z: Z) => deg((Math.atan2(z[1], z[0]) + 2 * Math.PI) % (2 * Math.PI));
          rows.push([lbl, 'Meets the rim at angles', `${ang(p)} and ${ang(r)}`]);
        }
      } else if (s.kind === 'triangle') {
        const t = triangle(a.z, b!.z, c!.z), lbl = `${name}Triangle ${a.name}${b!.name}${c!.name}`;
        if (!(t.area > 1e-12) || Math.min(...t.sides) < 1e-12) { bad = `Shape ${i + 1} needs three points that are not on one line.`; return; }
        rows.push([lbl, `Sides ${b!.name}${c!.name}, ${c!.name}${a!.name}, ${a.name}${b!.name}`, t.sides.map((v) => fmt(v)).join(', ')]);
        rows.push([lbl, `Angles at ${a.name}, ${b!.name}, ${c!.name}`, t.angles.map(deg).join(', ')]);
        rows.push([lbl, 'Angle sum', `${deg(t.sum)} (less than 180°)`]);
        rows.push([lbl, 'Area = π − angle sum', fmt(t.area)]);
      } else {
        if (!(s.r > 0 && s.r <= 20)) { bad = `Shape ${i + 1}: give a radius above 0 and up to 20.`; return; }
        const k = circle(a.z, s.r), lbl = `${name}Circle at ${a.name}, radius ${fmt(s.r)}`;
        rows.push([lbl, 'Circumference = 2π sinh r', fmt(k.circumference)]);
        rows.push([lbl, 'Area = 4π sinh²(r/2)', fmt(k.area)]);
        rows.push([lbl, 'Drawn as a Euclidean circle', `centre (${fmt(k.centre[0], 5)}, ${fmt(k.centre[1], 5)}), radius ${fmt(k.r, 5)}`]);
      }
    });
    return { rows, bad };
  }
  function showMeasures() {
    const t = q<HTMLTableElement>('.hd-mt'), f = q('.hd-facts');
    let rows: Row[] = [], facts: [string, string][] = [];
    if (mode === 'draw') {
      const m = measures(); rows = m.rows; err(m.bad);
      q('.hd-mh').textContent = 'Measurements';
      q('.hd-note').textContent = 'Lengths and areas are hyperbolic (curvature −1). Near the rim, a short line on the picture is a long way in hyperbolic terms, which is why the Euclidean length is shown too.';
    } else {
      const p = Number(q<HTMLSelectElement>('.hd-p').value), qq = Number(q<HTMLSelectElement>('.hd-q').value);
      q('.hd-mh').textContent = `The tiling {${p}, ${qq}}`;
      if (!hyperbolicPQ(p, qq)) {
        err(`{${p}, ${qq}} is not hyperbolic: (p − 2)(q − 2) = ${(p - 2) * (qq - 2)}, which is ${(p - 2) * (qq - 2) === 4 ? 'exactly 4, so it tiles the flat plane' : 'less than 4, so it wraps round a sphere (a regular solid)'}. Pick values with (p − 2)(q − 2) above 4.`);
      } else {
        err('');
        const m = tileMeasures(p, qq);
        facts = [['Corner angle 2π/q', deg(m.angle)], ['Side length', fmt(m.side)], ['Centre to corner', fmt(m.circumradius)], ['Centre to side', fmt(m.inradius)],
          ['Area of each tile', `${fmt(m.area)} = π × ${fmt(m.area / Math.PI)}`], ['Tiles drawn', tiles.length.toLocaleString('en')]];
      }
      q('.hd-note').textContent = 'Every tile is the same size in hyperbolic terms: they only look smaller towards the rim. The area comes from Gauss–Bonnet: (p − 2)π minus the sum of the p corner angles.';
    }
    f.replaceChildren(...facts.map(([k, v]) => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; return d; }));
    if (!rows.length) { t.replaceChildren(); return; }
    t.innerHTML = '<thead><tr><th>Shape</th><th>Measure</th><th class="r">Value</th></tr></thead><tbody></tbody>';
    t.tBodies[0].replaceChildren(...rows.map((r) => { const tr = document.createElement('tr'); tr.innerHTML = '<td></td><td></td><td class="r"></td>'; r.forEach((v, k) => (tr.cells[k].textContent = v)); return tr; }));
    lastRows = rows;
  }
  let lastRows: Row[] = [];

  // ---------- Drawing ----------
  const X = (z: Z, s: number): [number, number] => [s / 2 + (z[0] * (s / 2 - 6)), s / 2 - (z[1] * (s / 2 - 6))];
  function draw(P: Painter, s: number, pal: Palette) {
    const col = colors(pal), R = s / 2 - 6, mid = s / 2;
    P.poly([[0, 0], [s, 0], [s, s], [0, s]], pal.bg, null);
    P.circle(mid, mid, R, pal.red ? '#0a0000' : pal.bg === '#ffffff' ? '#f7f7f7' : '#141414', null);
    if (mode === 'tile') {
      const shade = q<HTMLInputElement>('.hd-shade').checked, fill = pal.red ? '#2a0000' : pal.bg === '#ffffff' ? '#cfe0f3' : '#1f3a5a';
      for (const t of tiles) {
        const ring: [number, number][] = [];
        for (let i = 0; i < t.v.length; i++) {
          const u = t.v[i], w = t.v[(i + 1) % t.v.length], e = Math.hypot(u[0] - w[0], u[1] - w[1]) * R;
          const seg = segment(u, w, Math.max(1, Math.min(24, Math.ceil(e / 6))));
          for (const z of seg) ring.push(X(z, s));
        }
        P.poly(ring, shade && t.gen % 2 === 0 ? fill : null, pal.ink, t.gen === 0 ? 1.6 : Math.max(0.3, Math.min(1, 1.2 * (1 - abs(t.c)) * 3)));
      }
    } else {
      shapes.forEach((sh, i) => {
        const c = col[i % col.length], a = ptOf(sh.a), b = ptOf(sh.b), cc = ptOf(sh.c);
        if (!a) return;
        if (sh.kind === 'circle') { if (sh.r > 0 && sh.r <= 20) { const k = circle(a.z, sh.r), [x, y] = X(k.centre, s); P.circle(x, y, k.r * R, null, c, 2); } return; }
        if (!b || dist(a.z, b.z) < 1e-12) return;
        if (sh.kind === 'segment') P.line(segment(a.z, b.z, 80).map((z) => X(z, s)), c, 2.4);
        if (sh.kind === 'line') P.line(line(a.z, b.z, 240).map((z) => X(z, s)), c, 2.2);
        if (sh.kind === 'triangle' && cc) {
          const ring = [...segment(a.z, b.z, 60), ...segment(b.z, cc.z, 60), ...segment(cc.z, a.z, 60)].map((z) => X(z, s));
          P.poly(ring, null, c, 2.4);
        }
      });
      for (const p of pts) {
        const [x, y] = X(p.z, s);
        P.circle(x, y, 5, pal.ink, pal.bg, 1.5);
        P.text(x + 8, y - 6, p.name, 14, pal.ink, 'start', 'bottom', 0, true);
      }
    }
    P.circle(mid, mid, R, null, pal.ink, 1.5);
  }
  function paint() {
    S = Math.max(240, Math.round(cv.clientWidth || 500));
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    cv.width = Math.round(S * dpr); cv.height = Math.round(S * dpr);
    const ctx = cv.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw(canvasPainter(ctx), S, pagePalette());
  }
  function buildTiles(seed?: Tile) {
    const p = Number(q<HTMLSelectElement>('.hd-p').value), qq = Number(q<HTMLSelectElement>('.hd-q').value);
    if (!hyperbolicPQ(p, qq)) { tiles = []; return; }
    tiles = tiling(seed ?? centralTile(p, qq, Math.PI / 2), Math.max(0.002, 2.5 / S), 5000);
  }
  function update() {
    if (mode === 'draw') { renderShapes(); } else buildTiles();
    showMeasures(); paint();
  }

  // ---------- Pointer ----------
  const toZ = (e: PointerEvent): Z => { const r = cv.getBoundingClientRect(), s = r.width, R = s / 2 - (6 * s) / S; return [(e.clientX - r.left - s / 2) / R, -(e.clientY - r.top - s / 2) / R]; };
  const clampZ = (z: Z): Z => { const r = abs(z); return r > MAXR ? [(z[0] * MAXR) / r, (z[1] * MAXR) / r] : z; };
  let dragPt = -1, dragFrom: Z | null = null, moved = false;
  cv.addEventListener('pointerdown', (e) => {
    const z = toZ(e); moved = false;
    if (mode === 'draw') {
      const r = cv.getBoundingClientRect(), k = (r.width / 2) * 0.97;
      let best = -1, bd = 16 / k;
      pts.forEach((p, i) => { const d = Math.hypot(p.z[0] - z[0], p.z[1] - z[1]); if (d < bd) { bd = d; best = i; } });
      dragPt = best; dragFrom = z;
    } else if (abs(z) < 1) dragFrom = z;
    cv.setPointerCapture(e.pointerId);
  });
  cv.addEventListener('pointermove', (e) => {
    if (!dragFrom) return;
    const z = toZ(e);
    if (!moved && Math.hypot(z[0] - dragFrom[0], z[1] - dragFrom[1]) < 0.01) return;
    moved = true;
    if (mode === 'draw') { if (dragPt >= 0) { pts[dragPt].z = clampZ(z); syncPointInputs(); showMeasures(); paint(); } }
    else {
      const zz = clampZ(z), from = clampZ(dragFrom), back: Z = [-from[0], -from[1]];
      tiles = tiles.map((t) => ({ v: t.v.map((v) => mobius(zz, mobius(back, v))), c: mobius(zz, mobius(back, t.c)), gen: t.gen }));
      dragFrom = zz; paint();
    }
  });
  cv.addEventListener('pointerup', (e) => {
    const z = toZ(e);
    if (mode === 'draw' && !moved && dragPt < 0 && abs(z) < MAXR && pts.length < NAMES.length) {
      const name = NAMES.find((n) => !ptOf(n))!; pts.push({ name, z }); pts.sort((a, b) => a.name.localeCompare(b.name)); renderPoints(); update();
    } else if (mode === 'tile' && moved && tiles.length) {
      let best = tiles[0]; for (const t of tiles) if (abs(t.c) < abs(best.c)) best = t;
      buildTiles({ ...best, gen: 0 }); q('.hd-reset').hidden = false; showMeasures(); paint();
    }
    dragPt = -1; dragFrom = null;
  });
  cv.addEventListener('pointercancel', () => { dragPt = -1; dragFrom = null; });

  // ---------- Downloads ----------
  const file = () => (mode === 'draw' ? 'hyperbolic-drawing' : `tiling-${q<HTMLSelectElement>('.hd-p').value}-${q<HTMLSelectElement>('.hd-q').value}`);
  q('.hd-svg').addEventListener('click', () => { const P = svgPainter(S, S); draw(P, S, LIGHT); save(new Blob([P.toString()], { type: 'image/svg+xml' }), `${file()}.svg`, 'image/svg+xml'); });
  q('.hd-png').addEventListener('click', () => { const c = document.createElement('canvas'), k = 2; c.width = c.height = S * k; const ctx = c.getContext('2d')!; ctx.scale(k, k); draw(canvasPainter(ctx), S, LIGHT); c.toBlob((b) => b && save(b, `${file()}.png`, 'image/png'), 'image/png'); });
  q('.hd-csv').addEventListener('click', () => {
    const cell = (s: string) => (/[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s), g = (v: number) => String(+v.toPrecision(12));
    let lines: string[];
    if (mode === 'draw') lines = ['point,x,y', ...pts.map((p) => [p.name, g(p.z[0]), g(p.z[1])].join(',')), '', 'shape,measure,value', ...lastRows.map((r) => r.map(cell).join(','))];
    else lines = ['tile,ring,vertex,x,y', ...tiles.flatMap((t, i) => t.v.map((v, k) => [i + 1, t.gen, k + 1, g(v[0]), g(v[1])].join(',')))];
    save(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `${file()}.csv`, 'text/csv');
  });

  // ---------- Wiring ----------
  for (const c of ['.hd-p', '.hd-q']) q<HTMLSelectElement>(c).innerHTML = Array.from({ length: 10 }, (_, i) => `<option>${i + 3}</option>`).join('');
  q<HTMLSelectElement>('.hd-p').value = '7'; q<HTMLSelectElement>('.hd-q').value = '3';
  function setMode(m: 'draw' | 'tile') {
    mode = m;
    root.querySelectorAll<HTMLButtonElement>('.hd-mode button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === m)));
    q('.hd-draw').hidden = m !== 'draw'; q('.hd-tile').hidden = m !== 'tile'; q('.hd-reset').hidden = true;
    cv.style.cursor = m === 'draw' ? 'crosshair' : 'grab';
    update();
  }
  root.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    if (b.dataset.m) setMode(b.dataset.m as 'draw' | 'tile');
    else if (b.classList.contains('hd-pdel')) { pts.splice(Number(b.dataset.i), 1); renderPoints(); update(); }
    else if (b.classList.contains('hd-sdel')) { shapes.splice(Number(b.closest<HTMLElement>('.hd-shape')!.dataset.i), 1); update(); }
    else if (b.classList.contains('hd-add') && pts.length >= 2) { shapes.push({ kind: 'segment', a: pts[0].name, b: pts[1].name, c: pts[2]?.name ?? pts[0].name, r: 1 }); update(); }
    else if (b.classList.contains('hd-clear')) { pts = []; shapes = []; renderPoints(); update(); }
    else if (b.classList.contains('hd-reset')) { q('.hd-reset').hidden = true; update(); }
  });
  root.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.classList.contains('hd-px') || t.classList.contains('hd-py')) {
      const i = Number(t.dataset.i), v = num(t.value), z: Z = [...pts[i].z] as Z; z[t.classList.contains('hd-px') ? 0 : 1] = v;
      if (!Number.isFinite(v) || abs(z) >= 1) { err(`Point ${pts[i].name} must be inside the unit circle (x² + y² below 1).`); return; }
      pts[i].z = z; err(''); update();
    } else if (t.closest('.hd-shape')) {
      const d = t.closest<HTMLElement>('.hd-shape')!, s = shapes[Number(d.dataset.i)], g = (c: string) => (d.querySelector(c) as HTMLInputElement).value;
      s.kind = g('.hd-k') as Shape['kind']; s.a = g('.hd-a'); s.b = g('.hd-b'); s.c = g('.hd-c'); s.r = num(g('.hd-r'));
      update();
    } else if (t.closest('.hd-tile')) { q('.hd-reset').hidden = true; update(); }
  });
  new ResizeObserver(() => { if (Math.round(cv.clientWidth) !== S) { if (mode === 'tile') buildTiles(); paint(); } }).observe(cv);
  new MutationObserver(() => { renderShapes(); paint(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
  example(); renderPoints(); update();
</script>
