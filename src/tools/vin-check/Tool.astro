---
// #T910 VIN check
---
<div class="tool-ui vc">
  <label>VIN (17 characters) <input class="vc-in" value="1M8GDM9AXKP042788" maxlength="30" autocomplete="off" spellcheck="false" autocapitalize="characters" /></label>
  <p class="vc-count" aria-live="polite"></p>
  <p class="vc-fix" aria-live="polite"></p>
  <dl class="vc-rows"></dl>
  <details class="vc-more"><summary>Show the working: how the check digit is worked out</summary>
    <p class="vc-fine">Each character gets a value (digits count as themselves, letters 1 to 9), is multiplied by the weight of its position, and the products are added. The sum divided by 11 leaves a remainder, and that remainder (10 is written X) must equal the 9th character. Only North American vehicles are required to follow this.</p>
    <div class="vc-scroll"><table class="vc-tab"><thead><tr><th>Pos</th><th>Char</th><th>Value</th><th>Weight</th><th>Product</th></tr></thead><tbody></tbody></table></div>
    <p class="vc-sum"></p>
  </details>
  <details class="vc-more"><summary>Where to find the VIN</summary>
    <p class="vc-fine">On the dashboard at the bottom of the windscreen (look from outside), on the sticker inside the driver's door frame, on the registration document and on the insurance papers. Two-wheelers and trucks often stamp it on the frame or chassis. Compare all of them: if they differ, walk away.</p>
  </details>
  <p class="vc-fine">Worked out on this page only: nothing is looked up or sent. A valid check digit does not prove a vehicle is genuine. Check the papers and official records.</p>
</div>

<style is:inline>
  .vc { display: grid; gap: 12px; margin-bottom: 32px; }
  .vc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .vc-in { font: 600 18px ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .vc-in:focus { border-color: var(--accent); outline: none; }
  .vc-count { margin: 0; font-weight: 600; }
  .vc-rows { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }
  .vc-rows dt { color: var(--muted); } .vc-rows dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .vc .good { color: var(--good); } .vc .bad { color: var(--bad); }
  .vc-fix { margin: 0; } .vc-fix:empty { display: none; }
  .vc-more summary { cursor: pointer; color: var(--accent); }
  .vc-scroll { overflow-x: auto; margin-top: 8px; }
  .vc-tab { border-collapse: collapse; width: 100%; font-size: 14px; }
  .vc-tab th, .vc-tab td { padding: 4px 8px; text-align: right; border-bottom: 1px solid var(--line); }
  .vc-sum { margin: 8px 0 0; font-weight: 600; }
  .vc-fine { color: var(--muted); font-size: 13px; margin: 0; }
</style>

<script>
  import { analyse, country, likelyYear, workings, suggestFix, cleanVin } from '../../lib/money/vin';
  const root = document.querySelector('.vc') as HTMLElement;
  const input = root.querySelector('.vc-in') as HTMLInputElement;
  const cnt = root.querySelector('.vc-count') as HTMLElement;
  const rows = root.querySelector('.vc-rows') as HTMLElement;
  const row = (a: string, b: string, cls = '') => `<dt>${a}</dt><dd class="${cls}">${b}</dd>`;
  const update = () => {
    const r = analyse(input.value);
    cnt.textContent = `${r.length} of 17 characters`;
    let h = '';
    const wk = root.querySelector('.vc-tab tbody') as HTMLElement, sm = root.querySelector('.vc-sum') as HTMLElement, fx = root.querySelector('.vc-fix') as HTMLElement;
    wk.innerHTML = ''; sm.textContent = ''; fx.textContent = '';
    if (!r.length) { rows.innerHTML = ''; cnt.textContent = ''; return; }
    const sf = suggestFix(r.vin);
    if (sf) fx.textContent = `A VIN never has I, O or Q. If they were misread, try ${sf.vin}: its check digit is ${sf.valid ? 'valid' : 'not valid either'}.`;
    h += row('Length', r.okLength ? '17, good' : `${r.length}, a VIN has exactly 17`, r.okLength ? 'good' : 'bad');
    h += row('Characters', r.bad.length ? `Not allowed: ${r.bad.join(' ')} (I, O and Q are never used)` : 'All allowed', r.bad.length ? 'bad' : 'good');
    if (r.okLength && !r.bad.length) {
      h += row('Check digit', r.valid ? `Valid (${r.actual})` : `Invalid: position 9 is ${r.actual}, the sum gives ${r.expected}` + (r.checkRequired ? '' : ' (not required outside North America)'), r.valid ? 'good' : 'bad');
      h += row('Maker region', r.region);
      const c = country(r.vin); if (c) h += row('Made in (maker country)', c);
      h += row('Model year', r.years ? `${r.years[0]} or ${r.years[1]}` : 'Code not used (U, Z and 0 are not model year codes)');
      const ly = likelyYear(r.vin); if (ly) h += row('Most likely year', `${ly} (7th character ${r.vin[6]} is ${/[A-Z]/.test(r.vin[6]) ? 'a letter: 2010 on' : 'a digit: before 2010'}, for North American cars)`);
      h += row('Maker code (first 3)', r.vin.slice(0, 3)) + row('Serial number (last 6)', r.vin.slice(11));
      const w = workings(r.vin);
      if (w) { wk.innerHTML = w.rows.map((x) => `<tr><td>${x.pos}</td><td>${x.ch}</td><td>${x.value}</td><td>${x.weight}</td><td>${x.product}</td></tr>`).join(''); sm.textContent = `Sum ${w.sum}; ${w.sum} divided by 11 leaves ${w.rest}${w.rest === 10 ? ' (written X)' : ''}.`; }
      h += row('Plant code', r.plant);
    }
    rows.innerHTML = h;
  };
  input.addEventListener('input', update);
  update();
</script>
