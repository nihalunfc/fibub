  .fcd .fc-front { font-size: clamp(20px, 5vw, 26px); font-weight: 650; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fcd .fc-back { font-size: clamp(17px, 4.4vw, 21px); white-space: pre-wrap; overflow-wrap: anywhere; border-top: 1px solid var(--line); padding-top: 14px; }
  .fcd .fc-grades { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
