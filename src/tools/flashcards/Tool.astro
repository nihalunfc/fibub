  .fcd .fc-g.g4, .fcd .fc-g.g5 { border-color: var(--good); }
  .fcd .fc-h3 { font-size: 15px; margin: 16px 0 6px; }
  .fcd .fc-clip { max-width: 16em; overflow-wrap: anywhere; white-space: pre-wrap; }
  .fcd .fc-tab .btn.small { padding: 4px 10px; font-size: 14px; }
  .fcd .fc-fgrid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
</style>
