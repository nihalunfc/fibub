---
// #T937 Password strength
---
<div class="tool-ui ps">
  <section class="panel" data-nokit>
    <label>Password<input class="ps-in" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" /></label>
    <label class="ps-check"><input type="checkbox" class="ps-show" /> Show the password</label>
    <details class="ps-more">
      <summary>More options: your personal words, compare two passwords</summary>
      <label>Words about you to check against (name, pet, birth year; separate with spaces or commas)
        <input class="ps-pers" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" placeholder="e.g. maya rex 1994" />
      </label>
      <label>Compare with another password
        <input class="ps-in2" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" data-lpignore="true" />
      </label>
      <p class="ps-cmp" aria-live="polite"></p>
    </details>
    <p class="ps-btns"><button type="button" class="btn secondary small ps-clear">Clear</button></p>
  </section>
  <section class="panel ps-res" aria-live="polite">
    <p class="ps-rate"></p>
    <div class="ps-bar" aria-hidden="true"><span></span></div>
    <p class="ps-sum"></p>
    <p class="ps-kinds"></p>
    <ul class="ps-chk"></ul>
    <table class="ps-times" hidden>
      <thead><tr><th>Attack</th><th>Guesses per second</th><th>Time to try every guess</th></tr></thead>
      <tbody></tbody>
    </table>
    <h3 class="ps-h" hidden>Why</h3>
    <ul class="ps-why"></ul>
    <p class="ps-tip"></p>
  </section>
  <p class="ps-fine">Checked on this page only: what you type is never sent anywhere or saved, and this does not look your password up in any breach list (that would mean sending it). This is a rough estimate from simple rules, not a promise; a long password from a password generator is always the safest choice.</p>
</div>

<style is:inline>
  .ps { display: grid; gap: 14px; margin-bottom: 32px; }
  .ps .panel { padding: 16px; }
  .ps label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .ps label.ps-check { display: flex; gap: 8px; align-items: flex-start; color: var(--ink); margin-top: 10px; font-size: 15px; }
  .ps-in { font: inherit; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--ink); padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .ps-in:focus { border-color: var(--accent); outline: none; }
  .ps-btns { margin: 10px 0 0; }
  .ps-rate { font-size: 24px; font-weight: 700; margin: 0 0 8px; }
  .ps-bar { height: 10px; border-radius: 5px; background: var(--line); overflow: hidden; }
  .ps-bar span { display: block; height: 100%; width: 0; background: var(--bad); }
  .ps-res[data-lv="2"] .ps-bar span { background: var(--warn); }
  .ps-res[data-lv="3"] .ps-bar span, .ps-res[data-lv="4"] .ps-bar span { background: var(--good); }
  .ps-res[data-lv="0"] .ps-rate, .ps-res[data-lv="1"] .ps-rate { color: var(--bad); }
  .ps-res[data-lv="3"] .ps-rate, .ps-res[data-lv="4"] .ps-rate { color: var(--good); }
  .ps-sum { margin: 10px 0 0; color: var(--muted); font-size: 15px; }
  .ps-times { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 12px; }
  .ps-times th, .ps-times td { text-align: left; padding: 6px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .ps-h { font-size: 15px; margin: 14px 0 4px; }
  .ps-why { margin: 0; padding-left: 20px; font-size: 15px; }
  .ps-why li { overflow-wrap: anywhere; }
  .ps-fine { color: var(--muted); font-size: 13px; margin: 0; }
  .ps input[type="text"], .ps input[type="password"] { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .ps-more { margin-top: 12px; }
  .ps-more summary { cursor: pointer; font-size: 14px; margin-bottom: 8px; }
  .ps-kinds { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .ps-chk { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 4px; font-size: 15px; }
  .ps-chk li { overflow-wrap: anywhere; }
  .ps-chk .bad { color: var(--bad); font-weight: 600; }
  .ps-chk .ok { color: var(--ink); }
  .ps-cmp { margin: 8px 0 0; font-size: 15px; }
  .ps-tip { margin: 12px 0 0; font-size: 15px; }
</style>

<script>
  import { estimate, kinds, levelOf, LEVELS, charsToReach, MAX_ANALYSED } from '../../lib/everyday/pwstrength';
  import { timeText } from '../../lib/everyday/password';
  const root = document.querySelector('.ps') as HTMLElement;
  const q = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const inp = q<HTMLInputElement>('.ps-in'), inp2 = q<HTMLInputElement>('.ps-in2'), pers = q<HTMLInputElement>('.ps-pers');
  const res = q('.ps-res'), rateEl = q('.ps-rate'), bar = q('.ps-bar span'), sum = q('.ps-sum');
  const table = q('.ps-times'), tbody = q('.ps-times tbody'), why = q('.ps-why'), whyH = q('.ps-h'), kindsEl = q('.ps-kinds'), chk = q('.ps-chk'), tip = q('.ps-tip'), cmp = q('.ps-cmp');

  const SPEEDS: [string, number][] = [
    ['Online, with the site limiting tries', 100 / 3600],
    ['Online, no limit', 10],
    ['Offline, slow password hash', 1e4],
    ['Offline, fast hash, many graphics cards', 1e10],
  ];
  const sci = (l10: number) => (l10 < 6 ? Math.round(10 ** l10).toLocaleString('en-US') : `about 10^${Math.floor(l10)}`);
  const words = () => pers.value.split(/[\s,;]+/).filter((w) => w.length >= 3);

  const update = () => {
    const pw = inp.value;
    chk.innerHTML = ''; kindsEl.textContent = ''; tip.textContent = '';
    if (!pw) {
      res.dataset.lv = ''; rateEl.textContent = 'Type a password above to check it.'; bar.style.width = '0';
      sum.textContent = 'It stays on this page.'; table.hidden = true; whyH.hidden = true; why.innerHTML = ''; compare(null); return;
    }
    const r = estimate(pw, words());
    const lv = levelOf(r.bits, r.whole);
    res.dataset.lv = String(lv); rateEl.textContent = LEVELS[lv]; bar.style.width = `${(lv + 1) * 20}%`;
    const l10 = r.bits * Math.log10(2);
    sum.textContent = `About ${r.bits.toFixed(1)} bits: an attacker would need up to ${sci(l10)} guesses.`;
    const kd = kinds(pw);
    kindsEl.textContent = `${pw.length} characters: ${kd.lower} lower case, ${kd.upper} upper case, ${kd.digit} digits, ${kd.symbol} symbols or spaces.` + (r.extra ? ` Patterns were looked for in the first ${MAX_ANALYSED} characters only.` : '');
    tbody.innerHTML = '';
    for (const [name, sp] of SPEEDS) {
      const tr = document.createElement('tr');
      for (const c of [name, sp < 1 ? '100 an hour' : sp.toLocaleString('en-US'), timeText(r.bits, sp)]) { const td = document.createElement('td'); td.textContent = c; tr.append(td); }
      tbody.append(tr);
    }
    table.hidden = false;
    const personal = r.used.some((m) => m.why.includes('personal word'));
    const patterns = r.used.filter((m) => !m.why.includes('common-password') && !m.why.includes('personal word')).length;
    const kindCount = [kd.lower, kd.upper, kd.digit, kd.symbol].filter((n) => n > 0).length;
    const rows: [boolean, string][] = [
      [pw.length >= 12, pw.length >= 12 ? `Length: ${pw.length} characters (12 or more)` : `Length: only ${pw.length} characters (aim for 12 or more, 16 is better)`],
      [kindCount >= 3 || pw.length >= 16, kindCount >= 3 ? `Mix: ${kindCount} kinds of character` : pw.length >= 16 ? 'Mix: few kinds of character, but long enough to make up for it' : `Mix: only ${kindCount} kind${kindCount === 1 ? '' : 's'} of character`],
      [!r.used.some((m) => m.why.includes('common-password')), r.used.some((m) => m.why.includes('common-password')) ? 'Common passwords: contains a word from the common-password list' : 'Common passwords: none found in the built-in list'],
      [patterns === 0, patterns === 0 ? 'Patterns: no sequences, keyboard runs, repeats, years or dates found' : `Patterns: ${patterns} found (sequence, keyboard run, repeat, year or date)`],
    ];
    if (words().length) rows.push([!personal, personal ? 'Your words: your password contains one of your personal words' : 'Your words: none of your personal words appear']);
    for (const [ok, t] of rows) { const li = document.createElement('li'); li.className = ok ? 'ok' : 'bad'; li.textContent = (ok ? 'OK: ' : 'Check: ') + t; chk.append(li); }
    const notes: string[] = [];
    if (r.whole) notes.push('Found in the common-password list: attackers try these first.');
    for (const m of r.used) if (!r.whole || !m.why.includes('common-password')) notes.push(m.why + '.');
    if (pw.length < 12) notes.push(`Only ${pw.length} characters: 12 or more is better, 16 or more is best.`);
    if (r.pool <= 26) notes.push('Only one kind of character: length matters most, but mixing kinds helps a short password.');
    if (!r.used.length && !r.whole) notes.push(`No common words or patterns found, so each character counts as about ${r.cb.toFixed(1)} bits (${r.pool} possible characters).`);
    whyH.hidden = false; why.innerHTML = '';
    for (const t of notes) { const li = document.createElement('li'); li.textContent = t; why.append(li); }
    const more = charsToReach(r.bits, r.cb, 80);
    tip.textContent = r.whole ? 'Pick something else entirely: a common password stays weak however it is changed. A random one from the password generator is best.'
      : more ? `To improve it: make it longer. About ${more} more random character${more === 1 ? '' : 's'} (about ${r.cb.toFixed(1)} bits each) would reach 80 bits, which guessing attacks cannot reach today.`
      : 'It already has at least 80 bits by this estimate. Never reuse it on another site.';
    compare(r.bits);
  };
  const compare = (a: number | null) => {
    if (!inp2.value) { cmp.textContent = ''; return; }
    if (a === null) { cmp.textContent = 'Type the first password to compare.'; return; }
    const b = estimate(inp2.value, words()).bits, d = Math.abs(b - a);
    const ratio = d > 40 ? `about 10^${Math.floor(d * Math.log10(2))} times` : `about ${Math.round(2 ** d).toLocaleString('en-US')} times`;
    cmp.textContent = d < 0.05 ? `The other password is about as strong: ${b.toFixed(1)} bits against ${a.toFixed(1)}.`
      : `The other password has ${b.toFixed(1)} bits against ${a.toFixed(1)}: ${b > a ? 'it is stronger' : 'it is weaker'} by ${d.toFixed(1)} bits, ${ratio} the guesses.`;
  };

  for (const el of [inp, inp2, pers]) el.addEventListener('input', update);
  q('.ps-show').addEventListener('change', (e) => { const t = (e.target as HTMLInputElement).checked ? 'text' : 'password'; inp.type = t; inp2.type = t; });
  q('.ps-clear').addEventListener('click', () => { inp.value = ''; inp2.value = ''; update(); inp.focus(); });
  update();
</script>
