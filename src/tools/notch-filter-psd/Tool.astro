---
// Line-noise notch filter for EEG / patch-clamp traces, with Welch PSD before and after and band powers.
import DataFile from '../../components/DataFile.astro';
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax nf">
  <div class="ax-card">
    <h2>Trace</h2>
    <label>One column of samples, or a time column (named time or t, in s or ms) and one or more signal columns. Paste from a spreadsheet or open a file.
      <textarea class="nf-in" rows="8" spellcheck="false" wrap="off"></textarea></label>
    <DataFile target=".nf-in" maxMB={50} maxCols={20} maxRows={500000} />
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn secondary small nf-wavb">Open a WAV file</button>
      <input type="file" class="nf-wav" accept=".wav,audio/wav,audio/x-wav" hidden />
      <span class="ax-help" style="margin:0">Or a WAV recording (up to 100 MB), for example from an amplifier's audio output.</span>
    </div>
    <p class="ax-help">The example (filled in for you) is a made-up 10 s EEG-like trace at 500 Hz in µV: alpha at 10 Hz, theta at 6 Hz, noise, and 50 Hz mains hum with its 3rd harmonic. Files are read on your device and never uploaded.</p>
    <p class="nf-src ax-help" hidden></p>
    <div class="ax-grid" style="margin-top:10px">
      <label>Signal column<select class="nf-col"></select></label>
      <label>Sample rate (Hz)<input class="nf-fs" type="number" min="1" step="any" /><span class="ax-help nf-fsn">Read from the time column when there is one.</span></label>
      <label>Units<input class="nf-unit" value="µV" /></label>
    </div>
    <p class="ax-err nf-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Filter and spectrum</h2>
    <div class="ax-grid">
      <label>Mains frequency<select class="nf-f0"><option value="50">50 Hz (Europe, Asia, Africa, Australia)</option><option value="60">60 Hz (Americas, parts of Asia)</option></select></label>
      <label>Notches<select class="nf-h"><option value="1">Mains only</option><option value="2">+ 2nd harmonic</option><option value="3" selected>+ 2nd and 3rd</option><option value="4">Up to 4th</option><option value="5">Up to 5th</option></select><span class="ax-help">Harmonics above half the sample rate are skipped.</span></label>
      <label>Quality Q<input class="nf-q" type="number" min="1" max="200" step="any" value="30" /><span class="ax-help">Notch width = frequency ÷ Q; higher Q cuts a narrower band.</span></label>
      <label>Welch segment<select class="nf-seg"><option>256</option><option selected>512</option><option>1024</option><option>2048</option><option>4096</option><option>8192</option></select><span class="ax-help nf-segn">Longer = finer frequency steps, noisier estimate.</span></label>
      <label class="ax-check" style="align-self:center"><input type="checkbox" class="nf-zp" checked /> Zero-phase (forward and backward)</label>
    </div>
    <label style="margin-top:10px">Bands (name and range in Hz, separated by semicolons)<input class="nf-bands" value="Delta 1-4; Theta 4-8; Alpha 8-13; Beta 13-30; Gamma 30-45" /></label>
    <p class="ax-help">Zero-phase filtering runs the notch forwards then backwards, so waveforms are not shifted in time and the notch is twice as deep. Untick it to see a single causal pass, as a hardware filter would do.</p>
  </div>

  <div class="ax-card nf-out" hidden>
    <h2>Result</h2>
    <dl class="ax-facts nf-facts"></dl>
    <h3>Power spectrum (Welch)</h3>
    <canvas class="ax-fig nf-psd"></canvas>
    <h3>Band power</h3>
    <div class="ax-scroll"><table class="nf-tab"></table></div>
    <h3>Trace</h3>
    <div class="ax-grid"><label>Show from (s)<input class="nf-t0" type="number" min="0" step="0.5" value="0" /></label><label>Length (s)<input class="nf-tl" type="number" min="0.01" step="0.5" value="1" /></label></div>
    <canvas class="ax-fig nf-tr"></canvas>
    <div class="ax-row" style="margin-top:12px">
      <button type="button" class="btn secondary small nf-csv">Filtered trace (CSV)</button>
      <button type="button" class="btn secondary small nf-pcsv">Spectra (CSV)</button>
    </div>
    <Downloads />
  </div>
</div>

<script>
  import { parseTable, num, sig, csv } from '../../lib/sci/num';
  import { notchFreqs, removeLineNoise, welch, bandPower, parseBands, exampleTrace } from '../../lib/sci/notchpsd';
  import { parseWav } from '../../lib/sci/spectro';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Section, type Figure } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.nf')!;
  const q = <T extends HTMLElement = HTMLInputElement>(c: string) => root.querySelector(c) as T;
  const box = q<HTMLTextAreaElement>('.nf-in'), colSel = q<HTMLSelectElement>('.nf-col');
  type Src = { names: string[]; cols: Float64Array[]; fs: number | null; label: string; t0: number };
  let src: Src | null = null, wav: Src | null = null, res: { x: Float64Array; y: Float64Array; fs: number; f: number[]; p0: number[]; p1: number[]; name: string; t0: number } | null = null;
  let figs: Figure[] = [], report: Section[] = [];

  // Example: built here so the page stays small.
  { const x = exampleTrace(); box.value = 'time_s\tEEG_uV\n' + Array.from(x, (v, i) => `${(i / 500).toFixed(3)}\t${v.toFixed(3)}`).join('\n'); }

  function readText(): Src {
    const rows = parseTable(box.value);
    if (!rows.length) throw new Error('Paste a trace, or open a CSV or WAV file.');
    const head = rows[0].some((c) => c !== '' && Number.isNaN(num(c)));
    const body = head ? rows.slice(1) : rows, width = Math.max(...rows.map((r) => r.length));
    const names = Array.from({ length: width }, (_, i) => (head ? rows[0][i] || `Column ${i + 1}` : `Column ${i + 1}`));
    let cols = names.map((_, i) => Float64Array.from(body, (r) => num(r[i])));
    const timeIdx = head && width > 1 && /^(t|time)([\s_(\[-]|$)/i.test(names[0]) ? 0 : -1;
    let fs: number | null = null, t0 = 0;
    if (timeIdx === 0) {
      const t = cols[0], k = /ms|msec|milli/i.test(names[0]) ? 1e-3 : 1;
      if (t.length > 1 && Number.isFinite(t[0]) && Number.isFinite(t[t.length - 1])) { fs = (t.length - 1) / ((t[t.length - 1] - t[0]) * k); t0 = t[0] * k; }
      if (!(fs! > 0)) throw new Error('The time column must increase from top to bottom.');
      const dt = (t[t.length - 1] - t[0]) / (t.length - 1); let worst = 0; for (let i = 1; i < t.length; i++) worst = Math.max(worst, Math.abs(t[i] - t[i - 1] - dt));
      if (worst > 0.01 * dt) throw new Error('The time column is not evenly spaced (a step differs by more than 1 %). The filter needs evenly spaced samples.');
      cols = cols.slice(1); names.shift();
    }
    return { names, cols, fs, label: '', t0 };
  }

  let lastCols = '';
  function fillCols(s: Src) {
    const key = s.names.join('\u0001');
    if (key === lastCols) return; lastCols = key;
    colSel.innerHTML = ''; s.names.forEach((n, i) => colSel.add(new Option(n, String(i))));
  }

  function calc(fromInput = false) {
    const err = q('.nf-err'); err.hidden = true;
    const fail = (m: string) => { err.textContent = m; err.hidden = false; q('.nf-out').hidden = true; report = []; res = null; };
    try { src = wav ?? readText(); } catch (e) { return fail((e as Error).message); }
    fillCols(src);
    if (src.fs && (fromInput || !num(q('.nf-fs').value))) q('.nf-fs').value = String(+src.fs.toPrecision(10));
    q('.nf-fs').disabled = !!src.fs; q('.nf-fsn').textContent = src.fs ? (wav ? 'From the WAV file.' : 'From the time column.') : 'No time column: type the rate the trace was recorded at.';
    const ci = Math.min(Number(colSel.value) || 0, src.cols.length - 1), x = src.cols[ci], name = src.names[ci];
    const bad = x.findIndex((v) => !Number.isFinite(v));
    if (bad >= 0) return fail(`${name}: row ${bad + 1} is not a number. Remove gaps or text from the trace (the filter needs every sample).`);
    const fs = src.fs ?? num(q('.nf-fs').value), Q = num(q('.nf-q').value), f0 = Number(q<HTMLSelectElement>('.nf-f0').value), nseg = Number(q<HTMLSelectElement>('.nf-seg').value), zp = q<HTMLInputElement>('.nf-zp').checked;
    if (!(fs > 0)) return fail('Type the sample rate in Hz (samples per second).');
    if (!(Q > 0)) return fail('Q must be a number above 0 (30 is typical).');
    const freqs = notchFreqs(f0, Number(q<HTMLSelectElement>('.nf-h').value), fs);
    if (!freqs.length) return fail(`The sample rate ${sig(fs, 4)} Hz is too low to contain ${f0} Hz hum (it must be above ${2 * f0} Hz).`);
    if (x.length < nseg) return fail(`The trace has ${x.length} samples, fewer than one Welch segment (${nseg}). Pick a shorter segment.`);
    let bands; try { bands = parseBands(q('.nf-bands').value); } catch (e) { return fail((e as Error).message); }
    let y: Float64Array;
    try { y = removeLineNoise(x, fs, freqs, Q, zp); } catch (e) { return fail((e as Error).message); }
    const w0 = welch(x, fs, nseg), w1 = welch(y, fs, nseg), u = q('.nf-unit').value.trim() || 'units';
    q('.nf-segn').textContent = `${sig(nseg / fs, 3)} s per segment; frequency step ${sig(fs / nseg, 3)} Hz; ${w0.segments} segments, 50 % overlap, Hann.`;
    res = { x: Float64Array.from(x), y, fs, f: w0.f, p0: w0.psd, p1: w1.psd, name, t0: src.t0 };
    q('.nf-out').hidden = false;
    // Line noise: power within ±1 Hz or ±2 frequency steps (whichever is wider) of each notch.
    const hw = Math.max(1, 2 * (fs / nseg)) + 1e-9;
    const line = (p: number[]) => freqs.reduce((s, f) => s + bandPower(w0.f, p, f - hw, f + hw), 0);
    const l0 = line(w0.psd), l1 = line(w1.psd), tot = (p: number[]) => bandPower(w0.f, p, 0, fs);
    const rms = (a: ArrayLike<number>) => { let m = 0; for (let i = 0; i < a.length; i++) m += a[i]; m /= a.length; let s = 0; for (let i = 0; i < a.length; i++) s += (a[i] - m) ** 2; return Math.sqrt(s / a.length); };
    const facts: [string, string][] = [
      ['Notches', `${freqs.map((f) => sig(f, 4)).join(', ')} Hz, Q ${sig(Q, 3)}`],
      ['Notch width (−3 dB)', `${sig(f0 / Q, 3)} Hz at ${f0} Hz`],
      [`Line noise power (±${sig(hw, 3)} Hz)`, `${sig(l0, 3)} → ${sig(l1, 3)} ${u}²`],
      ['Line noise removed', `${sig(10 * Math.log10(l0 / l1), 3)} dB`],
      ['Total power', `${sig(tot(w0.psd), 4)} → ${sig(tot(w1.psd), 4)} ${u}²`],
      ['RMS', `${sig(rms(x), 4)} → ${sig(rms(y), 4)} ${u}`],
      ['Trace', `${x.length.toLocaleString('en')} samples, ${sig(x.length / fs, 4)} s at ${sig(fs, 5)} Hz`],
    ];
    const dl = q('.nf-facts'); dl.innerHTML = '';
    for (const [k, v] of facts) { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.children[0].textContent = k; d.children[1].textContent = v; dl.append(d); }
    const b0 = bands.map((b) => bandPower(w0.f, w0.psd, b.lo, b.hi)), b1 = bands.map((b) => bandPower(w0.f, w1.psd, b.lo, b.hi)), sum1 = b1.reduce((s, v) => s + v, 0);
    const rows = bands.map((b, i) => [b.name, `${sig(b.lo, 4)}–${sig(b.hi, 4)}`, sig(b0[i], 4), sig(b1[i], 4), `${b0[i] > 0 ? sig((b1[i] / b0[i] - 1) * 100, 3) : '–'} %`, `${sum1 > 0 ? sig((b1[i] / sum1) * 100, 3) : '–'} %`]);
    const head = ['Band', 'Hz', `Before (${u}²)`, `After (${u}²)`, 'Change', 'Share after'];
    const tb = q<HTMLTableElement>('.nf-tab'); tb.innerHTML = '';
    const hr = tb.createTHead().insertRow(); head.forEach((h, i) => { const th = document.createElement('th'); th.textContent = h; if (i > 1) th.className = 'r'; hr.append(th); });
    const tbody = tb.createTBody(); rows.forEach((r) => { const tr = tbody.insertRow(); r.forEach((t, i) => { const td = tr.insertCell(); td.textContent = t; if (i > 1) td.className = 'r'; }); });
    const keep = w0.f.map((f, i) => i).filter((i) => i > 0);
    const psdFig = chartFigure({ h: 340, xLabel: 'Frequency (Hz)', yLabel: `PSD (${u}²/Hz)`, yLog: true, legend: 'inside', series: [{ name: 'Before', x: keep.map((i) => w0.f[i]), y: keep.map((i) => w0.psd[i]), mode: 'line' }, { name: 'After', x: keep.map((i) => w0.f[i]), y: keep.map((i) => w1.psd[i]), mode: 'line' }], marks: freqs.map((f) => ({ kind: 'vline' as const, at: f, dash: [2, 4] })) }, 'Welch power spectrum before and after the notch filter');
    paint(q<HTMLCanvasElement>('.nf-psd'), psdFig);
    const trFig = traceFig();
    figs = [psdFig, trFig];
    report = [
      { title: 'Settings and result', facts: [...facts, ['Signal', name], ['Filtering', zp ? 'zero-phase (forward and backward)' : 'single causal pass']] },
      { title: 'Power spectrum (Welch)', figure: psdFig, text: [q('.nf-segn').textContent!] },
      { title: 'Band power', table: { head, rows, align: ['l', 'l', 'r', 'r', 'r', 'r'] } },
      { title: 'Trace', figure: trFig },
    ];
  }

  function traceFig(): Figure {
    const r = res!, t0 = Math.max(0, num(q('.nf-t0').value) || 0), len = Math.max(1 / r.fs, num(q('.nf-tl').value) || 1);
    const i0 = Math.min(r.x.length - 1, Math.floor(t0 * r.fs)), i1 = Math.min(r.x.length, Math.max(i0 + 2, Math.ceil((t0 + len) * r.fs)));
    const step = Math.max(1, Math.floor((i1 - i0) / 2000)), xs: number[] = [], a: number[] = [], b: number[] = [];
    for (let i = i0; i < i1; i += step) { xs.push(r.t0 + i / r.fs); a.push(r.x[i]); b.push(r.y[i]); }
    const u = q('.nf-unit').value.trim() || 'units';
    const f = chartFigure({ h: 280, xLabel: 'Time (s)', yLabel: `${r.name} (${u})`, legend: 'inside', series: [{ name: 'Before', x: xs, y: a, mode: 'line', width: 1 }, { name: 'After', x: xs, y: b, mode: 'line', width: 1.5 }] }, 'Trace before and after filtering');
    paint(q<HTMLCanvasElement>('.nf-tr'), f);
    return f;
  }

  let t = 0;
  const later = (f: () => void) => { clearTimeout(t); t = window.setTimeout(f, 300); };
  box.addEventListener('input', () => { wav = null; q('.nf-src').hidden = true; later(() => calc(true)); });
  for (const c of ['.nf-fs', '.nf-q', '.nf-bands', '.nf-unit']) q(c).addEventListener('input', () => later(() => calc()));
  for (const c of ['.nf-col', '.nf-f0', '.nf-h', '.nf-seg', '.nf-zp']) q(c).addEventListener('change', () => calc());
  for (const c of ['.nf-t0', '.nf-tl']) q(c).addEventListener('input', () => later(() => { if (res) { figs[1] = traceFig(); report[3].figure = figs[1]; } }));
  const wi = q<HTMLInputElement>('.nf-wav');
  q('.nf-wavb').addEventListener('click', () => wi.click());
  wi.addEventListener('change', async () => {
    const f = wi.files?.[0]; wi.value = ''; if (!f) return;
    const err = q('.nf-err');
    if (f.size > 100e6) { err.textContent = `${f.name} is over 100 MB. Cut out the part you need first.`; err.hidden = false; return; }
    try {
      const w = parseWav(new Uint8Array(await f.arrayBuffer()));
      wav = { names: w.channels.map((_, i) => (w.channels.length === 1 ? 'Sound' : `Channel ${i + 1}`)), cols: w.channels.map((c) => Float64Array.from(c)), fs: w.fs, label: f.name, t0: 0 };
      q('.nf-src').textContent = `Using ${f.name}: ${w.channels.length} channel${w.channels.length > 1 ? 's' : ''}, ${w.fs} Hz, ${sig(w.channels[0].length / w.fs, 4)} s (values as fractions of full scale). Type in the box above to go back to pasted data.`;
      q('.nf-src').hidden = false; q('.nf-unit').value = 'full scale'; calc(true);
    } catch (e) { err.textContent = `${f.name}: ${(e as Error).message}`; err.hidden = false; }
  });
  const fmt = (v: number) => String(+v.toPrecision(7));
  q('.nf-csv').addEventListener('click', () => { if (!res) return; const r = res; const lines = ['time_s,original,filtered']; for (let i = 0; i < r.x.length; i++) lines.push(`${fmt(r.t0 + i / r.fs)},${fmt(r.x[i])},${fmt(r.y[i])}`); save(new TextEncoder().encode(lines.join('\n') + '\n'), `${r.name.replace(/[^\w-]+/g, '-')}-notch-filtered.csv`, 'text/csv'); });
  q('.nf-pcsv').addEventListener('click', () => { if (!res) return; const r = res; save(new TextEncoder().encode(csv([['frequency_Hz', 'psd_before', 'psd_after'], ...r.f.map((f, i) => [fmt(f), fmt(r.p0[i]), fmt(r.p1[i])])])), `${r.name.replace(/[^\w-]+/g, '-')}-psd.csv`, 'text/csv'); });
  document.addEventListener('fibub:theme', () => { if (figs[0]) paint(q<HTMLCanvasElement>('.nf-psd'), figs[0]); if (res) traceFig(); });
  calc(true);
  wireDownloads(q('.dl'), () => ({ title: 'Line-noise notch filter', subtitle: res?.name, file: 'notch-filter', sections: report }));
</script>
