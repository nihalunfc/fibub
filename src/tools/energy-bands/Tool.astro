---
// Energy bands: valence and conduction bands of a conductor, semiconductors and an insulator; temperature lifts
// electrons across the gap; n-type and p-type doping add a level and change n and p (n·p = ni²); LED colour from Eg.
import '../../styles/astro.css';
import '../../styles/chemquiz.css';
---
<div class="ax eb">
  <div class="ax-card">
    <div class="ax-seg eb-mat" role="group" aria-label="Material">
      <button type="button" data-m="cu" aria-pressed="false">Copper</button><button type="button" data-m="ge" aria-pressed="false">Germanium</button><button type="button" data-m="si" aria-pressed="true">Silicon</button><button type="button" data-m="gaas" aria-pressed="false">GaAs</button><button type="button" data-m="diamond" aria-pressed="false">Diamond</button>
    </div>
    <label class="eb-rl"><span>T</span><input type="range" class="eb-t" min="100" max="700" step="10" value="300" aria-label="Temperature" /><output class="eb-ot"></output></label>
    <div class="eb-dope">
      <div class="ax-seg eb-type" role="group" aria-label="Doping" style="margin-top:12px">
        <button type="button" data-d="none" aria-pressed="true">Pure</button><button type="button" data-d="n" aria-pressed="false">n-type (add P)</button><button type="button" data-d="p" aria-pressed="false">p-type (add B)</button>
      </div>
      <label class="eb-rl eb-nrow"><span>N</span><input type="range" class="eb-n" min="13" max="18" step="0.5" value="16" aria-label="Dopant atoms per cubic centimetre" /><output class="eb-on"></output></label>
    </div>
    <p class="ax-big eb-big" style="margin:12px 0 2px"></p>
    <p class="eb-sub" style="margin:0 0 6px"></p>
    <svg class="eb-svg" viewBox="0 0 320 260" role="img" aria-label="Band diagram"></svg>
    <dl class="ax-facts eb-facts"></dl>
    <p class="lx-eq eb-eq"></p>
    <p class="ax-help">The picture is on a log scale: each extra pair of dots means about ten times more free electrons (filled dots) or holes (open circles). Carrier numbers use one rough model for every material (effective density 2.5 × 10¹⁹ cm⁻³ at 300 K), so treat them as "about".</p>
  </div>

  <div class="ax-card">
    <h2>LED colour from the band gap</h2>
    <p class="ax-help" style="margin-top:0">In an LED an electron falls from the conduction band into a hole in the valence band and gives out one photon with energy about Eg.</p>
    <label class="eb-rl"><span>Eg</span><input type="range" class="eb-led" min="1" max="3.5" step="0.01" value="1.9" aria-label="Band gap of the LED" /><output class="eb-oled"></output></label>
    <div class="eb-ledrow">
      <svg class="eb-bulb" viewBox="0 0 80 100" role="img" aria-label="LED"><path class="eb-dome" d="M14 60 V34 a26 26 0 0 1 52 0 V60 Z" /><rect x="10" y="60" width="60" height="8" rx="2" class="eb-rim" /><line x1="28" y1="68" x2="28" y2="98" class="eb-leg" /><line x1="52" y1="68" x2="52" y2="90" class="eb-leg" /></svg>
      <div><p class="ax-big eb-lam" style="margin:0"></p><p class="eb-col" style="margin:2px 0 0"></p></div>
    </div>
    <p class="lx-eq eb-leq"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lx-try">
      <li>Silicon at 300 K, then 400 K. How many times more free electrons? Why does a warm semiconductor conduct better, when a warm metal conducts worse?</li>
      <li>Compare germanium and silicon at the same temperature. Which has more free electrons, and why?</li>
      <li>Diamond: how hot must it get before you see any electrons in the conduction band?</li>
      <li>Make silicon n-type. Electrons go up, but what happens to the holes? Check that n × p stays equal to nᵢ².</li>
      <li>Find the band gap that gives a blue LED, and one that gives infrared (TV remote).</li>
    </ul>
  </div>

  <div class="ax-card cq">
    <h2>Check yourself</h2>
    <ol class="cq-list"></ol>
    <button type="button" class="btn secondary small cq-new">New questions</button>
  </div>
</div>

<style is:inline>
  .eb-rl { display: grid !important; grid-template-columns: 30px 1fr 150px; align-items: center; gap: 10px !important; margin-top: 12px; color: var(--ink) !important; }
  .eb-rl input { height: 36px; accent-color: var(--accent); }
  .eb-rl output { font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; font-size: 14px; }
  .eb-svg { display: block; width: 100%; max-width: 440px; margin: 6px auto 10px; }
  .eb .cb { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .eb .vb { fill: var(--line); stroke: var(--ink); stroke-width: 1.5; }
  .eb .el { fill: var(--accent); }
  .eb .ho { fill: var(--surface); stroke: var(--ink); stroke-width: 1.4; }
  .eb .lv { stroke: var(--ink); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .eb .gp { stroke: var(--muted); stroke-width: 1; }
  .eb .tx { fill: var(--muted); font: 12px system-ui, sans-serif; }
  .eb .tb { fill: var(--ink); font: 600 13px system-ui, sans-serif; }
  .eb-ledrow { display: flex; gap: 16px; align-items: center; margin-top: 10px; }
  .eb-bulb { width: 70px; flex: none; }
  .eb-dome { stroke: var(--ink); stroke-width: 1.5; }
  .eb-rim { fill: var(--line); stroke: var(--ink); }
  .eb-leg { stroke: var(--muted); stroke-width: 3; }
  .eb-dope[hidden] { display: none; }
</style>

<script>
  import { MATERIALS, carriers, classify, colourName, dots, egFromLambda, lambdaNm, niRatio, wavelengthRGB } from '../../lib/sci/energybands';
  import { mountQuiz, near, same, pickOne, rint, type Question } from '../../lib/chemquiz';

  const root = document.querySelector<HTMLElement>('.eb')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as T;
  const NS = 'http://www.w3.org/2000/svg';
  const sv = (tag: string, attrs: Record<string, string | number>, text?: string) => { const n = document.createElementNS(NS, tag); for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v)); if (text != null) n.textContent = text; return n; };
  const SUP: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const sci = (x: number) => { if (x === 0) return '0'; const e = Math.floor(Math.log10(x)), m = x / 10 ** e; const ms = m.toFixed(2); return (ms === '10.00' ? `1.00 × 10${String(e + 1).replace(/./g, (c) => SUP[c])}` : `${ms} × 10${String(e).replace(/./g, (c) => SUP[c])}`); };
  const times = (x: number) => (x < 1e4 ? String(Number(x.toPrecision(3))) : sci(x));
  let mat = 'si', dope: 'none' | 'n' | 'p' = 'none';

  // fixed scatter positions so dots don't jump around as you slide
  const spots = Array.from({ length: 40 }, (_, i) => [((i * 0.6180339887) % 1), ((i * 0.7548776662 + 0.31) % 1)]);

  function update() {
    root.querySelectorAll<HTMLButtonElement>('.eb-mat button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === mat)));
    root.querySelectorAll<HTMLButtonElement>('.eb-type button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.d === dope)));
    const m = MATERIALS.find((x) => x.id === mat)!;
    const T = Number(q<HTMLInputElement>('.eb-t').value), N = 10 ** Number(q<HTMLInputElement>('.eb-n').value);
    q('.eb-ot').textContent = `${T} K (${T - 273} °C)`;
    q('.eb-on').textContent = `${sci(N)} cm⁻³`;
    const semi = m.kind === 'semiconductor';
    q('.eb-dope').hidden = !semi;
    q('.eb-nrow').hidden = !semi || dope === 'none';
    const d = semi ? dope : 'none';
    const svg = q<SVGSVGElement>('.eb-svg'); svg.replaceChildren();
    const f = q('.eb-facts'); f.replaceChildren();
    const fact = (k: string, v: string, s = '') => { const dv = document.createElement('div'); const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = v; if (s) { const sm = document.createElement('small'); sm.textContent = s; dd.append(sm); } dv.append(dt, dd); f.append(dv); };
    const eq = q('.eb-eq'); eq.replaceChildren();
    const lines = (ls: string[]) => ls.forEach((t, i) => { if (i) eq.append(document.createElement('br')); eq.append(t); });
    const X0 = 60, X1 = 300;
    svg.append(sv('text', { x: 6, y: 16, class: 'tx' }, 'energy ↑'));
    if (m.kind === 'conductor') {
      svg.setAttribute('viewBox', '0 0 320 200');
      svg.append(sv('rect', { x: X0, y: 30, width: X1 - X0, height: 70, class: 'cb' }), sv('rect', { x: X0, y: 80, width: X1 - X0, height: 90, class: 'vb' }));
      svg.append(sv('text', { x: X0 + 6, y: 46, class: 'tb' }, 'conduction band'), sv('text', { x: X0 + 6, y: 162, class: 'tb' }, 'valence band'));
      svg.append(sv('text', { x: 6, y: 94, class: 'tx' }, 'overlap'));
      for (let i = 0; i < 30; i++) svg.append(sv('circle', { cx: X0 + 10 + spots[i][0] * (X1 - X0 - 20), cy: 56 + spots[i][1] * 40, r: 4, class: 'el' }));
      q('.eb-big').textContent = 'Conductor: no band gap';
      q('.eb-sub').textContent = 'The bands overlap, so electrons always have empty levels right next to them and move freely. Heating a metal makes its atoms jiggle more, which scatters the electrons, so its resistance goes up, not down.';
      fact('Band gap Eg', '0 eV', 'bands overlap'); fact('Free electrons', 'about 8.5 × 10²² cm⁻³', 'one per copper atom; hardly changes with T');
      lines(['No gap to cross: almost every outer electron is free to move.']);
      svg.setAttribute('aria-label', 'Band diagram of a metal: overlapping bands');
      return;
    }
    const gap = 20 + m.eg * 18, cbY = 30, cbH = 50, vbY = cbY + cbH + gap, vbH = 60, H = vbY + vbH + 20;
    svg.setAttribute('viewBox', `0 0 320 ${H}`);
    svg.append(sv('rect', { x: X0, y: cbY, width: X1 - X0, height: cbH, class: 'cb' }), sv('rect', { x: X0, y: vbY, width: X1 - X0, height: vbH, class: 'vb' }));
    svg.append(sv('text', { x: X1 - 6, y: cbY + 16, class: 'tb', 'text-anchor': 'end' }, 'conduction band'), sv('text', { x: X1 - 6, y: vbY + vbH - 8, class: 'tb', 'text-anchor': 'end' }, 'valence band'));
    svg.append(sv('line', { x1: 34, y1: cbY + cbH, x2: 34, y2: vbY, class: 'gp' }), sv('line', { x1: 28, y1: cbY + cbH, x2: 40, y2: cbY + cbH, class: 'gp' }), sv('line', { x1: 28, y1: vbY, x2: 40, y2: vbY, class: 'gp' }));
    svg.append(sv('text', { x: 4, y: (cbY + cbH + vbY) / 2 + 4, class: 'tb' }, `${m.eg}`), sv('text', { x: 4, y: (cbY + cbH + vbY) / 2 + 18, class: 'tx' }, 'eV'));
    const c = carriers(m.eg, T, d, N), ne = dots(c.n), nh = dots(c.p);
    if (d === 'n') { const y = cbY + cbH + 9; svg.append(sv('line', { x1: X0, y1: y, x2: X1, y2: y, class: 'lv' }), sv('text', { x: X0 + 4, y: y + 15, class: 'tx' }, 'donor level, 0.045 eV below')); }
    if (d === 'p') { const y = vbY - 9; svg.append(sv('line', { x1: X0, y1: y, x2: X1, y2: y, class: 'lv' }), sv('text', { x: X0 + 4, y: y - 6, class: 'tx' }, 'acceptor level, 0.045 eV above')); }
    for (let i = 0; i < ne; i++) svg.append(sv('circle', { cx: X0 + 10 + spots[i][0] * (X1 - X0 - 20), cy: cbY + 24 + spots[i][1] * (cbH - 30), r: 4, class: 'el' }));
    for (let i = 0; i < nh; i++) svg.append(sv('circle', { cx: X0 + 10 + spots[39 - i][0] * (X1 - X0 - 20), cy: vbY + 6 + spots[39 - i][1] * (vbH - 30), r: 4, class: 'ho' }));
    svg.setAttribute('aria-label', `Band diagram of ${m.name}: gap ${m.eg} eV, ${ne} electron dots, ${nh} hole dots`);
    const kind = classify(m.eg);
    q('.eb-big').textContent = `${kind[0].toUpperCase() + kind.slice(1)}: Eg = ${m.eg} eV`;
    const r = niRatio(m.eg, T);
    q('.eb-sub').textContent = kind === 'insulator'
      ? `The gap is so wide that heat almost never lifts an electron across it${T >= 600 ? ', even this hot' : ''}. With no free electrons and no holes, it does not conduct.`
      : d === 'none'
        ? `Heat lifts a few electrons across the gap; each leaves a hole behind, so electrons and holes are equal. ${T === 300 ? '' : `That is ${times(r >= 1 ? r : 1 / r)} times ${r >= 1 ? 'more' : 'fewer'} than at 300 K.`}`
        : d === 'n'
          ? 'Each phosphorus atom has one spare electron that needs only 0.045 eV to reach the conduction band. Electrons are now the majority carriers; holes are fewer than in pure silicon.'
          : 'Each boron atom has one electron too few, so it grabs an electron from the valence band and leaves a hole. Holes are now the majority carriers.';
    fact('Free electrons nₑ', `${sci(c.n)} cm⁻³`, d === 'n' ? 'majority carriers' : d === 'p' ? 'minority carriers' : 'equal to holes');
    fact('Holes nₕ', `${sci(c.p)} cm⁻³`, d === 'p' ? 'majority carriers' : d === 'n' ? 'minority carriers' : 'equal to electrons');
    fact('Pure-crystal nᵢ', `${sci(c.ni)} cm⁻³`, `at ${T} K`);
    if (d === 'none') lines([`nᵢ = N (T/300)^1.5 e^(−Eg / 2kT) = ${sci(c.ni)} cm⁻³`, `kT = ${(8.617333262e-5 * T).toFixed(4)} eV, Eg / 2kT = ${(m.eg / (2 * 8.617333262e-5 * T)).toFixed(1)}`]);
    else lines([d === 'n' ? `nₑ ≈ N_D = ${sci(c.n)} cm⁻³` : `nₕ ≈ N_A = ${sci(c.p)} cm⁻³`, d === 'n' ? `nₕ = nᵢ² / nₑ = (${sci(c.ni)})² / ${sci(c.n)} = ${sci(c.p)} cm⁻³` : `nₑ = nᵢ² / nₕ = (${sci(c.ni)})² / ${sci(c.p)} = ${sci(c.n)} cm⁻³`]);
  }

  function updLed() {
    const eg = Number(q<HTMLInputElement>('.eb-led').value), lam = lambdaNm(eg), [r, g, b] = wavelengthRGB(lam), name = colourName(lam);
    q('.eb-oled').textContent = `${eg.toFixed(2)} eV`;
    q('.eb-lam').textContent = `λ = ${Math.round(lam)} nm`;
    q('.eb-col').textContent = name === 'infrared' || name === 'ultraviolet' ? `${name[0].toUpperCase() + name.slice(1)}: invisible to your eyes` : `${name[0].toUpperCase() + name.slice(1)} light`;
    const dome = q<SVGPathElement>('.eb-dome'); dome.style.fill = r + g + b ? `rgb(${r},${g},${b})` : 'var(--line)';
    dome.dataset.colour = name;
    const eq = q('.eb-leq'); eq.replaceChildren('λ = hc / Eg = 1240 eV nm / ', `${eg.toFixed(2)} eV = ${Math.round(lam)} nm`);
  }

  root.querySelectorAll<HTMLButtonElement>('.eb-mat button').forEach((b) => b.addEventListener('click', () => { mat = b.dataset.m!; update(); }));
  root.querySelectorAll<HTMLButtonElement>('.eb-type button').forEach((b) => b.addEventListener('click', () => { dope = b.dataset.d as typeof dope; update(); }));
  ['.eb-t', '.eb-n'].forEach((s) => q(s).addEventListener('input', update));
  q('.eb-led').addEventListener('input', updLed);
  update(); updLed();

  mountQuiz(q('.cq'), (): Question[] => {
    const e1 = rint(16, 30) / 10, l1 = lambdaNm(e1);
    const l2 = rint(45, 70) * 10, e2 = egFromLambda(l2);
    const k3 = rint(14, 17), p3 = (1.5e10 ** 2) / 10 ** k3, m3 = p3 / 10 ** Math.floor(Math.log10(p3)), x3 = Math.floor(Math.log10(p3));
    const g4 = pickOne([0.7, 1.4, 2.2, 4, 6]), k4 = classify(g4);
    const [el5, t5] = pickOne([['phosphorus', 'n'], ['arsenic', 'n'], ['antimony', 'n'], ['boron', 'p'], ['aluminium', 'p'], ['gallium', 'p'], ['indium', 'p']] as const);
    return [
      { q: `An LED is made from a semiconductor with Eg = ${e1} eV. What wavelength does it give out, in nm? (use λ = 1240 / Eg, 3 significant figures)`, hint: 'a number', answer: String(Number((1240 / e1).toPrecision(3))), ok: near(l1, 0.01), worked: `λ = 1240 / ${e1} = ${Number((1240 / e1).toPrecision(3))} nm.` },
      { q: `Light of wavelength ${l2} nm is just able to lift an electron across a band gap. What is the gap, in eV? (2 decimal places)`, hint: 'a number', answer: (1240 / l2).toFixed(2), ok: near(e2, 0.01), worked: `Eg = 1240 / λ = 1240 / ${l2} = ${(1240 / l2).toFixed(2)} eV.` },
      { q: `Pure silicon has nᵢ = 1.5 × 10¹⁰ cm⁻³. It is doped with 10^${k3} phosphorus atoms per cm³. What is the hole density, in cm⁻³?`, hint: 'like 2.25×10^4', answer: `${m3.toFixed(2)}×10^${x3}`, ok: near(p3, 0.02), worked: `nₑ ≈ N_D = 10^${k3}, so nₕ = nᵢ² / nₑ = (1.5 × 10¹⁰)² / 10^${k3} = ${m3.toFixed(2)} × 10^${x3} cm⁻³.` },
      { q: `A solid has a band gap of ${g4} eV. Is it a conductor, a semiconductor or an insulator? (school rule: under 3 eV is a semiconductor)`, hint: 'one word', answer: k4, ok: same(k4, k4 + 's'), worked: `${g4} eV is ${g4 < 3 ? 'under' : 'over'} 3 eV, so it is ${k4 === 'insulator' ? 'an' : 'a'} ${k4}.` },
      { q: `Silicon is doped with ${el5}. Is it n-type or p-type? (answer n or p)`, hint: 'n or p', answer: t5, ok: same(t5, `${t5}-type`, `${t5}type`), worked: `${el5[0].toUpperCase() + el5.slice(1)} is in group ${t5 === 'n' ? '15 (five outer electrons, one spare)' : '13 (three outer electrons, one short)'}, so it makes ${t5}-type silicon.` },
    ];
  });
</script>
