---
// Restriction digest simulator: sites on both strands, fragments, a map and a virtual gel. The example plasmid is random
// made-up sequence; the built-in enzymes are a few classic ones whose sites are textbook facts.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import { CLASSIC } from '../../lib/sci/digest';
const plasmid = `>example made-up 3 kb plasmid
TGGCAAGGGGTCCCTAATTATGATGCGCCATGAACTCGACATCGTAGTTGAGCGCTGACC
CTAGGATGAGGAGTTGAAGCTAAAGCGAATTTACGACCTCGTAGACAAGCCTTACGGATC
