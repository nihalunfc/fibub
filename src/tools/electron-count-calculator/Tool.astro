---
// 18-electron rule checker: valence electron count, oxidation state, dⁿ and ligand bond number by the covalent (L/X)
// method, with the ionic count alongside; 15 worked examples.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import { METALS, LIGANDS, PRESETS } from '../../lib/sci/ecount';
const rows = [{ id: 'Cp', n: 2 }, { id: '', n: 0 }, { id: '', n: 0 }, { id: '', n: 0 }, { id: '', n: 0 }];
---
<div class="ax eco">
  <div class="ax-card">
    <h2>Count the electrons</h2>
    <div class="ax-grid">
      <label class="eco-wide">Start from an example <select class="eco-pre"><option value="">Your own complex</option>{PRESETS.map((p) => <option value={p.id} selected={p.id === 'ferrocene'}>{p.name}</option>)}</select></label>
      <label>Metal <select class="eco-m">{METALS.map(([s, g]) => <option value={s} selected={s === 'Fe'}>{s} (group {g})</option>)}</select></label>
      <label>Charge of the complex <input class="eco-q" inputmode="numeric" value="0" /></label>
      <label>Metal–metal bonds <input class="eco-mm" inputmode="numeric" value="0" /></label>
    </div>
    <div class="eco-rows">
      {rows.map((r, i) => (
        <div class="eco-row">
          <label>Ligand {i + 1} <select class="eco-l"><option value="">none</option>{LIGANDS.map((g) => <option value={g.id} selected={g.id === r.id}>{g.name}</option>)}</select></label>
          <label>How many <input class="eco-n" inputmode="numeric" value={r.n || ''} /></label>
        </div>
      ))}
    </div>
    <p class="ax-help">Count a chelate (en, acac) or a ring (Cp, benzene) once per ligand. For a dimer such as Mn₂(CO)₁₀, count one metal with its own ligands and its metal–metal bonds.</p>
    <p class="ax-err eco-err" hidden></p>
    <div class="eco-out">
      <p class="ax-big eco-big"></p>
      <dl class="ax-facts eco-facts"></dl>
      <h3>Ligand by ligand</h3>
      <div class="ax-scroll"><table class="eco-tab"></table></div>
    </div>
    <Downloads />
  </div>
</div>

<script>
  import { METALS, LIGANDS, PRESETS, ligand, count, verdict, roman } from '../../lib/sci/ecount';
  import { num } from '../../lib/sci/num';
  import { wireDownloads } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.eco')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const fact = (k: string, val: string, s = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = val; if (s) { const sm = document.createElement('small'); sm.textContent = s; d.querySelector('dd')!.append(sm); } return d; };
  const SUP: Record<string, string> = { '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹', '-': '⁻', '+': '⁺' };
  const sup = (s: string) => s.split('').map((c) => SUP[c] ?? c).join('');
  const chg = (q: number) => (q === 0 ? '' : sup(`${Math.abs(q) === 1 ? '' : Math.abs(q)}${q > 0 ? '+' : '-'}`));
  const rowsEl = () => [...root.querySelectorAll<HTMLElement>('.eco-row')];
  let tab: string[][] = [];

  function load(id: string) {
    const p = PRESETS.find((x) => x.id === id); if (!p) return;
    q<HTMLSelectElement>('.eco-m').value = p.m; q<HTMLInputElement>('.eco-q').value = String(p.q); q<HTMLInputElement>('.eco-mm').value = String(p.mm);
    rowsEl().forEach((r, i) => { const it = p.items[i]; r.querySelector<HTMLSelectElement>('.eco-l')!.value = it?.id ?? ''; r.querySelector<HTMLInputElement>('.eco-n')!.value = it ? String(it.n) : ''; });
  }

  function calc() {
    const err = (m: string) => { q('.eco-err').textContent = m; q('.eco-err').hidden = !m; q('.eco-out').hidden = !!m; };
    const m = q<HTMLSelectElement>('.eco-m').value, N = METALS.find((x) => x[0] === m)![1];
    const qs = q<HTMLInputElement>('.eco-q').value.trim().replace('−', '-'), mms = q<HTMLInputElement>('.eco-mm').value.trim() || '0';
    const charge = num(qs || '0'), mm = num(mms);
    if (!Number.isInteger(charge) || Math.abs(charge) > 8) return err('The charge is a whole number, such as 0, 1, −1 or 3.');
    if (!Number.isInteger(mm) || mm < 0 || mm > 4) return err('Metal–metal bonds is a whole number from 0 to 4.');
    const items: { id: string; n: number }[] = [];
    for (const [i, r] of rowsEl().entries()) {
      const id = r.querySelector<HTMLSelectElement>('.eco-l')!.value, ns = r.querySelector<HTMLInputElement>('.eco-n')!.value.trim();
      if (!id) continue;
      const n = num(ns || '1');
      if (!Number.isInteger(n) || n < 0 || n > 12) return err(`Ligand ${i + 1}: how many is a whole number from 1 to 12.`);
      if (n > 0) items.push({ id, n });
    }
    if (!items.length) return err('Choose at least one ligand.');
    const r = count(N, charge, items, mm);
    if (r.d < 0) return err(`That gives ${m} an oxidation state of +${r.os}, more than its ${N} valence electrons: check the charge and the ligand types.`);
    err('');
    q('.eco-big').textContent = `${m}(${roman(r.os)}), d${sup(String(r.d))}, ${r.ve} valence electrons`;
    const cls = `[M${r.l ? `L${r.l > 1 ? sub(r.l) : ''}` : ''}${r.x ? `X${r.x > 1 ? sub(r.x) : ''}` : ''}]${chg(charge)}`;
    const facts = [
      fact('Verdict', verdict(r.ve, r.d, r.lbn)),
      fact('Covalent count', `${N} (${m}, group ${N}) + 2 × ${r.l} (L) + ${r.x} (X)${mm ? ` + ${mm} (M–M)` : ''}${charge ? ` ${charge > 0 ? '−' : '+'} ${Math.abs(charge)} (charge)` : ''} = ${r.ve}`),
      fact('Ionic count', `${m}${chg(r.os)} d${sup(String(r.d))} + ${2 * (r.l + r.x)} from the ligands${mm ? ` + ${mm} (M–M)` : ''} = ${r.ve}`, 'each X ligand given as an anion with 2 electrons; both methods always agree'),
      fact('Oxidation state', `${r.os > 0 ? '+' : ''}${r.os}`, `charge ${charge} + ${r.x} X ligand${r.x === 1 ? '' : 's'}${mm ? '; metal–metal bonds between like atoms do not change it' : ''}`),
      fact('Bond classification', cls, `ligand bond number ${r.lbn} (L + X), a guide to how crowded the metal is`),
    ];
    q('.eco-facts').replaceChildren(...facts);
    tab = items.map((it) => { const g = ligand(it.id)!; return [g.name, String(it.n), `${g.l ? `L${g.l > 1 ? sub(g.l) : ''}` : ''}${g.x ? `X${g.x > 1 ? sub(g.x) : ''}` : ''}`, String((2 * g.l + g.x) * it.n), `${2 * (g.l + g.x) * it.n} (${g.ion})`]; });
    const t = q<HTMLTableElement>('.eco-tab'); t.replaceChildren();
    const hr = t.createTHead().insertRow(); ['Ligand', 'Count', 'Type', 'Covalent e⁻', 'Ionic e⁻'].forEach((h) => { const th = document.createElement('th'); th.textContent = h; hr.append(th); });
    const bd = t.createTBody(); for (const row of tab) { const tr = bd.insertRow(); row.forEach((c, j) => { const td = tr.insertCell(); td.textContent = c; if (j) { td.style.textAlign = 'right'; td.style.whiteSpace = 'nowrap'; } }); }
  }
  function sub(n: number) { return String(n).split('').map((c) => '₀₁₂₃₄₅₆₇₈₉'[+c]).join(''); }

  q('.eco-pre').addEventListener('change', () => { load(q<HTMLSelectElement>('.eco-pre').value); calc(); });
  root.querySelectorAll('.eco-m, .eco-q, .eco-mm, .eco-row select, .eco-row input').forEach((i) => { const h = () => { q<HTMLSelectElement>('.eco-pre').value = ''; calc(); }; i.addEventListener('input', h); i.addEventListener('change', h); });
  load('ferrocene'); calc();
  wireDownloads(q('.dl'), () => ({
    title: 'Electron count', subtitle: q<HTMLSelectElement>('.eco-pre').selectedOptions[0].textContent!, file: 'electron-count',
    sections: q('.eco-out').hidden ? [] : [{ title: q('.eco-big').textContent!, facts: [...root.querySelectorAll('.eco-facts > div')].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), table: { head: ['Ligand', 'Count', 'Type', 'Covalent e⁻', 'Ionic e⁻'], rows: tab, align: ['l', 'r', 'r', 'r', 'r'] as ('l' | 'r')[] } }],
  }));
</script>

<style is:inline>
  .eco .eco-wide { grid-column: 1 / -1; }
  .eco select { max-width: 100%; }
  .eco .eco-rows { margin-top: 10px; }
  .eco .eco-row { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); gap: 8px; margin-bottom: 8px; }
  .eco h3 { margin: 16px 0 6px; font-size: 16px; }
</style>
