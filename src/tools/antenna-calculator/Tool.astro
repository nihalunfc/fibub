---
// Antenna sizes: half-wave dipole, quarter-wave monopole, microstrip patch (transmission-line model), Yagi rules of thumb.
// Default values are an example, made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax anc">
  <div class="ax-card">
    <h2>Antenna</h2>
    <div class="ax-seg an-kind" role="group" aria-label="Antenna type">
      <button type="button" data-k="dipole" aria-pressed="true">Dipole</button><button type="button" data-k="monopole" aria-pressed="false">Monopole</button><button type="button" data-k="patch" aria-pressed="false">Patch</button><button type="button" data-k="yagi" aria-pressed="false">Yagi</button>
    </div>
    <div class="ax-grid" style="margin-top:12px">
      <label>Frequency <input class="an-f" type="text" inputmode="decimal" value="145" /></label>
      <label>Unit <select class="an-fu"><option value="1e3">kHz</option><option value="1e6" selected>MHz</option><option value="1e9">GHz</option></select></label>
      <label>Show lengths in <select class="an-lu"><option value="si" selected>metres, cm, mm</option><option value="imp">feet and inches</option></select></label>
      <label class="an-wire">Shortening factor <input class="an-k" type="text" inputmode="decimal" value="0.95" /></label>
      <label class="an-p" hidden>Substrate relative permittivity εr <input class="an-er" type="text" inputmode="decimal" value="4.4" /></label>
      <label class="an-p" hidden>Substrate thickness h (mm) <input class="an-h" type="text" inputmode="decimal" value="1.6" /></label>
      <label class="an-p" hidden>Feed line impedance for the inset (Ω) <input class="an-z0" type="text" inputmode="decimal" value="50" /></label>
      <label class="an-y" hidden>Directors <select class="an-nd"><option>0</option><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option><option>6</option><option>8</option><option>10</option></select></label>
      <label class="an-y" hidden>Reflector length (λ) <input class="an-yr" type="text" inputmode="decimal" value="0.495" /></label>
      <label class="an-y" hidden>Driven element (λ) <input class="an-yd" type="text" inputmode="decimal" value="0.473" /></label>
      <label class="an-y" hidden>First director (λ) <input class="an-y1" type="text" inputmode="decimal" value="0.44" /></label>
      <label class="an-y" hidden>Each next director shorter by (λ) <input class="an-yt" type="text" inputmode="decimal" value="0.005" /></label>
      <label class="an-y" hidden>Reflector to driven spacing (λ) <input class="an-ysr" type="text" inputmode="decimal" value="0.2" /></label>
      <label class="an-y" hidden>Director spacing (λ) <input class="an-ysd" type="text" inputmode="decimal" value="0.25" /></label>
    </div>
    <p class="ax-help an-help"></p>
    <p class="ax-err an-err" hidden></p>
  </div>

  <div class="ax-card an-out">
    <h2 class="an-title">Result</h2>
    <p class="ax-big an-big"></p>
    <dl class="ax-facts an-facts"></dl>
    <canvas class="ax-fig an-fig" style="margin-top:12px"></canvas>
    <div class="ax-scroll an-tabw" hidden><table class="an-tab"></table></div>
    <h3 style="margin:14px 0 6px">Formulas</h3>
    <ul class="an-form"></ul>
    <p class="ax-help">For study and planning. Real antennas are affected by element thickness, nearby objects, the feed and the ground; cut a little long, measure (with an antenna analyser or VNA) and trim. The example values are made up.</p>
    <Downloads />
  </div>
</div>

<script>
  import { dipole, monopole, patch, yagi, wavelength } from '../../lib/sci/eng-antenna';
  import { paint, wireDownloads, type Figure, type Section } from '../../lib/report';
  import { num, sig } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.anc')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  const val = (c: string) => num(q<HTMLInputElement>(c).value);
  const sg = (x: number, d = 4) => { const t = sig(x, d); return /^-?[\d.]+$/.test(t) ? String(parseFloat(t)) : t; };
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const factPairs = (els: HTMLElement[]) => els.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent! + (d.querySelector('small') ? ` (${d.querySelector('small')!.textContent})` : '')] as [string, string]);
  let kind = 'dipole', fig: Figure | null = null, report: Section[] = [];

  /** A length in metres, written in the chosen units. */
  const len = (m: number) => {
    if (sel('.an-lu') === 'imp') { const inch = m / 0.0254; return inch >= 36 ? `${Math.floor(inch / 12)} ft ${sg(inch - 12 * Math.floor(inch / 12), 3)} in` : `${sg(inch, 4)} in`; }
    return m >= 1 ? `${sg(m, 5)} m` : m >= 0.01 ? `${sg(m * 100, 4)} cm` : `${sg(m * 1000, 4)} mm`;
  };
  const freqTxt = (f: number) => (f >= 1e9 ? `${sg(f / 1e9, 6)} GHz` : f >= 1e6 ? `${sg(f / 1e6, 6)} MHz` : `${sg(f / 1e3, 6)} kHz`);

  function calc() {
    root.querySelectorAll<HTMLButtonElement>('.an-kind button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === kind)));
    q('.an-wire').hidden = !(kind === 'dipole' || kind === 'monopole');
    root.querySelectorAll<HTMLElement>('.an-p').forEach((e) => (e.hidden = kind !== 'patch'));
    root.querySelectorAll<HTMLElement>('.an-y').forEach((e) => (e.hidden = kind !== 'yagi'));
    q('.an-help').textContent = {
      dipole: 'A half-wave dipole is two equal wires fed in the middle. The shortening factor allows for the end effect and wire thickness: about 0.95 to 0.98 for thin wire, less for thick tubes.',
      monopole: 'A quarter-wave monopole (a whip or ground-plane antenna) is half a dipole standing on a conducting ground plane or radials, which act as a mirror.',
      patch: 'A rectangular patch on a printed circuit board, sized with the transmission-line model. Use your board maker\'s εr at the working frequency (FR-4 is very roughly 4.2 to 4.7; low-loss RF laminates 2 to 3.5). The inset feed cuts notches so a feed line of the chosen impedance meets the patch at a matching point.',
      yagi: 'A Yagi-Uda beam: one driven element, a longer reflector behind and shorter directors in front. The starting values are common rules of thumb (in wavelengths); a real design is tuned with a modelling program such as NEC, as lengths also depend on element thickness and how the elements are mounted on the boom.',
    }[kind]!;
    const err = q('.an-err'), out = q('.an-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; };
    const f = val('.an-f') * +sel('.an-fu');
    if (!(f > 0)) return fail('Give the frequency (more than 0).');
    if (f < 1e3 || f > 3e12) return fail('Give a frequency between 1 kHz and 3,000 GHz.');
    const lam = wavelength(f);
    let facts: HTMLElement[] = [], forms: string[] = [], big = '', title = '';
    q('.an-tabw').hidden = true;
    if (kind === 'dipole' || kind === 'monopole') {
      const k = val('.an-k');
      if (!(k >= 0.5 && k <= 1)) return fail('Give a shortening factor between 0.5 and 1 (0.95 is a usual start).');
      if (kind === 'dipole') {
        const d = dipole(f, k);
        title = 'Half-wave dipole'; big = `Total length ${len(d.length)}, each side ${len(d.leg)}`;
        facts = [fact('Wavelength λ', len(d.lambda), `c / f at ${freqTxt(f)}`), fact('Free-space λ/2', len(d.half), 'before the shortening factor'), fact('Cut length', len(d.length), `λ/2 × ${sg(k, 3)}; two legs of ${len(d.leg)} with a small gap at the feed`), fact('Feed resistance', 'about 73 Ω', 'thin, resonant dipole in free space; lower close to the ground'), fact('Gain', '2.15 dBi', 'ideal half-wave dipole')];
        forms = ['λ = c / f, with c = 299,792,458 m/s', 'L = k × λ / 2 (k: shortening factor)', 'Each leg = L / 2'];
        fig = drawWire(d.length, true);
      } else {
        const m = monopole(f, k);
        title = 'Quarter-wave monopole'; big = `Element length ${len(m.length)}`;
        facts = [fact('Wavelength λ', len(m.lambda), `c / f at ${freqTxt(f)}`), fact('Free-space λ/4', len(m.quarter), 'before the shortening factor'), fact('Cut length', len(m.length), `λ/4 × ${sg(k, 3)}`), fact('Radials or ground plane', `at least ${len(m.quarter)} across`, 'radials about λ/4 long; sloping them down raises the feed resistance towards 50 Ω'), fact('Feed resistance', 'about 37 Ω', 'over a perfect ground plane (half the dipole value)'), fact('Gain', '5.15 dBi', 'ideal, over an infinite ground plane')];
        forms = ['λ = c / f', 'L = k × λ / 4', 'R ≈ 73 Ω / 2 ≈ 36.5 Ω (image theory)'];
        fig = drawWire(m.length, false);
      }
    } else if (kind === 'patch') {
      const er = val('.an-er'), h = val('.an-h') / 1000, z0 = val('.an-z0');
      if (!(er >= 1 && er <= 30)) return fail('Give a relative permittivity between 1 and 30.');
      if (!(h > 0)) return fail('Give the substrate thickness in mm.');
      if (h > 0.1 * lam) return fail(`The substrate is too thick for this model at ${freqTxt(f)}: keep h below λ/10 (${len(lam / 10)}).`);
      if (!(z0 > 0)) return fail('Give the feed line impedance in ohms (50 is usual).');
      const p = patch(f, er, h, z0);
      title = 'Rectangular microstrip patch'; big = `Patch ${len(p.W)} wide × ${len(p.L)} long`;
      facts = [
        fact('Width W', len(p.W), 'for good radiation efficiency'),
        fact('Length L', len(p.L), `the resonant length (λg/2 = ${len(p.lambdag / 2)}) minus 2ΔL`),
        fact('Effective permittivity εeff', sg(p.eeff, 4), 'part of the field runs in the air above the board'),
        fact('Fringing extension ΔL', len(p.dL), 'each radiating edge looks this much longer'),
        fact('Edge resistance', `${sg(p.Rin, 4)} Ω`, `1 / (2(G1 + G12)), G1 = ${sg(p.G1 * 1000, 4)} mS, G12 = ${sg(p.G12 * 1000, 4)} mS`),
        fact(`Inset depth for ${sg(z0, 4)} Ω`, p.inset === null ? 'not needed' : len(p.inset), p.inset === null ? 'the edge resistance is already below the feed impedance' : 'from the edge to the feed point, along the length'),
        fact('Ground plane at least', `${len(p.groundW)} × ${len(p.groundL)}`, 'rule of thumb: patch + 6h each way'),
        fact('Free-space and guided wavelength', `${len(p.lambda0)}, ${len(p.lambdag)}`, 'λ0 = c/f, λg = λ0/√εeff'),
      ];
      forms = ['W = c / (2f) × √(2 / (εr + 1))', 'εeff = (εr + 1)/2 + (εr − 1)/2 × (1 + 12h/W)^(−1/2)', 'ΔL = 0.412h (εeff + 0.3)(W/h + 0.264) / ((εeff − 0.258)(W/h + 0.8))', 'L = c / (2f√εeff) − 2ΔL', 'G1 = (1/120π²) ∫₀^π [sin(k0W cosθ / 2) / cosθ]² sin³θ dθ, and G12 the same with J0(k0L sinθ) inside', 'Rin = 1 / (2(G1 + G12)); inset y0 = (L/π) acos(√(Z0 / Rin))'];
      fig = drawPatch(p.W, p.L, p.inset, p.W * 0.08);
    } else {
      const nd = +sel('.an-nd'), o = { refl: val('.an-yr'), driven: val('.an-yd'), dir1: val('.an-y1'), taper: val('.an-yt'), sRefl: val('.an-ysr'), sDir: val('.an-ysd') };
      if (Object.values(o).some((v) => !(v >= 0 && v < 2))) return fail('Give each Yagi ratio as a fraction of a wavelength (for example 0.25).');
      if (o.dir1 - (nd - 1) * o.taper <= 0.2) return fail('The directors get too short; make the step between them smaller.');
      const y = yagi(f, nd, o);
      title = 'Yagi-Uda beam (rule of thumb)'; big = `${y.elements.length} elements on a ${len(y.boom)} boom`;
      facts = [fact('Wavelength λ', len(lam), `c / f at ${freqTxt(f)}`), fact('Boom length', len(y.boom), `${sg(y.boom / lam, 3)} λ from reflector to the last element`), fact('Driven element', len(y.elements[1].length), 'fed like a dipole; its impedance in a Yagi is usually 20 to 30 Ω, so a matching section is needed for 50 Ω')];
      const tab = q<HTMLTableElement>('.an-tab'); tab.replaceChildren();
      const tr = (c: string[], th = false) => { const r = document.createElement('tr'); c.forEach((x, j) => { const e = document.createElement(th ? 'th' : 'td'); e.textContent = x; if (j) e.className = 'r'; r.append(e); }); return r; };
      tab.append(tr(['Element', 'Length', '× λ', 'Position'], true), ...y.elements.map((e) => tr([e.name, len(e.length), sg(e.length / lam, 3), len(e.position)])));
      q('.an-tabw').hidden = false;
      forms = ['λ = c / f', `Reflector ≈ ${o.refl} λ, driven ≈ ${o.driven} λ, directors ≈ ${o.dir1} λ getting ${o.taper} λ shorter each`, `Spacing: reflector ${o.sRefl} λ behind the driven element, directors every ${o.sDir} λ`, 'These are approximate starting values, not an optimised design.'];
      fig = drawYagi(y.elements, lam);
      err.hidden = true; out.hidden = false;
      finish(title, big, facts, forms, { head: ['Element', 'Length', '× λ', 'Position'], rows: y.elements.map((e) => [e.name, len(e.length), sg(e.length / lam, 3), len(e.position)]) });
      return;
    }
    err.hidden = true; out.hidden = false;
    finish(title, big, facts, forms);
  }
  function finish(title: string, big: string, facts: HTMLElement[], forms: string[], table?: { head: string[]; rows: string[][] }) {
    q('.an-title').textContent = title; q('.an-big').textContent = big;
    q('.an-facts').replaceChildren(...facts);
    q('.an-form').replaceChildren(...forms.map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
    paint(q<HTMLCanvasElement>('.an-fig'), fig!);
    report = [{ title: `${title}: ${big}`, facts: factPairs(facts), figure: fig!, ...(table ? { table } : {}), text: forms }];
  }

  // Drawings (not to scale for the wires; to scale for the patch and the Yagi).
  function drawWire(L: number, dip: boolean): Figure {
    return { w: 380, h: 150, alt: dip ? `Dipole, total length ${len(L)}` : `Monopole, length ${len(L)}`, draw: (ctx, W, H, pal) => {
      ctx.strokeStyle = pal.ink; ctx.lineWidth = 3; ctx.fillStyle = pal.muted; ctx.font = '11px system-ui, sans-serif'; ctx.textAlign = 'center';
      if (dip) {
        const y = 60, a = 30, b = W - 30, m = W / 2;
        ctx.beginPath(); ctx.moveTo(a, y); ctx.lineTo(m - 5, y); ctx.moveTo(m + 5, y); ctx.lineTo(b, y); ctx.stroke();
        ctx.lineWidth = 1.2; ctx.strokeStyle = pal.accent; ctx.beginPath(); ctx.moveTo(m - 5, y); ctx.lineTo(m - 5, y + 40); ctx.moveTo(m + 5, y); ctx.lineTo(m + 5, y + 40); ctx.stroke();
        ctx.fillText('feed', m, y + 54);
        ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(a, y - 20); ctx.lineTo(b, y - 20); ctx.moveTo(a, y - 25); ctx.lineTo(a, y - 15); ctx.moveTo(b, y - 25); ctx.lineTo(b, y - 15); ctx.stroke();
        ctx.fillStyle = pal.ink; ctx.fillText(`L = ${len(L)}`, m, y - 28);
        ctx.fillStyle = pal.muted; ctx.fillText(`${len(L / 2)}`, (a + m) / 2, y + 16); ctx.fillText(`${len(L / 2)}`, (m + b) / 2, y + 16);
      } else {
        const x = W / 2, g = H - 30, t = 20;
        ctx.beginPath(); ctx.moveTo(x, g - 4); ctx.lineTo(x, t); ctx.stroke();
        ctx.strokeStyle = pal.muted; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(40, g); ctx.lineTo(W - 40, g); ctx.stroke();
        for (let i = 40; i < W - 40; i += 12) { ctx.beginPath(); ctx.moveTo(i, g); ctx.lineTo(i - 6, g + 7); ctx.lineWidth = 1; ctx.stroke(); }
        ctx.fillStyle = pal.ink; ctx.textAlign = 'left'; ctx.fillText(`L = ${len(L)}`, x + 10, (g + t) / 2);
        ctx.fillStyle = pal.muted; ctx.fillText('ground plane or radials', 42, g + 20);
      }
    } };
  }
  function drawPatch(Wp: number, Lp: number, inset: number | null, feedW: number): Figure {
    return { w: 380, h: 260, alt: `Patch ${len(Wp)} by ${len(Lp)}${inset ? `, inset ${len(inset)}` : ''}`, draw: (ctx, W, H, pal) => {
      const sc = Math.min((W - 120) / Wp, (H - 90) / (Lp * 1.45)), pw = Wp * sc, pl = Lp * sc, x0 = (W - pw) / 2, y0 = 30;
      const fw = Math.max(3, feedW * sc), ins = (inset ?? 0) * sc, gap = Math.max(3, fw * 0.6), cx = W / 2;
      ctx.fillStyle = pal.red ? pal.twilight : '#c58a2a';
      ctx.beginPath();
      ctx.moveTo(x0, y0); ctx.lineTo(x0 + pw, y0); ctx.lineTo(x0 + pw, y0 + pl);
      ctx.lineTo(cx + fw / 2 + gap, y0 + pl); ctx.lineTo(cx + fw / 2 + gap, y0 + pl - ins); ctx.lineTo(cx + fw / 2, y0 + pl - ins);
      ctx.lineTo(cx + fw / 2, H - 22); ctx.lineTo(cx - fw / 2, H - 22); ctx.lineTo(cx - fw / 2, y0 + pl - ins);
      ctx.lineTo(cx - fw / 2 - gap, y0 + pl - ins); ctx.lineTo(cx - fw / 2 - gap, y0 + pl); ctx.lineTo(x0, y0 + pl); ctx.closePath(); ctx.fill();
      ctx.strokeStyle = pal.ink; ctx.lineWidth = 1; ctx.stroke();
      ctx.fillStyle = pal.ink; ctx.font = '11px system-ui, sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(`W = ${len(Wp)}`, cx, y0 - 8);
      ctx.save(); ctx.translate(x0 - 10, y0 + pl / 2); ctx.rotate(-Math.PI / 2); ctx.fillText(`L = ${len(Lp)}`, 0, 0); ctx.restore();
      ctx.fillStyle = pal.muted; ctx.fillText('feed line', cx, H - 8);
      if (inset) { ctx.textAlign = 'left'; ctx.fillText(`inset ${len(inset)} deep`, cx + fw / 2 + 8, y0 + pl + 14); }
      ctx.textAlign = 'left'; ctx.fillText('radiating edges: top and bottom', cx + fw / 2 + 8, y0 + pl + 30);
    } };
  }
  function drawYagi(el: { name: string; length: number; position: number }[], lam: number): Figure {
    return { w: 380, h: 220, alt: `Yagi layout with ${el.length} elements`, draw: (ctx, W, H, pal) => {
      const boom = el[el.length - 1].position, maxL = Math.max(...el.map((e) => e.length));
      const sc = Math.min((W - 60) / Math.max(boom, 0.2 * lam), (H - 60) / maxL), x0 = 30, cy = (H - 20) / 2;
      ctx.strokeStyle = pal.muted; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(x0 - 10, cy); ctx.lineTo(x0 + boom * sc + 10, cy); ctx.stroke();
      ctx.font = '10px system-ui, sans-serif'; ctx.textAlign = 'center';
      el.forEach((e, i) => {
        const x = x0 + e.position * sc, hl = (e.length * sc) / 2;
        ctx.strokeStyle = i === 1 ? pal.accent : pal.ink; ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(x, cy - hl); ctx.lineTo(x, cy + hl); ctx.stroke();
        ctx.fillStyle = pal.muted; ctx.fillText(i === 0 ? 'R' : i === 1 ? 'DE' : `D${i - 1}`, x, cy + hl + 12);
      });
      ctx.fillStyle = pal.ink; ctx.textAlign = 'left'; ctx.fillText('beam direction →', W - 110, H - 6);
    } };
  }

  root.querySelectorAll<HTMLButtonElement>('.an-kind button').forEach((b) => b.addEventListener('click', () => { kind = b.dataset.k!; if (kind === 'patch' && sel('.an-fu') !== '1e9') { q<HTMLInputElement>('.an-f').value = '2.45'; q<HTMLSelectElement>('.an-fu').value = '1e9'; } calc(); }));
  root.querySelectorAll('input, select').forEach((i) => { i.addEventListener('input', calc); i.addEventListener('change', calc); });
  document.addEventListener('fibub:theme', () => { if (fig && report.length) paint(q<HTMLCanvasElement>('.an-fig'), fig); });
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'Antenna calculator', subtitle: q('.an-big').textContent ?? '', file: `antenna-${kind}`, sections: report }));
</script>

<style is:global>
  .anc select, .anc input { max-width: 100%; }
  .anc .an-form { margin: 0; padding-left: 20px; font-size: 14px; line-height: 1.6; }
  .anc .an-form li { overflow-wrap: anywhere; }
  .anc .an-tab td { white-space: nowrap; }
</style>
