  .gro [hidden] { display: none !important; }
  .gro h3 { font-size: 15px; margin: 16px 0 6px; }
  .gro .gr-brow, .gro .gr-wrow { margin-top: 10px; }
  .gro .gr-data { margin-top: 6px; }
  .gro .gr-sub { margin: 2px 0 12px; }
  .gro .gr-pickl { max-width: 320px; margin-bottom: 10px; }
  .gro .gr-warn { margin: 10px 0 0; padding-left: 20px; color: var(--bad); font-size: 14px; }
  .gro .gr-warn:empty { display: none; }
  .gro .gr-mh { margin-top: 18px; }
  .gro .gr-dlrow { margin-top: 14px; }
  .gro .gr-sum th, .gro .gr-sum td { white-space: nowrap; }
  .gro select { max-width: 100%; }
</style>
