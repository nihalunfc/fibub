---
// #1789 Image to text (OCR). Reader: src/lib/ocr.ts (tesseract.js, self-hosted in public/ocr/).
import { OCR_LANGS } from '../../lib/ocr';
---
<div class="tool-ui ocr">
  <div class="ocr-row">
    <label class="btn ocr-pick">Add images or a PDF <input class="ocr-file" type="file" accept="image/*,application/pdf" multiple /></label>
    <label class="btn secondary ocr-pick">Take a photo <input class="ocr-cam" type="file" accept="image/*" capture="environment" /></label>
  </div>
  <div class="ocr-row">
    <label>Language <select class="ocr-lang">{OCR_LANGS.map((l) => <option value={l.id}>{l.name} ({l.mb} MB)</option>)}</select></label>
    <label class="ocr-chk"><input class="ocr-clean" type="checkbox" checked /> Clean up first</label>
  </div>
  <p class="ocr-help">Clean up first turns the picture grey and evens out shadows, which helps with phone photos. Untick it for clear screenshots. You can also paste a picture (Ctrl+V or ⌘+V).</p>
  <p class="ocr-msg" role="status" aria-live="polite">Add a picture with text in it. Nothing is uploaded: the reader runs in your browser.</p>
  <progress class="ocr-bar" max="1" value="0" hidden></progress>
  <div class="ocr-out" hidden>
    <div class="ocr-views">
      <div class="ocr-pic"><canvas class="ocr-prev" aria-label="Picture with the words found"></canvas></div>
      <textarea class="ocr-text" rows="14" spellcheck="true" aria-label="Text found"></textarea>
    </div>
    <div class="ocr-row">
      <button class="btn small ocr-copy" type="button">Copy text</button>
      <button class="btn secondary small ocr-txt" type="button">Download .txt</button>
      <button class="btn secondary small ocr-rot" type="button">Turn and read again</button>
      <label class="ocr-chk"><input class="ocr-boxes" type="checkbox" checked /> Show word boxes</label>
    </div>
    <p class="ocr-note">Boxes in orange are words the reader was unsure about (under 60% sure): check those first. Page <span class="ocr-pn">1</span> of <span class="ocr-pt">1</span> is in the picture; <span class="ocr-nav"><button class="btn secondary small ocr-prevpg" type="button">Previous</button> <button class="btn secondary small ocr-nextpg" type="button">Next</button></span></p>
  </div>
</div>

<style is:inline>
  .ocr { display: grid; gap: .75rem; }
  .ocr-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .ocr-pick { position: relative; overflow: hidden; cursor: pointer; }
  .ocr-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .ocr-chk { display: inline-flex; gap: .35rem; align-items: center; }
  .ocr-help, .ocr-msg, .ocr-note { margin: 0; } .ocr-help, .ocr-note { font-size: .9rem; color: var(--muted); }
  .ocr-msg.err { color: var(--warn); }
  .ocr-bar { width: 100%; height: 10px; } .ocr-bar[hidden], .ocr-out[hidden] { display: none; }
  .ocr-out { display: grid; gap: .75rem; }
  .ocr-views { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: .75rem; }
  .ocr-pic { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 6px; display: grid; place-items: center; }
  .ocr-pic canvas { max-width: 100%; max-height: 60vh; }
  .ocr-text { width: 100%; box-sizing: border-box; min-height: 16rem; font: inherit; line-height: 1.5; padding: .6rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--ink); resize: vertical; }
  .ocr-text[dir=rtl] { text-align: right; }
</style>

<script>
  import { recognise, preload, OCR_LANGS, type OcrWord } from '../../lib/ocr';
  import { loadPdfJs } from '../../lib/compress/pdf';
  const root = document.querySelector('.ocr') as HTMLElement;
  const $ = <T extends Element>(s: string) => root.querySelector(s) as T;
  const msg = $<HTMLElement>('.ocr-msg'), bar = $<HTMLProgressElement>('.ocr-bar'), out = $<HTMLElement>('.ocr-out');
  const prev = $<HTMLCanvasElement>('.ocr-prev'), ta = $<HTMLTextAreaElement>('.ocr-text'), langSel = $<HTMLSelectElement>('.ocr-lang');
  const clean = $<HTMLInputElement>('.ocr-clean'), boxes = $<HTMLInputElement>('.ocr-boxes');
  interface Pg { c: HTMLCanvasElement; words: OcrWord[]; text: string; conf: number }
  let pages: Pg[] = [], cur = 0, running = false;
  const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('err', err); };

  const STATUS: Record<string, string> = {
    'loading tesseract core': 'Loading the reader (first time only)',
    'loading language traineddata': 'Loading the language file (first time only)',
    'initializing api': 'Starting the reader', 'recognizing text': 'Reading',
  };

  function fit(src: CanvasImageSource, w: number, h: number, max = 2600) {
    const k = Math.min(1, max / Math.max(w, h)), c = document.createElement('canvas');
    c.width = Math.round(w * k); c.height = Math.round(h * k); c.getContext('2d')!.drawImage(src, 0, 0, c.width, c.height); return c;
  }
  /** Grey, then divide by a blurred copy (evens out shadows), then stretch contrast. */
  function cleanUp(c: HTMLCanvasElement) {
    const x = c.getContext('2d', { willReadFrequently: true })!, d = x.getImageData(0, 0, c.width, c.height), p = d.data;
    const bg = document.createElement('canvas'), s = 1 / 16; bg.width = Math.max(1, Math.round(c.width * s)); bg.height = Math.max(1, Math.round(c.height * s));
    const bx = bg.getContext('2d', { willReadFrequently: true })!; bx.filter = 'blur(2px)'; bx.drawImage(c, 0, 0, bg.width, bg.height);
    const big = document.createElement('canvas'); big.width = c.width; big.height = c.height;
    const gx = big.getContext('2d', { willReadFrequently: true })!; gx.imageSmoothingEnabled = true; gx.drawImage(bg, 0, 0, c.width, c.height);
    const b = gx.getImageData(0, 0, c.width, c.height).data;
    for (let i = 0; i < p.length; i += 4) {
      const g = 0.299 * p[i] + 0.587 * p[i + 1] + 0.114 * p[i + 2], m = Math.max(1, 0.299 * b[i] + 0.587 * b[i + 1] + 0.114 * b[i + 2]);
      let v = Math.min(255, (g / m) * 255); v = v > 235 ? 255 : Math.max(0, (v - 40) * 255 / 195);
      p[i] = p[i + 1] = p[i + 2] = v;
    }
    const o = document.createElement('canvas'); o.width = c.width; o.height = c.height; o.getContext('2d')!.putImageData(d, 0, 0); return o;
  }
  function turn(c: HTMLCanvasElement) {
    const o = document.createElement('canvas'); o.width = c.height; o.height = c.width;
    const x = o.getContext('2d')!; x.translate(o.width / 2, o.height / 2); x.rotate(Math.PI / 2); x.drawImage(c, -c.width / 2, -c.height / 2); return o;
  }

  async function toCanvases(files: File[]) {
    const list: HTMLCanvasElement[] = [];
    for (const f of files) {
      try {
        if (f.type === 'application/pdf' || /\.pdf$/i.test(f.name)) {
          const pdfjs = await loadPdfJs(), doc = await pdfjs.getDocument({ data: new Uint8Array(await f.arrayBuffer()) }).promise;
          for (let i = 1; i <= doc.numPages; i++) {
            say(`Opening page ${i} of ${doc.numPages}...`);
            const pg = await doc.getPage(i), v1 = pg.getViewport({ scale: 1 }), vp = pg.getViewport({ scale: Math.min(3, 2400 / Math.max(v1.width, v1.height)) });
            const c = document.createElement('canvas'); c.width = Math.round(vp.width); c.height = Math.round(vp.height);
            const x = c.getContext('2d')!; x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height);
            await pg.render({ canvasContext: x, viewport: vp }).promise; list.push(c);
          }
        } else { const bmp = await createImageBitmap(f); list.push(fit(bmp, bmp.width, bmp.height)); bmp.close(); }
      } catch { say(`${f.name} could not be opened as a picture or PDF.`, true); }
    }
    return list;
  }

  async function readAll(list: HTMLCanvasElement[]) {
    if (!list.length || running) return; running = true; bar.hidden = false; bar.value = 0;
    const lang = langSel.value, done: Pg[] = [];
    try {
      for (let i = 0; i < list.length; i++) {
        const src = clean.checked ? cleanUp(list[i]) : list[i];
        const r = await recognise(src, lang, (p, st) => {
          bar.value = st === 'recognizing text' ? (i + p) / list.length : p;
          say(`${STATUS[st] || 'Working'}${list.length > 1 ? `, page ${i + 1} of ${list.length}` : ''}... ${Math.round(p * 100)}%`);
        });
        done.push({ c: list[i], words: r.words, text: r.text, conf: r.conf });
      }
      pages = done; cur = 0; show();
      const n = done.reduce((s, p) => s + p.words.filter((w) => w.text.trim()).length, 0), avg = Math.round(done.reduce((s, p) => s + p.conf, 0) / done.length);
      root.dataset.done = String(Date.now());
      say(n ? `Found ${n} word${n === 1 ? '' : 's'} on ${done.length} page${done.length === 1 ? '' : 's'}. The reader is ${avg}% sure overall. Check and edit the text before you use it.` : 'No text was found. Try a sharper picture, the right language, or untick Clean up first.', !n);
    } catch (e: any) { say((e && e.message) || 'The reader could not start. Reload the page and try again.', true); }
    finally { running = false; bar.hidden = true; }
  }

  function show() {
    out.hidden = !pages.length; if (!pages.length) return;
    const rtl = OCR_LANGS.find((l) => l.id === langSel.value)?.rtl; ta.dir = rtl ? 'rtl' : 'ltr';
    ta.value = pages.length === 1 ? pages[0].text : pages.map((p, i) => `--- Page ${i + 1} ---\n${p.text}`).join('\n\n');
    ($('.ocr-nav') as HTMLElement).hidden = pages.length < 2; $('.ocr-pt').textContent = String(pages.length);
    draw();
  }
  function draw() {
    const p = pages[cur]; if (!p) return; $('.ocr-pn').textContent = String(cur + 1);
    const k = Math.min(1, 900 / Math.max(p.c.width, p.c.height)); prev.width = Math.round(p.c.width * k); prev.height = Math.round(p.c.height * k);
    const x = prev.getContext('2d')!; x.drawImage(p.c, 0, 0, prev.width, prev.height);
    if (boxes.checked) for (const w of p.words) {
      if (!w.text.trim()) continue; x.lineWidth = 2; x.strokeStyle = w.conf < 60 ? '#e06c00' : '#0a7cff';
      x.strokeRect(w.bbox.x0 * k, w.bbox.y0 * k, (w.bbox.x1 - w.bbox.x0) * k, (w.bbox.y1 - w.bbox.y0) * k);
    }
  }

  async function take(files: File[]) { if (!files.length) return; say('Opening...'); readAll(await toCanvases(files)); }
  for (const sel of ['.ocr-file', '.ocr-cam']) $<HTMLInputElement>(sel).addEventListener('change', (e) => { const i = e.target as HTMLInputElement, fs = [...(i.files || [])]; i.value = ''; take(fs); });
  document.addEventListener('paste', (e) => {
    const fs = [...(e.clipboardData?.files || [])].filter((f) => f.type.startsWith('image/'));
    if (fs.length && !(e.target as HTMLElement)?.closest?.('textarea, input')) { e.preventDefault(); take(fs); }
  });
  langSel.addEventListener('change', () => { preload(langSel.value as any).catch(() => {}); if (pages.length) readAll(pages.map((p) => p.c)); });
  clean.addEventListener('change', () => { if (pages.length) readAll(pages.map((p) => p.c)); });
  boxes.addEventListener('change', draw);
  $('.ocr-rot').addEventListener('click', () => { if (pages[cur]) { const list = pages.map((p) => p.c); list[cur] = turn(list[cur]); readAll(list); } });
  $('.ocr-prevpg').addEventListener('click', () => { if (cur > 0) { cur--; draw(); } });
  $('.ocr-nextpg').addEventListener('click', () => { if (cur < pages.length - 1) { cur++; draw(); } });
  $('.ocr-copy').addEventListener('click', async () => { try { await navigator.clipboard.writeText(ta.value); say('Copied.'); } catch { ta.select(); say('Select all and copy (Ctrl+C or ⌘+C).'); } });
  $('.ocr-txt').addEventListener('click', () => {
    const a = document.createElement('a'), u = URL.createObjectURL(new Blob([ta.value], { type: 'text/plain;charset=utf-8' }));
    a.href = u; a.download = 'text.txt'; a.click(); setTimeout(() => URL.revokeObjectURL(u), 1000);
  });
</script>
