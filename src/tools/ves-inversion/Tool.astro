---
// Vertical electrical sounding: apparent resistivity from Schlumberger or Wenner readings, layered-earth forward
// model by linear filters and damped least-squares inversion. The example sounding is made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
// Made-up sounding over 120 ohm·m (3 m) on 25 ohm·m (12 m) on 400 ohm·m, with 2 % noise; current 100 mA.
const demo = 'AB/2\tMN/2\tdV_mV\tI_mA\n1\t0.5\t4992\t100\n1.5\t0.5\t1832\t100\n2.2\t0.5\t789.9\t100\n3.2\t0.5\t339.4\t100\n4.6\t0.5\t138.9\t100\n6.8\t0.5\t45\t100\n10\t0.5\t14.05\t100\n15\t0.5\t5.162\t100\n22\t5\t29.47\t100\n32\t5\t18.3\t100\n46\t5\t11.59\t100\n68\t5\t7.024\t100\n100\t5\t4.342\t100\n150\t5\t2.656\t100\n220\t5\t1.493\t100\n300\t5\t0.8957\t100';
---
<div class="ax ves">
  <div class="ax-card">
    <h2>Sounding</h2>
    <div class="ax-grid">
      <label>Array <select class="vs-arr"><option value="schlumberger" selected>Schlumberger</option><option value="wenner">Wenner</option></select></label>
      <label>Columns hold <select class="vs-col"><option value="field" selected>field readings (ΔV in mV, I in mA)</option><option value="rhoa">apparent resistivity (Ω·m)</option></select></label>
    </div>
    <p class="ax-help vs-colh"></p>
    <textarea class="vs-data" rows="9" spellcheck="false">{demo}</textarea>
    <DataFile target=".vs-data" maxCols={6} maxRows={2000} label="Open a file" />
    <p class="ax-err vs-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Layered model</h2>
    <div class="ax-grid">
      <label>Layers <select class="vs-n"><option>2</option><option selected>3</option><option>4</option><option>5</option><option>6</option></select></label>
      <label>Starting resistivities (Ω·m, top down) <input class="vs-r0" type="text" placeholder="automatic" /></label>
      <label>Starting thicknesses (m) <input class="vs-h0" type="text" placeholder="automatic" /></label>
    </div>
    <label class="ax-check" style="margin-top:10px"><input type="checkbox" class="vs-fix" /> Forward model only (no inversion): draw the curve for the starting model</label>
    <p class="ax-help">Inversion adjusts the logarithms of all resistivities and thicknesses by damped least squares until the model curve matches the readings. Use as few layers as the curve needs. The example sounding is made up.</p>
  </div>

  <div class="ax-card vs-out">
    <h2>Result</h2>
    <p class="ax-big vs-big"></p>
    <dl class="ax-facts vs-facts"></dl>
    <div class="ax-scroll" style="margin-top:12px"><table class="vs-ltab"></table></div>
    <canvas class="ax-fig vs-fig" style="margin-top:12px"></canvas>
    <canvas class="ax-fig vs-col2" style="margin-top:12px"></canvas>
    <div class="ax-scroll" style="margin-top:12px"><table class="vs-tab"></table></div>
    <div class="ax-row" style="margin-top:12px"><button type="button" class="btn secondary small vs-csv">Download readings and fit (CSV)</button></div>
    <Downloads />
  </div>
</div>

<script>
  import { invert, startModel, forward, schlumbergerIdeal, wenner, kSchlumberger, kWenner, type Model, type Reading, type Array_ } from '../../lib/sci/ves';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, numericColumns, sig, csv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.ves')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const tr = (cells: string[], th = false) => { const e = document.createElement('tr'); cells.forEach((c, j) => { const d = document.createElement(th ? 'th' : 'td'); d.textContent = c; if (j) d.className = 'r'; e.append(d); }); return e; };
  const list = (s: string) => s.split(/[\s,;]+/).filter(Boolean).map(num);
  const COLS: Record<string, string> = {
    'schlumberger field': 'Columns: AB/2 (m), MN/2 (m), ΔV (mV), I (mA). K = π(AB/2² − MN/2²) ÷ MN and ρa = K ΔV/I.',
    'schlumberger rhoa': 'Columns: AB/2 (m) and ρa, or AB/2, MN/2 and ρa. Without MN/2 the model uses the ideal Schlumberger curve (MN very small).',
    'wenner field': 'Columns: spacing a (m), ΔV (mV), I (mA). K = 2πa and ρa = K ΔV/I.',
    'wenner rhoa': 'Columns: spacing a (m) and ρa (Ω·m).',
  };
  let figs: Figure[] = [], report: Section[] = [], csvRows: (string | number)[][] = [];

  function calc() {
    const err = q('.vs-err'), out = q('.vs-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; };
    const arr = sel('.vs-arr') as Array_, mode = sel('.vs-col'), n = Number(sel('.vs-n'));
    q('.vs-colh').textContent = COLS[`${arr} ${mode}`];
    const tab = numericColumns(q<HTMLTextAreaElement>('.vs-data').value);
    const need = arr === 'schlumberger' ? (mode === 'field' ? 4 : 2) : mode === 'field' ? 3 : 2;
    if (tab.cols.length < need) return fail(`${COLS[`${arr} ${mode}`]} Found ${tab.cols.length} column${tab.cols.length === 1 ? '' : 's'}.`);
    const data: (Reading & { K: number })[] = [];
    for (let i = 0; i < tab.rows; i++) {
      const c = tab.cols.map((col) => col[i]);
      if (c.slice(0, need).some((v) => !Number.isFinite(v))) continue;
      const s = c[0];
      let l: number | undefined, rhoa: number, K = NaN;
      if (arr === 'schlumberger' && mode === 'field') { l = c[1]; K = kSchlumberger(s, l); rhoa = (K * c[2]) / c[3]; }
      else if (arr === 'schlumberger') { if (tab.cols.length >= 3 && Number.isFinite(c[2])) { l = c[1]; rhoa = c[2]; } else rhoa = c[1]; }
      else if (mode === 'field') { K = kWenner(s); rhoa = (K * c[1]) / c[2]; }
      else rhoa = c[1];
      if (!(s > 0)) return fail(`Row ${i + 1}: the spacing must be above zero.`);
      if (l !== undefined && !(l > 0 && l < s)) return fail(`Row ${i + 1}: MN/2 must be above zero and smaller than AB/2.`);
      if (!(rhoa > 0) || !Number.isFinite(rhoa)) return fail(`Row ${i + 1}: the apparent resistivity comes out as ${sig(rhoa, 3)}; check ΔV and I (both above zero).`);
      data.push({ s, l, rhoa, K });
    }
    if (data.length < 3) return fail('Enter at least three readings.');
    // Starting model.
    const r0 = list(q<HTMLInputElement>('.vs-r0').value), h0 = list(q<HTMLInputElement>('.vs-h0').value);
    let m0: Model;
    if (r0.length || h0.length) {
      if (r0.length !== n || h0.length !== n - 1) return fail(`For ${n} layers, give ${n} starting resistivities and ${n - 1} thickness${n > 2 ? 'es' : ''}, or leave both blank.`);
      if (r0.some((v) => !(v > 0)) || h0.some((v) => !(v > 0))) return fail('Starting resistivities and thicknesses must all be above zero.');
      m0 = { rho: r0, h: h0 };
    } else m0 = startModel(data, n);
    const only = q<HTMLInputElement>('.vs-fix').checked;
    let model = m0, rms: number, seR: number[] = [], seH: number[] = [], fitted: number[], iters = 0;
    if (only) { fitted = data.map((d) => forward(arr, d, model)); rms = Math.sqrt(data.reduce((s, d, i) => s + Math.log(d.rhoa / fitted[i]) ** 2, 0) / data.length); }
    else {
      try { const r = invert(arr, data, m0); model = r.model; rms = r.rms; seR = r.seRho; seH = r.seH; fitted = r.fitted; iters = r.iterations; } catch (e) { return fail((e as Error).message + '. Use fewer layers or add readings.'); }
    }
    err.hidden = true; out.hidden = false;
    const tops = model.h.map((_, k) => model.h.slice(0, k + 1).reduce((s, v) => s + v, 0));
    q('.vs-big').textContent = `${n} layers: ${model.rho.map((v) => sig(v, 3)).join(', ')} Ω·m; interfaces at ${tops.map((v) => sig(v, 3)).join(', ')} m`;
    const fs = [fact('Fit', `${(rms * 100).toFixed(2)} % RMS`, only ? 'forward model only (starting model)' : `log misfit × 100, after ${iters} iterations from ${r0.length ? 'your' : 'an automatic'} starting model`),
      fact('Readings', `${data.length}`, `AB/2 or a from ${sig(Math.min(...data.map((d) => d.s)), 3)} to ${sig(Math.max(...data.map((d) => d.s)), 3)} m`)];
    if (!only) fs.push(fact('Longitudinal conductance S', `${sig(model.h.reduce((s, h, i) => s + h / model.rho[i], 0), 3)} S`, 'Σ h/ρ above the bottom layer: well resolved even when single layers are not'));
    q('.vs-facts').replaceChildren(...fs);
    const fac = (f: number | undefined) => (f !== undefined && Number.isFinite(f) ? `×/÷ ${f.toFixed(2)}` : '');
    const lrows = model.rho.map((r, i) => [String(i + 1), sig(r, 4), fac(seR[i]), i < model.h.length ? sig(model.h[i], 4) : 'half-space', i < model.h.length ? fac(seH[i]) : '', i < model.h.length ? sig(tops[i], 4) : '']);
    const lhead = ['Layer', 'Resistivity (Ω·m)', '± (factor)', 'Thickness (m)', '± (factor)', 'Depth to base (m)'];
    q<HTMLTableElement>('.vs-ltab').replaceChildren(tr(lhead, true), ...lrows.map((r) => tr(r)));
    // Curves.
    const smin = Math.min(...data.map((d) => d.s)), smax = Math.max(...data.map((d) => d.s));
    const xs = Array.from({ length: 121 }, (_, i) => smin / 1.5 * ((smax * 1.5) / (smin / 1.5)) ** (i / 120));
    const curve = xs.map((s) => (arr === 'wenner' ? wenner(s, model) : schlumbergerIdeal(s, model)));
    const sx = arr === 'wenner' ? 'Electrode spacing a (m)' : 'AB/2 (m)';
    figs = [chartFigure({ w: 420, h: 320, xLog: true, yLog: true, xLabel: sx, yLabel: 'Apparent resistivity (Ω·m)', legend: 'below', series: [
      { name: 'Readings', x: data.map((d) => d.s), y: data.map((d) => d.rhoa), mode: 'points', marker: 'open-circle', size: 3.6 },
      { name: arr === 'wenner' ? 'Model' : 'Model (MN → 0)', x: xs, y: curve, mode: 'line', width: 1.6 },
      ...(arr === 'schlumberger' && data.some((d) => d.l) ? [{ name: 'Model at each MN', x: data.map((d) => d.s), y: fitted, mode: 'points' as const, marker: 'cross' as const, size: 3.2 }] : []),
    ] }, 'Sounding curve: apparent resistivity against spacing on log scales, with the model curve')];
    // Resistivity against depth as steps.
    const zb = tops.length ? tops[tops.length - 1] * 3 : smax;
    const zx: number[] = [], zy: number[] = [];
    model.rho.forEach((r, i) => { const top = i ? tops[i - 1] : Math.min(tops[0] ?? 1, smin) / 3, bot = i < tops.length ? tops[i] : zb; zx.push(r, r); zy.push(top, bot); });
    figs.push(chartFigure({ w: 420, h: 300, xLog: true, yLog: true, yReverse: true, xLabel: 'Resistivity (Ω·m)', yLabel: 'Depth (m)', legend: 'none', series: [{ name: 'Model', x: zx, y: zy, mode: 'line', width: 2 }] }, 'Layered model: resistivity against depth'));
    paint(q<HTMLCanvasElement>('.vs-fig'), figs[0]); paint(q<HTMLCanvasElement>('.vs-col2'), figs[1]);
    const head = [arr === 'wenner' ? 'a (m)' : 'AB/2 (m)', ...(arr === 'schlumberger' ? ['MN/2 (m)'] : []), 'K (m)', 'ρa (Ω·m)', 'Model ρa', 'Misfit %'];
    const p4 = (v: number) => String(+v.toPrecision(4));
    const rows = data.map((d, i) => [p4(d.s), ...(arr === 'schlumberger' ? [d.l ? p4(d.l) : ''] : []), Number.isFinite(d.K) ? p4(d.K) : '', p4(d.rhoa), p4(fitted[i]), ((d.rhoa / fitted[i] - 1) * 100).toFixed(1).replace('-', '−')]);
    q<HTMLTableElement>('.vs-tab').replaceChildren(tr(head, true), ...rows.map((r) => tr(r)));
    csvRows = [['spacing_m', 'mn2_m', 'k_m', 'rhoa_ohm_m', 'model_rhoa_ohm_m', 'misfit_pct'], ...data.map((d, i) => [d.s, d.l ?? '', Number.isFinite(d.K) ? +d.K.toFixed(6) : '', +d.rhoa.toFixed(6), +fitted[i].toFixed(6), +((d.rhoa / fitted[i] - 1) * 100).toFixed(4)])];
    report = [{ title: q('.vs-big').textContent!, facts: fs.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), table: { head: lhead, rows: lrows, align: lhead.map((_, j) => (j ? 'r' : 'l')) }, figure: figs[0] }, { title: 'Model', figure: figs[1], table: { head, rows, align: head.map(() => 'r') } }];
  }

  let timer = 0;
  const later = () => { clearTimeout(timer); timer = window.setTimeout(calc, 150); };
  root.querySelectorAll('input, textarea, select').forEach((i) => { i.addEventListener('input', later); i.addEventListener('change', later); });
  q('.vs-csv').addEventListener('click', () => save(new Blob([csv(csvRows)], { type: 'text/csv' }), 'ves-sounding.csv', 'text/csv'));
  document.addEventListener('fibub:theme', () => { if (figs[0]) paint(q<HTMLCanvasElement>('.vs-fig'), figs[0]); if (figs[1]) paint(q<HTMLCanvasElement>('.vs-col2'), figs[1]); });
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'Resistivity sounding', subtitle: q('.vs-big').textContent ?? '', file: 'ves-sounding', sections: report }));
</script>

<style is:global>
  .ves select, .ves input { max-width: 100%; }
  .ves textarea { width: 100%; }
  .ves td { white-space: nowrap; }
</style>
