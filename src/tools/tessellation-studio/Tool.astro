---
// Tessellation and symmetry studio: put regular polygons round a point and see whether their angles close up to
// 360° (a tiling), leave a gap or overlap; a patch of tiles for the shapes that tile alone; and a rangoli-style
// pattern pad that repeats your drawing k times with or without mirrors. Nothing is stored.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm ts">
  <div class="ax-card">
    <h2>Polygons around a point</h2>
    <p class="ax-help">Tap a shape to add it at the point. The corners must add up to exactly 360° to fit with no gap and no overlap.</p>
    <div class="ax-row ts-add">
      <button type="button" class="btn secondary small" data-n="3">Triangle</button>
      <button type="button" class="btn secondary small" data-n="4">Square</button>
      <button type="button" class="btn secondary small" data-n="5">Pentagon</button>
      <button type="button" class="btn secondary small" data-n="6">Hexagon</button>
      <button type="button" class="btn secondary small" data-n="8">Octagon</button>
      <button type="button" class="btn secondary small" data-n="10">Decagon</button>
      <button type="button" class="btn secondary small" data-n="12">12-gon</button>
    </div>
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn small ts-undo">Take one off</button>
      <button type="button" class="btn secondary small ts-clear">Clear</button>
    </div>
    <svg class="sm-fig ts-fig" viewBox="0 0 300 300" role="img" aria-label="Regular polygons placed around one point, with any gap or overlap marked"></svg>
    <p class="sm-f ts-sum"></p>
    <p class="ax-big ts-verdict" aria-live="polite"></p>
    <p class="ax-help">Try these:</p>
    <div class="ax-row">
      <button type="button" class="btn secondary small ts-pre" data-p="3,3,3,3,3,3">6 triangles</button>
      <button type="button" class="btn secondary small ts-pre" data-p="4,4,4,4">4 squares</button>
      <button type="button" class="btn secondary small ts-pre" data-p="6,6,6">3 hexagons</button>
      <button type="button" class="btn secondary small ts-pre" data-p="5,5,5">3 pentagons</button>
      <button type="button" class="btn secondary small ts-pre" data-p="4,8,8">4.8.8</button>
      <button type="button" class="btn secondary small ts-pre" data-p="3,12,12">3.12.12</button>
      <button type="button" class="btn secondary small ts-pre" data-p="3,4,6,4">3.4.6.4</button>
    </div>
  </div>

  <div class="ax-card ts-patch-card">
    <h2>A patch of tiles</h2>
    <div class="ax-seg ts-pt" role="group" aria-label="Which tile"><button type="button" data-n="3" aria-pressed="false">Triangles</button><button type="button" data-n="4" aria-pressed="true">Squares</button><button type="button" data-n="6" aria-pressed="false">Hexagons</button></div>
    <svg class="sm-fig ts-patch" viewBox="0 0 300 200" role="img" aria-label="A patch of the floor covered by one kind of regular polygon"></svg>
    <p class="ax-help ts-pnote"></p>
  </div>

  <div class="ax-card">
    <h2>Rangoli pattern pad</h2>
    <p class="ax-help">Draw with your finger or mouse. Each line you draw is turned round the centre to make a pattern with rotational symmetry; switch on mirrors for lines of symmetry too.</p>
    <div class="sm-sl"><b>k</b><input type="range" class="ts-kr" min="2" max="12" step="1" value="6" aria-label="Number of turns" /><input type="number" class="ts-k" min="2" max="12" step="1" value="6" inputmode="numeric" aria-label="Number of turns" /></div>
    <div class="ax-row">
      <label class="ax-check"><input type="checkbox" class="ts-mir" checked /> Mirrors</label>
      <button type="button" class="btn secondary small ts-sample">Sample pattern</button>
      <button type="button" class="btn secondary small ts-rundo">Undo</button>
      <button type="button" class="btn secondary small ts-rclear">Clear</button>
    </div>
    <svg class="sm-fig ts-pad" viewBox="0 0 300 300" role="img" aria-label="Drawing pad that repeats each line round the centre"></svg>
    <p class="sm-f ts-sym"></p>
    <p class="ax-help">Your drawing stays on this page only; nothing is saved or sent.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Add pentagons one at a time. Why can three not close up, and why will a fourth not fit?</li>
      <li>Squares and octagons (4.8.8) fit. Find another mix that closes, such as a triangle, two squares and a hexagon.</li>
      <li>On the pattern pad, set k = 5 with mirrors off. Turn your phone a fifth of a turn: the pattern looks the same, but it has no mirror line.</li>
      <li>Count the lines of symmetry with mirrors on. How do they compare with k?</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Nothing is saved.</p>
    <div class="ts-quiz"></div>
  </div>
</div>

<style is:inline>
  .ts svg .ts-p0 { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .ts svg .ts-p1 { fill: var(--good-soft); stroke: var(--good); stroke-width: 1.5; }
  .ts svg .ts-p2 { fill: var(--warn-soft); stroke: var(--warn); stroke-width: 1.5; }
  .ts svg .ts-over { fill: var(--bad-soft); stroke: var(--bad); stroke-width: 2; stroke-dasharray: 5 3; fill-opacity: 0.8; }
  .ts svg .ts-gap { fill: var(--bad); fill-opacity: 0.25; stroke: var(--bad); stroke-width: 1.5; }
  .ts svg .ts-tile { fill: var(--accent-soft); stroke: var(--ink); stroke-width: 1; }
  .ts svg .ts-tile2 { fill: var(--good-soft); stroke: var(--ink); stroke-width: 1; }
  .ts svg .ts-st { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .ts svg .ts-st.ts-m { stroke: var(--warn); }
  .ts svg .ts-guide { stroke: var(--line); stroke-width: 1; fill: none; }
</style>

<script>
  import { interior, aroundPoint, vertexSum, vertexFit, symmetry, polygonAt } from '../../lib/sci/tessellation-studio';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, quiz, dragOn, pair, val, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.ts')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const NAME: Record<number, string> = { 3: 'triangle', 4: 'square', 5: 'pentagon', 6: 'hexagon', 8: 'octagon', 10: 'decagon', 12: '12-gon' };
  let shapes: number[] = [3, 4, 6, 4];

  function drawPoint() {
    const svg = q<SVGSVGElement>('.ts-fig'); svg.replaceChildren();
    const C = 150, side = 72;
    let cum = 0;
    shapes.forEach((n, i) => {
      const a = interior(n), over = cum + a > 360 + 1e-9;
      const pts = polygonAt(n, 0, 0, cum, side).map(([x, y]) => `${(C + x).toFixed(1)},${(C - y).toFixed(1)}`).join(' ');
      S('polygon', { points: pts, class: `ts-poly ${over ? 'ts-over' : 'ts-p' + (i % 3)}` }, svg);
      cum += a;
    });
    if (shapes.length && cum < 360 - 1e-9) {
      const r = 48, t0 = (cum * Math.PI) / 180, large = 360 - cum > 180 ? 1 : 0;
      S('path', { d: `M${C},${C} L${C + r * Math.cos(t0)},${C - r * Math.sin(t0)} A${r},${r} 0 ${large} 0 ${C + r},${C} Z`, class: 'ts-gap' }, svg);
    }
    S('circle', { cx: C, cy: C, r: 4, fill: 'currentColor' }, svg);
    const sum = vertexSum(shapes);
    q('.ts-sum').textContent = shapes.length
      ? `${shapes.map((n) => `${fmt(interior(n), 2)}°`).join(' + ')} = ${fmt(sum, 2)}°. (A regular n-gon has corners of 180° × (n − 2) ÷ n.)`
      : 'Tap a shape to start.';
    const fit = vertexFit(shapes), v = q('.ts-verdict');
    v.textContent = !shapes.length ? '' : fit === 'closes' ? 'Exactly 360°: they fit with no gap.' : fit === 'gap' ? `A gap of ${fmt(360 - sum, 2)}° is left.` : `They overlap by ${fmt(sum - 360, 2)}°.`;
  }

  function drawPatch(n: number) {
    const svg = q<SVGSVGElement>('.ts-patch'); svg.replaceChildren();
    const poly = (pts: [number, number][], cls: string) => S('polygon', { points: pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' '), class: `ts-tile ${cls}` }, svg);
    if (n === 4) {
      const s = 40; for (let i = 0; i < 8; i++) for (let j = 0; j < 5; j++) poly([[i * s, j * s], [i * s + s, j * s], [i * s + s, j * s + s], [i * s, j * s + s]], (i + j) % 2 ? 'ts-tile2' : '');
    } else if (n === 3) {
      const s = 44, h = (s * Math.sqrt(3)) / 2;
      for (let r = 0; r < 5; r++) for (let i = -1; i < 9; i++) {
        const x = i * s + (r % 2 ? s / 2 : 0), y = r * h;
        poly([[x, y + h], [x + s, y + h], [x + s / 2, y]], '');
        poly([[x + s / 2, y], [x + s * 1.5, y], [x + s, y + h]], 'ts-tile2');
      }
    } else {
      const s = 26, w = Math.sqrt(3) * s;
      for (let r = -1; r < 7; r++) for (let i = -1; i < 9; i++) {
        const cx = i * w + (r % 2 ? w / 2 : 0), cy = r * 1.5 * s;
        poly(Array.from({ length: 6 }, (_, k) => [cx + s * Math.cos(((60 * k + 30) * Math.PI) / 180), cy + s * Math.sin(((60 * k + 30) * Math.PI) / 180)] as [number, number]), (r + i) % 3 === 0 ? 'ts-tile2' : '');
      }
    }
    const a = aroundPoint(n);
    q('.ts-pnote').textContent = `${a.count} ${NAME[n]}s meet at every corner: ${a.count} × ${fmt(interior(n), 2)}° = 360°.`;
  }

  // Rangoli pad: strokes are lists of points relative to the centre.
  type Pt = [number, number];
  let strokes: Pt[][] = [];
  const KR = q<HTMLInputElement>('.ts-kr'), K = q<HTMLInputElement>('.ts-k'), MIR = q<HTMLInputElement>('.ts-mir');
  pair(KR, K, drawPad);
  function drawPad() {
    const svg = q<SVGSVGElement>('.ts-pad'); svg.replaceChildren();
    const k = Math.round(val(K, 6, 2, 12)), mir = MIR.checked;
    S('circle', { cx: 150, cy: 150, r: 140, class: 'ts-guide' }, svg);
    for (let j = 0; j < k; j++) {
      const t = (j * 2 * Math.PI) / k;
      S('line', { x1: 150, y1: 150, x2: 150 + 140 * Math.cos(t), y2: 150 - 140 * Math.sin(t), class: 'ts-guide' }, svg);
    }
    for (const st of strokes) {
      if (st.length < 2) continue;
      const d = 'M' + st.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L');
      for (let j = 0; j < k; j++) {
        S('path', { d, transform: `translate(150 150) rotate(${(j * 360) / k})`, class: 'ts-st' }, svg);
        if (mir) S('path', { d, transform: `translate(150 150) rotate(${(j * 360) / k}) scale(1 -1)`, class: 'ts-st ts-m' }, svg);
      }
    }
    const s = symmetry(k, mir);
    q('.ts-sym').textContent = `Rotational symmetry of order ${s.order}: it looks the same after each turn of 360° ÷ ${k} = ${fmt(s.angle, 2)}°. ` +
      (mir ? `It has ${s.lines} lines of symmetry.` : 'With mirrors off it has no lines of symmetry (unless your own lines happen to be symmetric).');
  }
  dragOn(q<SVGSVGElement>('.ts-pad'), (x, y) => { strokes.push([[x - 150, y - 150]]); return 'd'; }, (_id, x, y) => {
    const st = strokes[strokes.length - 1], last = st[st.length - 1], p: Pt = [x - 150, y - 150];
    if (Math.hypot(p[0] - last[0], p[1] - last[1]) > 2) { st.push(p); drawPad(); }
  }, () => { if (strokes.length && strokes[strokes.length - 1].length < 2) strokes.pop(); drawPad(); });
  MIR.addEventListener('change', drawPad);
  q('.ts-sample').addEventListener('click', () => {
    strokes = [
      [[20, 0], [60, -18], [100, 0], [60, 18], [20, 0]],
      [[100, 0], [128, -10]],
      Array.from({ length: 9 }, (_, i) => [70 + 25 * Math.cos((i * Math.PI) / 4), -40 + 12 * Math.sin((i * Math.PI) / 4)] as Pt),
    ];
    drawPad();
  });
  q('.ts-rundo').addEventListener('click', () => { strokes.pop(); drawPad(); });
  q('.ts-rclear').addEventListener('click', () => { strokes = []; drawPad(); });

  root.querySelectorAll<HTMLButtonElement>('.ts-add button').forEach((b) => b.addEventListener('click', () => { if (shapes.length < 8) shapes.push(Number(b.dataset.n)); drawPoint(); }));
  q('.ts-undo').addEventListener('click', () => { shapes.pop(); drawPoint(); });
  q('.ts-clear').addEventListener('click', () => { shapes = []; drawPoint(); });
  root.querySelectorAll<HTMLButtonElement>('.ts-pre').forEach((b) => b.addEventListener('click', () => { shapes = b.dataset.p!.split(',').map(Number); drawPoint(); }));
  root.querySelectorAll<HTMLButtonElement>('.ts-pt button').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('.ts-pt button').forEach((e) => e.setAttribute('aria-pressed', String(e === b))); drawPatch(Number(b.dataset.n));
  }));
  drawPoint(); drawPatch(4); drawPad();

  quiz(q('.ts-quiz'), () => {
    const out: Question[] = [];
    const n1 = [5, 7, 8, 9, 10, 12, 15, 18, 20][randInt(0, 8)];
    out.push({ q: `What is each corner (interior angle) of a regular polygon with ${n1} sides, in degrees?`, want: [interior(n1)],
      work: `180 × (${n1} − 2) ÷ ${n1} = 180 × ${n1 - 2} ÷ ${n1} = ${fmt(interior(n1), 2)}°.` });
    const n2 = [3, 4, 6][randInt(0, 2)];
    out.push({ q: `How many regular ${NAME[n2]}s meet at each corner of a tiling made only of them?`, want: [360 / interior(n2)],
      work: `Each corner is ${interior(n2)}°, and 360 ÷ ${interior(n2)} = ${360 / interior(n2)}.` });
    const n3 = [5, 7, 8, 9, 10][randInt(0, 4)], a3 = aroundPoint(n3);
    out.push({ q: `Regular ${n3}-sided shapes are put round a point. How many degrees are left over after as many as fit?`, want: [a3.left],
      work: `Each corner is ${fmt(interior(n3), 2)}°. ${a3.count} fit (${fmt(a3.count * interior(n3), 2)}°), leaving 360 − ${fmt(a3.count * interior(n3), 2)} = ${fmt(a3.left, 2)}°. So they cannot tile alone.` });
    const mix = [[[4, 8], 8], [[3, 12], 12], [[3, 3, 4], 4], [[3, 4, 4], 6], [[4, 6], 12], [[3, 3, 3, 3], 6]] as [number[], number][];
    const [m, ans] = mix[randInt(0, mix.length - 1)];
    out.push({ q: `At a point there are regular polygons with ${m.join(', ')} sides. How many sides must the last regular polygon have to fill the gap exactly?`, want: [ans],
      work: `They use ${fmt(vertexSum(m), 2)}°, leaving ${fmt(360 - vertexSum(m), 2)}°. A regular ${ans}-gon has corners of ${fmt(interior(ans), 2)}°, so it fits.` });
    const k = randInt(3, 9);
    out.push({ q: `A rangoli has one design repeated ${k} times round the centre, mirrored each time. How many lines of symmetry does it have?`, want: [k],
      work: `It has rotational symmetry of order ${k} and, with mirrors, ${k} lines of symmetry (one through each copy and its mirror image).` });
    return out;
  });
</script>
