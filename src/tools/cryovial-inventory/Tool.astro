    document.documentElement.classList.add('cv-printing');
    const done = () => { document.documentElement.classList.remove('cv-printing'); root.append(p); };
    window.addEventListener('afterprint', done, { once: true });
    window.print();
    setTimeout(done, 0);
  });
  function mapFigure(b: C.Box): Figure {
    const occ = C.occupancy(inv, b.id), cell = 64, head = 22;
    const W = head + b.cols * cell + 2, H = head + b.rows * cell + 2;
    return {
      w: W, h: H, alt: `Box map of ${C.boxLabel(b)}: ${occ.size} of ${b.rows * b.cols} places used`,
      draw: (ctx, w, h, pal: Palette) => {
        const fills = pal.red ? Array(8).fill('#140000') : pal.bg === '#ffffff' ? FILL_LIGHT : FILL_DARK;
        ctx.fillStyle = pal.bg; ctx.fillRect(0, 0, w, h);
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = pal.muted; ctx.font = '600 12px system-ui, sans-serif';
        for (let c = 0; c < b.cols; c++) ctx.fillText(String(c + 1), head + c * cell + cell / 2, head / 2);
        for (let r = 0; r < b.rows; r++) ctx.fillText(C.rowLetter(r), head / 2, head + r * cell + cell / 2);
        for (let r = 0; r < b.rows; r++) for (let c = 0; c < b.cols; c++) {
          const x = head + c * cell + 1, y = head + r * cell + 1, v = occ.get(C.posName(r, c));
          ctx.fillStyle = v ? fills[colourOf(v.line)] : pal.bg; ctx.fillRect(x, y, cell - 2, cell - 2);
          ctx.strokeStyle = pal.line; ctx.lineWidth = 1; ctx.strokeRect(x + 0.5, y + 0.5, cell - 3, cell - 3);
          if (!v) continue;
          ctx.fillStyle = pal.ink; ctx.font = '600 11px system-ui, sans-serif';
          let name = v.line; while (name.length > 1 && ctx.measureText(name).width > cell - 8) name = name.slice(0, -1);
          ctx.fillText(name === v.line ? name : name.slice(0, -1) + '…', x + cell / 2 - 1, y + cell / 2 - 14);
          ctx.font = '11px system-ui, sans-serif'; ctx.fillStyle = pal.muted;
          ctx.fillText(passage(v.passage), x + cell / 2 - 1, y + cell / 2 + 1);
          ctx.fillText(v.frozen.slice(2), x + cell / 2 - 1, y + cell / 2 + 15);
        }
      },
    };
  }
  wireDownloads(q('.dl'), () => {
    const b = curBox();
    if (!b) return { title: '', sections: [], file: 'cryovial-box' };
    const occ = [...C.occupancy(inv, b.id).values()].sort((x, y) => C.posIndex(b, x.pos) - C.posIndex(b, y.pos));
    const u = C.boxUse(inv, b);
    const sections: Section[] = [
      { title: C.boxLabel(b), facts: [['Places used', `${u.used} of ${u.places}`], ['Free', String(u.places - u.used)], ['Lines', String(new Set(occ.map((v) => v.line)).size)]], figure: mapFigure(b) },
      { title: 'Vials in this box', table: { head: ['Place', 'Line', 'Passage', 'Frozen', 'Cells', 'Medium', 'By', 'Notes'], rows: occ.map((v) => [v.pos, v.line, passage(v.passage), v.frozen, cells(v.cells), v.medium, v.who, v.note]), align: ['l', 'l', 'l', 'l', 'r', 'l', 'l', 'l'] }, note: `Made on fibub.com on ${TODAY}. Nothing was uploaded.` },
    ];
    return { title: `Box map: ${b.name}`, subtitle: `${b.freezer} › ${b.rack}`, file: `cryovial-box-${fileSafe(b.name)}`, sections };
  });

  function exampleBox() { return C.findBox(inv, 'LN2 tank 1', 'Rack 3', 'Box 1')?.id ?? ''; }
  // ---------- Start ----------
  for (const c of ['.cv-a-date', '.cv-t-date', '.cv-b-date', '.cv-f-date']) inp(c).value = TODAY;
  if (!loadSaved()) { inv = C.example(); isExample = true; boxId = exampleBox(); }
  render(); freezer();
</script>

