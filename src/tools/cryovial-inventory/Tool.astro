---
// Cryovial inventory and freezing helper: freezers, racks and 9 × 9 or 10 × 10 boxes of frozen vials (line,
// passage, date frozen, cells per vial, medium, who), a box map, search and filters, marking vials thawed with a
// thaw log, CSV and JSON import/export, a printable box map, and a freezing helper (cells and freezing medium
// for N vials, DMSO % editable, with dates). Kept in this browser only when the user ticks the box.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax cvi">
  <div class="ax-card">
    <h2>Your boxes</h2>
    <div class="ax-row">
      <button type="button" class="btn secondary small cv-ex">Use the example</button>
      <button type="button" class="btn secondary small cv-empty">Start empty</button>
    </div>
    <p class="ax-help cv-exnote">This is a made-up example. Press <strong>Start empty</strong> to begin your own, or open a file you saved before (at the bottom of the page).</p>
    <div class="ax-grid cv-boxpick">
      <label>Box <select class="cv-box"></select></label>
    </div>
    <p class="cv-boxinfo" aria-live="polite"></p>
    <div class="cv-mapwrap">
      <div class="cv-map" role="group" aria-label="Box map"></div>
    </div>
    <div class="ax-legend cv-legend"></div>
    <p class="ax-help cv-maphelp">Tap a vial to see it, edit it or mark it thawed. Tap an empty place to add vials from there. Numbers are passages.</p>
    <details class="cv-addbox">
      <summary>Add a box</summary>
      <div class="ax-grid">
        <label>Freezer or tank <input class="cv-nb-f" list="cv-freezers" placeholder="LN2 tank 1" autocomplete="off" /></label>
        <label>Rack, tower or shelf <input class="cv-nb-r" placeholder="Rack 3" autocomplete="off" /></label>
        <label>Box name <input class="cv-nb-n" placeholder="Box 2" autocomplete="off" /></label>
        <label>Size <select class="cv-nb-s"><option value="9">9 × 9 (81 places)</option><option value="10">10 × 10 (100 places)</option></select></label>
      </div>
      <datalist id="cv-freezers"></datalist>
      <div class="ax-row" style="margin-top:10px"><button type="button" class="btn small cv-nb-add">Add box</button></div>
      <p class="ax-err cv-nb-err" hidden></p>
    </details>
    <details class="cv-editbox">
      <summary>Rename or remove this box</summary>
      <div class="ax-grid">
        <label>Freezer or tank <input class="cv-eb-f" list="cv-freezers" autocomplete="off" /></label>
        <label>Rack, tower or shelf <input class="cv-eb-r" autocomplete="off" /></label>
        <label>Box name <input class="cv-eb-n" autocomplete="off" /></label>
      </div>
      <div class="ax-row" style="margin-top:10px">
        <button type="button" class="btn small cv-eb-save">Save names</button>
        <button type="button" class="btn secondary small cv-eb-del">Remove this box</button>
      </div>
      <p class="ax-help">Removing a box also removes the vials still in it. Vials already thawed stay in the thaw log.</p>
      <p class="ax-err cv-eb-err" hidden></p>
    </details>
  </div>

  <div class="ax-card cv-vialcard" hidden>
    <h2 class="cv-vh"></h2>
    <dl class="ax-facts cv-vfacts"></dl>
    <h3>Mark it thawed</h3>
    <div class="ax-grid">
      <label>Thawed on <input class="cv-t-date" type="date" /></label>
      <label>By <input class="cv-t-by" autocomplete="off" /></label>
      <label class="cv-wide">Note (optional) <input class="cv-t-note" placeholder="How the cells looked" autocomplete="off" /></label>
    </div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn small cv-t-go">Mark thawed</button></div>
    <p class="ax-err cv-t-err" hidden></p>
    <details class="cv-edit">
      <summary>Edit or move this vial</summary>
      <div class="ax-grid">
        <label>Cell line or sample <input class="cv-e-line" list="cv-lines" autocomplete="off" /></label>
        <label>Passage <input class="cv-e-pass" inputmode="numeric" /></label>
        <label>Date frozen <input class="cv-e-date" type="date" /></label>
        <label>Cells per vial <input class="cv-e-cells" inputmode="decimal" /></label>
        <label>Freezing medium <input class="cv-e-med" autocomplete="off" /></label>
        <label>Frozen by <input class="cv-e-who" autocomplete="off" /></label>
        <label class="cv-wide">Notes <input class="cv-e-note" autocomplete="off" /></label>
        <label>Box <select class="cv-e-box"></select></label>
        <label>Place <input class="cv-e-pos" autocomplete="off" /></label>
      </div>
      <div class="ax-row" style="margin-top:10px">
        <button type="button" class="btn small cv-e-save">Save changes</button>
        <button type="button" class="btn secondary small cv-e-del">Remove (entered by mistake)</button>
      </div>
      <p class="ax-err cv-e-err" hidden></p>
    </details>
  </div>

  <div class="ax-card cv-addcard">
    <h2>Add vials</h2>
    <p class="ax-help" style="margin:0 0 10px">Vials go into the free places of the box shown above, row by row (A1, A2 … then B1), starting at the place you give. Full places are skipped.</p>
    <div class="ax-grid">
      <label>Cell line or sample <input class="cv-a-line" list="cv-lines" autocomplete="off" /></label>
      <label>Passage <input class="cv-a-pass" inputmode="numeric" placeholder="optional" /></label>
      <label>Date frozen <input class="cv-a-date" type="date" /></label>
      <label>Cells per vial <input class="cv-a-cells" inputmode="decimal" placeholder="1e6" /></label>
      <label>Freezing medium <input class="cv-a-med" autocomplete="off" placeholder="90 % serum, 10 % DMSO" /></label>
      <label>Frozen by <input class="cv-a-who" autocomplete="off" placeholder="initials" /></label>
      <label class="cv-wide">Notes <input class="cv-a-note" autocomplete="off" placeholder="optional" /></label>
      <label>How many vials <input class="cv-a-n" inputmode="numeric" value="1" /></label>
      <label>Start at <input class="cv-a-start" autocomplete="off" value="A1" /></label>
    </div>
    <datalist id="cv-lines"></datalist>
    <p class="ax-help cv-a-where"></p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn small cv-a-go">Add vials</button></div>
    <p class="ax-err cv-a-err" hidden></p>
    <p class="ax-help cv-a-ok" aria-live="polite"></p>
  </div>

  <div class="ax-card">
    <h2>Find vials</h2>
    <div class="ax-grid">
      <label class="cv-wide">Search <input class="cv-q" type="search" placeholder="line, P12, initials, note, box…" autocomplete="off" /></label>
      <label>Freezer <select class="cv-ff"></select></label>
      <label>Line <select class="cv-fl"></select></label>
    </div>
    <div class="ax-seg cv-fs" role="group" aria-label="Which vials">
      <button type="button" data-s="in" aria-pressed="true">In the freezer</button>
      <button type="button" data-s="thawed" aria-pressed="false">Thawed</button>
      <button type="button" data-s="all" aria-pressed="false">All</button>
    </div>
    <p class="cv-count" aria-live="polite"></p>
    <div class="ax-scroll"><table class="cv-res"></table></div>
    <div class="cv-bulk">
      <h3>Mark the ticked vials thawed</h3>
      <div class="ax-grid">
        <label>Thawed on <input class="cv-b-date" type="date" /></label>
        <label>By <input class="cv-b-by" autocomplete="off" /></label>
        <label class="cv-wide">Note (optional) <input class="cv-b-note" autocomplete="off" /></label>
      </div>
      <div class="ax-row" style="margin-top:10px"><button type="button" class="btn small cv-b-go">Mark ticked thawed</button><span class="ax-help cv-b-n" style="margin:0"></span></div>
      <p class="ax-err cv-b-err" hidden></p>
    </div>
    <div class="ax-row" style="margin-top:12px"><button type="button" class="btn secondary small cv-res-csv">Download these as CSV</button></div>
    <h3>Lines</h3>
    <div class="ax-grid"><label>Warn when a line is down to <input class="cv-low" inputmode="numeric" value="2" /></label></div>
    <div class="ax-scroll"><table class="cv-lines"></table></div>
  </div>

  <div class="ax-card">
    <h2>Thaw log</h2>
    <p class="ax-help" style="margin:0 0 8px">Every vial marked thawed, newest first, with the place it came from. Undo puts a vial back if its place is still free.</p>
    <p class="cv-lognone">No vials thawed yet.</p>
    <div class="ax-scroll"><table class="cv-log"></table></div>
    <p class="ax-err cv-log-err" hidden></p>
    <div class="ax-row" style="margin-top:12px"><button type="button" class="btn secondary small cv-log-csv">Download thaw log CSV</button></div>
  </div>

  <div class="ax-card">
    <h2>Freezing helper</h2>
    <p class="ax-help" style="margin:0 0 10px">How many cells to spin down and how much freezing medium to make for a batch of vials. The starting values are round numbers chosen by fibub, not a protocol: use your lab's own.</p>
    <div class="ax-grid">
      <label>Vials <input class="cv-f-n" inputmode="numeric" value="10" /></label>
      <label>Cells per vial <input class="cv-f-cpv" inputmode="decimal" value="1e6" /></label>
      <label>mL per vial <input class="cv-f-ml" inputmode="decimal" value="1" /></label>
      <label>DMSO (%) <input class="cv-f-d" inputmode="decimal" value="10" /></label>
      <label>Serum (%) <input class="cv-f-s" inputmode="decimal" value="20" /></label>
      <label>Extra for pipetting (%) <input class="cv-f-x" inputmode="decimal" value="10" /></label>
    </div>
    <p class="ax-help">DMSO protects the cells from ice; extra serum is optional (0 % if your mix is only medium and DMSO); the rest of the mix is medium. "Extra for pipetting" makes a little more so the last vial is full.</p>
    <h3>Your cells now (optional)</h3>
    <div class="ax-grid">
      <label>Live cells per mL <input class="cv-f-cpm" inputmode="decimal" value="8e5" /></label>
      <label>Volume of suspension (mL) <input class="cv-f-vol" inputmode="decimal" value="20" /></label>
    </div>
    <h3>Cooling and dates</h3>
    <div class="ax-grid">
      <label>Freezing on <input class="cv-f-date" type="date" /></label>
      <label>Start (°C) <input class="cv-f-t0" inputmode="decimal" value="20" /></label>
      <label>Cooling rate (°C per min) <input class="cv-f-rate" inputmode="decimal" value="1" /></label>
      <label>Move to storage after (h) <input class="cv-f-move" inputmode="decimal" value="24" /></label>
      <label>Test thaw after (days) <input class="cv-f-test" inputmode="decimal" value="7" /></label>
    </div>
    <p class="ax-help">The cooling time is how long the vials take to reach −80 °C at a steady rate; slow-cooling containers aim for about 1 °C per minute. Check your own container's instructions.</p>
    <p class="ax-err cv-f-err" hidden></p>
    <div class="cv-f-out">
      <p class="ax-big cv-f-big" aria-live="polite"></p>
      <p class="ax-help cv-f-sub"></p>
      <dl class="ax-facts cv-f-facts"></dl>
      <ol class="cv-f-steps"></ol>
      <ul class="cv-f-warn"></ul>
      <h3>Dates</h3>
      <div class="ax-scroll"><table class="cv-f-sched"></table></div>
      <div class="ax-row" style="margin-top:12px"><button type="button" class="btn secondary small cv-f-use">Add these vials to the box above</button></div>
    </div>
  </div>

  <div class="ax-card">
    <h2>Save, open and print</h2>
    <div class="ax-row">
      <button type="button" class="btn small cv-csv">Save as CSV</button>
      <button type="button" class="btn secondary small cv-json">Save as JSON</button>
      <button type="button" class="btn secondary small cv-open">Open a file</button>
      <input type="file" class="cv-in" accept=".csv,.tsv,.txt,.json,text/csv,application/json,text/plain" hidden />
    </div>
    <div class="ax-grid" style="margin-top:10px">
      <label>When opening a file <select class="cv-mode"><option value="add">add to this inventory</option><option value="replace">replace this inventory</option></select></label>
    </div>
    <p class="ax-help">CSV opens in any spreadsheet; JSON keeps everything, including empty boxes. Both open here again. A CSV of your own needs at least "line", "position" and "date_frozen" columns; freezer, rack, box, box_size (9x9 or 10x10), passage, cells_per_vial, medium, frozen_by and notes are read too.</p>
    <p class="ax-help cv-io-ok" aria-live="polite"></p>
    <p class="ax-err cv-io-err" hidden></p>
    <div class="ax-row" style="margin-top:12px">
      <button type="button" class="btn secondary small cv-print-go">Print this box map</button>
    </div>
    <div class="ax-row" style="margin-top:14px">
      <label class="ax-check"><input type="checkbox" class="cv-keep" /> Keep my inventory in this browser</label>
      <button type="button" class="btn secondary small cv-clear">Clear all</button>
    </div>
    <p class="ax-help">Off by default. When it is ticked, your boxes, vials and thaw log are saved only in this browser on this device, so they are here next time. They are never sent anywhere. Clear all empties the page and deletes the saved copy. Browsers can wipe saved data, so save a file now and then as a backup.</p>
    <p class="ax-help cv-cleared" aria-live="polite"></p>
    <Downloads label="Box map" />
  </div>
  <div class="cv-print" aria-hidden="true"></div>
</div>

<script>
  import * as C from '../../lib/sci/cryovial';
  import { num, sig, csv } from '../../lib/sci/num';
  import { save, wireDownloads, fileSafe, type Figure, type Section, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.cvi')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const inp = (c: string) => q<HTMLInputElement>(c);
  const val = (c: string) => inp(c).value.trim();
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
  const showErr = (c: string, m: string) => { const e = q(c); e.textContent = m; e.hidden = !m; };
  const KEY = 'fibub-cryovials-v1';
  const pad = (n: number) => String(n).padStart(2, '0');
  const now = new Date(), TODAY = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const cells = (x: number | null) => (x == null || !Number.isFinite(x) ? '–' : x >= 1e10 ? sig(x, 3) : Number(x.toPrecision(4)).toLocaleString('en-US'));
  const vol = (ml: number) => (ml === 0 ? '0 mL' : ml >= 1 ? `${Number(ml.toPrecision(4))} mL` : `${Number((ml * 1000).toPrecision(3))} µL`);
  const passage = (p: number | null) => (p == null ? '–' : `P${p}`);
  const optNum = (s: string) => (s.trim() ? num(s) : null);

  let inv: C.Inventory = C.newInventory();
  let boxId = '', selPos = '', status: 'in' | 'thawed' | 'all' = 'in', isExample = false;
  const ticked = new Set<string>();
  const curBox = () => inv.boxes.find((b) => b.id === boxId);

  // ---------- Storage (only when ticked) ----------
  const keeping = () => inp('.cv-keep').checked;
  const store = () => { try { if (keeping()) localStorage.setItem(KEY, C.toJson(inv)); } catch {} };
  function loadSaved(): boolean {
    try {
      const s = localStorage.getItem(KEY);
      if (!s) return false;
      const x = C.newInventory();
      C.importJson(x, s);
      inv = x; inp('.cv-keep').checked = true;
      return true;
    } catch { return false; }
  }

  // ---------- Colours per line ----------
  const lineColour = new Map<string, number>();
  const colourOf = (line: string) => {
    if (!lineColour.has(line)) lineColour.set(line, [...new Set(C.lineSummary(inv).map((s) => s.line))].indexOf(line) % 8);
    return lineColour.get(line)!;
  };
  const FILL_LIGHT = ['#cfe3f7', '#fde2b8', '#c9ecd9', '#f6d0e4', '#e2d8f3', '#f9f1b0', '#d5e7ec', '#f3d2c8'];
  const FILL_DARK = ['#1e3a5c', '#5a3d0f', '#17452f', '#57213e', '#3a2d5c', '#4f4810', '#1e4650', '#5a2a1e'];

  // ---------- Rendering ----------
  function changed() { lineColour.clear(); store(); render(); }
  function render() {
    renderBoxes(); renderMap(); renderVial(); renderAddHint(); renderFind(); renderLog(); lists();
  }
  function lists() {
    const lines = [...new Set(inv.vials.map((v) => v.line))].sort((a, b) => a.localeCompare(b, 'en', { numeric: true }));
    const freezers = [...new Set(inv.boxes.map((b) => b.freezer))].sort((a, b) => a.localeCompare(b, 'en', { numeric: true }));
    q('#cv-lines').replaceChildren(...lines.map((l) => { const o = el('option'); o.value = l; return o; }));
    q('#cv-freezers').replaceChildren(...freezers.map((l) => { const o = el('option'); o.value = l; return o; }));
  }
  function renderBoxes() {
    const s = q<HTMLSelectElement>('.cv-box'), boxes = C.sortedBoxes(inv);
    if (!boxes.some((b) => b.id === boxId)) { boxId = boxes[0]?.id ?? ''; selPos = ''; }
    s.replaceChildren(...boxes.map((b) => { const u = C.boxUse(inv, b), o = el('option', '', `${C.boxLabel(b)} (${u.used}/${u.places})`); o.value = b.id; return o; }));
    if (!boxes.length) { const o = el('option', '', 'No boxes yet: add one below'); o.value = ''; s.append(o); }
    s.value = boxId; s.disabled = !boxes.length;
    const eb = q<HTMLSelectElement>('.cv-e-box');
    eb.replaceChildren(...boxes.map((b) => { const o = el('option', '', C.boxLabel(b)); o.value = b.id; return o; }));
    q('.cv-exnote').hidden = !isExample;
    q('.cv-editbox').hidden = !boxes.length;
    const b = curBox();
    if (b) { inp('.cv-eb-f').value = b.freezer; inp('.cv-eb-r').value = b.rack; inp('.cv-eb-n').value = b.name; }
    resetDel();
  }
  function renderMap() {
    const b = curBox(), map = q('.cv-map');
    q('.cv-mapwrap').hidden = !b; q('.cv-maphelp').hidden = !b;
    if (!b) { q('.cv-boxinfo').textContent = 'No boxes yet. Add a box (below) to start, or open a file you saved.'; map.replaceChildren(); q('.cv-legend').replaceChildren(); (q('.cv-addbox') as HTMLDetailsElement).open = true; return; }
    const occ = C.occupancy(inv, b.id), u = C.boxUse(inv, b);
    const filtering = !!(val('.cv-q') || q<HTMLSelectElement>('.cv-ff').value || q<HTMLSelectElement>('.cv-fl').value);
    const hits = new Set(filtering ? C.filterVials(inv, readFilter()).map((v) => v.id) : []);
    q('.cv-boxinfo').textContent = `${C.boxLabel(b)}: ${u.used} of ${u.places} places used, ${u.places - u.used} free.${filtering ? ` ${[...occ.values()].filter((v) => hits.has(v.id)).length} match the search.` : ''}`;
    map.style.setProperty('--cols', String(b.cols));
    const kids: HTMLElement[] = [el('span', 'cv-corner')];
    for (let c = 0; c < b.cols; c++) kids.push(el('span', 'cv-hd', String(c + 1)));
    for (let r = 0; r < b.rows; r++) {
      kids.push(el('span', 'cv-hd', C.rowLetter(r)));
      for (let c = 0; c < b.cols; c++) {
        const pos = C.posName(r, c), v = occ.get(pos), btn = el('button', 'cv-cell');
        btn.type = 'button'; btn.dataset.pos = pos;
        if (v) {
          btn.classList.add('cv-full', 'cv-lc', `cv-c${colourOf(v.line)}`);
          btn.append(el('span', 'cv-l', v.line), el('span', 'cv-p', v.passage == null ? '' : String(v.passage)));
          btn.setAttribute('aria-label', `${pos}: ${v.line}, ${passage(v.passage)}, frozen ${v.frozen}`);
          btn.title = `${pos}: ${v.line} ${passage(v.passage)}, frozen ${v.frozen}${v.cells ? `, ${cells(v.cells)} cells` : ''}`;
          if (filtering && !hits.has(v.id)) btn.classList.add('cv-dim');
          if (filtering && hits.has(v.id)) btn.classList.add('cv-hit');
        } else { btn.setAttribute('aria-label', `${pos}: empty`); btn.title = `${pos}: empty`; }
        if (pos === selPos) { btn.classList.add('cv-sel'); btn.setAttribute('aria-pressed', 'true'); }
        kids.push(btn);
      }
    }
    map.replaceChildren(...kids);
    const inBox = C.lineSummary({ ...inv, vials: [...occ.values()] });
    q('.cv-legend').replaceChildren(...inBox.map((s) => { const sp = el('span'); const i = el('i', `cv-lc cv-c${colourOf(s.line)}`); sp.append(i, `${s.line} (${s.inStock})`); return sp; }));
  }
  function selected(): C.Vial | undefined { const b = curBox(); return b && selPos ? C.occupancy(inv, b.id).get(selPos) : undefined; }
  function renderVial() {
    const v = selected(), card = q('.cv-vialcard');
    card.hidden = !v;
    if (!v) return;
    const b = curBox()!;
    q('.cv-vh').textContent = `${v.pos} · ${v.line}`;
    const fact = (k: string, x: string) => { const d = el('div'); d.append(el('dt', '', k), el('dd', '', x || '–')); return d; };
    q('.cv-vfacts').replaceChildren(
      fact('Place', `${C.boxLabel(b)} › ${v.pos}`), fact('Passage', passage(v.passage)), fact('Frozen on', v.frozen),
      fact('Cells per vial', cells(v.cells)), fact('Medium', v.medium), fact('Frozen by', v.who), fact('Notes', v.note),
    );
    if (q('.cv-vialcard').dataset.vid !== v.id) {
      q('.cv-vialcard').dataset.vid = v.id;
      inp('.cv-e-line').value = v.line; inp('.cv-e-pass').value = v.passage == null ? '' : String(v.passage);
      inp('.cv-e-date').value = v.frozen; inp('.cv-e-cells').value = v.cells == null ? '' : String(v.cells);
      inp('.cv-e-med').value = v.medium; inp('.cv-e-who').value = v.who; inp('.cv-e-note').value = v.note;
      q<HTMLSelectElement>('.cv-e-box').value = v.box; inp('.cv-e-pos').value = v.pos;
      inp('.cv-t-note').value = ''; showErr('.cv-t-err', ''); showErr('.cv-e-err', ''); resetVialDel();
    }
  }
  function renderAddHint() {
    const b = curBox();
    q<HTMLButtonElement>('.cv-a-go').disabled = !b;
    if (!b) { q('.cv-a-where').textContent = 'Add a box first.'; return; }
    const n = Math.round(num(val('.cv-a-n'))), start = val('.cv-a-start') || 'A1';
    const free = C.freePositions(inv, b, start);
    q('.cv-a-where').textContent = !C.parsePos(start, b) ? `Start at a place from A1 to ${C.posName(b.rows - 1, b.cols - 1)}.`
      : n >= 1 && free.length >= n ? `Into ${b.name}: ${n === 1 ? free[0] : `${free[0]} to ${free[n - 1]}`} (${free.length} free from ${start.toUpperCase()}).`
      : `${free.length} free place${free.length === 1 ? '' : 's'} in ${b.name} from ${start.toUpperCase()}.`;
  }

  // ---------- Find ----------
  const readFilter = (): C.Filter => ({ text: val('.cv-q'), freezer: q<HTMLSelectElement>('.cv-ff').value, line: q<HTMLSelectElement>('.cv-fl').value, status });
  function fillSelect(s: HTMLSelectElement, first: string, items: string[]) {
    const cur = s.value;
