---
// Exploratory factor analysis: KMO, Bartlett, scree and parallel analysis, principal axis or ML, varimax or promax.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax fa">
  <div class="ax-card">
    <h2>Data</h2>
    <div class="ax-grid">
      <label>My data is <select class="fa-form"><option value="raw" selected>Scores (one row per person)</option><option value="corr">A correlation matrix</option></select></label>
      <label class="fa-nl" hidden>Number of people (n) <input class="fa-n" inputmode="numeric" value="" placeholder="e.g. 200" /></label>
    </div>
    <label style="margin-top:10px"><span class="fa-what">One row per person, one column per variable (item). A header row with names is optional. Rows with a blank cell are left out.</span>
