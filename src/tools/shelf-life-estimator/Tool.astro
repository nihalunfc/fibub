---
// Shelf life at another temperature (Q10), Q10 and Arrhenius activation energy fitted to accelerated test points,
// and water activity from ERH or a Norrish-type equation. For study and planning. Nothing is uploaded.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax shelf">
  <div class="ax-card">
    <h2>Shelf life at another temperature</h2>
    <div class="ax-row"><button type="button" class="btn secondary small sl-ex">Use the example</button></div>
    <div class="ax-grid" style="margin-top:10px">
      <label>Known shelf life <input class="sl-t1" type="number" min="0" step="any" value="180" inputmode="decimal" /></label>
      <label>Time unit <select class="sl-unit"><option>days</option><option>weeks</option><option>months</option><option>hours</option></select></label>
      <label>At temperature (°C) <input class="sl-T1" type="number" step="any" value="25" inputmode="decimal" /></label>
      <label>Q10 <input class="sl-q10" type="number" min="0" step="any" value="2" inputmode="decimal" /></label>
      <label>New temperature (°C) <input class="sl-T2" type="number" step="any" value="5" inputmode="decimal" /></label>
    </div>
    <p class="ax-help">Q10 is how many times faster the food spoils for every 10 °C warmer. Shelf life at T2 = shelf life at T1 ÷ Q10<sup>(T2 − T1)/10</sup>. Use a Q10 measured for your product, or fit one below.</p>
    <p class="ax-err sl-err1" hidden></p>
    <p class="ax-big sl-big1"></p>
    <div class="ax-scroll"><table class="sl-tab1"></table></div>
  </div>

  <div class="ax-card">
    <h2>Fit Q10 and activation energy from test points</h2>
    <label>Accelerated test results: temperature (°C) and shelf life, one test per line
      <textarea class="sl-pts" rows="5" spellcheck="false" placeholder="25, 180&#10;35, 75&#10;45, 32"></textarea></label>
    <DataFile target=".sl-pts" maxMB={1} maxCols={4} maxRows={200} />
    <div class="ax-grid" style="margin-top:10px">
      <label>Predict at (°C) <input class="sl-Tp" type="number" step="any" value="20" inputmode="decimal" /></label>
    </div>
    <p class="ax-help">Shelf life in the time unit chosen above. Two temperatures give exact lines; three or more are fitted by least squares on ln(shelf life). The Q10 model is a straight line against temperature; the Arrhenius model is a straight line against 1/T in kelvin.</p>
    <p class="ax-err sl-err2" hidden></p>
    <div class="sl-out2" hidden>
      <p class="ax-big sl-big2"></p>
      <dl class="ax-facts sl-facts"></dl>
      <canvas class="ax-fig sl-fig" style="margin-top:12px"></canvas>
      <div class="ax-scroll"><table class="sl-tab2"></table></div>
      <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small sl-csv">Download fit (CSV)</button></div>
    </div>
  </div>

  <div class="ax-card">
    <h2>Water activity</h2>
    <div class="ax-grid">
      <label>Equilibrium relative humidity, ERH (%) <input class="sl-erh" type="number" min="0" max="100" step="any" value="" placeholder="e.g. 85" inputmode="decimal" /></label>
    </div>
    <p class="ax-help sl-awerh">Water activity a<sub>w</sub> = ERH ÷ 100: the humidity of the air sealed with the food once it settles.</p>
    <h3>Solution with one solute (Norrish-type equation)</h3>
    <div class="ax-grid">
      <label>Water (g) <input class="sl-w" type="number" min="0" step="any" value="100" inputmode="decimal" /></label>
      <label>Solute (g) <input class="sl-s" type="number" min="0" step="any" value="" placeholder="e.g. 60" inputmode="decimal" /></label>
      <label>Solute molar mass (g/mol) <input class="sl-m" type="number" min="0" step="any" value="" placeholder="e.g. 342.3" inputmode="decimal" /></label>
      <label>Norrish constant K <input class="sl-k" type="number" step="any" value="0" inputmode="decimal" /></label>
    </div>
    <p class="ax-help">a<sub>w</sub> = x<sub>w</sub> · exp(−K · x<sub>s</sub>²), with x the mole fractions of water and solute. Enter K for your solute from your own reference; K = 0 is Raoult's law (an ideal solution).</p>
    <p class="ax-err sl-err3" hidden></p>
    <p class="ax-big sl-big3"></p>
    <p class="ax-help">Rough general guide: most bacteria need a<sub>w</sub> above about 0.9, most moulds and yeasts above about 0.8, and almost no microbes grow below about 0.6. Food safety limits for a product must come from the official source and tests on the product.</p>
  </div>

  <div class="ax-card">
    <Downloads />
    <p class="ax-help">For study and planning, not a substitute for professional judgement. Real shelf life must be confirmed by tests on the product at the temperature it is kept at; Q10 is often not constant over wide ranges.</p>
  </div>
</div>

<style is:inline>
  .shelf h3 { margin: 18px 0 8px; font-size: 15px; }
</style>

<script>
  import { q10Shift, fitShelf, q10FromEa, awFromErh, norrish, EXAMPLE_POINTS, type ShelfFit } from '../../lib/sci/shelflife';
  import { num, sig, csv, parseTable } from '../../lib/sci/num';
  import { chartFigure } from '../../lib/sci/plot';
  import { wireDownloads, save, paint, type Figure, type Section } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.shelf')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const v = (c: string) => num(q<HTMLInputElement>(c).value);
  const unit = () => q<HTMLSelectElement>('.sl-unit').value;
  const s3 = (x: number) => sig(x, 3);
  const table = (t: HTMLElement, head: string[], rows: string[][]) => {
    t.replaceChildren();
    const h = t.insertRow(); head.forEach((x, k) => { const th = document.createElement('th'); th.textContent = x; if (k) th.className = 'r'; h.append(th); });
    for (const r of rows) { const tr = t.insertRow(); r.forEach((x, k) => { const td = tr.insertCell(); td.textContent = x; if (k) td.className = 'r'; }); }
  };
  const err = (c: string, m = '') => { const e = q(c); e.textContent = m; e.hidden = !m; };
  let rows1: string[][] = [], fit: ShelfFit | null = null, pts: { T: number; t: number }[] = [], fig: Figure | null = null, Tp = NaN, rows2: string[][] = [];

  function one() {
    err('.sl-err1'); rows1 = [];
    const t1 = v('.sl-t1'), T1 = v('.sl-T1'), Q = v('.sl-q10'), T2 = v('.sl-T2');
    q('.sl-big1').textContent = ''; q('.sl-tab1').replaceChildren();
    if (![t1, T1, Q, T2].every(Number.isFinite)) return err('.sl-err1', 'Fill in all five boxes with numbers.');
    if (!(t1 > 0) || !(Q > 0)) return err('.sl-err1', 'Shelf life and Q10 must be more than 0.');
    if (Q < 1) err('.sl-err1', 'A Q10 below 1 means the food keeps longer when warmer. Check the value.');
    const t2 = q10Shift(t1, T1, T2, Q);
    q('.sl-big1').textContent = `${s3(t2)} ${unit()} at ${T2} °C`;
    const temps = Array.from({ length: 11 }, (_, i) => i * 5);
    rows1 = temps.map((T) => [`${T} °C`, `${s3(q10Shift(t1, T1, T, Q))} ${unit()}`]);
    table(q('.sl-tab1'), ['Temperature', `Shelf life (Q10 ${Q})`], rows1);
  }

  function two() {
    err('.sl-err2'); fit = null; q('.sl-out2').hidden = true;
    const text = q<HTMLTextAreaElement>('.sl-pts').value;
    if (!text.trim()) return;
    pts = [];
    for (const r of parseTable(text)) {
      const T = num(r[0]), t = num(r[1]);
      if (!Number.isFinite(T) && !Number.isFinite(t) && !pts.length) continue; // header row
      if (!Number.isFinite(T) || !Number.isFinite(t)) return err('.sl-err2', `"${r.join(', ')}" needs a temperature and a shelf life.`);
      pts.push({ T, t });
    }
    try { fit = fitShelf(pts); } catch (e) { return err('.sl-err2', (e as Error).message); }
    Tp = v('.sl-Tp');
    if (!Number.isFinite(Tp)) return err('.sl-err2', 'Give a temperature to predict at.');
    const f = fit, u = unit();
    q('.sl-out2').hidden = false;
    q('.sl-big2').textContent = `At ${Tp} °C: ${s3(f.predictQ10(Tp))} ${u} (Q10 model), ${s3(f.predictArr(Tp))} ${u} (Arrhenius)`;
    const facts: [string, string][] = [['Fitted Q10', s3(f.q10)], ['R² (Q10 model)', f.q10Line.r2.toFixed(4)], ['Activation energy Ea', `${s3(f.Ea / 1000)} kJ/mol`], ['R² (Arrhenius)', f.arrLine.r2.toFixed(4)], [`Q10 from Ea at ${Tp} °C`, s3(q10FromEa(f.Ea, Tp))], ['Test points', String(f.n)]];
    q('.sl-facts').replaceChildren(...facts.map(([k, x]) => { const d = document.createElement('div'); const dt = document.createElement('dt'); dt.textContent = k; const dd = document.createElement('dd'); dd.textContent = x; d.append(dt, dd); return d; }));
    rows2 = pts.map((p) => [`${p.T} °C`, `${s3(p.t)}`, s3(f.predictQ10(p.T)), s3(f.predictArr(p.T))]);
    table(q('.sl-tab2'), ['Temperature', `Measured (${u})`, 'Q10 model', 'Arrhenius'], rows2);
    const lo = Math.min(Tp, ...pts.map((p) => p.T)), hi = Math.max(Tp, ...pts.map((p) => p.T));
    const xs = Array.from({ length: 61 }, (_, i) => lo + ((hi - lo) * i) / 60);
    fig = chartFigure({ w: 520, h: 340, yLog: true, xLabel: 'Temperature (°C)', yLabel: `Shelf life (${u})`, legend: 'below', series: [
      { name: 'Test points', x: pts.map((p) => p.T), y: pts.map((p) => p.t), mode: 'points' },
      { name: 'Q10 model', x: xs, y: xs.map(f.predictQ10), mode: 'line', width: 2 },
      { name: 'Arrhenius', x: xs, y: xs.map(f.predictArr), mode: 'line', width: 2, dash: [6, 4] },
    ], marks: [{ kind: 'vline', at: Tp, dash: [3, 3], label: `${Tp} °C` }] }, `Shelf life against temperature on a log scale: ${f.n} test points with the fitted Q10 (${s3(f.q10)}) and Arrhenius (Ea ${s3(f.Ea / 1000)} kJ/mol) lines`);
    paint(q<HTMLCanvasElement>('.sl-fig'), fig);
  }

  let aw: string[] = [];
  function three() {
    err('.sl-err3'); aw = [];
    const erh = v('.sl-erh');
    if (Number.isFinite(erh)) {
      if (erh < 0 || erh > 100) err('.sl-err3', 'ERH must be from 0 to 100 %.');
      else aw.push(`From ERH ${erh} %: aw = ${awFromErh(erh).toFixed(3)}`);
    }
    const w = v('.sl-w'), s = v('.sl-s'), m = v('.sl-m'), K = v('.sl-k');
    if (Number.isFinite(s) && Number.isFinite(m)) {
      try { const r = norrish(w, s, m, Number.isFinite(K) ? K : 0); aw.push(`Solution: aw = ${r.aw.toFixed(4)} (water mole fraction ${r.xw.toFixed(4)}, solute ${r.xs.toFixed(4)}, K ${Number.isFinite(K) ? K : 0}), ERH ${(100 * r.aw).toFixed(1)} %`); }
      catch (e) { err('.sl-err3', (e as Error).message); }
    }
    q('.sl-big3').textContent = aw.join('. ');
    q('.sl-big3').style.fontSize = '18px';
  }

  const sections = (): Section[] => [
    ...(rows1.length ? [{ title: 'Shelf life at another temperature', text: [q('.sl-big1').textContent ?? ''], facts: [['Known', `${v('.sl-t1')} ${unit()} at ${v('.sl-T1')} °C`], ['Q10', String(v('.sl-q10'))]] as [string, string][], table: { head: ['Temperature', 'Shelf life'], rows: rows1, align: ['l', 'r'] as ('l' | 'r')[] } }] : []),
    ...(fit ? [{ title: 'Fit from test points', text: [q('.sl-big2').textContent ?? ''], facts: [...q('.sl-facts').querySelectorAll('div')].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.textContent!]) as [string, string][], figure: fig ?? undefined, table: { head: ['Temperature', `Measured (${unit()})`, 'Q10 model', 'Arrhenius'], rows: rows2, align: ['l', 'r', 'r', 'r'] as ('l' | 'r')[] } }] : []),
    ...(aw.length ? [{ title: 'Water activity', text: aw }] : []),
  ];

  const all = () => { one(); two(); three(); };
  let tm = 0;
  const later = (f: () => void) => { clearTimeout(tm); tm = window.setTimeout(f, 250); };
  for (const c of ['.sl-t1', '.sl-T1', '.sl-q10', '.sl-T2']) q(c).addEventListener('input', () => later(one));
  q('.sl-unit').addEventListener('change', all);
  for (const c of ['.sl-pts', '.sl-Tp']) q(c).addEventListener('input', () => later(two));
  for (const c of ['.sl-erh', '.sl-w', '.sl-s', '.sl-m', '.sl-k']) q(c).addEventListener('input', () => later(three));
  q('.sl-ex').addEventListener('click', () => {
    const set = (c: string, x: string) => { q<HTMLInputElement>(c).value = x; };
    set('.sl-t1', '180'); set('.sl-T1', '25'); set('.sl-q10', '2.5'); set('.sl-T2', '5'); q<HTMLSelectElement>('.sl-unit').value = 'days';
    q<HTMLTextAreaElement>('.sl-pts').value = EXAMPLE_POINTS; set('.sl-Tp', '20');
    set('.sl-erh', '85'); set('.sl-w', '100'); set('.sl-s', '60'); set('.sl-m', '342.3'); set('.sl-k', '0');
    all();
  });
  q('.sl-csv').addEventListener('click', () => {
    if (!fit) return;
    const f = fit;
    save(new Blob([csv([['temperature_C', `shelf_life_${unit()}`, 'q10_model', 'arrhenius_model'], ...pts.map((p) => [p.T, p.t, f.predictQ10(p.T).toPrecision(6), f.predictArr(p.T).toPrecision(6)]), [],
      ['q10', f.q10.toPrecision(6)], ['q10_r2', f.q10Line.r2.toFixed(6)], ['Ea_J_per_mol', f.Ea.toPrecision(6)], ['arrhenius_r2', f.arrLine.r2.toFixed(6)],
      [`predicted_at_${Tp}C_q10`, f.predictQ10(Tp).toPrecision(6)], [`predicted_at_${Tp}C_arrhenius`, f.predictArr(Tp).toPrecision(6)]])], { type: 'text/csv' }), 'shelf-life-fit.csv', 'text/csv');
  });
  wireDownloads(q('.dl'), () => ({ title: 'Shelf life and water activity', subtitle: 'For study and planning; confirm with tests on the product.', file: 'shelf-life', sections: sections() }));
  document.addEventListener('fibub:theme', () => { if (fig && fit) paint(q<HTMLCanvasElement>('.sl-fig'), fig); });
  one();
</script>
