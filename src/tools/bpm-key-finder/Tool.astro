---
// #T1023 Key finder
---
<div class="tool-ui bkf">
  <label>TODO input <input class="bkf-in" type="number" value="1" step="any" /></label>
  <p class="bkf-out" aria-live="polite"></p>
</div>

<style is:inline>
  .bkf { display: grid; gap: .75rem; }
</style>

<script>
  // Keep the maths in src/lib/ (or src/lib/sci/ for science) as plain TypeScript; import heavy libraries with import().
  const root = document.querySelector('.bkf') as HTMLElement;
  const input = root.querySelector('.bkf-in') as HTMLInputElement;
  const out = root.querySelector('.bkf-out') as HTMLElement;
  const update = () => { out.textContent = 'TODO result for ' + input.value; };
  input.addEventListener('input', update);
  update();
</script>
