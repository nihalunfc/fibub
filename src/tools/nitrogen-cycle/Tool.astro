---
// Nitrogen cycle game (Learn): follow one nitrogen atom through the air, soil bacteria, plants, animals and decay
// by picking the right process at each step, or name the highlighted arrow. Level switch adds bacteria and
// chemistry (Class 11). Teaching model; nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm nc">
  <div class="ax-card">
    <h2>The nitrogen cycle</h2>
    <div class="ax-row">
      <div class="ax-seg nc-mode" role="group" aria-label="Game">
        <button type="button" data-m="follow" aria-pressed="true">Follow an atom</button>
        <button type="button" data-m="name" aria-pressed="false">Name the arrow</button>
      </div>
      <div class="ax-seg nc-lvl" role="group" aria-label="Level">
        <button type="button" data-l="9" aria-pressed="true">Class 8–9</button>
        <button type="button" data-l="11" aria-pressed="false">Class 11</button>
      </div>
    </div>
    <p class="sm-f nc-ask" aria-live="polite" style="margin-top:10px"></p>
    <svg class="sm-fig nc-fig" viewBox="0 0 340 330" role="img" aria-label="The nitrogen stores joined by numbered arrows; the nitrogen atom is shown as a dot"></svg>
    <div class="nc-btns" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,150px),1fr));gap:8px;margin-top:10px"></div>
    <p class="sm-f nc-out" aria-live="polite"></p>
    <ol class="sm-steps nc-path"></ol>
    <div class="ax-row" style="margin-top:8px">
      <button type="button" class="btn secondary small nc-new">New challenge</button>
    </div>
  </div>

  <div class="ax-card">
    <h2>The processes</h2>
    <ol class="sm-try nc-list"></ol>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Take an atom from the air into an animal in as few steps as you can. Three is the least.</li>
      <li>Find two different ways for nitrogen to leave the air. Which one needs no living thing?</li>
      <li>Waterlogged fields lose nitrogen. Which arrow is that, and which bacteria do it?</li>
      <li>Why do farmers grow peas or beans between cereal crops? Look at arrow 1.</li>
    </ul>
    <p class="ax-help">A teaching model: the real cycle has more side paths (for example ammonia escaping to the air, and nitrate washing into rivers).</p>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Type the number of your answer. Nothing is saved.</p>
    <div class="nc-quiz"></div>
  </div>
</div>

<style is:inline>
  .nc svg .nc-box { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .nc svg .nc-here { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2.5; }
  .nc svg .nc-goal { stroke: var(--good); stroke-width: 3; stroke-dasharray: 6 3; }
  .nc svg .nc-arr { fill: none; stroke: var(--muted); stroke-width: 2; }
  .nc svg .nc-arr.hum { stroke-dasharray: 5 4; }
  .nc svg .nc-arr.on { stroke: var(--accent); stroke-width: 4; }
  .nc svg .nc-num { fill: var(--surface); stroke: var(--muted); stroke-width: 1.5; }
  .nc svg .nc-num.on { fill: var(--accent); stroke: var(--accent); }
  .nc svg .nc-nt { font-size: 11px; font-weight: 700; }
  .nc svg .nc-nt.on { fill: var(--accent-ink); }
  .nc svg .nc-atom { fill: var(--bad); stroke: var(--surface); stroke-width: 2; }
  .nc svg .nc-sm { font-size: 10.5px; fill: var(--muted); }
  .nc .nc-btns button { min-height: 44px; text-align: left; }
  .nc .nc-out .good { color: var(--good); font-weight: 700; }
  .nc .nc-out .bad { color: var(--bad); font-weight: 700; }
</style>

<script>
  import { STORES, PROCESSES, outOf, shortest, shortestLoop, type Store, type Process } from '../../lib/sci/nitrogen-cycle';
  import { randInt } from '../../lib/sci/smath';
  import { S, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.nc')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.nc-fig'), btns = q('.nc-btns'), out = q('.nc-out'), ask = q('.nc-ask');
  let mode: 'follow' | 'name' = 'follow', level = 9;
  let at: Store = 'air', goal: Store = 'animals', path: Process[] = [], won = false, loop = false;
  let lit: Process | null = null, tally = { right: 0, tries: 0 }, answered = false;

  // Box centres and sizes on the 340 × 330 picture, and each arrow's path and number badge.
  const BOX: Record<Store, [number, number]> = { air: [170, 32], plants: [58, 150], animals: [58, 286], dead: [170, 286], ammonium: [270, 150], nitrate: [270, 286] };
  const W = 92, H = 44;
  const ARROW: Record<string, [string, number, number]> = {
    fix: ['M206,54 Q250,70 256,126', 244, 80],
    haber: ['M188,54 Q200,110 236,128', 206, 104],
    light: ['M216,24 C336,24 336,200 302,262', 328, 136],
    nitrif: ['M270,172 L270,262', 270, 218],
    assimN: ['M224,278 Q160,230 106,168', 160, 232],
    assimA: ['M224,146 L106,146', 150, 146],
    eat: ['M58,172 L58,262', 58, 218],
    dieP: ['M92,172 Q120,220 148,262', 118, 212],
    dieA: ['M104,286 L122,286', 114, 318],
    ammon: ['M204,264 Q214,214 236,174', 220, 238],
    denit: ['M232,264 Q172,176 162,56', 182, 186],
  };

  const text = (p: Process) => (level === 11 ? p.detail : p.simple);
  const num = (p: Process) => PROCESSES.indexOf(p) + 1;
  const say = (cls: string, strong: string, rest = '') => { const b = document.createElement('span'); b.className = cls; b.textContent = strong; out.replaceChildren(b, rest ? ' ' + rest : ''); };

  function draw() {
    fig.replaceChildren();
    const defs = S('defs', {}, fig);
    for (const [id, col] of [['nc-a', 'var(--muted)'], ['nc-b', 'var(--accent)']]) {
      const m = S('marker', { id, viewBox: '0 0 10 10', refX: 8, refY: 5, markerWidth: 5, markerHeight: 5, orient: 'auto-start-reverse' }, defs);
      S('path', { d: 'M0,0 L10,5 L0,10 z', style: `fill:${col}` }, m);
    }
    for (const p of PROCESSES) {
      const on = lit === p;
      S('path', { d: ARROW[p.id][0], class: `nc-arr${p.human ? ' hum' : ''}${on ? ' on' : ''}`, 'marker-end': `url(#${on ? 'nc-b' : 'nc-a'})` }, fig);
    }
    for (const [s, [x, y]] of Object.entries(BOX) as [Store, [number, number]][]) {
      const cls = mode === 'follow' && s === at ? 'nc-box nc-here' : 'nc-box';
      S('rect', { x: x - W / 2, y: y - H / 2, width: W, height: H, rx: 8, class: cls + (mode === 'follow' && s === goal && !won ? ' nc-goal' : '') }, fig);
      S('text', { x, y: y - 3, 'text-anchor': 'middle', style: 'font-weight:700;font-size:12px' }, fig, STORES[s].name.replace(' & wastes', ''));
      S('text', { x, y: y + 12, 'text-anchor': 'middle', class: 'nc-sm' }, fig, level === 11 ? STORES[s].form : s === 'dead' ? '& wastes' : '');
    }
    // Numbered badges on each arrow.
    for (const p of PROCESSES) {
      const [, bx, by] = ARROW[p.id], on = lit === p;
      S('circle', { cx: bx, cy: by, r: 9, class: `nc-num${on ? ' on' : ''}` }, fig);
      S('text', { x: bx, y: by + 4, 'text-anchor': 'middle', class: `nc-nt${on ? ' on' : ''}` }, fig, String(num(p)));
    }
    if (mode === 'follow') { const [x, y] = BOX[at]; S('circle', { cx: x + W / 2 - 10, cy: y - H / 2 + 10, r: 7, class: 'nc-atom' }, fig); S('text', { x: x + W / 2 - 10, y: y - H / 2 + 14, 'text-anchor': 'middle', style: 'font-size:9px;font-weight:700;fill:#fff' }, fig, 'N'); }
    q('.nc-list').replaceChildren(...PROCESSES.map((p) => { const li = document.createElement('li'); const b = document.createElement('b'); b.textContent = p.name + (p.human ? ' (people)' : '') + ': '; li.append(b, `${STORES[p.from].name} → ${STORES[p.to].name}. ${text(p)}`); return li; }));
  }

  function buttons() {
    const list = mode === 'follow' ? PROCESSES : choices;
    btns.replaceChildren(...list.map((p) => {
      const b = document.createElement('button'); b.type = 'button'; b.className = 'btn secondary small nc-b'; b.dataset.id = p.id; b.textContent = p.name;
      b.addEventListener('click', () => (mode === 'follow' ? move(p) : guess(p)));
      return b;
    }));
  }

  function newFollow() {
    const stores = Object.keys(STORES) as Store[];
    at = stores[randInt(0, stores.length - 1)];
    loop = Math.random() < 0.3;
    do goal = stores[randInt(0, stores.length - 1)]; while (!loop && goal === at);
    if (loop) goal = at;
    path = []; won = false; lit = null; out.textContent = '';
    const best = loop ? shortestLoop(at)! : shortest(at, goal)!;
    ask.textContent = loop ? `Your atom is in ${STORES[at].name}. Take it round the cycle and back again. Pick a process to move it. (Fewest steps: ${best.length}.)` : `Your atom is in ${STORES[at].name}. Get it to ${STORES[goal].name} (green dashed box). Pick a process to move it. (Fewest steps: ${best.length}.)`;
    q('.nc-path').replaceChildren(); buttons(); draw();
  }
  function move(p: Process) {
    if (won) return;
    if (p.from !== at) { lit = null; draw(); say('bad', 'That process does not start here.', `${p.name} moves nitrogen from ${STORES[p.from].name} to ${STORES[p.to].name}. From ${STORES[at].name} you can use: ${outOf(at).map((o) => o.name).join(', ')}.`); return; }
    at = p.to; path.push(p); lit = p;
    const li = document.createElement('li'); li.textContent = `${p.name}: ${STORES[p.from].name} → ${STORES[p.to].name}`; q('.nc-path').append(li);
    if (at === goal) {
      won = true;
      const best = loop ? shortestLoop(goal)! : shortest(path[0].from, goal)!;
      say('good', `Made it in ${path.length} step${path.length === 1 ? '' : 's'}!`, path.length <= best.length ? 'That is the fewest possible.' : `The fewest is ${best.length}: ${best.map((id) => PROCESSES.find((x) => x.id === id)!.name).join(' → ')}.`);
    } else say('', `${p.name}.`, text(p));
    draw();
  }

  let choices: Process[] = [];
  function newName() {
    lit = PROCESSES[randInt(0, PROCESSES.length - 1)]; answered = false;
    const others = PROCESSES.filter((p) => p !== lit).sort(() => Math.random() - 0.5).slice(0, 3);
    choices = [lit, ...others].sort(() => Math.random() - 0.5);
    ask.textContent = `Arrow ${num(lit)} is lit up: ${STORES[lit.from].name} → ${STORES[lit.to].name}. What is this process called?`;
    out.textContent = ''; q('.nc-path').replaceChildren(); buttons(); draw();
  }
  function guess(p: Process) {
    if (answered || !lit) return;
    answered = true; tally.tries++;
    if (p === lit) { tally.right++; say('good', 'Right!', `${text(lit)} (${tally.right} of ${tally.tries} right.)`); }
    else say('bad', `No, that is ${p.name}.`, `Arrow ${num(lit)} is ${lit.name}: ${text(lit)} (${tally.right} of ${tally.tries} right.)`);
  }

  const start = () => (mode === 'follow' ? newFollow() : newName());
  q('.nc-new').addEventListener('click', start);
  for (const b of root.querySelectorAll<HTMLButtonElement>('.nc-mode button')) b.addEventListener('click', () => {
    mode = b.dataset.m as 'follow' | 'name';
    for (const o of root.querySelectorAll('.nc-mode button')) o.setAttribute('aria-pressed', String(o === b));
    start();
  });
  for (const b of root.querySelectorAll<HTMLButtonElement>('.nc-lvl button')) b.addEventListener('click', () => {
    level = Number(b.dataset.l);
    for (const o of root.querySelectorAll('.nc-lvl button')) o.setAttribute('aria-pressed', String(o === b));
    draw();
  });
  // Start with a fixed first challenge so the page reads the same each time: air to animals.
  at = 'air'; goal = 'animals'; ask.textContent = `Your atom is in Air. Get it to Animals (green dashed box). Pick a process to move it. (Fewest steps: ${shortest('air', 'animals')!.length}.)`;
  buttons(); draw();

  quiz(q('.nc-quiz'), () => {
    const outq: Question[] = [];
    const mc = (p: Process, stem: string) => {
      const opts = [p, ...PROCESSES.filter((x) => x !== p && x.from !== p.from).sort(() => Math.random() - 0.5).slice(0, 3)].sort(() => Math.random() - 0.5);
      outq.push({ q: `${stem} ${opts.map((o, i) => `(${i + 1}) ${o.name}`).join('  ')}`, want: [opts.indexOf(p) + 1], hint: '1 to 4', work: `${p.name}: ${p.simple}` });
    };
    const pool = PROCESSES.filter((p) => !p.human).sort(() => Math.random() - 0.5);
    const stems: Record<string, string> = { fix: 'Which process turns nitrogen gas into ammonia, done by bacteria in root nodules?', light: 'Which process joins nitrogen and oxygen without any living thing?', nitrif: 'Which process turns ammonium into nitrite and then nitrate?', assimN: 'How does nitrate get from the soil into plants?', assimA: 'Which process takes ammonium straight into a plant?', eat: 'How do animals get nitrogen?', dieP: 'How does nitrogen in a plant reach the dead matter in the soil?', dieA: 'How does nitrogen leave an animal?', ammon: 'Which process makes decomposers release ammonia from dead matter?', denit: 'Which process returns nitrogen to the air from waterlogged soil?' };
    for (const p of pool.slice(0, 3)) mc(p, stems[p.id]);
    const pairs: [Store, Store][] = [['air', 'animals'], ['animals', 'air'], ['dead', 'plants'], ['air', 'plants'], ['plants', 'ammonium'], ['dead', 'air']];
    const [a, b] = pairs[randInt(0, pairs.length - 1)], s = shortest(a, b)!;
    outq.push({ q: `What is the fewest number of processes that carry nitrogen from ${STORES[a].name} to ${STORES[b].name}?`, want: [s.length], work: s.map((id) => PROCESSES.find((x) => x.id === id)!.name).join(' → ') + ` (${s.length} steps).` });
    return outq;
  });
</script>
