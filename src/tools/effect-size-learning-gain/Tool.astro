---
// Effect sizes (Cohen's d, Hedges' g, Glass's delta, paired dz and dav) with intervals, and Hake's normalised gain.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
---
<div class="ax es">
  <div class="ax-card">
    <h2>What are you comparing?</h2>
    <div class="ax-seg es-mode" role="group" aria-label="Comparison">
      <button type="button" data-m="groups" aria-pressed="true">Two groups</button><button type="button" data-m="paired" aria-pressed="false">Before and after</button><button type="button" data-m="gain" aria-pressed="false">Learning gain</button>
    </div>
    <p class="ax-help es-what"></p>

    <div class="es-p" data-m="groups">
      <label class="es-srcl">Enter <select class="es-src"><option value="sum" selected>Means, SDs and sizes</option><option value="raw">Raw scores</option></select></label>
      <div class="es-s" data-s="sum">
        <div class="ax-grid">
          <label>Group 1 mean <input class="es-m1" inputmode="decimal" value="78.4" /></label>
          <label>Group 1 SD <input class="es-s1" inputmode="decimal" value="9.6" /></label>
          <label>Group 1 size <input class="es-n1" inputmode="numeric" value="24" /></label>
          <label>Group 2 mean <input class="es-m2" inputmode="decimal" value="72.1" /></label>
          <label>Group 2 SD <input class="es-s2" inputmode="decimal" value="10.8" /></label>
          <label>Group 2 size <input class="es-n2" inputmode="numeric" value="26" /></label>
        </div>
        <p class="ax-help">Made-up example: a new teaching method (group 1) against the usual one (group 2). Group 2 is the control; Glass's delta uses its SD.</p>
      </div>
      <div class="es-s" data-s="raw" hidden>
        <label>Two columns: group 1 and group 2. A header row is optional. If the groups differ in size, put the larger one first.
          <textarea class="es-graw" rows="7" spellcheck="false" wrap="off">New	Usual
82	70
75	68
88	79
79	74
71	65
84	77
77	72
90	69
80</textarea></label>
        <DataFile target=".es-graw" maxCols={2} />
      </div>
    </div>

    <div class="es-p" data-m="paired" hidden>
      <label class="es-srcl">Enter <select class="es-src"><option value="sum" selected>Means, SDs and correlation</option><option value="raw">Raw scores</option></select></label>
      <div class="es-s" data-s="sum">
        <div class="ax-grid">
          <label>Before mean <input class="es-pm1" inputmode="decimal" value="61.2" /></label>
          <label>Before SD <input class="es-ps1" inputmode="decimal" value="12.4" /></label>
          <label>After mean <input class="es-pm2" inputmode="decimal" value="68.9" /></label>
          <label>After SD <input class="es-ps2" inputmode="decimal" value="11.7" /></label>
          <label>People <input class="es-pn" inputmode="numeric" value="20" /></label>
          <label>Correlation r <input class="es-pr" inputmode="decimal" value="0.72" /></label>
          <label>or SD of differences <input class="es-psd" inputmode="decimal" value="" placeholder="optional" /></label>
        </div>
        <p class="ax-help">Made-up example: 20 students tested before and after a unit. The correlation between the two tests (or the SD of each student's change) is needed for dz; if you give the SD of differences, it is used instead of r.</p>
      </div>
      <div class="es-s" data-s="raw" hidden>
        <label>Two columns: before and after, one row per person. A header row is optional.
          <textarea class="es-praw" rows="7" spellcheck="false" wrap="off">Pre	Post
12	15
15	18
9	13
20	22
14	15
11	16
17	19
13	17
10	12
16	20</textarea></label>
        <DataFile target=".es-praw" maxCols={2} />
      </div>
    </div>

    <div class="es-p" data-m="gain" hidden>
      <label class="es-srcl">Enter <select class="es-src"><option value="raw" selected>Each student's scores</option><option value="sum">Class means</option></select></label>
      <div class="ax-grid" style="margin-top:10px"><label>Maximum score <input class="es-max" inputmode="decimal" value="25" /></label></div>
      <div class="es-s" data-s="raw">
        <label style="margin-top:10px">Two columns: pre-test and post-test, one row per student. A header row is optional.
          <textarea class="es-hraw" rows="7" spellcheck="false" wrap="off">Pre	Post
12	15
15	18
9	13
20	22
14	15
11	16
17	19
13	17
10	12
16	20</textarea></label>
        <DataFile target=".es-hraw" maxCols={2} />
      </div>
      <div class="es-s" data-s="sum" hidden>
        <div class="ax-grid" style="margin-top:10px">
          <label>Pre-test mean <input class="es-hpre" inputmode="decimal" value="13.7" /></label>
          <label>Post-test mean <input class="es-hpost" inputmode="decimal" value="16.7" /></label>
        </div>
      </div>
      <p class="ax-help">Made-up example: 10 students on a 25-mark concept test. Hake's gain is the share of the possible improvement that was made.</p>
    </div>

    <div class="ax-grid es-lv" style="margin-top:10px"><label>Confidence level <select class="es-level"><option value="0.9">90 %</option><option value="0.95" selected>95 %</option><option value="0.99">99 %</option></select></label></div>
    <p class="ax-err es-err" hidden></p>
  </div>

  <div class="ax-card es-out" hidden>
    <h2 class="es-h"></h2>
    <p class="ax-big es-big"></p>
    <dl class="ax-facts es-facts"></dl>
    <div class="ax-scroll" style="margin-top:12px"><table class="es-tab"></table></div>
    <div class="es-gw" hidden><h3 style="margin:16px 0 6px;font-size:16px">Each student</h3><div class="ax-scroll es-gs"><table class="es-gt"></table></div></div>
    <p class="ax-help es-note"></p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small es-csv">Download results (CSV)</button></div>
    <Downloads />
  </div>
</div>

<style is:inline>
  .es .es-p { margin-top: 12px; }
  .es .es-srcl { max-width: 280px; margin-bottom: 10px; }
  .es .es-tab td, .es .es-gt td { white-space: nowrap; }
  .es .es-gs { max-height: 320px; overflow-y: auto; }
</style>

<script>
  import { parseTable, num, sig, csv } from '../../lib/sci/num';
  import { mean, sd } from '../../lib/sci/stats';
  import { independent, paired, hake, hakeClass, gainBand, dBand } from '../../lib/sci/effectsize';
  import { wireDownloads, save, type Section } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.es')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string, el: ParentNode = root) => el.querySelector(c) as T;
  let mode = 'groups', report: Section[] = [], csvRows: (string | number)[][] = [];
  const WHAT: Record<string, string> = {
    groups: "Two separate groups, such as a class taught one way and a class taught another: Cohen's d, Hedges' g and Glass's delta.",
    paired: 'The same people measured twice: dz (change against the spread of changes) and dav (change against the average SD).',
    gain: "Hake's normalised gain for pre- and post-tests: the share of the possible improvement that was made.",
  };
  const f3 = (x: number) => (Number.isFinite(x) ? x.toFixed(3).replace(/^-/, '−') : '–');
  const ci = (c: [number, number]) => `${f3(c[0])} to ${f3(c[1])}`;
  const pTxt = (p: number) => (p < 0.001 ? '< 0.001' : '= ' + p.toFixed(3));
  const val = (c: string, name: string) => { const v = num(q<HTMLInputElement>(c).value); if (!Number.isFinite(v)) throw new Error(`Enter the ${name}.`); return v; };
  const src = () => q<HTMLSelectElement>('.es-src', q(`.es-p[data-m="${mode}"]`)).value;

  /** Two columns of numbers; blanks allowed (columns may differ in length). */
  function columns(text: string): { a: number[]; b: number[]; rows: [number, number][]; names: [string, string] } {
    const rows = parseTable(text);
    if (!rows.length) throw new Error('Paste two columns of numbers first.');
    const head = rows[0].some((c) => c.trim() !== '' && !Number.isFinite(num(c)));
    const body = head ? rows.slice(1) : rows;
    const cell = (c: string | undefined, i: number) => { const t = (c ?? '').trim(); if (!t) return NaN; const v = num(t); if (!Number.isFinite(v)) throw new Error(`"${t}" in row ${i + 1} is not a number.`); return v; };
    const pairs = body.map((r, i) => [cell(r[0], i), cell(r[1], i)] as [number, number]);
    return { a: pairs.map((p) => p[0]).filter(Number.isFinite), b: pairs.map((p) => p[1]).filter(Number.isFinite), rows: pairs.filter((p) => p.every(Number.isFinite)), names: [head ? rows[0][0] || 'Column 1' : 'Column 1', head ? rows[0][1] || 'Column 2' : 'Column 2'] };
  }
  function facts(list: [string, string][]) {
    const dl = q('.es-facts'); dl.innerHTML = '';
    for (const [k, v] of list) { const d = document.createElement('div'), dt = document.createElement('dt'), dd = document.createElement('dd'); dt.textContent = k; dd.textContent = v; d.append(dt, dd); dl.append(d); }
  }
  function table(t: HTMLTableElement, head: string[], rows: string[][]) {
    t.innerHTML = '';
    const hr = t.createTHead().insertRow();
    head.forEach((h, i) => { const th = document.createElement('th'); th.textContent = h; if (i) th.className = 'r'; hr.append(th); });
    const b = t.createTBody();
    rows.forEach((r) => { const tr = b.insertRow(); r.forEach((x, i) => { const td = tr.insertCell(); td.textContent = x; if (i) td.className = 'r'; }); });
  }

  function runGroups(level: number): Section[] {
    let g;
    if (src() === 'raw') {
      const { a, b } = columns(q<HTMLTextAreaElement>('.es-graw').value);
      g = { m1: mean(a), s1: sd(a), n1: a.length, m2: mean(b), s2: sd(b), n2: b.length };
    } else g = { m1: val('.es-m1', 'group 1 mean'), s1: val('.es-s1', 'group 1 SD'), n1: val('.es-n1', 'group 1 size'), m2: val('.es-m2', 'group 2 mean'), s2: val('.es-s2', 'group 2 SD'), n2: val('.es-n2', 'group 2 size') };
    if (!Number.isInteger(g.n1) || !Number.isInteger(g.n2)) throw new Error('Group sizes must be whole numbers.');
    const r = independent(g, level), L = `${Math.round(level * 100)} % interval`;
    q('.es-h').textContent = 'Two groups';
    q('.es-big').textContent = `g = ${f3(r.g)}`;
    const ff: [string, string][] = [
      ['Difference in means', sig(r.diff, 4)], ['Pooled SD', sig(r.sp, 4)],
      ['t test', `t(${r.df}) = ${r.t.toFixed(3)}, p ${pTxt(r.p)}`],
      ['Group 1', `${sig(g.m1, 4)} (SD ${sig(g.s1, 4)}, n ${g.n1})`], ['Group 2', `${sig(g.m2, 4)} (SD ${sig(g.s2, 4)}, n ${g.n2})`],
    ];
    facts(ff);
    const head = ['Measure', 'Value', L, 'Size'];
    const rows = [
      ["Hedges' g", f3(r.g), ci(r.gCi), dBand(r.g)],
      ["Cohen's d", f3(r.d), ci(r.dCi), dBand(r.d)],
      ["Glass's delta (group 2 SD)", f3(r.delta), ci(r.deltaCi) + ' (approx.)', dBand(r.delta)],
    ];
    table(q<HTMLTableElement>('.es-tab'), head, rows);
    q('.es-note').textContent = `d divides the difference in means by the pooled SD. g corrects d for small samples (× ${r.J.toFixed(4)}) and is the one to report in most studies and meta-analyses. Intervals for d and g are exact, from the noncentral t distribution; Glass's delta uses a normal approximation and is best when the treatment may change the spread. Sizes follow Cohen's rough guide (0.2 small, 0.5 medium, 0.8 large).`;
    csvRows = [head, ...rows];
    return [{ title: 'Two groups', facts: [['Hedges g', f3(r.g)], ...ff] }, { title: 'Effect sizes', table: { head, rows, align: ['l', 'r', 'r', 'r'] }, note: q('.es-note').textContent! }];
  }

  function runPaired(level: number): Section[] {
    let o;
    if (src() === 'raw') {
      const { rows } = columns(q<HTMLTextAreaElement>('.es-praw').value);
      const a = rows.map((x) => x[0]), b = rows.map((x) => x[1]);
      o = { m1: mean(a), s1: sd(a), m2: mean(b), s2: sd(b), n: rows.length, sdiff: sd(rows.map((x) => x[1] - x[0])) };
    } else {
      const sdt = q<HTMLInputElement>('.es-psd').value.trim();
      o = { m1: val('.es-pm1', 'before mean'), s1: val('.es-ps1', 'before SD'), m2: val('.es-pm2', 'after mean'), s2: val('.es-ps2', 'after SD'), n: val('.es-pn', 'number of people'), r: sdt ? undefined : val('.es-pr', 'correlation'), sdiff: sdt ? num(sdt) : undefined };
      if (sdt && !Number.isFinite(o.sdiff)) throw new Error('The SD of differences is not a number.');
    }
    if (!Number.isInteger(o.n)) throw new Error('The number of people must be a whole number.');
    const r = paired(o, level), L = `${Math.round(level * 100)} % interval`;
    q('.es-h').textContent = 'Before and after';
    q('.es-big').textContent = `dz = ${f3(r.dz)}`;
    const ff: [string, string][] = [
      ['Mean change', sig(r.diff, 4)], ['SD of changes', sig(r.sdiff, 4)], ['Correlation r', f3(r.r)],
      ['Paired t test', `t(${r.df}) = ${r.t.toFixed(3)}, p ${pTxt(r.p)}`], ['People', String(o.n)],
    ];
    facts(ff);
    const head = ['Measure', 'Value', L, 'Size'];
    const rows = [
      ['dz (change / SD of changes)', f3(r.dz), ci(r.dzCi), dBand(r.dz)],
      ['dav (change / average SD)', f3(r.dav), ci(r.davCi) + ' (approx.)', dBand(r.dav)],
      ['gz (small-sample corrected)', f3(r.gz), '', dBand(r.gz)],
      ['gav (small-sample corrected)', f3(r.gav), '', dBand(r.gav)],
    ];
    table(q<HTMLTableElement>('.es-tab'), head, rows);
    q('.es-note').textContent = 'dz goes with the paired t test (t = dz × √n) and its interval is exact. dav is on the same scale as a two-group d, so it is the one to compare with between-group studies; its interval is approximate (Borenstein et al. 2009). The g versions multiply by the small-sample correction for n − 1 degrees of freedom.';
    csvRows = [head, ...rows];
    return [{ title: 'Before and after', facts: [['dz', f3(r.dz)], ...ff] }, { title: 'Effect sizes', table: { head, rows, align: ['l', 'r', 'r', 'r'] }, note: q('.es-note').textContent! }];
  }

  function runGain(): Section[] {
    const max = val('.es-max', 'maximum score');
    q('.es-h').textContent = 'Normalised learning gain';
    if (src() === 'sum') {
      const pre = val('.es-hpre', 'pre-test mean'), post = val('.es-hpost', 'post-test mean');
      if (pre < 0 || post < 0 || pre > max || post > max) throw new Error(`Means must be between 0 and the maximum score (${max}).`);
      const g = hakeClass(pre, post, max);
      q('.es-big').textContent = `⟨g⟩ = ${f3(g)}`;
      const ff: [string, string][] = [['Reads as', `${gainBand(g)} gain`], ['Pre-test mean', `${sig(pre, 4)} (${(100 * pre / max).toFixed(1)} %)`], ['Post-test mean', `${sig(post, 4)} (${(100 * post / max).toFixed(1)} %)`]];
      facts(ff); q('.es-tab').innerHTML = ''; q('.es-gw').hidden = true;
      q('.es-note').textContent = "Hake (1998): below 0.3 low, 0.3 to 0.7 medium, above 0.7 high. With each student's scores you also get the average of individual gains.";
      csvRows = [['Measure', 'Value'], ['Class average gain', +g.toFixed(6)]];
      return [{ title: 'Normalised learning gain', facts: [['Class gain', f3(g)], ...ff], note: q('.es-note').textContent! }];
    }
    const { rows } = columns(q<HTMLTextAreaElement>('.es-hraw').value);
    if (rows.length < 1) throw new Error('Each row needs a pre-test and a post-test score.');
    const h = hake(rows.map((x) => x[0]), rows.map((x) => x[1]), max);
    q('.es-big').textContent = `⟨g⟩ = ${f3(h.classGain)}`;
    const ff: [string, string][] = [
      ['Reads as', `${gainBand(h.classGain)} gain`],
      ['Average of individual gains', f3(h.averageGain) + (h.excluded ? ` (${h.excluded} at the maximum left out)` : '')],
      ['Pre-test mean', `${sig(h.mPre, 4)} (${(100 * h.mPre / max).toFixed(1)} %)`],
      ['Post-test mean', `${sig(h.mPost, 4)} (${(100 * h.mPost / max).toFixed(1)} %)`],
      ['Students', String(h.n)],
    ];
    if (rows.length >= 3) { try { const p = paired({ m1: h.mPre, s1: sd(rows.map((x) => x[0])), m2: h.mPost, s2: sd(rows.map((x) => x[1])), n: rows.length, sdiff: sd(rows.map((x) => x[1] - x[0])) }); ff.push(['Paired effect size dz', `${f3(p.dz)} (${ci(p.dzCi)})`]); } catch { /* no spread */ } }
    facts(ff); q('.es-tab').innerHTML = '';
    const head = ['Student', 'Pre', 'Post', 'Gain g'];
    const gr = rows.map((x, i) => [String(i + 1), sig(x[0], 4), sig(x[1], 4), f3(h.individual[i])]);
    table(q<HTMLTableElement>('.es-gt'), head, gr); q('.es-gw').hidden = false;
    q('.es-note').textContent = "The class gain ⟨g⟩ = (post mean − pre mean) / (maximum − pre mean) is Hake's measure; the average of each student's own gain is usually close but gives more weight to students who started high. Students who scored the maximum on the pre-test have no individual gain and are left out of that average. Hake (1998): below 0.3 low, 0.3 to 0.7 medium, above 0.7 high.";
    csvRows = [head, ...rows.map((x, i) => [i + 1, x[0], x[1], Number.isFinite(h.individual[i]) ? +h.individual[i].toFixed(6) : ''])];
    return [{ title: 'Normalised learning gain', facts: [['Class gain', f3(h.classGain)], ...ff] }, { title: 'Each student', table: { head, rows: gr, align: ['l', 'r', 'r', 'r'] }, note: q('.es-note').textContent! }];
  }

  function calc() {
    const err = q('.es-err'), level = Number(q<HTMLSelectElement>('.es-level').value);
    try {
      if (mode !== 'gain') q('.es-gw').hidden = true;
      report = mode === 'groups' ? runGroups(level) : mode === 'paired' ? runPaired(level) : runGain();
      err.hidden = true; q('.es-out').hidden = false;
    } catch (e) { err.textContent = (e as Error).message.replace(/([^.])$/, '$1.'); err.hidden = false; q('.es-out').hidden = true; report = []; csvRows = []; }
  }
  function setMode(m: string) {
    mode = m;
    root.querySelectorAll<HTMLButtonElement>('.es-mode button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === m)));
    root.querySelectorAll<HTMLElement>('.es-p').forEach((p) => (p.hidden = p.dataset.m !== m));
    q('.es-what').textContent = WHAT[m];
    q('.es-lv').hidden = m === 'gain';
    calc();
  }
  root.querySelectorAll<HTMLButtonElement>('.es-mode button').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.m!)));
  root.querySelectorAll<HTMLSelectElement>('.es-src').forEach((s) => s.addEventListener('change', () => {
    s.closest('.es-p')!.querySelectorAll<HTMLElement>('.es-s').forEach((x) => (x.hidden = x.dataset.s !== s.value));
  }));
  let t = 0;
  root.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(calc, 250); });
  root.addEventListener('change', (e) => { if ((e.target as HTMLElement).matches('select')) calc(); });
  q('.es-csv').addEventListener('click', () => { if (csvRows.length > 1) save(new TextEncoder().encode(csv(csvRows)), 'effect-size.csv', 'text/csv'); });
  setMode('groups');
  wireDownloads(q('.dl'), () => ({ title: 'Effect size', file: 'effect-size', sections: report }));
</script>
