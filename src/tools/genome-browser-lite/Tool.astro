  .gbl .gb-files .gb-rm { grid-column: 2; grid-row: 1 / span 2; padding: 6px 10px; font-size: 14px; }
  .gbl .gb-where { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  @media (min-width: 640px) { .gbl .gb-where { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); } }
  .gbl .gb-go-f { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: end; margin: 0; }
  .gbl .gb-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 10px; }
  .gbl .gb-nav .btn { min-width: 44px; justify-content: center; }
  .gbl .gb-wrap { position: relative; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--bg); }
  .gbl .gb-cv { display: block; width: 100%; touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  .gbl .gb-cv:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .gbl .gb-tip { position: absolute; pointer-events: none; max-width: min(320px, 90%); background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; font-size: 12.5px; line-height: 1.35; white-space: pre-line; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12); }
  .gbl .gb-opts { margin-top: 10px; }
  .gbl .gb-chks { margin: 10px 0 12px; }
  .gbl .gb-dl { margin-top: 12px; }
  .gbl .gb-h3 { margin: 16px 0 6px; font-size: 1rem; }
  .gbl .gb-seq { margin-top: 8px; font-size: 12.5px; word-break: break-all; }
  .gbl .gb-attrs td:last-child { overflow-wrap: anywhere; word-break: break-word; }
</style>
