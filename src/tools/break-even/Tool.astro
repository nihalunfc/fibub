---
// #1730 Break-even: units and sales needed to cover costs.
---
<div class="tool-ui be">
  <section class="panel">
    <h2>Your numbers</h2>
    <div class="be-grid">
      <label>Currency <select class="be-cur" data-k="cur"></select></label>
      <label>Fixed costs (rent, pay, software) <input data-k="fixed" inputmode="decimal" /></label>
      <label>Selling price per unit <input data-k="price" inputmode="decimal" /></label>
      <label>Variable cost per unit <input data-k="var" inputmode="decimal" /></label>
      <label>Profit you want (optional) <input data-k="target" inputmode="decimal" /></label>
      <label>What if the price changes by <span class="be-suf"><input data-k="chg" inputmode="decimal" /><i>%</i></span></label>
    </div>
    <p class="note bad be-err" role="alert" hidden></p>
  </section>
  <section class="be-res" aria-live="polite">
    <div class="be-stats">
      <div class="good"><span>Break-even units</span><b class="be-s-units"></b></div>
      <div><span>Break-even sales</span><b class="be-s-rev"></b></div>
      <div><span>Profit per unit</span><b class="be-s-cm"></b></div>
      <div><span>Units for your target</span><b class="be-s-tgt"></b></div>
    </div>
    <p class="be-line be-words"></p>
    <figure class="be-chart panel">
      <figcaption>Sales and costs <span><i class="k-a"></i>Sales</span> <span><i class="k-b"></i>Total costs</span></figcaption>
      <svg class="be-svg" viewBox="0 0 640 220" role="img" aria-label="Sales and total costs by units sold, crossing at the break-even point"></svg>
    </figure>
    <div class="be-what panel"><h2>If the price changes</h2><p class="be-line be-whatout"></p></div>
  </section>
  <p class="be-fine">Break-even units = fixed costs divided by (price minus variable cost). Assumes the price and variable cost stay the same however many you sell. Units are rounded up. Not financial advice. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .be { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .be > *, .be-res > * { min-width: 0; }
  .be h2 { margin: 0 0 12px; font-size: 18px; }
  .be .panel { padding: 16px; }
  .be-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .be label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .be input, .be select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .be input:focus, .be select:focus { border-color: var(--accent); outline: none; }
  .be-suf { position: relative; display: block; }
  .be-suf i { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-style: normal; font-size: 13px; color: var(--muted); pointer-events: none; }
  .be-suf input { padding-right: 84px; }
  .be-res { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .be-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .be-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .be-stats span { font-size: 13px; color: var(--muted); }
  .be-stats b { font-size: clamp(17px, 3.4vw, 24px); overflow-wrap: anywhere; }
  .be-stats .good b { color: var(--good); }
  .be-line { margin: 0; font-size: 15px; }
  .be-line:empty { display: none; }
  .be-chart { margin: 0; }
  .be-chart figcaption { font-weight: 600; font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; margin-bottom: 8px; }
  .be-chart figcaption span { font-weight: 500; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }
  .be-chart i { display: inline-block; width: 18px; height: 3px; border-radius: 2px; }
  .k-a { background: var(--accent); }
  .k-b { background: var(--muted); opacity: .7; }
  .be-svg { width: 100%; height: auto; display: block; }
  .be-svg text { font: 11px system-ui, sans-serif; fill: var(--muted); }
  .be-wrap { overflow-x: auto; }
  .be table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .be th, .be td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .be th:first-child, .be td:first-child { text-align: left; }
  .be th { font-size: 12px; color: var(--muted); font-weight: 600; }
  .be details summary { cursor: pointer; font-weight: 700; margin-bottom: 8px; }
  .be details .btn { margin-top: 12px; }
  .be-fine { margin: 0; color: var(--muted); font-size: 13px; }
  .be-err { margin: 10px 0 0; }
  @media (max-width: 720px) { .be-stats { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  import { defaultCurrency, money, num, currencyOptions } from '../../lib/money';
  const root = document.querySelector<HTMLElement>('.be')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const f = (k: string) => q<HTMLInputElement>(`[data-k="${k}"]`);
  q('.be-cur').innerHTML = currencyOptions(defaultCurrency());
  f('fixed').value = '10,000'; f('price').value = '50'; f('var').value = '30'; f('target').value = '0'; f('chg').value = '10';
  const $ = (n: number, d = 0) => money(n, f('cur').value, d);
  const units = (fixed: number, price: number, v: number, profit = 0) => Math.ceil((fixed + profit) / (price - v) - 1e-9);
  function run() {
    const fixed = num(f('fixed').value), price = num(f('price').value), v = num(f('var').value), target = num(f('target').value), chg = num(f('chg').value);
    const bad = fixed < 0 || v < 0 || target < 0 ? 'Costs and profit cannot be negative.' : !(price > 0) ? 'Enter the selling price per unit.' : price <= v ? `Your price must be higher than the variable cost (${$(v, 2)}), or each sale loses money and you never break even.` : '';
    q('.be-err').hidden = !bad; q('.be-err').textContent = bad; q('.be-res').hidden = !!bad;
    if (bad) return;
    const cm = price - v, n = units(fixed, price, v);
    q('.be-s-units').textContent = n.toLocaleString();
    q('.be-s-rev').textContent = $(n * price);
    q('.be-s-cm').textContent = $(cm, 2);
    q('.be-s-tgt').textContent = target > 0 ? units(fixed, price, v, target).toLocaleString() : 'Add a target';
    q('.be-words').innerHTML = `Each unit leaves <b>${$(cm, 2)}</b> (${Math.round((cm / price) * 1000) / 10}% of the price) after its own costs. You need ${n.toLocaleString()} units to cover <b>${$(fixed)}</b> of fixed costs.${target > 0 ? ` To also make ${$(target)} profit, sell ${units(fixed, price, v, target).toLocaleString()} units (${$(units(fixed, price, v, target) * price)} in sales).` : ''}`;
    const max = Math.max(n * 2, 10), W = 640, H = 220, L = 56, R = 10, T = 10, B = 26, top = max * price;
    const x = (u: number) => L + (u / max) * (W - L - R), y = (val: number) => T + (1 - val / top) * (H - T - B);
    const short = (val: number) => new Intl.NumberFormat(undefined, { notation: 'compact', maximumFractionDigits: 1 }).format(val);
    let t = '';
    for (const k of [0, 0.5, 1]) t += `<line x1="${L}" x2="${W - R}" y1="${y(top * k)}" y2="${y(top * k)}" stroke="var(--line)"/><text x="${L - 6}" y="${y(top * k) + 4}" text-anchor="end">${short(top * k)}</text><text x="${x(max * k)}" y="${H - 8}" text-anchor="middle">${short(max * k)}</text>`;
    t += `<line x1="${x(0)}" y1="${y(fixed)}" x2="${x(max)}" y2="${y(fixed + v * max)}" stroke="var(--muted)" stroke-width="2" stroke-dasharray="5 4"/><line x1="${x(0)}" y1="${y(0)}" x2="${x(max)}" y2="${y(price * max)}" stroke="var(--accent)" stroke-width="2.5"/><circle cx="${x(n)}" cy="${y(n * price)}" r="5" fill="var(--accent)"/><text x="${x(n) + 8}" y="${y(n * price) + 16}">${n.toLocaleString()} units</text>`;
    q('.be-svg').innerHTML = t;
    const np = price * (1 + chg / 100);
    q('.be-whatout').innerHTML = np <= v ? `At a price of ${$(np, 2)} you would not cover the variable cost.` : `At ${chg >= 0 ? '+' : ''}${chg}% the price is ${$(np, 2)}, so you break even at <b>${units(fixed, np, v).toLocaleString()} units</b> (${$(units(fixed, np, v) * np)} in sales) instead of ${n.toLocaleString()}.`;
  }
  root.addEventListener('input', run); root.addEventListener('change', run);
  run();
</script>
