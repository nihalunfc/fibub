---
// Pythagoras playground: drag a right triangle and watch the squares on its sides; four visual proofs with the
// current side lengths; a Pythagorean triple generator. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm py">
  <div class="ax-card">
    <h2>Squares on the sides</h2>
    <svg class="sm-fig py-fig" viewBox="0 0 340 340" role="img" aria-label="A right triangle with a square drawn on each side"></svg>
    <p class="ax-help">Drag the two blue corners to change the legs a and b. The right angle stays at the corner marked with a small square.</p>
    <div class="sm-sl"><b>a</b><input type="range" class="py-ar" min="1" max="12" step="0.5" value="3" aria-label="a slider" /><input type="number" class="py-a" min="0.1" step="0.5" value="3" inputmode="decimal" aria-label="a" /></div>
    <div class="sm-sl"><b>b</b><input type="range" class="py-br" min="1" max="12" step="0.5" value="4" aria-label="b slider" /><input type="number" class="py-b" min="0.1" step="0.5" value="4" inputmode="decimal" aria-label="b" /></div>
    <p class="ax-err py-err" hidden></p>
    <p class="sm-f py-sum" aria-live="polite"></p>
    <p class="sm-f py-c"></p>
  </div>

  <div class="ax-card">
    <h2>Why it is true: four proofs</h2>
    <div class="ax-seg py-proof" role="group" aria-label="Proof">
      <button type="button" data-p="rearrange" aria-pressed="true">Rearrange</button>
      <button type="button" data-p="bhaskara" aria-pressed="false">Bhaskara</button>
      <button type="button" data-p="similar" aria-pressed="false">Similar triangles</button>
      <button type="button" data-p="baudhayana" aria-pressed="false">Baudhayana</button>
    </div>
    <svg class="sm-fig py-pf" viewBox="0 0 340 300" role="img" aria-label="Proof picture" style="margin-top:10px"></svg>
    <div class="sm-sl py-trow"><b>t</b><input type="range" class="py-t" min="0" max="1" step="0.01" value="0" aria-label="Slide the triangles" /><span class="ax-help py-tv" style="margin:0">start</span></div>
    <ol class="sm-steps py-steps"></ol>
  </div>

  <div class="ax-card">
    <h2>Pythagorean triples</h2>
    <p class="ax-help">Whole numbers a, b, c with a² + b² = c². A primitive triple has no common factor; the others are its multiples.</p>
    <div class="ax-grid">
      <label>Largest hypotenuse <input type="number" class="py-max" min="5" max="500" step="1" value="50" inputmode="numeric" /></label>
      <label>Class 8 rule: m <input type="number" class="py-m" min="2" max="100" step="1" value="4" inputmode="numeric" /></label>
    </div>
    <label class="ax-check" style="margin-top:8px"><input type="checkbox" class="py-prim" /> Primitive triples only</label>
    <p class="sm-f py-mrule"></p>
    <p class="ax-help py-tcount"></p>
    <div class="ax-scroll" style="max-height:320px"><table class="py-tab"></table></div>
    <p class="ax-help">Tap a row to draw that triangle above.</p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Make a = 6 and b = 8. Is c a whole number? Now try a = 6, b = 7.</li>
      <li>In the Rearrange proof, slide t slowly. The four triangles only slide; the empty space changes shape but never changes area.</li>
      <li>Set a = b. Bhaskara's middle square disappears, and Baudhayana's square-doubling picture appears inside it.</li>
      <li>Pick m = 5, 6 and 7 in the Class 8 rule. Check each triple in the triangle above.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Give answers to 2 decimal places when they are not whole. Nothing is saved.</p>
    <div class="py-quiz"></div>
  </div>
</div>

<style is:inline>
  .py .py-tab tr[data-i] { cursor: pointer; }
  .py .py-tab tr.on td { background: var(--accent-soft); }
  .py .py-proof button { flex: 1 1 auto; }
</style>

<script>
  import { triples, tripleFrom, rearrangement, bhaskara, altitudeSplit, hyp, type Pt } from '../../lib/sci/pythagoras-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, dragOn, pair, val, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.py')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.py-fig'), pf = q<SVGSVGElement>('.py-pf');
  const A = q<HTMLInputElement>('.py-a'), B = q<HTMLInputElement>('.py-b');
  const setA = pair(q('.py-ar'), A, draw), setB = pair(q('.py-br'), B, draw);
  let proof = 'rearrange', dragging = false, scale = 1, ox = 0, oy = 0;
  const pts = (p: Pt[]) => p.map(([x, y]) => `${(ox + x * scale).toFixed(1)},${(oy - y * scale).toFixed(1)}`).join(' ');

  function sides() {
    const a = val(A, 3, 0.1, 1000), b = val(B, 4, 0.1, 1000);
    return { a, b, c: hyp(a, b) };
  }

  function main() {
    const { a, b, c } = sides();
    // Fit everything (triangle and three squares) in the box unless a drag is under way.
    if (!dragging) {
      const w = a + 2 * b, h = 2 * a + b;   // x from −b to a + b, y from −a to a + b
      scale = Math.min(300 / w, 300 / h); ox = 20 + (300 - w * scale) / 2 + b * scale; oy = 20 + (300 - h * scale) / 2 + (a + b) * scale;
    }
    fig.replaceChildren();
    const C0: Pt = [0, 0], Bp: Pt = [a, 0], Ap: Pt = [0, b];
    S('polygon', { points: pts([C0, Bp, [a, -a], [0, -a]]), class: 'sm-soft' }, fig);
    S('polygon', { points: pts([C0, [-b, 0], [-b, b], Ap]), class: 'sm-soft2' }, fig);
    S('polygon', { points: pts([Bp, [a + b, a], [b, a + b], Ap]), class: 'sm-soft3' }, fig);
    S('polygon', { points: pts([C0, Bp, Ap]), class: 'sm-line', style: 'fill:var(--surface)' }, fig);
    const r = Math.min(a, b, 1.2) * 0.35;
    S('polyline', { points: pts([[r, 0], [r, r], [0, r]]), class: 'sm-line', style: 'stroke-width:1.2' }, fig);
    const lab = (x: number, y: number, t: string) => S('text', { x: ox + x * scale, y: oy - y * scale + 5, 'text-anchor': 'middle', style: 'font-weight:600' }, fig, t);
    lab(a / 2, -a / 2, `a² = ${fmt(a * a)}`);
    lab(-b / 2, b / 2, `b² = ${fmt(b * b)}`);
    lab((a + b) / 2, (a + b) / 2, `c² = ${fmt(c * c)}`);
    S('text', { x: ox + (a / 2) * scale, y: oy + 16, 'text-anchor': 'middle', class: 'sm-tick' }, fig, `a = ${fmt(a)}`);
    S('text', { x: ox - 6, y: oy - (b / 2) * scale, 'text-anchor': 'end', class: 'sm-tick' }, fig, `b = ${fmt(b)}`);
    for (const [id, p] of [['a', Bp], ['b', Ap]] as const) {
      S('circle', { cx: ox + p[0] * scale, cy: oy - p[1] * scale, r: 22, class: 'sm-hit' }, fig);
      S('circle', { cx: ox + p[0] * scale, cy: oy - p[1] * scale, r: 9, class: `sm-handle py-h${id}` }, fig);
    }
    q('.py-sum').textContent = `a² + b² = ${fmt(a * a)} + ${fmt(b * b)} = ${fmt(a * a + b * b)} = c²`;
    const whole = Math.abs(c - Math.round(c)) < 1e-9;
    q('.py-c').textContent = `c = √${fmt(a * a + b * b)} = ${fmt(c, 3)}${whole && Number.isInteger(a) && Number.isInteger(b) ? ' (a whole number: a Pythagorean triple!)' : ''}`;
  }

  function proofDraw() {
    const { a, b, c } = sides();
    pf.replaceChildren();
    q('.py-trow').hidden = proof !== 'rearrange';
    const steps: string[] = [];
    const fit = (minX: number, minY: number, maxX: number, maxY: number) => {
      scale = Math.min(300 / (maxX - minX), 260 / (maxY - minY));
      ox = 20 + (300 - (maxX - minX) * scale) / 2 - minX * scale; oy = 20 + (260 - (maxY - minY) * scale) / 2 + maxY * scale;
    };
    const keep = { scale, ox, oy };
    if (proof === 'rearrange') {
      const s = a + b, t = Number(q<HTMLInputElement>('.py-t').value);
      fit(0, 0, s, s);
      S('polygon', { points: pts([[0, 0], [s, 0], [s, s], [0, s]]), class: t > 0.999 ? 'sm-soft' : t < 0.001 ? 'sm-soft3' : 'sm-dash', style: t > 0.001 && t < 0.999 ? 'fill:var(--bg)' : '' }, pf);
      if (t > 0.999) { S('polygon', { points: pts([[0, a], [0, s], [a, s], [a, a]]), style: 'fill:var(--surface)' }, pf); S('polygon', { points: pts([[a, 0], [s, 0], [s, a], [a, a]]), style: 'fill:var(--surface)' }, pf); S('polygon', { points: pts([[a, a], [s, a], [s, s], [a, s]]), class: 'sm-soft2' }, pf); }
      rearrangement(a, b, t).forEach((tri) => S('polygon', { points: pts(tri), class: 'sm-line py-tri', style: 'fill:var(--line)' }, pf));
      if (t < 0.001) S('text', { x: ox + (s / 2) * scale, y: oy - (s / 2) * scale + 5, 'text-anchor': 'middle', style: 'font-weight:600' }, pf, `c² = ${fmt(c * c)}`);
      if (t > 0.999) { S('text', { x: ox + (a / 2) * scale, y: oy - (a / 2) * scale + 5, 'text-anchor': 'middle', style: 'font-weight:600' }, pf, `a²`); S('text', { x: ox + (a + b / 2) * scale, y: oy - (a + b / 2) * scale + 5, 'text-anchor': 'middle', style: 'font-weight:600' }, pf, `b²`); }
      q('.py-tv').textContent = t < 0.001 ? 'start' : t > 0.999 ? 'end' : 'moving';
      steps.push(`Both pictures are the same big square, side a + b = ${fmt(s)}, area ${fmt(s * s)}, holding the same four triangles of area ab/2 = ${fmt((a * b) / 2)} each.`);
      steps.push(`At the start the space left over is one tilted square of side c: area ${fmt(s * s)} − 4 × ${fmt((a * b) / 2)} = ${fmt(c * c)}.`);
      steps.push(`Slide t to the end: the same triangles now leave two squares, a² = ${fmt(a * a)} and b² = ${fmt(b * b)}.`);
      steps.push(`The space left over did not change, so c² = a² + b² (${fmt(c * c)} = ${fmt(a * a)} + ${fmt(b * b)}).`);
    } else if (proof === 'bhaskara') {
      const Bh = bhaskara(a, b), lo = Math.min(a, b), hi = Math.max(a, b);
      fit(-lo, 0, hi, hi + lo);
      S('polygon', { points: pts(Bh.big), class: 'sm-soft3' }, pf);
      Bh.tris.forEach((tri) => S('polygon', { points: pts(tri), class: 'sm-line py-tri', style: 'fill:var(--line)' }, pf));
      if (hi - lo > 1e-9) S('polygon', { points: pts(Bh.inner), class: 'sm-soft2' }, pf);
      steps.push(`The square on the hypotenuse has area c² = ${fmt(c * c)}. Inside it fit four copies of the triangle and a small square.`);
      steps.push(`The small square has side b − a = ${fmt(hi - lo)}, so its area is ${fmt((hi - lo) ** 2)}.`);
      steps.push(`c² = 4 × ab/2 + (b − a)² = 2ab + b² − 2ab + a² = a² + b².`);
      steps.push(`With your numbers: 4 × ${fmt((a * b) / 2)} + ${fmt((hi - lo) ** 2)} = ${fmt(2 * a * b + (hi - lo) ** 2)} = ${fmt(a * a)} + ${fmt(b * b)}.`);
      steps.push('Bhaskara II (12th century) drew this figure with the single word "Behold!"');
    } else if (proof === 'similar') {
      const S2 = altitudeSplit(a, b);
      // Hypotenuse along the bottom: from (0,0) to (c,0); right-angle vertex above at (p, h).
      fit(0, -0.15 * c, c, S2.h * 1.15);
      const Pp: Pt = [S2.p, S2.h];
      S('polygon', { points: pts([[0, 0], [S2.p, 0], Pp]), class: 'sm-soft' }, pf);
      S('polygon', { points: pts([[S2.p, 0], [c, 0], Pp]), class: 'sm-soft2' }, pf);
      S('line', { x1: ox + S2.p * scale, y1: oy, x2: ox + S2.p * scale, y2: oy - S2.h * scale, class: 'sm-dash' }, pf);
      const t = (x: number, y: number, s: string, anchor = 'middle') => S('text', { x: ox + x * scale, y: oy - y * scale, 'text-anchor': anchor }, pf, s);
      t(S2.p / 2, -0.1 * c, `p = ${fmt(S2.p, 2)}`); t(S2.p + S2.q / 2, -0.1 * c, `q = ${fmt(S2.q, 2)}`);
      t(S2.p / 2 - 0.03 * c, S2.h / 2 + 0.05 * c, `a`, 'end'); t(S2.p + S2.q / 2 + 0.03 * c, S2.h / 2 + 0.05 * c, `b`, 'start');
      steps.push(`Drop the height from the right angle to the hypotenuse. It cuts c = ${fmt(c, 3)} into p = ${fmt(S2.p, 3)} and q = ${fmt(S2.q, 3)}.`);
      steps.push('Each small triangle shares an angle with the big one and has a right angle, so all three are similar (AA).');
      steps.push(`Similar triangles give a/c = p/a, so a² = c × p = ${fmt(c, 3)} × ${fmt(S2.p, 3)} = ${fmt(a * a, 3)}.`);
      steps.push(`In the same way b² = c × q = ${fmt(c, 3)} × ${fmt(S2.q, 3)} = ${fmt(b * b, 3)}.`);
      steps.push(`Add them: a² + b² = c(p + q) = c × c = c².`);
    } else {
      const s = Math.min(a, b);
      fit(-s, -0.1 * s, s, 2.05 * s);
      // The square on the diagonal from (0, 0) to (s, s), split into four half-squares by its own diagonals.
      S('polygon', { points: pts([[0, 0], [s, s], [0, 2 * s], [-s, s]]), class: 'sm-soft3 py-dsq' }, pf);
      S('polygon', { points: pts([[0, 0], [s, 0], [s, s], [0, s]]), class: 'sm-soft' }, pf);
      S('line', { x1: ox, y1: oy, x2: ox + s * scale, y2: oy - s * scale, class: 'sm-line' }, pf);
      S('line', { x1: ox, y1: oy - s * scale, x2: ox, y2: oy - 2 * s * scale, class: 'sm-dash' }, pf);
      S('line', { x1: ox - s * scale, y1: oy - s * scale, x2: ox, y2: oy - s * scale, class: 'sm-dash' }, pf);
      S('text', { x: ox + (s / 2) * scale, y: oy - (s / 4) * scale, 'text-anchor': 'middle' }, pf, `s = ${fmt(s)}`);
      steps.push(`Take a square of side s = ${fmt(s)} (the shorter leg). Its area is ${fmt(s * s)}.`);
      steps.push(`Its diagonal is the hypotenuse of a right triangle with both legs s, so the diagonal is s√2 = ${fmt(s * Math.SQRT2, 3)}.`);
      steps.push(`The square on the diagonal (the big tilted square) is made of 4 half-squares; the small square is 2 of them. So it has twice the area: ${fmt(2 * s * s)}.`);
      steps.push('The Baudhayana Sulba Sutra (around 800 BCE) used this to double the size of a square altar, and states the general rule for any rectangle: the diagonal makes as much area as the two sides together.');
    }
    q('.py-steps').replaceChildren(...steps.map((s) => Object.assign(document.createElement('li'), { textContent: s })));
    ({ scale, ox, oy } = keep);
  }

  function draw() {
    const err = q('.py-err');
    const bad = [A, B].some((x) => x.value.trim() !== '' && !(Number(x.value) > 0));
    err.hidden = !bad; if (bad) err.textContent = 'Side lengths must be more than 0.';
    main(); proofDraw();
  }

  function table() {
    const max = Math.min(500, Math.max(5, Math.round(val(q('.py-max'), 50))));
    const only = q<HTMLInputElement>('.py-prim').checked;
    const T = triples(max).filter((t) => !only || t.primitive);
    q('.py-tcount').textContent = `${T.length} ${only ? 'primitive ' : ''}triples with c up to ${max}.`;
    const tab = q<HTMLTableElement>('.py-tab'); tab.replaceChildren();
    const h = tab.insertRow(); for (const x of ['a', 'b', 'c', 'Check', 'From']) { const th = document.createElement('th'); th.textContent = x; h.append(th); }
    T.forEach((t) => {
      const tr = tab.insertRow(); tr.dataset.i = `${t.a},${t.b}`; tr.tabIndex = 0;
      for (const v of [t.a, t.b, t.c, `${t.a * t.a} + ${t.b * t.b} = ${t.c * t.c}`, t.primitive ? `m = ${t.m}, n = ${t.n}` : `${t.k} × (${t.a / t.k}, ${t.b / t.k}, ${t.c / t.k})`]) tr.insertCell().textContent = String(v);
    });
    const m = Math.min(100, Math.max(2, Math.round(val(q('.py-m'), 4))));
    const [x, y, z] = tripleFrom(m);
    q('.py-mrule').textContent = `2m = ${x}, m² − 1 = ${y}, m² + 1 = ${z}:  ${x}² + ${y}² = ${x * x + y * y} = ${z}²`;
  }
  q('.py-tab').addEventListener('click', (e) => {
    const tr = (e.target as HTMLElement).closest('tr[data-i]') as HTMLElement | null; if (!tr) return;
    const [a, b] = tr.dataset.i!.split(',').map(Number); setA(a); setB(b); draw();
    root.querySelectorAll('.py-tab tr.on').forEach((r) => r.classList.remove('on')); tr.classList.add('on');
  });
  q('.py-tab').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') (e.target as HTMLElement).click(); });
  for (const c of ['.py-max', '.py-m', '.py-prim']) q(c).addEventListener('input', table);
  q('.py-t').addEventListener('input', proofDraw);
  root.querySelectorAll<HTMLButtonElement>('.py-proof button').forEach((btn) => btn.addEventListener('click', () => {
    proof = btn.dataset.p!; root.querySelectorAll('.py-proof button').forEach((x) => x.setAttribute('aria-pressed', String(x === btn))); proofDraw();
  }));

  dragOn(fig, (x, y) => {
    const { a, b } = sides();
    if (Math.hypot(x - (ox + a * scale), y - oy) < 30) return 'a';
    if (Math.hypot(x - ox, y - (oy - b * scale)) < 30) return 'b';
    return null;
  }, (id, x, y) => {
    dragging = true;
    const v = Math.round(Math.min(12, Math.max(0.5, id === 'a' ? (x - ox) / scale : (oy - y) / scale)) * 2) / 2;
    (id === 'a' ? setA : setB)(v); draw();
  }, () => { dragging = false; draw(); });

  draw(); table();

  quiz(q('.py-quiz'), () => {
    const out: Question[] = [];
    const base = [[3, 4, 5], [5, 12, 13], [8, 15, 17], [7, 24, 25]][randInt(0, 3)], k = randInt(1, 3);
    const [a1, b1, c1] = base.map((x) => x * k);
    out.push({ q: `A right triangle has legs ${a1} cm and ${b1} cm. How long is the hypotenuse?`, want: [c1], hint: 'cm',
      work: `c² = ${a1}² + ${b1}² = ${a1 * a1} + ${b1 * b1} = ${c1 * c1}, so c = √${c1 * c1} = ${c1} cm.` });
    const [a2, b2, c2] = [[6, 8, 10], [9, 12, 15], [5, 12, 13], [20, 21, 29]][randInt(0, 3)];
    out.push({ q: `A ladder ${c2} m long leans on a wall with its foot ${a2} m from the wall. How high up the wall does it reach?`, want: [b2], hint: 'm',
      work: `The ladder is the hypotenuse: h² = ${c2}² − ${a2}² = ${c2 * c2} − ${a2 * a2} = ${b2 * b2}, so h = ${b2} m.` });
    const w = randInt(2, 9), h = randInt(2, 9), d = Math.hypot(w, h);
    out.push({ q: `A rectangle is ${w} cm by ${h} cm. How long is its diagonal (to 2 decimal places)?`, want: [Math.round(d * 100) / 100], tol: 0.002, hint: 'cm',
      work: `d² = ${w}² + ${h}² = ${w * w + h * h}, so d = √${w * w + h * h} ≈ ${fmt(d, 2)} cm.` });
    const m = randInt(3, 9), [x, y, z] = tripleFrom(m);
    out.push({ q: `Using 2m, m² − 1, m² + 1 with m = ${m}, what is the hypotenuse of the triple?`, want: [z],
      work: `2m = ${x}, m² − 1 = ${y}, m² + 1 = ${z}. Check: ${x}² + ${y}² = ${x * x} + ${y * y} = ${z * z} = ${z}².` });
    return out;
  });
</script>
