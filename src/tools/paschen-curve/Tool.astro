---
// Paschen curve: DC breakdown voltage of a uniform gas gap. A and B are rounded textbook constants, editable.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax pcc">
  <div class="ax-card">
    <h2>Gas and gap</h2>
    <div class="ax-grid">
      <label>Gas <select class="pc-gas"></select></label>
      <label>A (1 / Torr·cm) <input class="pc-A" type="text" inputmode="decimal" /></label>
      <label>B (V / Torr·cm) <input class="pc-B" type="text" inputmode="decimal" /></label>
      <label>Secondary emission γ <input class="pc-g" type="text" inputmode="decimal" value="0.01" /></label>
      <label>Pressure <input class="pc-p" type="text" inputmode="decimal" value="1" /></label>
      <label>Pressure unit <select class="pc-pu"><option value="atm" selected>atm</option><option value="torr">Torr (mmHg)</option><option value="pa">Pa</option><option value="kpa">kPa</option><option value="mbar">mbar</option><option value="psi">psi</option></select></label>
      <label>Gap d <input class="pc-d" type="text" inputmode="decimal" value="1" /></label>
      <label>Gap unit <select class="pc-du"><option value="um">µm</option><option value="mm" selected>mm</option><option value="cm">cm</option><option value="m">m</option><option value="in">inch</option></select></label>
      <label>Voltage to check (V, optional) <input class="pc-v" type="text" inputmode="decimal" value="1000" /></label>
    </div>
    <label class="ax-check" style="margin-top:10px"><input type="checkbox" class="pc-all" /> Show every gas on the chart</label>
    <p class="ax-help">A and B are rounded textbook values for each gas, from fits that hold only over a limited range of E/p; type your own to override them. γ is the number of electrons knocked out of the cathode per ion (about 0.01 to 0.1, depending on the metal and gas). Room temperature is assumed: at other temperatures use the gas density, p × 293 K / T.</p>
    <p class="ax-err pc-err" hidden></p>
  </div>

  <div class="ax-card pc-out">
    <h2>Breakdown</h2>
    <p class="ax-big pc-big"></p>
    <dl class="ax-facts pc-facts"></dl>
    <canvas class="ax-fig pc-fig"></canvas>
    <p class="ax-help">Paschen's law for a uniform field between flat electrodes. It fails for very small gaps (below about 10 µm in air at atmospheric pressure, where field emission takes over), far from the E/p range of the A and B fit, for pointed electrodes, AC or RF, and very short pulses. For study and planning, not a substitute for professional judgement or insulation standards.</p>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small pc-csv">Download the curve (CSV)</button></div>
    <Downloads />
  </div>
</div>

<script>
  import { GASES, PRESSURE, GAP, paschenV, paschenMin, pdForVoltage, pdAsymptote } from '../../lib/sci/phpaschen';
  import { chartFigure, type Series } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, sig, csv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.pcc')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const val = (c: string) => { const t = q<HTMLInputElement>(c).value.trim(); return t ? num(t) : NaN; };
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const gas = q<HTMLSelectElement>('.pc-gas');
  for (const g of GASES) gas.append(new Option(`${g.name} (rounded A, B)`, g.id));
  gas.append(new Option('My own A and B', 'own'));
  const setAB = () => { const g = GASES.find((x) => x.id === gas.value); if (g) { q<HTMLInputElement>('.pc-A').value = String(g.A); q<HTMLInputElement>('.pc-B').value = String(g.B); } };
  setAB();
  let fig: Figure | null = null, report: Section[] = [], curve: { pd: number; V: number }[] = [];
  const volts = (v: number) => (v >= 1e4 ? `${sig(v / 1e3, 3)} kV` : `${sig(v, 3)} V`);
  const gapTxt = (cm: number) => (cm >= 100 ? `${sig(cm / 100, 3)} m` : cm >= 1 ? `${sig(cm, 3)} cm` : cm >= 0.1 ? `${sig(cm * 10, 3)} mm` : `${sig(cm * 1e4, 3)} µm`);

  function calc() {
    const err = q('.pc-err'), out = q('.pc-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; };
    const A = val('.pc-A'), B = val('.pc-B'), g = val('.pc-g');
    const pT = val('.pc-p') * PRESSURE[q<HTMLSelectElement>('.pc-pu').value], dcm = val('.pc-d') * GAP[q<HTMLSelectElement>('.pc-du').value];
    const Vc = val('.pc-v'), vTxt = q<HTMLInputElement>('.pc-v').value.trim();
    if (!(A > 0) || !(B > 0)) return fail('A and B must both be greater than 0.');
    if (!(g > 0 && g < 1)) return fail('γ must be between 0 and 1 (typically 0.01 to 0.1).');
    if (!(pT > 0)) return fail('Give a pressure greater than 0.');
    if (!(dcm > 0)) return fail('Give a gap greater than 0.');
    if (vTxt && !(Vc > 0)) return fail('The voltage to check must be greater than 0, or left blank.');
    err.hidden = true; out.hidden = false;
    const pd = pT * dcm, V = paschenV(pd, A, B, g), m = paschenMin(A, B, g), asym = pdAsymptote(A, g);
    const side = pd < m.pd ? 'left of the minimum: a wider gap or higher pressure would break down more easily' : 'right of the minimum: the usual side, voltage rises with pressure and gap';
    q('.pc-big').textContent = Number.isFinite(V) ? `Breakdown at about ${volts(V)} (${sig(V / dcm / 1e3, 3)} kV/cm)` : 'No breakdown by Townsend avalanche: the gap is left of the curve\'s asymptote';
    const f = [
      fact('p × d', `${sig(pd, 4)} Torr·cm`, `${sig(pT, 4)} Torr × ${gapTxt(dcm)}; ${sig(pd * 1.33322, 4)} mbar·cm, ${sig(pd * 133.322 / 100, 4)} Pa·m`),
      fact('Breakdown voltage', Number.isFinite(V) ? volts(V) : 'none', Number.isFinite(V) ? side : `p·d is at or below ${sig(asym, 3)} Torr·cm, where ln(A p d) ≤ ln(ln(1 + 1/γ))`),
      ...(Number.isFinite(V) ? [fact('Breakdown field', `${sig(V / dcm / 1e3, 3)} kV/cm`, `E/p = ${sig(V / pd, 3)} V/(Torr·cm); A and B fits hold only over a limited E/p range`)] : []),
      fact('Paschen minimum', `${volts(m.V)} at ${sig(m.pd, 3)} Torr·cm`, `at this pressure that is a gap of ${gapTxt(m.pd / pT)}; no lower DC voltage can break down this gas`),
    ];
    if (Number.isFinite(Vc)) {
      const r = pdForVoltage(Vc, A, B, g);
      if (!r.length) f.push(fact(`At ${volts(Vc)}`, 'cannot break down at any gap', `below the Paschen minimum of ${volts(m.V)}`));
      else f.push(fact(`At ${volts(Vc)}`, `breaks down for gaps from ${gapTxt(r[0] / pT)} to ${gapTxt(r[1] / pT)}`, `at this pressure; p·d from ${sig(r[0], 3)} to ${sig(r[1], 3)} Torr·cm. ${Number.isFinite(V) && Vc >= V ? 'Your gap breaks down at this voltage.' : 'Your gap holds this voltage.'}`));
    }
    if (pT > 300 && dcm < 1e-3) f.push(fact('Small gap warning', 'field emission likely', 'gaps below about 10 µm near atmospheric pressure break down below the Paschen value'));
    q('.pc-facts').replaceChildren(...f);
    // Curve from just right of the asymptote to well past the point.
    const lo = asym * 1.02, hi = Math.max(pd, m.pd) * 30, xs: number[] = [];
    for (let i = 0; i <= 240; i++) xs.push(lo * Math.pow(hi / lo, i / 240));
    curve = xs.map((x) => ({ pd: x, V: paschenV(x, A, B, g) })).filter((c) => Number.isFinite(c.V));
    const yMax = Math.max(m.V * 30, Number.isFinite(V) ? V * 3 : 0);
    const series: Series[] = [];
    if (q<HTMLInputElement>('.pc-all').checked) for (const gs of GASES) { if (gs.id === gas.value) continue; const ax = pdAsymptote(gs.A, g) * 1.02; const xx = xs.map((x) => x * ax / lo); series.push({ name: gs.name, x: xx, y: xx.map((x) => paschenV(x, gs.A, gs.B, g)), mode: 'line', width: 1 }); }
    series.unshift({ name: gas.value === 'own' ? 'Your gas' : gas.selectedOptions[0].text.replace(' (rounded A, B)', ''), x: curve.map((c) => c.pd), y: curve.map((c) => c.V), mode: 'line', width: 2.5 });
    if (Number.isFinite(V)) series.push({ name: 'Your gap', x: [pd], y: [V], mode: 'points', marker: 'diamond', size: 6 });
    fig = chartFigure({ w: 380, h: 280, xLabel: 'p × d (Torr·cm)', yLabel: 'Breakdown voltage (V)', xLog: true, yLog: true, yMin: m.V / 2, yMax, xMin: lo / 1.5, xMax: hi, legend: 'below', series, marks: Number.isFinite(Vc) ? [{ kind: 'hline', at: Vc, dash: [4, 3], label: volts(Vc) }] : [] }, 'Paschen curve: breakdown voltage against pressure times gap');
    paint(q<HTMLCanvasElement>('.pc-fig'), fig);
    report = [{ title: q('.pc-big').textContent!, text: [`${gas.selectedOptions[0].text}: A = ${A} /(Torr·cm), B = ${B} V/(Torr·cm), γ = ${g}.`], facts: f.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]), figure: fig }];
  }

  gas.addEventListener('change', () => { setAB(); calc(); });
  for (const c of ['.pc-A', '.pc-B']) q(c).addEventListener('input', () => { const g = GASES.find((x) => x.id === gas.value); if (g && (val('.pc-A') !== g.A || val('.pc-B') !== g.B)) gas.value = 'own'; });
  root.querySelectorAll('input, select:not(.pc-gas)').forEach((i) => { i.addEventListener('input', calc); i.addEventListener('change', calc); });
  document.addEventListener('fibub:theme', () => { if (fig && !q('.pc-out').hidden) paint(q<HTMLCanvasElement>('.pc-fig'), fig); });
  q('.pc-csv').addEventListener('click', () => { if (curve.length) save(new Blob([csv([['pd_Torr_cm', 'breakdown_V'], ...curve.map((c) => [+c.pd.toPrecision(6), +c.V.toPrecision(6)])])], { type: 'text/csv' }), 'paschen-curve.csv', 'text/csv'); });
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'Paschen curve', subtitle: q('.pc-big').textContent ?? '', file: 'paschen-curve', sections: report }));
</script>

<style is:global>
  .pcc canvas.ax-fig { margin-top: 12px; }
</style>
