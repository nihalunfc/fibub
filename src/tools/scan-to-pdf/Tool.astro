---
// #1708 Scan to PDF
---
<div class="tool-ui stp">
  <div class="stp-row">
    <label class="btn stp-pick">Take a photo <input class="stp-cam" type="file" accept="image/*" capture="environment" /></label>
    <label class="btn secondary stp-pick">Add images <input class="stp-file" type="file" accept="image/*" multiple /></label>
  </div>
  <p class="stp-msg" role="status" aria-live="polite">Take a photo of a page, or add pictures from your device. Nothing is uploaded.</p>
  <div class="stp-work" hidden>
    <p class="stp-hint">Drag the four round corners onto the corners of the page, then check the flattened page on the right.</p>
    <div class="stp-views">
      <div class="stp-edit"><canvas class="stp-src" aria-label="Photo with page corners"></canvas></div>
      <div class="stp-edit"><canvas class="stp-prev" aria-label="Flattened page"></canvas></div>
    </div>
    <div class="stp-row">
      <button class="btn secondary small stp-auto" type="button">Find page edges</button>
      <button class="btn secondary small stp-reset" type="button">Use whole photo</button>
      <button class="btn secondary small stp-rot" type="button">Turn page</button>
    </div>
    <div class="stp-row">
      <label>Look <select class="stp-filter"><option value="original">Original</option><option value="grey">Grey</option><option value="bw">Black and white</option><option value="whiten" selected>Whiten background</option></select></label>
      <label>Page size <select class="stp-size"><option value="a4">A4</option><option value="letter">Letter</option><option value="fit">Fit the page</option></select></label>
    </div>
    <div class="stp-pages"></div>
    <button class="btn stp-make" type="button">Download PDF</button>
  </div>
</div>

<style is:inline>
  .stp { display: grid; gap: .75rem; }
  .stp-row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .stp-pick { position: relative; overflow: hidden; cursor: pointer; }
  .stp-pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; }
  .stp-msg, .stp-hint { margin: 0; } .stp-msg.err { color: var(--warn); }
  .stp-work[hidden] { display: none; } .stp-work { display: grid; gap: .75rem; }
  .stp-views { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .75rem; }
  .stp-edit { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 6px; display: grid; place-items: center; }
  .stp-edit canvas { max-width: 100%; max-height: 60vh; touch-action: none; }
  .stp-pages { display: flex; flex-wrap: wrap; gap: .5rem; }
  .stp-card { border: 2px solid var(--line); border-radius: 10px; padding: 4px; display: grid; gap: 4px; width: 104px; background: var(--surface); }
  .stp-card.cur { border-color: var(--accent); }
  .stp-card canvas { width: 100%; height: 90px; object-fit: contain; background: #fff; cursor: pointer; }
  .stp-card .act { display: flex; gap: 2px; }
  .stp-card .act button { flex: 1; min-height: 36px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 6px; cursor: pointer; font: inherit; }
</style>

<script>
  import { detectCorners, warp, applyFilter, type Quad, type Filter } from '../../lib/docs/scan';
  import { download } from '../../lib/docs/pdfpages';
  const root = document.querySelector('.stp') as HTMLElement;
  const $ = <T extends Element>(s: string) => root.querySelector(s) as T;
  const msg = $<HTMLElement>('.stp-msg'), srcC = $<HTMLCanvasElement>('.stp-src'), prevC = $<HTMLCanvasElement>('.stp-prev');
  const filterSel = $<HTMLSelectElement>('.stp-filter'), sizeSel = $<HTMLSelectElement>('.stp-size'), strip = $<HTMLElement>('.stp-pages');
  interface Pg { img: ImageData; q: Quad; rot: number; thumb?: HTMLCanvasElement }
  const pages: Pg[] = []; let cur = 0, drag = -1;
  const say = (t: string, err = false) => { msg.textContent = t; msg.classList.toggle('err', err); };
  const whole = (): Quad => [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }];

  function toCanvas(d: ImageData, rot = 0) {
    const c = document.createElement('canvas'), t = document.createElement('canvas'); t.width = d.width; t.height = d.height; t.getContext('2d')!.putImageData(d, 0, 0);
    const sw = rot % 180 !== 0; c.width = sw ? d.height : d.width; c.height = sw ? d.width : d.height;
    const x = c.getContext('2d')!; x.translate(c.width / 2, c.height / 2); x.rotate(rot * Math.PI / 180); x.drawImage(t, -d.width / 2, -d.height / 2); return c;
  }
  const px = (p: Pg): Quad => p.q.map((a) => ({ x: a.x * p.img.width, y: a.y * p.img.height })) as Quad;
  const flat = (p: Pg) => toCanvas(applyFilter(warp(p.img, px(p)), filterSel.value as Filter), p.rot);

  function drawSrc() {
    const p = pages[cur]; if (!p) return;
    const k = Math.min(1, 640 / Math.max(p.img.width, p.img.height)); srcC.width = Math.round(p.img.width * k); srcC.height = Math.round(p.img.height * k);
    const x = srcC.getContext('2d')!, t = toCanvas(p.img); x.drawImage(t, 0, 0, srcC.width, srcC.height);
    x.lineWidth = 3; x.strokeStyle = '#0a7cff'; x.fillStyle = '#0a7cff'; x.beginPath();
    p.q.forEach((a, i) => (i ? x.lineTo : x.moveTo).call(x, a.x * srcC.width, a.y * srcC.height)); x.closePath(); x.stroke();
    p.q.forEach((a) => { x.beginPath(); x.arc(a.x * srcC.width, a.y * srcC.height, 11, 0, 7); x.globalAlpha = .6; x.fill(); x.globalAlpha = 1; x.stroke(); });
    srcC.dataset.corners = JSON.stringify(p.q.map((a) => [+a.x.toFixed(3), +a.y.toFixed(3)]));
  }
  function drawPrev() {
    const p = pages[cur]; if (!p) return; const c = flat(p), k = Math.min(1, 640 / Math.max(c.width, c.height));
    prevC.width = Math.round(c.width * k); prevC.height = Math.round(c.height * k); prevC.getContext('2d')!.drawImage(c, 0, 0, prevC.width, prevC.height);
    p.thumb = c; drawStrip();
  }
  function drawStrip() {
    strip.textContent = '';
    pages.forEach((p, i) => {
      const card = document.createElement('div'); card.className = 'stp-card' + (i === cur ? ' cur' : '');
      card.innerHTML = '<canvas></canvas><div class="act"><button type="button" data-a="l" aria-label="Move earlier">&larr;</button><button type="button" data-a="r" aria-label="Move later">&rarr;</button><button type="button" data-a="d" aria-label="Delete page">&times;</button></div>';
      const cv = card.querySelector('canvas')!; if (p.thumb) { cv.width = 120; cv.height = 120 * p.thumb.height / p.thumb.width; if (cv.height > 160) { cv.height = 160; cv.width = 160 * p.thumb.width / p.thumb.height; } cv.getContext('2d')!.drawImage(p.thumb, 0, 0, cv.width, cv.height); }
      cv.onclick = () => { cur = i; refresh(); };
      card.querySelector('.act')!.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('button')?.dataset.a; if (!a) return;
        if (a === 'l' && i > 0) { [pages[i - 1], pages[i]] = [pages[i], pages[i - 1]]; cur = i - 1; }
        else if (a === 'r' && i < pages.length - 1) { [pages[i + 1], pages[i]] = [pages[i], pages[i + 1]]; cur = i + 1; }
        else if (a === 'd') { pages.splice(i, 1); cur = Math.max(0, Math.min(cur, pages.length - 1)); }
        refresh();
      });
      strip.appendChild(card);
    });
  }
  function refresh() {
    ($('.stp-work') as HTMLElement).hidden = !pages.length; root.dataset.pages = String(pages.length);
    if (pages.length) { drawSrc(); drawPrev(); say(`${pages.length} page${pages.length === 1 ? '' : 's'}. Page ${cur + 1} is showing.`); } else say('Take a photo of a page, or add pictures from your device. Nothing is uploaded.');
  }

  async function add(files: File[]) {
    for (const f of files) {
      try {
        const bmp = await createImageBitmap(f), k = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
        const x = c.getContext('2d', { willReadFrequently: true })!; x.drawImage(bmp, 0, 0, c.width, c.height);
        const img = x.getImageData(0, 0, c.width, c.height), sm = document.createElement('canvas'), s = 200 / Math.max(c.width, c.height);
        sm.width = Math.round(c.width * s); sm.height = Math.round(c.height * s); const sx = sm.getContext('2d', { willReadFrequently: true })!; sx.drawImage(c, 0, 0, sm.width, sm.height);
        pages.push({ img, q: detectCorners(sx.getImageData(0, 0, sm.width, sm.height)), rot: 0 }); cur = pages.length - 1;
      } catch { say(`${f.name} could not be read as a picture.`, true); }
    }
    refresh();
  }
  for (const sel of ['.stp-file', '.stp-cam']) $<HTMLInputElement>(sel).addEventListener('change', (e) => { const i = e.target as HTMLInputElement, fs = [...(i.files || [])]; i.value = ''; add(fs); });

  const at = (e: PointerEvent) => { const r = srcC.getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height }; };
  srcC.addEventListener('pointerdown', (e) => {
    const p = pages[cur]; if (!p) return; const m = at(e), r = srcC.getBoundingClientRect(); let best = 1e9;
    p.q.forEach((a, i) => { const d = Math.hypot((a.x - m.x) * r.width, (a.y - m.y) * r.height); if (d < best) { best = d; drag = i; } });
    if (best > 40) drag = -1; else srcC.setPointerCapture(e.pointerId);
  });
  srcC.addEventListener('pointermove', (e) => { if (drag < 0) return; const m = at(e); pages[cur].q[drag] = { x: Math.max(0, Math.min(1, m.x)), y: Math.max(0, Math.min(1, m.y)) }; drawSrc(); });
  const end = () => { if (drag >= 0) { drag = -1; drawPrev(); } };
  srcC.addEventListener('pointerup', end); srcC.addEventListener('pointercancel', end);

  $('.stp-auto').addEventListener('click', () => {
    const p = pages[cur]; if (!p) return; const sm = document.createElement('canvas'), s = 200 / Math.max(p.img.width, p.img.height);
    sm.width = Math.round(p.img.width * s); sm.height = Math.round(p.img.height * s);
    const x = sm.getContext('2d', { willReadFrequently: true })!; x.drawImage(toCanvas(p.img), 0, 0, sm.width, sm.height);
    p.q = detectCorners(x.getImageData(0, 0, sm.width, sm.height)); drawSrc(); drawPrev();
  });
  $('.stp-reset').addEventListener('click', () => { if (pages[cur]) { pages[cur].q = whole(); drawSrc(); drawPrev(); } });
  $('.stp-rot').addEventListener('click', () => { if (pages[cur]) { pages[cur].rot = (pages[cur].rot + 90) % 360; drawPrev(); } });
  filterSel.addEventListener('change', () => { pages.forEach((p) => (p.thumb = undefined)); drawPrev(); });

  $('.stp-make').addEventListener('click', async () => {
    try {
      say('Making your PDF...'); const { PDFDocument } = await import('pdf-lib'), doc = await PDFDocument.create();
      for (const p of pages) {
        const c = flat(p), blob: Blob = await new Promise((r) => c.toBlob((b) => r(b!), 'image/jpeg', 0.85));
        const im = await doc.embedJpg(new Uint8Array(await blob.arrayBuffer())), sz = sizeSel.value;
        if (sz === 'fit') { const w = im.width * 72 / 150, h = im.height * 72 / 150; doc.addPage([w, h]).drawImage(im, { x: 0, y: 0, width: w, height: h }); }
        else {
          const [W, H] = sz === 'a4' ? [595.28, 841.89] : [612, 792], pg = doc.addPage([W, H]), k = Math.min((W - 24) / im.width, (H - 24) / im.height);
          pg.drawImage(im, { x: (W - im.width * k) / 2, y: (H - im.height * k) / 2, width: im.width * k, height: im.height * k });
        }
      }
      download(await doc.save(), 'scan.pdf'); say(`Saved scan.pdf with ${pages.length} page${pages.length === 1 ? '' : 's'}.`);
    } catch (e: any) { say(e.message || 'Something went wrong.', true); }
  });
</script>
