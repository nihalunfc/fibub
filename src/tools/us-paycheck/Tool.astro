---
// #1785 US paycheck: 2026 federal tax, Social Security, Medicare, 401(k), HSA and state tax -> take-home per paycheck.
---
<div class="tool-ui upc">
  <section class="panel">
    <h2>Your pay in 2026</h2>
    <div class="upc-grid">
      <label>Pay before anything comes off <span class="upc-suf"><input class="upc-pay" inputmode="decimal" value="75,000" /><select class="upc-unit" aria-label="Pay per year or per hour"><option value="year" selected>a year</option><option value="hour">an hour</option></select></span></label>
      <label class="upc-hrs-l" hidden>Hours a week <input class="upc-hrs" inputmode="decimal" value="40" /></label>
      <label>How often you are paid <select class="upc-freq">
        <option value="weekly">Weekly (52 a year)</option>
        <option value="biweekly" selected>Every two weeks (26)</option>
        <option value="semimonthly">Twice a month (24)</option>
        <option value="monthly">Monthly (12)</option>
      </select></label>
      <label>Filing status <select class="upc-status">
        <option value="single" selected>Single</option>
        <option value="mfj">Married filing jointly</option>
        <option value="hoh">Head of household</option>
        <option value="mfs">Married filing separately</option>
      </select></label>
      <label>Children under 17 <input class="upc-kids" inputmode="numeric" value="0" /></label>
      <label>State you work in <select class="upc-state"></select></label>
      <label class="upc-rate-l" hidden><span class="upc-rate-t">State tax rate</span> <span class="upc-suf"><input class="upc-rate" inputmode="decimal" value="4" /><i>%</i></span></label>
    </div>
    <p class="upc-snote"></p>
    <h3>Before-tax deductions</h3>
    <div class="upc-grid">
      <label>401(k) <span class="upc-suf"><input class="upc-k" inputmode="decimal" value="5" /><select class="upc-kunit" aria-label="Percent of pay or dollars a year"><option value="pct" selected>% of pay</option><option value="usd">$ a year</option></select></span></label>
      <label>401(k) type <select class="upc-ktype"><option value="trad" selected>Traditional (before tax)</option><option value="roth">Roth (after tax)</option></select></label>
      <label>Your age at the end of 2026 <input class="upc-age" inputmode="numeric" value="35" /></label>
      <label>HSA through payroll, $ a year <input class="upc-hsa" inputmode="decimal" value="0" /></label>
      <label>Health, dental and vision premiums, $ a year <input class="upc-pre" inputmode="decimal" value="0" /></label>
    </div>
  </section>

  <section class="upc-res" aria-live="polite">
    <div class="upc-stats">
      <div class="good"><span>Take-home a paycheck</span><b class="upc-per"></b></div>
      <div><span>Take-home a year</span><b class="upc-year"></b></div>
      <div><span>A month</span><b class="upc-month"></b></div>
      <div><span>Federal tax bracket</span><b class="upc-brk"></b></div>
    </div>
    <p class="upc-note"></p>
    <figure class="panel upc-fig">
      <figcaption>Where each dollar goes</figcaption>
      <div class="upc-bar" role="img"></div>
      <ul class="upc-key"></ul>
    </figure>
    <div class="panel upc-tw">
      <table>
        <thead><tr><th>Item</th><th class="upc-per-h">A paycheck</th><th>A year</th></tr></thead>
        <tbody class="upc-body"></tbody>
      </table>
    </div>
  </section>
  <p class="upc-fine">Estimate for 2026 wages: the year's tax is worked out and spread evenly over your paychecks, as the W-4 aims to do; your employer's withholding tables can differ by a few dollars, and the true figure is settled on your tax return. Uses the standard deduction and the child tax credit only (no other credits, itemized deductions or the new tips, overtime and senior deductions). Federal figures: IRS Rev. Proc. 2025-32; Social Security wage base $184,500 (SSA); 401(k) and HSA limits from the IRS, all checked 10 November 2026. City and county taxes, and state disability or family leave payroll taxes, are not included. Not financial or tax advice: check the official source (irs.gov and your state's revenue department). Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .upc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-bottom: 32px; }
  .upc > *, .upc-res > * { min-width: 0; }
  .upc h2 { margin: 0 0 12px; font-size: 18px; }
  .upc h3 { margin: 16px 0 10px; font-size: 16px; }
  .upc .panel { padding: 16px; }
  .upc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .upc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); align-content: end; }
  .upc label[hidden] { display: none; }
  .upc input, .upc select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .upc input:focus, .upc select:focus { border-color: var(--accent); outline: none; }
  .upc-suf { display: grid; grid-template-columns: 1fr auto; gap: 6px; align-items: center; }
  .upc-suf select { width: auto; }
  .upc-suf i { font-style: normal; color: var(--muted); }
  .upc-snote { margin: 10px 0 0; font-size: 14px; }
  .upc-snote:empty, .upc-note:empty { display: none; }
  .upc-res { display: grid; gap: 12px; }
  .upc-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .upc-stats div { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; background: var(--surface); }
  .upc-stats span { font-size: 13px; color: var(--muted); }
  .upc-stats b { font-size: clamp(17px, 3.4vw, 22px); overflow-wrap: anywhere; }
  .upc-stats .good b { color: var(--good); }
  .upc-note { margin: 0; font-size: 14px; }
  .upc-fig { margin: 0; }
  .upc-fig figcaption { font-weight: 600; margin-bottom: 10px; }
  .upc-bar { display: flex; height: 28px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); }
  .upc-bar i { display: block; height: 100%; }
  .upc-key { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; }
  .upc-key i { display: inline-block; width: 11px; height: 11px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
  .upc-tw { overflow-x: auto; }
  .upc table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .upc th, .upc td { text-align: right; padding: 7px 8px; border-bottom: 1px solid var(--line); }
  .upc th:first-child, .upc td:first-child { text-align: left; }
  .upc th { font-size: 12px; color: var(--muted); }
  .upc tr.tot td { font-weight: 700; }
  .upc-fine { color: var(--muted); font-size: 13px; margin: 0; }
  @media (max-width: 640px) { .upc-stats { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  import { paycheck, STATES, PERIODS, LIMITS, k401Limit, type Status } from '../../lib/money/us-paycheck.ts';
  import { num } from '../../lib/money';
  const root = document.querySelector('.upc') as HTMLElement;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector(s) as T;
  const v = (s: string) => num(q<HTMLInputElement>(s).value);
  const $ = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  const pct = (n: number) => `${(Math.round(n * 1000) / 10).toFixed(1)}%`;
  const sel = q<HTMLSelectElement>('.upc-state');
  sel.innerHTML = Object.entries(STATES).sort((a, b) => a[1].name.localeCompare(b[1].name))
    .map(([k, s]) => `<option value="${k}"${k === 'IL' ? ' selected' : ''}>${s.name}</option>`).join('');
  let lastState = '';

  const update = () => {
    const hourly = q<HTMLSelectElement>('.upc-unit').value === 'hour';
    q('.upc-hrs-l').hidden = !hourly;
    const gross = hourly ? v('.upc-pay') * v('.upc-hrs') * 52 : v('.upc-pay');
    const [fname, n] = PERIODS[q<HTMLSelectElement>('.upc-freq').value];
    const code = sel.value, st = STATES[code];
    const rateBox = q<HTMLInputElement>('.upc-rate');
    if (code !== lastState) {
      if (st.kind === 'az') rateBox.value = '2';
      else if (st.kind === 'est') rateBox.value = String(st.start ?? 4);
      lastState = code;
    }
    q('.upc-rate-l').hidden = !(st.kind === 'az' || st.kind === 'est');
    q('.upc-rate-t').textContent = st.kind === 'az' ? 'Arizona withholding you chose on form A-4' : `Your ${st.name} effective tax rate`;
    q('.upc-snote').textContent = st.kind === 'none' ? `${st.name} has no state income tax on wages.`
      : st.kind === 'flat' ? `${st.name}: exact flat rate of ${(st.rate! * 100).toFixed(2)}%${st.k401Taxed ? ' (Pennsylvania taxes 401(k) contributions, so they do not lower state tax)' : ''}${st.name === 'Pennsylvania' || st.name === 'Michigan' || st.name === 'Kentucky' ? '. Local earned-income or city taxes are extra.' : '.'}`
      : st.kind === 'az' ? 'Arizona: employers withhold the percentage of wages you pick on form A-4 (0.5% to 3.5%; 2% if you never filled one in). The tax rate itself is 2.5% of Arizona taxable income; any difference is settled on your return.'
      : `${st.name} is not worked out exactly here: type your effective state rate (state tax divided by wages, from last year's return or a payslip). The starting value ${st.start === 4 ? 'is a rough middle guess' : `is ${st.name.replace(/ \(.*/, '')}'s 2026 flat rate, before its deductions, so your real rate is lower`}: estimate, check the official source.`;
    const kv = v('.upc-k');
    const k401 = q<HTMLSelectElement>('.upc-kunit').value === 'pct' ? gross * kv / 100 : kv;
    const roth = q<HTMLSelectElement>('.upc-ktype').value === 'roth';
    const kids = v('.upc-kids'), age = v('.upc-age');
    const r = paycheck({ gross, status: q<HTMLSelectElement>('.upc-status').value as Status, children: kids, k401, roth, hsa: v('.upc-hsa'), pretax: v('.upc-pre'), state: code, stateRate: v('.upc-rate') });
    q('.upc-per').textContent = $(r.takeHome / n);
    q('.upc-year').textContent = $(r.takeHome);
    q('.upc-month').textContent = $(r.takeHome / 12);
    q('.upc-brk').textContent = pct(r.marginalFed);
    q('.upc-per-h').textContent = `${fname} paycheck`;
    const notes: string[] = [];
    const lim = k401Limit(age);
    if (k401 > lim) notes.push(`Your 401(k) is over the 2026 limit of ${$(lim)} for your age (${$(LIMITS.k401)}, plus catch-up from 50; ${$(LIMITS.k401CatchUp60)} catch-up at 60 to 63).`);
    if (v('.upc-hsa') > LIMITS.hsaFamily + (age >= 55 ? LIMITS.hsaCatchUp55 : 0)) notes.push(`The 2026 HSA limit is ${$(LIMITS.hsaSelf)} for self-only cover or ${$(LIMITS.hsaFamily)} for family cover (plus $1,000 from 55), including what your employer puts in.`);
    if (r.credit > 0) notes.push(`The child tax credit takes ${$(r.credit)} off your federal tax.`);
    q('.upc-note').textContent = notes.join(' ');
    const rows: [string, number, string][] = [
      ['Federal income tax', r.fed, 'var(--accent)'], ['Social Security', r.ss, 'var(--warn)'], ['Medicare', r.medicare, 'var(--bad)'],
      ['State income tax', r.state, 'var(--muted)'], [roth ? '401(k) (Roth) and other deductions' : '401(k) and other deductions', r.deductions, 'var(--ink)'],
    ];
    const parts: [string, number, string][] = [['Take-home', r.takeHome, 'var(--good)'], ...rows];
    const total = Math.max(r.gross, 1);
    q('.upc-bar').innerHTML = parts.filter((p) => p[1] > 0).map(([l, x, c]) => `<i title="${l}" style="width:${(x / total) * 100}%;background:${c}"></i>`).join('');
    q('.upc-bar').setAttribute('aria-label', parts.map(([l, x]) => `${l} ${pct(x / total)}`).join(', '));
    q('.upc-key').innerHTML = parts.map(([l, x, c]) => `<li><i style="background:${c}"></i>${l} ${pct(x / total)}</li>`).join('');
    q('.upc-body').innerHTML = [['Gross pay', r.gross], ...rows.map(([l, x]) => [l, -x] as [string, number])]
      .map(([l, x]) => `<tr><td>${l}</td><td>${$((x as number) / n)}</td><td>${$(x as number)}</td></tr>`).join('')
      + `<tr class="tot"><td>Take-home pay</td><td>${$(r.takeHome / n)}</td><td>${$(r.takeHome)}</td></tr>`;
  };
  root.addEventListener('input', update);
  root.addEventListener('change', update);
  update();
</script>
