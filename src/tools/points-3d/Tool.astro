---
// 3D point plotter (Learn, Class 11 introduction to three-dimensional geometry): turn the axes round, place two
// points, see their octants, the coordinate box behind each point and the distance formula in 3D, plus the
// section formula. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm p3">
  <div class="ax-card">
    <h2>Turn the axes</h2>
    <svg class="sm-fig p3-fig" viewBox="0 0 340 320" role="img" aria-label="Three axes x, y and z drawn in perspective with points P and Q, their coordinate boxes and the segment PQ"></svg>
    <p class="ax-help">Drag the picture to turn it round.</p>
    <div class="ax-row">
      <div class="ax-seg p3-view" role="group" aria-label="View"><button type="button" data-v="turn">Slanted</button><button type="button" data-v="front">Front (yz)</button><button type="button" data-v="top">Top (xy)</button></div>
    </div>
    <div class="ax-row" style="margin-top:10px">
      <span>Move</span>
      <div class="ax-seg p3-who" role="group" aria-label="Which point the sliders move"><button type="button" data-p="P" aria-pressed="true">P</button><button type="button" data-p="Q" aria-pressed="false">Q</button></div>
    </div>
    <div class="sm-sl"><b>x</b><input type="range" class="p3-xr" min="-6" max="6" step="1" value="3" aria-label="x slider" /><input type="number" class="p3-x" min="-6" max="6" step="1" value="3" inputmode="numeric" aria-label="x coordinate" /></div>
    <div class="sm-sl"><b>y</b><input type="range" class="p3-yr" min="-6" max="6" step="1" value="-2" aria-label="y slider" /><input type="number" class="p3-y" min="-6" max="6" step="1" value="-2" inputmode="numeric" aria-label="y coordinate" /></div>
    <div class="sm-sl"><b>z</b><input type="range" class="p3-zr" min="-6" max="6" step="1" value="4" aria-label="z slider" /><input type="number" class="p3-z" min="-6" max="6" step="1" value="4" inputmode="numeric" aria-label="z coordinate" /></div>
    <label class="ax-check"><input type="checkbox" class="p3-box" checked /> Show the coordinate box behind each point</label>
    <label class="ax-check"><input type="checkbox" class="p3-sec" /> Add the point R dividing PQ in a ratio (section formula)</label>
    <div class="p3-secbox" hidden>
      <div class="sm-sl"><b>m</b><input type="range" class="p3-mr" min="1" max="9" step="1" value="1" aria-label="m slider" /><input type="number" class="p3-m" min="1" max="20" step="1" value="1" inputmode="numeric" aria-label="m" /></div>
      <div class="sm-sl"><b>n</b><input type="range" class="p3-nr" min="1" max="9" step="1" value="1" aria-label="n slider" /><input type="number" class="p3-n" min="1" max="20" step="1" value="1" inputmode="numeric" aria-label="n" /></div>
    </div>
  </div>

  <div class="ax-card">
    <h2>With your numbers</h2>
    <p class="sm-f p3-pts"></p>
    <p class="sm-f p3-oct"></p>
    <p class="sm-f p3-d"></p>
    <p class="sm-f p3-o"></p>
    <p class="sm-f p3-r"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Change only the sign of z for P. It jumps from an octant above the xy plane to the one straight below it (I ↔ V, II ↔ VI, …).</li>
      <li>Set P's z to 0. P now lies in the xy plane and belongs to no octant. Set y to 0 too: P is on the x axis.</li>
      <li>Use the Top view: you see x and y only, and the distance on the floor is the 2D distance formula. The 3D formula adds the height difference as one more square.</li>
      <li>Turn on R with m : n = 1 : 1. R is the midpoint; check that PR and RQ come out equal.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Give points as x, y, z. Nothing is saved.</p>
    <div class="p3-quiz"></div>
  </div>
</div>

<style is:inline>
  .p3 svg .p3-ax { stroke: var(--muted); stroke-width: 1.4; }
  .p3 svg .p3-axp { stroke: var(--ink); stroke-width: 2; }
  .p3 svg .p3-floor { fill: var(--accent-soft); fill-opacity: 0.35; stroke: var(--line); }
  .p3 svg .p3-boxl { stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3; fill: none; }
  .p3 svg .p3-pq { stroke: var(--accent); stroke-width: 3; }
  .p3 svg .p3-P { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
  .p3 svg .p3-Q { fill: var(--warn); stroke: var(--surface); stroke-width: 2; }
  .p3 svg .p3-R { fill: var(--good); stroke: var(--surface); stroke-width: 2; }
  .p3 svg .p3-lab { font-weight: 700; }
  .p3 svg.p3-fig { cursor: grab; }
</style>

<script>
  import { dist, octant, ROMAN, onWhat, section, view, type P3 } from '../../lib/sci/points-3d';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, pair, val, quiz, svgPoint, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.p3')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.p3-fig');
  const pts: Record<'P' | 'Q', P3> = { P: [3, -2, 4], Q: [-1, 2, 2] };
  let who: 'P' | 'Q' = 'P', yaw = 30, pitch = 20;
  const X = q<HTMLInputElement>('.p3-x'), Y = q<HTMLInputElement>('.p3-y'), Z = q<HTMLInputElement>('.p3-z');
  const set = [pair(q('.p3-xr'), X, fromSliders), pair(q('.p3-yr'), Y, fromSliders), pair(q('.p3-zr'), Z, fromSliders)];
  const Mb = q<HTMLInputElement>('.p3-m'), Nb = q<HTMLInputElement>('.p3-n');
  pair(q('.p3-mr'), Mb, draw); pair(q('.p3-nr'), Nb, draw);
  function fromSliders() { pts[who] = [Math.round(val(X, 0, -6, 6)), Math.round(val(Y, 0, -6, 6)), Math.round(val(Z, 0, -6, 6))]; draw(); }
  root.querySelectorAll<HTMLButtonElement>('.p3-who button').forEach((b) => b.addEventListener('click', () => {
    who = b.dataset.p as 'P' | 'Q'; root.querySelectorAll('.p3-who button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    pts[who].forEach((v, i) => set[i](v));
  }));
  root.querySelectorAll<HTMLButtonElement>('.p3-view button').forEach((b) => b.addEventListener('click', () => {
    [yaw, pitch] = b.dataset.v === 'top' ? [0, 90] : b.dataset.v === 'front' ? [0, 0] : [30, 20]; draw();
  }));
  for (const c of ['.p3-box', '.p3-sec']) q(c).addEventListener('change', draw);
  const k = 20, cx = 170, cy = 165;
  const sp = (p: P3): [number, number] => { const [h, v] = view(p, yaw, pitch); return [cx + h * k, cy - v * k]; };
  const P3t = (p: P3) => `(${fmt(p[0], 3)}, ${fmt(p[1], 3)}, ${fmt(p[2], 3)})`;
  const sq = (x: number) => (x < 0 ? `(${fmt(x)})²` : `${fmt(x)}²`);
  const sgn = (v: number) => (v > 0 ? '+' : v < 0 ? '−' : '0');

  function line(a: P3, b: P3, cls: string) { const [x1, y1] = sp(a), [x2, y2] = sp(b); S('line', { x1, y1, x2, y2, class: cls }, fig); }
  function draw() {
    fig.replaceChildren();
    const floor: P3[] = [[-6, -6, 0], [6, -6, 0], [6, 6, 0], [-6, 6, 0]];
    S('polygon', { points: floor.map((p) => sp(p).join(',')).join(' '), class: 'p3-floor' }, fig);
    for (const [i, name] of [[0, 'x'], [1, 'y'], [2, 'z']] as const) {
      const e: P3 = [0, 0, 0], f: P3 = [0, 0, 0]; e[i] = -7; f[i] = 7;
      line(e, [0, 0, 0], 'p3-ax'); line([0, 0, 0], f, 'p3-axp');
      const [lx, ly] = sp(f); S('text', { x: lx + 4, y: ly + 4, class: 'p3-lab' }, fig, name);
      for (const t of [-5, 5]) { const m: P3 = [0, 0, 0]; m[i] = t; const [tx, ty] = sp(m); S('circle', { cx: tx, cy: ty, r: 2, style: 'fill:var(--muted)' }, fig); S('text', { x: tx + 3, y: ty - 4, class: 'sm-tick' }, fig, fmt(t).replace('-', '−')); }
    }
    const { P, Q } = pts;
    if (q<HTMLInputElement>('.p3-box').checked) for (const p of [P, Q]) {
      const [x, y, z] = p, F: P3 = [x, y, 0];
      line(p, F, 'p3-boxl'); line(F, [x, 0, 0], 'p3-boxl'); line(F, [0, y, 0], 'p3-boxl');
      line(p, [x, 0, z], 'p3-boxl'); line(p, [0, y, z], 'p3-boxl'); line([x, 0, z], [x, 0, 0], 'p3-boxl'); line([0, y, z], [0, y, 0], 'p3-boxl');
      line([x, 0, z], [0, 0, z], 'p3-boxl'); line([0, y, z], [0, 0, z], 'p3-boxl');
    }
    line(P, Q, 'p3-pq');
    const sec = q<HTMLInputElement>('.p3-sec').checked; q('.p3-secbox').hidden = !sec;
    const m = Math.round(val(Mb, 1, 1, 20)), n = Math.round(val(Nb, 1, 1, 20)), Rp = section(P, Q, m, n);
    const order = [{ p: P, c: 'p3-P', l: 'P' }, { p: Q, c: 'p3-Q', l: 'Q' }, ...(sec ? [{ p: Rp, c: 'p3-R', l: 'R' }] : [])].sort((a, b) => view(a.p, yaw, pitch)[2] - view(b.p, yaw, pitch)[2]);
    for (const o of order) { const [x, y] = sp(o.p); S('circle', { cx: x, cy: y, r: o.l === 'R' ? 6 : 8, class: `${o.c} p3-dot${o.l}` }, fig); S('text', { x: x + 10, y: y - 8, class: 'p3-lab' }, fig, o.l); }

    q('.p3-pts').textContent = `P = ${P3t(P)}, Q = ${P3t(Q)}`;
    const oc = (p: P3, name: string) => { const o = octant(p); return o ? `${name} has signs (${p.map(sgn).join(', ')}): octant ${ROMAN[o]}.` : `${name} lies on ${onWhat(p)}, so it is in no octant.`; };
    q('.p3-oct').textContent = `${oc(P, 'P')} ${oc(Q, 'Q')}`;
    const d = [Q[0] - P[0], Q[1] - P[1], Q[2] - P[2]], s = d.reduce((t, v) => t + v * v, 0);
    q('.p3-d').textContent = `PQ = √[(x₂ − x₁)² + (y₂ − y₁)² + (z₂ − z₁)²] = √[${d.map(sq).join(' + ')}] = √${s} = ${fmt(dist(P, Q), 4)}`;
    const so = P.reduce((t, v) => t + v * v, 0);
    q('.p3-o').textContent = `Distance of P from the origin: √(${P.map(sq).join(' + ')}) = √${so} = ${fmt(Math.sqrt(so), 4)}`;
    q('.p3-r').textContent = sec ? `R divides PQ in ${m} : ${n}: R = ((m x₂ + n x₁)/(m + n), …) = ${P3t(Rp)}${m === n ? ', the midpoint' : ''}. PR = ${fmt(dist(P, Rp), 4)}, RQ = ${fmt(dist(Rp, Q), 4)}, ratio ${fmt(dist(P, Rp) / dist(Rp, Q), 4)}.` : '';
  }

  let drag: { x: number; y: number } | null = null;
  fig.style.touchAction = 'none';
  fig.addEventListener('pointerdown', (e) => { drag = svgPoint(fig, e.clientX, e.clientY); fig.setPointerCapture(e.pointerId); });
  fig.addEventListener('pointermove', (e) => {
    if (!drag) return; const p = svgPoint(fig, e.clientX, e.clientY);
    yaw = (yaw - (p.x - drag.x) * 0.6) % 360; pitch = Math.max(-90, Math.min(90, pitch + (p.y - drag.y) * 0.4)); drag = p; draw();
  });
  const stop = () => { drag = null; };
  fig.addEventListener('pointerup', stop); fig.addEventListener('pointercancel', stop);
  draw();

  const QUADS: P3[] = [[1, 2, 2], [2, 3, 6], [1, 4, 8], [2, 6, 9], [4, 4, 7], [2, 10, 11], [6, 6, 7]];
  quiz(q('.p3-quiz'), () => {
    const out: Question[] = [];
    const [a, b, c] = QUADS[randInt(0, QUADS.length - 1)], perm = [[a, b, c], [b, c, a], [c, a, b]][randInt(0, 2)].map((v) => v * (randInt(0, 1) ? 1 : -1)), A: P3 = [randInt(-4, 4), randInt(-4, 4), randInt(-4, 4)];
    const B: P3 = [A[0] + perm[0], A[1] + perm[1], A[2] + perm[2]], D = Math.hypot(a, b, c);
    out.push({ q: `How far apart are (${A.join(', ')}) and (${B.join(', ')})?`.replace(/-/g, '−'), want: [D], work: `√[${perm.map((v) => `(${v})²`).join(' + ')}] = √${D * D} = ${D}.`.replace(/-/g, '−') });
    const C: P3 = [randInt(-6, 6, true), randInt(-6, 6, true), randInt(-6, 6, true)];
    out.push({ q: `In which octant is (${C.join(', ')})? Type its number, 1 for I up to 8 for VIII.`.replace(/-/g, '−'), want: [octant(C)], tol: 0, work: `Signs (${C.map(sgn).join(', ')}) give octant ${ROMAN[octant(C)]}, that is ${octant(C)}.` });
    const E: P3 = [randInt(-6, 6), randInt(-6, 6), randInt(-6, 6)], F: P3 = [randInt(-6, 6), randInt(-6, 6), randInt(-6, 6)], M = section(E, F, 1, 1);
    out.push({ q: `Find the midpoint of (${E.join(', ')}) and (${F.join(', ')}).`.replace(/-/g, '−'), want: M, ordered: true, hint: 'x, y, z', work: `((${E[0]} + ${F[0]})/2, (${E[1]} + ${F[1]})/2, (${E[2]} + ${F[2]})/2) = (${M.map((v) => fmt(v)).join(', ')}).`.replace(/-/g, '−') });
    const [g, h, i] = QUADS[randInt(0, 2)], G: P3 = [g * (randInt(0, 1) ? 1 : -1), h * (randInt(0, 1) ? 1 : -1), i];
    out.push({ q: `How far is the point (${G.join(', ')}) from the origin?`.replace(/-/g, '−'), want: [Math.hypot(...G)], work: `√(${G.map((v) => `(${v})²`).join(' + ')}) = √${g * g + h * h + i * i} = ${Math.hypot(...G)}.`.replace(/-/g, '−') });
    return out;
  });
</script>
