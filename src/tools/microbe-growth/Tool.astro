---
// Microbe growth simulator (Learn): microbes doubling every few minutes, slowed by cold, salt and sugar and killed by
// heat; yeast makes gas and curd bacteria make acid. A teaching model with rounded, made-up numbers.
import '../../styles/astro.css';
import '../../styles/learnquiz-d.css';
import { MICROBES } from '../../lib/sci/learnj-microbe';
---
<div class="ax lrn mgr">
  <div class="ax-card">
    <div class="ax-seg" role="group" aria-label="Level"><button type="button" data-level="8" aria-pressed="true">Class 8</button><button type="button" data-level="9" aria-pressed="false">Class 9 and up</button></div>
    <label style="display:grid;gap:4px;margin-top:10px">Microbe
      <select class="mg-m">{MICROBES.map((m) => <option value={m.id}>{m.name}</option>)}</select>
    </label>
    <div class="ax-row mg-pre" style="margin-top:8px;flex-wrap:wrap">
      <button type="button" class="btn secondary small" data-t="4" data-salt="0" data-sugar="0">Fridge</button>
      <button type="button" class="btn secondary small" data-t="30" data-salt="0" data-sugar="0">Warm kitchen</button>
      <button type="button" class="btn secondary small" data-t="30" data-salt="12" data-sugar="0">Pickle</button>
      <button type="button" class="btn secondary small" data-t="30" data-salt="0" data-sugar="65">Jam</button>
      <button type="button" class="btn secondary small" data-t="100" data-salt="0" data-sugar="0">Boiling</button>
    </div>
    <div class="ax-grid" style="margin-top:10px">
      <label class="lrn-sl">Temperature <b class="mg-Tv"></b><input type="range" class="mg-T" min="0" max="100" step="1" value="30" aria-label="Temperature" /></label>
      <label class="lrn-sl">Salt <b class="mg-sv"></b><input type="range" class="mg-salt" min="0" max="15" step="0.5" value="0" aria-label="Salt percent" /></label>
      <label class="lrn-sl">Sugar <b class="mg-uv"></b><input type="range" class="mg-sugar" min="0" max="70" step="1" value="0" aria-label="Sugar percent" /></label>
      <label class="lrn-sl">Time <b class="mg-tv"></b><input type="range" class="mg-t" min="0" max="720" step="10" value="240" aria-label="Time in minutes" /></label>
    </div>
    <canvas class="lrn-cv mg-dish" aria-label="A dish of microbes: more dots means more microbes"></canvas>
    <p class="ax-big mg-big" style="margin:10px 0 0"></p>
    <p class="lrn-eq mg-eq"></p>
    <dl class="ax-facts mg-facts" style="margin-top:10px"></dl>
  </div>

  <div class="ax-card">
    <h2>Number of microbes over time</h2>
    <canvas class="lrn-cv mg-gr" aria-label="Graph of the number of microbes against time"></canvas>
    <p class="ax-help mg-axis"></p>
    <div class="ax-scroll"><table class="mg-tab"></table></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="lrn-try">
      <li>Press Warm kitchen and watch the count after 4 hours. Then press Fridge: almost nothing grows.</li>
      <li>Press Pickle and Jam. Lots of salt or sugar stops microbes growing, which is why pickles and jams keep for months.</li>
      <li>Press Boiling: the microbes die within a minute or two. That is why we boil milk and drinking water.</li>
      <li>Choose yeast in dough and find the temperature where the dough rises fastest.</li>
      <li>Choose curd bacteria and watch the milk turn sour (the pH falls) as they grow.</li>
    </ul>
    <p class="ax-help">A teaching model: the doubling times and temperature limits are rounded, made-up values for a typical microbe, not data for any real species. Never use it to decide whether food is safe to eat.</p>
  </div>

  <div class="ax-card mg-quiz">
    <h2>Check yourself</h2>
  </div>
</div>

<style is:inline>
  .mgr select { min-height: 44px; font-size: 16px; }
  .mgr .mg-dish { margin-top: 10px; }
</style>

<script>
  import { MICROBES, simulate, doublingTime, tempFactor, soluteFactor, killRate, doubling, CAP } from '../../lib/sci/learnj-microbe';
  import { mountQuiz, pick, one, r, fitCanvas, wireLevel } from '../../lib/learnquiz-d';
  import { pagePalette } from '../../lib/report';
  import { rng } from '../../lib/sci/learnj-micro';

  const root = document.querySelector<HTMLElement>('.mgr')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const N0 = 100;
  let level = '8';
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const big = (n: number) => n >= 1e6 ? `${r(n / 1e6, 3)} million` : n >= 1 ? Math.round(n).toLocaleString('en') : n >= 0.01 ? 'fewer than 1' : 'none left';
  const hm = (min: number) => min < 60 ? `${Math.round(min)} min` : `${Math.floor(min / 60)} h${min % 60 ? ' ' + Math.round(min % 60) + ' min' : ''}`;
  const val = (s: string) => +q<HTMLInputElement>(s).value;

  function render() {
    const pal = pagePalette(), m = MICROBES.find((x) => x.id === q<HTMLSelectElement>('.mg-m').value)!;
    const T = val('.mg-T'), salt = val('.mg-salt'), sugar = val('.mg-sugar'), t = val('.mg-t');
    q('.mg-Tv').textContent = `${T} °C`; q('.mg-sv').textContent = `${salt} %`; q('.mg-uv').textContent = `${sugar} %`; q('.mg-tv').textContent = hm(t);
    const ser = simulate(m, T, salt, sugar, N0, 720), n = ser[t], td = doublingTime(m, T, salt, sugar), kr = killRate(T);
    // Dish: dots on a log scale, from 1 dot for 100 microbes to 1,500 dots at the 1,000 million limit.
    { const { ctx: c, W, H } = fitCanvas(q<HTMLCanvasElement>('.mg-dish'), 200), R = Math.min(W / 2, H / 2) - 6, cx = W / 2, cy = H / 2;
      c.fillStyle = pal.bg; c.fillRect(0, 0, W, H);
      c.strokeStyle = pal.line; c.lineWidth = 3; c.beginPath(); c.arc(cx, cy, R, 0, 7); c.stroke();
      const dots = n < 1 ? 0 : Math.round(1 + 1499 * Math.max(0, Math.log10(n) - 2) / 7), rand = rng(42);
      c.fillStyle = pal.red ? pal.ink : m.id === 'yeast' ? pal.accent2 : m.id === 'curd' ? pal.accent : pal.good;
      for (let i = 0; i < 1500; i++) { const a = rand() * 6.283, rr = Math.sqrt(rand()) * (R - 6); if (i < dots) { c.beginPath(); c.arc(cx + rr * Math.cos(a), cy + rr * Math.sin(a), 2.2, 0, 7); c.fill(); } }
      c.fillStyle = pal.muted; c.font = '12px system-ui, sans-serif'; c.textAlign = 'left'; c.fillText(`after ${hm(t)}`, 6, 16);
    }
    // Graph: log scale from 1 to 10⁹ (Class 9) or plain count (Class 8).
    { const { ctx: c, W, H } = fitCanvas(q<HTMLCanvasElement>('.mg-gr'), 220), gx = 46, gy = 10, gw = W - 56, gh = H - 40, logS = level === '9';
      const maxN = Math.max(...ser.slice(0, 721)), Ymax = logS ? 9 : Math.max(1000, maxN * 1.1);
      const X = (i: number) => gx + (i / 720) * gw, Y = (v: number) => gy + gh - (logS ? Math.max(0, Math.log10(Math.max(v, 1))) / 9 : v / Ymax) * gh;
      c.fillStyle = pal.bg; c.fillRect(0, 0, W, H); c.strokeStyle = pal.line; c.lineWidth = 1; c.strokeRect(gx, gy, gw, gh);
      c.fillStyle = pal.muted; c.font = '11px system-ui, sans-serif'; c.textAlign = 'right';
      const ticks = logS ? [1, 1e3, 1e6, 1e9] : [0, Ymax / 2, Ymax];
      for (const v of ticks) { c.fillText(logS ? `10^${Math.round(Math.log10(v))}` : v >= 1e6 ? `${r(v / 1e6, 2)}M` : String(Math.round(v)), gx - 4, Y(v) + 4); c.strokeStyle = pal.grid; c.beginPath(); c.moveTo(gx, Y(v)); c.lineTo(gx + gw, Y(v)); c.stroke(); }
      c.textAlign = 'center'; for (let h = 0; h <= 12; h += 2) c.fillText(`${h} h`, X(h * 60), gy + gh + 14);
      c.strokeStyle = pal.red ? pal.ink : pal.accent; c.lineWidth = 2; c.beginPath(); ser.forEach((v, i) => { if (i) c.lineTo(X(i), Y(v)); else c.moveTo(X(i), Y(v)); }); c.stroke();
      c.strokeStyle = pal.muted; c.setLineDash([4, 3]); c.beginPath(); c.moveTo(X(t), gy); c.lineTo(X(t), gy + gh); c.stroke(); c.setLineDash([]);
      c.fillStyle = pal.red ? pal.ink : pal.accent2; c.beginPath(); c.arc(X(t), Y(n), 4, 0, 7); c.fill();
      q('.mg-axis').textContent = logS ? 'Up the side: a log scale, each line 1,000 times the one below, so steady doubling shows as a straight line.' : 'Up the side: the number of microbes. Doubling makes the line bend upwards ever faster.';
    }
    q('.mg-big').textContent = `${big(n)} microbes after ${hm(t)} (started with ${N0})`;
    const why = kr > 0 ? 'heat is killing them' : tempFactor(T, m) === 0 ? (T < m.topt ? 'too cold to grow' : 'too hot to grow') : soluteFactor(salt, m.saltMax) === 0 ? 'too salty to grow' : soluteFactor(sugar, m.sugarMax) === 0 ? 'too sugary to grow' : '';
    q('.mg-eq').textContent = Number.isFinite(td)
      ? `Doubling time here: ${r(td, 3)} min. With no limit, N = ${N0} × 2^(${t} ÷ ${r(td, 3)}) = ${big(doubling(N0, t, td))}` + (doubling(N0, t, td) > CAP ? '; food and space run out first, so the count levels off near 1,000 million.' : '.')
      : `No growth: ${why}.` + (kr > 0 ? ` One in ten survive every ${r(Math.LN10 / kr, 2)} min.` : '');
    const facts = [
      fact('Speed compared with the best', `${Math.round(100 * tempFactor(T, m) * soluteFactor(salt, m.saltMax) * soluteFactor(sugar, m.sugarMax))} %`, why || `best at ${m.topt} °C`),
      fact('Grows between', `${m.tmin} and ${m.tmax} °C`, `fastest at ${m.topt} °C, doubling every ${m.td} min`),
    ];
    if (m.product === 'acid') { const prog = n <= N0 ? 0 : Math.min(1, Math.log10(n / N0) / Math.log10(CAP / N0)); facts.push(fact('Milk pH (model)', r(6.6 - 2.1 * prog, 2), prog > 0.85 ? 'sour: the milk has set into curd' : 'acid from the bacteria lowers the pH')); }
    if (m.product === 'gas') { const prog = n <= N0 ? 0 : Math.min(1, Math.log10(n / N0) / Math.log10(CAP / N0)); facts.push(fact('Dough size (model)', `${r(1 + 1.5 * prog, 2)} × the start`, 'carbon dioxide gas from the yeast puffs it up')); }
    if (level === '9') facts.push(fact('Number of doublings', Number.isFinite(td) ? r(t / td, 3) : '0', 'time ÷ doubling time'), fact('Growth rate', Number.isFinite(td) ? `${r(Math.LN2 / td * 60, 3)} per hour` : '0', 'k = ln 2 ÷ doubling time, N = N₀ e^(kt)'));
    q('.mg-facts').replaceChildren(...facts);
    const tab = q<HTMLTableElement>('.mg-tab'); tab.replaceChildren();
    const hr = tab.createTHead().insertRow(); ['Time', 'Microbes'].forEach((h) => { const c = document.createElement('th'); c.textContent = h; hr.append(c); });
    const body = tab.createTBody(); for (let h = 0; h <= 12; h += 2) { const tr = body.insertRow(); tr.insertCell().textContent = `${h} h`; tr.insertCell().textContent = big(ser[h * 60]); }
  }

  root.querySelectorAll<HTMLButtonElement>('.mg-pre button').forEach((b) => b.addEventListener('click', () => {
    q<HTMLInputElement>('.mg-T').value = b.dataset.t!; q<HTMLInputElement>('.mg-salt').value = b.dataset.salt!; q<HTMLInputElement>('.mg-sugar').value = b.dataset.sugar!; render();
  }));
  for (const s of ['.mg-T', '.mg-salt', '.mg-sugar', '.mg-t', '.mg-m']) q(s).addEventListener('input', render);
  addEventListener('resize', render);
  wireLevel(root, (l) => { level = l; render(); });

  mountQuiz(q('.mg-quiz'), () => {
    const n0 = one([10, 50, 100, 200]), td = one([15, 20, 30]), k = pick(2, 6), t = td * k, tgt = n0 * 2 ** pick(3, 7), td2 = one([20, 30, 40]);
    return [
      { q: `Bacteria double every ${td} minutes. You start with ${n0}. How many are there after ${t} minutes?`, ans: n0 * 2 ** k, unit: 'bacteria', work: `${t} ÷ ${td} = ${k} doublings, so ${n0} × 2^${k} = ${n0} × ${2 ** k} = ${n0 * 2 ** k}` },
      { q: `Starting from ${n0}, how many doublings does it take to reach ${tgt}?`, ans: Math.log2(tgt / n0), unit: 'doublings', work: `${tgt} ÷ ${n0} = ${tgt / n0} = 2^${Math.log2(tgt / n0)}, so ${Math.log2(tgt / n0)} doublings.` },
      { q: `A microbe doubles every ${td2} minutes. How many hours until 1 becomes about 1,000 (2^10 = 1024)?`, ans: 10 * td2 / 60, unit: 'hours', work: `10 doublings × ${td2} min = ${10 * td2} min = ${r(10 * td2 / 60)} hours` },
      { q: 'Why does food keep longer in a fridge?', ans: 2, choices: ['The cold kills all the microbes', 'The fridge removes the water', 'Cold slows microbes down, so they double much more slowly'], work: 'At fridge temperature most microbes grow very slowly; they are not killed, which is why food still spoils in the end.' },
      { q: 'How do lots of salt in pickles or sugar in jam stop microbes?', ans: 0, choices: ['They draw water out of the microbes, so they cannot grow', 'They make the food hotter', 'They feed the microbes'], work: 'Strong salt or sugar solutions pull water out of microbes by osmosis, so they cannot grow and multiply.' },
    ];
  });
</script>
