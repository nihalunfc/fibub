---
// Köppen-Geiger climate class with its reasoning, and a Walter-Lieth climate diagram, from 12 monthly means. Examples made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
// Made-up example stations written by fibub (not real places).
const EX: Record<string, { name: string; elev: string; T: number[]; P: number[] }> = {
  med: { name: 'Mediterranean coast (made up)', elev: '40', T: [10, 11, 13, 15, 19, 23, 26, 26, 23, 19, 14, 11], P: [80, 70, 55, 40, 25, 8, 2, 5, 25, 60, 85, 95] },
  monsoon: { name: 'Monsoon coast (made up)', elev: '10', T: [26, 27, 28, 29, 28, 27, 27, 27, 27, 27, 27, 26], P: [20, 25, 40, 120, 300, 450, 500, 450, 350, 200, 60, 25] },
  desert: { name: 'Desert town (made up)', elev: '300', T: [14, 16, 20, 25, 30, 33, 34, 33, 31, 26, 19, 15], P: [5, 4, 3, 1, 0, 0, 0, 0, 0, 1, 3, 5] },
  continental: { name: 'Continental plain (made up)', elev: '200', T: [-12, -10, -3, 6, 13, 18, 21, 19, 13, 6, -2, -9], P: [30, 25, 35, 50, 70, 90, 100, 90, 70, 55, 45, 35] },
  south: { name: 'Southern hemisphere coast (made up)', elev: '60', T: [17, 17, 16, 14, 11, 9, 8, 9, 10, 12, 14, 16], P: [60, 55, 65, 75, 90, 95, 100, 95, 80, 70, 65, 60] },
  tundra: { name: 'Arctic coast (made up)', elev: '5', T: [-28, -27, -25, -17, -6, 3, 7, 6, 1, -9, -20, -25], P: [10, 8, 9, 9, 12, 25, 35, 40, 25, 18, 12, 10] },
};
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const table = (k: string) => 'month\ttemperature\tprecipitation\n' + MON.map((m, i) => `${m}\t${EX[k].T[i]}\t${EX[k].P[i]}`).join('\n');
const presets = Object.fromEntries(Object.keys(EX).map((k) => [k, { ...EX[k], text: table(k) }]));
---
<div class="ax kpc" data-presets={JSON.stringify(presets)}>
  <div class="ax-card">
    <h2>Monthly climate</h2>
    <label>Example <select class="kp-ex">
      <option value="med" selected>Mediterranean coast (made up)</option>
      <option value="monsoon">Monsoon coast (made up)</option>
      <option value="desert">Desert town (made up)</option>
      <option value="continental">Continental plain (made up)</option>
      <option value="south">Southern hemisphere coast (made up)</option>
      <option value="tundra">Arctic coast (made up)</option>
      <option value="own">My own data</option>
    </select></label>
    <label style="margin-top:8px">Month, mean temperature, precipitation <textarea class="kp-data" rows="8" spellcheck="false">{presets.med.text}</textarea></label>
    <DataFile target=".kp-data" maxCols={20} maxRows={60} label="Open a file" />
    <p class="ax-help">12 rows, January to December: the mean temperature and the total precipitation of each month (long-term averages, ideally 30 years). A month column is optional. Two rows of 12 values also work. A row for the year is skipped.</p>
    <div class="ax-grid" style="margin-top:10px">
      <label>Units <select class="kp-u"><option value="si" selected>°C and mm</option><option value="us">°F and inches</option></select></label>
      <label>Station name (for the diagram) <input class="kp-name" type="text" value="Mediterranean coast (made up)" /></label>
      <label>Elevation (m, optional) <input class="kp-elev" type="text" inputmode="decimal" value="40" /></label>
      <label>C and D split at a coldest month of <select class="kp-cd"><option value="0" selected>0 °C (Peel et al. 2007)</option><option value="-3">−3 °C (Köppen's original)</option></select></label>
      <label>Hot (h) or cold (k) dry climate by <select class="kp-hk"><option value="mat" selected>Mean annual temperature 18 °C</option><option value="cold">Coldest month 0 °C</option></select></label>
      <label>Diagram starts in <select class="kp-start"><option value="auto" selected>January, or July in the southern hemisphere</option><option value="0">January</option><option value="6">July</option></select></label>
    </div>
    <p class="ax-err kp-err" hidden></p>
  </div>

  <div class="ax-card kp-out">
    <h2>Climate class</h2>
    <p class="ax-big kp-big"></p>
    <ol class="kp-steps"></ol>
    <dl class="ax-facts kp-facts"></dl>
    <h2 style="margin-top:14px">Walter-Lieth climate diagram</h2>
    <canvas class="ax-fig kp-fig"></canvas>
    <p class="ax-help">Red line: temperature (left scale). Blue line: precipitation (right scale, 20 mm for every 10 °C, so the lines cross where rain just matches evaporation in Walter's rule of thumb). Dotted red: dry months. Blue hatching: wet months. Solid blue: months above 100 mm, drawn at a tenth of the scale. The diagram is always in °C and mm.</p>
    <Downloads />
  </div>
</div>

<script>
  import { koppen, walterLieth, parseMonthly } from '../../lib/sci/koppen';
  import { paint, wireDownloads, type Figure, type Section } from '../../lib/report';
  import { num, parseTable } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.kpc')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  const presets = JSON.parse(root.dataset.presets!) as Record<string, { name: string; elev: string; text: string }>;
  const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  let fig: Figure | null = null, report: Section[] = [];

  function calc() {
    const err = q('.kp-err'), out = q('.kp-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; report = []; };
    const got = parseMonthly(parseTable(q<HTMLTextAreaElement>('.kp-data').value), num);
    if ('error' in got) return fail(got.error);
    const us = sel('.kp-u') === 'us';
    const T = got.T.map((t) => (us ? ((t - 32) * 5) / 9 : t)), P = got.P.map((p) => (us ? p * 25.4 : p));
    if (P.some((p) => p < 0)) return fail('Precipitation cannot be negative.');
    if (T.some((t) => t < -90 || t > 60)) return fail(`A monthly mean temperature is outside −90 to 60 °C; check the units${us ? '' : ' (choose °F and inches for US data)'}.`);
    err.hidden = true; out.hidden = false;
    const r = koppen(T, P, { cdBoundary: +sel('.kp-cd') as 0, hk: sel('.kp-hk') as 'mat' }), m = r.m;
    q('.kp-big').textContent = `${r.code}: ${r.name}`;
    const ol = q('.kp-steps'); ol.replaceChildren();
    r.steps.forEach((s) => { const li = document.createElement('li'); li.textContent = s.test + (s.result ? ' → ' : ''); if (s.result) { const b = document.createElement('strong'); b.textContent = s.result; li.append(b); } ol.append(li); });
    const tU = (c: number) => (us ? `${((c * 9) / 5 + 32).toFixed(1)} °F` : `${c.toFixed(1)} °C`), pU = (mm: number) => (us ? `${(mm / 25.4).toFixed(2)} in` : `${Math.round(mm)} mm`);
    const wl = walterLieth(T, P), aridN = wl.arid.filter(Boolean).length;
    const facts = [
      fact('Mean annual temperature', tU(m.MAT), `warmest month ${tU(m.Thot)} (${MON[T.indexOf(m.Thot)]}), coldest ${tU(m.Tcold)} (${MON[T.indexOf(m.Tcold)]}); annual range ${us ? ((m.Thot - m.Tcold) * 9 / 5).toFixed(1) + ' °F' : (m.Thot - m.Tcold).toFixed(1) + ' °C'}`),
      fact('Annual precipitation', pU(m.MAP), `wettest month ${pU(m.Pwet)} (${MON[P.indexOf(m.Pwet)]}), driest ${pU(m.Pdry)} (${MON[m.dryMonth]})`),
      fact('Summer half', m.nhSummer ? 'April to September' : 'October to March', `${Math.round((100 * m.Psum) / (m.MAP || 1))} % of the precipitation falls in it${m.nhSummer ? '' : ' (southern hemisphere pattern)'}`),
      fact('Months above 10 °C', String(m.Tmon10), 'the growing-season count used for the third letter'),
      fact('Dry months (Walter-Lieth)', String(aridN), aridN ? `precipitation below twice the temperature: ${MON.filter((_, i) => wl.arid[i]).join(', ')}` : 'no month has precipitation below twice its temperature'),
    ];
    q('.kp-facts').replaceChildren(...facts);
    // Walter-Lieth diagram.
    const start = sel('.kp-start') === 'auto' ? (m.nhSummer ? 0 : 6) : +sel('.kp-start');
    const ord = Array.from({ length: 12 }, (_, i) => (i + start) % 12);
    const To = ord.map((i) => T[i]), Po = ord.map((i) => P[i]);
    const yTop = Math.max(50, Math.ceil(Math.max(...To, ...ord.map((i) => wl.py[i])) / 10) * 10), yBot = Math.min(0, Math.floor(Math.min(...To) / 10) * 10);
    const name = q<HTMLInputElement>('.kp-name').value.trim(), elev = num(q<HTMLInputElement>('.kp-elev').value);
    fig = { w: 380, h: 300, alt: `Walter-Lieth climate diagram, ${r.code}, ${aridN} dry months`, draw: (ctx, W, H, pal) => {
      const l = 40, rr = 44, t = 34, b = 26, pw = W - l - rr, ph = H - t - b;
      const X = (k: number) => l + ((k + 0.5) / 12) * pw, Y = (v: number) => t + ph * (1 - (v - yBot) / (yTop - yBot));
      const lerp = (arr: number[], x: number) => { const k = Math.max(0, Math.min(10.999, x)), i = Math.floor(k), f = k - i; return arr[i] + f * (arr[i + 1] - arr[i]); };
      const p2 = Po.map((p) => p / 2), pc = Po.map((p) => (p <= 100 ? p / 2 : 50 + (p - 100) / 20));
      ctx.font = '9px system-ui, sans-serif';
      ctx.strokeStyle = pal.grid; ctx.lineWidth = 0.7;
      for (let v = yBot; v <= yTop; v += 10) { ctx.beginPath(); ctx.moveTo(l, Y(v)); ctx.lineTo(l + pw, Y(v)); ctx.stroke(); }
      // Fills, sampled across the months.
      const blue = pal.red ? pal.muted : pal.accent;
      for (let px = Math.ceil(X(0)); px <= X(11); px += 3) {
        const x = ((px - l) / pw) * 12 - 0.5, tv = lerp(To, x), pv = lerp(p2, x), cv = lerp(pc, x);
        if (pv < tv) { ctx.fillStyle = pal.bad; for (let yy = Y(tv) + 1; yy < Y(pv); yy += 3) ctx.fillRect(px, yy, 1.1, 1.1); }
        else {
          ctx.strokeStyle = blue; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(px + 0.5, Y(tv)); ctx.lineTo(px + 0.5, Y(Math.min(pv, 50))); ctx.stroke();
          if (cv > 50) { ctx.fillStyle = blue; ctx.fillRect(px - 1, Y(cv), 3, Y(50) - Y(cv)); }
        }
      }
      const curve = (arr: number[], colour: string) => { ctx.strokeStyle = colour; ctx.lineWidth = 2; ctx.beginPath(); arr.forEach((v, k) => (k ? ctx.lineTo(X(k), Y(v)) : ctx.moveTo(X(k), Y(v)))); ctx.stroke(); };
      curve(pc, blue); curve(To, pal.bad);
      if (yBot < 0) { ctx.strokeStyle = pal.muted; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(l, Y(0)); ctx.lineTo(l + pw, Y(0)); ctx.stroke(); }
      ctx.strokeStyle = pal.line; ctx.lineWidth = 1; ctx.strokeRect(l, t, pw, ph);
      ctx.fillStyle = pal.muted; ctx.textBaseline = 'middle';
      for (let v = yBot; v <= yTop; v += 10) {
        ctx.textAlign = 'right'; ctx.fillText(String(v), l - 4, Y(v));
        if (v >= 0) { ctx.textAlign = 'left'; ctx.fillText(String(v <= 50 ? v * 2 : 100 + (v - 50) * 20), l + pw + 4, Y(v)); }
      }
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ord.forEach((i, k) => ctx.fillText(MON[i][0], X(k), t + ph + 4));
      ctx.save(); ctx.translate(10, t + ph / 2); ctx.rotate(-Math.PI / 2); ctx.textBaseline = 'middle'; ctx.fillStyle = pal.bad; ctx.fillText('Temperature (°C)', 0, 0); ctx.restore();
      ctx.save(); ctx.translate(W - 8, t + ph / 2); ctx.rotate(Math.PI / 2); ctx.textBaseline = 'middle'; ctx.fillStyle = blue; ctx.fillText('Precipitation (mm)', 0, 0); ctx.restore();
      ctx.fillStyle = pal.ink; ctx.font = '10px system-ui, sans-serif'; ctx.textBaseline = 'top';
      ctx.textAlign = 'left'; ctx.fillText(`${name || 'Station'}${Number.isFinite(elev) ? ` (${Math.round(elev)} m)` : ''}`.slice(0, 44), l, 4);
      ctx.fillStyle = pal.muted; ctx.fillText(`${r.code}`, l, 18);
      ctx.textAlign = 'right'; ctx.fillStyle = pal.ink; ctx.fillText(`${m.MAT.toFixed(1)} °C   ${Math.round(m.MAP)} mm`, l + pw, 4);
    } };
    paint(q<HTMLCanvasElement>('.kp-fig'), fig);
    report = [{ title: q('.kp-big').textContent!, facts: [...r.steps.map((s, i) => [`Step ${i + 1}`, s.test + (s.result ? ` → ${s.result}` : '')] as [string, string]), ...facts.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string])], figure: fig, table: { head: ['Month', us ? 'T (°F)' : 'T (°C)', us ? 'P (in)' : 'P (mm)', 'Dry (P < 2T)'], rows: MON.map((mo, i) => [mo, String(got.T[i]), String(got.P[i]), wl.arid[i] ? 'yes' : '']), align: ['l', 'r', 'r', 'l'] } }];
  }

  q('.kp-ex').addEventListener('change', () => {
    const k = sel('.kp-ex'); if (k === 'own') return;
    const p = presets[k]; q<HTMLTextAreaElement>('.kp-data').value = p.text; q<HTMLInputElement>('.kp-name').value = p.name; q<HTMLInputElement>('.kp-elev').value = p.elev; q<HTMLSelectElement>('.kp-u').value = 'si';
  });
  q('.kp-data').addEventListener('input', () => { q<HTMLSelectElement>('.kp-ex').value = 'own'; });
  root.querySelectorAll('input, textarea, select').forEach((i) => { i.addEventListener('input', calc); i.addEventListener('change', calc); });
  document.addEventListener('fibub:theme', () => fig && !q('.kp-out').hidden && paint(q<HTMLCanvasElement>('.kp-fig'), fig));
  calc();
  wireDownloads(q('.dl'), () => ({ title: 'Climate class and diagram', subtitle: q('.kp-big').textContent ?? '', file: 'climate', sections: report }));
</script>

<style is:global>
  .kpc select, .kpc input { max-width: 100%; }
  .kpc textarea { width: 100%; }
  .kpc .kp-steps { margin: 6px 0 10px; padding-left: 1.3em; line-height: 1.45; }
  .kpc .kp-steps li { margin: 3px 0; }
</style>
