---
// #T852 Hash checker
---
<div class="tool-ui hc">
  <section class="panel">
    <div class="hc-tabs" role="tablist" aria-label="What to hash">
      <button type="button" role="tab" data-m="text" aria-selected="true">Text</button>
      <button type="button" role="tab" data-m="file" aria-selected="false">File</button>
    </div>
    <label class="hc-tp">Text<textarea class="hc-text" rows="3" spellcheck="false">abc</textarea></label>
    <label class="hc-fp" hidden>Choose a file<input class="hc-file" type="file" /></label>
    <p class="hc-info" aria-live="polite"></p>
    <label>Expected hash (optional: paste one to compare)<input class="hc-exp" type="text" spellcheck="false" autocomplete="off" /></label>
    <p class="hc-cmp" aria-live="polite" hidden></p>
    <div class="hc-btns"><button type="button" class="btn secondary hc-clear">Clear</button></div>
  </section>
  <section class="panel">
    <ul class="hc-list"></ul>
  </section>
  <p class="hc-fine">Hashes are worked out on this page. Your text and files are never sent anywhere.</p>
</div>

<style is:inline>
  .hc { display: grid; gap: 14px; margin-bottom: 32px; }
  .hc .panel { padding: 16px; display: grid; gap: 10px; }
  .hc-tabs { display: flex; gap: 6px; }
  .hc-tabs button { font: inherit; font-size: 14px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .hc-tabs button[aria-selected="true"] { border-color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .hc label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .hc label[hidden] { display: none; }
  .hc textarea, .hc input[type=text], .hc input[type=file] { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; box-sizing: border-box; }
  .hc textarea, .hc input[type=text] { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 14px; }
  .hc textarea:focus, .hc input:focus { border-color: var(--accent); outline: none; }
  .hc-btns { display: flex; gap: 8px; }
  .hc-info, .hc-fine { color: var(--muted); font-size: 13px; margin: 0; }
  .hc-cmp { margin: 0; font-weight: 600; }
  .hc-cmp.ok { color: var(--good); } .hc-cmp.no { color: var(--bad); }
  .hc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .hc-list li { display: grid; gap: 4px; }
  .hc-name { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .hc-name small { font-weight: 400; color: var(--muted); }
  .hc-name button { font: inherit; font-size: 13px; padding: 4px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .hc-val { font: 13px ui-monospace, Menlo, Consolas, monospace; overflow-wrap: anywhere; word-break: break-all; margin: 0; }
  .hc-list li.hit .hc-val { color: var(--good); font-weight: 700; }
</style>

<script>
  const root = document.querySelector('.hc') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const text = $<HTMLTextAreaElement>('.hc-text'), file = $<HTMLInputElement>('.hc-file'), exp = $<HTMLInputElement>('.hc-exp');
  const info = $('.hc-info'), cmp = $('.hc-cmp'), list = $('.hc-list');

  // MD5 (RFC 1321), kept small. Old and broken for security; still used for download checksums.
  const md5 = (msg: Uint8Array): Uint8Array => {
    const K = new Uint32Array(64), S = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];
    for (let i = 0; i < 64; i++) K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 2 ** 32);
    const n = (((msg.length + 8) >>> 6) + 1) << 6, buf = new Uint8Array(n);
    buf.set(msg); buf[msg.length] = 0x80;
    const dv = new DataView(buf.buffer), bits = msg.length * 8;
    dv.setUint32(n - 8, bits >>> 0, true); dv.setUint32(n - 4, Math.floor(bits / 2 ** 32), true);
    let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;
    const M = new Uint32Array(16);
    for (let off = 0; off < n; off += 64) {
      for (let j = 0; j < 16; j++) M[j] = dv.getUint32(off + j * 4, true);
      let A = a0, B = b0, C = c0, D = d0;
      for (let i = 0; i < 64; i++) {
        let F: number, g: number;
        if (i < 16) { F = (B & C) | (~B & D); g = i; }
        else if (i < 32) { F = (D & B) | (~D & C); g = (5 * i + 1) & 15; }
        else if (i < 48) { F = B ^ C ^ D; g = (3 * i + 5) & 15; }
        else { F = C ^ (B | ~D); g = (7 * i) & 15; }
        const s = S[(i >> 4) * 4 + (i & 3)];
        const x = (A + F + K[i] + M[g]) | 0;
        A = D; D = C; C = B; B = (B + ((x << s) | (x >>> (32 - s)))) | 0;
      }
      a0 = (a0 + A) | 0; b0 = (b0 + B) | 0; c0 = (c0 + C) | 0; d0 = (d0 + D) | 0;
    }
    const out = new Uint8Array(16), ov = new DataView(out.buffer);
    [a0, b0, c0, d0].forEach((v, i) => ov.setUint32(i * 4, v >>> 0, true));
    return out;
  };
  const hex = (u: Uint8Array) => Array.from(u, (b) => b.toString(16).padStart(2, '0')).join('');
  const ALGS: [string, string, string][] = [['SHA-256', 'SHA-256', 'the usual choice'], ['SHA-512', 'SHA-512', ''], ['SHA-384', 'SHA-384', ''], ['SHA-1', 'SHA-1', 'old, not secure'], ['MD5', 'MD5', 'old, not secure']];
  let results: Record<string, string> = {}, job = 0, mode = 'text', bytes: Uint8Array | null = null;

  const compare = () => {
    const e = exp.value.trim().toLowerCase().replace(/^(sha-?\d+|md5)[:=\s]+/, '').replace(/\s+/g, '');
    list.querySelectorAll('li').forEach((li) => li.classList.toggle('hit', !!e && results[(li as HTMLElement).dataset.a!] === e));
    if (!e) { cmp.hidden = true; return; }
    const hit = Object.keys(results).find((k) => results[k] === e);
    cmp.hidden = false; cmp.className = 'hc-cmp ' + (hit ? 'ok' : 'no');
    cmp.textContent = hit ? `Match: this is the ${hit} hash.` : Object.keys(results).length ? 'No match with any of the hashes below. The text or file is not the same, or it is a different kind of hash.' : 'Add text or a file first.';
  };
  const draw = () => {
    list.innerHTML = '';
    if (!bytes) return;
    for (const [a, label, note] of ALGS) {
      const li = document.createElement('li'); li.dataset.a = a;
      const top = document.createElement('div'); top.className = 'hc-name';
      const nm = document.createElement('span'); nm.textContent = label + ' ';
      if (note) { const sm = document.createElement('small'); sm.textContent = `(${note})`; nm.append(sm); }
      const cp = document.createElement('button'); cp.type = 'button'; cp.textContent = 'Copy';
      cp.addEventListener('click', () => navigator.clipboard?.writeText(results[a] || '').then(() => { cp.textContent = 'Copied'; setTimeout(() => (cp.textContent = 'Copy'), 1200); }, () => {}));
      top.append(nm, cp);
      const v = document.createElement('p'); v.className = 'hc-val'; v.textContent = results[a] || '…';
      li.append(top, v); list.append(li);
    }
    compare();
  };
  const run = async () => {
    const my = ++job;
    bytes = mode === 'text' ? new TextEncoder().encode(text.value) : bytes;
    results = {};
    if (!bytes) { info.textContent = mode === 'file' ? 'Choose a file to hash it.' : ''; draw(); compare(); return; }
    const u = bytes;
    const r: Record<string, string> = {};
    for (const [a] of ALGS) r[a] = a === 'MD5' ? hex(md5(u)) : hex(new Uint8Array(await crypto.subtle.digest(a, u)));
    if (my !== job) return;
    results = r; draw();
  };

  text.addEventListener('input', () => { info.textContent = `${new TextEncoder().encode(text.value).length.toLocaleString('en-US')} bytes as UTF-8.`; run(); });
  file.addEventListener('change', async () => {
    const f = file.files?.[0]; if (!f) return;
    info.textContent = `Reading ${f.name}…`;
    bytes = new Uint8Array(await f.arrayBuffer());
    info.textContent = `${f.name}: ${f.size.toLocaleString('en-US')} bytes.`;
    run();
  });
  exp.addEventListener('input', compare);
  root.querySelectorAll('.hc-tabs button').forEach((b) => b.addEventListener('click', () => {
    mode = (b as HTMLElement).dataset.m!;
    root.querySelectorAll('.hc-tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    $('.hc-tp').hidden = mode !== 'text'; $('.hc-fp').hidden = mode !== 'file';
    if (mode === 'file') { bytes = null; file.value = ''; }
    info.textContent = mode === 'text' ? `${new TextEncoder().encode(text.value).length.toLocaleString('en-US')} bytes as UTF-8.` : '';
    run();
  }));
  $('.hc-clear').addEventListener('click', () => { text.value = ''; file.value = ''; exp.value = ''; bytes = null; info.textContent = ''; run(); });
  info.textContent = '3 bytes as UTF-8.';
  run();
</script>
