---
// #T1061 Battery Test: what the browser reports about the battery, a live log, our own time-left estimate and a chart.
import '../../styles/device.css';
---
<div class="tool-ui dv bt">
  <section class="panel">
    <div class="dv-row">
      <button type="button" class="btn bt-start">Read battery</button>
      <label class="dv-check"><input type="checkbox" class="bt-awake" /> Keep screen on while watching</label>
    </div>
    <p class="dv-status bt-status" aria-live="polite">Press Read battery. Nothing is sent or stored anywhere.</p>
    <div class="dv-meter bt-meter" aria-hidden="true"><i></i></div>
    <dl class="dv-stats">
      <div><dt>Level</dt><dd class="bt-level">–</dd></div>
      <div><dt>Charging</dt><dd class="bt-chg">–</dd></div>
      <div><dt>Time to full (browser)</dt><dd class="bt-ct">–</dd></div>
      <div><dt>Time left (browser)</dt><dd class="bt-dt">–</dd></div>
      <div><dt>Our estimate</dt><dd class="bt-eta">–</dd></div>
    </dl>
    <p class="dv-fine">Our estimate comes from how fast the level moved since you opened this page, so it needs a few minutes and a level that changes. The browser's own figure may be missing or jumpy.</p>
  </section>
  <section class="panel">
    <h2>Level over this visit</h2>
    <canvas class="dv-canvas bt-cv" height="140" aria-label="Chart of battery level while this page has been open"></canvas>
    <h2>Changes</h2>
    <pre class="dv-log bt-log" aria-live="polite">Nothing yet.</pre>
  </section>
  <section class="panel">
    <h2>Good to know</h2>
    <ul class="dv-fine">
      <li>Works in Chromium browsers (Chrome, Edge, Opera, Brave) on Windows, macOS, Android, ChromeOS and Linux. Safari, Firefox and every iPhone browser do not offer it.</li>
      <li>Browsers round the level, often to the nearest 1%, so small changes take a while to show.</li>
      <li>A desktop with no battery usually reports 100% and charging.</li>
      <li>For battery health, use your system: Windows, run <code>powercfg /batteryreport</code> in a command window; Mac, System Settings &gt; Battery &gt; Battery Health; iPhone, Settings &gt; Battery &gt; Battery Health; Android, Settings &gt; Battery (the name varies by maker).</li>
    </ul>
  </section>
</div>

<style is:inline>
  .bt .bt-cv { height: 140px; }
  .bt .bt-log { min-height: 3em; }
</style>

<script>
  import { batteryEta } from '../../lib/device/core';
  import { keepAwake, say } from '../../lib/device/browser';
  type Bat = EventTarget & { level: number; charging: boolean; chargingTime: number; dischargingTime: number };
  const root = document.querySelector('.bt') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const status = $('.bt-status'), meter = $('.bt-meter'), bar = meter.querySelector('i') as HTMLElement, log = $('.bt-log'), cv = $<HTMLCanvasElement>('.bt-cv'), awake = $<HTMLInputElement>('.bt-awake');
  let bat: Bat | null = null, poll = 0, release: (() => void) | null = null;
  let ref: { level: number; t: number } | null = null, last: { level: number; t: number; charging: boolean } | null = null;
  const pts: { t: number; level: number }[] = [], lines: string[] = [];
  const now = () => Date.now();
  const mins = (m: number) => (m < 1 ? 'under a minute' : m < 60 ? `${Math.round(m)} min` : `${Math.floor(m / 60)} h ${Math.round(m % 60)} min`);
  const secs = (s: number) => (isFinite(s) ? mins(s / 60) : 'not reported');

  const chart = () => {
    const dpr = devicePixelRatio || 1, W = (cv.width = cv.clientWidth * dpr), H = (cv.height = 140 * dpr), c = cv.getContext('2d')!;
    const css = getComputedStyle(root), ink = css.getPropertyValue('--ink') || '#000', line = css.getPropertyValue('--line') || '#999';
    c.strokeStyle = line; c.lineWidth = dpr; [0, 0.5, 1].forEach((p) => { c.beginPath(); c.moveTo(0, H - p * (H - 4 * dpr) - 2 * dpr); c.lineTo(W, H - p * (H - 4 * dpr) - 2 * dpr); c.stroke(); });
    if (pts.length < 2) return;
    const t0 = pts[0].t, span = Math.max(60000, pts[pts.length - 1].t - t0);
    c.strokeStyle = ink; c.lineWidth = 2 * dpr; c.beginPath();
    pts.forEach((p, i) => { const x = ((p.t - t0) / span) * W, y = H - p.level * (H - 4 * dpr) - 2 * dpr; i ? c.lineTo(x, y) : c.moveTo(x, y); });
    c.stroke();
  };

  const show = (changed: boolean) => {
    if (!bat) return;
    const lvl = bat.level, chg = bat.charging, t = now(), pct = Math.round(lvl * 100);
    $('.bt-level').textContent = `${pct}%`; $('.bt-chg').textContent = chg ? 'Yes' : 'No';
    $('.bt-ct').textContent = chg ? secs(bat.chargingTime) : '–'; $('.bt-dt').textContent = chg ? '–' : secs(bat.dischargingTime);
    bar.style.width = `${pct}%`; meter.dataset.tone = !chg && pct <= 15 ? 'bad' : !chg && pct <= 30 ? 'warn' : '';
    if (!ref || (last && last.charging !== chg)) ref = { level: lvl, t };
    if (last && (last.level !== lvl || last.charging !== chg) && changed) {
      lines.unshift(`${new Date(t).toLocaleTimeString()}  ${pct}%  ${chg ? 'charging' : 'on battery'}`);
      log.textContent = lines.slice(0, 100).join('\n');
    }
    const eta = batteryEta(ref, { level: lvl, t }, chg);
    $('.bt-eta').textContent = eta != null && t - ref.t >= 30000 ? `${mins(eta)} ${chg ? 'to full' : 'left'}` : 'collecting…';
    pts.push({ t, level: lvl });
    if (pts.length > 2000) pts.shift();
    last = { level: lvl, t, charging: chg }; chart();
  };

  const stop = () => { clearInterval(poll); release?.(); release = null; };
  const start = async () => {
    stop(); bat = null; ref = last = null; pts.length = 0; lines.length = 0; log.textContent = 'Nothing yet.';
    const nav = navigator as Navigator & { getBattery?: () => Promise<Bat> };
    if (typeof nav.getBattery !== 'function') { say(status, 'This browser does not share battery information. Use Chrome, Edge or Opera on Windows, Mac, Android or Linux. Safari, Firefox and iPhones do not offer it. See the system steps below.', 'bad'); return; }
    try { bat = await nav.getBattery(); } catch { say(status, 'The browser refused to share the battery state (often a privacy setting or an insecure page).', 'bad'); return; }
    for (const ev of ['levelchange', 'chargingchange', 'chargingtimechange', 'dischargingtimechange']) bat.addEventListener(ev, () => show(true));
    show(false);
    say(status, bat.level === 1 && bat.charging && !isFinite(bat.dischargingTime) ? 'Reports 100% and charging. A desktop with no battery usually shows exactly this.' : 'Watching the battery. Changes appear below as they happen.', 'good');
    poll = window.setInterval(() => show(false), 5000);
    if (awake.checked) release = await keepAwake();
  };

  $('.bt-start').addEventListener('click', start);
  awake.addEventListener('change', async () => { release?.(); release = null; if (awake.checked && bat) release = await keepAwake(); });
  document.addEventListener('visibilitychange', async () => { if (!document.hidden && awake.checked && bat) { release?.(); release = await keepAwake(); } });
  addEventListener('pagehide', stop);
</script>
