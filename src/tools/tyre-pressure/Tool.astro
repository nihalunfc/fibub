---
// #T899 Tyre pressure
---
<div class="tool-ui tp">
  <section class="panel">
    <h2 class="tp-h">Convert pressure</h2>
    <div class="tp-grid">
      <label>Pressure <input data-k="cv" inputmode="decimal" value="35" /></label>
      <label>Unit <select data-k="cu"><option value="psi">psi</option><option value="bar">bar</option><option value="kpa">kPa</option></select></label>
    </div>
    <p class="tp-line" data-o="conv"></p>
  </section>
  <section class="panel">
    <h2 class="tp-h">Temperature change</h2>
    <p class="tp-fine">Air in a tyre pushes harder when warm and softer when cold. Gauges read pressure above the air outside (gauge), so the sum is done on absolute pressure (gauge + 101.325 kPa) in kelvin.</p>
    <div class="tp-grid">
      <label>Gauge pressure <input data-k="p1" inputmode="decimal" value="35" /></label>
      <label>Unit <select data-k="u1"><option value="psi">psi</option><option value="bar">bar</option><option value="kpa">kPa</option></select></label>
      <label>Air temperature when measured (°C) <input data-k="t1" inputmode="decimal" value="20" /></label>
      <label>New temperature (°C) <input data-k="t2" inputmode="decimal" value="-10" /></label>
    </div>
    <p class="tp-big" data-o="change" aria-live="polite"></p>
    <p class="tp-line" data-o="rule"></p>
  </section>
  <section class="panel">
    <h2 class="tp-h">Set cold pressure for another day</h2>
    <p class="tp-fine">Type the pressure you want at the temperature you will drive in. It tells you what to fill to now, at today's temperature.</p>
    <div class="tp-grid">
      <label>Wanted pressure (gauge) <input data-k="p3" inputmode="decimal" value="35" /></label>
      <label>Unit <select data-k="u3"><option value="psi">psi</option><option value="bar">bar</option><option value="kpa">kPa</option></select></label>
      <label>Temperature it is wanted at (°C) <input data-k="t3" inputmode="decimal" value="20" /></label>
      <label>Temperature now, tyres cold (°C) <input data-k="t4" inputmode="decimal" value="5" /></label>
    </div>
    <p class="tp-big" data-o="fill" aria-live="polite"></p>
    <p class="tp-warn" role="alert"></p>
  </section>
  <p class="tp-fine">Use the pressure on your vehicle's door-jamb or manual label, set with cold tyres (driven less than about 2 km). A tyre warms by roughly 0.3 to 0.5 bar (4 to 7 psi) after a long drive: do not let air out of hot tyres. Rough physics, not a safety guarantee; always check with a gauge you trust. Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .tp { display: grid; gap: 14px; margin-bottom: 32px; }
  .tp .panel { padding: 16px; }
  .tp-h { font-size: 16px; margin: 0 0 8px; }
  .tp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); gap: 12px; }
  .tp label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .tp input, .tp select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .tp input:focus, .tp select:focus { border-color: var(--accent); outline: none; }
  .tp-big { font-size: 24px; font-weight: 700; margin: 12px 0 0; }
  .tp-line { margin: 10px 0 0; font-weight: 600; }
  .tp-warn { color: var(--bad); margin: 8px 0 0; } .tp-warn:empty { display: none; }
  .tp-fine { color: var(--muted); font-size: 13px; margin: 0 0 10px; }
  .tp > .tp-fine { margin: 0; }
</style>

<script>
  import { toKpa, fromKpa, gaugeAtTemp, type PUnit } from '../../lib/money/vehicle-physics';
  const root = document.querySelector('.tp') as HTMLElement;
  const q = (k: string) => root.querySelector(`[data-k="${k}"]`) as HTMLInputElement;
  const o = (k: string) => root.querySelector(`[data-o="${k}"]`) as HTMLElement;
  const num = (k: string) => parseFloat(q(k).value.replace(/,/g, ''));
  const fmt = (v: number, u: PUnit) => v.toLocaleString('en-US', { minimumFractionDigits: u === 'bar' ? 2 : 1, maximumFractionDigits: u === 'bar' ? 2 : 1 });
  const all = (k: number) => `${fmt(fromKpa(k, 'psi'), 'psi')} psi = ${fmt(fromKpa(k, 'bar'), 'bar')} bar = ${fmt(k, 'kpa')} kPa`;
  const calc = () => {
    const cv = num('cv');
    o('conv').textContent = isFinite(cv) ? all(toKpa(cv, q('cu').value as PUnit)) : '';
    const warn = root.querySelector('.tp-warn') as HTMLElement; warn.textContent = '';
    const p1 = num('p1'), t1 = num('t1'), t2 = num('t2'), u1 = q('u1').value as PUnit;
    if (isFinite(p1) && isFinite(t1) && isFinite(t2) && t1 > -273 && t2 > -273) {
      const k = gaugeAtTemp(toKpa(p1, u1), t1, t2);
      o('change').textContent = `${fmt(fromKpa(k, u1), u1)} ${u1 === 'kpa' ? 'kPa' : u1} at ${t2} °C`;
      o('rule').textContent = all(k) + `. That is ${fmt(Math.abs(fromKpa(k - toKpa(p1, u1), u1)), u1)} ${u1 === 'kpa' ? 'kPa' : u1} ${k < toKpa(p1, u1) ? 'lower' : 'higher'}.`;
    } else { o('change').textContent = ''; o('rule').textContent = 'Type a pressure and two temperatures.'; }
    const p3 = num('p3'), t3 = num('t3'), t4 = num('t4'), u3 = q('u3').value as PUnit;
    if (isFinite(p3) && isFinite(t3) && isFinite(t4) && t3 > -273 && t4 > -273) {
      const k = gaugeAtTemp(toKpa(p3, u3), t3, t4);
      o('fill').textContent = `Fill to ${fmt(fromKpa(k, u3), u3)} ${u3 === 'kpa' ? 'kPa' : u3} now`;
      if (k < 0) warn.textContent = 'That would need less than no pressure: check the numbers.';
    } else o('fill').textContent = '';
  };
  root.addEventListener('input', calc); root.addEventListener('change', calc);
  calc();
</script>
