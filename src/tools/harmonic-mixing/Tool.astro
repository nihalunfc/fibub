---
// #T1024 Mix planner
---
<div class="tool-ui hm">
  <label>TODO input <input class="hm-in" type="number" value="1" step="any" /></label>
  <p class="hm-out" aria-live="polite"></p>
</div>

<style is:inline>
  .hm { display: grid; gap: .75rem; }
</style>

<script>
  // Keep the maths in src/lib/ (or src/lib/sci/ for science) as plain TypeScript; import heavy libraries with import().
  const root = document.querySelector('.hm') as HTMLElement;
  const input = root.querySelector('.hm-in') as HTMLInputElement;
  const out = root.querySelector('.hm-out') as HTMLElement;
  const update = () => { out.textContent = 'TODO result for ' + input.value; };
  input.addEventListener('input', update);
  update();
</script>
