---
// Phototropism plant: a seedling grows hour by hour. Drag the lamp and the shoot bends towards it, because auxin
// moves to the shaded side of the tip and makes those cells grow longer. Cut or cover the tip like the classic
// experiments, switch the light off, or lay the pot on its side to see gravity at work. Teaching model.
import '../../styles/astro.css';
import '../../styles/smath.css';
---
<div class="ax sm pht">
  <p class="ax-help">A teaching model: the growth and bending rates are made-up round values so you can watch a day or two of growth in seconds.</p>
  <div class="ax-card">
    <div class="ax-row"><b>Level</b>
      <div class="ax-seg pht-level" role="group" aria-label="Level"><button type="button" data-v="10" aria-pressed="true">Class 10</button><button type="button" data-v="11" aria-pressed="false">Class 11</button></div></div>
    <div class="ax-row pht-gap"><b>Light</b>
      <div class="ax-seg pht-light" role="group" aria-label="Light"><button type="button" data-v="lamp" aria-pressed="true">Lamp (drag it)</button><button type="button" data-v="top" aria-pressed="false">From above</button><button type="button" data-v="dark" aria-pressed="false">Dark</button></div></div>
    <div class="ax-row pht-gap"><b>Tip</b>
      <div class="ax-seg pht-exp" role="group" aria-label="What is done to the shoot tip"><button type="button" data-v="normal" aria-pressed="true">Left alone</button><button type="button" data-v="cover" aria-pressed="false">Covered with foil</button><button type="button" data-v="cut" aria-pressed="false">Cut off</button></div></div>
    <div class="ax-row pht-gap"><b>Pot</b>
      <div class="ax-seg pht-pot" role="group" aria-label="Pot"><button type="button" data-v="up" aria-pressed="true">Upright</button><button type="button" data-v="side" aria-pressed="false">On its side</button></div></div>
  </div>

  <div class="ax-card">
    <svg class="sm-fig pht-fig" viewBox="0 0 340 320" role="img" aria-label="A seedling in a pot with a lamp you can drag"></svg>
    <label class="pht-gap pht-al">Lamp position: <b class="pht-av"></b>
      <input type="range" class="pht-ang" min="-80" max="80" step="1" value="47" aria-label="Lamp angle from straight above, degrees; negative is to the left" /></label>
    <div class="ax-row pht-gap">
      <button type="button" class="btn small pht-play">Grow</button>
      <button type="button" class="btn secondary small pht-one">+1 hour</button>
      <button type="button" class="btn secondary small pht-reset">Start again</button>
    </div>
    <p class="ax-big pht-big" aria-live="polite"></p>
    <dl class="ax-facts pht-facts"></dl>
    <p class="pht-say"></p>
  </div>

  <div class="ax-card pht-x11" hidden>
    <h2>Plant hormones</h2>
    <div class="ax-scroll"><table>
      <tr><th>Hormone</th><th>Main jobs</th></tr>
      <tr><td>Auxin</td><td>Cell lengthening at shoot tips; bending to light and gravity; root formation on cuttings; keeps side buds asleep.</td></tr>
      <tr><td>Gibberellin</td><td>Stem lengthening, seed germination, larger fruit.</td></tr>
      <tr><td>Cytokinin</td><td>Cell division; delays the ageing of leaves.</td></tr>
      <tr><td>Abscisic acid</td><td>Stops growth; closes stomata when water is short; keeps seeds dormant; leaves falling.</td></tr>
      <tr><td>Ethylene</td><td>A gas that ripens fruit.</td></tr>
    </table></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="sm-try">
      <li>Grow for 10 hours with the lamp on the right, then drag it to the left. What does the shoot do?</li>
      <li>Cover the tip with foil and grow again. Does it still bend? What does that tell you about where light is sensed?</li>
      <li>Cut the tip off. Why does the shoot hardly grow and not bend at all?</li>
      <li>Switch the light off and lay the pot on its side. Which way do the shoot and root turn?</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Type the number of your answer. Nothing is saved.</p>
    <div class="pht-quiz"></div>
  </div>
</div>

<style is:inline>
  .pht .pht-gap { margin-top: 10px; }
  .pht .pht-al { display: block; } .pht .pht-al input { width: 100%; height: 32px; accent-color: var(--accent); }
  .pht svg .pht-shoot { fill: none; stroke: var(--good); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .pht svg .pht-leaf { fill: var(--good-soft); stroke: var(--good); stroke-width: 1.5; }
  .pht svg .pht-root { fill: none; stroke: var(--warn); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .pht svg .pht-pot { fill: var(--accent-soft); stroke: var(--ink); stroke-width: 2; }
  .pht svg .pht-soil { fill: var(--warn-soft); stroke: none; }
  .pht svg .pht-sun { fill: var(--warn); stroke: var(--surface); stroke-width: 2; cursor: grab; }
  .pht svg .pht-ray { stroke: var(--warn); stroke-width: 1.5; stroke-dasharray: 4 5; opacity: .8; }
  .pht svg .pht-foil { fill: var(--muted); }
  .pht svg .pht-dark { fill: var(--ink); opacity: .12; }
  .pht svg text { font-size: 11px; }
  .pht svg .pht-aux1 { fill: var(--accent); } .pht svg .pht-aux2 { fill: var(--accent-soft); stroke: var(--accent); }
</style>

<script>
  import { newPlant, growHour, auxin, tip, aimError, type Plant, type Experiment } from '../../lib/sci/tropism';
  import { fmt } from '../../lib/sci/smath';
  import { S, dragOn, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.pht')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const fig = q<SVGSVGElement>('.pht-fig');
  const BX = 170, BY = 230, MAXH = 44;
  let level = 10, lightMode = 'lamp', exp: Experiment = 'normal', tilted = false, plant: Plant = newPlant(), timer = 0;
  let lamp = { x: 310, y: 100 };

  const lightPt = () => lightMode === 'dark' ? null : lightMode === 'top' ? { x: 0, y: -BY + 12 } : { x: lamp.x - BX, y: lamp.y - BY };

  function draw() {
    fig.replaceChildren();
    if (lightMode === 'dark') S('rect', { x: 0, y: 0, width: 340, height: 320, class: 'pht-dark' }, fig);
    // pot, rotated when on its side
    const pot = S('g', { transform: tilted ? `rotate(90 ${BX} ${BY})` : '' }, fig);
    S('path', { d: `M${BX - 46} ${BY} L${BX + 46} ${BY} L${BX + 36} ${BY + 74} L${BX - 36} ${BY + 74} Z`, class: 'pht-pot' }, pot);
    S('rect', { x: BX - 44, y: BY + 2, width: 88, height: 16, class: 'pht-soil' }, pot);
    // root and shoot
    const line = (segs: { a: number; len: number }[]) => { let x = BX, y = BY; const pts = [`${x},${y}`]; for (const s of segs) { x += s.len * Math.cos(s.a); y += s.len * Math.sin(s.a); pts.push(`${x.toFixed(1)},${y.toFixed(1)}`); } return pts.join(' '); };
    S('polyline', { points: line(plant.root), class: 'pht-root' }, fig);
    S('polyline', { points: line(plant.shoot), class: 'pht-shoot' }, fig);
    const t = tip(plant.shoot, BX, BY), a = plant.shoot[plant.shoot.length - 1].a;
    if (exp !== 'cut') {
      for (const s of [-1, 1]) S('ellipse', { cx: t.x + 9 * Math.cos(a + s * 1.9), cy: t.y + 9 * Math.sin(a + s * 1.9), rx: 9, ry: 4, transform: `rotate(${((a + s * 1.9) * 180) / Math.PI} ${t.x + 9 * Math.cos(a + s * 1.9)} ${t.y + 9 * Math.sin(a + s * 1.9)})`, class: 'pht-leaf' }, fig);
      if (exp === 'cover') S('circle', { cx: t.x + 3 * Math.cos(a), cy: t.y + 3 * Math.sin(a), r: 7, class: 'pht-foil' }, fig);
    } else S('line', { x1: t.x - 6 * Math.sin(a), y1: t.y + 6 * Math.cos(a), x2: t.x + 6 * Math.sin(a), y2: t.y - 6 * Math.cos(a), stroke: 'currentColor', 'stroke-width': 2 }, fig);
    // light
    const L = lightPt();
    if (L) {
      const lx = L.x + BX, ly = L.y + BY;
      S('line', { x1: lx, y1: ly, x2: t.x, y2: t.y, class: 'pht-ray' }, fig);
      if (lightMode === 'lamp') { S('circle', { cx: lx, cy: ly, r: 26, fill: 'transparent', class: 'pht-hit' }, fig); S('circle', { cx: lx, cy: ly, r: 14, class: 'pht-sun pht-lamp' }, fig); S('text', { x: lx, y: ly + 28, 'text-anchor': 'middle' }, fig, 'lamp'); }
      else S('circle', { cx: lx, cy: ly, r: 10, class: 'pht-sun' }, fig);
    }
    // auxin at the tip
    const au = auxin(a, L ? Math.atan2(L.y + BY - t.y, L.x + BX - t.x) : null, exp);
    S('text', { x: 8, y: 304 }, fig, `${plant.hours} h`);
    // facts
    const tiltDeg = ((a + Math.PI / 2) * 180) / Math.PI;
    q('.pht-big').textContent = exp === 'cut' ? 'No tip, no auxin: no bending' : au.sideways > 0.05 ? `Shaded side gets ${fmt(au.shaded * 100, 0)} % of the auxin` : 'Auxin is shared evenly: no bending from light';
    const facts: [string, string][] = [['Hours grown', String(plant.hours)], ['Tip leans', Math.abs(tiltDeg) < 0.5 ? 'straight up' : `${fmt(Math.abs(tiltDeg), 0)}° to the ${tiltDeg > 0 ? 'right' : 'left'}`], ['Auxin, lit side', exp === 'cut' ? 'none' : `${fmt(au.lit * 100, 0)} %`], ['Auxin, shaded side', exp === 'cut' ? 'none' : `${fmt(au.shaded * 100, 0)} %`]];
    if (L && level === 11) facts.push(['Tip points away from the light by', `${fmt(aimError(plant, L), 0)}°`]);
    q('.pht-facts').replaceChildren(...facts.map(([k, v]) => { const d = document.createElement('div'); d.append(Object.assign(document.createElement('dt'), { textContent: k }), Object.assign(document.createElement('dd'), { textContent: v })); return d; }));
    let say = '';
    if (exp === 'cut') say = 'With the tip cut off, there is no auxin coming down the stem, so it hardly grows and cannot bend. The tip is where auxin is made.';
    else if (exp === 'cover') say = 'The foil cap stops the tip seeing the light, so auxin stays evenly spread and the shoot grows straight' + (tilted ? ', but it still turns up against gravity.' : '. Light is sensed at the tip.');
    else if (!L) say = tilted ? 'In the dark the shoot still turns up and the root turns down: that is geotropism (gravitropism), the response to gravity.' : 'In the dark there is no light from one side, so the shoot grows straight up, tall and pale.';
    else if (au.sideways < 0.05) say = 'Light comes from straight ahead of the tip, so auxin is shared evenly and both sides grow at the same speed.';
    else say = 'Light hits one side of the tip. Auxin moves to the shaded side, cells there grow longer than on the lit side, and the shoot curves towards the light: positive phototropism. The root grows down, towards gravity.';
    if (level === 11) say += ' Charles and Francis Darwin found in 1880 that covering the tip stops the bending; Went later collected auxin from tips in agar blocks.';
    q('.pht-say').textContent = say;
    q<HTMLButtonElement>('.pht-one').disabled = plant.hours >= MAXH;
  }

  const stop = () => { clearInterval(timer); timer = 0; q('.pht-play').textContent = 'Grow'; };
  const step = () => { if (plant.hours >= MAXH) { stop(); return; } plant = growHour(plant, lightPt(), exp); draw(); };
  q('.pht-play').addEventListener('click', () => { if (timer) { stop(); return; } if (plant.hours >= MAXH) plant = newPlant(tilted); q('.pht-play').textContent = 'Pause'; timer = window.setInterval(step, matchMedia('(prefers-reduced-motion: reduce)').matches ? 400 : 200); });
  q('.pht-one').addEventListener('click', () => { stop(); step(); });
  const reset = () => { stop(); plant = newPlant(tilted); draw(); };
  q('.pht-reset').addEventListener('click', reset);
  const seg = (s: string, on: (v: string) => void) => q(s).addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (!b) return; q(s).querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); on(b.dataset.v!); });
  seg('.pht-level', (v) => { level = Number(v); q('.pht-x11').hidden = level !== 11; draw(); });
  seg('.pht-light', (v) => { lightMode = v; draw(); });
  seg('.pht-exp', (v) => { exp = v as Experiment; reset(); });
  seg('.pht-pot', (v) => { tilted = v === 'side'; reset(); });
  const ANG = q<HTMLInputElement>('.pht-ang');
  const showAng = () => { const a = Number(ANG.value); q('.pht-av').textContent = a === 0 ? 'straight above' : `${Math.abs(a)}° to the ${a > 0 ? 'right' : 'left'}`; };
  ANG.addEventListener('input', () => { const a = (Number(ANG.value) * Math.PI) / 180; lamp = { x: BX + 150 * Math.sin(a), y: BY - 150 * Math.cos(a) }; if (lightMode !== 'lamp') q<HTMLButtonElement>('.pht-light button[data-v="lamp"]').click(); showAng(); draw(); });
  showAng();
  dragOn(fig, (x, y) => (lightMode === 'lamp' && Math.hypot(x - lamp.x, y - lamp.y) < 30 ? 'lamp' : null), (_id, x, y) => { lamp = { x: Math.min(325, Math.max(15, x)), y: Math.min(300, Math.max(15, y)) }; ANG.value = String(Math.round((Math.atan2(lamp.x - BX, BY - lamp.y) * 180) / Math.PI)); showAng(); draw(); });
  draw();

  const FACTS: { q: string; opts: string[]; right: number; why: string }[] = [
    { q: 'A shoot bends towards light because auxin makes cells grow longer on the', opts: ['lit side', 'shaded side', 'root side'], right: 1, why: 'Auxin moves to the shaded side, so that side grows faster and the shoot curves towards the light.' },
    { q: 'Roots growing down into the soil is an example of', opts: ['positive geotropism', 'negative phototropism only', 'chemotropism'], right: 0, why: 'Roots grow towards gravity: positive geotropism.' },
    { q: 'Which part of a shoot senses light?', opts: ['The base of the stem', 'The roots', 'The tip'], right: 2, why: 'Covering the tip stops bending, so the tip senses the light.' },
    { q: 'A pollen tube growing towards the ovule is an example of', opts: ['phototropism', 'chemotropism', 'hydrotropism'], right: 1, why: 'It grows towards chemicals made by the ovule: chemotropism.' },
    { q: 'A shoot growing up away from gravity shows', opts: ['negative geotropism', 'positive geotropism', 'hydrotropism'], right: 0, why: 'Shoots grow against gravity: negative geotropism.' },
    { q: 'Which plant hormone mainly causes bending towards light?', opts: ['Abscisic acid', 'Ethylene', 'Auxin'], right: 2, why: 'Auxin, made at the shoot tip.' },
    { q: 'The folding leaves of a touch-me-not plant are an example of', opts: ['a growth movement', 'a movement without growth', 'phototropism'], right: 1, why: 'Cells quickly lose water and change shape; no growth is involved.' },
  ];
  quiz(q('.pht-quiz'), () => [...FACTS].sort(() => Math.random() - 0.5).slice(0, 4).map((c) => {
    const order = [0, 1, 2].sort(() => Math.random() - 0.5), pos = order.indexOf(c.right) + 1;
    const list = order.map((k, i) => `${i + 1} ${c.opts[k]}`).join(', ');
    return { q: c.q.endsWith('?') ? `${c.q} ${list}.` : `${c.q} ___? ${list}.`, want: [pos], hint: 'type 1, 2 or 3', work: `${pos}: ${c.opts[c.right]}. ${c.why}` } as Question;
  }));
</script>
