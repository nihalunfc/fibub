---
// Coulomb's law and superposition: drag up to four point charges on a board, pick one, and see the force from
// each of the others and their vector sum. Everything runs in the browser.
import '../../styles/astro.css';
---
<div class="ax cfz">
  <div class="ax-card">
    <h2>Charges on a board</h2>
    <div class="ax-row">
      <label>Start from <select class="cfz-preset" style="width:auto">
        <option value="two">Two charges</option>
        <option value="three" selected>Three charges</option>
        <option value="line">Three in a line</option>
        <option value="square">Four at the corners of a square</option>
      </select></label>
    </div>
    <canvas class="ax-fig cfz-fig" aria-label="Charges and the forces on the chosen charge"></canvas>
    <div class="ax-legend"><span><i class="cfz-kp"></i>positive</span><span><i class="cfz-kn"></i>negative</span><span><i class="cfz-kf"></i>force from one charge</span><span><i class="cfz-kt"></i>net force</span></div>
    <p class="cfz-hint">Tap a charge to choose it, drag to move it (1 cm grid). The arrows show the forces on the chosen charge.</p>
    <label class="cfz-sl">Chosen charge <b class="cfz-name">A</b>: <b class="cfz-qv">+2 µC</b><input type="range" class="cfz-q" min="-10" max="10" step="1" value="2" aria-label="Charge of the chosen charge in microcoulomb" /></label>
    <div class="ax-row" style="margin-top:10px">
      <button type="button" class="btn secondary small cfz-add">Add a charge</button>
      <button type="button" class="btn secondary small cfz-del">Remove chosen</button>
      <label class="cfz-chk"><input type="checkbox" class="cfz-tail" /> Show the head-to-tail sum</label>
    </div>
  </div>

  <div class="ax-card">
    <p class="ax-big cfz-big" aria-live="polite"></p>
    <ul class="cfz-parts"></ul>
    <p class="cfz-sum"></p>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="cfz-try">
      <li>Start from Two charges and drag B twice as far away: the force drops to a quarter (inverse square).</li>
      <li>Flip the sign of B with the slider: the arrow on A turns round, from push to pull.</li>
      <li>In Three in a line, slide the middle charge until the two pushes on it cancel and the net force is zero.</li>
      <li>In the square, choose a corner: the two near neighbours push at right angles, and the far corner adds along the diagonal.</li>
      <li>Tick the head-to-tail sum: the net force arrow closes the chain of single forces.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <div class="cfz-quiz"></div>
  </div>
</div>

<style is:inline>
  .cfz .cfz-fig { touch-action: none; cursor: pointer; border: 1px solid var(--line); max-width: 560px; margin: 10px auto 0; }
  .cfz .cfz-sl { display: grid; gap: 6px; margin-top: 12px; color: var(--ink); font-size: 15px; }
  .cfz input[type=range] { width: 100%; height: 32px; accent-color: var(--accent); }
  .cfz .cfz-chk { display: inline-flex; gap: 6px; align-items: center; font-size: 15px; min-height: 40px; }
  .cfz .cfz-hint { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .cfz-kp { background: var(--bad); }
  .cfz-kn { background: var(--accent); }
  .cfz-kf { background: var(--muted); }
  .cfz-kt { background: var(--good); }
  .cfz-big { font-size: clamp(18px, 4.6vw, 24px); margin: 0; }
  .cfz-parts { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; overflow-wrap: anywhere; }
  .cfz-sum { margin: 8px 0 0; font-size: 15px; overflow-wrap: anywhere; }
  .cfz-try { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-size: 15px; }
  .cfz .eq-list { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 14px; }
  .cfz .eq-q p { margin: 0 0 6px; }
  .cfz .eq-res { margin: 6px 0 0; font-size: 14px; min-height: 1em; }
  .cfz .eq-ok { color: var(--good); font-weight: 600; }
  .cfz .eq-no { color: var(--bad); }
  .cfz .eq-work { margin-top: 4px; font-size: 14px; }
  .cfz .eq-work summary { cursor: pointer; color: var(--muted); padding: 4px 0; }
  .cfz .eq-work p { margin: 4px 0; }
</style>

<script>
  import { netForce, deg360, questions, type Charge } from '../../lib/sci/coulomb-forces';
  import { pagePalette } from '../../lib/report';
  import { setup, arrow, sg, sci3, onTheme, quiz } from '../../lib/school-p34';

  const root = document.querySelector<HTMLElement>('.cfz')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const fig = q<HTMLCanvasElement>('.cfz-fig'), slider = q<HTMLInputElement>('.cfz-q');
  const W = 360, H = 280, PX = 10; // 1 cm = 10 px: the board is 36 cm × 28 cm
  const NAMES = 'ABCD';
  const PRESETS: Record<string, Charge[]> = {
    two: [{ q: 2, x: 10, y: 14 }, { q: -3, x: 26, y: 14 }],
    three: [{ q: 2, x: 8, y: 8 }, { q: -3, x: 28, y: 8 }, { q: 1, x: 18, y: 22 }],
    line: [{ q: 4, x: 6, y: 14 }, { q: 1, x: 16, y: 14 }, { q: 1, x: 30, y: 14 }],
    square: [{ q: 2, x: 8, y: 4 }, { q: 2, x: 28, y: 4 }, { q: 2, x: 28, y: 24 }, { q: 2, x: 8, y: 24 }],
  };
  let cs: Charge[] = [], sel = 0, drag = -1;
  const load = (k: string) => { cs = PRESETS[k].map((c) => ({ ...c })); sel = k === 'line' ? 1 : 0; };
  const cx = (x: number) => x * PX, cy = (y: number) => H - y * PX;
  const fmtQ = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v)} µC`;
  const fmtN = (F: number) => (F >= 0.1 ? `${sci3(F)} N` : `${sci3(F * 1000)} mN`);

  function draw() {
    const pal = pagePalette(), c = setup(fig, W, H);
    c.fillStyle = pal.bg; c.fillRect(0, 0, W, H);
    c.strokeStyle = pal.grid; c.lineWidth = 1; c.beginPath();
    for (let x = 0; x <= 36; x += 2) { c.moveTo(cx(x) + 0.5, 0); c.lineTo(cx(x) + 0.5, H); }
    for (let y = 0; y <= 28; y += 2) { c.moveTo(0, cy(y) + 0.5); c.lineTo(W, cy(y) + 0.5); }
    c.stroke();
    c.fillStyle = pal.muted; c.font = '11px system-ui, sans-serif'; c.textAlign = 'left'; c.fillText('grid: 2 cm', 4, H - 5);
    const n = netForce(cs, sel), big = Math.max(n.F, ...n.parts.map((p) => Math.abs(p.F)), 1e-12), k = 90 / big;
    const x0 = cx(cs[sel].x), y0 = cy(cs[sel].y);
    let hx = x0, hy = y0;
    for (const p of n.parts) {
      const x1 = x0 + p.fx * k, y1 = y0 - p.fy * k;
      arrow(c, x0, y0, x1, y1, pal.muted, 2, `from ${NAMES[p.j]}`);
      if (q<HTMLInputElement>('.cfz-tail').checked) {
        c.setLineDash([5, 4]); arrow(c, hx, hy, hx + p.fx * k, hy - p.fy * k, pal.warn, 1.5); c.setLineDash([]);
        hx += p.fx * k; hy -= p.fy * k;
      }
    }
    if (n.F > 1e-12) arrow(c, x0, y0, x0 + n.fx * k, y0 - n.fy * k, pal.good, 4, 'net');
    cs.forEach((ch, i) => {
      const X = cx(ch.x), Y = cy(ch.y), col = ch.q > 0 ? pal.bad : ch.q < 0 ? pal.accent : pal.muted;
      c.fillStyle = col; c.beginPath(); c.arc(X, Y, 13, 0, Math.PI * 2); c.fill();
      if (i === sel) { c.strokeStyle = pal.ink; c.lineWidth = 2.5; c.beginPath(); c.arc(X, Y, 17, 0, Math.PI * 2); c.stroke(); }
      c.fillStyle = pal.bg; c.font = '700 14px system-ui, sans-serif'; c.textAlign = 'center'; c.fillText(ch.q > 0 ? '+' : ch.q < 0 ? '−' : '0', X, Y + 5);
      c.fillStyle = pal.ink; c.font = '700 12px system-ui, sans-serif'; c.fillText(`${NAMES[i]} ${fmtQ(ch.q)}`, X, Y + (ch.y > 3 ? 30 : -22));
    });
    fig.setAttribute('aria-label', `${cs.length} charges; net force on ${NAMES[sel]} ${fmtN(n.F)}`);
  }

  function texts() {
    const ch = cs[sel], n = netForce(cs, sel), name = NAMES[sel];
    q('.cfz-name').textContent = name; q('.cfz-qv').textContent = fmtQ(ch.q); slider.value = String(ch.q);
    q('.cfz-big').textContent = n.F < 1e-12 ? `Net force on ${name}: 0 N` : `Net force on ${name}: ${fmtN(n.F)} at ${Math.round(deg360(n.angle))}°`;
    const items = n.parts.map((p) => {
      const o = cs[p.j], li = document.createElement('li');
      const kind = p.F > 0 ? `repulsion (pushes ${name} away from ${NAMES[p.j]})` : p.F < 0 ? `attraction (pulls ${name} towards ${NAMES[p.j]})` : 'no force';
      const m = (v: number) => String(v).replace('-', '−');
      li.textContent = `From ${NAMES[p.j]} (${fmtQ(o.q)}, r = ${sg(p.r * 100)} cm): F = k q${name} q${NAMES[p.j]} / r² = 8.99 × 10⁹ × ${m(ch.q)} × 10⁻⁶ × ${m(o.q)} × 10⁻⁶ / ${sci3(p.r)}² = ${fmtN(Math.abs(p.F))}, ${kind}`;
      return li;
    });
    q('.cfz-parts').replaceChildren(...items);
    q('.cfz-sum').textContent = `Add them as vectors: Fx = ${sg(n.fx)} N, Fy = ${sg(n.fy)} N, so F = √(Fx² + Fy²) = ${sg(n.F)} N` + (n.F < 1e-12 ? '.' : `, at ${Math.round(deg360(n.angle))}° anticlockwise from the right.`);
    q<HTMLButtonElement>('.cfz-add').disabled = cs.length >= 4; q<HTMLButtonElement>('.cfz-del').disabled = cs.length <= 2;
  }
  const all = () => { texts(); draw(); };

  const toBoard = (e: PointerEvent) => { const r = fig.getBoundingClientRect(); return [((e.clientX - r.left) / r.width) * W, ((e.clientY - r.top) / r.height) * H]; };
  fig.addEventListener('pointerdown', (e) => {
    const [x, y] = toBoard(e);
    let best = -1, bd = 26;
    cs.forEach((ch, i) => { const d = Math.hypot(cx(ch.x) - x, cy(ch.y) - y); if (d < bd) { bd = d; best = i; } });
    if (best < 0) return;
    sel = best; drag = best; fig.setPointerCapture(e.pointerId); e.preventDefault(); all();
  });
  fig.addEventListener('pointermove', (e) => {
    if (drag < 0) return;
    const [x, y] = toBoard(e), nx = Math.max(1, Math.min(35, Math.round(x / PX))), ny = Math.max(1, Math.min(27, Math.round((H - y) / PX)));
    if (cs.some((o, i) => i !== drag && o.x === nx && o.y === ny)) return;
    if (cs[drag].x !== nx || cs[drag].y !== ny) { cs[drag].x = nx; cs[drag].y = ny; all(); }
  });
  const up = () => { drag = -1; };
  fig.addEventListener('pointerup', up); fig.addEventListener('pointercancel', up);
  slider.addEventListener('input', () => { cs[sel].q = +slider.value; all(); });
  q('.cfz-preset').addEventListener('change', () => { load(q<HTMLSelectElement>('.cfz-preset').value); all(); });
  q('.cfz-tail').addEventListener('change', draw);
  q('.cfz-add').addEventListener('click', () => {
    if (cs.length >= 4) return;
    const spots = [[18, 14], [18, 4], [18, 24], [4, 14], [32, 14]];
    const s = spots.find(([x, y]) => !cs.some((o) => o.x === x && o.y === y)) ?? [2, 2];
    cs.push({ q: -1, x: s[0], y: s[1] }); sel = cs.length - 1; all();
  });
  q('.cfz-del').addEventListener('click', () => { if (cs.length <= 2) return; cs.splice(sel, 1); sel = 0; all(); });
  onTheme(draw);
  load('three'); all();
  quiz(q('.cfz-quiz'), () => questions());
</script>
