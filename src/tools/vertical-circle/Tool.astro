---
// Circular motion: a stone whirled on a string (v²/r towards the centre; let go and it flies off along the
// tangent) and a mass on a string in a vertical circle. Maths in src/lib/sci/vertical-circle.ts.
import '../../styles/astro.css';
---
<div class="ax vc">
  <div class="ax-card">
    <div class="ax-row vc-top">
      <div class="ax-seg vc-mode" role="group" aria-label="Which circle">
        <button type="button" data-v="h" aria-pressed="true">Stone on a string</button>
        <button type="button" data-v="v" aria-pressed="false">Vertical circle</button>
      </div>
    </div>
    <canvas class="vc-c" aria-label="Circular motion"></canvas>
    <p class="vc-state"><span class="ax-pill vc-pill"></span></p>
    <div class="ax-row"><button type="button" class="btn small vc-go">Let go</button><button type="button" class="btn secondary small vc-reset">Start again</button></div>
    <div class="vc-ctl">
      <label>Mass: <b class="vc-mv"></b><input class="vc-m" type="range" min="0.1" max="2" step="0.1" value="0.5" /></label>
      <label>Radius (string length): <b class="vc-rv"></b><input class="vc-r" type="range" min="0.3" max="2" step="0.1" value="1" /></label>
      <label><span class="vc-ul">Speed</span>: <b class="vc-uv"></b><input class="vc-u" type="range" min="1" max="12" step="0.1" value="5" /></label>
    </div>
  </div>

  <div class="ax-card">
    <h2 class="vc-h">Towards the centre</h2>
    <dl class="ax-facts vc-facts"></dl>
    <canvas class="vc-g" aria-label="Tension around the circle" hidden></canvas>
    <div class="vc-eq"></div>
  </div>

  <div class="ax-card">
    <h2>Try this</h2>
    <ul class="vc-try">
      <li>Whirl the stone and press Let go. It flies off along the tangent, not outwards: no force was pushing it out.</li>
      <li>Double the speed. The pull you need goes up four times (v²). Double the radius at the same speed: it halves.</li>
      <li>In the vertical circle, find the least speed at the bottom that just makes it round. Check it against √(5gr).</li>
      <li>Go a little slower. The string goes slack above the side and the ball falls inside the circle.</li>
      <li>The string pulls hardest at the bottom, where it must hold the weight and turn the ball.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <div class="vc-quiz"></div>
  </div>
</div>

<script>
  import { whirl, at, loop, questions, G } from '../../lib/sci/vertical-circle';
  import { mountQuiz } from '../../lib/school-quiz-b';
  import { setupCanvas, arrow, text, f, fact, para, seg, keepDrawn } from '../../lib/school-n';

  const root = document.querySelector<HTMLElement>('.vc')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const inp = (c: string) => q<HTMLInputElement>(c);
  const val = (c: string) => Number(inp(c).value);
  const H = 300;
  let mode = 'h', raf = 0, last = 0;
  // state: horizontal angle; vertical θ from the bottom, ω, or a free flight
  let phi = 0, free: { x: number; y: number; vx: number; vy: number } | null = null, th = 0, om = 0, trail: [number, number][] = [];
  const P = () => ({ m: val('.vc-m'), r: val('.vc-r'), u: val('.vc-u') });

  function reset() {
    const p = P(); phi = 0; free = null; trail = []; th = 0; om = p.u / p.r; last = 0;
    q<HTMLButtonElement>('.vc-go').hidden = mode !== 'h';
  }

  function step(dt: number) {
    const p = P();
    if (free) { if (mode === 'v') free.vy -= G * dt; free.x += free.vx * dt; free.y += free.vy * dt; trail.push([free.x, free.y]); if (trail.length > 400) trail.shift(); return; }
    if (mode === 'h') { phi += (p.u / p.r) * dt; return; }
    // pendulum while taut: θ'' = −(g/r) sin θ, RK4
    const fdd = (t: number) => -(G / p.r) * Math.sin(t);
    const k1t = om, k1w = fdd(th), k2t = om + 0.5 * dt * k1w, k2w = fdd(th + 0.5 * dt * k1t), k3t = om + 0.5 * dt * k2w, k3w = fdd(th + 0.5 * dt * k2t), k4t = om + dt * k3w, k4w = fdd(th + dt * k3t);
    th += (dt / 6) * (k1t + 2 * k2t + 2 * k3t + k4t); om += (dt / 6) * (k1w + 2 * k2w + 2 * k3w + k4w);
    const T = p.m * om * om * p.r + p.m * G * Math.cos(th);
    if (T < 0) { // slack: fly freely from here (centre at the origin, bottom at (0, −r))
      const x = p.r * Math.sin(th), y = -p.r * Math.cos(th), v = om * p.r;
      free = { x, y, vx: v * Math.cos(th), vy: v * Math.sin(th) }; trail = [[x, y]];
    }
  }

  function scene() {
    const p = P(), c = q<HTMLCanvasElement>('.vc-c'), { ctx, w, pal } = setupCanvas(c, H), cx = w / 2, cy = H / 2, s = (H / 2 - 30) / 2; // 2 m fills the view
    const X = (x: number) => cx + x * s, Y = (y: number) => cy - y * s, R = p.r * s;
    ctx.strokeStyle = pal.line; ctx.setLineDash([4, 4]); ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = pal.ink; ctx.beginPath(); ctx.arc(cx, cy, 4, 0, Math.PI * 2); ctx.fill();
    const ballR = 6 + p.m * 4;
    if (free) {
      ctx.strokeStyle = pal.bad; ctx.lineWidth = 1.5; ctx.setLineDash([5, 4]); ctx.beginPath(); trail.forEach(([x, y], i) => (i ? ctx.lineTo(X(x), Y(y)) : ctx.moveTo(X(x), Y(y)))); ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle = pal.accent; ctx.beginPath(); ctx.arc(X(free.x), Y(free.y), ballR, 0, Math.PI * 2); ctx.fill();
      if (mode === 'h') text(ctx, 'flies off along the tangent', 8, H - 10, pal.bad, 'left', 12, 600);
      else text(ctx, 'string slack: the ball falls', 8, H - 10, pal.bad, 'left', 12, 600);
      return;
    }
    if (mode === 'h') {
      text(ctx, 'seen from above', 8, H - 10, pal.muted, 'left', 11);
      const bx = X(p.r * Math.cos(phi)), by = Y(p.r * Math.sin(phi));
      ctx.strokeStyle = pal.muted; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(bx, by); ctx.stroke();
      ctx.fillStyle = pal.accent; ctx.beginPath(); ctx.arc(bx, by, ballR, 0, Math.PI * 2); ctx.fill();
      const tl = 26 + p.u * 4; arrow(ctx, bx, by, -Math.sin(phi) * tl, -Math.cos(phi) * tl, pal.good, 'v');
      arrow(ctx, bx, by, (cx - bx) * 0.45, (cy - by) * 0.45, pal.bad, 'a');
    } else {
      const bx = X(p.r * Math.sin(th)), by = Y(-p.r * Math.cos(th)), T = p.m * om * om * p.r + p.m * G * Math.cos(th);
      ctx.strokeStyle = pal.muted; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(bx, by); ctx.stroke();
      ctx.fillStyle = pal.accent; ctx.beginPath(); ctx.arc(bx, by, ballR, 0, Math.PI * 2); ctx.fill();
      const k = 50 / Math.max(1, at(p.u, p.r, p.m, 0).T);
      arrow(ctx, bx, by, (cx - bx) / R * T * k, (cy - by) / R * T * k, pal.accent2, `T ${f(T, 1)} N`);
      arrow(ctx, bx, by, 0, p.m * G * k, pal.ink, 'mg', { width: 2 });
    }
  }

  function tGraph() {
    const p = P(), c = q<HTMLCanvasElement>('.vc-g'); if (c.hidden) return;
    const { ctx, w, pal } = setupCanvas(c, 150), L = 40, Rr = w - 10, T = 12, B = 122;
    const Ts = Array.from({ length: 181 }, (_, i) => at(p.u, p.r, p.m, i)), max = Math.max(...Ts.map((t) => Math.abs(t.T)), 1), min = Math.min(0, ...Ts.map((t) => t.T));
    const X = (d: number) => L + ((Rr - L) * d) / 180, Y = (t: number) => B - ((B - T) * (t - min)) / (max - min);
    ctx.strokeStyle = pal.grid; for (const d of [0, 45, 90, 135, 180]) { ctx.beginPath(); ctx.moveTo(X(d), T); ctx.lineTo(X(d), B); ctx.stroke(); text(ctx, `${d}°`, X(d), B + 13, pal.muted, 'center', 10); }
    ctx.strokeStyle = pal.ink; ctx.beginPath(); ctx.moveTo(L, Y(0)); ctx.lineTo(Rr, Y(0)); ctx.stroke();
    text(ctx, f(max, 0), L - 4, Y(max) + 4, pal.muted, 'right', 10); text(ctx, '0', L - 4, Y(0) + 4, pal.muted, 'right', 10);
    ctx.lineWidth = 2.5; let prevOk = true;
    for (let i = 1; i <= 180; i++) {
      const a = Ts[i - 1], b = Ts[i], ok = a.T >= 0 && a.v2 >= 0 && prevOk; ctx.strokeStyle = ok ? pal.accent2 : pal.bad;
      ctx.beginPath(); ctx.moveTo(X(i - 1), Y(a.T)); ctx.lineTo(X(i), Y(b.T)); ctx.stroke(); if (!ok) prevOk = false;
    }
    text(ctx, 'tension (N) from bottom to top', L, T - 2, pal.muted, 'left', 10);
  }

  function info() {
    const p = P(), pill = q('.vc-pill'), eq: HTMLElement[] = [];
    q('.vc-mv').textContent = `${f(p.m, 1)} kg`; q('.vc-rv').textContent = `${f(p.r, 1)} m`; q('.vc-uv').textContent = `${f(p.u, 1)} m/s`;
    q('.vc-ul').textContent = mode === 'h' ? 'Speed' : 'Speed at the bottom';
    q('.vc-g').hidden = mode === 'h';
    if (mode === 'h') {
      const r = whirl(p.m, p.r, p.u);
      q('.vc-h').textContent = 'Towards the centre';
      pill.textContent = free ? 'Let go: no force now, so it moves in a straight line' : `The string pulls with ${f(r.F, 2)} N towards the centre`; pill.className = 'ax-pill good vc-pill';
      q('.vc-facts').replaceChildren(fact('Centripetal acceleration', `${f(r.a, 2)} m/s²`, 'v² ÷ r'), fact('Pull of the string', `${f(r.F, 2)} N`, 'm v² ÷ r'), fact('Angular speed ω', `${f(r.omega, 2)} rad/s`, `${f(r.rpm, 1)} turns a minute`), fact('Time for one turn', `${f(r.T, 3)} s`));
      eq.push(para([['Acceleration: '], `a = v² ÷ r = ${f(p.u, 1)}² ÷ ${f(p.r, 1)} = ${f(r.a, 2)} m/s², also ω²r = ${f(r.omega, 2)}² × ${f(p.r, 1)}.`]));
      eq.push(para([['Force: '], `F = m a = ${f(p.m, 1)} × ${f(r.a, 2)} = ${f(r.F, 2)} N, always towards the centre. The speed stays the same, but the direction keeps changing, and a change of direction is an acceleration.`]));
    } else {
      const l = loop(p.u, p.r, p.m), bot = at(p.u, p.r, p.m, 0), side = at(p.u, p.r, p.m, 90);
      q('.vc-h').textContent = 'Around the vertical circle';
      pill.textContent = l.kind === 'loops' ? 'It goes all the way round' : l.kind === 'slack' ? `The string goes slack ${f(l.slack, 1)}° up from the bottom` : `It swings up to ${f(l.slack, 1)}° and back`;
      pill.className = `ax-pill ${l.kind === 'loops' ? 'good' : 'warn'} vc-pill`;
      q('.vc-facts').replaceChildren(
        fact('Least speed at the bottom to loop', `${f(l.uMin, 2)} m/s`, '√(5gr)'),
        fact('Tension at the bottom', `${f(bot.T, 2)} N`, 'mg + mv²/r'),
        fact('Speed at the side', side.v2 >= 0 ? `${f(side.v, 2)} m/s` : 'does not get there'),
        fact('Speed at the top', l.kind === 'loops' ? `${f(l.vTop, 2)} m/s` : '–', l.kind === 'loops' ? `least possible √(gr) = ${f(Math.sqrt(G * p.r), 2)}` : 'does not get there'),
        fact('Tension at the top', l.kind === 'loops' ? `${f(l.Ttop, 2)} N` : '–', 'mv²/r − mg'),
      );
      eq.push(para([['Energy: '], `rising a height h, v² = u² − 2gh. At the top h = 2r, so v_top² = ${f(p.u, 1)}² − 4 × 9.8 × ${f(p.r, 1)} = ${f(p.u * p.u - 4 * G * p.r, 2)} m²/s².`]));
      eq.push(para([['Tension: '], 'T = mv²/r + mg cos θ (θ from the bottom). At the top T = mv²/r − mg, which must not drop below zero, so v_top ≥ √(gr) and u ≥ √(5gr).']));
      if (l.kind === 'slack') eq.push(para([['Slack: '], `T reaches zero where cos θ = (2gr − u²) ÷ 3gr, θ = ${f(l.slack, 1)}°. From there the ball moves as a projectile and falls inside the circle.`]));
    }
    q('.vc-eq').replaceChildren(...eq);
  }

  function frame(now: number) {
    const dt = last ? Math.min(0.05, (now - last) / 1000) : 0; last = now;
    const p = P(), slow = mode === 'h' ? Math.min(1, 3 / Math.max(0.5, p.u / p.r)) : 0.6; // keep it watchable
    const n = 20; for (let i = 0; i < n; i++) step((dt * slow) / n);
    if (free && Math.hypot(free.x, free.y) > 3.2) { reset(); info(); }
    scene(); raf = requestAnimationFrame(frame);
  }

  q('.vc-go').addEventListener('click', () => { if (free || mode !== 'h') return; const p = P(); free = { x: p.r * Math.cos(phi), y: p.r * Math.sin(phi), vx: -Math.sin(phi) * p.u, vy: Math.cos(phi) * p.u }; trail = [[free.x, free.y]]; info(); });
  q('.vc-reset').addEventListener('click', () => { reset(); info(); });
  seg(q('.vc-mode'), (v) => { mode = v; inp('.vc-u').value = v === 'h' ? '5' : '8'; reset(); info(); tGraph(); });
  root.querySelectorAll('.vc-ctl input').forEach((i) => i.addEventListener('input', () => { reset(); info(); tGraph(); }));
  mountQuiz(q('.vc-quiz'), () => questions());
  reset(); info(); tGraph();
  raf = requestAnimationFrame(frame);
  keepDrawn(q('.vc-c'), () => { scene(); tGraph(); });
</script>

<style is:inline>
  .vc .vc-top { margin-bottom: 10px; }
  .vc .ax-seg button { min-height: 44px; }
  .vc canvas { display: block; width: 100%; }
  .vc .vc-g { margin-top: 12px; }
  .vc .vc-g[hidden], .vc .vc-go[hidden] { display: none; }
  .vc .vc-state { margin: 8px 0; }
  .vc .vc-pill { font-size: 14px; white-space: normal; }
  .vc .vc-ctl { display: grid; gap: 10px; margin-top: 12px; }
  .vc input[type=range] { width: 100%; height: 32px; accent-color: var(--ink); }
  .vc label b { color: var(--ink); }
  .vc .btn.small { min-height: 44px; }
  .vc .vc-eq p { margin: 8px 0 0; font-size: 15px; overflow-wrap: anywhere; }
  .vc .vc-try { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .sq-list { margin: 0 0 12px; padding-left: 22px; display: grid; gap: 14px; }
  .sq-text { margin: 0 0 6px; }
  .sq-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .ax .sq-row .sq-in { width: 7.5em; min-height: 44px; }
  .sq-row .btn { min-height: 44px; }
  .sq-unit { color: var(--muted); }
  .sq-res { margin: 6px 0 0; font-weight: 650; }
  .sq-res[data-ok="1"] { color: var(--good); }
  .sq-res[data-ok="0"] { color: var(--bad); }
  .sq-work { margin: 6px 0 0; padding: 8px 10px; border-left: 3px solid var(--line); color: var(--ink); font-size: 15px; }
</style>
