---
// Reference interval from local data: CLSI nonparametric and parametric (raw, log, Box-Cox) limits with CIs,
// outlier screens and Harris-Boyd partitioning.
import DataFile from '../../components/DataFile.astro';
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax ri">
  <div class="ax-card">
    <p class="ri-med">For study and teaching, not medical advice. Check with a qualified professional.</p>
    <h2>Results from healthy reference people</h2>
