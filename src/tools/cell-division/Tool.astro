  .cdv .cdv-note { margin: 0; }
  .cdv .cdv-lab { font-size: 14px; color: var(--muted); min-width: 64px; }
  .cdv .cdv-gap { margin-top: 12px; }
  .cdv .ax-seg { flex-wrap: wrap; }
  .cdv .ax-seg button { min-height: 44px; padding: 8px 12px; }
  .cdv input[type=checkbox] { width: 22px; height: 22px; }
  .cdv .ax-check { min-height: 44px; align-items: center; }
  .cdv .btn.small { min-height: 44px; }
  .cdv .cdv-strip { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .cdv .cdv-strip button { min-height: 44px; min-width: 52px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }
  .cdv .cdv-strip button[aria-pressed=true] { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 600; }
  .cdv .cdv-say { margin: 6px 0 12px; }
  .cdv .cdv-tab tr.on td { font-weight: 700; background: var(--accent-soft); }
  .cdv .cdv-try { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .cdv .cdv-qs { padding-left: 20px; display: grid; gap: 14px; margin: 10px 0; }
  .cdv .cdv-qs p { margin: 0 0 6px; }
  .cdv .cdv-qs select, .cdv .cdv-qs input { max-width: 240px; min-height: 44px; }
  .cdv .cdv-worked.ok { color: var(--good); }
  .cdv .cdv-worked.no { color: var(--bad); }
  .cdv .cdv-score { font-weight: 700; }
  .cdv [hidden] { display: none !important; }
</style>
