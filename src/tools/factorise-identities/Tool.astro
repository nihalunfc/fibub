---
// Factorise with identities: type a polynomial in x (or pick an example) and get it factorised step by step:
// common factor, then a² − b², (a ± b)², a³ ± b³, (a + b)³, the middle-term split or the factor theorem. The
// answer is drawn as an area model when it is two brackets, and checked by multiplying back and putting in a
// number. Nothing is stored or sent.
import '../../styles/astro.css';
import '../../styles/smath.css';
const EX = ['4x² − 9', 'x² + 6x + 9', 'x² + 5x + 6', '6x² + 5x − 6', '2x² − 18', '8x³ − 27', 'x³ + 6x² + 12x + 8', 'x³ − 6x² + 11x − 6', 'x⁴ − 16'];
---
<div class="ax sm fz">
  <div class="ax-card">
    <h2>Your expression</h2>
    <label>Polynomial in x (whole numbers, up to x⁴)
      <input type="text" class="fz-in" value="6x² + 5x − 6" autocomplete="off" spellcheck="false" aria-label="Polynomial to factorise" />
    </label>
    <p class="ax-help">Type powers as x^2 or x², for example 9x^2 - 25.</p>
    <div class="fz-ex">{EX.map((e) => <button type="button" class="btn secondary small fz-chip" data-e={e}>{e}</button>)}</div>
    <div class="ax-row" style="margin-top:8px"><span class="ax-help" style="margin:0">Random</span>
      <div class="ax-seg fz-rand" role="group" aria-label="Make a random example">
        <button type="button" data-k="sq">a² − b²</button><button type="button" data-k="ps">(a ± b)²</button><button type="button" data-k="split">Split</button><button type="button" data-k="cube">a³ ± b³</button><button type="button" data-k="ft">Factor theorem</button>
      </div>
    </div>
    <p class="ax-err fz-err" hidden></p>
  </div>

  <div class="ax-card">
    <h2>Step by step</h2>
    <ol class="sm-steps fz-steps"></ol>
    <p class="ax-big fz-big" aria-live="polite"></p>
    <svg class="sm-fig fz-fig" viewBox="0 0 340 230" role="img" aria-label="Area model of the two brackets" hidden></svg>
    <p class="sm-f fz-check"></p>
  </div>

  <div class="ax-card">
    <h2>The identities</h2>
    <ul class="sm-try">
      <li>a² − b² = (a + b)(a − b)</li>
      <li>(a + b)² = a² + 2ab + b² and (a − b)² = a² − 2ab + b²</li>
      <li>x² + (p + q)x + pq = (x + p)(x + q)</li>
      <li>a³ + b³ = (a + b)(a² − ab + b²) and a³ − b³ = (a − b)(a² + ab + b²)</li>
      <li>(a + b)³ = a³ + 3a²b + 3ab² + b³</li>
    </ul>
    <h3 style="margin:12px 0 4px">Try this</h3>
    <ul class="sm-try">
      <li>Factorise 2x² − 18. Why is it easier after taking out the 2?</li>
      <li>Change 4x² − 9 to 4x² + 9. Why does it no longer factorise?</li>
      <li>Use a² − b² to work out 53² − 47² in your head.</li>
    </ul>
  </div>

  <div class="ax-card">
    <h2>Check yourself</h2>
    <p class="ax-help">Fresh questions every time. Where two numbers are asked for, type them with a comma. Nothing is saved.</p>
    <div class="fz-quiz"></div>
  </div>
</div>

<style is:inline>
  .fz .fz-ex { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .fz .fz-chip { font-variant-numeric: tabular-nums; }
  .fz .fz-in { font-size: 18px; }
  .fz svg .fz-c0 { fill: var(--accent-soft); stroke: var(--accent); } .fz svg .fz-c1 { fill: var(--good-soft); stroke: var(--good); }
  .fz svg .fz-c2 { fill: var(--warn-soft); stroke: var(--warn); } .fz svg .fz-c3 { fill: var(--bad-soft); stroke: var(--bad); }
  .fz svg rect { stroke-width: 1.5; }
</style>

<script>
  import { parse, show, factorise, resultText, expand, same, evalAt, mul, degree, type Poly } from '../../lib/sci/factor-school';
  import { fmt, randInt } from '../../lib/sci/smath';
  import { S, quiz, type Question } from '../../lib/smath-ui';

  const root = document.querySelector<HTMLElement>('.fz')!;
  const q = <T extends Element = HTMLElement>(c: string) => root.querySelector(c) as unknown as T;
  const inp = q<HTMLInputElement>('.fz-in'), fig = q<SVGSVGElement>('.fz-fig');
  const li = (t: string) => Object.assign(document.createElement('li'), { textContent: t });

  function area(f1: Poly, f2: Poly) {
    // Rectangle (a x + b) by (c x + d): four parts. Lengths drawn with x = 3 so the x parts look longer.
    fig.replaceChildren(); fig.removeAttribute('hidden');
    const [b, a] = f1, [d, c] = f2, X = 3, w1 = Math.abs(a) * X, w2 = Math.abs(b), h1 = Math.abs(c) * X, h2 = Math.abs(d);
    const k = Math.min(240 / (w1 + w2 || 1), 160 / (h1 + h2 || 1)), ox = 70, oy = 30;
    const cell = (x: number, y: number, w: number, h: number, cls: string, t: string) => { if (w <= 0 || h <= 0) return; S('rect', { x: ox + x * k, y: oy + y * k, width: w * k, height: h * k, class: cls }, fig); S('text', { x: ox + (x + w / 2) * k, y: oy + (y + h / 2) * k + 5, 'text-anchor': 'middle', style: 'font-weight:700' }, fig, t); };
    const term = (m: number, e: number) => `${m < 0 ? '−' : ''}${Math.abs(m) === 1 && e ? '' : Math.abs(m)}${e === 2 ? 'x²' : e === 1 ? 'x' : ''}`;
    cell(0, 0, w1, h1, 'fz-c0', term(a * c, 2)); cell(w1, 0, w2, h1, 'fz-c1', term(b * c, 1)); cell(0, h1, w1, h2, 'fz-c2', term(a * d, 1)); cell(w1, h1, w2, h2, 'fz-c3', term(b * d, 0));
    S('text', { x: ox + ((w1 + w2) / 2) * k, y: oy - 10, 'text-anchor': 'middle' }, fig, show(f1));
    S('text', { x: ox - 8, y: oy + ((h1 + h2) / 2) * k + 5, 'text-anchor': 'end' }, fig, show(f2));
    S('text', { x: 170, y: 222, 'text-anchor': 'middle', class: 'sm-tick' }, fig, 'Area model (not to scale for minus signs)');
  }

  function run() {
    const p = parse(inp.value), err = q('.fz-err');
    if (!p) {
      err.hidden = false; err.textContent = 'Type a polynomial in x with whole-number coefficients, up to x⁴, such as 9x^2 - 25.';
      q('.fz-steps').replaceChildren(); q('.fz-big').textContent = ''; q('.fz-check').textContent = ''; fig.setAttribute('hidden', ''); return;
    }
    err.hidden = true;
    const r = factorise(p), txt = resultText(r);
    q('.fz-steps').replaceChildren(...r.steps.map(li));
    const nothing = r.factors.length <= 1 && r.k === 1 && !r.xPow;
    q('.fz-big').textContent = nothing ? `${show(p)} does not factorise with whole numbers` : `${show(p)} = ${txt}`;
    const back = expand(r), x = 2;
    q('.fz-check').textContent = `Check: multiplying the brackets back gives ${show(back)}${same(back, p) ? ' ✓' : ' ✗'}. Put x = ${x}: ${show(p)} = ${fmt(evalAt(p, x), 4)}, and the factorised form also gives ${fmt(evalAt(back, x), 4)}.`;
    const lin = r.factors.filter((f) => degree(f) === 1);
    if (r.factors.length === 2 && lin.length === 2 && !r.xPow && r.k === 1) area(lin[0], lin[1]); else fig.setAttribute('hidden', '');
  }
  inp.addEventListener('input', run);
  root.querySelectorAll<HTMLButtonElement>('.fz-chip').forEach((b) => b.addEventListener('click', () => { inp.value = b.dataset.e!; run(); }));
  const nz = (lo: number, hi: number) => randInt(lo, hi, true);
  root.querySelectorAll<HTMLButtonElement>('.fz-rand button').forEach((b) => b.addEventListener('click', () => {
    let p: Poly;
    const k = b.dataset.k;
    if (k === 'sq') { const a = randInt(1, 6), c = randInt(1, 9); p = [-c * c, 0, a * a]; }
    else if (k === 'ps') { const a = randInt(1, 5), c = nz(-7, 7); p = mul([c, a], [c, a]); }
    else if (k === 'split') { p = mul([nz(-7, 7), randInt(1, 3)], [nz(-7, 7), 1]); }
    else if (k === 'cube') { const a = randInt(1, 3), c = nz(-5, 5); p = [c ** 3, 0, 0, a ** 3]; }
    else { p = mul(mul([nz(-4, 4), 1], [nz(-4, 4), 1]), [nz(-4, 4), 1]); }
    inp.value = show(p); run();
  }));
  run();

  quiz(q('.fz-quiz'), () => {
    const out: Question[] = [];
    const p = randInt(1, 8), r = randInt(1, 8);
    out.push({ q: `x² + ${p + r}x + ${p * r} = (x + m)(x + n). Find m and n.`, want: [p, r], hint: 'two numbers, like 2, 5', work: `Two numbers that multiply to ${p * r} and add to ${p + r}: ${p} and ${r}. So x² + ${p + r}x + ${p * r} = (x + ${p})(x + ${r}).` });
    const big = randInt(2, 9) * 10 + randInt(1, 9) * (Math.random() < 0.5 ? 1 : 0), e = randInt(2, 9);
    out.push({ q: `Use a² − b² = (a + b)(a − b) to work out ${big + e}² − ${big - e}².`, want: [(2 * big) * (2 * e)], work: `(${big + e} + ${big - e})(${big + e} − ${big - e}) = ${2 * big} × ${2 * e} = ${4 * big * e}.` });
    const h = randInt(1, 9) * 100, s = randInt(1, 9);
    out.push({ q: `Use (a + b)² = a² + 2ab + b² to work out ${h + s}².`, want: [(h + s) ** 2], work: `(${h} + ${s})² = ${h * h} + 2 × ${h} × ${s} + ${s * s} = ${(h + s) ** 2}.` });
    const a = randInt(2, 9), b = randInt(1, a - 1);
    out.push({ q: `If a + b = ${a + b} and ab = ${a * b}, find a² + b².`, want: [a * a + b * b], work: `(a + b)² = a² + 2ab + b², so a² + b² = ${a + b}² − 2 × ${a * b} = ${(a + b) ** 2} − ${2 * a * b} = ${a * a + b * b}.` });
    return out;
  });
</script>
