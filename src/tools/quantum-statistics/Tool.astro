---
// Maxwell-Boltzmann, Fermi-Dirac and Bose-Einstein distributions with a chemical potential, plus the ideal 3D
// quantum gas (μ from density, Fermi energy, condensation). Example values made up or rounded. All in the browser.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax qst">
  <div class="ax-card">
    <h2>Distributions</h2>
    <div class="ax-grid">
      <label>Energy unit <select class="qs-u"><option value="1" selected>eV</option><option value="0.001">meV</option></select></label>
      <label>Temperature (K) <input class="qs-T" type="text" inputmode="decimal" value="300" /></label>
      <label>Chemical potential μ <input class="qs-mu" type="text" inputmode="decimal" value="0" /></label>
      <label>Energy from <input class="qs-e0" type="text" inputmode="decimal" value="-0.15" /></label>
      <label>Energy to <input class="qs-e1" type="text" inputmode="decimal" value="0.25" /></label>
      <label>Read off at energy E <input class="qs-E" type="text" inputmode="decimal" value="0.05" /></label>
    </div>
    <div class="ax-row" style="margin-top:10px">
      <label class="ax-check"><input type="checkbox" class="qs-smb" checked /> Maxwell-Boltzmann</label>
      <label class="ax-check"><input type="checkbox" class="qs-sfd" checked /> Fermi-Dirac</label>
      <label class="ax-check"><input type="checkbox" class="qs-sbe" checked /> Bose-Einstein</label>
    </div>
    <p class="ax-help">Mean number of particles in one quantum state of energy E. Fermions (electrons, ³He) never exceed 1; bosons (photons, ⁴He, ⁸⁷Rb) pile up just above μ and are only defined for E &gt; μ. The example values are made up.</p>
    <p class="ax-err qs-err" hidden></p>
  </div>

  <div class="ax-card qs-out">
    <p class="ax-big qs-big"></p>
    <dl class="ax-facts qs-facts"></dl>
    <canvas class="ax-fig qs-f1"></canvas>
    <canvas class="ax-fig qs-f2"></canvas>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small qs-csv">Occupancies (CSV)</button></div>
  </div>

  <div class="ax-card">
    <h2>Ideal quantum gas</h2>
    <div class="ax-grid">
      <label>Particles <select class="qs-p"><option value="e" selected>Electrons (fermions, g 2)</option><option value="he3">Helium-3 atoms (fermions, g 2)</option><option value="he4">Helium-4 atoms (bosons, g 1)</option><option value="rb87">Rubidium-87 atoms (bosons, g 1)</option><option value="custom">Other</option></select></label>
      <label>Statistics <select class="qs-st"><option value="fd" selected>Fermi-Dirac (fermions)</option><option value="be">Bose-Einstein (bosons)</option><option value="mb">Maxwell-Boltzmann (classical)</option></select></label>
      <label>Mass (u) <input class="qs-m" type="text" inputmode="decimal" value="0.000548579909" /></label>
      <label>Spin degeneracy g <input class="qs-g" type="text" inputmode="decimal" value="2" /></label>
      <label>Number density (per m³) <input class="qs-n" type="text" inputmode="decimal" value="8.5e28" /></label>
      <label>Temperature (K) <input class="qs-gT" type="text" inputmode="decimal" value="300" /></label>
    </div>
    <p class="ax-help">An ideal (non-interacting) gas in a box. The example is the conduction electrons of a metal like copper (about 8.5 × 10²⁸ per m³, a rounded value). For a cold atom cloud try rubidium-87 at 10²⁰ per m³ and 200 nK (type 2e-7). Masses are in unified atomic mass units (u).</p>
    <p class="ax-err qs-gerr" hidden></p>
  </div>

  <div class="ax-card qs-gout">
    <p class="ax-big qs-gbig"></p>
    <dl class="ax-facts qs-gfacts"></dl>
    <canvas class="ax-fig qs-f3"></canvas>
    <p class="ax-help">The classical curve is drawn for comparison only when the gas is not degenerate (nλ³/g below 1). The chemical potential μ is found from the density by inverting the Fermi-Dirac or Bose-Einstein integral. Real metals and atom clouds add interactions, band structure and traps that this ideal gas leaves out.</p>
    <Downloads />
  </div>
</div>

<script>
  import { occupancy, idealGas, spectrum, STAT_NAMES, KB, QE, AMU, ZETA32, type Stat } from '../../lib/sci/phqstat';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, wireDownloads, save, type Figure, type Section } from '../../lib/report';
  import { num, sig, csv } from '../../lib/sci/num';

  const root = document.querySelector<HTMLElement>('.qst')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const inp = (c: string) => q<HTMLInputElement>(c);
  const val = (c: string) => num(inp(c).value);
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; d.querySelector('dd')!.append(e); } return d; };
  const rowsOf = (els: HTMLElement[]) => els.map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]);
  let figs: (Figure | null)[] = [null, null, null], dist: Section[] = [], gas: Section[] = [], csvRows: (string | number)[][] = [];
  const STATS: Stat[] = ['mb', 'fd', 'be'];

  function calcDist() {
    const err = q('.qs-err'), out = q('.qs-out');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; dist = []; };
    const U = +sel('.qs-u'), un = U === 1 ? 'eV' : 'meV', T = val('.qs-T'), mu = val('.qs-mu'), e0 = val('.qs-e0'), e1 = val('.qs-e1'), E = val('.qs-E');
    const on = STATS.filter((s) => inp(`.qs-s${s}`).checked);
    if (!(T > 0)) return fail('Give a temperature above 0 K.');
    if (!Number.isFinite(mu)) return fail('Give the chemical potential μ (it may be negative).');
    if (!(Number.isFinite(e0) && e1 > e0)) return fail('Give an energy range with the second value larger.');
    if (!Number.isFinite(E)) return fail('Give an energy to read the occupancies at.');
    if (!on.length) return fail('Tick at least one distribution.');
    err.hidden = true; out.hidden = false;
    const kT = (KB * T) / QE / U, x = (E - mu) / kT;
    q('.qs-big').textContent = `kT = ${sig(kT, 4)} ${un}; at E − μ = ${+(E - mu).toPrecision(4)} ${un} (${sig(x, 4)} kT)`;
    const f = [fact('Thermal energy kT', `${sig(kT, 4)} ${un}`, `at ${sig(T, 4)} K`), ...STATS.filter((s) => on.includes(s)).map((s) => { const v = occupancy(s, x); return fact(STAT_NAMES[s], Number.isNaN(v) ? 'undefined' : sig(v, 4), s === 'be' && Number.isNaN(v) ? 'Bose-Einstein needs E > μ' : s === 'mb' ? 'e^(−(E−μ)/kT)' : s === 'fd' ? '1/(e^((E−μ)/kT) + 1)' : '1/(e^((E−μ)/kT) − 1)'); })];
    q('.qs-facts').replaceChildren(...f);
    const Es: number[] = []; for (let i = 0; i <= 400; i++) Es.push(e0 + ((e1 - e0) * i) / 400);
    const ymax = 2.2;
    const ser = on.map((s) => { const xs: number[] = [], ys: number[] = []; for (const e of Es) { const v = occupancy(s, (e - mu) / kT); if (Number.isFinite(v) && v <= ymax * 1.5) { xs.push(e); ys.push(Math.min(v, ymax * 1.5)); } } return { name: STAT_NAMES[s], x: xs, y: ys, mode: 'line' as const, width: 2, dash: s === 'mb' ? [6, 3] : undefined }; });
    const c1 = chartFigure({ w: 380, h: 240, xLabel: `Energy E (${un})`, yLabel: 'Mean occupation per state', yMin: 0, yMax: ymax, xMin: e0, xMax: e1, legend: 'below', series: ser, marks: [{ kind: 'vline', at: mu, dash: [3, 3], label: 'μ' }, { kind: 'hline', at: 1, dash: [2, 4] }] }, `Occupation against energy at ${sig(T, 4)} K, μ = ${sig(mu, 4)} ${un}`);
    const xs: number[] = []; for (let i = 0; i <= 300; i++) xs.push(-5 + (10 * i) / 300);
    const c2 = chartFigure({ w: 380, h: 220, xLabel: '(E − μ) / kT', yLabel: 'Occupation', yMin: 0, yMax: ymax, legend: 'below', series: STATS.map((s) => ({ name: STAT_NAMES[s], x: xs.filter((v) => s !== 'be' || v > 0.3), y: xs.filter((v) => s !== 'be' || v > 0.3).map((v) => occupancy(s, v)), mode: 'line' as const, width: 1.8, dash: s === 'mb' ? [6, 3] : undefined })) }, 'The three distributions in units of kT (they agree when E − μ is many kT)');
    figs[0] = c1; figs[1] = c2;
    csvRows = [[`E (${un})`, 'x = (E-mu)/kT', 'Maxwell-Boltzmann', 'Fermi-Dirac', 'Bose-Einstein'], ...Es.map((e) => { const xx = (e - mu) / kT; return [+e.toPrecision(8), +xx.toPrecision(8), ...STATS.map((s) => { const v = occupancy(s, xx); return Number.isFinite(v) ? +v.toPrecision(8) : ''; })]; })];
    dist = [{ title: q('.qs-big').textContent!, facts: rowsOf(f), figure: c1 }, { title: 'In units of kT', figure: c2 }];
    paintAll();
  }

  const PRESET: Record<string, { m: number; g: number; st: Stat }> = { e: { m: 0.000548579909, g: 2, st: 'fd' }, he3: { m: 3.016029, g: 2, st: 'fd' }, he4: { m: 4.002602, g: 1, st: 'be' }, rb87: { m: 86.909181, g: 1, st: 'be' } };
  q('.qs-p').addEventListener('change', () => { const p = PRESET[sel('.qs-p')]; if (!p) return; inp('.qs-m').value = String(p.m); inp('.qs-g').value = String(p.g); q<HTMLSelectElement>('.qs-st').value = p.st; });
  for (const c of ['.qs-m', '.qs-g']) inp(c).addEventListener('input', () => { q<HTMLSelectElement>('.qs-p').value = 'custom'; });

  function E(j: number) { const ev = j / QE; const a = Math.abs(ev); return a >= 0.1 ? `${sig(ev, 4)} eV` : a >= 1e-4 ? `${sig(ev * 1000, 4)} meV` : `${sig(j / KB, 4)} K × kB`; }
  function T_(k: number) { return k >= 1 ? `${sig(k, 4)} K` : k >= 1e-3 ? `${sig(k * 1000, 4)} mK` : k >= 1e-6 ? `${sig(k * 1e6, 4)} µK` : `${sig(k * 1e9, 4)} nK`; }
  function calcGas() {
    const err = q('.qs-gerr'), out = q('.qs-gout');
    const fail = (m: string) => { err.textContent = m; err.hidden = false; out.hidden = true; gas = []; };
    const st = sel('.qs-st') as Stat, mu_ = val('.qs-m'), g = val('.qs-g'), n = val('.qs-n'), T = val('.qs-gT');
    if (!(mu_ > 0)) return fail('Give the particle mass in u (greater than 0).');
    if (!(g >= 1 && Number.isInteger(g))) return fail('The spin degeneracy g is a whole number: 2 for spin ½, 1 for spin 0.');
    if (!(n > 0 && n < 1e40)) return fail('Give the number density per m³, for example 8.5e28.');
    if (!(T > 0)) return fail('Give a temperature above 0 K.');
    err.hidden = true; out.hidden = false;
    const m = mu_ * AMU, r = idealGas(st, m, g, n, T), kT = KB * T, cl = idealGas('mb', m, g, n, T);
    const regime = r.degeneracy < 0.01 ? 'classical: quantum effects are tiny' : r.degeneracy < 1 ? 'weakly quantum' : 'strongly quantum (degenerate)';
    q('.qs-gbig').textContent = r.condensate > 0 ? `μ = 0: ${sig(r.condensate * 100, 3)} % of the atoms are in the condensate` : `μ = ${E(r.mu)} (${sig(r.eta, 4)} kT)`;
    const f = [
      fact('Thermal wavelength λ', `${sig(r.lambda * 1e9, 4)} nm`, `h / √(2π m kT); mean spacing n^(−1/3) = ${sig(Math.cbrt(1 / n) * 1e9, 4)} nm`),
      fact('Degeneracy nλ³/g', sig(r.degeneracy, 4), regime),
      fact('Mean energy per particle', E(r.meanE), `${sig(r.meanE / kT, 4)} kT; a classical gas has 1.5 kT`),
      fact('Pressure', `${sig(r.pressure, 4)} Pa`, `classical nkT = ${sig(n * kT, 4)} Pa`),
    ];
    if (r.EF !== undefined) f.push(fact('Fermi energy EF', E(r.EF), `Fermi temperature ${T_(r.TF!)}; T/TF = ${sig(T / r.TF!, 3)}`));
    if (r.Tc !== undefined) f.push(fact('Condensation temperature Tc', T_(r.Tc), r.condensate > 0 ? `below Tc: condensate fraction 1 − (T/Tc)^1.5` : `nλ³/g must reach ζ(3/2) = ${ZETA32.toFixed(3)}`));
    if (st !== 'mb') f.push(fact('Classical chemical potential', E(cl.mu), 'what Maxwell-Boltzmann statistics would give'));
    q('.qs-gfacts').replaceChildren(...f);
    // Particles per unit energy.
    const top = Math.max(r.EF ?? 0, 0) + 12 * kT, Es: number[] = []; for (let i = 1; i <= 300; i++) Es.push((top * i) / 300);
    const scale = QE; // per eV
    const ser = [{ name: STAT_NAMES[st], x: Es.map((e) => e / QE), y: Es.map((e) => spectrum(st, m, g, r.mu, T, e) * scale), mode: 'line' as const, width: 2 }];
    if (st !== 'mb' && r.degeneracy < 1) ser.push({ name: 'Maxwell-Boltzmann (same n)', x: Es.map((e) => e / QE), y: Es.map((e) => spectrum('mb', m, g, cl.mu, T, e) * scale), mode: 'line' as const, width: 1.4 });
    const c3 = chartFigure({ w: 380, h: 240, xLabel: 'Energy (eV)', yLabel: 'Number per eV per m³', xMin: 0, yMin: 0, legend: 'below', series: ser, marks: r.EF !== undefined ? [{ kind: 'vline', at: r.EF / QE, dash: [3, 3], label: 'EF' }] : [] }, `Energy spectrum of the gas at ${T_(T)}${r.condensate > 0 ? ' (the condensate at E = 0 is not drawn)' : ''}`);
    figs[2] = c3; paintAll();
    gas = [{ title: q('.qs-gbig').textContent!, text: [`${q<HTMLSelectElement>('.qs-p').selectedOptions[0].textContent}, ${STAT_NAMES[st]}, n = ${inp('.qs-n').value} per m³, T = ${T_(T)}`], facts: rowsOf(f), figure: c3, note: 'Ideal 3D gas; CODATA constants. For study and planning.' }];
  }
  function paintAll() { (['.qs-f1', '.qs-f2', '.qs-f3'] as const).forEach((c, i) => { const f = figs[i]; if (f) paint(q<HTMLCanvasElement>(c), f); }); }

  root.querySelectorAll('.qs-u, .qs-T, .qs-mu, .qs-e0, .qs-e1, .qs-E, .qs-smb, .qs-sfd, .qs-sbe').forEach((i) => { i.addEventListener('input', calcDist); i.addEventListener('change', calcDist); });
  root.querySelectorAll('.qs-p, .qs-st, .qs-m, .qs-g, .qs-n, .qs-gT').forEach((i) => { i.addEventListener('input', calcGas); i.addEventListener('change', calcGas); });
  q('.qs-csv').addEventListener('click', () => { if (csvRows.length > 1) save(new Blob([csv(csvRows)], { type: 'text/csv' }), 'quantum-statistics.csv', 'text/csv'); });
  document.addEventListener('fibub:theme', paintAll);
  calcDist(); calcGas();
  wireDownloads(q('.dl'), () => ({ title: 'Quantum statistics', subtitle: `${inp('.qs-T').value} K`, file: 'quantum-statistics', sections: [...dist, ...gas] }));
</script>

<style is:inline>
  .qst select, .qst input { max-width: 100%; }
</style>
