---
// #T962 Instrument tuner: listens through the microphone, finds the pitch (YIN) and shows the note and how many cents off.
// Pitch maths in src/lib/audio/pitch.ts (checks in tests/audio.mjs). The sound is analysed on the device and never recorded or sent.
const PRESETS: Record<string, { name: string; notes: string[] }> = {
  chromatic: { name: 'Any note (chromatic)', notes: [] },
  guitar: { name: 'Guitar (E A D G B E)', notes: ['E2', 'A2', 'D3', 'G3', 'B3', 'E4'] },
  bass: { name: 'Bass guitar (E A D G)', notes: ['E1', 'A1', 'D2', 'G2'] },
  ukulele: { name: 'Ukulele (G C E A)', notes: ['G4', 'C4', 'E4', 'A4'] },
  violin: { name: 'Violin (G D A E)', notes: ['G3', 'D4', 'A4', 'E5'] },
  cello: { name: 'Cello and viola (C G D A)', notes: ['C2', 'G2', 'D3', 'A3'] },
};
---
<div class="tool-ui it" data-presets={JSON.stringify(PRESETS)}>
  <p class="note bad it-none" hidden>This browser cannot listen to a microphone. Try a recent Chrome, Edge, Firefox or Safari.</p>
  <section class="panel">
    <div class="it-note"><span class="it-name">–</span><sub class="it-oct"></sub></div>
    <div class="it-meter" aria-hidden="true"><span class="it-mid"></span><span class="it-needle"></span></div>
    <div class="it-scale" aria-hidden="true"><span>−50</span><span>0</span><span>+50</span></div>
    <p class="it-read" aria-live="polite">Press Start and play one note.</p>
    <button type="button" class="btn it-go">Start listening</button>
    <p class="note bad it-err" hidden></p>
  </section>
  <section class="panel">
    <div class="it-grid">
      <label>Instrument <select class="it-preset">{Object.entries(PRESETS).map(([k, p]) => <option value={k}>{p.name}</option>)}</select></label>
      <label>A4 is (Hz) <input class="it-a4" type="number" min="400" max="480" step="0.5" value="440" inputmode="decimal" /></label>
    </div>
    <div class="it-strings" aria-label="Strings: press one to hear its note"></div>
    <p class="it-fine">The microphone sound is checked here on your device about 15 times a second and is never recorded or sent anywhere.</p>
  </section>
</div>

<style is:inline>
  .it { display: grid; gap: 14px; margin-bottom: 32px; }
  .it .panel { display: grid; gap: 12px; padding: 16px; }
  .it [hidden] { display: none !important; }
  .it-note { font-size: 72px; line-height: 1; text-align: center; font-variant-numeric: tabular-nums; }
  .it-oct { font-size: 28px; color: var(--muted); }
  .it-meter { position: relative; height: 34px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); overflow: hidden; }
  .it-mid { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--ink); opacity: .35; }
  .it-needle { position: absolute; left: 50%; top: 4px; bottom: 4px; width: 6px; margin-left: -3px; border-radius: 3px; background: var(--muted); transition: left 80ms linear; }
  .it-needle.good { background: var(--good, #1a7f37); }
  .it-needle.off { background: var(--warn, #b26a00); }
  .it-scale { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; }
  .it-read { text-align: center; margin: 0; font-variant-numeric: tabular-nums; }
  .it-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .it label { display: grid; gap: 4px; font-size: 14px; color: var(--muted); }
  .it input, .it select { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .it-strings { display: flex; flex-wrap: wrap; gap: 8px; }
  .it-strings button { font: inherit; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--ink); cursor: pointer; min-width: 52px; }
  .it-strings button.near { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .it-fine { color: var(--muted); font-size: 14px; margin: 0; }
</style>

<script>
  import { yin, nearestNote, NOTE_NAMES } from '../../lib/audio/pitch.ts';
  import { tone } from '../../lib/audio/synth.ts';
  import { player } from '../../lib/audio/browser.ts';
  const root = document.querySelector('.it') as HTMLElement;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const PRESETS = JSON.parse(root.dataset.presets!) as Record<string, { notes: string[] }>;
  const go = $<HTMLButtonElement>('.it-go'), err = $('.it-err'), read = $('.it-read'), needle = $('.it-needle'), a4In = $<HTMLInputElement>('.it-a4'), preset = $<HTMLSelectElement>('.it-preset');
  if (!navigator.mediaDevices?.getUserMedia) { $('.it-none').hidden = false; go.disabled = true; }
  const play = player();
  let stream: MediaStream | null = null, ac: AudioContext | null = null, timer = 0;
  const hist: number[] = [];
  const a4 = () => Math.max(400, Math.min(480, +a4In.value || 440));
  const noteHz = (n: string) => { const m = n.match(/^([A-G]♯?)(-?\d)$/)!; const midi = NOTE_NAMES.indexOf(m[1]) + 12 * (+m[2] + 1); return a4() * Math.pow(2, (midi - 69) / 12); };
  const strings = () => {
    const box = $('.it-strings'), notes = PRESETS[preset.value].notes;
    box.replaceChildren(...notes.map((n) => { const b = document.createElement('button'); b.type = 'button'; b.dataset.note = n; b.textContent = n; b.title = `${noteHz(n).toFixed(2)} Hz: press to hear it`;
      b.addEventListener('click', () => play.play([tone('triangle', noteHz(n), 1.5, 48000, 0.3)], 48000)); return b; }));
  };
  const show = (hz: number) => {
    const notes = PRESETS[preset.value].notes;
    let target: number, label: string, oct: string;
    if (notes.length) { // nearest string, measured against its own note
      const best = notes.map((n) => ({ n, d: Math.abs(Math.log2(hz / noteHz(n))) })).sort((a, b) => a.d - b.d)[0];
      target = noteHz(best.n); label = best.n.replace(/-?\d$/, ''); oct = best.n.match(/-?\d$/)![0];
      $('.it-strings').querySelectorAll('button').forEach((b) => b.classList.toggle('near', b.dataset.note === best.n));
    } else { const nn = nearestNote(hz, a4()); target = nn.target; label = nn.name; oct = String(nn.octave); }
    const cents = 1200 * Math.log2(hz / target), c = Math.max(-50, Math.min(50, cents));
    $('.it-name').textContent = label; $('.it-oct').textContent = oct;
    needle.style.left = `${50 + c}%`; needle.className = 'it-needle ' + (Math.abs(cents) <= 5 ? 'good' : 'off');
    read.textContent = `${hz.toFixed(1)} Hz · ${cents >= 0 ? '+' : '−'}${Math.abs(cents).toFixed(0)} cents · ${Math.abs(cents) <= 5 ? 'in tune' : cents > 0 ? 'too high: loosen' : 'too low: tighten'}`;
  };
  const start = async () => {
    err.hidden = true;
    try { stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } }); }
    catch (e) { err.textContent = (e as Error).name === 'NotAllowedError' ? 'The microphone was blocked. Allow it in the address bar and try again.' : 'No microphone was found, or another app is using it.'; err.hidden = false; return; }
    ac = new AudioContext(); await ac.resume();
    const an = ac.createAnalyser(); an.fftSize = 4096; ac.createMediaStreamSource(stream).connect(an);
    const buf = new Float32Array(an.fftSize), rate = ac.sampleRate;
    timer = window.setInterval(() => {
      an.getFloatTimeDomainData(buf);
      const low = preset.value === 'bass' || preset.value === 'cello';
      const r = yin(low ? buf : buf.subarray(buf.length - 2048), rate, low ? 30 : 60, 1500);
      // Wait for 3 pitched frames so the first frame of a new note (half silence, half sound) never shows on its own.
      if (r.hz && r.clarity > 0.85) { hist.push(r.hz); if (hist.length > 5) hist.shift(); if (hist.length >= 3) show([...hist].sort((a, b) => a - b)[hist.length >> 1]); }
      else if (hist.length) hist.shift();
    }, 66);
    go.textContent = 'Stop listening';
  };
  const stop = () => { clearInterval(timer); timer = 0; stream?.getTracks().forEach((t) => t.stop()); ac?.close(); ac = null; stream = null; hist.length = 0; go.textContent = 'Start listening'; };
  go.addEventListener('click', () => (timer ? stop() : start()));
  preset.addEventListener('change', strings); a4In.addEventListener('change', strings);
  strings();
</script>
