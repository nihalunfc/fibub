---
// Catch per unit effort: nominal CPUE by year and a log-linear standardised index (year + factors) with confidence
// intervals and a trend. The example records are made up.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
import DataFile from '../../components/DataFile.astro';
