---
// #T857 Colour converter
---
<div class="tool-ui cc">
  <section class="panel cc-top">
    <label class="cc-lab">Type a colour (HEX, RGB, HSL, CMYK or a CSS name)
      <input class="cc-in" type="text" value="#1e90ff" spellcheck="false" autocomplete="off" autocapitalize="off" />
    </label>
    <label class="cc-lab cc-picklab">Or pick one
      <input class="cc-pick" type="color" value="#1e90ff" />
    </label>
    <button type="button" class="cc-reset">Reset</button>
  </section>
  <p class="cc-err" role="alert" hidden></p>
  <section class="panel cc-res">
    <div class="cc-swatch" aria-hidden="true"></div>
    <dl class="cc-rows"></dl>
  </section>
  <section class="panel">
    <h3 class="cc-h">Tints and shades</h3>
    <p class="cc-note">Tints mix in white, shades mix in black, in steps of 20%. Tap one to use it.</p>
    <div class="cc-steps" data-k="tints"></div>
    <div class="cc-steps" data-k="shades"></div>
  </section>
  <section class="panel">
    <h3 class="cc-h">Contrast (WCAG 2)</h3>
    <div class="cc-con"></div>
    <p class="cc-note">AA needs 4.5:1 for normal text and 3:1 for large text (24 px, or 19 px bold). AAA needs 7:1 and 4.5:1.</p>
  </section>
  <p class="cc-note">Nothing you type leaves this page.</p>
</div>

<style is:inline>
  .cc { display: grid; gap: 14px; margin-bottom: 32px; }
  .cc .panel { padding: 16px; }
  .cc-top { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; align-items: end; }
  .cc-lab { display: grid; gap: 4px; font-size: 14px; color: var(--muted); min-width: 0; }
  .cc-in { font: inherit; color: var(--ink); padding: 9px 11px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); width: 100%; min-width: 0; }
  .cc-in:focus { border-color: var(--accent); outline: none; }
  .cc-pick { width: 56px; height: 42px; padding: 2px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; }
  .cc button { font: inherit; font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); cursor: pointer; }
  .cc-err { margin: 0; color: var(--bad, #b00020); font-weight: 600; }
  .cc-res { display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: start; }
  .cc-swatch { width: 96px; height: 96px; border-radius: 12px; border: 1px solid var(--line); }
  .cc-rows { margin: 0; display: grid; gap: 6px; min-width: 0; }
  .cc-rows div { display: grid; grid-template-columns: 56px 1fr auto; gap: 8px; align-items: center; }
  .cc-rows dt { color: var(--muted); font-size: 14px; }
  .cc-rows dd { margin: 0; font-family: ui-monospace, monospace; font-size: 15px; overflow-wrap: anywhere; min-width: 0; }
  .cc-rows button { padding: 4px 10px; font-size: 13px; }
  .cc-h { margin: 0 0 6px; font-size: 16px; }
  .cc-note { color: var(--muted); font-size: 13px; margin: 0 0 8px; }
  .cc-steps { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-bottom: 6px; }
  .cc-steps button { height: 44px; padding: 0; font-size: 11px; font-family: ui-monospace, monospace; border-radius: 8px; overflow: hidden; }
  .cc-con { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 10px; margin-bottom: 8px; }
  .cc-box { border-radius: 10px; padding: 12px; border: 1px solid var(--line); }
  .cc-box b { display: block; font-size: 20px; }
  .cc-box span { font-size: 14px; }
  .cc-meta { background: var(--surface); color: var(--ink); padding: 8px 10px; font-size: 13px; border-radius: 0 0 10px 10px; margin: 8px -12px -12px; }
  @media (max-width: 480px) {
    .cc-top { grid-template-columns: 1fr auto; }
    .cc-top .cc-lab:first-child { grid-column: 1 / -1; }
    .cc-res { grid-template-columns: 1fr; }
    .cc-swatch { width: 100%; height: 64px; }
  }
</style>

<script>
  const NAMES_RAW = 'aliceblue:f0f8ff antiquewhite:faebd7 aqua:00ffff aquamarine:7fffd4 azure:f0ffff beige:f5f5dc bisque:ffe4c4 black:000000 blanchedalmond:ffebcd blue:0000ff blueviolet:8a2be2 brown:a52a2a burlywood:deb887 cadetblue:5f9ea0 chartreuse:7fff00 chocolate:d2691e coral:ff7f50 cornflowerblue:6495ed cornsilk:fff8dc crimson:dc143c cyan:00ffff darkblue:00008b darkcyan:008b8b darkgoldenrod:b8860b darkgray:a9a9a9 darkgreen:006400 darkgrey:a9a9a9 darkkhaki:bdb76b darkmagenta:8b008b darkolivegreen:556b2f darkorange:ff8c00 darkorchid:9932cc darkred:8b0000 darksalmon:e9967a darkseagreen:8fbc8f darkslateblue:483d8b darkslategray:2f4f4f darkslategrey:2f4f4f darkturquoise:00ced1 darkviolet:9400d3 deeppink:ff1493 deepskyblue:00bfff dimgray:696969 dimgrey:696969 dodgerblue:1e90ff firebrick:b22222 floralwhite:fffaf0 forestgreen:228b22 fuchsia:ff00ff gainsboro:dcdcdc ghostwhite:f8f8ff gold:ffd700 goldenrod:daa520 gray:808080 green:008000 greenyellow:adff2f grey:808080 honeydew:f0fff0 hotpink:ff69b4 indianred:cd5c5c indigo:4b0082 ivory:fffff0 khaki:f0e68c lavender:e6e6fa lavenderblush:fff0f5 lawngreen:7cfc00 lemonchiffon:fffacd lightblue:add8e6 lightcoral:f08080 lightcyan:e0ffff lightgoldenrodyellow:fafad2 lightgray:d3d3d3 lightgreen:90ee90 lightgrey:d3d3d3 lightpink:ffb6c1 lightsalmon:ffa07a lightseagreen:20b2aa lightskyblue:87cefa lightslategray:778899 lightslategrey:778899 lightsteelblue:b0c4de lightyellow:ffffe0 lime:00ff00 limegreen:32cd32 linen:faf0e6 magenta:ff00ff maroon:800000 mediumaquamarine:66cdaa mediumblue:0000cd mediumorchid:ba55d3 mediumpurple:9370db mediumseagreen:3cb371 mediumslateblue:7b68ee mediumspringgreen:00fa9a mediumturquoise:48d1cc mediumvioletred:c71585 midnightblue:191970 mintcream:f5fffa mistyrose:ffe4e1 moccasin:ffe4b5 navajowhite:ffdead navy:000080 oldlace:fdf5e6 olive:808000 olivedrab:6b8e23 orange:ffa500 orangered:ff4500 orchid:da70d6 palegoldenrod:eee8aa palegreen:98fb98 paleturquoise:afeeee palevioletred:db7093 papayawhip:ffefd5 peachpuff:ffdab9 peru:cd853f pink:ffc0cb plum:dda0dd powderblue:b0e0e6 purple:800080 rebeccapurple:663399 red:ff0000 rosybrown:bc8f8f royalblue:4169e1 saddlebrown:8b4513 salmon:fa8072 sandybrown:f4a460 seagreen:2e8b57 seashell:fff5ee sienna:a0522d silver:c0c0c0 skyblue:87ceeb slateblue:6a5acd slategray:708090 slategrey:708090 snow:fffafa springgreen:00ff7f steelblue:4682b4 tan:d2b48c teal:008080 thistle:d8bfd8 tomato:ff6347 turquoise:40e0d0 violet:ee82ee wheat:f5deb3 white:ffffff whitesmoke:f5f5f5 yellow:ffff00 yellowgreen:9acd32';
  const NAMES: Record<string, string> = {};
  for (const p of NAMES_RAW.split(' ')) { const [k, v] = p.split(':'); NAMES[k] = v; }
  type RGB = [number, number, number];
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const hex2 = (v: number) => Math.round(v).toString(16).padStart(2, '0');
  const toHex = (c: RGB) => '#' + c.map(hex2).join('');
  const fromHex = (h: string): RGB | null => {
    h = h.replace(/^#/, '');
    if (/^[0-9a-f]{3,4}$/i.test(h)) h = h.slice(0, 3).split('').map((x) => x + x).join('');
    else if (/^[0-9a-f]{6}([0-9a-f]{2})?$/i.test(h)) h = h.slice(0, 6);
    else return null;
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as RGB;
  };
  const hslToRgb = (h: number, s: number, l: number): RGB => {
    h = ((h % 360) + 360) % 360; s /= 100; l /= 100;
    const k = (n: number) => (n + h / 30) % 12, a = s * Math.min(l, 1 - l);
    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
    return [f(0) * 255, f(8) * 255, f(4) * 255].map(Math.round) as RGB;
  };
  const rgbToHsl = ([r, g, b]: RGB) => {
    r /= 255; g /= 255; b /= 255;
    const mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn, l = (mx + mn) / 2;
    let h = 0, s = 0;
    if (d) {
      s = d / (1 - Math.abs(2 * l - 1));
      h = mx === r ? ((g - b) / d) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4;
      h = (h * 60 + 360) % 360;
    }
    return [Math.round(h) % 360, Math.round(s * 100), Math.round(l * 100)];
  };
  const rgbToCmyk = ([r, g, b]: RGB) => {
    const k = 1 - Math.max(r, g, b) / 255;
    if (k >= 1) return [0, 0, 0, 100];
    return [r, g, b].map((v) => Math.round(((1 - v / 255 - k) / (1 - k)) * 100)).concat(Math.round(k * 100));
  };
  const nums = (s: string) => (s.match(/-?\d*\.?\d+%?/g) || []).map((x) => parseFloat(x));
  const parse = (raw: string): RGB | null => {
    const s = raw.trim().toLowerCase();
    if (!s) return null;
    if (NAMES[s.replace(/\s+/g, '')]) return fromHex(NAMES[s.replace(/\s+/g, '')]);
    if (/^#?[0-9a-f]+$/.test(s)) return fromHex(s);
    const n = nums(s);
    if (/^rgba?\(/.test(s) || /^[\d.\s,%]+$/.test(s)) {
      if (n.length < 3) return null;
      const pc = (s.match(/-?\d*\.?\d+%?/g) || []).map((x) => x.endsWith('%'));
      const v = n.slice(0, 3).map((x, i) => (pc[i] ? x * 2.55 : x));
      if (v.some((x) => x < 0 || x > 255.5)) return null;
      return v.map((x) => Math.round(clamp(x, 0, 255))) as RGB;
    }
    if (/^hsla?\(/.test(s)) {
      if (n.length < 3) return null;
      let h = n[0];
      if (/turn/.test(s)) h *= 360; else if (/rad/.test(s)) h = (h * 180) / Math.PI;
      if (n[1] < 0 || n[1] > 100 || n[2] < 0 || n[2] > 100) return null;
      return hslToRgb(h, n[1], n[2]);
    }
    if (/^(cmyk|device-cmyk)\(/.test(s)) {
      if (n.length < 4) return null;
      const pc = (s.match(/-?\d*\.?\d+%?/g) || []).some((x) => x.endsWith('%')) || n.slice(0, 4).some((x) => x > 1);
      const [c, m, y, k] = n.slice(0, 4).map((x) => (pc ? x / 100 : x));
      if ([c, m, y, k].some((x) => x < 0 || x > 1)) return null;
      return [c, m, y].map((x) => Math.round(255 * (1 - x) * (1 - k))) as RGB;
    }
    return null;
  };
  const lum = (c: RGB) => {
    const L = (v: number) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };
    return 0.2126 * L(c[0]) + 0.7152 * L(c[1]) + 0.0722 * L(c[2]);
  };
  const ratio = (a: RGB, b: RGB) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
  const nearest = (c: RGB) => {
    let best = '', bd = Infinity;
    for (const [k, v] of Object.entries(NAMES)) {
      const o = fromHex(v)!; const d = (o[0] - c[0]) ** 2 + (o[1] - c[1]) ** 2 + (o[2] - c[2]) ** 2;
      if (d < bd) { bd = d; best = k; }
    }
    return { name: best, exact: bd === 0 };
  };
  const mix = (c: RGB, t: RGB, f: number) => c.map((v, i) => Math.round(v + (t[i] - v) * f)) as RGB;

  const root = document.querySelector('.cc') as HTMLElement;
  const inp = root.querySelector('.cc-in') as HTMLInputElement;
  const pick = root.querySelector('.cc-pick') as HTMLInputElement;
  const err = root.querySelector('.cc-err') as HTMLElement;
  const rows = root.querySelector('.cc-rows') as HTMLElement;
  const sw = root.querySelector('.cc-swatch') as HTMLElement;
  const con = root.querySelector('.cc-con') as HTMLElement;
  const steps = (k: string) => root.querySelector(`.cc-steps[data-k="${k}"]`) as HTMLElement;
  const textOn = (c: RGB) => (ratio(c, [0, 0, 0]) >= ratio(c, [255, 255, 255]) ? '#000' : '#fff');

  const render = () => {
    const c = parse(inp.value);
    if (!c) {
      err.hidden = false;
      err.textContent = inp.value.trim() ? 'Could not read that colour. Try #1e90ff, rgb(30, 144, 255), hsl(210, 100%, 56%), cmyk(88%, 44%, 0%, 0%) or a name like tomato.' : 'Type a colour above.';
      root.querySelector('.cc-res')!.classList.add('cc-dim');
      return;
    }
    err.hidden = true;
    const hex = toHex(c), [h, s, l] = rgbToHsl(c), cm = rgbToCmyk(c), nm = nearest(c);
    pick.value = hex; sw.style.background = hex;
    const R: [string, string, string][] = [
      ['hex', 'HEX', hex],
      ['rgb', 'RGB', `rgb(${c.join(', ')})`],
      ['hsl', 'HSL', `hsl(${h}, ${s}%, ${l}%)`],
      ['cmyk', 'CMYK', `cmyk(${cm.map((v) => v + '%').join(', ')})`],
      ['name', 'Name', nm.exact ? nm.name : `none (nearest: ${nm.name})`],
    ];
    rows.innerHTML = '';
    for (const [k, lab, val] of R) {
      const d = document.createElement('div');
      const dt = document.createElement('dt'); dt.textContent = lab;
      const dd = document.createElement('dd'); dd.dataset.f = k; dd.textContent = val;
      const b = document.createElement('button'); b.type = 'button'; b.textContent = 'Copy';
      const copyVal = k === 'name' ? nm.name : val;
      b.addEventListener('click', async () => { try { await navigator.clipboard.writeText(copyVal); b.textContent = 'Copied'; } catch { b.textContent = 'Select it'; } setTimeout(() => (b.textContent = 'Copy'), 1200); });
      d.append(dt, dd, b); rows.append(d);
    }
    for (const [k, t] of [['tints', [255, 255, 255]], ['shades', [0, 0, 0]]] as [string, RGB][]) {
      const el = steps(k); el.innerHTML = '';
      for (let i = 0; i <= 5; i++) {
        const m = mix(c, t, i * 0.2), hx = toHex(m);
        const b = document.createElement('button'); b.type = 'button'; b.style.background = hx; b.style.color = textOn(m);
        b.textContent = hx; b.title = `${k === 'tints' ? 'Tint' : 'Shade'} ${i * 20}%: ${hx}`;
        b.addEventListener('click', () => { inp.value = hx; render(); });
        el.append(b);
      }
    }
    con.innerHTML = '';
    for (const [lab, bg] of [['On white', [255, 255, 255]], ['On black', [0, 0, 0]]] as [string, RGB][]) {
      const r = ratio(c, bg), rs = (Math.floor(r * 100) / 100).toFixed(2);
      const g = (x: number) => (r >= x ? 'pass' : 'fail');
      const box = document.createElement('div'); box.className = 'cc-box'; box.style.background = toHex(bg); box.style.color = hex;
      box.dataset.bg = lab === 'On white' ? 'white' : 'black';
      box.innerHTML = `<b>${rs}:1</b><span>${lab}: sample text</span>`;
      const meta = document.createElement('div'); meta.className = 'cc-meta';
      meta.textContent = `Normal text: AA ${g(4.5)}, AAA ${g(7)} · Large text: AA ${g(3)}, AAA ${g(4.5)}`;
      box.append(meta); con.append(box);
    }
  };
  inp.addEventListener('input', render);
  pick.addEventListener('input', () => { inp.value = pick.value; render(); });
  root.querySelector('.cc-reset')!.addEventListener('click', () => { inp.value = '#1e90ff'; render(); });
  render();
</script>
