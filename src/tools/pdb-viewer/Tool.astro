  }
  function showPick() {
    const s = S!, el = q('.pv-pick');
    if (!picks.length) el.textContent = 'Tap an atom to start a measurement.';
    else if (picks.length === 1) el.textContent = `${atomLabel(s, picks[0])} picked (B ${fmt(s.atoms[picks[0]].b)}). Tap a second atom.`;
    else el.textContent = `${atomLabel(s, picks[0])} to ${atomLabel(s, picks[1])}: ${dist(s.atoms[picks[0]], s.atoms[picks[1]]).toFixed(3)} Å`;
    redraw();
  }
  function resetView() {
    R = R0.slice(); zoom = 1; redraw();
  }

  // ---------- tables ----------
  function table(t: HTMLTableElement, head: string[], rows: (string | Node)[][], right: number[] = []) {
    t.replaceChildren();
    const hr = t.createTHead().insertRow();
    head.forEach((h, i) => { const th = document.createElement('th'); th.textContent = h; if (right.includes(i)) th.className = 'r'; hr.append(th); });
    const b = t.createTBody();
    rows.forEach((r) => { const tr = b.insertRow(); r.forEach((c, i) => { const td = tr.insertCell(); if (typeof c === 'string') td.textContent = c; else td.append(c); if (right.includes(i)) td.className = 'r'; }); });
  }
  const fact = (k: string, v: string, sm = '') => { const d = document.createElement('div'); const dt = document.createElement('dt'), dd = document.createElement('dd'); dt.textContent = k; dd.textContent = v; if (sm) { const e = document.createElement('small'); e.textContent = sm; dd.append(e); } d.append(dt, dd); return d; };
  const pct = (a: number, n: number) => (n ? `${Math.round((100 * a) / n)} %` : '–');
  const near4 = (ri: number) => {
    const s = S!, out: string[] = [];
    s.residues.forEach((r, k) => { if (k !== ri && r.kind !== 'water' && closest(s, ri, k).d <= 4) out.push(resLabel(r)); });
    return out;
  };

  function describe() {
    const s = S!, sh = ssShare(s), polyChains = s.chains.filter((c) => c.polymer.length);
    const ligs = s.residues.filter((r) => r.kind === 'ligand'), wats = s.residues.filter((r) => r.kind === 'water');
    const nPoly = s.residues.filter((r) => r.kind === 'polymer').length;
    q('.pv-big').textContent = `${polyChains.length} chain${polyChains.length === 1 ? '' : 's'}, ${nPoly} residue${nPoly === 1 ? '' : 's'}, ${ligs.length} ligand${ligs.length === 1 ? '' : 's'}`;
    q('.pv-title').textContent = s.title ? `${s.title} (${name})` : name;
    const src = s.ssSource === 'records' ? (s.format === 'cif' ? 'from the file (struct_conf and struct_sheet_range)' : "from the file's HELIX and SHEET records") : s.ssSource === 'guess' ? 'a rough guess from C-alpha positions' : 'none: the file has no records for it';
    q('.pv-facts').replaceChildren(
      fact('Atoms', s.atoms.length.toLocaleString('en'), `${s.format === 'cif' ? 'mmCIF' : 'PDB'} file${s.models > 1 ? `, model 1 of ${s.models}` : ''}`),
      fact('Chains', String(polyChains.length), polyChains.map((c) => c.id || '(none)').slice(0, 12).join(', ') + (polyChains.length > 12 ? '…' : '')),
      fact('Residues', nPoly.toLocaleString('en'), 'amino acids or nucleotides'),
      fact('Ligands', String(ligs.length), [...new Set(ligs.map((r) => r.resName))].slice(0, 8).join(', ')),
      fact('Waters', String(wats.length)),
      fact('Secondary structure', `${pct(sh.h, sh.n)} helix, ${pct(sh.e, sh.n)} strand`, src),
    );
    table(q<HTMLTableElement>('.pv-chains'), ['Chain', 'Residues', 'Numbered', 'Helix', 'Strand', 'Ligands', 'Waters'],
      s.chains.map((c) => {
        const rs = c.polymer.map((i) => s.residues[i]), h = rs.filter((r) => r.ss === 'H').length, e = rs.filter((r) => r.ss === 'E').length;
        return [c.id || '(none)', String(rs.length), rs.length ? `${rs[0].resSeq}${rs[0].iCode} to ${rs[rs.length - 1].resSeq}${rs[rs.length - 1].iCode}` : '–', String(h), String(e), String(c.ligands.length), String(c.waters.length)];
      }), [1, 3, 4, 5, 6]);
    // Sequences, letters coloured by secondary structure; tap one to measure.
    const box = q('.pv-seqs'); box.replaceChildren();
    for (const c of polyChains.slice(0, 40)) {
      const h = document.createElement('p'); h.className = 'pv-seqh'; h.textContent = `Chain ${c.id || '(none)'}`;
      const p = document.createElement('p'); p.className = 'pv-seq';
      c.polymer.slice(0, 5000).forEach((ri, k) => {
        const r = s.residues[ri], b = document.createElement('button');
        b.type = 'button'; b.textContent = c.seq[k]; b.dataset.r = String(ri); b.title = resLabel(r);
        if (r.ss !== 'C') b.className = r.ss === 'H' ? 'pv-h' : 'pv-e';
        p.append(b);
        if ((k + 1) % 10 === 0) p.append(document.createTextNode(' '));
      });
      box.append(h, p);
    }
    table(q<HTMLTableElement>('.pv-ligs'), ['Name', 'Chain', 'Number', 'Atoms', 'Residues within 4 Å'],
      ligs.slice(0, 200).map((r) => { const n = near4(s.residues.indexOf(r)); return [r.resName, r.chain || '(none)', `${r.resSeq}${r.iCode}`, String(r.atoms.length), n.length ? n.slice(0, 8).join(', ') + (n.length > 8 ? ` and ${n.length - 8} more` : '') : 'none']; }), [2, 3]);
    q('.pv-ligbox').hidden = !ligs.length;
    q('.pv-notes').textContent = [...s.notes, ligs.length > 200 ? `Only the first 200 of ${ligs.length} ligands are listed.` : ''].filter(Boolean).join(' ');
    // Residue pickers.
    const opts = s.residues.map((r, i) => [r, i] as const).filter(([r]) => r.kind !== 'water').slice(0, 20000);
    for (const sel of [q<HTMLSelectElement>('.pv-r1'), q<HTMLSelectElement>('.pv-r2')]) sel.replaceChildren(...opts.map(([r, i]) => new Option(resLabel(r) + (r.kind === 'ligand' ? ' (ligand)' : ''), String(i))));
  }

  function measure() {
    const s = S!, a = Number(q<HTMLSelectElement>('.pv-r1').value), b = Number(q<HTMLSelectElement>('.pv-r2').value), out = q('.pv-mout');
    qa('.pv-seq button.pv-sel').forEach((e) => e.classList.remove('pv-sel'));
    for (const ri of [a, b]) root.querySelector(`.pv-seq button[data-r="${ri}"]`)?.classList.add('pv-sel');
    if (!(a >= 0) || !(b >= 0)) { out.textContent = ''; return; }
    if (a === b) { out.textContent = 'Pick two different residues.'; return; }
    const c = closest(s, a, b), ra = s.residues[a], rb = s.residues[b];
    if (c.a < 0) { out.textContent = 'These residues have no heavy atoms to measure.'; return; }
    const ca = ra.rep >= 0 && rb.rep >= 0 ? ` ${s.atoms[ra.rep].name} to ${s.atoms[rb.rep].name}: ${dist(s.atoms[ra.rep], s.atoms[rb.rep]).toFixed(3)} Å.` : '';
    out.textContent = `Closest atoms: ${atomLabel(s, c.a)} to ${atomLabel(s, c.b)}, ${c.d.toFixed(3)} Å.${ca}`;
    picks = [c.a, c.b]; showPick();
  }

  function runContacts() {
    const s = S!, cut = Number(q<HTMLInputElement>('.pv-cut').value), sep = Number(q<HTMLInputElement>('.pv-sep').value);
    const err = q('.pv-cerr');
    if (!(cut >= 1 && cut <= 12)) { err.textContent = 'Give a cutoff between 1 and 12 Å.'; err.hidden = false; return; }
    if (!(sep >= 1 && sep <= 20 && Number.isInteger(sep))) { err.textContent = 'Give a whole number of residues between 1 and 20 to skip.'; err.hidden = false; return; }
    err.hidden = true;
    const scope = q<HTMLSelectElement>('.pv-scope').value as 'all' | 'chains' | 'ligands';
    cs = contacts(s, { cutoff: cut, minSep: sep, scope, water: q<HTMLInputElement>('.pv-cwat').checked, hydrogens: q<HTMLInputElement>('.pv-chyd').checked });
    const what = scope === 'chains' ? ' between chains' : scope === 'ligands' ? ' with ligands or water' : '';
    q('.pv-cbig').textContent = `${cs.length.toLocaleString('en')} residue pair${cs.length === 1 ? '' : 's'}${what} within ${cut} Å`;
    const rows = cs.slice(0, TABLE_MAX).map((c) => [resLabel(s.residues[c.r1]), resLabel(s.residues[c.r2]), c.d.toFixed(2), `${s.atoms[c.a1].name}–${s.atoms[c.a2].name}`, String(c.n), c.kind]);
    table(q<HTMLTableElement>('.pv-ctab'), ['Residue', 'Residue', 'Closest (Å)', 'Atoms', 'Pairs', 'Type'], rows, [2, 4]);
    q('.pv-cnote').textContent = cs.length > TABLE_MAX ? `The first ${TABLE_MAX} pairs are listed; the CSV has all ${cs.length.toLocaleString('en')}.` : cs.length ? '"Pairs" counts the atom pairs within the cutoff; tap a row to mark it in the view.' : 'No contacts at these settings.';
    report();
  }

  function report() {
    const s = S!;
    const fig: Figure = { w: 640, h: 480, alt: `3D view of ${name}`, draw: (ctx, w, h, pal) => { const was = builtFor; build(pal); drawScene(ctx, w, h, pal); builtFor = was === pal.bg + pal.red ? was : ''; if (!builtFor) redraw(); } };
    const facts = [...q('.pv-facts').children].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.childNodes[0].textContent!] as [string, string]);
    const ch = q<HTMLTableElement>('.pv-chains');
    const rowsOf = (t: HTMLTableElement) => [...t.tBodies[0]?.rows ?? []].map((r) => [...r.cells].map((c) => c.textContent ?? ''));
    sections = [
      { title: q('.pv-big').textContent!, text: [q('.pv-title').textContent!], facts, figure: fig },
      { title: 'Chains', table: { head: [...ch.tHead!.rows[0].cells].map((c) => c.textContent!), rows: rowsOf(ch), align: ['l', 'r', 'l', 'r', 'r', 'r', 'r'] } },
      ...(q('.pv-ligbox').hidden ? [] : [{ title: 'Ligands', table: { head: ['Name', 'Chain', 'Number', 'Atoms', 'Residues within 4 Å'], rows: rowsOf(q<HTMLTableElement>('.pv-ligs')) } }]),
      { title: q('.pv-cbig').textContent!, table: { head: ['Residue', 'Residue', 'Closest (Å)', 'Atoms', 'Pairs', 'Type'], rows: rowsOf(q<HTMLTableElement>('.pv-ctab')).slice(0, 150), align: ['l', 'l', 'r', 'l', 'r', 'l'] }, note: cs.length > 150 ? `First 150 of ${cs.length} pairs; download the CSV for all of them.` : undefined },
    ];
    if (q('.pv-mout').textContent) sections.splice(1, 0, { title: 'Measured', text: [q('.pv-mout').textContent!, q('.pv-pick').textContent!] });
  }

  // ---------- loading ----------
  function load(t: string, nm: string) {
    const err = q('.pv-err');
    let s: Structure;
    try { s = parseStructure(t, { ss: q<HTMLSelectElement>('.pv-ss').value as 'auto' | 'guess' }); }
    catch (e) { err.textContent = (e as Error).message; err.hidden = false; return; }
    if (!s.residues.some((r) => r.kind === 'polymer' && r.rep >= 0) && !s.residues.some((r) => r.kind === 'ligand')) { err.textContent = 'No amino acids, nucleotides or ligands found to draw.'; err.hidden = false; return; }
    err.hidden = true; S = s; name = nm; picks = [];
    const shown = s.atoms.map((_, i) => i).filter((i) => s.residues[s.atoms[i].res].kind !== 'water');
    const e = extent(s, shown.length ? shown : s.atoms.map((_, i) => i)); centre = e.c; radius = Math.max(4, e.r);
    const bs = s.residues.filter((r) => r.kind === 'polymer' && r.rep >= 0).map((r) => s.atoms[r.rep].b);
    bRange = bs.length ? [Math.min(...bs), Math.max(...bs)] : [0, 1];
    if (q<HTMLSelectElement>('.pv-style').value === 'atoms') { const all = s.atoms.map((a) => a.b); bRange = [Math.min(...all), Math.max(...all)]; }
    const ax = principalAxes(shown.map((i) => P(i))).axes;
    R0 = [...ax[0], ...ax[1], ...ax[2]]; R = R0.slice(); zoom = 1;
    const along = (k: number) => Math.max(...shown.map((i) => { const a = s.atoms[i]; return Math.abs(ax[k][0] * (a.x - centre[0]) + ax[k][1] * (a.y - centre[1]) + ax[k][2] * (a.z - centre[2])); }));
    fitX = Math.max(4, along(0) + 1.5); fitY = Math.max(fitX * 0.5, along(1) + 1.5);
    qa('.pv-out').forEach((x) => (x.hidden = false));
    describe();
    if (nm === 'example') { setPick(1, 'A', 4); setPick(2, 'B', 10); }
    else { q<HTMLSelectElement>('.pv-r2').selectedIndex = Math.min(1, q<HTMLSelectElement>('.pv-r2').options.length - 1); }
    measure(); runContacts(); rebuild();
  }
  function setPick(k: number, ch: string, seq: number) {
    const i = S!.residues.findIndex((r) => r.chain === ch && r.resSeq === seq);
    if (i >= 0) q<HTMLSelectElement>(`.pv-r${k}`).value = String(i);
  }
  async function readFile(f: File) {
    const err = q('.pv-err');
    if (f.size > MAXB) { err.textContent = `That file is ${(f.size / 1e6).toFixed(0)} MB; the limit is 60 MB.`; err.hidden = false; return; }
    try {
      let t: string;
      if (/\.gz$/i.test(f.name)) {
        if (typeof DecompressionStream === 'undefined') throw new Error('This browser cannot unzip .gz files. Unzip it first, then open the .pdb or .cif file.');
        t = await new Response(f.stream().pipeThrough(new DecompressionStream('gzip'))).text();
