  q('.pv-reset').addEventListener('click', resetView);
  q('.pv-clear').addEventListener('click', () => { picks = []; q('.pv-mout').textContent = ''; qa('.pv-seq button.pv-sel').forEach((e) => e.classList.remove('pv-sel')); showPick(); report(); });
  q('.pv-style').addEventListener('change', () => {
    if (S) { const vals = q<HTMLSelectElement>('.pv-style').value === 'atoms' ? S.atoms.map((a) => a.b) : S.residues.filter((r) => r.kind === 'polymer' && r.rep >= 0).map((r) => S!.atoms[r.rep].b); if (vals.length) bRange = [Math.min(...vals), Math.max(...vals)]; }
    if (q<HTMLSelectElement>('.pv-style').value !== 'atoms' && q<HTMLSelectElement>('.pv-color').value === 'element') q<HTMLSelectElement>('.pv-color').value = 'chain';
    rebuild();
  });
  q('.pv-color').addEventListener('change', () => {
    // Element colours only make sense with every atom drawn.
    if (q<HTMLSelectElement>('.pv-color').value === 'element' && q<HTMLSelectElement>('.pv-style').value !== 'atoms') { q<HTMLSelectElement>('.pv-style').value = 'atoms'; q('.pv-style').dispatchEvent(new Event('change')); return; }
    rebuild();
  });
  ['.pv-lig', '.pv-wat', '.pv-hyd'].forEach((c) => q(c).addEventListener('change', rebuild));
  q('.pv-ss').addEventListener('change', () => { if (!S) return; assignSS(S, q<HTMLSelectElement>('.pv-ss').value as 'auto' | 'guess'); describe(); measure(); runContacts(); rebuild(); });
  ['.pv-r1', '.pv-r2'].forEach((c) => q(c).addEventListener('change', () => { measure(); report(); }));
  q('.pv-seqs').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-r]'); if (!b) return;
    q<HTMLSelectElement>(slot === 0 ? '.pv-r1' : '.pv-r2').value = b.dataset.r!; slot = 1 - slot; measure(); report();
  });
  q('.pv-ctab').addEventListener('click', (e) => {
    const tr = (e.target as HTMLElement).closest('tbody tr') as HTMLTableRowElement | null; if (!tr) return;
    const c = cs[tr.sectionRowIndex]; if (!c) return;
    picks = [c.a1, c.a2]; showPick();
    canvas.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });
  let timer = 0;
  ['.pv-cut', '.pv-sep'].forEach((c) => q(c).addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => S && runContacts(), 300); }));
  ['.pv-scope', '.pv-cwat', '.pv-chyd'].forEach((c) => q(c).addEventListener('change', () => S && runContacts()));
  const csv = (rows: string[][]) => rows.map((r) => r.map((c) => (/[",\n]/.test(c) ? `"${c.replace(/"/g, '""')}"` : c)).join(',')).join('\n') + '\n';
  q('.pv-csv').addEventListener('click', () => S && save(new Blob([csv(contactRows(S, cs))], { type: 'text/csv' }), `${fileSafe(name)}-contacts.csv`, 'text/csv'));
  q('.pv-png').addEventListener('click', () => {
    if (!S) return;
    const c = document.createElement('canvas'), w = 1600, h = 1200; c.width = w; c.height = h;
    const ctx = c.getContext('2d')!; ctx.scale(2, 2);
    const was = builtFor; build(LIGHT); drawScene(ctx, w / 2, h / 2, LIGHT); builtFor = was === LIGHT.bg + LIGHT.red ? was : '';
    redraw();
    c.toBlob((b) => b && save(b, `${fileSafe(name)}-view.png`, 'image/png'), 'image/png');
  });
  new ResizeObserver(() => redraw()).observe(canvas);
  document.addEventListener('fibub:theme', rebuild);
  new MutationObserver(rebuild).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
  wireDownloads(q('.dl'), () => { report(); return { title: 'PDB structure', subtitle: q('.pv-title').textContent ?? '', file: `${fileSafe(name)}-structure`, sections }; });
  load(EXAMPLE_PDB, 'example');
</script>

