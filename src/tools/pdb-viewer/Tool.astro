  q('.pv-show').addEventListener('click', () => { const t = q<HTMLTextAreaElement>('.pv-paste').value; if (!t.trim()) { q('.pv-err').textContent = 'Paste the text of a PDB or mmCIF file first.'; q('.pv-err').hidden = false; return; } load(t, 'pasted'); });
