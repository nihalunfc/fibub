  q('.pv-open').addEventListener('click', () => q<HTMLInputElement>('.pv-file').click());
  q('.pv-file').addEventListener('change', () => { const f = q<HTMLInputElement>('.pv-file').files?.[0]; q<HTMLInputElement>('.pv-file').value = ''; if (f) readFile(f); });
