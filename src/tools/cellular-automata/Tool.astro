---
// Cellular automata explorer: elementary 1D rules 0-255 (Wolfram numbering) and Life-like 2D rules in B/S
// notation, with patterns, step and run, wrap or dead edges, and RLE import and export. Runs in the browser.
import '../../styles/astro.css';
import Downloads from '../../components/Downloads.astro';
---
<div class="ax cas">
  <div class="ax-card">
    <h2>Automaton</h2>
    <div class="ax-seg ca-mode" role="group" aria-label="Kind of automaton">
      <button type="button" data-m="1d" aria-pressed="true">Elementary (1D)</button>
      <button type="button" data-m="2d" aria-pressed="false">Game of Life and Life-like (2D)</button>
    </div>

    <div class="ca-p1" style="margin-top:12px">
      <div class="ax-grid">
        <label>Rule (0 to 255) <input class="ca-rule" type="number" min="0" max="255" step="1" inputmode="numeric" value="30" /></label>
        <label>Width (cells) <input class="ca-w1" inputmode="numeric" value="201" /></label>
        <label>Generations <input class="ca-g1" inputmode="numeric" value="100" /></label>
        <label>Start <select class="ca-start"><option value="single">One live cell in the middle</option><option value="random">Random</option><option value="custom">My own row</option></select></label>
        <label class="ca-dw" hidden>Live share (%) <input class="ca-dens1" inputmode="decimal" value="50" /></label>
        <label class="ca-sw" hidden>Seed <input class="ca-seed1" inputmode="numeric" value="1" /></label>
        <label class="ca-cw" hidden>Row (1 alive, 0 dead) <input class="ca-cust" value="1101" spellcheck="false" /></label>
        <label>Edges <select class="ca-e1"><option value="wrap">Wrap round</option><option value="dead">Dead beyond the edge</option></select></label>
      </div>
      <div class="ca-icons" aria-label="The rule as a table"></div>
      <p class="ax-help ca-rnote"></p>
    </div>

    <div class="ca-p2" style="margin-top:12px" hidden>
      <div class="ax-grid">
        <label>Rule <select class="ca-preset"></select></label>
        <label>B/S notation <input class="ca-bs" value="B3/S23" spellcheck="false" autocapitalize="off" /></label>
        <label>Pattern <select class="ca-pat"></select></label>
        <label>Width <input class="ca-w2" inputmode="numeric" value="80" /></label>
        <label>Height <input class="ca-h2" inputmode="numeric" value="60" /></label>
        <label>Edges <select class="ca-e2"><option value="wrap">Wrap round (torus)</option><option value="dead" selected>Dead beyond the edge</option></select></label>
        <label class="ca-rw" hidden>Live share (%) <input class="ca-dens2" inputmode="decimal" value="30" /></label>
        <label class="ca-rw" hidden>Seed <input class="ca-seed2" inputmode="numeric" value="1" /></label>
      </div>
      <p class="ax-help">B lists the numbers of live neighbours (out of 8) that bring a dead cell to life; S lists those that keep a live cell alive. Conway's Life is B3/S23. Tap the grid to draw or erase cells.</p>
      <div class="ax-row" style="margin-top:10px">
        <button type="button" class="btn small ca-run">Run</button>
        <button type="button" class="btn secondary small ca-step">Step</button>
        <button type="button" class="btn secondary small ca-reset">Reset</button>
        <button type="button" class="btn secondary small ca-clear">Clear</button>
        <label style="display:flex;flex-direction:row;align-items:center;gap:6px">Speed <select class="ca-speed" style="width:auto"><option value="1">1 a frame</option><option value="2" selected>2</option><option value="8">8</option></select></label>
      </div>
      <details class="ca-rled" style="margin-top:12px">
        <summary>Import or export a pattern (RLE)</summary>
        <label style="margin-top:8px">RLE or plain text (. and O) <textarea class="ca-rle" rows="5" spellcheck="false" wrap="off" placeholder="x = 3, y = 3, rule = B3/S23&#10;bo$2bo$3o!"></textarea></label>
        <div class="ax-row" style="margin-top:8px">
          <button type="button" class="btn secondary small ca-load">Load into the grid</button>
          <button type="button" class="btn secondary small ca-open">Open an .rle file</button>
          <input type="file" class="ca-file" accept=".rle,.txt,.cells,text/plain" hidden />
          <button type="button" class="btn secondary small ca-exp">Export the grid as RLE</button>
        </div>
        <p class="ax-help">Up to 1 MB. Loading also sets the rule if the pattern names one. Export puts the RLE in the box and downloads it.</p>
      </details>
    </div>
    <p class="ax-err ca-err" hidden></p>
  </div>

  <div class="ax-card ca-out">
    <h2 class="ca-oh">Pattern</h2>
    <p class="ca-status" aria-live="polite"></p>
    <canvas class="ax-fig ca-fig"></canvas>
    <dl class="ax-facts ca-facts" style="margin-top:12px"></dl>
    <div class="ca-popw" hidden><h3>Population</h3><canvas class="ax-fig ca-pop"></canvas></div>
    <div class="ax-row" style="margin-top:10px"><button type="button" class="btn secondary small ca-txt">Download cells (text)</button></div>
    <Downloads />
  </div>
</div>

<style is:global>
  .cas h3 { margin: 20px 0 8px; font-size: 15px; }
  .cas .ca-status { margin: 0 0 8px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .cas .ca-icons { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; margin-top: 12px; max-width: 420px; }
  .cas .ca-icons div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; }
  .cas .ca-icons i { aspect-ratio: 1; border: 1px solid var(--line); background: var(--bg); }
  .cas .ca-icons i.on { background: var(--ink); }
  .cas .ca-icons i.res { grid-column: 2; }
  .cas .ca-icons i.none { visibility: hidden; }
  .cas .ca-fig { touch-action: manipulation; image-rendering: pixelated; }
</style>

<script>
  import { elementaryRun, elementaryStart, FAMOUS, parseRule, lifeStep, population, newGrid, randomGrid, place, parseRLE, toRLE, gridHash, RULES, PATTERNS, type Grid, type LifeRule } from '../../lib/sci/ca';
  import { num } from '../../lib/sci/num';
  import { chartFigure } from '../../lib/sci/plot';
  import { paint, pagePalette, wireDownloads, save, type Figure, type Palette } from '../../lib/report';

  const root = document.querySelector<HTMLElement>('.cas')!;
  const q = <T extends HTMLElement = HTMLElement>(c: string) => root.querySelector(c) as T;
  const v = (c: string) => num(q<HTMLInputElement>(c).value);
  const sel = (c: string) => q<HTMLSelectElement>(c).value;
  q<HTMLSelectElement>('.ca-preset').replaceChildren(...RULES.map((r) => new Option(`${r.name}: ${r.rule}`, r.rule)), new Option('My own rule', 'own'));
  q<HTMLSelectElement>('.ca-pat').replaceChildren(...PATTERNS.map((p) => new Option(p.name, p.id)), new Option('Random', 'random'), new Option('Empty', 'empty'));
  q<HTMLSelectElement>('.ca-pat').value = 'gun';
  let mode: '1d' | '2d' = '1d', rows: Uint8Array[] = [], fig: Figure | null = null, popFig: Figure | null = null;
  let grid: Grid = newGrid(80, 60), rule: LifeRule = parseRule('B3/S23'), gen = 0, pops: number[] = [], seen = new Map<string, number>(), cycle = '', running = false, raf = 0, frame = 0;

  const int = (c: string, lo: number, hi: number, name: string) => { const x = v(c); if (!(Number.isInteger(x) && x >= lo && x <= hi)) throw new Error(`${name} must be a whole number from ${lo} to ${hi}.`); return x; };
  const err = (m: string | null) => { q('.ca-err').textContent = m ?? ''; q('.ca-err').hidden = !m; };
  const facts = (list: [string, string][]) => q('.ca-facts').replaceChildren(...list.map(([k, x]) => { const d = document.createElement('div'); d.innerHTML = '<dt></dt><dd></dd>'; d.querySelector('dt')!.textContent = k; d.querySelector('dd')!.textContent = x; return d; }));
  const hex = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
  function cellsFig(w: number, h: number, get: (x: number, y: number) => number, alt: string, maxW = 640): Figure {
    const k = Math.max(1, Math.floor(maxW / Math.max(w, (h * 4) / 3)));
    const FW = w * k, FH = h * k;
    return {
      w: FW, h: FH, alt,
      draw: (ctx, ww, hh, pal: Palette) => {
        const off = document.createElement('canvas'); off.width = w; off.height = h;
        const oc = off.getContext('2d')!, img = oc.createImageData(w, h), on = hex(pal.ink), offc = hex(pal.bg);
        for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const c = get(x, y) ? on : offc, i = 4 * (y * w + x); img.data[i] = c[0]; img.data[i + 1] = c[1]; img.data[i + 2] = c[2]; img.data[i + 3] = 255; }
        oc.putImageData(img, 0, 0); ctx.imageSmoothingEnabled = false; ctx.drawImage(off, 0, 0, ww, hh);
        if (k >= 6) { ctx.strokeStyle = pal.grid; ctx.lineWidth = 1; ctx.beginPath(); for (let x = 1; x < w; x++) { ctx.moveTo(x * k + 0.5, 0); ctx.lineTo(x * k + 0.5, hh); } for (let y = 1; y < h; y++) { ctx.moveTo(0, y * k + 0.5); ctx.lineTo(ww, y * k + 0.5); } ctx.stroke(); }
        ctx.strokeStyle = pal.line; ctx.strokeRect(0.5, 0.5, ww - 1, hh - 1);
      },
    };
  }

  // ---------- 1D ----------
  function run1() {
    q('.ca-dw').hidden = q('.ca-sw').hidden = sel('.ca-start') !== 'random'; q('.ca-cw').hidden = sel('.ca-start') !== 'custom';
    try {
      const r = int('.ca-rule', 0, 255, 'The rule'), w = int('.ca-w1', 3, 1000, 'The width'), g = int('.ca-g1', 1, 1000, 'The number of generations');
      const kind = sel('.ca-start') as 'single' | 'random' | 'custom';
      const d = v('.ca-dens1') / 100; if (kind === 'random' && !(d >= 0 && d <= 1)) throw new Error('The live share must be between 0 and 100 %.');
      const first = elementaryStart(w, kind, { density: d, seed: kind === 'random' ? int('.ca-seed1', 0, 2 ** 31, 'The seed') : 1, text: q<HTMLInputElement>('.ca-cust').value });
      rows = elementaryRun(first, r, g, sel('.ca-e1') === 'wrap');
      err(null); q('.ca-out').hidden = false;
      // Rule table: neighbourhoods 111 down to 000 and the new centre cell.
      q('.ca-icons').replaceChildren(...[7, 6, 5, 4, 3, 2, 1, 0].map((k) => { const d = document.createElement('div'); d.title = `${(k >> 2) & 1}${(k >> 1) & 1}${k & 1} → ${(r >> k) & 1}`; for (const b of [4, 2, 1]) { const i = document.createElement('i'); if (k & b) i.className = 'on'; d.append(i); } const i = document.createElement('i'); i.className = 'res' + ((r >> k) & 1 ? ' on' : ''); const pad1 = document.createElement('i'), pad2 = document.createElement('i'); pad1.className = pad2.className = 'none'; d.append(pad1, i, pad2); return d; }));
      q('.ca-rnote').textContent = `Rule ${r} = ${r.toString(2).padStart(8, '0')} in binary: read the eight new cells above, from neighbourhood 111 to 000.${FAMOUS[r] ? ` Rule ${r}: ${FAMOUS[r]}.` : ''}`;
      q('.ca-oh').textContent = 'Space-time diagram';
      q('.ca-status').textContent = `Rule ${r}, ${g} generations of ${w} cells (time runs down)`;
      fig = cellsFig(w, rows.length, (x, y) => rows[y][x], `Rule ${r}: ${g} generations of ${w} cells`);
      paint(q<HTMLCanvasElement>('.ca-fig'), fig);
      const live = rows[rows.length - 1].reduce((s, x) => s + x, 0), tot = rows.reduce((s, row) => s + row.reduce((a, b) => a + b, 0), 0);
      facts([['Rule in binary', r.toString(2).padStart(8, '0')], ['Live cells in the last row', `${live} of ${w}`], ['Live share overall', `${((100 * tot) / (w * rows.length)).toFixed(1)} %`]]);
      q('.ca-popw').hidden = true;
    } catch (e) { err((e as Error).message); q('.ca-out').hidden = true; }
  }

  // ---------- 2D ----------
  function setRule(): boolean {
    try { rule = parseRule(q<HTMLInputElement>('.ca-bs').value); err(null); return true; } catch (e) { err((e as Error).message); stop(); return false; }
  }
  function startGrid(g: Grid) { grid = g; gen = 0; pops = [population(g)]; seen = new Map([[gridHash(g), 0]]); cycle = ''; }
  function reset2() {
    stop();
    try {
      const w = int('.ca-w2', 5, 400, 'The width'), h = int('.ca-h2', 5, 400, 'The height'), p = sel('.ca-pat');
      for (const el of root.querySelectorAll<HTMLElement>('.ca-rw')) el.hidden = p !== 'random';
      if (!setRule()) return;
      let g = newGrid(w, h);
      if (p === 'random') { const d = v('.ca-dens2') / 100; if (!(d >= 0 && d <= 1)) throw new Error('The live share must be between 0 and 100 %.'); g = randomGrid(w, h, d, int('.ca-seed2', 0, 2 ** 31, 'The seed')); }
      else if (p !== 'empty') g = place(g, parseRLE(PATTERNS.find((x) => x.id === p)!.rle));
      startGrid(g); err(null); q('.ca-out').hidden = false; draw2(true);
    } catch (e) { err((e as Error).message); q('.ca-out').hidden = true; }
  }
  function step2() {
    grid = lifeStep(grid, rule, sel('.ca-e2') === 'wrap'); gen++;
    if (pops.length < 20000) pops.push(population(grid));
    if (!cycle) {
      const hsh = gridHash(grid), was = seen.get(hsh);
      if (was !== undefined) { const p = gen - was; cycle = population(grid) === 0 ? `Everything died by generation ${was}.` : p === 1 ? `Still life from generation ${was}: nothing changes any more.` : `Repeats every ${p} generations from generation ${was}.`; }
      else if (seen.size < 5000) seen.set(hsh, gen);
    }
  }
  function draw2(withPop: boolean) {
    q('.ca-oh').textContent = 'Grid';
    fig = cellsFig(grid.w, grid.h, (x, y) => grid.c[y * grid.w + x], `${rule.text} grid of ${grid.w} × ${grid.h} at generation ${gen}`);
    paint(q<HTMLCanvasElement>('.ca-fig'), fig);
    const pop = population(grid);
    q('.ca-status').textContent = `Generation ${gen}, population ${pop.toLocaleString('en')}${running ? ', running' : ''}`;
    facts([['Rule', rule.text], ['Grid', `${grid.w} × ${grid.h}, ${sel('.ca-e2') === 'wrap' ? 'wrapping' : 'dead edges'}`], ['What happens', cycle || 'No repeat seen yet']]);
    if (withPop) {
      q('.ca-popw').hidden = false;
      const xs = pops.map((_, i) => i);
      popFig = chartFigure({ h: 220, xLabel: 'Generation', yLabel: 'Live cells', yMin: 0, legend: 'none', series: [{ name: 'Population', x: xs, y: pops, mode: 'line' }] }, 'Population over the generations');
      paint(q<HTMLCanvasElement>('.ca-pop'), popFig);
    }
  }
  function loop() {
    const n = Number(sel('.ca-speed'));
    for (let k = 0; k < n; k++) step2();
    frame++; draw2(frame % 8 === 0);
    if (running) raf = requestAnimationFrame(loop);
  }
  function start() { if (running || !setRule()) return; running = true; q('.ca-run').textContent = 'Pause'; raf = requestAnimationFrame(loop); }
  function stop() { const was = running; running = false; cancelAnimationFrame(raf); q('.ca-run').textContent = 'Run'; if (was) draw2(true); }

  function setMode(m: '1d' | '2d') {
    mode = m; stop();
    for (const b of root.querySelectorAll<HTMLButtonElement>('.ca-mode button')) b.setAttribute('aria-pressed', String(b.dataset.m === m));
    q('.ca-p1').hidden = m !== '1d'; q('.ca-p2').hidden = m !== '2d';
    if (m === '1d') run1(); else reset2();
  }
  root.querySelectorAll<HTMLButtonElement>('.ca-mode button').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.m as '1d' | '2d')));
  let tm = 0;
  for (const el of root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.ca-p1 input, .ca-p1 select')) el.addEventListener('input', () => { clearTimeout(tm); tm = window.setTimeout(run1, 200); });
  q('.ca-preset').addEventListener('change', () => { const p = sel('.ca-preset'); if (p !== 'own') { q<HTMLInputElement>('.ca-bs').value = p; setRule(); draw2(false); } });
  q('.ca-bs').addEventListener('input', () => { const ok = setRule(); if (ok) { const m = RULES.find((r) => r.rule === rule.text); q<HTMLSelectElement>('.ca-preset').value = m ? m.rule : 'own'; draw2(false); } });
  for (const c of ['.ca-pat', '.ca-w2', '.ca-h2', '.ca-dens2', '.ca-seed2']) q(c).addEventListener('input', () => { clearTimeout(tm); tm = window.setTimeout(reset2, 250); });
  q('.ca-e2').addEventListener('change', () => { seen = new Map([[gridHash(grid), gen]]); cycle = ''; draw2(false); });
  q('.ca-run').addEventListener('click', () => (running ? stop() : start()));
  q('.ca-step').addEventListener('click', () => { stop(); if (setRule()) { step2(); draw2(true); } });
  q('.ca-reset').addEventListener('click', reset2);
  q('.ca-clear').addEventListener('click', () => { stop(); startGrid(newGrid(grid.w, grid.h)); draw2(true); });
  q('.ca-fig').addEventListener('click', (e) => {
    if (mode !== '2d') return;
    const rc = q('.ca-fig').getBoundingClientRect(), x = Math.floor(((e.clientX - rc.left) / rc.width) * grid.w), y = Math.floor(((e.clientY - rc.top) / rc.height) * grid.h);
    if (x < 0 || y < 0 || x >= grid.w || y >= grid.h) return;
    grid.c[y * grid.w + x] ^= 1; seen = new Map([[gridHash(grid), gen]]); cycle = ''; pops[pops.length - 1] = population(grid); draw2(false);
  });
  const loadRLE = (text: string) => {
    try {
      const p = parseRLE(text);
      if (p.rule) { q<HTMLInputElement>('.ca-bs').value = p.rule; if (!setRule()) return; const m = RULES.find((r) => r.rule === rule.text); q<HTMLSelectElement>('.ca-preset').value = m ? m.rule : 'own'; }
      stop();
      let w = grid.w, h = grid.h;
      if (p.w + 4 > w || p.h + 4 > h) { w = Math.min(400, Math.max(w, p.w + 10)); h = Math.min(400, Math.max(h, p.h + 10)); q<HTMLInputElement>('.ca-w2').value = String(w); q<HTMLInputElement>('.ca-h2').value = String(h); }
      startGrid(place(newGrid(w, h), p)); err(null); q('.ca-out').hidden = false; draw2(true);
    } catch (e) { err((e as Error).message); }
  };
  q('.ca-load').addEventListener('click', () => loadRLE(q<HTMLTextAreaElement>('.ca-rle').value));
  q('.ca-open').addEventListener('click', () => q<HTMLInputElement>('.ca-file').click());
  q('.ca-file').addEventListener('change', async () => {
    const inp = q<HTMLInputElement>('.ca-file'), f = inp.files?.[0]; inp.value = '';
    if (!f) return;
    if (f.size > 1e6) { err(`${f.name} is over 1 MB; this tool takes pattern files up to 1 MB.`); return; }
    const t = await f.text(); q<HTMLTextAreaElement>('.ca-rle').value = t; loadRLE(t);
  });
  q('.ca-exp').addEventListener('click', () => { const t = toRLE(grid, rule.text); q<HTMLTextAreaElement>('.ca-rle').value = t; save(new Blob([t], { type: 'text/plain' }), 'pattern.rle', 'text/plain'); });
  q('.ca-txt').addEventListener('click', () => {
    const t = mode === '1d' ? rows.map((r) => Array.from(r, (x) => (x ? '#' : '.')).join('')).join('\n') : Array.from({ length: grid.h }, (_, y) => Array.from(grid.c.subarray(y * grid.w, (y + 1) * grid.w), (x) => (x ? 'O' : '.')).join('')).join('\n');
    save(new Blob([t + '\n'], { type: 'text/plain' }), mode === '1d' ? `rule-${q<HTMLInputElement>('.ca-rule').value}.txt` : `life-gen-${gen}.txt`, 'text/plain');
  });
  document.addEventListener('fibub:theme', () => { if (fig) paint(q<HTMLCanvasElement>('.ca-fig'), fig, pagePalette()); if (popFig && !q('.ca-popw').hidden) paint(q<HTMLCanvasElement>('.ca-pop'), popFig); });
  run1();
  wireDownloads(q('.dl'), () => ({ title: mode === '1d' ? `Elementary cellular automaton, rule ${q<HTMLInputElement>('.ca-rule').value}` : `Life-like cellular automaton ${rule.text}`, subtitle: q('.ca-status').textContent ?? '', file: mode === '1d' ? 'elementary-ca' : 'life', sections: [{ title: q('.ca-oh').textContent!, facts: [...q('.ca-facts').querySelectorAll('div')].map((d) => [d.querySelector('dt')!.textContent!, d.querySelector('dd')!.textContent!]) as [string, string][], figure: fig ?? undefined }, ...(mode === '2d' && popFig ? [{ title: 'Population', figure: popFig }] : [])] }));
</script>
