---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import SoonList from '../components/SoonList.astro';
import { SITE } from '../site';
import { ICONS } from '../lib/icons';
import { allTools } from '../lib/tools';
const tools = await allTools();
const live = tools.filter((t) => t.data.status === 'live');
const soon = tools.filter((t) => t.data.status === 'soon');
const promises: [keyof typeof ICONS, string][] = [['lock', 'Nothing is uploaded'], ['check', 'Nothing about you is saved'], ['download', 'Free, no sign-up']];
---
<Base title={SITE.name}>
  <section class="hero">
    <h1>Everyday tools that <span class="grad">never see your files</span></h1>
    <p class="lead">Compress, resize, check and convert, right in your browser. Fast, free and private.</p>
    <ul class="promises">
      {promises.map(([i, t]) => <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} />{t}</li>)}
    </ul>
    <label class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" set:html={ICONS.search} />
      <span class="visually-hidden">Find a tool</span>
      <input type="search" placeholder="Find a tool: PDF, photo, ZIP…" autocomplete="off" />
    </label>
  </section>

  <h2>Ready to use</h2>
  <div class="grid tools">{live.map((t) => <ToolCard tool={t} />)}</div>
  <p class="empty" hidden>No tool matches that yet. <a href="/contact/">Suggest it</a>.</p>

  <h2>Coming soon</h2>
  <SoonList tools={soon} />
</Base>

<style>
  .hero { position: relative; padding: 12px 0 4px; isolation: isolate; }
  .hero::before { content: ''; position: absolute; z-index: -1; inset: -60px -40px auto auto; width: min(520px, 90vw); height: 320px; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent-2) 16%, transparent), transparent), radial-gradient(closest-side at 30% 60%, color-mix(in srgb, var(--accent) 14%, transparent), transparent); pointer-events: none; }
  .hero h1 { max-width: 760px; }
  .promises { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .promises li { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--ink); }
  .promises svg { width: 16px; height: 16px; color: var(--good); }
  .search { display: flex; align-items: center; gap: 10px; max-width: 520px; padding: 0 14px; height: 48px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); color: var(--muted); }
  .search:focus-within { border-color: var(--accent); }
  .search svg { width: 18px; height: 18px; flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; color: var(--ink); height: 100%; }
  .empty { color: var(--muted); }
</style>

<script>
  // Filter the tool cards and the coming-soon chips as the person types.
  const input = document.querySelector<HTMLInputElement>('.search input')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const empty = document.querySelector<HTMLElement>('.empty')!;
  input.addEventListener('input', () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of items) {
      const ok = words.every((w) => el.dataset.search!.includes(w));
      el.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
  });
</script>
