---
// One page per school class (/learn/class-8/ ... /learn/class-12/): every chapter of each subject, in book
// order, with the fibub tools that let students explore it. Chapters come from src/data/ncert.ts; a tool
// listed there shows only once it is live, so the page fills up as tools are built.
import Base from '../../layouts/Base.astro';
import { allClasses, type Curriculum } from '../../data/curricula';
import type { SchoolClass } from '../../data/ncert';
import { allTools, toolUrl } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
import { chapterLessons } from '../../courses/ncert';
import { courseLessons } from '../../lib/course';
import { NCERT_COURSES } from '../../courses/ncert';
import '../../styles/area.css';
export function getStaticPaths() {
  return allClasses().map(({ cur, cls }) => ({ params: { klass: cls.id }, props: { cls, cur } }));
}
const { cls, cur } = Astro.props as { cls: SchoolClass; cur: Curriculum };
const all = await allTools();
const live = new Map(all.filter((t) => t.data.status === 'live').map((t) => [t.id, t]));
// NCERT study notes (src/courses/ncert.ts): a chapter links its notes and practice page once they are written.
const written = new Set<string>();
for (const c of NCERT_COURSES) for (const slug of (await courseLessons(c)).keys()) written.add(`${c.id}/${slug}`);
const study = (sid: string, ch: any) => {
  if (cur.id !== 'ncert') return undefined;
  const l = chapterLessons(cls.id, sid, ch);
  if (!l) return undefined;
  return { course: `/learn/courses/${l.course}/`, notes: written.has(`${l.course}/${l.slug}`) ? l.notes : undefined, practice: written.has(`${l.course}/${l.practiceSlug}`) ? l.practice : undefined };
};
const subjects = cls.subjects.map((s) => ({ ...s, chapters: s.chapters.map((ch) => ({ ...ch, study: study(s.id, ch), live: ch.tools.map((id) => live.get(id)).filter((t) => !!t) })) }));
const count = new Set(subjects.flatMap((s) => s.chapters.flatMap((ch) => ch.live.map((t) => t!.id)))).size;
const names = cls.subjects.map((s) => s.name.toLowerCase()).join(', ').replace(/, ([^,]*)$/, ' and $1');
const title = `Learn: ${cls.name}`;
// Search titles stay at 60 characters or less: longer state names drop the word "tools".
const docTitle = [`${cls.name} science and maths tools by chapter | fibub`, `${cls.name} science and maths by chapter | fibub`].find((t) => t.length <= 60) ?? `${cls.name} by chapter | fibub`;
const desc = `Interactive ${names} tools for ${cls.name}, chapter by chapter, following the ${cur.name} topics. Free, in your browser, no sign-up.`;
const others = cur.classes.filter((k) => k.id !== cls.id);
const range = cur.id === 'ncert' ? 'Class 8 to 12' : `${cur.name}, ${cur.grades}`;
---
<Base title={title} docTitle={docTitle} description={desc} ld={collectionLd(title, desc, `/learn/${cls.id}/`, [{ name: 'Home', url: '/' }, { name: 'Learn', url: '/learn/' }, { name: 'School', url: `/learn/school/#${cur.id}` }, { name: cls.name, url: `/learn/${cls.id}/` }])}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/">Learn</a> / <a href={`/learn/school/#${cur.id}`}>{range}</a> / {cls.name}</div>
  <div class="ar-head">
    <h1>{cls.name}: {names}</h1>
    <p class="lead">Every chapter, with study notes where they are ready and tools to try: change a number, drag a point, run an experiment and see what happens. {count} tools so far, and more are on the way.</p>
  </div>
  <nav class="lc-jump" aria-label="Subjects">
    {subjects.map((s) => <a href={`#${s.id}`}>{s.name}{s.book && <small> ({s.book})</small>}</a>)}
  </nav>
  {subjects.map((s) => (
    <section class="lc-subject" id={s.id}>
      <h2>{s.name}{s.book && <small> · {s.book}</small>}</h2>
      {s.chapters.some((ch) => ch.study) && <p class="lc-course">Study notes for every chapter, with animations, the tools below built in, and practice questions: <a href={s.chapters.find((ch) => ch.study)!.study!.course}>{cls.name} {s.name} course</a></p>}
      <ol class="lc-chapters">
        {s.chapters.map((ch) => (
          <li class="lc-ch" id={`${s.id}-${ch.n}`}>
            <h3><span class="lc-n">{ch.n}</span> {ch.title}</h3>
            <p class="lc-topics">{ch.topics}</p>
            {(ch.study?.notes || ch.study?.practice) && <p class="lc-study">{ch.study.notes && <a class="lc-notes" href={ch.study.notes}>Study the chapter</a>}{ch.study.practice && <a href={ch.study.practice}>Practice questions</a>}</p>}
            {ch.live.length > 0
              ? <ul class="lc-tools">{ch.live.map((t) => <li><a href={toolUrl(t!)}>{t!.data.name}</a></li>)}</ul>
              : <p class="lc-soon">Tools for this chapter are coming soon.</p>}
          </li>
        ))}
      </ol>
    </section>
  ))}
  <p class="lc-other">Other grades and classes: {others.map((k, i) => <>{i > 0 && ' · '}<a href={`/learn/${k.id}/`}>{k.name}</a></>)}</p>
  <p class="ar-note">{cur.note} Every tool runs in your browser: no sign-up, nothing about you is saved.</p>
</Base>
<style is:inline>
  .lc-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
  .lc-jump a { padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 14.5px; }
  .lc-jump a:hover { border-color: var(--accent); }
  .lc-jump small { color: var(--muted); font-weight: 400; }
  .lc-subject { margin-top: 28px; scroll-margin-top: 80px; }
  .lc-subject h2 small { color: var(--muted); font-weight: 400; font-size: .7em; }
  .lc-chapters { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .lc-ch { padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); scroll-margin-top: 80px; min-width: 0; }
  .lc-ch:target { border-color: var(--accent); }
  .lc-ch h3 { margin: 0 0 4px; font-size: 16.5px; display: flex; gap: 8px; align-items: baseline; }
  .lc-n { flex: none; min-width: 26px; height: 26px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  .lc-topics { margin: 0 0 8px; color: var(--muted); font-size: 14px; }
  .lc-tools { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .lc-tools a { display: inline-block; padding: 6px 11px; border-radius: 8px; background: var(--accent-soft); color: var(--accent); text-decoration: none; font-weight: 600; font-size: 14px; }
  .lc-tools a:hover { text-decoration: underline; }
  .lc-soon { margin: 0; font-size: 13.5px; color: var(--muted); font-style: italic; }
  .lc-other { margin-top: 24px; }
  .lc-course { margin: 0 0 10px; font-size: 14.5px; }
  .lc-study { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .lc-study a { display: inline-block; padding: 6px 11px; border-radius: 8px; border: 1px solid var(--accent); color: var(--accent); text-decoration: none; font-weight: 700; font-size: 14px; }
  .lc-study a.lc-notes { background: var(--accent); color: var(--bg); }
</style>
