---
import LearnPage from '../../components/LearnPage.astro';
import { COURSES } from '../../data/curricula';
const cards = COURSES.map((c) => ({ name: c.name, text: c.text, href: c.status === 'live' ? c.href : undefined }));
---
<LearnPage title="Learn: Courses" description="Short free courses for young learners on new and advanced topics: coding, AI, space, climate, money and science skills."
  lead="Short free courses on new and advanced topics, written for young learners. Every lesson is short and has something to try."
  cardsTitle="Planned courses" cards={cards}
  toolsTitle="Tools the courses will use" tools={['sky-tonight', 'plot-maker', 'sql-playground', 'budget-calculator', 'tree-carbon', 'sample-size']} />
