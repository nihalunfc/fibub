---
// The Learn overview (nihal, 2026-11-22): continue where you left off, a tile per category, then one row
// per category that swipes sideways on phones (less scrolling) and is a grid on computers. Courses come
// from COURSES (src/data/curricula.ts) with their `cat`, so new courses show up here on their own.
import Base from '../../layouts/Base.astro';
import HubIcon from '../../components/learn/HubIcon.astro';
import CourseCard from '../../components/learn/CourseCard.astro';
import LearnMore from '../../components/learn/LearnMore.astro';
import { courseCards, cardsIn, learnHubs } from '../../lib/learn';
import { COURSE_CATS, CURRICULA } from '../../data/curricula';
import { allTools, toolUrl } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
import '../../styles/area.css';
import '../../styles/learn.css';
const cards = await courseCards();
const hubs = learnHubs(cards);
const all = await allTools();
const pick = ['equation-balancer', 'molar-mass-calculator', 'gas-law-calculator', 'wave-calculator', 'sky-tonight', 'plot-maker', 'titration-curve', 'uncertainty-calculator'];
const tools = pick.map((id) => all.find((t) => t.id === id && t.data.status === 'live')).filter((t) => !!t);
const curricula = CURRICULA.filter((c) => c.status === 'live');
const countries = [...new Set(curricula.map((c) => c.country))].map((name) => ({ id: name.toLowerCase().replace(/[^a-z]+/g, '-'), name, curricula: curricula.filter((c) => c.country === name) }));
const title = 'Learn';
const desc = 'Free courses and learning tools: school science and maths for Class 8 to 12 (NCERT, Kerala, Canada, USA, UK), data and AI courses, science and space, and home skills. In your browser, no sign-up.';
---
<Base title={title} docTitle="Learn: free courses and school tools | fibub" description={desc} ld={collectionLd(title, desc, '/learn/', [{ name: 'Home', url: '/' }, { name: 'Learn', url: '/learn/' }])}>
  <div class="lh-head">
    <h1>Learn</h1>
    <p class="lead">Free courses and hands-on tools, from Class 8 science to machine learning. No sign-up.</p>
  </div>
  <section class="lh-cont" data-continue hidden aria-label="Continue where you left off"><h2>Continue where you left off</h2><ul></ul></section>
  <nav class="lh-hubs lh-anim" aria-label="Learn categories">
    {hubs.map((h, i) => (
      <a class="lh-hub" href={h.href} style={`--i:${i}`}>
        <HubIcon id={h.id} />
        <strong>{h.name}</strong>
        <small>{h.count}</small>
        <span class="lh-blurb">{h.blurb}</span>
      </a>
    ))}
  </nav>

  <div class="lh-sec"><h2>School, Class 8 to 12</h2><a href="/learn/school/">All classes →</a></div>
  <div class="lh-rail">
    {countries.map((co) => (
      <a class="lk" href={`/learn/school/#${co.id}`}>
        <strong>{co.name}</strong>
        <small>{co.curricula.map((c) => c.name.replace(/ \((India|UK)\)$/, '')).join(' · ')}</small>
        <small>{[...new Set(co.curricula.map((c) => c.grades))].join(', ')}</small>
      </a>
    ))}
  </div>

  {COURSE_CATS.map((k) => {
    const cs = cardsIn(cards, k.id).filter((c) => c.status === 'live');
    return cs.length > 0 && <>
      <div class="lh-sec"><h2>{k.name}</h2><a href={k.href}>{cs.some((c) => c.status === 'live') ? `See all ${cs.filter((c) => c.status === 'live').length}` : 'Open'} →</a></div>
      <div class="lh-rail">{cs.slice(0, 8).map((c) => <CourseCard c={c} />)}</div>
    </>;
  })}

  <div class="lh-sec"><h2>Try a tool</h2><a href="/science/">All science tools →</a></div>
  <ul class="lh-chips">{tools.map((t) => <li><a href={toolUrl(t!)}>{t!.data.name}</a></li>)}</ul>

  <LearnMore here="overview" />
  <p class="ar-note">School pages follow the topics of the NCERT, Kerala SCERT, Ontario, US and England curricula; fibub is an independent free site, not part of any of them, and copies no textbook text or pictures. University-level material comes later.</p>
</Base>
<script>import '../../scripts/learn';</script>
