---
// School (nihal, 2026-11-22): one tab per curriculum (NCERT, Kerala, Canada, USA, UK) with a compact tile per
// class or grade, then the Learn tools by school subject, also as tabs. Radio chips, so it works with no script;
// /learn/school/#canada opens the Canada tab.
import Base from '../../layouts/Base.astro';
import LearnMore from '../../components/learn/LearnMore.astro';
import { CURRICULA, INDIA_NCERT_BOARDS } from '../../data/curricula';
import { SECTIONS } from '../../site';
import { allTools, toolUrl } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
import { hubHeadline } from '../../lib/headline';
import CountStrip from '../../components/CountStrip.astro';
import { NCERT_COURSES } from '../../courses/ncert';
import '../../styles/area.css';
import '../../styles/learn.css';
const all = await allTools();
const live = new Set(all.filter((t) => t.data.status === 'live').map((t) => t.id));
const curricula = CURRICULA.filter((c) => c.status === 'live').map((cur) => ({
  ...cur,
  tiles: cur.classes.map((k) => {
    const tools = new Set(k.subjects.flatMap((s) => s.chapters.flatMap((ch) => ch.tools.filter((id) => live.has(id))))).size;
    const chapters = k.subjects.reduce((a, s) => a + s.chapters.length, 0);
    return { name: k.name, href: `/learn/${k.id}/`, subjects: k.subjects.map((s) => s.name).join(', '), chapters, tools };
  }),
}));
// One tab per country (nihal, 2026-11-22: a single India tab holding NCERT and every state board), each
// curriculum a block inside it. A new state board joins the India tab by having country 'India'.
const slug = (x: string) => x.toLowerCase().replace(/[^a-z]+/g, '-');
const countries = [...new Set(curricula.map((c) => c.country))].map((name) => ({ id: slug(name), name, curricula: curricula.filter((c) => c.country === name) }));
const groups = (SECTIONS.learn ?? []).filter((sec) => sec.id !== 'home-skills').map((sec) => ({ ...sec, tools: all.filter((t) => t.data.shelf === 'learn' && t.data.status === 'live' && t.data.section === sec.id) })).filter((g) => g.tools.length);
const css = countries.map((c) => `.lh-cur:has(#c-${c.id}:checked) [data-panel]:not([data-panel="${c.id}"]){display:none}`).join('')
  + groups.map((g) => `.lh-sub-t:has(#s-${g.id}:checked) [data-group]:not([data-group="${g.id}"]){display:none}`).join('');
const nums = await hubHeadline('school');
const title = 'Learn: School';
const desc = 'Interactive science and maths tools for Class 8 to 12, chapter by chapter: NCERT and CBSE, Kerala, Tamil Nadu, Telangana and West Bengal state boards, Canada, the USA and the UK. Free, in your browser.';
---
<Base title={title} docTitle="Class 8 to 12 science and maths tools by chapter | fibub" description={desc} ld={collectionLd('School', desc, '/learn/school/', [{ name: 'Home', url: '/' }, { name: 'Learn', url: '/learn/' }, { name: 'School', url: '/learn/school/' }])}>
  <style is:inline set:html={css + '.lh-jump{margin:0 0 10px}.lh-jump a{text-decoration:none}.lh-note{margin:4px 0 8px;color:var(--muted);font-size:14px}.lh-states{list-style:none;margin:0;padding:0;display:grid;gap:6px}.lh-states li{padding:8px 10px;border:1px solid var(--line);border-radius:10px;font-size:14px;overflow-wrap:anywhere}.lh-states small{color:var(--muted)}'}></style>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/">Learn</a> / School</div>
  <div class="lh-head">
    <h1>School, Class 8 to 12</h1>
    <p class="lead">Pick your syllabus, then your class, to see every chapter with tools to try: change a number and watch what happens.</p>
  </div>
  <CountStrip counts={nums.counts} exams={nums.exams} label="School in numbers" examsLabel="Practice questions" />
  <div class="lh-cur">
    <div class="lh-tabs" role="radiogroup" aria-label="Country">
      {countries.map((c, i) => <><input type="radio" name="cur" id={`c-${c.id}`} value={c.id} data-hash checked={i === 0} /><label for={`c-${c.id}`}>{c.name}</label></>)}
    </div>
    {countries.map((co) => (
      <div data-panel={co.id}>
        {co.curricula.length > 2 && <nav class="lh-chips lh-jump" aria-label={`${co.name} syllabuses`}>{co.curricula.map((c) => <a href={`#${c.id}`}>{c.name.replace(/ state syllabus.*| \(India\)/, '')}</a>)}{co.name === 'India' && <a href="#ncert-states">Other states</a>}</nav>}
        {co.curricula.map((c) => (
          <section id={c.id} class="lh-curblock" aria-label={c.name}>
            {co.curricula.length > 1 && <h2 class="lh-curh">{c.name} <small>{c.grades}</small></h2>}
            <div class="lh-grid lh-k2 lh-anim">
              {c.tiles.map((t, i) => <a class="lk" href={t.href} style={`--i:${i}`}><strong>{t.name}</strong><small>{t.subjects}</small><small>{t.chapters} {c.unit ?? 'chapter'}s · {t.tools} tools</small></a>)}
            </div>
            {c.id === 'ncert' && NCERT_COURSES.length > 0 && <p class="lh-note"><strong>Study notes, chapter by chapter</strong> (animations, tools built in, practice questions): {NCERT_COURSES.map((k, i) => <>{i > 0 && ' · '}<a href={`/learn/courses/${k.id}/`}>{k.name}</a></>)}</p>}
            <details class="lh-about"><summary>About this syllabus</summary><p class="ar-note">{c.note}</p></details>
          </section>
        ))}
        {co.name === 'India' && (
          <section id="ncert-states" class="lh-curblock" aria-label="States that use the NCERT books">
            <h2 class="lh-curh">Other states: use the NCERT pages</h2>
            <p class="lh-note">These state boards teach science and maths from the NCERT books (or books that follow them closely), so their students can use the <a href="#ncert">NCERT and CBSE</a> class pages. Chapter numbers can differ a little, so match by chapter name.</p>
            <ul class="lh-states">{INDIA_NCERT_BOARDS.map((b) => <li><strong>{b.name}</strong> <small>({b.board})</small>: {b.text} <a href={b.source} rel="nofollow noopener" target="_blank">Source</a></li>)}</ul>
          </section>
        )}
      </div>
    ))}
  </div>
  {groups.length > 0 && <>
    <div class="lh-sec"><h2>Activities by subject</h2></div>
    <div class="lh-sub-t">
      <div class="lh-tabs" role="radiogroup" aria-label="Subject">
        {groups.map((g, i) => <><input type="radio" name="subj" id={`s-${g.id}`} value={g.id} checked={i === 0} /><label for={`s-${g.id}`}>{g.name} <small>{g.tools.length}</small></label></>)}
      </div>
      {groups.map((g) => <div data-group={g.id}>
        <ul class="lh-chips">{g.tools.slice(0, 18).map((t) => <li><a href={toolUrl(t)}>{t.data.name}</a></li>)}</ul>
        {g.tools.length > 18 && <details class="lh-all"><summary>Show all {g.tools.length}</summary><ul class="lh-chips">{g.tools.slice(18).map((t) => <li><a href={toolUrl(t)}>{t.data.name}</a></li>)}</ul></details>}
      </div>)}
    </div>
  </>}
  <LearnMore here="school" />
</Base>
<script>import '../../scripts/learn';</script>
