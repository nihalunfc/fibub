---
// Virtual experiments: school practicals grouped by topic, every one a live fibub lab (EXPERIMENTS in src/lib/learn.ts).
import Base from '../../layouts/Base.astro';
import HubIcon from '../../components/learn/HubIcon.astro';
import LearnMore from '../../components/learn/LearnMore.astro';
import { EXPERIMENTS } from '../../lib/learn';
import { allTools, toolUrl } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
import '../../styles/area.css';
import '../../styles/learn.css';
const all = await allTools();
const groups = EXPERIMENTS.map((g) => ({ ...g, tools: g.tools.map((id) => all.find((t) => t.id === id && t.data.status === 'live')).filter((t) => !!t) })).filter((g) => g.tools.length);
const n = groups.reduce((s, g) => s + g.tools.length, 0);
const desc = `${n} free virtual science experiments for Class 8 to 12: electricity, light, motion, chemistry and biology practicals in your browser. No sign-up.`;
---
<Base title="Learn: Experiments" docTitle="Free virtual science experiments for school | fibub" description={desc} ld={collectionLd('Experiments', desc, '/learn/experiments/', [{ name: 'Home', url: '/' }, { name: 'Learn', url: '/learn/' }, { name: 'Experiments', url: '/learn/experiments/' }])}>
  <div class="crumbs"><a href="/">Home</a> / <a href="/learn/">Learn</a> / Experiments</div>
  <div class="lh-head">
    <h1>Virtual experiments</h1>
    <p class="lead">{n} school practicals you can run on a phone: set things up, take readings, draw the graph and check your answer, as many times as you like.</p>
  </div>
  <div class="lh-grid lh-anim">
    {groups.map((g, i) => (
      <section class="lk lh-exp" style={`--i:${i}`}>
        <span class="lh-exp-h"><HubIcon id="labs" /><strong>{g.name}</strong></span>
        <small>{g.text}</small>
        <ul class="lh-chips">{g.tools.map((t) => <li><a href={toolUrl(t!)}>{t!.data.name}</a></li>)}</ul>
      </section>
    ))}
  </div>
  <p class="lh-sub" style="margin-top:12px">Every lab for your class is also listed chapter by chapter on the <a href="/learn/school/">School</a> pages.</p>
  <LearnMore here="labs" />
</Base>
<style is:inline>
  .lh-exp { gap: 6px; }
  .lh-exp-h { display: flex; align-items: center; gap: 8px; }
  .lh-exp .lh-ico { width: 24px; height: 24px; }
  .lh-exp .lh-chips { margin-top: 2px; }
</style>
<script>import '../../scripts/learn';</script>
