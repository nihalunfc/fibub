---
import LessonPage from '../../../../components/course/LessonPage.astro';
import { DATA_MODELLING } from '../../../../courses/data-modelling/syllabus';
import { FIGURES } from '../../../../courses/data-modelling/figures';
import { courseLessons, type LessonEntry } from '../../../../lib/course';
import '../../../../styles/runner.css';
import '../../../../styles/tableviz.css';
export async function getStaticPaths() {
  const written = await courseLessons(DATA_MODELLING);
  const live = new Set(written.keys());
  return [...written].map(([slug, entry]) => ({ params: { lesson: slug }, props: { slug, entry, live } }));
}
const { slug, entry, live } = Astro.props as { slug: string; entry: LessonEntry; live: Set<string> };
---
<LessonPage course={DATA_MODELLING} entry={entry} slug={slug} live={live} figures={FIGURES} />
<script>import '../../../../scripts/sqllab';</script>
