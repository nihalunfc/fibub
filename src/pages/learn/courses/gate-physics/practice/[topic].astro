---
import ExamPracticeTopic from '../../../../../components/qbank/ExamPracticeTopic.astro';
import { GATE_PHYSICS, GATE_BANK } from '../../../../../courses/gate-physics/syllabus';
import { bankCounts } from '../../../../../lib/qbank/build';
import { courseLessons } from '../../../../../lib/course';
import { flatLessons } from '../../../../../courses/types';
export async function getStaticPaths() {
  const { idx, topics } = await bankCounts(GATE_BANK.bank);
  const live = await courseLessons(GATE_PHYSICS);
  const lessons = flatLessons(GATE_PHYSICS).filter((l) => live.has(l.slug));
  return idx.units.flatMap((u) => u.topics.filter((t) => (topics[t.id]?.exams['gate'] ?? 0) > 0).map((t) => ({
    params: { topic: t.id },
    props: { topic: t, unit: u.name, count: topics[t.id].exams['gate'], lesson: lessons.find((l) => l.slug === t.id) },
  })));
}
const { topic, unit, count, lesson } = Astro.props as any;
---
<ExamPracticeTopic course={GATE_PHYSICS} {...GATE_BANK} topic={topic} unit={unit} count={count} lesson={lesson} />
