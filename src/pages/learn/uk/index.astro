---
import LearnPage from '../../../components/LearnPage.astro';
import { UK_LEVELS } from '../../../data/uk';
import { allTools } from '../../../lib/tools';
const all = await allTools();
const live = new Set(all.filter((t) => t.data.status === 'live').map((t) => t.id));
const cards = UK_LEVELS.map((k) => {
  const n = new Set(k.subjects.flatMap((s) => s.chapters.flatMap((ch) => ch.tools.filter((id) => live.has(id))))).size;
  const topics = k.subjects.reduce((a, s) => a + s.chapters.length, 0);
  return { name: k.name, href: `/learn/uk/${k.id}/`, live: true, text: `${k.blurb} ${topics} topics, ${n} tools so far.`, items: k.subjects.map((s) => `${s.name}: ${s.chapters.length} topics`) };
});
---
<LearnPage title="Learn: United Kingdom" description="Interactive science and maths tools for Key Stage 3, GCSE and A-level, topic by topic, following the England national curriculum. Free, in your browser."
  lead="Pick your stage to see every topic with tools to try. Change a number, drag a point or run an experiment and see what happens. The same tools also serve other countries' school years, so a good one for GCSE may help in Year 9 or A-level too."
  cardsTitle="Key stages" cards={cards}>
</LearnPage>
