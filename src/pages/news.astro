---
// The News tab. For now: the newest tools and links to the change log and usage stats. What else
// goes here (articles, updates) is still to be decided.
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { allTools } from '../lib/tools';
import '../styles/area.css';
const tools = await allTools();
const live = tools.filter((t) => t.data.status === 'live');
const newest = [...live].sort((a, b) => (b.data.num ?? 0) - (a.data.num ?? 0)).slice(0, 12);
---
<Base title="News" description="What's new on fibub: the newest free tools, every change to the site, and how much the tools are used.">
  <div class="crumbs"><a href="/">Home</a> / News</div>
  <div class="ar-head">
    <h1>News</h1>
    <p class="lead">What's new on fibub. More is coming here soon.</p>
  </div>
  <div class="ar-cards">
    <a class="ar-card" href="/changes/"><h2>Change log</h2><p>Every change to the tools and pages, newest first, with the time it went live.</p><span class="ar-go">Open →</span></a>
    <a class="ar-card" href="/stats/"><h2>Usage stats</h2><p>How much each tool is used, as anonymous totals. Nothing about you is counted.</p><span class="ar-go">Open →</span></a>
  </div>
  <h2 class="ar-h">Newest tools</h2>
  <div class="grid">{newest.map((t) => <ToolCard tool={t} />)}</div>
</Base>
