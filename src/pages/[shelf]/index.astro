---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import SoonList from '../../components/SoonList.astro';
import { SHELVES, SECTIONS, SUBJECTS, COUNTRIES } from '../../site';
import { allTools, bySection, bySubject } from '../../lib/tools';
import { collectionLd } from '../../lib/seo';
export function getStaticPaths() {
  return SHELVES.map((s) => ({ params: { shelf: s.id }, props: { shelf: s } }));
}
const { shelf } = Astro.props;
const desc = `Free ${shelf.name.toLowerCase()} tools that run in your browser. ${shelf.blurb}`;
const tools = await allTools();
const live = tools.filter((t) => t.data.shelf === shelf.id && t.data.status === 'live');
const soon = tools.filter((t) => t.data.shelf === shelf.id && t.data.status === 'soon');
const hasSections = (SECTIONS[shelf.id] ?? []).length > 0;
const groups = bySection(shelf.id, live);
// Science: a grid of subjects, each with its sections; the tools are one click away on the subject's page.
const subjects = SUBJECTS[shelf.id] ? bySubject(shelf.id, live) : null;
---
<Base title={`${shelf.name} tools`} docTitle={`Free ${shelf.name.toLowerCase()} tools and calculators | fibub`} description={desc} ld={collectionLd(`${shelf.name} tools`, desc, `/${shelf.id}/`, [{ name: 'Home', url: '/' }, { name: shelf.name, url: `/${shelf.id}/` }])} shelf={shelf.id}>
  <div class="crumbs"><a href="/">Home</a> / {shelf.name}</div>
  <h1>{shelf.name} tools</h1>
  <p class="lead">{shelf.blurb} Free, with no sign-up.</p>
  {shelf.id === 'vehicles' && (
    <nav class="cty" aria-label="Vehicle tools by country">
      <b>Pick your country</b>
      <div>{COUNTRIES.map((c) => <a href={`/vehicles/${c.id}/`}><span class="cty-flag">{c.flag}</span>{c.short}</a>)}</div>
      <small>Shows only the tools that fit your country, opened on its rules and units.</small>
    </nav>
  )}
  {subjects ? (
    <div class="sj-grid">
      {subjects.map((sj) => (
        <section class="sj">
          <h2><a href={sj.url}>{sj.name}</a> <small>{sj.count} tools</small></h2>
          <p>{sj.blurb}</p>
          <ul>{sj.groups.map((g) => <li><a href={`${sj.url}#${g.id}`}>{g.name}</a> <span>{g.tools.length}</span></li>)}</ul>
        </section>
      ))}
    </div>
  ) : <>
  {live.length > 6 && (
    <label class="sf"><span class="visually-hidden">Find a {shelf.name.toLowerCase()} tool</span><input type="search" placeholder={`Find a ${shelf.name.toLowerCase()} tool…`} autocomplete="off" /></label>
  )}
  {hasSections ? (
    <div class="sections">
      {groups.map((g) => (
        <details class="sec" open id={g.id} data-sec={g.id}>
          <summary><span><b>{g.label}</b>{g.blurb && <small>{g.blurb}</small>}</span><em>{g.tools.length}</em></summary>
          <div class="grid">{g.tools.map((t) => <ToolCard tool={t} />)}</div>
        </details>
      ))}
    </div>
  ) : (
    live.length > 0 && <div class="grid">{live.map((t) => <ToolCard tool={t} />)}</div>
  )}
  <p class="sf-empty" hidden>No tool matches that yet. <a href="/contact/">Suggest it</a>.</p>
  </>}
  {soon.length > 0 && <><h2>Coming soon</h2><SoonList tools={soon} /></>}
</Base>

<style>
  .cty { margin: 0 0 20px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .cty > b { display: block; margin-bottom: 8px; }
  .cty div { display: flex; flex-wrap: wrap; gap: 8px; }
  .cty a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 600; min-height: 40px; }
  .cty a:hover { border-color: var(--accent); }
  .cty-flag { font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: .04em; }
  .cty small { display: block; margin-top: 8px; color: var(--muted); }
  .sf { display: block; max-width: 420px; margin: 0 0 16px; }
  .sf input { width: 100%; font: inherit; padding: 10px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); }
  .sf input:focus { outline: none; border-color: var(--accent); }
  .sections { display: grid; gap: 12px; }
  .sec { border: 1px solid var(--line); border-radius: var(--radius); background: color-mix(in srgb, var(--surface) 55%, transparent); }
  .sec > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; }
  .sec > summary::-webkit-details-marker { display: none; }
  .sec > summary span { display: grid; }
  .sec > summary b { font-size: 18px; }
  .sec > summary small { color: var(--muted); font-size: 14px; }
  .sec > summary em { font-style: normal; font-size: 13px; font-weight: 700; color: var(--muted); background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; display: flex; align-items: center; gap: 6px; }
  .sec > summary em::after { content: '▾'; transition: transform .15s; }
  .sec:not([open]) > summary em::after { transform: rotate(-90deg); }
  .sec .grid { padding: 0 12px 12px; }
  .sf-empty { color: var(--muted); }
  .sj-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 8px 40px; }
  .sj h2 { display: flex; align-items: baseline; gap: 8px; font-size: 18px; margin: 18px 0 4px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); }
  .sj h2 a { color: var(--ink); text-decoration: none; }
  .sj h2 a:hover { text-decoration: underline; }
  .sj h2 small { font-size: 13px; font-weight: 500; color: var(--muted); }
  .sj p { margin: 6px 0; font-size: 14px; color: var(--muted); }
  .sj ul { list-style: none; margin: 0; padding: 0; }
  .sj li { display: flex; justify-content: space-between; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .sj li a { color: var(--ink); text-decoration: none; }
  .sj li a:hover { text-decoration: underline; }
  .sj li span { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  /* Phones: a tighter list instead of tall cards, so a long shelf stays easy to scan. */
  @media (max-width: 600px) {
    .sec .grid, .grid { gap: 6px; }
    .grid :global(.tc) { padding: 10px 12px; gap: 12px; }
    .grid :global(.tc-sum) { -webkit-line-clamp: 1; }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('.sf input');
  if (input) {
    const cards = [...document.querySelectorAll<HTMLElement>('.tc[data-search]')];
    const secs = [...document.querySelectorAll<HTMLDetailsElement>('.sec')];
    const empty = document.querySelector<HTMLElement>('.sf-empty')!;
    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) { const ok = words.every((w) => c.dataset.search!.includes(w)); c.hidden = !ok; if (ok) shown++; }
      for (const s of secs) { const any = [...s.querySelectorAll<HTMLElement>('.tc')].some((c) => !c.hidden); s.hidden = !any; if (words.length && any) s.open = true; }
      empty.hidden = shown > 0;
    });
  }
</script>
