---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import ToolFlow from '../../components/ToolFlow.astro';
import SubjectPage from '../../components/SubjectPage.astro';
import ChangeList from '../../components/ChangeList.astro';
import { changesFor } from '../../lib/changes';
import { render } from 'astro:content';
import { shelfById } from '../../site';
import { allTools, toolComponent, toolUrl, relatedTools, bySubject, toolPlace } from '../../lib/tools';
import { ICONS } from '../../lib/icons';
import { toolSeoTitle, toolDescription, toolLd } from '../../lib/seo';
import { SHELVES, SUBJECTS } from '../../site';
import { chaptersFor } from '../../data/ncert';
import { articlesFor, articleUrl } from '../../lib/blog';
// Two kinds of page share this address pattern: a tool (/science/sky-tonight/) and, on shelves with
// subjects, a subject (/science/physics/). The build fails if a tool id is also a subject id.
export async function getStaticPaths() {
  const tools = await allTools();
  const live = tools.filter((t) => t.data.status === 'live');
  const toolPages = live.map((t) => ({ params: { shelf: t.data.shelf, tool: t.id }, props: { tool: t, related: relatedTools(t, tools) } }));
  const subjectPages = SHELVES.filter((s) => SUBJECTS[s.id]).flatMap((s) => bySubject(s.id, live).map((sj) => ({ params: { shelf: s.id, tool: sj.id }, props: { subjectPage: { shelf: s.id, subject: sj } } })));
  return [...toolPages, ...subjectPages];
}
const { tool, related, subjectPage } = Astro.props as any;
const place = tool ? toolPlace(tool) : null;
const section = place?.section, subject = place?.subject;
const shelf = tool ? shelfById(tool.data.shelf) : null;
const ToolUI = tool ? toolComponent(tool.id) : null;
const Content = tool ? (await render(tool)).Content : null;
const updated = tool?.data.updated.toISOString().slice(0, 10);
const changes = tool ? changesFor(tool.id) : [];
// School chapters (Learn > Class 8 to 12) that use this tool.
const syllabus = tool ? chaptersFor(tool.id) : [];
const secHref = (sh: string, sj: any, sec: any) => sh === 'learn' ? `/learn/school/#${sec.id}` : sj ? `/${sh}/${sj.id}/#${sec.id}` : `/${sh}/#${sec.id}`;
const everyTool = tool ? await allTools() : [];
// The tool's guide on the Blog, and other articles that mention it.
const reading = tool ? await articlesFor(tool.id) : { guide: undefined, featured: [] };
// Hub tools (the plot maker, sample size) relate to dozens of others. Every one stays linked, but past
// the first CARDS as plain links, so the page stays light.
const CARDS = 12;
---
{subjectPage ? <SubjectPage shelf={subjectPage.shelf} subject={subjectPage.subject} /> : (
<Base title={tool.data.title} docTitle={toolSeoTitle(tool)} description={toolDescription(tool)} ld={toolLd(tool)} shelf={shelf.id} tool={tool.id} image={`/og/${tool.id}.png`}>
  <div class="crumbs"><a href="/">Home</a> / <a href={`/${shelf.id}/`}>{shelf.name}</a>{subject && <> / <a href={`/${shelf.id}/${subject.id}/`}>{subject.name}</a></>}{section && <> / <a href={secHref(shelf.id, subject, section)}>{section.name}</a></>} / {tool.data.name}{tool.data.code && <a class="tool-num" href="/tools/#ids" title="This tool's ID. Use it when you tell us about the tool. Click to see what the letters mean.">Tool #{tool.data.code}{tool.data.num && String(tool.data.num) !== tool.data.code.replace(/^[A-Z]+/, '') && <small> (formerly #{tool.data.num})</small>}</a>}</div>
  <h1>{tool.data.title}</h1>
  <p class="page-views tool-counts" data-counter hidden title="How many times this tool's page has been opened, counted as a running total. Nothing about you is kept."><b data-count="v"></b>{' '}<span data-one="view" data-many="views">views</span></p>
  <p class="lead">{tool.data.summary}</p>
  {reading.guide && <p class="guide-link"><a href={articleUrl(reading.guide)}>Read the full guide: {reading.guide.data.title}</a></p>}
  <div class="bm" data-id={tool.id}>
    <button type="button" class="bm-btn" aria-haspopup="dialog"><svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z" /></svg><span>Bookmark this tool</span></button>
    <span class="bm-tip" role="status" aria-live="polite">Keep it one tap away for everyday use.</span>
    <dialog class="bm-dlg" aria-labelledby="bm-title">
      <h2 id="bm-title">Bookmark {tool.data.name}?</h2>
      <p class="bm-desk">Press <kbd class="bm-k">Ctrl</kbd> + <kbd>D</kbd> now. Your browser opens its own bookmark box, where you choose the name and folder.</p>
      <p class="bm-phone" hidden>Tap <b>Add bookmark</b>, then choose <b>Add bookmark</b> or <b>Add to Home Screen</b> from your phone's list.</p>
      <label><input type="checkbox" class="bm-pin" /> Also pin it to My tools on fibub (kept only in this browser)</label>
      <div class="bm-row">
        <button type="button" class="btn bm-share" hidden>Add bookmark</button>
        <button type="button" class="btn secondary bm-done">Done</button>
      </div>
    </dialog>
  </div>
  {tool.data.flow && <ToolFlow steps={tool.data.flow} works={tool.data.works} />}
  <div class="tool-ui"><ToolUI /></div>
  {related.direct.length > 0 && (
    <nav class="also" aria-label="Works well with">
      <span>Works well with</span>
      {related.direct.slice(0, CARDS).map((t) => <a href={toolUrl(t)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[t.data.icon]} />{t.data.name}</a>)}
    </nav>
  )}
  {syllabus.length > 0 && (
    <nav class="also" aria-label="In the school syllabus">
      <span>In the school syllabus</span>
      {syllabus.slice(0, 8).map((x) => <a href={`/learn/${x.cls.id}/#${x.subject.id}-${x.chapter.n}`}>{`${x.cls.name} ${x.subject.name}, chapter ${x.chapter.n}: ${x.chapter.title}`}</a>)}
    </nav>
  )}
  <article class="prose">
    <Content />
    {tool.data.sources.length > 0 && (
      <section class="sources" id="sources">
        <h2>Where the numbers come from</h2>
        <ul>{tool.data.sources.map((x: string) => <li>{x}</li>)}</ul>
        <p>Standard scientific values, such as constants, atomic weights and melting points, are facts found in every textbook; we name where ours were checked. If you are an author or publisher and want a value, a credit or a table changed or removed, <a href={`/contact/?about=rights-${tool.id}#rights`}>tell us</a> and we will act quickly.</p>
      </section>
    )}
    {(reading.guide || reading.featured.length > 0) && (
      <section class="reading" id="guide">
        <h2>Read more on the Blog</h2>
        <ul>
          {reading.guide && <li><a href={articleUrl(reading.guide)}>{reading.guide.data.title}</a> <span>(the full guide)</span></li>}
          {reading.featured.slice(0, 8).map((a: any) => <li><a href={articleUrl(a)}>{a.data.title}</a></li>)}
        </ul>
      </section>
    )}
    <p style="color:var(--muted);font-size:14px">Last updated {updated}.</p>
  </article>
  {changes.length > 0 && (
    <section class="tool-log" id="changes">
      <h2>Change log for {tool.data.name}</h2>
      <ChangeList changes={changes.slice(0, 10)} tools={everyTool} showTools={false} />
      <p class="more-log">{changes.length > 10 ? `Showing the latest 10 of ${changes.length} changes. ` : ''}<a href="/changes/">Every change to fibub</a></p>
    </section>
  )}
  <aside class="suggest panel">
    <b>Have a suggestion, or found a bug?</b>
    <span>Tell us what would make {tool.data.name} more useful. Ideas that ship are credited, if you'd like.</span>
    <a class="btn secondary" href={`/contact/?about=${tool.id}`}>Send a suggestion</a>
  </aside>
  {related.all.length > 0 && (
    <section>
      <h2>Related tools</h2>
      <div class="grid">{related.all.slice(0, CARDS).map((t) => <ToolCard tool={t} />)}</div>
      {related.all.length > CARDS && (
        <p class="more-rel">Also related: {related.all.slice(CARDS).map((t, i) => <>{i > 0 && ', '}<a href={toolUrl(t)}>{t.data.name}</a></>)}</p>
      )}
    </section>
  )}
</Base>
)}

<style>
  .tool-ui { display: contents; }
  .guide-link { margin: -8px 0 14px; font-size: 15px; font-weight: 600; }
  .reading span { color: var(--muted); font-size: 14px; }
  .more-log { font-size: 14px; color: var(--muted); }
  .more-rel { margin-top: 16px; font-size: 15px; color: var(--muted); }
  .suggest { display: grid; gap: 6px; justify-items: start; margin: 32px 0 8px; max-width: 720px; }
  .suggest span { color: var(--muted); font-size: 15px; }
  .suggest .btn { margin-top: 6px; }
  .also { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -16px 0 28px; }
  .also span { font-size: 14px; color: var(--muted); }
  .also a { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; text-decoration: none; color: var(--ink); border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px 5px 10px; }
  .also a:hover { border-color: var(--accent); color: var(--accent); }
  .also svg { width: 15px; height: 15px; color: var(--accent); }
</style>
