---
// Two kinds of page share this address pattern: a tool (/science/sky-tonight/) and, on shelves with
// subjects, a subject (/science/physics/). The build fails if a tool id is also a subject id.
import ToolView from '../../views/ToolView.astro';
import SubjectView from '../../views/SubjectView.astro';
import { shelfAndToolPages } from '../../lib/pages';
export const getStaticPaths = shelfAndToolPages;
const { tool, related, subjectPage } = Astro.props as any;
---
{subjectPage ? <SubjectView shelf={subjectPage.shelf} subject={subjectPage.subject} lang="en" /> : <ToolView tool={tool} related={related} lang="en" />}
