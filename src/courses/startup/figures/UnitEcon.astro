---
// 2.4: unit economics calculator: margin per sale, customer lifetime value, LTV:CAC and payback.
---
<figure class="cs-fig su-fig" data-ue>
  <span class="cs-figtag">Try it: unit economics</span>
  <div class="su-row">
    <label>Country<select name="cc"><option value="in">India (₹)</option><option value="ca">Canada (C$)</option><option value="us">USA ($)</option></select></label>
    <label>Price per month (or per order)<input type="number" name="price" min="0" step="any" value="500" /></label>
    <label>Cost to serve one customer<input type="number" name="cost" min="0" step="any" value="150" /></label>
    <label>Payment fees, %<input type="number" name="fee" min="0" max="20" step="0.1" value="2" /></label>
    <label>Cost to win one customer (CAC)<input type="number" name="cac" min="0" step="any" value="1500" /></label>
    <label>Customers who leave each month, %<input type="number" name="churn" min="0.5" max="100" step="0.5" value="5" /></label>
  </div>
  <div class="su-out">
    <div><span>Gross margin per month</span><b data-gm></b></div>
    <div><span>Average months a customer stays</span><b data-life></b></div>
    <div><span>Lifetime value (LTV)</span><b data-ltv></b></div>
    <div><span>LTV : CAC</span><b data-ratio></b></div>
    <div><span>Months to earn back CAC</span><b data-pay></b></div>
  </div>
  <p class="su-say" data-say></p>
  <figcaption>Prices are before sales tax: GST, HST or US sales tax is collected for the government and is not your revenue (Module 7). A common rule of thumb for subscription businesses is LTV at least 3 times CAC and payback within 12 months.</figcaption>
</figure>
<script>
  import { followCountry, money, num, put } from './fmt';
  const DEF = { in: [500, 150, 2, 1500], ca: [29, 8, 2.9, 90], us: [29, 8, 2.9, 90] } as const;
  for (const fig of document.querySelectorAll<HTMLElement>('[data-ue]')) {
    let touched = false;
    fig.querySelectorAll('input').forEach((el) => el.addEventListener('input', () => { touched = true; draw(); }));
    const cc = followCountry(fig, (c) => { if (!touched) { const d = DEF[c]; (['price', 'cost', 'fee', 'cac'] as const).forEach((k, i) => (fig.querySelector<HTMLInputElement>(`[name=${k}]`)!.value = String(d[i]))); } draw(); });
    function draw() {
      const c = cc(), p = num(fig, 'price'), gm = p - num(fig, 'cost') - (p * num(fig, 'fee')) / 100, life = 100 / Math.max(0.5, num(fig, 'churn')), ltv = gm * life, cac = num(fig, 'cac');
      put(fig, 'gm', `${money(c, gm, gm < 100 ? 2 : 0)} (${p ? Math.round((gm / p) * 100) : 0} %)`); put(fig, 'life', life.toFixed(1)); put(fig, 'ltv', money(c, ltv));
      const r = cac > 0 ? ltv / cac : Infinity, pb = gm > 0 ? cac / gm : Infinity;
      put(fig, 'ratio', Number.isFinite(r) ? `${r.toFixed(1)} : 1` : 'no CAC'); put(fig, 'pay', Number.isFinite(pb) ? pb.toFixed(1) : 'never');
      put(fig, 'say', gm <= 0 ? 'Each sale loses money before marketing. Raise the price or cut the cost to serve first.' : r >= 3 && pb <= 12 ? 'Healthy: each customer pays back what it cost to win them, with room to spare.' : r >= 1 ? 'Thin: you earn back the cost of winning customers, but slowly. Cut CAC, raise price or keep customers longer.' : 'Each customer costs more to win than they ever pay. Growth would burn cash faster.');
    }
  }
</script>
