---
// 8.5: paying yourself from your own company. Move the slider between salary and dividends (or, in a US S corp, salary and distributions) and compare cash in hand.
---
<figure class="cs-fig su-fig" data-py>
  <span class="cs-figtag">Calculator: salary or dividends?</span>
  <div class="su-row">
    <label>Country<select name="cc"><option value="in">India: private limited (₹)</option><option value="ca">Canada: Ontario CCPC (C$)</option><option value="us">USA: S corporation ($)</option></select></label>
    <label>Company profit before paying you<input type="number" name="p" min="0" step="any" value="3000000" /></label>
    <label>Share paid as salary: <b data-sv></b><input type="range" name="s" min="0" max="100" step="5" value="50" /></label>
  </div>
  <div class="su-bars" data-bars></div>
  <p class="su-say" data-say></p>
  <figcaption>Everything is paid out in the year, to one owner with no other income. India: salary is deductible for the company and taxed at slab rates with the ₹75,000 standard deduction; dividends come from profit after 25.17 % company tax and are taxed at slab rates. Canada: salary with CPP on both sides (no EI for an owner with over 40 %), dividends non-eligible from profit after 12.2 % tax, with the 2026 gross-up and federal and Ontario dividend tax credits (approximate). USA: federal only, payroll tax on salary, QBI deduction on the distribution. Estimates, not advice.</figcaption>
</figure>
<script>
  import { followCountry, money, num, type CC } from './fmt';
  import { inPersonal, IN_CO, caCorpTax, usScorp } from './biztax';
  import { canadaTax } from '../../../lib/money/canada-income-tax';
  const DEF: Record<CC, number> = { in: 3000000, ca: 150000, us: 150000 };
  function cash(c: CC, p: number, share: number) {
    if (c === 'in') { const s = p * share, d = (p - s) * (1 - IN_CO); return s + d - inPersonal(s, d); }
    if (c === 'ca') {
      const budget = p * share; let s = budget / 1.0595;
      for (let i = 0; i < 4; i++) { const t = canadaTax({ prov: 'ON', employment: s, other: 0, rrsp: 0 }); s = budget - t.cpp - t.cpp2; }
      const ts = canadaTax({ prov: 'ON', employment: s, other: 0, rrsp: 0 });
      const rest = Math.max(0, p - budget), d = rest - caCorpTax(rest, 'ON'), g = d * 1.15;
      const tAll = canadaTax({ prov: 'ON', employment: s, other: g, rrsp: 0 });
      const divTax = Math.max(0, tAll.incomeTax - ts.incomeTax - g * (0.090301 + 0.029863));
      return s - ts.incomeTax - ts.cpp - ts.cpp2 + d - divTax;
    }
    const r = usScorp(p, p * share);
    return p - r.total;
  }
  for (const fig of document.querySelectorAll<HTMLElement>('[data-py]')) {
    let touched = false; fig.querySelector('[name=p]')!.addEventListener('input', () => { touched = true; draw(); });
    fig.querySelector('[name=s]')!.addEventListener('input', draw);
    const cc = followCountry(fig, (c) => { if (!touched) (fig.querySelector('[name=p]') as HTMLInputElement).value = String(DEF[c]); draw(); });
    function draw() {
      const c = cc(), p = num(fig, 'p'), sh = num(fig, 's') / 100;
      fig.querySelector('[data-sv]')!.textContent = `${Math.round(sh * 100)} %`;
      const pts = [0, 0.25, 0.5, 0.75, 1];
      if (!pts.includes(sh)) pts.push(sh);
      pts.sort((a, b) => a - b);
      const vals = pts.map((x) => [x, cash(c, p, c === 'us' && x === 0 ? 0.0001 : x)] as const), max = Math.max(...vals.map((v) => v[1]), 1), best = vals.reduce((a, b) => (b[1] > a[1] ? b : a));
      fig.querySelector('[data-bars]')!.innerHTML = vals.map(([x, v]) => `<div><span>${x === sh ? '▶ ' : ''}${Math.round(x * 100)} % salary</span><span class="t"><i class="${x === best[0] ? 'g' : ''}" style="width:${Math.max(1, (v / max) * 100)}%"></i></span><b>${money(c, v)}</b></div>`).join('');
      const mine = cash(c, p, sh);
      fig.querySelector('[data-say]')!.textContent = `In hand at ${Math.round(sh * 100)} % salary: ${money(c, mine)} of ${money(c, p)} (${Math.round((mine / Math.max(p, 1)) * 100)} %). ` + (c === 'in' ? 'Salary is usually cheaper up to the ₹12 lakh rebate range and the 30 % slab; dividends suffer company tax first. Salary also needs TDS and is a cost the company must justify.' : c === 'ca' ? 'Salary builds RRSP room and CPP pension and is simpler for mortgages; dividends skip CPP. Many owners mix both, or leave profit in the company and pay out later.' : 'A 0 % salary is not allowed: the IRS requires reasonable pay for the work you do. The saving comes only from profit above that salary.');
    }
  }
</script>
