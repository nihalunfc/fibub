---
// SIM for 9.2: a simulated Hertzsprung-Russell diagram (made-up stars from simple rules, not a catalogue) with
// lines of equal radius. Pick a temperature and radius and see where that star lands.
---
<figure class="cs-fig mlf" data-hrplot>
  <span class="cs-figtag">Try it: build a star</span>
  <canvas aria-label="A simulated Hertzsprung-Russell diagram with dashed lines of equal radius and one chosen star"></canvas>
  <div class="mlf-ctl">
    <label>Surface temperature <output data-v="T"></output><input type="range" name="T" min="3.4" max="4.5" step="0.005" value="3.761"></label>
    <label>Radius <output data-v="R"></output><input type="range" name="R" min="-2.2" max="3" step="0.01" value="0"></label>
  </div>
  <div class="mlf-read">
    <div><span>luminosity L = 4πR²σT⁴</span><b data-L></b></div>
    <div><span>what kind of star</span><b data-kind></b></div>
  </div>
  <figcaption>Hot stars are on the left, as astronomers have always drawn it. The grey dots are 600 simulated stars made from simple rules: most on the main sequence, some giants and supergiants, and white dwarfs. The dashed lines are stars of equal size; bigger and hotter both mean brighter. The slider starts on the Sun.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  import { massLuminosity, msTemp, TSUN } from '../../../lib/astrocourse/physics';
  import { rng } from '../../../lib/astrocourse/sky';
  const R = rng(9), gauss = () => (R() + R() + R() + R() - 2) * 0.87;
  const pts: [number, number][] = [];
  for (let k = 0; k < 600; k++) {
    const u = R();
    if (u < 0.8) { const m = 10 ** (-0.9 + 2.4 * R() ** 1.8); pts.push([Math.log10(msTemp(m)) + gauss() * 0.01, Math.log10(massLuminosity(m)) + gauss() * 0.12]); }
    else if (u < 0.9) { const t = 3.55 + R() * 0.15; pts.push([t, 1.5 + (3.7 - t) * 6 + gauss() * 0.3]); }
    else if (u < 0.94) pts.push([3.55 + R() * 0.9, 4.5 + gauss() * 0.4]);
    else { const t = 3.8 + R() * 0.55; pts.push([t, -4 + (t - 3.8) * 5 + gauss() * 0.15]); }
  }
  for (const fig of document.querySelectorAll<HTMLElement>('[data-hrplot]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [-4.55, -3.4], y: [-4.5, 6.2], h: 320, xLabel: 'surface temperature (K), hot on the left', yLabel: 'log₁₀ L / L☉' });
    const draw = () => {
      const lt = gT(), lr = gR(), lL = 2 * lr + 4 * (lt - Math.log10(TSUN));
      p.begin();
      for (const r of [-2, -1, 0, 1, 2, 3]) {
        p.fn((x) => 2 * r + 4 * (-x - Math.log10(TSUN)), { color: p.pal.grid, width: 1, dash: [4, 4] });
        const xl = -4.5, yl = 2 * r + 4 * (4.5 - Math.log10(TSUN)); if (yl < 6.1 && yl > -4.4) p.text(xl, yl, `${10 ** r} R☉`, { dx: 4, dy: -8, size: 10, color: p.pal.muted });
      }
      for (const [t, l] of pts) p.dot(-t, l, { r: 1.8, color: p.pal.muted, alpha: 0.6 });
      p.dot(-lt, lL, { r: 7, color: p.pal.accent2 });
      p.end();
      const c = p.ctx; c.fillStyle = p.pal.bg; c.fillRect(p.L - 2, p.H - p.B + 1, p.W, p.B - 14); c.fillStyle = p.pal.muted; c.textAlign = 'center'; c.textBaseline = 'top'; c.font = '11px system-ui, sans-serif';
      for (const T of [30000, 10000, 6000, 4000]) c.fillText(String(T), p.px(-Math.log10(T)), p.H - p.B + 4);
      q('[data-L]').textContent = `${fmt(10 ** lL, lL < 0 ? 4 : lL < 2 ? 2 : 0)} L☉`;
      const msL = Math.log10(massLuminosity(Math.max(0.1, 10 ** ((lt - Math.log10(TSUN)) / 0.55))));
      q('[data-kind]').textContent = lr < -1.3 ? 'white dwarf' : Math.abs(lL - msL) < 0.6 ? 'main-sequence star' : lr > 2 ? 'supergiant' : lL > msL ? 'giant' : 'smaller than a main-sequence star';
    };
    const gT = slider(fig, 'T', () => go(), (v) => `${fmt(10 ** v, 0)} K`), gR = slider(fig, 'R', () => go(), (v) => `${fmt(10 ** v, v < 0 ? 3 : 1)} R☉`);
    const go = live(cv, draw);
  }
</script>
