---
// SIM for 7.6: how big a telescope must be to see 1 arcsecond detail at each wavelength, from X-rays to radio,
// and why radio astronomers link dishes into interferometers.
---
<figure class="cs-fig mlf" data-beyond>
  <span class="cs-figtag">Try it: pick a wavelength</span>
  <canvas aria-label="Aperture needed for a chosen resolution against wavelength, on log scales"></canvas>
  <div class="mlf-ctl">
    <label>Wavelength <output data-v="l"></output><input type="range" name="l" min="-9" max="0" step="0.05" value="-0.68"></label>
    <label>Detail wanted <output data-v="r"></output><input type="range" name="r" min="-3" max="2" step="0.05" value="0"></label>
  </div>
  <div class="mlf-read">
    <div><span>aperture or baseline needed</span><b data-D></b></div>
    <div><span>for comparison</span><b data-cmp></b></div>
  </div>
  <figcaption>From the diffraction limit D = 1.22 λ / θ (Sky watching lesson 4.4). Radio waves are about a million times longer than light, so a single dish can never match an optical telescope's sharpness. Instead, interferometers combine dishes kilometres or continents apart; the Event Horizon Telescope reached about 25 microarcseconds at 1.3 mm with an Earth-sized baseline.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  const need = (lam: number, arcsec: number) => (1.22 * lam) / (arcsec / 206264.806);
  const show = (D: number) => D < 1 ? `${fmt(D * 100, 1)} cm` : D < 1000 ? `${fmt(D, 1)} m` : `${fmt(D / 1000, D < 1e5 ? 1 : 0)} km`;
  const name = (l: number) => l < -8 ? 'X-ray' : l < -6.4 ? 'ultraviolet' : l < -6.15 ? 'visible' : l < -3 ? 'infrared' : l < -1.5 ? 'microwave' : 'radio';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-beyond]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [-9, 0], y: [-6, 8], h: 240, xLabel: 'log₁₀ wavelength (m)', yLabel: 'log₁₀ aperture (m)' });
    const draw = () => {
      const l = gl(), r = 10 ** gr(), D = need(10 ** l, r);
      p.begin();
      p.rect(-6.4, -6, 0.25, 14, { fill: p.pal.accent2, alpha: 0.2 });
      p.line(-9, Math.log10(1.2756e7), 0, Math.log10(1.2756e7), { color: p.pal.muted, width: 1, dash: [4, 4] }); p.text(-8.9, Math.log10(1.2756e7), "Earth's diameter", { dy: -8, size: 10.5, color: p.pal.muted });
      p.line(-9, 1, 0, 1, { color: p.pal.muted, width: 1, dash: [2, 4] }); p.text(-8.9, 1, '10 m: largest optical mirrors', { dy: -8, size: 10.5, color: p.pal.muted });
      p.fn((x) => Math.log10(need(10 ** x, r)), { color: p.pal.accent, width: 2.5 });
      p.dot(l, Math.log10(D), { r: 6, color: p.pal.accent2 });
      p.end();
      q('[data-D]').textContent = show(D);
      q('[data-cmp]').textContent = `${name(l)}; ${D > 1.2756e7 ? 'bigger than Earth' : D > 1e4 ? 'needs an interferometer' : D > 12 ? 'bigger than any single mirror; radio dishes reach about 500 m' : 'a single telescope can do it'}`;
    };
    const gl = slider(fig, 'l', () => go(), (v) => { const m = 10 ** v; return m < 1e-6 ? `${fmt(m * 1e9, 2)} nm` : m < 1e-2 ? `${fmt(m * 1e6, 1)} µm` : `${fmt(m * 100, 1)} cm`; }), gr = slider(fig, 'r', () => go(), (v) => { const a = 10 ** v; return a < 0.1 ? `${fmt(a * 1000, 1)} milliarcsec` : `${fmt(a, 2)}″`; });
    const go = live(cv, draw);
  }
</script>
