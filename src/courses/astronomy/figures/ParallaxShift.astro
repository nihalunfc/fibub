---
// SIM for 9.1: Earth on either side of its orbit sees a nearby star shift against far-away ones. Move the star
// and watch the parallax angle shrink as 1/d. Angles are hugely exaggerated in the drawing.
---
<figure class="cs-fig mlf" data-parallax>
  <span class="cs-figtag">Try it: move the star away</span>
  <canvas aria-label="Earth's orbit, a nearby star and the two lines of sight six months apart"></canvas>
  <div class="mlf-ctl">
    <label>Distance <output data-v="d"></output><input type="range" name="d" min="0.11" max="3" step="0.01" value="0.11"></label>
    <label>Time of year <output data-v="t"></output><input type="range" name="t" min="0" max="12" step="0.1" value="0"></label>
  </div>
  <div class="mlf-read">
    <div><span>parallax p = 1/d</span><b data-p></b></div>
    <div><span>in light-years</span><b data-ly></b></div>
    <div><span>shift across six months</span><b data-sh></b></div>
  </div>
  <figcaption>The distance slider is logarithmic, from 1.3 pc (about Alpha Centauri) to 1,000 pc. The drawing is not to scale: the real angles are smaller than an arcsecond, the width of a coin seen from 4 km. The ring on the band marks where the star appears against the background; through the year it swings back and forth, and half the full swing is the parallax.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  import { parallaxDistance } from '../../../lib/astrocourse/physics';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-parallax]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [-3, 3], y: [-1.6, 5.4], h: 320, bare: true });
    const draw = () => {
      const d = 10 ** gd(), pa = 1 / d, t = gt(), ang = (t / 12) * 2 * Math.PI;
      const sy = 1.2 + 2.2 * Math.min(1, Math.log10(d * 10) / 4); // drawn height of the star
      p.begin();
      p.rect(-3, 4.6, 6, 0.8, { fill: p.pal.muted, alpha: 0.12 });
      p.text(-2.9, 5.0, 'far-away stars', { size: 11, color: p.pal.muted });
      const orb: [number, number][] = []; for (let k = 0; k <= 80; k++) orb.push([Math.cos((k / 80) * 2 * Math.PI), 0.35 * Math.sin((k / 80) * 2 * Math.PI)]);
      p.path(orb, { color: p.pal.grid, width: 1.2 });
      p.dot(0, 0, { r: 6, color: p.pal.warn });
      const ex = Math.cos(ang), ey = 0.35 * Math.sin(ang);
      // line of sight from Earth through the star to the background band at y = 5
      const bx = ex + ((0 - ex) * (5 - ey)) / (sy - ey);
      p.line(ex, ey, bx, 5, { color: p.pal.accent2, width: 1.5, dash: [4, 3] });
      for (const s of [-1, 1]) { const b2 = s + ((0 - s) * 5) / sy; p.line(s, 0, b2, 5, { color: p.pal.grid, width: 1, dash: [2, 4] }); }
      p.dot(ex, ey, { r: 5, color: p.pal.accent }); p.dot(0, sy, { r: 5, color: p.pal.ink });
      p.dot(bx, 5, { r: 4, color: p.pal.accent2, shape: 'ring' });
      p.text(0, sy, 'nearby star', { dx: 9, size: 11, color: p.pal.muted });
      p.end();
      q('[data-p]').textContent = `${fmt(pa, pa < 0.01 ? 4 : 3)}″`;
      q('[data-ly]').textContent = `${fmt(parallaxDistance(pa) * 3.2616, d < 10 ? 1 : 0)} ly`;
      q('[data-sh]').textContent = pa >= 0.5 ? `${fmt(2 * pa, 2)}″` : `${fmt(2 * pa * 1000, 1)} milliarcseconds`;
    };
    const gd = slider(fig, 'd', () => go(), (v) => `${fmt(10 ** v, 10 ** v < 10 ? 2 : 0)} pc`);
    const gt = slider(fig, 't', () => go(), (v) => ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Math.floor(v) % 12]);
    const go = live(cv, draw);
  }
</script>
