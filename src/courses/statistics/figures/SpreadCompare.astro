---
// SIM for 1.3: two shops with the same average daily sales. Widen shop B's spread and watch the standard
// deviation, IQR and range react while the mean stays put.
---
<figure class="cs-fig mlf" data-spread>
  <span class="cs-figtag">Try it: same average, different spread</span>
  <canvas aria-label="Daily sales of two shops as rows of dots, with the mean marked and the middle half shaded"></canvas>
  <div class="mlf-ctl"><label>Shop B's spread: <output data-v="k"></output><input type="range" name="k" min="0.2" max="3" step="0.1" value="1.8" /></label></div>
  <div class="mlf-read"><div><span>mean A / B</span><b data-m></b></div><div><span>standard deviation A / B</span><b data-s></b></div><div><span>IQR A / B</span><b data-i></b></div><div><span>range A / B</span><b data-r></b></div></div>
  <figcaption>Each dot is one day's sales (in $ hundreds, made up). Both shops average 100. The shaded band is the middle half of days (the interquartile range, IQR). A manager planning staff or stock cares about the spread as much as the average: shop B's busy days are much busier and its quiet days much quieter.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt, put } from './skit';
  import { rng, mean, sd, quantile } from '../../../lib/ml/core';
  import { iqr, range } from '../../../lib/stats/tests';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-spread]')) {
    const cv = fig.querySelector('canvas')!, R = rng(5);
    let z = Array.from({ length: 30 }, () => R.normal()); const zm = mean(z), zs = sd(z); z = z.map((v) => (v - zm) / zs);
    const p = new Plot(cv, { x: [20, 180], y: [0, 3], h: 200, xLabel: 'daily sales ($00)', noYTicks: true });
    const k = slider(fig, 'k', () => draw());
    function row(xs: number[], y: number, name: string, col: string) {
      p.rect(quantile(xs, 0.25), y - 0.35, iqr(xs), 0.7, { fill: col, alpha: 0.12 });
      xs.forEach((x, i) => p.dot(x, y + ((i % 5) - 2) * 0.08, { r: 4, color: col, alpha: 0.85 }));
      p.line(mean(xs), y - 0.45, mean(xs), y + 0.45, { color: p.pal.ink, width: 2 });
      p.text(22, y + 0.6, name, { bold: true });
    }
    function draw() {
      const A = z.map((v) => 100 + 12 * v), B = z.map((v, i) => 100 + 12 * k() * z[(i * 7) % 30]);
      p.begin(); row(A, 2, 'Shop A', p.pal.accent); row(B, 0.9, 'Shop B', p.pal.accent2); p.end();
      put(fig, 'm', `${fmt(mean(A), 0)} / ${fmt(mean(B), 0)}`);
      put(fig, 's', `${fmt(sd(A, true), 1)} / ${fmt(sd(B, true), 1)}`);
      put(fig, 'i', `${fmt(iqr(A), 1)} / ${fmt(iqr(B), 1)}`);
      put(fig, 'r', `${fmt(range(A), 0)} / ${fmt(range(B), 0)}`);
    }
    live(cv, draw);
  }
</script>
