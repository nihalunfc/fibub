---
// SIM for 6.2: the p-value dance. Run the same experiment again and again with the same true effect and
// sample size; the p-values jump around wildly. With no true effect, they spread evenly from 0 to 1.
---
<figure class="cs-fig mlf" data-pdance>
  <span class="cs-figtag">Try it: repeat the same experiment</span>
  <canvas aria-label="Dots for the p-values of repeated experiments on a scale from 0 to 1, with the 0.05 line marked"></canvas>
  <div class="mlf-ctl">
    <label>True difference in means (in SDs): <output data-v="d"></output><input type="range" name="d" min="0" max="1" step="0.05" value="0.5" /></label>
    <label>People per group: <output data-v="n"></output><input type="range" name="n" min="5" max="200" step="5" value="30" /></label>
  </div>
  <div class="mlf-btns"><button type="button" class="btn" data-run="1">Run once</button><button type="button" class="btn secondary" data-run="100">Run 100 times</button><button type="button" class="btn secondary" data-clear>Clear</button></div>
  <div class="mlf-read"><div><span>last p-value</span><b data-last></b></div><div><span>runs with p &lt; 0.05</span><b data-sig></b></div></div>
  <figcaption>Each dot is the p-value from one complete experiment: two groups, a t-test. Nothing changes between runs except luck, yet one run gives p = 0.003 and the next p = 0.3. A single p-value is a noisy measurement. Set the true difference to 0: about 5 % of runs still come out "significant", which is exactly what the 0.05 threshold promises.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt, put, pct } from './skit';
  import { rng } from '../../../lib/ml/core';
  import { tTestTwo } from '../../../lib/stats/tests';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-pdance]')) {
    const cv = fig.querySelector('canvas')!, R = rng(19); let ps: number[] = [];
    const p = new Plot(cv, { x: [0, 1], y: [0, 1], h: 200, xLabel: 'p-value', noYTicks: true });
    const reset = () => { ps = []; draw(); };
    const D = slider(fig, 'd', reset), N = slider(fig, 'n', reset);
    function draw() {
      p.begin(); p.rect(0, 0, 0.05, 1, { fill: p.pal.accent2, alpha: 0.12 }); p.line(0.05, 0, 0.05, 1, { color: p.pal.accent2, width: 1.5 }).text(0.05, 0.95, ' 0.05', { color: p.pal.accent2, base: 'top' });
      ps.forEach((v, i) => p.dot(v, 0.08 + ((i * 0.618) % 1) * 0.78, { r: 3.5, color: v < 0.05 ? p.pal.accent2 : p.pal.accent, alpha: 0.8 }));
      p.end();
      put(fig, 'last', ps.length ? fmt(ps[ps.length - 1], 3) : '–');
      put(fig, 'sig', ps.length ? `${ps.filter((v) => v < 0.05).length} of ${ps.length} (${pct(ps.filter((v) => v < 0.05).length / ps.length, 0)})` : '–');
    }
    fig.querySelectorAll<HTMLButtonElement>('[data-run]').forEach((b) => b.addEventListener('click', () => {
      for (let k = 0; k < Number(b.dataset.run); k++) {
        const a = Array.from({ length: N() }, () => R.normal(0, 1)), c = Array.from({ length: N() }, () => R.normal(D(), 1));
        ps.push(tTestTwo(c, a).p);
      }
      if (ps.length > 500) ps = ps.slice(-500);
      draw();
    }));
    fig.querySelector('[data-clear]')!.addEventListener('click', reset);
    live(cv, draw);
  }
</script>
