---
// SIM for 4.2: a satisfaction survey where unhappy customers are less likely to answer. Make the response
// rates differ and watch the survey's average drift from the truth, however many people are invited.
---
<figure class="cs-fig mlf" data-rbias>
  <span class="cs-figtag">Try it: who answers the survey?</span>
  <canvas aria-label="Bars for the true spread of satisfaction scores and for the scores of people who answered"></canvas>
  <div class="mlf-ctl">
    <label>Happy customers (4–5) who answer: <output data-v="hi"></output><input type="range" name="hi" min="0.05" max="0.6" step="0.01" value="0.3" /></label>
    <label>Unhappy customers (1–2) who answer: <output data-v="lo"></output><input type="range" name="lo" min="0.05" max="0.6" step="0.01" value="0.1" /></label>
  </div>
  <div class="mlf-read"><div><span>true average score</span><b data-t></b></div><div><span>survey average</span><b data-s></b></div><div><span>bias</span><b data-b></b></div></div>
  <figcaption>Outline bars: all 20,000 customers' true satisfaction (1 to 5, made up). Filled bars: the share of answers the survey receives. When happy and unhappy customers answer at different rates, the survey is biased, and inviting more people does not help: you get a bigger sample of the same wrong mix. This is <strong>non-response bias</strong>.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt, put, pct } from './skit';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-rbias]')) {
    const cv = fig.querySelector('canvas')!, share = [0.12, 0.13, 0.2, 0.3, 0.25];
    const p = new Plot(cv, { x: [0.4, 5.6], y: [0, 0.5], h: 220, xLabel: 'satisfaction score' });
    const show = (v: number) => pct(v, 0);
    const HI = slider(fig, 'hi', () => draw(), show), LO = slider(fig, 'lo', () => draw(), show);
    function draw() {
      const rate = [LO(), LO(), (LO() + HI()) / 2, HI(), HI()], got = share.map((s, i) => s * rate[i]), tot = got.reduce((a, b) => a + b, 0), obs = got.map((g) => g / tot);
      p.begin();
      share.forEach((s, i) => { p.rect(i + 1 - 0.38, 0, 0.36, obs[i], { fill: p.pal.accent, alpha: 0.7 }); p.rect(i + 1 + 0.02, 0, 0.36, s, { color: p.pal.ink, width: 1.5 }); });
      p.text(0.5, 0.47, 'filled: survey answers   outline: everyone', { color: p.pal.muted, size: 11.5 }).end();
      const t = share.reduce((a, s, i) => a + s * (i + 1), 0), sv = obs.reduce((a, s, i) => a + s * (i + 1), 0);
      put(fig, 't', fmt(t, 2)); put(fig, 's', fmt(sv, 2)); put(fig, 'b', `${sv >= t ? '+' : ''}${fmt(sv - t, 2)}`);
    }
    live(cv, draw);
  }
</script>
