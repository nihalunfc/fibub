---
// SIM for 6.4: errors and power. Two curves: where the test statistic lands if there is no effect (null)
// and if the effect is real. The cut-off makes a type I error area (α) and a type II error area (β).
---
<figure class="cs-fig mlf" data-power>
  <span class="cs-figtag">Try it: α, β and power</span>
  <canvas aria-label="Two overlapping bell curves, one for no effect and one for a real effect, with error areas shaded"></canvas>
  <div class="mlf-ctl">
    <label>True effect (in SDs): <output data-v="d"></output><input type="range" name="d" min="0.05" max="1" step="0.05" value="0.3" /></label>
    <label>People per group: <output data-v="n"></output><input type="range" name="n" min="10" max="500" step="10" value="100" /></label>
    <label>Significance level α: <output data-v="a"></output><input type="range" name="a" min="0.01" max="0.2" step="0.01" value="0.05" /></label>
  </div>
  <div class="mlf-read"><div><span>type I error α (false alarm)</span><b data-al></b></div><div><span>type II error β (missed effect)</span><b data-be></b></div><div><span>power = 1 − β</span><b data-pw></b></div><div><span>people per group for 80 % power</span><b data-n80></b></div></div>
  <figcaption>Left curve: the difference you would measure if the change did nothing. Right curve: if it truly works. Results past the cut-off (vertical line) are called significant. The second-colour area under the null curve is α, a false alarm. The first-colour area under the real-effect curve, left of the cut-off, is β, a real effect missed. More people pull the curves apart (they get narrower), raising power.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt, put, pct, area } from './skit';
  import { normalPdf } from '../../../lib/ml/core';
  import { normalInv } from '../../../lib/stats/dist';
  import { powerMeans, nPerGroupMeans } from '../../../lib/stats/tests';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-power]')) {
    const cv = fig.querySelector('canvas')!;
    const p = new Plot(cv, { x: [-1, 1.5], y: [0, 1], h: 240, xLabel: 'measured difference (SDs)', noYTicks: true });
    const D = slider(fig, 'd', () => draw()), N = slider(fig, 'n', () => draw()), A = slider(fig, 'a', () => draw());
    function draw() {
      const d = D(), n = N(), a = A(), se = Math.sqrt(2 / n), cut = normalInv(1 - a / 2) * se;
      const f0 = (x: number) => normalPdf(x, 0, se), f1 = (x: number) => normalPdf(x, d, se), top = f0(0) * 1.15;
      p.o.x = [-4 * se, Math.max(d + 4 * se, cut + se)]; p.o.y = [0, top]; p.begin();
      area(p, f0, cut, p.x1, p.pal.accent2, 0.45); area(p, f0, p.x0, -cut, p.pal.accent2, 0.45); area(p, f1, -cut, cut, p.pal.accent, 0.3);
      p.fn(f0, { color: p.pal.ink, width: 2 }).fn(f1, { color: p.pal.accent, width: 2 });
      p.line(cut, 0, cut, top, { color: p.pal.ink, width: 1.5, dash: [5, 4] }).text(0, top * 0.95, 'no effect', { align: 'center', base: 'top', size: 11.5 }).text(d, top * 0.86, 'real effect', { align: 'center', base: 'top', size: 11.5, color: p.pal.accent });
      p.end();
      const pw = powerMeans(d, 1, n, a);
      put(fig, 'al', pct(a, 0)); put(fig, 'be', pct(1 - pw, 0)); put(fig, 'pw', pct(pw, 0)); put(fig, 'n80', nPerGroupMeans(d, 1, a, 0.8).toLocaleString('en'));
      void fmt;
    }
    live(cv, draw);
  }
</script>
