---
// How a surrogate key stands in for the source system's key, with the -1 "unknown" member for guests.
const rows: [string, string, string][] = [
  ['customer_id 17', '17', 'Uma Novak'],
  ['customer_id 142', '142', 'Yara Garcia'],
  ['customer_id 601', '601', 'Uma Novak (signed up again)'],
  ['no customer (guest)', '-1', 'Guest / unknown'],
];
---
<figure class="skm">
  <div class="skm-grid">
    <div class="skm-box">
      <h4>Source: orders</h4>
      <ul>{rows.map(([src]) => <li><code>{src}</code></li>)}</ul>
    </div>
    <div class="skm-arrow" aria-hidden="true">→<span>look up</span></div>
    <div class="skm-box">
      <h4>Warehouse: dim_customer</h4>
      <table>
        <thead><tr><th>customer_key</th><th>name</th></tr></thead>
        <tbody>{rows.map(([, k, n]) => <tr class={k === '-1' ? 'skm-unk' : ''}><td><code>{k}</code></td><td>{n}</td></tr>)}</tbody>
      </table>
    </div>
  </div>
  <figcaption>The fact table stores only <code>customer_key</code>. Every source id maps to exactly one key, and orders with no customer map to the special row -1, so no sale is ever dropped by a join. (Keys here equal the source ids because they were numbered in id order; they need not.)</figcaption>
</figure>
<style is:inline>
.skm { margin: 20px 0; }
.skm-grid { display: grid; gap: 10px; grid-template-columns: 1fr; align-items: center; }
@media (min-width: 560px) { .skm-grid { grid-template-columns: 1fr auto 1.3fr; } }
.skm-box { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; background: var(--surface); min-width: 0; }
.skm h4 { margin: 0 0 6px; font-size: 15px; }
.skm ul { margin: 0; padding-left: 18px; }
.skm li { padding: 3px 0; }
.skm table { border-collapse: collapse; width: 100%; font-size: 14px; }
.skm th, .skm td { text-align: left; padding: 3px 6px; border-bottom: 1px solid var(--line); }
.skm-unk td { background: var(--accent-soft); }
.skm-arrow { text-align: center; font-size: 22px; color: var(--accent); }
.skm-arrow span { display: block; font-size: 12px; color: var(--muted); }
.skm figcaption { margin-top: 8px; font-size: 13.5px; color: var(--muted); }
</style>
