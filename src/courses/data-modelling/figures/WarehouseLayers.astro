---
// Staging → core → marts: what each layer holds, with the Northbay objects built in the layers lesson.
const layers = [
  { n: 'Sources', d: 'the systems you load from', ex: ['customers', 'orders', 'order_items'] },
  { n: 'Staging', d: 'one view per source table: rename, cast, trim; no joins', ex: ['stg_customers', 'stg_orders', 'stg_order_items'] },
  { n: 'Core', d: 'the conformed star: surrogate keys, -1 member, history', ex: ['dim_customer', 'fact_sales'] },
  { n: 'Marts', d: 'shaped for one team or dashboard', ex: ['mart_finance_monthly', 'mart_marketing_customers'] },
];
---
<figure class="cs-fig wl">
  <ol class="wl-flow">
    {layers.map((l, i) => (
      <li class={i === 2 ? 'wl-core' : ''}>
        <strong>{l.n}</strong><span>{l.d}</span>
        <div class="wl-ex">{l.ex.map((e) => <code>{e}</code>)}</div>
      </li>
    ))}
  </ol>
  <figcaption>Arrows only point one way: each layer reads from the layer before it and nothing else. A mart that read staging directly would skip core's rules and could disagree with every other mart.</figcaption>
</figure>
<style is:inline>
.wl-flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; grid-template-columns: 1fr; }
@media (min-width: 720px) { .wl-flow { grid-template-columns: repeat(4, 1fr); gap: 18px; } }
.wl-flow li { position: relative; border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; background: var(--bg); min-width: 0; }
.wl-flow li strong { display: block; font-size: 14px; }
.wl-flow li > span { display: block; font-size: 12.5px; color: var(--muted); }
.wl-ex { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 4px; }
.wl-ex code { font-size: 11.5px; overflow-wrap: anywhere; }
.wl-core { border-color: var(--accent); background: var(--accent-soft); }
.wl-flow li:not(:last-child)::after { content: '↓'; position: absolute; left: 50%; bottom: -21px; transform: translateX(-50%); color: var(--muted); }
@media (min-width: 720px) { .wl-flow li:not(:last-child)::after { content: '→'; left: auto; right: -15px; bottom: auto; top: 50%; transform: translateY(-50%); } }
</style>
