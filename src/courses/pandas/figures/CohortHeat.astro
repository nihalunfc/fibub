---
// SIM for 8.5: the retention triangle of the course shop (orders.csv), cohort = month of first order.
// Slide the smallest cohort size to hide noisy cohorts; the readout is the size-weighted retention.
---
<figure class="cs-fig mlf" data-cohort>
  <span class="cs-figtag">Try it: read the triangle</span>
  <canvas aria-label="Cohort retention heat map: one row per first-order month, one column per month since the first order"></canvas>
  <div class="mlf-ctl">
    <label>Hide cohorts smaller than: <output data-v="min"></output><input type="range" name="min" min="1" max="60" step="1" value="1" /></label>
    <label><input type="checkbox" data-first /> Hide the first cohort (Jan 2025, mixed with older customers)</label>
  </div>
  <div class="mlf-read"><div><span>back in month 1 / 3 / 6 (weighted by cohort size)</span><b data-ret></b></div><div><span>cohorts shown</span><b data-n></b></div></div>
  <figcaption>Each row is a cohort: the customers whose first order fell in that month. Each column is how many months later, and the colour is the share of the cohort that bought again that month (darker = more). Month 0 is always 100 %. The bottom rows are short because those customers have not had time to come back, and they are tiny, so their colours jump around: hide them with the slider and the averages settle. Real counts from orders.csv.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  const LAB = ['2025-01', '2025-02', '2025-03', '2025-04', '2025-05', '2025-06', '2025-07', '2025-08', '2025-09', '2025-10', '2025-11', '2025-12', '2026-01', '2026-02', '2026-03', '2026-04', '2026-05', '2026-06'];
  const SIZE = [216, 153, 177, 120, 116, 73, 72, 45, 61, 41, 27, 34, 13, 10, 14, 4, 7, 2];
  const PCT = [[100,24,26,25,20,23,28,22,21,22,27,32,18,20,22,27,29,26],[100,28,30,30,23,24,29,25,27,36,35,20,20,25,20,29,22],[100,20,22,25,25,29,24,24,29,34,21,18,30,22,25,29],[100,21,27,24,28,17,27,31,35,17,18,25,22,25,28],[100,27,24,22,21,29,34,35,22,17,30,32,31,28],[100,23,25,25,18,23,36,16,23,23,25,21,25],[100,31,28,25,25,31,18,21,26,18,21,25],[100,20,18,36,44,22,13,31,29,27,27],[100,15,28,43,20,16,25,26,31,21],[100,37,49,32,15,24,29,27,27],[100,48,26,19,11,30,26,19],[100,18,24,26,24,26,26],[100,8,15,8,8,46],[100,10,30,20,30],[100,14,21,29],[100,0,0],[100,29],[100]];
  const put = (fig: HTMLElement, key: string, t: string) => { const el = fig.querySelector(`[data-${key}]`); if (el) el.textContent = t; };
  for (const fig of document.querySelectorAll<HTMLElement>('[data-cohort]')) {
    const cv = fig.querySelector('canvas')!, A = 18, first = fig.querySelector<HTMLInputElement>('[data-first]')!;
    const p = new Plot(cv, { x: [0, 1], y: [0, 1], h: 360, bare: true });
    const M = slider(fig, 'min', () => draw(), (v) => `${v} customers`);
    first.addEventListener('change', () => draw());
    function draw() {
      const rows = LAB.map((_, i) => i).filter((i) => SIZE[i] >= M() && !(first.checked && i === 0));
      p.o.h = 18 + 18 * Math.max(rows.length, 1) + 22;   // room for the rows and the watermark
      p.begin();
      const c = p.ctx, left = 58, top = 18, w = (p.W - left - 6) / A, h = 18;
      c.font = `${Math.min(11, w * 0.9)}px system-ui, sans-serif`; c.textBaseline = 'middle';
      c.fillStyle = p.pal.muted; c.textAlign = 'center';
      for (let a = 0; a < A; a += a < 6 ? 1 : 3) c.fillText(String(a), left + (a + 0.5) * w, top - 9);
      rows.forEach((i, r) => {
        const y = top + r * h;
        c.textAlign = 'right'; c.fillStyle = p.pal.ink; c.fillText(LAB[i], left - 4, y + h / 2);
        PCT[i].forEach((v, a) => {
          c.globalAlpha = 0.08 + 0.92 * Math.min(1, v / 50); c.fillStyle = a ? p.pal.accent : p.pal.muted;
          c.fillRect(left + a * w + 0.5, y + 0.5, w - 1, h - 1); c.globalAlpha = 1;
        });
      });
      p.end();
      const avg = (a: number) => { let s = 0, n = 0; for (const i of rows) if (PCT[i].length > a) { s += PCT[i][a] * SIZE[i]; n += SIZE[i]; } return n ? fmt(s / n, 0) + ' %' : 'n/a'; };
      put(fig, 'ret', `${avg(1)} / ${avg(3)} / ${avg(6)}`);
      put(fig, 'n', `${rows.length} of ${LAB.length} (${rows.reduce((s, i) => s + SIZE[i], 0)} customers)`);
    }
    live(cv, draw);
  }
</script>
