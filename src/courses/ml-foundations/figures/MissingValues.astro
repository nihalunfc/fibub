---
// SIM for 2.4: 14 ages, 4 of them missing. Choose how to handle the gaps and see what happens to the
// mean, the spread and the number of rows left.
---
<figure class="cs-fig mlf" data-missing>
  <span class="cs-figtag">Try it: fill the gaps</span>
  <canvas aria-label="Fourteen ages on a line; filled-in values are drawn as hollow rings"></canvas>
  <div class="mlf-ctl"><label>Missing ages are<select name="m"><option value="drop">dropped (remove those rows)</option><option value="mean">filled with the mean</option><option value="median">filled with the median</option><option value="zero">filled with 0 (a common mistake)</option></select></label></div>
  <div class="mlf-read"><div><span>rows left</span><b data-n></b></div><div><span>mean age</span><b data-m></b></div><div><span>standard deviation</span><b data-s></b></div></div>
  <p class="mlf-say" aria-live="polite" data-say></p>
  <figcaption>Hollow rings are filled-in values. Dropping rows throws away the other columns of those rows too. Filling with the mean or median keeps the rows but squeezes the spread, because every gap gets the same middle value. Filling with 0 invents babies and drags the mean down. Whatever you choose, add a yes/no column "age was missing", because missing is often a clue in itself. Made-up ages.</figcaption>
</figure>
<script>
  import { Plot, live, fmt } from './kit';
  import { mean, median, sd } from '../../../lib/ml/core';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-missing]')) {
    const cv = fig.querySelector('canvas')!, sel = fig.querySelector('select')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const AGES: (number | null)[] = [23, 31, null, 45, 38, 29, null, 52, 61, 34, null, 27, 41, null];
    const known = AGES.filter((a): a is number => a !== null);
    const p = new Plot(cv, { x: [-5, 70], y: [0, 2], h: 150, xLabel: 'age' });
    const draw = () => {
      const m = sel.value, fill = m === 'mean' ? mean(known) : m === 'median' ? median(known) : 0;
      const vals = m === 'drop' ? known : AGES.map((a) => a ?? fill);
      p.begin();
      AGES.forEach((a, i) => { if (a !== null) p.dot(a, 1 + ((i % 3) - 1) * 0.25, { r: 6 }); else if (m !== 'drop') p.dot(fill, 1 + ((i % 3) - 1) * 0.25, { r: 7, shape: 'ring', color: p.pal.accent2 }); });
      p.line(mean(vals), 0.3, mean(vals), 1.7, { color: p.pal.bad, width: 2, dash: [5, 4] }).text(mean(vals), 1.82, 'mean', { color: p.pal.bad, align: 'center' });
      p.end();
      q('[data-n]').textContent = `${vals.length} of ${AGES.length}`; q('[data-m]').textContent = fmt(mean(vals), 1); q('[data-s]').textContent = fmt(sd(vals, true), 1);
      q('[data-say]').textContent = m === 'zero' ? 'Four people aged 0: the mean drops by about 10 years and the spread balloons. The model would learn nonsense.' : m === 'drop' ? `Honest, but you lose 4 rows (29 %) and everything else in them.` : `Every gap gets ${fmt(fill, 1)}. The mean barely moves, but the spread shrinks a little: the data now looks more certain than it is.`;
    };
    sel.addEventListener('change', () => go());
    const go = live(cv, draw);
  }
</script>
