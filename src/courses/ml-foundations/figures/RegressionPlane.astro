---
// SIM for 3.4: with two inputs, a linear model is a flat plane over the floor. 40 flats by size and age,
// height = price. Turn the view; the plane is the least-squares fit found with the normal equation.
---
<figure class="cs-fig mlf" data-plane>
  <span class="cs-figtag">Try it: turn the 3-D view</span>
  <canvas aria-label="Points floating above a floor of size and age, with a flat plane fitted through them"></canvas>
  <div class="mlf-ctl"><label>Turn: <output data-v="a"></output><input type="range" name="a" min="-80" max="80" step="1" value="35" /></label><label>Tilt: <output data-v="t"></output><input type="range" name="t" min="5" max="60" step="1" value="25" /></label></div>
  <div class="mlf-read"><div><span>fitted model</span><b data-eq></b></div></div>
  <figcaption>Each dot is a flat: its position on the floor is its size and age, and its height is its price. The model price = w₁ × size + w₂ × age + b is a flat plane. Stems join each flat to the plane: those are the errors that least squares makes as small as possible. Turn the view until the plane is edge-on to see how well it fits. Made-up flats.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from './kit';
  import { rng } from '../../../lib/ml/core';
  import { leastSquares } from '../../../lib/ml/models';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-plane]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const R = rng(9);
    const S = Array.from({ length: 40 }, () => R.uniform(40, 140)), A = Array.from({ length: 40 }, () => R.uniform(0, 60));
    const Y = S.map((s, i) => 120 + 3 * s - 2.2 * A[i] + R.normal(0, 30));
    const [b, w1, w2] = leastSquares(S.map((s, i) => [1, s, A[i]]), Y);
    q('[data-eq]').textContent = `price = ${fmt(w1)} × size ${w2 < 0 ? '−' : '+'} ${fmt(Math.abs(w2))} × age + ${fmt(b, 0)}`;
    const p = new Plot(cv, { x: [-1.6, 1.6], y: [-1.1, 1.3], h: 300, bare: true });
    const ang = slider(fig, 'a', () => go(), (v) => `${v}°`), tilt = slider(fig, 't', () => go(), (v) => `${v}°`);
    // Normalise each axis to −1..1, then rotate about the vertical and tilt towards the viewer.
    const nx = (s: number) => (s - 90) / 50, nz = (a: number) => (a - 30) / 30, ny = (y: number) => (y - 300) / 250;
    const proj = (X: number, Z: number, Yv: number): [number, number, number] => {
      const a = (ang() * Math.PI) / 180, t = (tilt() * Math.PI) / 180;
      const x1 = X * Math.cos(a) - Z * Math.sin(a), z1 = X * Math.sin(a) + Z * Math.cos(a);
      return [x1, Yv * Math.cos(t) + z1 * Math.sin(t) * 0.8, z1];
    };
    const draw = () => {
      p.begin(); const pal = p.pal;
      const corner = (s: number, a: number) => proj(nx(s), nz(a), ny(w1 * s + w2 * a + b));
      const floor = (s: number, a: number) => proj(nx(s), nz(a), -1);
      const F = [floor(40, 0), floor(140, 0), floor(140, 60), floor(40, 60)];
      p.poly(F.map(([x, y]) => [x, y] as [number, number]), { fill: pal.line, alpha: 0.25 });
      const lab = (s: number, a: number, t: string) => { const [x, y] = floor(s, a); p.text(x, y, t, { color: pal.muted, align: 'center', dy: 12, size: 11.5 }); };
      lab(90, -6, 'size →'); lab(146, 30, 'age →');
      const pts = S.map((s, i) => ({ s, a: A[i], y: Y[i], d: proj(nx(s), nz(A[i]), ny(Y[i]))[2] })).sort((u, v) => v.d - u.d);
      const below = pts.filter((o) => o.y < w1 * o.s + w2 * o.a + b), above = pts.filter((o) => o.y >= w1 * o.s + w2 * o.a + b);
      const stem = (o: typeof pts[0]) => { const [x1, y1] = proj(nx(o.s), nz(o.a), ny(o.y)), [x2, y2] = corner(o.s, o.a); p.line(x1, y1, x2, y2, { color: pal.accent2, width: 1.2 }); p.dot(x1, y1, { r: 4.5, alpha: 0.95 }); };
      below.forEach(stem);
      const P = [corner(40, 0), corner(140, 0), corner(140, 60), corner(40, 60)];
      p.poly(P.map(([x, y]) => [x, y] as [number, number]), { fill: pal.accent2, alpha: 0.28 });
      for (let k = 0; k < 4; k++) p.line(P[k][0], P[k][1], P[(k + 1) % 4][0], P[(k + 1) % 4][1], { color: pal.accent2, width: 1.5 });
      above.forEach(stem);
      p.end();
    };
    const go = live(cv, draw);
  }
</script>
