---
// SIM for 9.7: a one-number recurrent cell reading a sequence. Its hidden state mixes the new input with its own
// previous value; the memory weight u decides how long a past input keeps echoing.
---
<figure class="cs-fig mlf" data-rnn>
  <span class="cs-figtag">Try it: how long does a memory last?</span>
  <canvas aria-label="Bars for the inputs over 20 time steps and a line for the hidden state, which jumps at each input and fades away at a speed set by the memory weight"></canvas>
  <div class="mlf-ctl">
    <label>Memory weight u: <output data-v="u"></output><input type="range" name="u" min="0" max="1.2" step="0.05" value="0.7" /></label>
    <label>Input pattern: <select name="s"><option value="one">one blip at step 2</option><option value="two">blips at steps 2 and 10</option><option value="noise">random inputs</option></select></label>
  </div>
  <div class="mlf-read"><div><span>left of the step-2 blip after 10 steps</span><b data-e></b></div></div>
  <figcaption>The cell computes h(t) = tanh(w·x(t) + u·h(t − 1)) with w = 1: the new state is a squashed mix of the new input and the old state. With u = 0 it remembers nothing; with u near 1 a blip echoes for many steps. Training a network like this multiplies by u (and by tanh's slope) once per step back in time, so long memories fade or explode: the same vanishing-gradient problem as deep networks, in time. LSTMs, and later transformers' attention (Lesson 10.4), were invented to fix it.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from './kit';
  import { rng } from '../../../lib/ml/core';
  import { rnn } from '../../../lib/ml/nn';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-rnn]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!, sel = fig.querySelector('select')!;
    const p = new Plot(cv, { x: [0, 21], y: [-1.1, 1.1], h: 230, xLabel: 'time step', yLabel: 'value' });
    const u = slider(fig, 'u', () => go(), (v) => fmt(v, 2));
    const R = rng(3), NOISE = Array.from({ length: 20 }, () => R.uniform(-1, 1));
    const seq = () => Array.from({ length: 20 }, (_, i) => (sel.value === 'noise' ? NOISE[i] : i + 1 === 2 || (sel.value === 'two' && i + 1 === 10) ? 1 : 0));
    const draw = () => {
      const xs = seq(), hs = rnn(xs, 1, u());
      p.begin();
      p.line(0, 0, 21, 0, { color: p.pal.muted });
      xs.forEach((v, i) => v && p.rect(i + 1 - 0.3, Math.min(0, v), 0.6, Math.abs(v), { fill: p.pal.accent2, alpha: 0.6 }));
      p.path(hs.map((h, i) => [i + 1, h] as [number, number]), { color: p.pal.accent, width: 2.5 });
      hs.forEach((h, i) => p.dot(i + 1, h, { r: 3.5, color: p.pal.accent }));
      p.text(20.8, 1.0, 'bars: input   line: memory h', { align: 'right', color: p.pal.muted });
      p.end();
      const one = rnn(Array.from({ length: 20 }, (_, i) => (i + 1 === 2 ? 1 : 0)), 1, u());
      q('[data-e]').textContent = `${fmt((100 * one[11]) / one[1], 1)} % of its first effect`;
    };
    sel.addEventListener('change', () => go());
    const go = live(cv, draw);
  }
</script>
