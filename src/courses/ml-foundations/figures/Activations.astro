---
// SIM for 9.2: the common activation functions and their slopes. The slope matters because backpropagation multiplies
// by it at every layer: flat regions stop learning.
---
<figure class="cs-fig mlf" data-act>
  <span class="cs-figtag">Try it: compare activation functions</span>
  <canvas aria-label="The chosen activation function and, dashed, its slope, for inputs from minus 5 to 5"></canvas>
  <div class="mlf-ctl">
    <label>Function: <select name="f"><option value="relu">ReLU: max(0, z)</option><option value="sigmoid">sigmoid: 1 / (1 + e⁻ᶻ)</option><option value="tanh">tanh</option><option value="step">step (the perceptron's)</option></select></label>
    <label>Input z: <output data-v="z"></output><input type="range" name="z" min="-5" max="5" step="0.1" value="1" /></label>
  </div>
  <div class="mlf-read"><div><span>output f(z)</span><b data-o></b></div><div><span>slope f′(z)</span><b data-d></b></div><div><span>slope after 10 layers (f′ⁿ)</span><b data-t></b></div></div>
  <figcaption>Solid: the function; dashed: its slope. The step has slope 0 everywhere (except the jump), so gradient descent cannot learn with it. Sigmoid and tanh flatten for large inputs: their slope there is nearly 0, and multiplied over many layers the learning signal vanishes. ReLU keeps a slope of exactly 1 for every positive input, which is why it made deep networks trainable. The last box shows the slope raised to the tenth power, a rough picture of a signal passing back through 10 such layers.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from './kit';
  import { ACT } from '../../../lib/ml/nn';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-act]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!, sel = fig.querySelector('select')!;
    const p = new Plot(cv, { x: [-5, 5], y: [-1.3, 2.3], h: 250, xLabel: 'z', yLabel: 'f(z)' });
    const z = slider(fig, 'z', () => go(), (v) => fmt(v, 1));
    const draw = () => {
      const A = ACT[sel.value as keyof typeof ACT];
      p.begin();
      p.line(-5, 0, 5, 0, { color: p.pal.muted }); p.line(0, -1.3, 0, 2.3, { color: p.pal.muted });
      p.fn(A.f, { color: p.pal.accent, width: 2.5 });
      p.fn(A.d, { color: p.pal.accent2, width: 2, dash: [6, 4] });
      p.dot(z(), A.f(z()), { r: 6, color: p.pal.accent }); p.dot(z(), A.d(z()), { r: 5, shape: 'square', color: p.pal.accent2 });
      p.end();
      const d = A.d(z());
      q('[data-o]').textContent = fmt(A.f(z()), 3); q('[data-d]').textContent = fmt(d, 3);
      q('[data-t]').textContent = d ** 10 < 1e-4 && d > 0 ? `${(d ** 10).toExponential(1)}` : fmt(d ** 10, 4);
    };
    sel.addEventListener('change', () => go());
    const go = live(cv, draw);
  }
</script>
