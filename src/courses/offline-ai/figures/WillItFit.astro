---
// SIM for 4.1, 8.1 and 8.5: pick a model size, bits per weight, context length and a device. A bar shows the
// memory it needs against what the device can give it, with a rough top speed. Rough rules, labelled as such.
const MODELS = [['2', 'Gemma 4 E2B class (about 2 to 5B)'], ['4', 'Gemma 4 E4B class'], ['8', '8B'], ['12', 'Gemma 4 12B'], ['27', 'Qwen3.8-27B'], ['31', 'Gemma 4 31B'], ['70', '70B'], ['120', 'gpt-oss-120b (MoE, 5.1B active)']];
// [id, label, usable GB, bandwidth GB/s]
const DEVICES = [
  ['l8', 'Typical laptop, 8 GB memory', 4, 60], ['l16', 'Typical laptop, 16 GB memory', 11, 100], ['m32', 'Mac mini, 32 GB (M6)', 24, 170],
  ['g16', 'Graphics card, 16 GB (RTX 5060 Ti class)', 15, 448], ['g24', 'Graphics card, 24 GB (used RTX 3090)', 23, 936],
  ['g32', 'Graphics card, 32 GB (RTX 5090)', 31, 1792], ['s128', 'AI box, 128 GB (DGX Spark class)', 110, 273], ['x128', 'Mac Studio, 128 GB (M5 Max)', 96, 614],
];
---
<figure class="cs-fig wf" data-will-fit>
  <span class="cs-figtag">Try it: will it fit?</span>
  <div class="wf-grid">
    <label>Model size<select name="p">{MODELS.map(([v, t]) => <option value={v} selected={v === '12'}>{t}</option>)}</select></label>
    <label>Bits per weight<select name="b"><option value="16">16 (full size)</option><option value="8">8</option><option value="6">6</option><option value="4.8" selected>4 (Q4_K_M, about 4.8)</option><option value="3.5">3</option></select></label>
    <label>Context length<select name="c"><option value="4">4,000 tokens</option><option value="8" selected>8,000 tokens</option><option value="32">32,000 tokens</option><option value="128">128,000 tokens</option></select></label>
    <label>Device<select name="d">{DEVICES.map(([v, t, g, bw]) => <option value={v} data-gb={g} data-bw={bw} selected={v === 'l16'}>{t}</option>)}</select></label>
  </div>
  <div class="wf-bar" aria-hidden="true"><span class="wf-w"></span><span class="wf-k"></span><span class="wf-o"></span><i class="wf-cap"></i></div>
  <p class="wf-legend"><span class="sw w"></span>model weights <span class="sw k"></span>conversation memory (KV cache) <span class="sw o"></span>working room · line = what this device can give the model</p>
  <p class="wf-out" aria-live="polite" data-out></p>
  <figcaption>Rough rules: weights = billions of parameters × bits ÷ 8; conversation memory ≈ 0.01 GB per billion parameters per 1,000 tokens; 1 GB working room; top speed ≈ memory bandwidth ÷ weights read per token. Real numbers vary by model and engine by 20% or more. Usable memory leaves room for the system (Macs about three quarters). Device speeds are makers' figures and the sources in this lesson.</figcaption>
</figure>
<style>
  .wf-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .wf-grid label { display: grid; gap: 4px; font-weight: 600; font-size: 14.5px; }
  .wf-grid select { font: inherit; font-weight: 400; padding: 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); max-width: 100%; }
  .wf-bar { position: relative; display: flex; height: 26px; margin: 16px 0 6px; border-radius: 8px; background: var(--accent-soft); overflow: visible; }
  .wf-bar span { height: 100%; transition: width .25s; }
  .wf-w { background: var(--ink); border-radius: 8px 0 0 8px; }
  .wf-k { background: var(--warn); }
  .wf-o { background: var(--muted); opacity: .5; }
  .wf-cap { position: absolute; top: -6px; bottom: -6px; width: 3px; background: var(--good); border-radius: 2px; }
  .wf-bar.over .wf-cap { background: var(--bad); }
  .wf-legend { font-size: 13px; color: var(--muted); margin: 0 0 8px; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin: 0 3px 0 6px; vertical-align: -1px; }
  .sw.w { background: var(--ink); } .sw.k { background: var(--warn); } .sw.o { background: var(--muted); opacity: .5; }
  .wf-out { margin: 0; padding: 10px 12px; border-radius: 10px; background: var(--good-soft); border-left: 4px solid var(--good); font-size: 15.5px; line-height: 1.5; }
  .wf-out.tight { background: var(--warn-soft); border-color: var(--warn); }
  .wf-out.over { background: var(--bad-soft); border-color: var(--bad); }
  @media (prefers-reduced-motion: reduce) { .wf-bar span { transition: none; } }
</style>
<script>
  const r1 = (x: number) => (x >= 10 ? Math.round(x) : Math.round(x * 10) / 10);
  for (const fig of document.querySelectorAll<HTMLElement>('[data-will-fit]')) {
    const sel = (n: string) => fig.querySelector<HTMLSelectElement>(`select[name="${n}"]`)!;
    const show = () => {
      const p = Number(sel('p').value), b = Number(sel('b').value), c = Number(sel('c').value);
      const dev = sel('d').selectedOptions[0];
      const gb = Number(dev.dataset.gb), bw = Number(dev.dataset.bw);
      const moe = p === 120;
      const w = (p * b) / 8, kv = 0.01 * (moe ? 40 : p) * c, o = 1, need = w + kv + o;
      const scale = Math.max(need, gb) * 1.08;
      const set = (cls: string, v: number) => (fig.querySelector<HTMLElement>(cls)!.style.width = `${(100 * v) / scale}%`);
      set('.wf-w', w); set('.wf-k', kv); set('.wf-o', o);
      fig.querySelector<HTMLElement>('.wf-cap')!.style.left = `${(100 * gb) / scale}%`;
      const active = moe ? (5.1 * b) / 8 : w; // MoE reads only the active experts per token
      const speed = bw / active;
      const over = need > gb, tight = !over && need > gb * 0.85;
      fig.querySelector('.wf-bar')!.classList.toggle('over', over);
      const out = fig.querySelector<HTMLElement>('[data-out]')!;
      out.className = `wf-out${over ? ' over' : tight ? ' tight' : ''}`;
      out.textContent = over
        ? `Needs about ${r1(need)} GB but this device can give about ${gb} GB. It will not load, or it spills onto slower memory and crawls. Try fewer bits, a shorter context or a smaller model.`
        : `Needs about ${r1(need)} GB of ${gb} GB available: ${tight ? 'it fits, but only just; close other apps' : 'fits with room to spare'}. Top speed about ${r1(speed)} tokens per second${speed > 60 ? ', faster than anyone reads' : speed < 8 ? ', slow to read along with' : ''}${moe ? ' (only 5.1B parameters are read per token)' : ''}.`;
    };
    fig.addEventListener('change', show);
    show();
  }
</script>
