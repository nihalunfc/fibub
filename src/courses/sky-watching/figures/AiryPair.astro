---
// SIM for 4.4: the Airy pattern of two equal stars along a line. At the Rayleigh limit the peak of one sits on
// the first dark ring of the other; at Dawson's limit there is a small dip between them.
---
<figure class="cs-fig mlf" data-airy>
  <span class="cs-figtag">Try it: when can you split them?</span>
  <canvas aria-label="Brightness across two close stars, each an Airy pattern, and their sum"></canvas>
  <div class="mlf-ctl">
    <label>Aperture <output data-v="d"></output><input type="range" name="d" min="50" max="400" step="5" value="100"></label>
    <label>Separation <output data-v="s"></output><input type="range" name="s" min="0.3" max="4" step="0.05" value="1.4"></label>
  </div>
  <div class="mlf-read">
    <div><span>Rayleigh limit</span><b data-r></b></div>
    <div><span>Dawson limit</span><b data-dw></b></div>
    <div><span>dip between the peaks</span><b data-dip></b></div>
  </div>
  <figcaption>Thin lines: each star's Airy pattern (a bright core with faint rings), green light 550 nm, perfect optics and perfectly steady air. Thick line: what you see, their sum. Rayleigh's rule puts the limit where the dip is about 26 %; Dawson found by eye that skilled observers split equal pairs down to 116″ ÷ aperture in mm, where the dip is only a few percent.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  import { airy, rayleigh, dawson } from '../../../lib/astrocourse/optics';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-airy]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [-4, 4], y: [0, 2.1], h: 240, xLabel: 'arcsec', yLabel: 'brightness' });
    const draw = () => {
      const D = gd(), s = gs(), a = (x: number) => airy(x + s / 2, D), b = (x: number) => airy(x - s / 2, D), sum = (x: number) => a(x) + b(x);
      p.begin();
      p.fn(a, { color: p.pal.accent, width: 1.2, dash: [4, 3] }); p.fn(b, { color: p.pal.accent2, width: 1.2, dash: [4, 3] });
      p.fn(sum, { color: p.pal.ink, width: 2.5 });
      p.end();
      const peak = Math.max(...Array.from({ length: 101 }, (_, i) => sum(-s / 2 - 0.3 + (i / 100) * 0.6))), mid = sum(0), dip = Math.max(0, 1 - mid / peak);
      q('[data-r]').textContent = `${fmt(rayleigh(D), 2)}″`; q('[data-dw]').textContent = `${fmt(dawson(D), 2)}″`;
      q('[data-dip]').textContent = dip < 0.005 ? 'none: one star' : `${fmt(dip * 100, 0)} %`;
    };
    const gd = slider(fig, 'd', () => go(), (v) => `${v} mm`), gs = slider(fig, 's', () => go(), (v) => `${fmt(v, 2)}″`);
    const go = live(cv, draw);
  }
</script>
