---
// SIM for 4.6: how far a star drifts in declination when an equatorial mount's axis is a little off the pole,
// and the longest exposure before the drift shows at your image scale.
---
<figure class="cs-fig mlf" data-drift>
  <span class="cs-figtag">Try it: how good must polar alignment be?</span>
  <canvas aria-label="Declination drift growing with time for a polar alignment error"></canvas>
  <div class="mlf-ctl">
    <label>Polar alignment error <output data-v="e"></output><input type="range" name="e" min="0.5" max="60" step="0.5" value="5"></label>
    <label>Image scale (″ per pixel) <output data-v="sc"></output><input type="range" name="sc" min="0.5" max="10" step="0.1" value="2"></label>
  </div>
  <div class="mlf-read">
    <div><span>drift per minute (worst case)</span><b data-dm></b></div>
    <div><span>exposure before 1 pixel of drift</span><b data-t></b></div>
  </div>
  <figcaption>Worst case: a target near the celestial equator and the meridian, with the whole error in the direction that causes drift. The error is in arcminutes; the Moon is about 30′ across. Visual observers barely notice a few degrees of error; long-exposure imaging needs a few arcminutes or better (or autoguiding, Lesson 6.5).</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  import { polarDrift } from '../../../lib/astrocourse/optics';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-drift]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [0, 10], y: [0, 60], h: 240, xLabel: 'minutes', yLabel: 'drift (″)' });
    const draw = () => {
      const e = ge(), sc = gsc(), t1 = sc / polarDrift(e, 1);
      p.begin();
      p.line(0, sc, 10, sc, { color: p.pal.accent2, width: 1.5, dash: [5, 4] }); p.text(9.9, sc, '1 pixel', { align: 'right', dy: -8, size: 11, color: p.pal.accent2 });
      p.fn((m) => polarDrift(e, m * 60), { color: p.pal.accent, width: 2.5 });
      if (t1 / 60 < 10) p.dot(t1 / 60, sc, { r: 6, color: p.pal.bad });
      p.end();
      q('[data-dm]').textContent = `${fmt(polarDrift(e, 60), 2)}″`;
      q('[data-t]').textContent = t1 < 120 ? `${fmt(t1, 0)} s` : `${fmt(t1 / 60, 1)} min`;
    };
    const ge = slider(fig, 'e', () => go(), (v) => `${fmt(v, 1)}′`), gsc = slider(fig, 'sc', () => go(), (v) => fmt(v, 1));
    const go = live(cv, draw);
  }
</script>
