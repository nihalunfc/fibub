---
// SIM for 5.4: a made-up long-period variable observed by many amateurs. Each estimate is off by a few tenths of
// a magnitude, but the average of many observers traces the true light curve.
---
<figure class="cs-fig mlf" data-varcurve>
  <span class="cs-figtag">Try it: add observers</span>
  <canvas aria-label="A variable star's light curve with scattered visual estimates and their running average"></canvas>
  <div class="mlf-ctl">
    <label>Observers <output data-v="n"></output><input type="range" name="n" min="1" max="40" step="1" value="5"></label>
    <label>Each observer's typical error <output data-v="e"></output><input type="range" name="e" min="0.05" max="0.6" step="0.05" value="0.3"></label>
  </div>
  <div class="mlf-read">
    <div><span>estimates</span><b data-k></b></div>
    <div><span>error of the 10-day average</span><b data-avg></b></div>
  </div>
  <figcaption>Made-up star with a period of 330 days, between magnitude 6 and 12 (a Mira-like variable). Dots: single visual estimates, each with its own random error. Thick line: the average of estimates in each 10-day bin. Note the magnitude axis runs upside down, as in all light curves: brighter is higher. The error of an average falls as 1/√n.</figcaption>
</figure>
<script>
  import { Plot, live, slider, fmt } from '../../ml-foundations/figures/kit';
  import { rng } from '../../../lib/astrocourse/sky';
  const truth = (t: number) => 9 - 3 * Math.sin((2 * Math.PI * t) / 330) - 0.6 * Math.sin((4 * Math.PI * t) / 330 + 0.8);
  for (const fig of document.querySelectorAll<HTMLElement>('[data-varcurve]')) {
    const cv = fig.querySelector('canvas')!, q = (s: string) => fig.querySelector<HTMLElement>(s)!;
    const p = new Plot(cv, { x: [0, 660], y: [-13.5, -5], h: 260, xLabel: 'days' });
    const draw = () => {
      const n = gn(), e = ge(), R = rng(3), gauss = () => Math.sqrt(-2 * Math.log(R() + 1e-12)) * Math.cos(2 * Math.PI * R());
      const pts: [number, number][] = [];
      for (let o = 0; o < n; o++) for (let t = R() * 12; t < 660; t += 8 + R() * 10) pts.push([t, truth(t) + e * gauss()]);
      p.begin();
      // y is −magnitude so brighter is up; label ticks as positive magnitudes.
      p.fn((t) => -truth(t), { color: p.pal.muted, width: 1, dash: [4, 4] });
      for (const [t, m] of pts) p.dot(t, -m, { r: 2.2, color: p.pal.accent, alpha: 0.55 });
      const bins: [number, number][] = [];
      for (let b = 0; b < 66; b++) { const inb = pts.filter(([t]) => t >= b * 10 && t < b * 10 + 10); if (inb.length) bins.push([b * 10 + 5, -inb.reduce((s, x) => s + x[1], 0) / inb.length]); }
      p.path(bins, { color: p.pal.accent2, width: 2.5 });
      p.end();
      // Relabel the y ticks without the minus sign.
      const c = p.ctx; c.fillStyle = p.pal.bg; c.fillRect(0, 0, p.L - 2, p.H - p.B + 2); c.fillStyle = p.pal.muted; c.textAlign = 'right'; c.textBaseline = 'middle'; c.font = '12px system-ui, sans-serif';
      for (let m = 6; m <= 13; m += 2) c.fillText(String(m), p.L - 5, p.py(-m));
      c.textAlign = 'left'; c.textBaseline = 'top'; c.fillText('mag', 2, 2);
      const per = pts.length / 66;
      q('[data-k]').textContent = `${pts.length}`; q('[data-avg]').textContent = `about ±${fmt(e / Math.sqrt(Math.max(1, per)), 2)} mag`;
    };
    const gn = slider(fig, 'n', () => go(), (v) => `${v}`), ge = slider(fig, 'e', () => go(), (v) => `±${fmt(v, 2)} mag`);
    const go = live(cv, draw);
  }
</script>
