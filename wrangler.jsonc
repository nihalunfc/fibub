// Cloudflare Workers settings for fibub.com. The site is plain static files from dist/,
// so there is no server code. Keeping this file in the repo stops Cloudflare's build from
// rewriting the project on every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fibub",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "observability": { "enabled": false }
}
